# The packages of the system that the build needs. MSYS2 builds FFmpeg (configure and make need a Unix shell); its NASM (the native one of
# the CLANG64 environment) also builds the assembly of dav1d. ARM64 has no assembly that needs NASM. FFmpeg links libwinpthread.a statically, which is in winpthreads (libwinpthread only has the DLL).
set(MSYS2_PACKAGES_x64 make diffutils mingw-w64-clang-x86_64-clang mingw-w64-clang-x86_64-winpthreads mingw-w64-clang-x86_64-nasm)
set(MSYS2_PACKAGES_arm64 make diffutils mingw-w64-clang-aarch64-clang mingw-w64-clang-aarch64-winpthreads)
set(APT_PACKAGES nasm pkg-config libx11-dev libxext-dev libxcursor-dev libxi-dev libxrandr-dev libxss-dev libxtst-dev libxfixes-dev
	libwayland-dev libxkbcommon-dev libdecor-0-dev libasound2-dev libpulse-dev libudev-dev libdrm-dev libgbm-dev libegl-dev)
set(BREW_PACKAGES nasm)

get_filename_component(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
