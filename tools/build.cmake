message(STATUS "Building BlitzLLVM for ${PLATFORM} (${ARCH}${_HOST_ARCH}), ${CONFIG}, in ${BUILD_DIR}")

# Downloads URL into the tools folder, checks its hash and unpacks it into DESTINATION, unless that is there already.
function(_fetch_tool NAME URL SHA256 DESTINATION)
	if(EXISTS "${DESTINATION}/.complete")
		return()
	endif()
	get_filename_component(_FILE_NAME "${URL}" NAME)
	set(_ARCHIVE "${TOOLS_DIR}/downloads/${_FILE_NAME}")
	if(EXISTS "${_ARCHIVE}")
		file(SHA256 "${_ARCHIVE}" _HASH)
		if(NOT _HASH STREQUAL SHA256)
			file(REMOVE "${_ARCHIVE}")
		endif()
	endif()
	if(NOT EXISTS "${_ARCHIVE}")
		message(STATUS "Downloading ${NAME} from ${URL}")
		file(DOWNLOAD "${URL}" "${_ARCHIVE}.part" EXPECTED_HASH SHA256=${SHA256} STATUS _STATUS TLS_VERIFY ON)
		list(GET _STATUS 0 _CODE)
		if(NOT _CODE EQUAL 0)
			file(REMOVE "${_ARCHIVE}.part")
			list(GET _STATUS 1 _TEXT)
			message(FATAL_ERROR "Downloading ${NAME} failed: ${_TEXT}")
		endif()
		file(RENAME "${_ARCHIVE}.part" "${_ARCHIVE}")
	endif()
	message(STATUS "Unpacking ${NAME} into ${DESTINATION}")
	file(REMOVE_RECURSE "${DESTINATION}")
	file(ARCHIVE_EXTRACT INPUT "${_ARCHIVE}" DESTINATION "${DESTINATION}")
	file(WRITE "${DESTINATION}/.complete" "${URL}\n")
endfunction()

# 1. Tools ----------------------------------------------------------------------------------------------------------------------------------
if(PLATFORM STREQUAL "windows")
	if(_HOST_ARCH STREQUAL "ARM64")
		set(_NINJA_FLAVOR winarm64)
	else()
		set(_NINJA_FLAVOR win)
	endif()
	set(_EXE ".exe")
elseif(PLATFORM STREQUAL "macos")
	set(_NINJA_FLAVOR mac)
	set(_EXE "")
elseif(_HOST_ARCH MATCHES "^(aarch64|arm64)$")
	set(_NINJA_FLAVOR linux-aarch64)
	set(_EXE "")
else()
	set(_NINJA_FLAVOR linux)
	set(_EXE "")
endif()
set(_NINJA_DIR "${TOOLS_DIR}/ninja-${NINJA_VERSION}-${_NINJA_FLAVOR}")
_fetch_tool("Ninja ${NINJA_VERSION}" "https://github.com/ninja-build/ninja/releases/download/v${NINJA_VERSION}/ninja-${_NINJA_FLAVOR}.zip"
	"${NINJA_SHA256_${_NINJA_FLAVOR}}" "${_NINJA_DIR}")
set(NINJA "${_NINJA_DIR}/ninja${_EXE}")
if(NOT CMAKE_HOST_WIN32)
	file(CHMOD "${NINJA}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
message(STATUS "Ninja: ${NINJA}")
# Also first on PATH: the dependencies (SDL3 and the others) are configured as builds of their own, which look for Ninja there.
file(TO_NATIVE_PATH "${_NINJA_DIR}" _NINJA_NATIVE)
if(CMAKE_HOST_WIN32)
	set(ENV{PATH} "${_NINJA_NATIVE};$ENV{PATH}")
else()
	set(ENV{PATH} "${_NINJA_NATIVE}:$ENV{PATH}")
endif()

if(PLATFORM STREQUAL "windows")
	# llvm-mingw for the computer that builds; it has the compilers for both targets (x86_64 and aarch64).
	if(_HOST_ARCH STREQUAL "ARM64")
		set(_LLVM_MINGW_ARCH aarch64)
	else()
		set(_LLVM_MINGW_ARCH x86_64)
	endif()
	set(_LLVM_MINGW_NAME "llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-${_LLVM_MINGW_ARCH}")
	_fetch_tool("llvm-mingw ${LLVM_MINGW_VERSION}" "https://github.com/mstorsjo/llvm-mingw/releases/download/${LLVM_MINGW_VERSION}/${_LLVM_MINGW_NAME}.zip"
		"${LLVM_MINGW_SHA256_${_LLVM_MINGW_ARCH}}" "${TOOLS_DIR}/${_LLVM_MINGW_NAME}")
	set(LLVM_MINGW_BIN "${TOOLS_DIR}/${_LLVM_MINGW_NAME}/${_LLVM_MINGW_NAME}/bin")
	if(NOT EXISTS "${LLVM_MINGW_BIN}/clang.exe")
		message(FATAL_ERROR "llvm-mingw has no clang.exe in ${LLVM_MINGW_BIN}. Delete ${TOOLS_DIR}/${_LLVM_MINGW_NAME} and run again.")
	endif()
	message(STATUS "llvm-mingw: ${LLVM_MINGW_BIN}")
	# First on PATH for everything that is started from here (the configure, the build, the tests), so that no other clang is picked up.
	file(TO_NATIVE_PATH "${LLVM_MINGW_BIN}" _BIN_NATIVE)
	set(ENV{PATH} "${_BIN_NATIVE};$ENV{PATH}")
	if("$ENV{GITHUB_ACTIONS}" STREQUAL "true" AND DEFINED ENV{GITHUB_PATH})
		file(APPEND "$ENV{GITHUB_PATH}" "${_BIN_NATIVE}\n")
	endif()
endif()

if(TOOLS_ONLY)
	return()
endif()

# 2. Dependencies -------------------------------------------------------------------------------------------------------------------------
# Runs a command and stops with MESSAGE when it fails.
function(_run MESSAGE)
	execute_process(COMMAND ${ARGN} RESULT_VARIABLE _RESULT)
	if(NOT _RESULT EQUAL 0)
		message(FATAL_ERROR "${MESSAGE} (${_RESULT})")
	endif()
endfunction()

if(PLATFORM STREQUAL "windows")
	if(NOT MSYS2_DIR)
		set(MSYS2_DIR "C:/msys64")
	endif()
	file(TO_CMAKE_PATH "${MSYS2_DIR}" MSYS2_DIR)
	if(NOT EXISTS "${MSYS2_DIR}/usr/bin/bash.exe")
		message(FATAL_ERROR "MSYS2 was not found in '${MSYS2_DIR}'. FFmpeg is built with it: install it from https://www.msys2.org, "
			"or pass --msys2 <dir> (or set BLITZLLVM_MSYS2) if it is somewhere else. Then run this again with --install-deps.")
	endif()
	if(ARCH STREQUAL "arm64")
		set(MSYSTEM CLANGARM64)
		set(_MSYS2_PREFIX "${MSYS2_DIR}/clangarm64")
	else()
		set(MSYSTEM CLANG64)
		set(_MSYS2_PREFIX "${MSYS2_DIR}/clang64")
	endif()
	set(_PACKAGES ${MSYS2_PACKAGES_${ARCH}})
	# What the build runs from MSYS2, as files: that does not depend on how pacman prints its answers. With --install-deps pacman is run
	# every time (--needed makes that quick), so that a package that is installed but broken is put right too.
	set(_FILES "${MSYS2_DIR}/usr/bin/make.exe" "${MSYS2_DIR}/usr/bin/cmp.exe" "${_MSYS2_PREFIX}/bin/clang.exe" "${_MSYS2_PREFIX}/lib/libwinpthread.a")
	if(ARCH STREQUAL "x64")
		list(APPEND _FILES "${_MSYS2_PREFIX}/bin/nasm.exe")
	endif()
	list(JOIN _PACKAGES " " _PACKAGES_TEXT)
	if(INSTALL_DEPS)
		message(STATUS "Making sure that MSYS2 has: ${_PACKAGES_TEXT}")
		_run("pacman failed" "${CMAKE_COMMAND}" -E env MSYSTEM=${MSYSTEM} "${MSYS2_DIR}/usr/bin/bash.exe" -lc "pacman -S --needed --noconfirm ${_PACKAGES_TEXT}")
	endif()
	set(_MISSING "")
	foreach(_FILE IN LISTS _FILES)
		if(NOT EXISTS "${_FILE}")
			list(APPEND _MISSING "${_FILE}")
		endif()
	endforeach()
	if(_MISSING)
		list(JOIN _MISSING ", " _TEXT)
		message(FATAL_ERROR "MSYS2 lacks ${_TEXT}. Run this again with --install-deps, or install the packages in an MSYS2 shell with: pacman -S --needed ${_PACKAGES_TEXT}")
	endif()
	set(ENV{BLITZLLVM_MSYS2} "${MSYS2_DIR}")
	message(STATUS "MSYS2: ${MSYS2_DIR} (${MSYSTEM})")
	if(ARCH STREQUAL "x64")
		set(NASM "${_MSYS2_PREFIX}/bin/nasm.exe")
	endif()
elseif(PLATFORM STREQUAL "linux")
	find_program(_DPKG_QUERY dpkg-query)
	if(_DPKG_QUERY)
		set(_MISSING "")
		foreach(_PACKAGE IN LISTS APT_PACKAGES)
			execute_process(COMMAND "${_DPKG_QUERY}" -W -f=\${Status} "${_PACKAGE}" OUTPUT_VARIABLE _STATUS ERROR_QUIET)
			if(NOT _STATUS MATCHES "install ok installed")
				list(APPEND _MISSING "${_PACKAGE}")
			endif()
		endforeach()
		if(_MISSING)
			list(JOIN _MISSING " " _TEXT)
			if(NOT INSTALL_DEPS)
				message(FATAL_ERROR "These packages are missing: ${_TEXT}. Run this again with --install-deps, or install them with: sudo apt-get install ${_TEXT}")
			endif()
			set(_SUDO "")
			execute_process(COMMAND id -u OUTPUT_VARIABLE _UID OUTPUT_STRIP_TRAILING_WHITESPACE)
			if(NOT _UID STREQUAL "0")
				set(_SUDO sudo)
			endif()
			message(STATUS "Installing: ${_TEXT}")
			_run("apt-get update failed" ${_SUDO} apt-get update)
			_run("apt-get install failed" ${_SUDO} apt-get install -y --no-install-recommends ${_MISSING})
		endif()
	else()
		# Not Debian or Ubuntu: the names differ, so the configure step says what is missing.
		message(STATUS "No dpkg-query: the packages are not checked. They are the development packages of: ${APT_PACKAGES}")
	endif()
elseif(PLATFORM STREQUAL "macos")
	find_program(NASM nasm)
	if(NOT NASM)
		if(NOT INSTALL_DEPS)
			message(FATAL_ERROR "NASM is missing. Run this again with --install-deps, or install it with: brew install ${BREW_PACKAGES}")
		endif()
		_run("brew install failed" brew install ${BREW_PACKAGES})
		find_program(NASM nasm REQUIRED)
	endif()
endif()

# 3. Configure ------------------------------------------------------------------------------------------------------------------------------
set(_CONFIGURE "${CMAKE_COMMAND}" -S "${SOURCE_DIR}" -B "${BUILD_DIR}" -G Ninja "-DCMAKE_MAKE_PROGRAM=${NINJA}" "-DCMAKE_BUILD_TYPE=${CONFIG}")
if(FRESH)
	list(APPEND _CONFIGURE --fresh)
endif()
if(PLATFORM STREQUAL "windows")
	if(ARCH STREQUAL "arm64")
		set(_TRIPLE aarch64-w64-mingw32)
	else()
		set(_TRIPLE x86_64-w64-mingw32)
	endif()
	list(APPEND _CONFIGURE
		"-DCMAKE_C_COMPILER=${LLVM_MINGW_BIN}/${_TRIPLE}-clang.exe"
		"-DCMAKE_CXX_COMPILER=${LLVM_MINGW_BIN}/${_TRIPLE}-clang++.exe"
		"-DCMAKE_RC_COMPILER=${LLVM_MINGW_BIN}/${_TRIPLE}-windres.exe"
		-DCMAKE_LINKER_TYPE=LLD)
elseif(PLATFORM STREQUAL "macos")
	list(APPEND _CONFIGURE "-DCMAKE_OSX_ARCHITECTURES=${ARCH}")
elseif(NOT SYSTEM_LIBRARIES)
	list(APPEND _CONFIGURE -DBLITZ_SYSTEM_SDL3=OFF -DBLITZ_SYSTEM_SDL3_IMAGE=OFF -DBLITZ_SYSTEM_SDL3_MIXER=OFF -DBLITZ_SYSTEM_IMAGE_CODECS=OFF
		-DBLITZ_SYSTEM_AUDIO_CODECS=OFF -DBLITZ_SYSTEM_FFMPEG=OFF)
endif()
if(NASM)
	list(APPEND _CONFIGURE "-DBLITZLLVM_NASM=${NASM}")
endif()
if(RELAXED)
	list(APPEND _CONFIGURE -DBLITZLLVM_REQUIRE_NASM=OFF -DBLITZLLVM_REQUIRE_HELP=OFF -DBLITZLLVM_REQUIRE_FXC=OFF)
else()
	list(APPEND _CONFIGURE -DBLITZLLVM_REQUIRE_NASM=ON -DBLITZLLVM_REQUIRE_HELP=ON)
	if(PLATFORM STREQUAL "windows")
		list(APPEND _CONFIGURE -DBLITZLLVM_REQUIRE_FXC=ON)
	endif()
endif()
if(GPU_TESTS)
	list(APPEND _CONFIGURE -DBLITZ_TEST_GPU=ON)
endif()
if(VERSION)
	list(APPEND _CONFIGURE "-DBlitzLLVM_VERSION=${VERSION}")
endif()
list(APPEND _CONFIGURE ${EXTRA_ARGS})

list(JOIN _CONFIGURE " " _TEXT)
message(STATUS "Configuring: ${_TEXT}")
_run("Configuring failed" ${_CONFIGURE})
if(CONFIGURE_ONLY)
	return()
endif()

# 4. Build ----------------------------------------------------------------------------------------------------------------------------------
message(STATUS "Building")
_run("Building failed" "${CMAKE_COMMAND}" --build "${BUILD_DIR}" --config "${CONFIG}")

# 5. Tests and install --------------------------------------------------------------------------------------------------------------------
if(RUN_TESTS)
	cmake_host_system_information(RESULT _CORES QUERY NUMBER_OF_LOGICAL_CORES)
	message(STATUS "Testing")
	_run("Tests failed" "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD_DIR}" -C "${CONFIG}" -j${_CORES} --output-on-failure --timeout 600)
endif()
if(INSTALL_DIR)
	message(STATUS "Installing into ${INSTALL_DIR}")
	_run("Installing failed" "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}" --prefix "${INSTALL_DIR}")
	file(COPY "${SOURCE_DIR}/LICENSE.adoc" "${SOURCE_DIR}/README.adoc" "${SOURCE_DIR}/CHANGELOG.md" DESTINATION "${INSTALL_DIR}")
endif()
message(STATUS "Done")
