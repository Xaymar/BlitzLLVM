else()
	set(PLATFORM linux)
	execute_process(COMMAND uname -m OUTPUT_VARIABLE _HOST_ARCH OUTPUT_STRIP_TRAILING_WHITESPACE)
	if(ARCH)
		message(FATAL_ERROR "--arch is for Windows and macOS. Linux builds for the computer it runs on.")
	endif()
