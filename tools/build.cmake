set(TOOLS_DIR "${SOURCE_DIR}/.tools")
set(MSYS2_DIR "$ENV{BLITZLLVM_MSYS2}")
set(EXTRA_ARGS "")

set(_ARGS "")
set(_SEEN_SEPARATOR OFF)
math(EXPR _LAST "${CMAKE_ARGC} - 1")
foreach(_I RANGE 0 ${_LAST})
	if(_SEEN_SEPARATOR)
		# A ';' would split the argument into list elements, so it is a ',' until it is used (--arch "arm64;x86_64").
		string(REPLACE ";" "," _ARG "${CMAKE_ARGV${_I}}")
		list(APPEND _ARGS "${_ARG}")
	elseif(CMAKE_ARGV${_I} STREQUAL "--")
		set(_SEEN_SEPARATOR ON)
	endif()
endforeach()

function(_need_value OPTION)
	if(NOT _ARGS)
		message(FATAL_ERROR "${OPTION} needs a value.")
	endif()
endfunction()

while(_ARGS)
	list(POP_FRONT _ARGS _ARG)
	if(_ARG MATCHES "^--(build-dir|config|arch|version|install|tools-dir|msys2)$")
		_need_value("${_ARG}")
		list(POP_FRONT _ARGS _VALUE)
		if(_ARG STREQUAL "--build-dir")
			set(BUILD_DIR "${_VALUE}")
		elseif(_ARG STREQUAL "--config")
			set(CONFIG "${_VALUE}")
		elseif(_ARG STREQUAL "--arch")
			set(ARCH "${_VALUE}")
		elseif(_ARG STREQUAL "--version")
			set(VERSION "${_VALUE}")
		elseif(_ARG STREQUAL "--install")
			set(INSTALL_DIR "${_VALUE}")
		elseif(_ARG STREQUAL "--tools-dir")
			set(TOOLS_DIR "${_VALUE}")
		else()
			set(MSYS2_DIR "${_VALUE}")
		endif()
	elseif(_ARG STREQUAL "--install-deps")
		set(INSTALL_DEPS ON)
	elseif(_ARG STREQUAL "--relaxed")
		set(RELAXED ON)
	elseif(_ARG STREQUAL "--system-libraries")
		set(SYSTEM_LIBRARIES ON)
	elseif(_ARG STREQUAL "--gpu-tests")
		set(GPU_TESTS ON)
	elseif(_ARG STREQUAL "--fresh")
		set(FRESH ON)
	elseif(_ARG STREQUAL "--configure-only")
		set(CONFIGURE_ONLY ON)
	elseif(_ARG STREQUAL "--test")
		set(RUN_TESTS ON)
	elseif(_ARG STREQUAL "--tools-only")
		set(TOOLS_ONLY ON)
	elseif(_ARG MATCHES "^-D.+")
		list(APPEND EXTRA_ARGS "${_ARG}")
	elseif(_ARG MATCHES "^(-h|--help)$")
		# The comment at the top of this file, up to the first line that is not a comment.
		file(STRINGS "${CMAKE_CURRENT_LIST_FILE}" _LINES)
		set(CMAKE_MESSAGE_INDENT "")
		foreach(_LINE IN LISTS _LINES)
			if(_LINE MATCHES "AUTOGENERATED|Copyright")
				continue()
			elseif(_LINE STREQUAL "" AND NOT _STARTED)
				continue()
			elseif(NOT _LINE MATCHES "^#")
				break()
			endif()
			set(_STARTED ON)
			string(REGEX REPLACE "^# ?" "" _LINE "${_LINE}")
			message(NOTICE "${_LINE}")
		endforeach()
		return()
	else()
		message(FATAL_ERROR "Unknown option '${_ARG}'. Run with --help to list the options.")
	endif()
endwhile()

foreach(_VARIABLE IN ITEMS BUILD_DIR TOOLS_DIR INSTALL_DIR)
	if(${_VARIABLE})
		file(TO_CMAKE_PATH "${${_VARIABLE}}" ${_VARIABLE})
		if(NOT IS_ABSOLUTE "${${_VARIABLE}}")
			set(${_VARIABLE} "${SOURCE_DIR}/${${_VARIABLE}}")
		endif()
	endif()
endforeach()

# Platform -----------------------------------------------------------------------------------------------------------------------------------
