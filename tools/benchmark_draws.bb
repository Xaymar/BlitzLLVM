; Draws about 500000 triangles in different layouts and prints how many draw calls and state changes they took, and how
; long a frame took. Needs a window and a GPU: python3 tools/benchmark_draws.py runs all of the layouts, under xvfb
; and llvmpipe if there is no display.
;
; BENCH_LAYOUT is one of
;   copies    5000 copies of one small mesh, one texture (what CopyEntity is for: trees, rocks, bullets)
;   unique    5000 different small meshes, one texture
;   textured  5000 copies of one small mesh, spread over 16 textures
;   large     10 meshes of 50000 triangles each
;   blended   2500 copies of one small mesh, half of them see-through
;   offscreen 5000 copies of one small mesh of which most are beside the view
;   mixed     all of the above at a fifth of the size
; BENCH_FRAMES is how many frames are timed (default 20).

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

layout$ = GetEnv$("BENCH_LAYOUT")
If layout$ = "" Then layout$ = "copies"
frames = Int(GetEnv$("BENCH_FRAMES"))
If frames <= 0 Then frames = 20

camera = CreateCamera()
CameraClsColor camera, 10, 10, 30
CameraRange camera, 0.1, 5000
PositionEntity camera, 0, 0, -60
light = CreateLight()
TurnEntity light, 40, 30, 0

Dim textures(15)
For t = 0 To 15
	textures(t) = CreateTexture(8, 8, 1 + 4096)
	SetBuffer TextureBuffer(textures(t))
	Color 40 + t * 12, 255 - t * 12, 128
	Rect 0, 0, 8, 8
	SetBuffer BackBuffer()
Next

; A sphere of about 100 triangles: 100 of them make 10000, and 5000 of them half a million.
Function Spawn(mesh, index, count, texture, alpha#)
	e = CopyEntity(mesh)
	side = Int(Sqr(count)) + 1
	x# = ((index Mod side) - side / 2) * 1.2
	y# = ((index / side) - side / 2) * 1.2
	PositionEntity e, x * 0.35, y * 0.35, 0
	ScaleEntity e, 0.12, 0.12, 0.12
	If texture <> 0 Then EntityTexture e, texture
	If alpha < 1 Then EntityAlpha e, alpha
	Return e
End Function

Function Sphere(segments)
	Return CreateSphere(segments)
End Function

small = Sphere(7)
HideEntity small

If layout$ = "copies" Or layout$ = "mixed" Then
	n = 5000 : If layout$ = "mixed" Then n = 1000
	For i = 0 To n - 1
		Spawn(small, i, n, textures(0), 1)
	Next
EndIf
If layout$ = "unique" Or layout$ = "mixed" Then
	n = 5000 : If layout$ = "mixed" Then n = 1000
	For i = 0 To n - 1
		m = Sphere(7)
		e = Spawn(m, i, n, textures(0), 1)
		FreeEntity m
	Next
EndIf
If layout$ = "offscreen" Then
	For i = 0 To 4999
		e = Spawn(small, i, 5000, textures(0), 1)
		If (i Mod 5) <> 0 Then MoveEntity e, 400, 0, 0
	Next
EndIf
If layout$ = "textured" Or layout$ = "mixed" Then
	n = 5000 : If layout$ = "mixed" Then n = 1000
	For i = 0 To n - 1
		Spawn(small, i, n, textures(i Mod 16), 1)
	Next
EndIf
If layout$ = "large" Or layout$ = "mixed" Then
	n = 10 : If layout$ = "mixed" Then n = 2
	For i = 0 To n - 1
		e = Sphere(160)
		PositionEntity e, (i - n / 2) * 3.0, 0, 20 + i
		EntityTexture e, textures(i)
	Next
EndIf
If layout$ = "blended" Or layout$ = "mixed" Then
	n = 2500 : If layout$ = "mixed" Then n = 500
	For i = 0 To n - 1
		a# = 1
		If (i Mod 2) = 0 Then a = 0.5
		Spawn(small, i, n, textures(1), a)
	Next
EndIf

; The first frames make the GPU buffers.
RenderWorld
Flip 0
RenderWorld
Flip 0

start = MilliSecs()
For f = 1 To frames
	RenderWorld
	Flip 0
Next
elapsed = MilliSecs() - start

DebugLog "layout=" + layout$ + " tris=" + TrisRendered() + " draws=" + Int(Stats3D(1000)) + " pipelines=" + Int(Stats3D(1001)) + " textures=" + Int(Stats3D(1002)) + " buffers=" + Int(Stats3D(1003)) + " ms_per_frame=" + (Float(elapsed) / frames)
End
