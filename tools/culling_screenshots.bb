; Renders scenes that stress the culling of what a camera cannot see and saves each one as a bitmap in the folder that
; SHOT_DIR names, so that the pictures of two builds can be compared byte for byte.
Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()
folder$ = GetEnv$("SHOT_DIR")
If folder$ = "" Then folder$ = "."

tex = CreateTexture(8, 8)
SetBuffer TextureBuffer(tex)
For y = 0 To 7
	For x = 0 To 7
		If ((x + y) And 1) = 0 Then Color 255, 255, 255 Else Color 60, 120, 255
		Plot x, y
	Next
Next
SetBuffer BackBuffer()

Function Reset()
	ClearWorld True, True, False
	AmbientLight 60, 60, 60
	l = CreateLight()
	TurnEntity l, 40, 30, 0
End Function

Function Shot(name$)
	RenderWorld
	SaveBuffer BackBuffer(), GetEnv$("SHOT_DIR") + "/" + name$ + ".bmp"
	DebugLog name$ + " calls=" + Stats3D(1000) + " tris=" + TrisRendered()
End Function

; 1. Cubes and sprites around the edges of the view and behind the camera.
Reset()
cam = CreateCamera() : PositionEntity cam, 0, 0, -10
CameraClsColor cam, 20, 30, 40
For i = 0 To 35
	a# = i * 10.0
	c = CreateCube() : EntityColor c, 255 - i * 6, 80 + i * 4, 60
	PositionEntity c, Sin(a) * 8, Cos(a) * 6, 0
	ScaleEntity c, 0.3, 0.3, 0.3
	s = CreateSprite() : EntityTexture s, tex
	PositionEntity s, Sin(a + 5) * 14, Cos(a + 5) * 10.5, 4
	ScaleSprite s, 0.8, 0.8
	b = CreateSprite() : EntityTexture b, tex
	PositionEntity b, Sin(a) * 6, Cos(a) * 5, -30
Next
Shot("edges")

; 2. A mesh much bigger than the view with the camera inside of it, and one that is only partly in view.
Reset()
cam = CreateCamera() : PositionEntity cam, 0, 0, 0
CameraClsColor cam, 20, 30, 40
room = CreateCube() : FlipMesh room : ScaleEntity room, 40, 40, 40 : EntityTexture room, tex
EntityFX room, 1
big = CreateCube() : ScaleEntity big, 30, 2, 30 : PositionEntity big, 20, -6, 25 : EntityColor big, 200, 120, 60
TurnEntity cam, 0, 35, 0
Shot("big")

; 3. Two cameras next to each other that look different ways, and one that is rolled.
Reset()
cam = CreateCamera() : CameraViewport cam, 0, 0, 160, 240 : PositionEntity cam, 0, 0, -10
CameraClsColor cam, 20, 30, 40
cam2 = CreateCamera() : CameraViewport cam2, 160, 0, 160, 240 : PositionEntity cam2, 0, 0, -10 : TurnEntity cam2, 0, 70, 20
CameraClsColor cam2, 40, 30, 20
For i = 0 To 35
	a# = i * 10.0
	c = CreateCube() : EntityColor c, 255 - i * 6, 80 + i * 4, 60
	PositionEntity c, Sin(a) * 25, Cos(a) * 3, Cos(a * 2) * 25
	s = CreateSprite() : EntityTexture s, tex
	PositionEntity s, Cos(a) * 25, Sin(a) * 6, Sin(a) * 25
Next
Shot("cameras")

; 4. A mirror: what is behind the camera shows in it, and the pass of the mirror has its own view.
Reset()
cam = CreateCamera() : PositionEntity cam, 0, 4, -14 : TurnEntity cam, 14, 0, 0
CameraClsColor cam, 20, 30, 40
m = CreateMirror()
floor = CreatePlane() : EntityColor floor, 40, 80, 40 : EntityAlpha floor, 0.6
For i = 0 To 23
	a# = i * 15.0
	c = CreateCube() : EntityColor c, 255 - i * 8, 80 + i * 6, 60
	PositionEntity c, Sin(a) * 7, 1 + (i Mod 3), Cos(a) * 7 + 4
	s = CreateSprite() : EntityTexture s, tex
	PositionEntity s, Sin(a) * 12, 3, Cos(a) * 12 + 4
Next
Shot("mirror")

; 5. A mesh whose vertices move and entities that move in and out of the view while frames are drawn.
Reset()
cam = CreateCamera() : PositionEntity cam, 0, 0, -10
CameraClsColor cam, 20, 30, 40
mover = CreateCube() : EntityColor mover, 255, 200, 40 : PositionEntity mover, 40, 0, 0
wave = CreateCube() : surf = GetSurface(wave, 1) : EntityColor wave, 60, 220, 120
spr = CreateSprite() : EntityTexture spr, tex : PositionEntity spr, -40, 0, 0
For f = 0 To 59
	PositionEntity mover, 40 - f, Sin(f * 6) * 3, 0
	PositionEntity spr, -40 + f * 1.2, 0, 0
	For v = 0 To CountVertices(surf) - 1
		VertexCoords surf, v, VertexX(surf, v), VertexY(surf, v), VertexZ(surf, v) * 0.5 + f * 0.01
	Next
	PositionEntity wave, Sin(f * 12) * 20, 2, 0
	If f = 30 Or f = 40 Or f = 50 Then Shot("animated" + f) Else RenderWorld
Next

End
