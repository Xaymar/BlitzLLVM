; Times UpdateWorld with BENCH_STATICS entities that stay where they are (default 5000) and BENCH_MOVERS entities that
; move every frame (default 200), which collide with the statics with polygons, spheres or boxes (BENCH_METHOD 2, 1 or 3).
; python3 tools/benchmark_collisions.py runs it with and without the broad phase (BLITZ_NO_BROADPHASE=1).

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

statics = Int(GetEnv$("BENCH_STATICS")) : If statics <= 0 Then statics = 5000
movers = Int(GetEnv$("BENCH_MOVERS")) : If movers <= 0 Then movers = 200
method = Int(GetEnv$("BENCH_METHOD")) : If method <= 0 Then method = 2
frames = 30

SeedRnd 7
base = CreateSphere(6)
For i = 1 To statics
	e = CopyEntity(base)
	PositionEntity e, Rnd(-200, 200), Rnd(-5, 5), Rnd(10, 400)
	EntityType e, 2
	EntityRadius e, 1
Next
Dim mover(movers)
For i = 1 To movers
	mover(i) = CopyEntity(base)
	PositionEntity mover(i), Rnd(-200, 200), Rnd(-5, 5), Rnd(10, 400)
	EntityType mover(i), 1
	EntityRadius mover(i), 1
Next
FreeEntity base
Collisions 1, 2, method, 2
UpdateWorld

start = MilliSecs()
For f = 1 To frames
	For i = 1 To movers
		MoveEntity mover(i), Rnd(-1, 1), 0, Rnd(-1, 1)
	Next
	UpdateWorld
Next
DebugLog "statics=" + statics + " movers=" + movers + " method=" + method + " update_ms=" + (Float(MilliSecs() - start) / frames)
End
