; Times a frame of a pretend game: BENCH_WORK loops of arithmetic for the program's own logic, then RenderWorld and
; Flip. How much of the logic overlaps with the GPU working on the frame before shows up as milliseconds per frame, run
; it with and without BLITZ_SYNC_GPU=1 to compare. python3 tools/benchmark_overlap.py does both.
; BENCH_FRAMES is how many frames are timed (default 100), BENCH_MESHES how many spheres are drawn (default 2000).

Graphics3D 640, 480, 32, 2
SetBuffer BackBuffer()

frames = Int(GetEnv$("BENCH_FRAMES"))
If frames <= 0 Then frames = 100
work = Int(GetEnv$("BENCH_WORK"))
meshes = Int(GetEnv$("BENCH_MESHES"))
If meshes <= 0 Then meshes = 2000

camera = CreateCamera()
CameraRange camera, 0.1, 5000
PositionEntity camera, 0, 0, -60
light = CreateLight()
TurnEntity light, 40, 30, 0

base = CreateSphere(8)
For i = 0 To meshes - 1
	e = CopyEntity(base)
	side = Int(Sqr(meshes)) + 1
	PositionEntity e, ((i Mod side) - side / 2) * 0.4, ((i / side) - side / 2) * 0.4, 0
	ScaleEntity e, 0.15, 0.15, 0.15
Next
FreeEntity base

; Warm up.
For i = 1 To 5
	RenderWorld
	Flip 0
Next

acc# = 0
start = MilliSecs()
For f = 1 To frames
	For w = 1 To work
		acc = acc + Sin(w) * Cos(f)
	Next
	TurnEntity camera, 0, 0, 0.01
	RenderWorld
	Flip 0
Next
elapsed = MilliSecs() - start
DebugLog "frames=" + frames + " work=" + work + " ms_per_frame=" + (Float(elapsed) / frames) + " acc=" + acc
End
