; Types: objects, fields, lists, handles. Stops with an error if anything is off.
Const Cmax = 3

Type Tnode
	Field id, weight#, name$
	Field tags[Cmax]
	Field parent.Tnode
	Field owner.Towner
End Type

Type Towner
	Field name$
	Field count
End Type

Local a.Tnode = New Tnode
a\id = 1 : a\weight = 2.5 : a\name = "first"
Local b.Tnode = New Tnode
b\id = 2 : b\name = "second" : b\parent = a
Local c.Tnode = New Tnode
c\id = 3 : c\name = "third"

Check "field int", a\id, 1
Check "field float", a\weight, 2.5
CheckS "field string", a\name, "first"
CheckS "parent chain", b\parent\name, "first"
Check "null parent", (a\parent = Null), 1
Check "not null", (b\parent <> Null), 1

; Array fields, including the last element.
For i = 0 To Cmax
	a\tags[i] = i * 10
Next
Check "array field", a\tags[2], 20
Check "array field last", a\tags[Cmax], 30

; Lists keep their order.
Local total = 0, order$ = ""
For n.Tnode = Each Tnode
	total = total + n\id
	order = order + n\id
Next
Check "each total", total, 6
CheckS "each order", order, "123"
Check "first", (First Tnode)\id, 1
Check "last", (Last Tnode)\id, 3
Check "after", (After a)\id, 2
Check "before", (Before c)\id, 2
Check "before first", (Before a = Null), 1

; Deleting while looping must not break the loop.
Local visited = 0
For n.Tnode = Each Tnode
	visited = visited + 1
	If n\id = 2 Then Delete n
Next
Check "visited all", visited, 3
Check "after delete", (After a)\id, 3

; Handles stand in for objects.
Local h = Handle(c)
Check "handle", (Object.Tnode(h) = c), 1
Check "handle of Null", Handle(Null), 0
Check "deleted handle", (Object.Tnode(Handle(a)) = a), 1

; Moving things around.
Local d.Tnode = New Tnode
d\id = 4
Insert d Before a
Check "insert before", (First Tnode)\id, 4
Insert d After c
Check "insert after", (Last Tnode)\id, 4

Local owner.Towner = New Towner
owner\name = "me"
c\owner = owner
CheckS "other type", c\owner\name, "me"
Check "function result", Count(), 3

Delete Each Tnode
Check "delete each", (First Tnode = Null), 1

Print "All type tests passed."

Function Count()
	Local n = 0
	For o.Tnode = Each Tnode
		n = n + 1
	Next
	Return n
End Function

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function

Function CheckS(name$, got$, want$)
	If got <> want Then RuntimeError name + ": got '" + got + "', expected '" + want + "'"
End Function
