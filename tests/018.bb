; Reading and writing pixels, and copying parts of buffers. Without a window nothing is drawn, so nothing is checked.
Graphics 320, 240, 32, 2
SetBuffer BackBuffer()
Local real = (TotalVidMem() > 0)

Local img = CreateImage(8, 8)
SetBuffer ImageBuffer(img)
Color 10, 20, 30
Rect 0, 0, 8, 8, True
Plot 5, 5

If real Then
	Check "ReadPixel", ReadPixel(3, 3) And $FFFFFF, $0A141E
	Check "ReadPixel on a buffer", ReadPixel(3, 3, ImageBuffer(img)) And $FFFFFF, $0A141E
	Check "outside", ReadPixel(100, 100), 0

	; Fast access works on a locked buffer.
	LockBuffer ImageBuffer(img)
	Check "fast read", ReadPixelFast(3, 3) And $FFFFFF, $0A141E
	WritePixelFast 1, 1, $FF8040
	WritePixelFast 2, 1, $102030
	CopyPixelFast 2, 1, ImageBuffer(img), 6, 6, ImageBuffer(img)
	UnlockBuffer ImageBuffer(img)
	Check "written", ReadPixel(1, 1) And $FFFFFF, $FF8040
	Check "copied pixel", ReadPixel(6, 6) And $FFFFFF, $102030

	WritePixel 0, 0, $00AA00
	Check "slow write", ReadPixel(0, 0) And $FFFFFF, $00AA00

	; Rectangles can be copied between buffers, and within one.
	SetBuffer BackBuffer()
	Color 255, 0, 0
	Rect 0, 0, 16, 16, True
	CopyRect 0, 0, 8, 8, 100, 100, BackBuffer(), BackBuffer()
	Check "copy within", ReadPixel(104, 104) And $FFFFFF, $FF0000
	CopyRect 0, 0, 8, 8, 50, 50, ImageBuffer(img), BackBuffer()
	Check "copy between", ReadPixel(51, 51) And $FFFFFF, $FF8040

	GetColor 51, 51
	Check "red", ColorRed(), $FF
	Check "green", ColorGreen(), $80
	Check "blue", ColorBlue(), $40
EndIf

If real Then Print "All pixel tests passed (checked on the GPU)." Else Print "All pixel tests passed (no window, nothing checked)."

Function Check(name$, got, want)
	If got <> want Then RuntimeError name + ": got " + Hex(got) + ", expected " + Hex(want)
End Function
