; Data, Read and Restore. Stops with an error if anything is off.
Local a, b#, c$

Read a, b, c
Check "int", a, 7
Check "real", b, 2.5
CheckS "string", c, "seven"

Read a
Check "negative", a, -3
Read c
CheckS "number as string", c, "1"

Restore numbers
Read a, b
Check "restored int", a, 10
Check "restored real", b, 20

Restore
Read a
Check "restored to the start", a, 7

; Data can be anywhere, and is read in the order it appears in the program.
Restore later
Read c
CheckS "later data", c, "from later"

Print "All Data tests passed."
End

Data 7, 2.5, "seven"
Data -3, 1
.numbers
Data 10, 20
.later
Data "from later"

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function

Function CheckS(name$, got$, want$)
	If got <> want Then RuntimeError name + ": got '" + got + "', expected '" + want + "'"
End Function
