; 2D images: drawing into them, masks, frames, tiles, and drawing on a texture. Runs for a few seconds, or until Escape.
Graphics3D 640, 480, 32, 2
AppTitle "BlitzLLVM Image Test"
SetBuffer BackBuffer()

; An image that is drawn on. Black is masked by default, so the corners are see-through.
Local ball = CreateImage(64, 64)
Check "image width", ImageWidth(ball), 64
SetBuffer ImageBuffer(ball)
Color 255, 60, 60 : Oval 0, 0, 64, 64, 1
Color 255, 255, 255 : Text 32, 28, "Hi", True, True
SetBuffer BackBuffer()
MidHandle ball

; Frames.
Local frames = CreateImage(32, 32, 4)
For f = 0 To 3
	SetBuffer ImageBuffer(frames, f)
	Color 40 + f * 70, 220 - f * 60, 100 : Rect 0, 0, 32, 32, 1
	Color 255, 255, 255 : Text 16, 16, f, True, True
Next
SetBuffer BackBuffer()

; A texture that is drawn on, and put on a cube.
Local board = CreateTexture(64, 64)
SetBuffer TextureBuffer(board)
Color 255, 220, 0 : Rect 0, 0, 64, 64, 1
Color 0, 0, 160 : Oval 8, 8, 48, 48, 1
SetBuffer BackBuffer()

Local camera = CreateCamera()
PositionEntity camera, 0, 0, -4
CameraViewport camera, 400, 240, 220, 220
CameraClsMode camera, False, True
Local light = CreateLight()
RotateEntity light, 40, 30, 0
Local cube = CreateCube()
EntityTexture cube, board

Local copy = 0
Local count = 0
While count < 400
	ClsColor 30, 60, 90
	Cls
	TileBlock frames, 0, 0, 2

	DrawImage ball, 100, 100
	DrawBlock ball, 200, 100
	For f = 0 To 3
		DrawImage frames, 300 + f * 40, 100, f
	Next
	DrawImageRect ball, 100, 200, 16, 16, 32, 32
	DrawBlockRect ball, 160, 200, 16, 16, 32, 32

	If count = 5 Then
		; Copy what is on the screen, make a smaller version, and keep it in a file.
		copy = CreateImage(120, 60)
		GrabImage copy, 80, 70
		SaveImage copy, "017_grab.bmp"
		ResizeImage copy, 60, 30
	EndIf
	If copy <> 0 Then DrawBlock copy, 10, 400

	TurnEntity cube, 0.5, 1, 0
	RenderWorld
	Color 255, 255, 255
	Text 10, 10, "Images " + count

	Flip
	count = count + 1
	If KeyHit(1) Then Exit
Wend

; Without a window nothing is drawn, so nothing was saved either.
Local saved = LoadImage("017_grab.bmp")
If saved <> 0 Then
	Check "saved image", ImageWidth(saved), 120
	DeleteFile "017_grab.bmp"
EndIf
Print "All image tests passed."

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function
