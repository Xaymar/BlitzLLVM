; The BlitzPlus GUI: a window with menus and most of the gadgets. Try them, what happens is printed on the status bar.

win = CreateWindow("BlitzPlus GUI", 40, 30, 560, 420)
root = WindowMenu(win)
mfile = CreateMenu("File", 0, root)
mopen = CreateMenu("Open", 1, mfile)
CreateMenu "", 0, mfile
mquit = CreateMenu("Quit", 2, mfile)
medit = CreateMenu("Edit", 0, root)
mcheck = CreateMenu("Checked", 3, medit)
CheckMenu mcheck
UpdateWindowMenu win

btn = CreateButton("Press", 10, 10, 80, 26, win)
chk = CreateButton("Check", 100, 10, 80, 26, win, 2)
rad1 = CreateButton("Radio 1", 190, 10, 80, 26, win, 3)
rad2 = CreateButton("Radio 2", 280, 10, 80, 26, win, 3)
tf = CreateTextField(10, 44, 170, 24, win)
SetGadgetText tf, "Type here"
ta = CreateTextArea(10, 76, 250, 100, win)
SetGadgetText ta, "Text area" + Chr(13) + "with two lines and a long line that goes on and on to be wrapped"
FormatTextAreaText ta, 255, 0, 0, 1, 0, 4
lb = CreateListBox(270, 44, 120, 100, win)
For i = 1 To 12 : AddGadgetItem lb, "Item " + i : Next
cb = CreateComboBox(400, 44, 120, 24, win)
For i = 1 To 5 : AddGadgetItem cb, "Choice " + i : Next
SelectGadgetItem cb, 0
sl = CreateSlider(10, 184, 250, 18, win)
SetSliderRange sl, 10, 110
pb = CreateProgBar(10, 210, 250, 18, win)
UpdateProgBar pb, 0.35
tab = CreateTabber(270, 150, 250, 90, win)
AddGadgetItem tab, "First"
AddGadgetItem tab, "Second"
tv = CreateTreeView(10, 240, 200, 120, win)
r = TreeViewRoot(tv)
a = AddTreeViewNode("Animals", r)
AddTreeViewNode "Cat", a
AddTreeViewNode "Dog", a
b = AddTreeViewNode("Plants", r)
AddTreeViewNode "Tree", b
ExpandTreeViewNode a
cv = CreateCanvas(220, 250, 160, 100, win)
SetBuffer CanvasBuffer(cv)
Color 20, 40, 80
Rect 0, 0, 160, 100, 1
Color 255, 255, 0
Oval 20, 20, 60, 60, 1
SetBuffer BackBuffer()
FlipCanvas cv
SetStatusText win, "Ready"

Repeat
	id = WaitEvent()
	Select id
		Case $803 : End
		Case $1001 : SetStatusText win, "Menu " + EventData()
		Case $401 : SetStatusText win, "Gadget " + EventSource() + " data " + EventData()
	End Select
	If EventSource() = btn And id = $401 Then SetStatusText win, "Button"
	If id = $1001 And EventData() = 2 Then End
Forever
