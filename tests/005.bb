; 2D drawing through Vulkan. Runs for 5 seconds, or until Escape is pressed.
Graphics 640, 480, 32, 2
AppTitle "BlitzLLVM Graphics Test"
SetBuffer BackBuffer()
ClsColor 20, 30, 60

Local frames = 0
While frames < 300
	Cls

	Color 255, 0, 0 : Rect 20, 20, 100, 60, 1
	Color 0, 255, 0 : Rect 140, 20, 100, 60, 0
	Color 255, 255, 0 : Oval 260, 20, 100, 60, 1
	Color 255, 255, 255 : Oval 380, 20, 100, 60, 0
	Color 0, 200, 255 : Line 20, 120, 300, 200
	For i = 0 To 50
		Plot 320 + i, 120
	Next

	Color 255, 255, 255
	Text 20, 240, "Hello from Vulkan! Frame " + frames
	Text 320, 300, "Centered", True, True
	Rect 0, 0, GraphicsWidth(), GraphicsHeight(), False

	Flip
	frames = frames + 1
	If KeyHit(1) Then Exit
Wend
