; Renders a .x model and writes what LoadMesh made of it, for comparing BlitzLLVM with the original Blitz3D 1.118 (see
; tools/x_compare.sh). It only uses commands that both have, and writes "<name>.txt" (counts and a checksum of the vertices) and
; "<name>.bmp" (the picture). MODEL$, NAME$ and TIME# are replaced by the script.
Const MODEL$ = "@MODEL@"
Const NAME$ = "@NAME@"
Const TIME# = @TIME@

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; The mesh as LoadMesh makes it: where it is and how big.
stat = LoadMesh(MODEL$)
If stat = 0 Then
	f = WriteFile(NAME$ + ".txt")
	WriteLine f, "LoadMesh gave 0"
	CloseFile f
	End
EndIf
minx# = 1000000 : miny# = 1000000 : minz# = 1000000
maxx# = -1000000 : maxy# = -1000000 : maxz# = -1000000
verts = 0 : tris = 0 : sum# = 0 : nsum# = 0 : usum# = 0
f = WriteFile(NAME$ + ".txt")
For s = 1 To CountSurfaces(stat)
	sf = GetSurface(stat, s)
	verts = verts + CountVertices(sf)
	tris = tris + CountTriangles(sf)
	WriteLine f, "surface " + s + " " + CountVertices(sf) + " " + CountTriangles(sf) + " " + TextureOf$(sf)
	For v = 0 To CountVertices(sf) - 1
		x# = VertexX(sf, v) : y# = VertexY(sf, v) : z# = VertexZ(sf, v)
		If x < minx Then minx = x
		If y < miny Then miny = y
		If z < minz Then minz = z
		If x > maxx Then maxx = x
		If y > maxy Then maxy = y
		If z > maxz Then maxz = z
		sum = sum + x * 1.1 + y * 2.3 + z * 3.7 + VertexNX(sf, v) * 0.5 + VertexNY(sf, v) * 0.7 + VertexNZ(sf, v) * 0.9 + VertexU(sf, v) * 0.3 + VertexV(sf, v) * 0.2
		nsum = nsum + VertexNX(sf, v) * 0.5 + VertexNY(sf, v) * 0.7 + VertexNZ(sf, v) * 0.9
		usum = usum + VertexU(sf, v) * 0.3 + VertexV(sf, v) * 0.2
	Next
Next
WriteLine f, "surfaces " + CountSurfaces(stat)
WriteLine f, "vertices " + verts
WriteLine f, "triangles " + tris
WriteLine f, "min " + Int(minx * 100) + " " + Int(miny * 100) + " " + Int(minz * 100)
WriteLine f, "max " + Int(maxx * 100) + " " + Int(maxy * 100) + " " + Int(maxz * 100)
WriteLine f, "checksum " + Int(sum * 10)
WriteLine f, "normals " + Int(nsum * 10)
WriteLine f, "uvs " + Int(usum * 10)

anim = LoadAnimMesh(MODEL$)
WriteLine f, "animlength " + AnimLength(anim)
WriteLine f, "children " + CountChildren(anim)
If TIME >= 0 Then SetAnimTime anim, TIME
Global dumped = 0
DumpTree f, anim, 0
CloseFile f
FreeEntity stat

cx# = (minx + maxx) / 2 : cy# = (miny + maxy) / 2 : cz# = (minz + maxz) / 2
size# = maxx - minx
If maxy - miny > size Then size = maxy - miny
If maxz - minz > size Then size = maxz - minz
If size < 0.001 Then size = 1
If TIME >= 0 Then SetAnimTime anim, TIME

cam = CreateCamera()
CameraRange cam, size * 0.05, size * 20
CameraClsColor cam, 40, 50, 70
PositionEntity cam, cx + size * 0.6, cy + size * 0.6, cz - size * 1.8
pivot = CreatePivot()
PositionEntity pivot, cx, cy, cz
PointEntity cam, pivot
AmbientLight 80, 80, 80
light = CreateLight()
RotateEntity light, 40, 30, 0
RenderWorld
Flip
SaveBuffer FrontBuffer(), NAME$ + ".bmp"
End

; Each entity of the tree with where it is in the world, so that the poses at the time can be compared.
Function DumpTree(f, e, depth)
	If dumped > 300 Then Return
	dumped = dumped + 1
	WriteLine f, "node " + depth + " " + EntityName$(e) + " " + Int(EntityX(e, True) * 100) + " " + Int(EntityY(e, True) * 100) + " " + Int(EntityZ(e, True) * 100) + " " + Int(EntityPitch(e, True)) + " " + Int(EntityYaw(e, True)) + " " + Int(EntityRoll(e, True))
	For c = 1 To CountChildren(e)
		DumpTree f, GetChild(e, c), depth + 1
	Next
End Function

; The name of the picture of a surface without the folders, or "-".
Function TextureOf$(sf)
	b = GetSurfaceBrush(sf)
	t = GetBrushTexture(b)
	If t = 0 Then Return "-"
	n$ = TextureName$(t)
	For i = Len(n$) To 1 Step -1
		c$ = Mid$(n$, i, 1)
		If c$ = "/" Or c$ = "\" Then Return Mid$(n$, i + 1)
	Next
	Return n$
End Function
