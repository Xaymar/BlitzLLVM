; The type of a function without one comes from its Return statements.
Global shown% = 0

Function Show(value%)
	shown = shown + value
	Print "shown " + shown
End Function

Function Early(value%)
	If value = 0 Then Return
	Print "early " + value
End Function

Function Count()
	Return 3
End Function

Function Half()
	Return 1.5
End Function

Function Name()
	Return "name"
End Function

Function Mixed(flag%)
	If flag Then Return 1.5
	Return "text"
End Function

Function Blank(flag%)
	If flag Then Return 1.5
	Return
End Function

Show 2
Early 0
Early 4
Print Count()
Print Half()
Print Name()
Print Mixed(1)
Print Blank(0)
