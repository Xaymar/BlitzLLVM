; Declarations without a type, and variables that were never declared.
Const Limit = 10
Global total
Local lead, second = 5

Function Sum(count)
	For i = 1 To count
		result = result + i
	Next
	label$ = "sum"
	Return result
End Function

Function Greeting$(name$)
	message$ = "Hello " + name
	Return message
End Function

total = Sum(Limit) + lead + second
Print total
Print Greeting("tidy")
