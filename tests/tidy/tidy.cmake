################################################################################
# Tests for blitz-tidy, run as 'cmake -DCASE=<name> ... -P tidy.cmake'.
#
# Variables: TIDY (blitz-tidy), BLITZCC (the compiler), TESTS (tests/tidy), WORK (an empty directory to write to).
#
# CASE=fix runs every program in cases/ through blitz-tidy and expects the file in expected/. The result has to be left alone by a
# second run (idempotent), and the program has to print the same and return the same before and after (the fixes do not change it).
################################################################################
cmake_minimum_required(VERSION 3.20)

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# Run blitz-tidy in WORK, results are RC, OUT and ERR.
function(tidy)
	# A configuration file in a parent directory of the build must not change the results.
	if(NOT CASE STREQUAL "config")
		set(_CONFIG --no-config)
	endif()
	execute_process(
		COMMAND "${TIDY}" ${_CONFIG} ${ARGN}
		WORKING_DIRECTORY "${WORK}"
		RESULT_VARIABLE _RC
		OUTPUT_VARIABLE _OUT
		ERROR_VARIABLE _ERR
	)
	set(RC "${_RC}" PARENT_SCOPE)
	set(OUT "${_OUT}" PARENT_SCOPE)
	set(ERR "${_ERR}" PARENT_SCOPE)
endfunction()

macro(expect_rc EXPECTED)
	if(NOT RC EQUAL ${EXPECTED})
		message(FATAL_ERROR "Expected exit code ${EXPECTED}, got '${RC}'.\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
endmacro()

macro(expect_contains VARIABLE TEXT)
	string(FIND "${${VARIABLE}}" "${TEXT}" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected '${TEXT}' in ${VARIABLE}, got:\n${${VARIABLE}}")
	endif()
endmacro()

macro(expect_missing VARIABLE TEXT)
	string(FIND "${${VARIABLE}}" "${TEXT}" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Did not expect '${TEXT}' in ${VARIABLE}, got:\n${${VARIABLE}}")
	endif()
endmacro()

function(expect_same_file ACTUAL EXPECTED)
	file(READ "${ACTUAL}" _A)
	file(READ "${EXPECTED}" _E)
	if(NOT _A STREQUAL _E)
		message(FATAL_ERROR "${ACTUAL} is not ${EXPECTED}.\nGot:\n${_A}\nExpected:\n${_E}")
	endif()
endfunction()

# Compile and run a program next to its files, results are PROGRAM_RC and PROGRAM_OUT.
function(run_program FILE)
	execute_process(
		COMMAND "${BLITZCC}" -q "${FILE}"
		WORKING_DIRECTORY "${WORK}"
		RESULT_VARIABLE _RC
		OUTPUT_VARIABLE _OUT
		ERROR_VARIABLE _ERR
		TIMEOUT 120
	)
	set(PROGRAM_RC "${_RC}" PARENT_SCOPE)
	set(PROGRAM_OUT "${_OUT}${_ERR}" PARENT_SCOPE)
endfunction()

if(CASE STREQUAL "fix")
	# What each program needs besides the defaults.
	set(ARGS_dead_code --unsafe)
	file(GLOB _CASES "${TESTS}/cases/*.bb")
	foreach(_CASE IN LISTS _CASES)
		get_filename_component(_NAME "${_CASE}" NAME_WE)
		file(COPY "${_CASE}" DESTINATION "${WORK}")
		tidy(${ARGS_${_NAME}} "${WORK}/${_NAME}.bb")
		expect_rc(0)
		file(WRITE "${WORK}/${_NAME}.tidy.out" "${OUT}")
		expect_same_file("${WORK}/${_NAME}.tidy.out" "${TESTS}/expected/${_NAME}.bb")

		# Nothing is left to fix.
		file(COPY "${TESTS}/expected/${_NAME}.bb" DESTINATION "${WORK}/again")
		tidy(--check ${ARGS_${_NAME}} "${WORK}/again/${_NAME}.bb")
		expect_rc(0)

		# The same program: the same output and the same exit code.
		run_program("${_CASE}")
		set(_BEFORE_RC "${PROGRAM_RC}")
		set(_BEFORE_OUT "${PROGRAM_OUT}")
		run_program("${WORK}/again/${_NAME}.bb")
		if(NOT (_BEFORE_RC EQUAL PROGRAM_RC) OR NOT (_BEFORE_OUT STREQUAL PROGRAM_OUT))
			message(FATAL_ERROR "${_NAME} behaves differently after blitz-tidy.\nBefore (${_BEFORE_RC}): ${_BEFORE_OUT}\nAfter (${PROGRAM_RC}): ${PROGRAM_OUT}")
		endif()
		if(NOT _BEFORE_RC EQUAL 0)
			message(FATAL_ERROR "${_NAME} does not run: ${_BEFORE_OUT}")
		endif()
	endforeach()

elseif(CASE STREQUAL "check")
	file(COPY "${TESTS}/cases/conversions.bb" DESTINATION "${WORK}")
	tidy(--check "${WORK}/conversions.bb")
	expect_rc(1)
	expect_contains(OUT "conversions.bb")
	# --check does not change the file.
	expect_same_file("${WORK}/conversions.bb" "${TESTS}/cases/conversions.bb")
	tidy(--check "${TESTS}/expected/conversions.bb")
	expect_rc(0)

elseif(CASE STREQUAL "recursive")
	# -r takes every .bb, .b3d and .bp file below a directory, and nothing else.
	foreach(_FILE IN ITEMS a.bb sub/b.b3d sub/deeper/c.BP sub/deeper/notes.txt)
		get_filename_component(_DIRECTORY "${WORK}/tree/${_FILE}" DIRECTORY)
		file(MAKE_DIRECTORY "${_DIRECTORY}")
		file(COPY_FILE "${TESTS}/cases/conversions.bb" "${WORK}/tree/${_FILE}")
	endforeach()
	# A directory without -r is an error, and nothing is changed.
	tidy(--check "${WORK}/tree")
	expect_rc(2)
	expect_contains(ERR "use -r")
	tidy(-r --check "${WORK}/tree")
	expect_rc(1)
	expect_contains(OUT "tree/a.bb")
	expect_contains(OUT "tree/sub/b.b3d")
	expect_contains(OUT "tree/sub/deeper/c.BP")
	expect_missing(OUT "notes.txt")
	tidy(--recursive -i -q "${WORK}/tree")
	expect_rc(0)
	foreach(_FILE IN ITEMS a.bb sub/b.b3d sub/deeper/c.BP)
		expect_same_file("${WORK}/tree/${_FILE}" "${TESTS}/expected/conversions.bb")
	endforeach()
	# The other file is left alone, and now nothing is left to do.
	expect_same_file("${WORK}/tree/sub/deeper/notes.txt" "${TESTS}/cases/conversions.bb")
	tidy(-r --check "${WORK}/tree")
	expect_rc(0)
	# A directory without a source file is fine, a directory that is not there is not.
	file(MAKE_DIRECTORY "${WORK}/empty")
	tidy(-r --check "${WORK}/empty")
	expect_rc(0)
	tidy(-r --check "${WORK}/missing")
	expect_rc(2)

elseif(CASE STREQUAL "diff")
	file(COPY "${TESTS}/cases/conversions.bb" DESTINATION "${WORK}")
	tidy(--diff "${WORK}/conversions.bb")
	expect_rc(1)
	expect_contains(OUT "-Local a% = ratio")
	expect_contains(OUT "+Local a% = Int(ratio)")

elseif(CASE STREQUAL "in_place")
	file(COPY "${TESTS}/cases/declarations.bb" "${TESTS}/cases/labels.bb" DESTINATION "${WORK}")
	tidy(-i "${WORK}/declarations.bb" "${WORK}/labels.bb")
	expect_rc(0)
	expect_same_file("${WORK}/declarations.bb" "${TESTS}/expected/declarations.bb")
	expect_same_file("${WORK}/labels.bb" "${TESTS}/expected/labels.bb")
	# No temporary files are left behind.
	file(GLOB _LEFT "${WORK}/.blitz-tidy-*")
	if(_LEFT)
		message(FATAL_ERROR "Left behind: ${_LEFT}")
	endif()

elseif(CASE STREQUAL "stdin")
	execute_process(
		COMMAND "${TIDY}" --no-config --stdin-filepath=${WORK}/conversions.bb
		INPUT_FILE "${TESTS}/cases/conversions.bb"
		WORKING_DIRECTORY "${WORK}"
		RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR
	)
	expect_rc(0)
	file(WRITE "${WORK}/out.bb" "${OUT}")
	expect_same_file("${WORK}/out.bb" "${TESTS}/expected/conversions.bb")

elseif(CASE STREQUAL "rules")
	tidy(--rules)
	expect_rc(0)
	foreach(_RULE IN ITEMS implicit-lossy-int-to-int implicit-lossy-real-to-int implicit-lossy-real-to-real implicit-string-to-number implicit-lossy-int-to-real implicit-variable unused-result implicit-number-to-string unreachable-code unused-variable typeless-declaration unused-function)
		expect_contains(OUT "${_RULE}")
	endforeach()

elseif(CASE STREQUAL "rule_modes")
	# off: the rule is left alone. report: it is printed. fix: it is fixed.
	file(COPY "${TESTS}/cases/conversions.bb" DESTINATION "${WORK}")
	tidy(--implicit-lossy-real-to-int=off --implicit-lossy-int-to-real=report "${WORK}/conversions.bb")
	expect_rc(0)
	expect_contains(OUT "Local a% = ratio")
	expect_contains(OUT "Local b# = whole")
	expect_contains(ERR "[blitz-tidy:implicit-lossy-int-to-real]")
	expect_contains(OUT "Local c$ = Str(whole + 1)")
	tidy(--default=off --implicit-number-to-string "${WORK}/conversions.bb")
	expect_contains(OUT "Local c$ = Str(whole + 1)")
	expect_contains(OUT "Local d% = text")
	expect_missing(ERR "blitz-tidy:")

elseif(CASE STREQUAL "report_only")
	# unused-result has nothing to fix, so it can not be set to fix.
	tidy(--unused-result=fix "${TESTS}/cases/conversions.bb")
	expect_rc(2)
	expect_contains(ERR "can only be reported")
	tidy(--default=fix "${TESTS}/cases/conversions.bb")
	expect_rc(0)

elseif(CASE STREQUAL "unsafe")
	file(COPY "${TESTS}/cases/dead_code.bb" DESTINATION "${WORK}")
	tidy("${WORK}/dead_code.bb")
	expect_contains(OUT "Function Unused()")
	expect_contains(ERR "turn on \"unsafe\"")
	tidy(--unsafe "${WORK}/dead_code.bb")
	expect_missing(OUT "Function Unused()")

elseif(CASE STREQUAL "config")
	# .blitz-tidy in a directory, blitz-tidy.json in a directory below it, the nearest wins, and the command line wins over both.
	file(COPY "${TESTS}/config/" DESTINATION "${WORK}")
	tidy("${WORK}/sample.bb")
	expect_contains(OUT "Local i% = Int(r)")
	expect_contains(OUT "Local f# = i")
	expect_contains(OUT "Local u\n")
	expect_contains(ERR "[blitz-tidy:typeless-declaration]")
	tidy("${WORK}/sub/sample.bb")
	expect_contains(OUT "Local i% = r")
	expect_contains(OUT "Local f# = Float(i)")
	expect_contains(OUT "Local u:Int32")
	tidy(--implicit-lossy-real-to-int=off "${WORK}/sample.bb")
	expect_contains(OUT "Local i% = r")
	tidy(--no-config "${WORK}/sample.bb")
	expect_contains(OUT "Local i% = Int(r)")
	expect_contains(OUT "Local f# = Float(i)")
	tidy(--implicit-nothing=fix "${WORK}/sample.bb")
	expect_rc(2)
	expect_contains(ERR "There is no setting or rule")

elseif(CASE STREQUAL "include")
	# The file is compiled where it is, so what it includes is found.
	file(WRITE "${WORK}/lib.bb" "Function Twice(n%)\n\tReturn n * 2\nEnd Function\n")
	file(WRITE "${WORK}/main.bb" "Include \"lib.bb\"\nLocal x = Twice(2.5)\nPrint x\n")
	tidy("${WORK}/main.bb")
	expect_rc(0)
	expect_contains(OUT "Local x:Int32 = Twice(Int(2.5))")

elseif(CASE STREQUAL "broken")
	# A file that does not compile is not touched and is reported.
	file(WRITE "${WORK}/broken.bb" "Local x% = \nPrint x\n")
	tidy(--check "${WORK}/broken.bb")
	expect_rc(2)
	expect_contains(ERR "can't be checked")

else()
	message(FATAL_ERROR "Unknown case '${CASE}'.")
endif()
