; Declarations without a type, and variables that were never declared.
Const Limit% = 10
Global total%
Local lead%, second% = 5

Function Sum(count)
	Local i%
	Local result%
	For i = 1 To count
		result = result + i
	Next
	Local label$
	label$ = "sum"
	Return result
End Function

Function Greeting$(name$)
	Local message$
	message$ = "Hello " + name
	Return message
End Function

