; Declarations without a type, and variables that were never declared.
Const Limit:Int32 = 10
Global total:Int32
Local lead:Int32, second:Int32 = 5

Function Sum(count)
	Local i:Int32
	Local result:Int32
	For i = 1 To count
		result = result + i
	Next
	Local label:String
	label$ = "sum"
	Return result
End Function

Function Greeting$(name$)
	Local message:String
	message$ = "Hello " + name
	Return message
End Function

total = Sum(Limit) + lead + second
Print total
Print Greeting("tidy")
