; The program for autosuspend.py: it counts frames and writes how far it got to the file named in BLITZLLVM_TEST_PROGRESS, until
; the time in BLITZLLVM_TEST_SECONDS is over. It is suspended (or not) with AutoSuspend as BLITZLLVM_TEST_SUSPEND says.
Graphics 320, 240, 32, 2
SetBuffer BackBuffer()
AutoSuspend GetEnv$("BLITZLLVM_TEST_SUSPEND") = "1"
file$ = GetEnv$("BLITZLLVM_TEST_PROGRESS")
limit = Int(GetEnv$("BLITZLLVM_TEST_SECONDS")) * 1000
start = MilliSecs()
frame = 0
While MilliSecs() - start < limit
	Cls
	Flip
	frame = frame + 1
	If frame Mod 5 = 0
		out = WriteFile(file$ + ".tmp")
		WriteLine out, frame
		CloseFile out
		CopyFile file$ + ".tmp", file$
	EndIf
Wend
