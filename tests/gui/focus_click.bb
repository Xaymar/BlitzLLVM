; The program for focus_click.py: two windows, each with a canvas. It writes the clicks on the canvases ($201) to the file named in
; BLITZLLVM_TEST_PROGRESS, one letter per click naming the window ("-" while there was none yet), until the time in
; BLITZLLVM_TEST_SECONDS is over.
file$ = GetEnv$("BLITZLLVM_TEST_PROGRESS")
limit = Int(GetEnv$("BLITZLLVM_TEST_SECONDS")) * 1000
win_a = CreateWindow("FocusClickA", 40, 40, 200, 150, Desktop(), 1)
can_a = CreateCanvas(0, 0, 200, 150, win_a)
win_b = CreateWindow("FocusClickB", 320, 40, 200, 150, Desktop(), 1)
can_b = CreateCanvas(0, 0, 200, 150, win_b)
clicks$ = "-"
Report(file$, clicks$)
start = MilliSecs()
While MilliSecs() - start < limit
	If WaitEvent(50) = $201
		If EventSource() = can_a
			clicks$ = clicks$ + "A"
		ElseIf EventSource() = can_b
			clicks$ = clicks$ + "B"
		EndIf
		Report(file$, clicks$)
	EndIf
Wend

Function Report(file$, clicks$)
	out = WriteFile(file$ + ".tmp")
	WriteLine out, clicks$
	CloseFile out
	CopyFile file$ + ".tmp", file$
End Function
