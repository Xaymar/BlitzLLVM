; Input, clipboard and information about the graphics. Runs without a window, where input is always empty.
Graphics3D 320, 240, 32, 2
Check "no key", GetKey(), 0
Check "no mouse button", GetMouse(), 0
Check "no mouse movement", MouseXSpeed(), 0
FlushKeys
FlushMouse
FlushJoy
HidePointer
MoveMouse 10, 10

OpenClipboard 0
EmptyClipboard
Check "empty clipboard", ExamineClipboard(1), 0
SetClipboardData 1, "from Blitz"
Check "has text", ExamineClipboard(1), 1
CheckS "clipboard", GetClipboardData(1), "from Blitz"
CloseClipboard

Check "depth", GraphicsDepth(), 32
Check "mode exists", GfxMode3DExists(640, 480, 32), 1
Check "no triangles yet", TrisRendered(), 0
Check "no textures", ActiveTextures(), 0

Print "All input tests passed."

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function

Function CheckS(name$, got$, want$)
	If got <> want Then RuntimeError name + ": got '" + got + "', expected '" + want + "'"
End Function
