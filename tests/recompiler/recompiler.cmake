################################################################################
# Tests for blitz-recompiler, run as 'cmake -DCASE=<name> ... -P recompiler.cmake'.
#
# Variables: RECOMPILER, BLITZCC, TESTS (the tests directory), WORK (an empty directory to write to).
#
# The programs are the module of an executable of the original compiler (tests/recompiler/<case>/*.module, made from the .bb next to it with
# the original Blitz3D 1.118, the resource 1111 of the executable, which is all that blitz-recompiler reads; the runtime of the original is not
# kept here). The libraries are the ones that the original program called, built for this system.
################################################################################
cmake_minimum_required(VERSION 3.20)

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(recompiler)
	execute_process(
		COMMAND "${RECOMPILER}" ${ARGN}
		WORKING_DIRECTORY "${WORK}"
		RESULT_VARIABLE _RC
		OUTPUT_VARIABLE _OUT
		ERROR_VARIABLE _ERR
	)
	set(RC "${_RC}" PARENT_SCOPE)
	set(OUT "${_OUT}" PARENT_SCOPE)
	set(ERR "${_ERR}" PARENT_SCOPE)
endfunction()

# Build tests/recompiler/userlib/ulib.c as the library that ulib.decls names.
function(build_ulib DIR)
	set(_CC "$ENV{BLITZLLVM_CC}")
	if(NOT _CC)
		set(_CC clang)
	endif()
	file(MAKE_DIRECTORY "${DIR}")
	if(CMAKE_HOST_WIN32)
		set(_OUTPUT "${DIR}/ulib.dll")
	elseif(CMAKE_HOST_APPLE)
		set(_OUTPUT "${DIR}/libulib.dylib")
	else()
		set(_OUTPUT "${DIR}/libulib.so")
	endif()
	execute_process(COMMAND "${_CC}" -shared -fPIC "${TESTS}/recompiler/userlib/ulib.c" -o "${_OUTPUT}" RESULT_VARIABLE _RC ERROR_VARIABLE _ERR)
	if(NOT _RC EQUAL 0)
		message(FATAL_ERROR "Building the test library failed: ${_ERR}")
	endif()
	file(COPY "${TESTS}/recompiler/userlib/ulib.decls" DESTINATION "${DIR}")
endfunction()

macro(expect_ok)
	if(NOT RC EQUAL 0)
		message(FATAL_ERROR "Expected success, got '${RC}'.\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
endmacro()

macro(expect_failure)
	if(RC EQUAL 0)
		message(FATAL_ERROR "Expected a failure, got success.\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
endmacro()

macro(expect_in TEXT VAR)
	string(FIND "${${VAR}}" "${TEXT}" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected '${TEXT}' in ${VAR}, got:\n${${VAR}}")
	endif()
endmacro()

set(MODULE "${TESTS}/recompiler/userlib/call.module")

if(CASE STREQUAL "userlib")
	# The functions of a user library are called with the types of the declaration, from the libraries in the userlibs directory.
	build_ulib("${WORK}/userlibs")
	recompiler(-q --blitzcc "${BLITZCC}" --userlibs-dir "${WORK}/userlibs" "${MODULE}" -o "${WORK}/call")
	expect_ok()
	execute_process(COMMAND "${WORK}/call" RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
	expect_ok()
	if(NOT "${OUT}" MATCHES "^42\r?\n6.0\r?\nHELLO!\r?\n$")
		message(FATAL_ERROR "Expected the results of the three library functions, got:\n${OUT}")
	endif()

elseif(CASE STREQUAL "userlib_missing_declaration")
	# A function without a matching declaration is reported, and raises an error when the program reaches it (--strict refuses the program).
	file(MAKE_DIRECTORY "${WORK}/userlibs")
	recompiler(-q -S --userlibs-dir "${WORK}/userlibs" "${MODULE}" -o "${WORK}/call.ll")
	expect_ok()
	expect_in("the user library function 'addints' (_AddInts@8 in 'ulib.dll') has no declaration" ERR)
	recompiler(-q -S --strict --userlibs-dir "${WORK}/userlibs" "${MODULE}" -o "${WORK}/strict.ll")
	expect_failure()
	expect_in("has no declaration" ERR)
	# A declaration of another library does not match either.
	file(WRITE "${WORK}/userlibs/other.decls" ".lib \"other.dll\"\nAddInts%( a%,b% ):\"_AddInts@8\"\n")
	recompiler(-q -S --strict --userlibs-dir "${WORK}/userlibs" "${MODULE}" -o "${WORK}/strict.ll")
	expect_failure()

elseif(CASE STREQUAL "userlib_wide_parameter")
	# The program passes 32 bit values, so a declaration with a wider parameter can't be called from it.
	file(MAKE_DIRECTORY "${WORK}/userlibs")
	file(WRITE "${WORK}/userlibs/ulib.decls" ".lib \"ulib.dll\"\nAddInts:Int( a:Long,b:Int ):\"_AddInts@8\"\nScale#( v#,f# ):\"_Scale@8\"\nShout$( s$ ):\"_Shout@4\"\n")
	recompiler(-q -S --strict --userlibs-dir "${WORK}/userlibs" "${MODULE}" -o "${WORK}/call.ll")
	expect_failure()
	expect_in("passes only 32 bit values" ERR)

else()
	message(FATAL_ERROR "Unknown case '${CASE}'.")
endif()
