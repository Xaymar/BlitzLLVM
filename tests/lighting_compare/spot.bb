; Spot light profile: a finely subdivided quad lit by a spot light at several cone settings; the value along the row is written.
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Global out = WriteFile("spot.txt")

Global camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100

Global quad = CreateMesh()
s = CreateSurface(quad)
For iy = 0 To 1
For ix = 0 To 96
	v = AddVertex(s, -3 + ix * 6.0 / 96, 0.3 - iy * 0.6, 0)
	VertexNormal s, v, 0, 0, -1
Next
Next
For ix = 0 To 95
	AddTriangle s, ix, ix + 1, ix + 97
	AddTriangle s, ix + 1, ix + 98, ix + 97
Next
EntityColor quad, 20, 20, 20
AmbientLight 0, 0, 0

Global light = CreateLight(3)
PositionEntity light, 0, 0, -3
LightRange light, 100

Function Probe(name$)
	RenderWorld
	line$ = name$ + ":"
	For x = 32 To 128 Step 4
		p = ReadPixel(x, 60, BackBuffer())
		line$ = line$ + " " + ((p Shr 8) And 255)
	Next
	WriteLine out, line$
End Function

LightColor light, 255, 255, 255
EntityColor quad, 20, 20, 20
LightConeAngles light, 20, 60
Probe("20_60")
LightConeAngles light, 0, 90
Probe("0_90")
LightConeAngles light, 30, 90
Probe("30_90")
LightConeAngles light, 40, 80
Probe("40_80")
LightConeAngles light, 0, 60
Probe("0_60")
LightConeAngles light, 60, 60
Probe("60_60")
LightConeAngles light, 60, 20
Probe("60_20")
CloseFile out
End
