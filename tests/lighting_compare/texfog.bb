; Fog, texture blend modes, EntityBlend and EntityFX with a lit, textured quad. One row of pixels per case goes to texfog.txt.
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global out = WriteFile("texfog.txt")
Global camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 40, 60, 90
CameraRange camera, 0.1, 100

Global quad = CreateMesh()
s = CreateSurface(quad)
For iy = 0 To 8
For ix = 0 To 16
	v = AddVertex(s, -3 + ix * 6.0 / 16, 1.5 - iy * 3.0 / 8, ix * 0.5, ix / 16.0, iy / 8.0)
	VertexNormal s, v, 0, 0, -1
	VertexColor s, v, 255 - ix * 12, 60 + iy * 12, 128 + ix * 4 - iy * 4, 1.0 - ix / 40.0
Next
Next
For iy = 0 To 7
For ix = 0 To 15
	a = iy * 17 + ix
	AddTriangle s, a, a + 1, a + 17
	AddTriangle s, a + 1, a + 18, a + 17
Next
Next

Global tex = CreateTexture(32, 32, 3)
SetBuffer TextureBuffer(tex)
For y = 0 To 31
For x = 0 To 31
	WritePixel x, y, ((100 + x * 4) Shl 24) Or ((50 + x * 6) Shl 16) Or ((200 - y * 5) Shl 8) Or (80 + y * 5)
Next
Next
SetBuffer BackBuffer()
EntityTexture quad, tex
Global light = CreateLight()
RotateEntity light, 30, 20, 0
AmbientLight 60, 60, 60

Function Probe(name$)
	RenderWorld
	line$ = name$ + ":"
	For i = 0 To 7
		p = ReadPixel(16 + i * 18, 60, BackBuffer())
		line$ = line$ + " " + ((p Shr 16) And 255) + "," + ((p Shr 8) And 255) + "," + (p And 255)
	Next
	WriteLine out, line$
End Function

Probe("plain")
For b = 1 To 5
	TextureBlend tex, b
	Probe("textureblend_" + b)
Next
TextureBlend tex, 2
EntityColor quad, 200, 120, 60
Probe("color_blend2")
TextureBlend tex, 3
Probe("color_blend3")
TextureBlend tex, 2
For b = 1 To 3
	EntityBlend quad, b
	Probe("entityblend_" + b)
Next
EntityBlend quad, 1
EntityAlpha quad, 0.5
Probe("alpha_half")
EntityBlend quad, 3
Probe("alpha_half_add")
EntityAlpha quad, 1
For f = 1 To 31
	If f = 1 Or f = 2 Or f = 3 Or f = 4 Or f = 8 Or f = 16 Or f = 18 Or f = 19 Or f = 31 Then
		EntityFX quad, f
		Probe("fx_" + f)
	EndIf
Next
EntityFX quad, 0
EntityBlend quad, 1
CameraFogMode camera, 1
CameraFogRange camera, 2, 9
CameraFogColor camera, 200, 100, 50
Probe("fog_linear")
EntityFX quad, 8
Probe("fog_nofog_fx")
EntityFX quad, 0
EntityBlend quad, 3
Probe("fog_add")
EntityBlend quad, 2
Probe("fog_multiply")
CloseFile out
End
