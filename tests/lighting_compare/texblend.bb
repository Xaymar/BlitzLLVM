; TextureBlend modes 0 to 5 with and without an alpha channel in the texture, with and without vertex colors, on a lit quad.
; One row of pixels per case goes to texblend.txt.
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global out = WriteFile("texblend.txt")
Global camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 40, 60, 90
CameraRange camera, 0.1, 100

Global quad = CreateMesh()
s = CreateSurface(quad)
For iy = 0 To 8
For ix = 0 To 16
	v = AddVertex(s, -3 + ix * 6.0 / 16, 1.5 - iy * 3.0 / 8, ix * 0.5, ix / 16.0, iy / 8.0)
	VertexNormal s, v, 0, 0, -1
	VertexColor s, v, 255 - ix * 12, 60 + iy * 12, 128 + ix * 4 - iy * 4, 1.0 - ix / 40.0
Next
Next
For iy = 0 To 7
For ix = 0 To 15
	a = iy * 17 + ix
	AddTriangle s, a, a + 1, a + 17
	AddTriangle s, a + 1, a + 18, a + 17
Next
Next

Global tex = CreateTexture(32, 32, 3 + 4096)
SetBuffer TextureBuffer(tex)
For y = 0 To 31
For x = 0 To 31
	WritePixel x, y, ((100 + x * 4) Shl 24) Or ((50 + x * 6) Shl 16) Or ((200 - y * 5) Shl 8) Or (80 + y * 5)
Next
Next
SetBuffer BackBuffer()
EntityTexture quad, tex
Global light = CreateLight()
RotateEntity light, 30, 20, 0
AmbientLight 60, 60, 60

Function Probe(name$)
	RenderWorld
	line$ = name$ + ":"
	For i = 0 To 7
		p = ReadPixel(16 + i * 18, 60, BackBuffer())
		line$ = line$ + " " + ((p Shr 16) And 255) + "," + ((p Shr 8) And 255) + "," + (p And 255)
	Next
	WriteLine out, line$
End Function

Global tex2 = CreateTexture(32, 32, 1 + 4096)
SetBuffer TextureBuffer(tex2)
For y = 0 To 31
For x = 0 To 31
	WritePixel x, y, ((30 + x * 6) Shl 16) Or ((220 - y * 6) Shl 8) Or (60 + x * 3)
Next
Next
SetBuffer BackBuffer()
EntityColor quad, 230, 200, 160
For t = 0 To 1
	If t = 1 Then EntityTexture quad, tex2
	For fx = 0 To 2 Step 2
		EntityFX quad, fx
		For b = 0 To 5
			TextureBlend tex, b
			TextureBlend tex2, b
			Probe("tex" + t + "_fx" + fx + "_blend" + b)
		Next
	Next
Next
CloseFile out
End
