; Smooth-shaded terrain from UpdateNormals with vertex colors, one directional light and ambient light, as in the waterfall benchmark.
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Height#(x#, z#)
	Return 1.5 * Sin(x * 9) * Cos(z * 7) + 0.4 * x
End Function

m = CreateMesh()
s = CreateSurface(m)
For iz = 0 To 24
	For ix = 0 To 24
		x# = ix - 12
		z# = iz - 12
		AddVertex s, x, Height(x, z), z
		VertexColor s, iz * 25 + ix, 55 + ix * 6, 115 + iz * 3, 45 + (ix + iz) * 2
	Next
Next
For iz = 0 To 23
	For ix = 0 To 23
		a = iz * 25 + ix
		AddTriangle s, a, a + 25, a + 1
		AddTriangle s, a + 1, a + 25, a + 26
	Next
Next
UpdateNormals m
EntityFX m, 2

camera = CreateCamera()
CameraClsColor camera, 150, 185, 225
PositionEntity camera, 0, 14, -16
RotateEntity camera, 40, 0, 0
light = CreateLight()
RotateEntity light, 50, -30, 0
AmbientLight 90, 90, 90

RenderWorld
SaveBuffer(BackBuffer(), "terrain.bmp")
End
