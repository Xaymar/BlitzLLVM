; Lighting probe: renders a subdivided quad that faces the camera under many light setups and writes pixel rows.
; Works with the original Blitz3D and BlitzLLVM, so both outputs can be compared.
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Global out = WriteFile("lighting.txt")

Global camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100

; 16x16 quads, 6 wide, normals towards the camera, vertex colors as a gradient.
Global quad = CreateMesh()
s = CreateSurface(quad)
For iy = 0 To 16
For ix = 0 To 16
	v = AddVertex(s, -3 + ix * 6.0 / 16, 3 - iy * 6.0 / 16, 0)
	VertexNormal s, v, 0, 0, -1
	VertexColor s, v, 255 - ix * 12, 60 + iy * 12, 128 + ix * 4 - iy * 4
Next
Next
For iy = 0 To 15
For ix = 0 To 15
	a = iy * 17 + ix
	AddTriangle s, a, a + 1, a + 17
	AddTriangle s, a + 1, a + 18, a + 17
Next
Next

Global light = CreateLight()

Function Probe(name$)
	RenderWorld
	line$ = name$ + ":"
	For i = 0 To 7
		x = 16 + i * 18
		p = ReadPixel(x, 60, BackBuffer())
		line$ = line$ + " " + ((p Shr 16) And 255) + "," + ((p Shr 8) And 255) + "," + (p And 255)
	Next
	WriteLine out, line$
	SaveBuffer(BackBuffer(), name$ + ".bmp")
End Function

; --- directional
AmbientLight 0, 0, 0
RotateEntity light, 30, 20, 0
EntityColor quad, 200, 100, 50
Probe("dir_color")
AmbientLight 90, 90, 90
Probe("dir_color_amb90")
EntityFX quad, 2
Probe("dir_vc_amb90")
EntityColor quad, 20, 20, 20
Probe("dir_vc_amb90_entity20")
EntityFX quad, 1
Probe("fullbright")
EntityFX quad, 0
AmbientLight 0, 0, 0
LightColor light, 128, 255, 0
EntityColor quad, 255, 255, 255
Probe("dir_lightcolor")
LightColor light, 255, 255, 255
EntityColor quad, 255, 255, 255
AmbientLight 200, 200, 200
Probe("dir_amb200_overbright")
LightColor light, 255, 255, 255

; --- point
FreeEntity light
light = CreateLight(2)
PositionEntity light, 0, 0, -3
AmbientLight 0, 0, 0
EntityColor quad, 100, 100, 100
LightRange light, 10
Probe("point_r10")
LightRange light, 5
Probe("point_r5")
LightRange light, 100
Probe("point_r100")
LightRange light, 1000
Probe("point_r1000")
PositionEntity light, 0, 0, -0.5
LightRange light, 10
Probe("point_close_r10")
PositionEntity light, 0, 0, -3
EntityColor quad, 100, 100, 100
LightRange light, 10
EntityFX quad, 2
Probe("point_vc_r10")
EntityFX quad, 0

; --- spot
FreeEntity light
light = CreateLight(3)
PositionEntity light, 0, 0, -3
LightRange light, 20
EntityColor quad, 150, 150, 150
LightConeAngles light, 20, 60
Probe("spot_20_60")
LightConeAngles light, 0, 90
Probe("spot_0_90")
LightConeAngles light, 45, 45
Probe("spot_45_45")
LightConeAngles light, 10, 120
Probe("spot_10_120")

; --- specular
FreeEntity light
light = CreateLight(2)
PositionEntity light, 1, 1, -3
LightRange light, 20
EntityColor quad, 60, 60, 60
EntityShininess quad, 0.5
Probe("spec_05")
EntityShininess quad, 1
Probe("spec_1")
EntityShininess quad, 0.1
Probe("spec_01")
EntityShininess quad, 0
FreeEntity light
light = CreateLight()
RotateEntity light, 30, 20, 0
EntityShininess quad, 0.7
Probe("spec_dir_07")
EntityShininess quad, 0

; --- two lights
l2 = CreateLight(2)
PositionEntity l2, -1, 0, -2
LightRange l2, 8
LightColor l2, 0, 200, 255
EntityColor quad, 120, 120, 120
AmbientLight 30, 30, 30
Probe("two_lights")
; --- negative light
LightColor l2, -255, -255, -255
Probe("negative_light")

CloseFile out
End
