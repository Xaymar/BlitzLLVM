; Texture flag 1024 (point sampling) on the original Blitz3D: a two texel texture magnified over a cube face and a
; checker with mip maps far away, with and without the flag. Every case writes one row of pixels to pointflag.txt.
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global out = WriteFile("pointflag.txt")
Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
Global cube = CreateCube()
EntityFX cube, 1

Function Row(name$, y)
	Local s$ = name$ + ":"
	For x = 0 To 159 Step 8
		p = ReadPixel(x, y, BackBuffer())
		s$ = s$ + " " + ((p Shr 16) And 255) + "," + ((p Shr 8) And 255) + "," + (p And 255)
	Next
	WriteLine out, s$
End Function

Function Strip(flags)
	t = CreateTexture(2, 1, flags + 4096)
	SetBuffer TextureBuffer(t)
	WritePixel 0, 0, $FFFF0000
	WritePixel 1, 0, $FF0000FF
	SetBuffer BackBuffer()
	Return t
End Function

Function Checker(flags)
	t = CreateTexture(64, 64, flags + 4096)
	SetBuffer TextureBuffer(t)
	For y = 0 To 63
	For x = 0 To 63
		If ((x / 2) + (y / 2)) Mod 2 = 0 Then WritePixel x, y, $FFFFFFFF Else WritePixel x, y, $FF000000
	Next
	Next
	SetBuffer BackBuffer()
	Return t
End Function

Function Show(t, dist#, name$)
	EntityTexture cube, t
	PositionEntity cube, 0, 0, dist# + 1
	RenderWorld
	Row name$, 60
	Flip
	SaveBuffer FrontBuffer(), name$ + ".bmp"
End Function

ClearTextureFilters
Show Strip(0), 2, "mag_0"
Show Strip(1024), 2, "mag_1024"
Show Strip(1), 2, "mag_1"
Show Strip(1025), 2, "mag_1025"
Show Checker(8), 20, "mip_8"
Show Checker(8 + 1024), 20, "mip_1032"
Show Checker(0), 20, "min_0"
Show Checker(1024), 20, "min_1024"
CloseFile out
End
