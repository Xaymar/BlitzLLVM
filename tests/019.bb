; Looking at meshes, names, copies and converting between spaces. Stops with an error if anything is off.
Local cube = CreateCube()
Check "surfaces", CountSurfaces(cube), 1
Local surf = GetSurface(cube, 1)
Check "vertices", CountVertices(surf), 24
Check "triangles", CountTriangles(surf), 12
Check "width", MeshWidth(cube), 2
Check "height", MeshHeight(cube), 2
Check "depth", MeshDepth(cube), 2
Check "vertex x", Abs(VertexX(surf, 0)), 1
Check "normal length", Abs(VertexNX(surf, 0)) + Abs(VertexNY(surf, 0)) + Abs(VertexNZ(surf, 0)), 1
Check "corner", (TriangleVertex(surf, 0, 2) < 24), 1

ScaleMesh cube, 2, 3, 4
Check "scaled width", MeshWidth(cube), 4
Check "scaled depth", MeshDepth(cube), 8

; Names are found in the whole hierarchy, whatever case they are in.
Local root = CreatePivot()
NameEntity root, "Root"
Local arm = CreatePivot(root)
NameEntity arm, "Arm"
Local hand = CreatePivot(arm)
NameEntity hand, "Hand"
Check "found child", FindChild(root, "arm"), arm
Check "found grandchild", FindChild(root, "HAND"), hand
Check "not found", FindChild(root, "foot"), 0
CheckS "entity name", EntityName(hand), "Hand"

; Copies are separate entities, that still have what the original has.
PositionEntity arm, 1, 2, 3
EntityColor cube, 255, 0, 0
Local copy = CopyEntity(root)
Check "copy is new", (copy <> root), 1
Local copied_arm = FindChild(copy, "Arm")
Check "copied child", (copied_arm <> arm And copied_arm <> 0), 1
Check "copied position", EntityY(copied_arm), 2
PositionEntity arm, 0, 0, 0
Check "copy stays", EntityY(copied_arm), 2

Local mesh_copy = CopyEntity(cube)
Check "copied mesh", CountVertices(GetSurface(mesh_copy, 1)), 24
FreeEntity cube
Check "the copy keeps the mesh", CountVertices(GetSurface(mesh_copy, 1)), 24

; Positions can be converted between the spaces of entities.
Local parent = CreatePivot()
PositionEntity parent, 10, 0, 0
RotateEntity parent, 0, 90, 0
TFormPoint 1, 0, 0, parent, 0
Check "point to world x", TFormedX(), 10
Check "point to world z", TFormedZ(), -1
TFormPoint 10, 0, -1, 0, parent
Check "point from world x", TFormedX(), 1
Check "point from world z", TFormedZ(), 0
TFormVector 0, 0, 1, parent, 0
Check "vector", TFormedX(), 1
TFormNormal 0, 0, 5, parent, 0
Check "normal length", TFormedX(), 1

; Turning to face things.
Local looker = CreatePivot()
Local target = CreatePivot()
PositionEntity target, 10, 0, 0
Check "yaw to face", DeltaYaw(looker, target), 90
RotateEntity looker, 0, 90, 0
Check "already facing", DeltaYaw(looker, target), 0
PositionEntity target, 0, 10, 0
Check "pitch up", DeltaPitch(looker, target), -90

Print "All entity query tests passed."

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function

Function CheckS(name$, got$, want$)
	If got <> want Then RuntimeError name + ": got '" + got + "', expected '" + want + "'"
End Function
