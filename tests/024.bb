; Drawing to textures: a second camera renders a spinning cube into a texture, 2D is drawn on top of it, and the
; texture is then shown on a plane in the main view. Runs for 5 seconds, or until Escape is pressed.
Graphics3D 640, 480, 32, 2
AppTitle "BlitzLLVM Render Target Test"
SetBuffer BackBuffer()

; The texture that is drawn to.
Local target = CreateTexture(128, 128, 1 + 256)
If target = 0 Then RuntimeError "Could not create the texture."
Check "texture width", TextureWidth(target), 128
Check "texture height", TextureHeight(target), 128

; Main view: a plane that shows the texture.
Local camera = CreateCamera()
PositionEntity camera, 0, 0, -4
CameraClsColor camera, 20, 30, 60
Local light = CreateLight()
RotateEntity light, 40, 30, 0
Local screen = CreatePlane(1)
Check "plane exists", (screen <> 0), 1
FreeEntity screen
screen = CreateCube()
ScaleEntity screen, 1.5, 1.5, 0.05
EntityTexture screen, target
EntityFX screen, 1

; The view that is drawn into the texture: a smaller, different world to the main view.
Local scene_camera = CreateCamera()
CameraClsColor scene_camera, 200, 120, 40
PositionEntity scene_camera, 100, 0, 96
HideEntity scene_camera
Local scene_light = CreateLight()
Local spinner = CreateCube()
PositionEntity spinner, 100, 0, 100
EntityColor spinner, 255, 80, 80

Local frames = 0
While frames < 300
	TurnEntity spinner, 1, 2, 0.5

	; Texture: render the scene, then draw text over it.
	HideEntity camera
	ShowEntity scene_camera
	SetBuffer TextureBuffer(target)
	RenderWorld
	Color 255, 255, 255
	Text 4, 4, "texture"
	Rect 0, 0, 128, 128, False
	SetBuffer BackBuffer()
	HideEntity scene_camera
	ShowEntity camera

	TurnEntity screen, 0, 0.5, 0
	RenderWorld
	Flip
	frames = frames + 1
	If KeyHit(1) Then Exit
Wend

Function Check(name$, got#, want#, tolerance# = 0.001)
	If Abs(got - want) > tolerance Then RuntimeError name + ": got " + got + ", expected " + want
End Function
