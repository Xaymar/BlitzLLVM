; More of 3D: fog, planes, sprites, blending, draw order, fading and finding things on the screen.
; Needs to be run from this directory. Runs for a few seconds, or until Escape is pressed.
Graphics3D 640, 480, 32, 2
AppTitle "BlitzLLVM 3D Test 2"
SetBuffer BackBuffer()

Local texture = LoadTexture("checker.png")

Local camera = CreateCamera()
PositionEntity camera, 0, 2, -12
RotateEntity camera, 8, 0, 0
CameraClsColor camera, 60, 90, 130
CameraFogMode camera, True
CameraFogRange camera, 8, 60
CameraFogColor camera, 60, 90, 130
CameraRange camera, 0.5, 200

Local light = CreateLight()
RotateEntity light, 50, 20, 0
AmbientLight 70, 70, 70

; A big floor with the texture repeated on it, and cubes along a line that disappear into the fog.
Local floor = CreatePlane()
EntityTexture floor, texture
ScaleTexture texture, 4, 4
PositionEntity floor, 0, -1.5, 0

Local nearest
For i = 0 To 7
	Local c = CreateCube()
	PositionEntity c, -3 + (i Mod 2) * 6, 0, i * 8
	EntityColor c, 255 - i * 25, 120, i * 30
	If i = 0 Then nearest = c
Next

; Sprites face the camera, whichever way it looks.
Local sprite = CreateSprite()
EntityTexture sprite, texture
PositionEntity sprite, 0, 2.5, 6
ScaleSprite sprite, 1.5, 1.5

; Blending: an additive and a multiplying sphere.
Local glow = CreateSphere(16)
EntityColor glow, 255, 160, 40
EntityBlend glow, 3
PositionEntity glow, -4, 1, 3
Local shade = CreateSphere(16)
EntityColor shade, 80, 80, 255
EntityBlend shade, 2
PositionEntity shade, 4, 1, 3

; Faded with distance: gone beyond 40 units.
Local fader = CreateCube()
EntityAutoFade fader, 10, 40
PositionEntity fader, 0, 0, 25

; A cube that is always in front, whatever is in the way.
Local front = CreateCube()
EntityOrder front, -1
EntityColor front, 255, 255, 0
PositionEntity front, 0, 0, 40
ScaleEntity front, 0.2, 0.2, 0.2

; Finding things on the screen.
CameraProject camera, EntityX(nearest), EntityY(nearest), EntityZ(nearest)
Check "projected x", (ProjectedX() > 0 And ProjectedX() < 640), 1
Check "projected y", (ProjectedY() > 0 And ProjectedY() < 480), 1
Check "projected z", ProjectedZ() > 0, 1
Check "in view", EntityInView(nearest, camera), 1
Local behind = CreatePivot()
PositionEntity behind, 0, 0, -50
Check "behind the camera", EntityInView(behind, camera), 0

Local count = 0
While count < 400
	TurnEntity glow, 0, 1, 0
	MoveEntity camera, 0, 0, 0.01
	RenderWorld
	Color 255, 255, 255
	Text 10, 10, "Fog, planes, sprites and blends " + count
	Flip
	count = count + 1
	If KeyHit(1) Then Exit
Wend
Print "All 3D test 2 checks passed."

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function
