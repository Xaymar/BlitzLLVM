; TCP and UDP, talking to ourselves. Stops with an error if anything is off.
Local localhost = 127 + 1 * 16777216
CheckS "dotted ip", DottedIP(localhost), "127.0.0.1"
TCPTimeouts 3000, 3000

; UDP: what is written is sent as one message.
Local a = CreateUDPStream()
Local b = CreateUDPStream()
If a = 0 Or b = 0 Then RuntimeError "Could not create UDP streams"
Check "own ports differ", (UDPStreamPort(a) <> UDPStreamPort(b)), 1

WriteInt a, 42
WriteString a, "hello"
SendUDPMsg a, localhost, UDPStreamPort(b)

Local size = 0
For tries = 1 To 100
	size = RecvUDPMsg(b)
	If size > 0 Then Exit
	Delay 20
Next
Check "message size", size, 4 + 4 + 5
Check "message port", UDPMsgPort(b), UDPStreamPort(a)
Check "message int", ReadInt(b), 42
CheckS "message string", ReadString(b), "hello"
CloseUDPStream a
CloseUDPStream b

; TCP: a server, and a client that connects to it.
Local server = CreateTCPServer(38123)
If server = 0 Then RuntimeError "Could not create the server"
Local client = OpenTCPStream("127.0.0.1", 38123)
If client = 0 Then RuntimeError "Could not connect"
Local peer = AcceptTCPStream(server)
If peer = 0 Then RuntimeError "Nobody was accepted"

WriteLine client, "ping"
WriteInt client, 1234
CheckS "server got line", ReadLine(peer), "ping"
Check "server got int", ReadInt(peer), 1234
WriteString peer, "pong"
CheckS "client got string", ReadString(client), "pong"

CloseTCPStream client
CloseTCPStream peer
CloseTCPServer server

Print "All network tests passed."

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function

Function CheckS(name$, got$, want$)
	If got <> want Then RuntimeError name + ": got '" + got + "', expected '" + want + "'"
End Function
