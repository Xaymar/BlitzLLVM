; Loading models and animating them, without a window. Stops with an error if anything is off.
Const MODEL$ = "stranded2/mods/Stranded II/gfx/pirate.b3d"

Local still = LoadMesh(MODEL)
Check "loaded mesh", (still <> 0), 1
Check "surfaces", (CountSurfaces(still) > 1), 1
Check "bigger than nothing", MeshHeight(still) > 10, 1

Local man = LoadAnimMesh(MODEL)
Check "loaded animated mesh", (man <> 0), 1
Check "not playing", Animating(man), 0
Check "still on its own", Animating(still), 0

Animate man, 1, 1
Check "playing", Animating(man), 1
Local seq = ExtractAnimSeq(man, 5, 15)
Check "new sequence", seq, 1
Animate man, 3, 1, seq
Check "playing sequence", Animating(man), 1

; Time passes for the animation.
For i = 1 To 30
	Delay 20
	UpdateWorld
Next
Check "one-shot ended", Animating(man), 0

; Copies move on their own.
Animate man, 1, 1
Local twin = CopyEntity(man)
Check "copy plays too", Animating(twin), 1
Animate twin, 0
Check "copy stops", Animating(twin), 0
Check "original goes on", Animating(man), 1

Print "All model tests passed."

Function Check(name$, got#, want#, tolerance# = 0.001)
	If Abs(got - want) > tolerance Then RuntimeError name + ": got " + got + ", expected " + want
End Function
