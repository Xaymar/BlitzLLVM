; Textures on 3D objects. Needs to be run from this directory. Runs for 5 seconds, or until Escape is pressed.
Graphics3D 640, 480, 32, 2
AppTitle "BlitzLLVM Texture Test"
SetBuffer BackBuffer()

Local texture = LoadTexture("checker.png")
If texture = 0 Then RuntimeError "Could not load checker.png, run this from the tests directory."
If TextureWidth(texture) <> 64 Then RuntimeError "Unexpected texture width " + TextureWidth(texture)

Local camera = CreateCamera()
PositionEntity camera, 0, 0, -7
CameraClsColor camera, 20, 30, 60

Local light = CreateLight()
RotateEntity light, 35, 25, 0
AmbientLight 80, 80, 80

Local cube = CreateCube()
EntityTexture cube, texture
PositionEntity cube, -2.2, 0, 0

Local sphere = CreateSphere(24)
EntityTexture sphere, texture
PositionEntity sphere, 2.2, 0, 0

Local frames = 0
While frames < 300
	TurnEntity cube, 0.7, 1, 0.3
	TurnEntity sphere, 0, 1.5, 0
	RenderWorld
	Flip
	frames = frames + 1
	If KeyHit(1) Then Exit
Wend
