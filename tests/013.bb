; Files, directories and banks. Needs to be run from this directory, and stops with an error if anything is off.
Local dir$ = "013_files"
If FileType(dir) = 0 Then CreateDir dir
Check "directory", FileType(dir), 2

Local path$ = dir + "\data.bin"
Local f = WriteFile(path)
If f = 0 Then RuntimeError "Could not write " + path
WriteByte f, 200
WriteShort f, 40000
WriteInt f, -123456
WriteFloat f, 1.5
WriteString f, "Hello"
WriteLine f, "first line"
WriteLine f, "second line"
CloseFile f

Check "file type", FileType(path), 1
Check "file size", FileSize(path), 1 + 2 + 4 + 4 + 4 + 5 + 12 + 13

f = ReadFile(path)
Check "byte", ReadByte(f), 200
Check "short", ReadShort(f), 40000
Check "int", ReadInt(f), -123456
Check "float", ReadFloat(f), 1.5
CheckS "string", ReadString(f), "Hello"
Check "not at the end", Eof(f), 0
CheckS "line 1", ReadLine(f), "first line"
CheckS "line 2", ReadLine(f), "second line"
Check "at the end", Eof(f), 1
CloseFile f

CopyFile path, dir + "\copy.bin"
Check "copy", FileSize(dir + "\copy.bin"), FileSize(path)

; Directories list "." and ".." too.
Local d = ReadDir(dir)
Local names$ = "", count = 0
Local n$ = NextFile(d)
While n <> ""
	If n <> "." And n <> ".." Then names = names + n + ";" : count = count + 1
	n = NextFile(d)
Wend
CloseDir d
Check "directory entries", count, 2
Check "data.bin listed", (Instr(names, "data.bin") > 0), 1

DeleteFile path
DeleteFile dir + "\copy.bin"
Check "deleted", FileType(path), 0

; Banks
Local bank = CreateBank(16)
Check "bank size", BankSize(bank), 16
PokeByte bank, 0, 255
PokeShort bank, 1, 513
PokeInt bank, 4, 305419896
PokeFloat bank, 8, 2.25
Check "peek byte", PeekByte(bank, 0), 255
Check "peek short", PeekShort(bank, 1), 513
Check "peek int", PeekInt(bank, 4), 305419896
Check "peek float", PeekFloat(bank, 8), 2.25
ResizeBank bank, 32
Check "resized", BankSize(bank), 32
Check "kept", PeekInt(bank, 4), 305419896
Check "new bytes are 0", PeekInt(bank, 28), 0
Local other = CreateBank(8)
CopyBank bank, 4, other, 0, 4
Check "copied", PeekInt(other, 0), 305419896
FreeBank bank
FreeBank other

CheckS "LSet", LSet("ab", 4) + "|", "ab  |"
CheckS "LSet cut", LSet("abcdef", 3), "abc"
CheckS "RSet", RSet("ab", 4), "  ab"

Print "All file and bank tests passed."

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function

Function CheckS(name$, got$, want$)
	If got <> want Then RuntimeError name + ": got '" + got + "', expected '" + want + "'"
End Function
