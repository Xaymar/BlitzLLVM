; Opens the window the test names with the first argument (before: AppTitle runs before Graphics, after: it runs after Graphics) and stays for three seconds. tests/cli/app_title.py reads the title of the window.
Local mode$ = CommandLine$()
If Instr(mode$, "before") > 0
	AppTitle "Title before Graphics"
	Graphics3D 64, 64, 0, 2
Else
	Graphics3D 64, 64, 0, 2
	AppTitle "Title after Graphics"
EndIf
DebugLog "started"
For i = 1 To 300
	Delay 10
Next
