; Makes meshes, draws them until their draws are in the table of static draws, frees every other one and makes textures. BLITZLLVM_DEFRAG_TEST=1
; moves the memory of the allocator together before each texture is made, which moves the vertex and index buffers of the meshes that are left.
; They must still be drawn, with the colors they had, and a mesh that is changed afterwards must show the change.
Graphics3D 128, 128, 0, 2
SetBuffer BackBuffer()
Dim cube(15)
Global cam = CreateCamera()
Local i

Function Frames(count)
	Local n
	For n = 1 To count
		RenderWorld
		Flip
	Next
	RenderWorld
End Function

; The color of the centre of a mesh must be the one it was given.
Function CheckCube(c, number, red, green, blue)
	CameraProject cam, EntityX(c), EntityY(c), EntityZ(c)
	Local pixel = ReadPixel(ProjectedX(), ProjectedY(), BackBuffer())
	If Abs(((pixel Shr 16) And 255) - red) > 2 Or Abs(((pixel Shr 8) And 255) - green) > 2 Or Abs((pixel And 255) - blue) > 2 Then RuntimeError "mesh " + number + " is drawn wrong: " + Hex$(pixel And $FFFFFF)
End Function

For i = 0 To 15
	cube(i) = CreateCube()
	ScaleEntity cube(i), 0.5, 0.5, 0.5
	PositionEntity cube(i), ((i Mod 4) - 1.5) * 3, ((i / 4) - 1.5) * 3, 20
	EntityFX cube(i), 1
	EntityColor cube(i), 40 + i * 12, 255 - i * 12, 100
Next
Frames 8

For i = 1 To 15 Step 2
	FreeEntity cube(i)
	cube(i) = 0
Next
Frames 2

Dim tex(7)
For i = 0 To 7
	tex(i) = CreateTexture(256, 256, 1 + 4096)
Next

Frames 8
For i = 0 To 15 Step 2
	CheckCube cube(i), i, 40 + i * 12, 255 - i * 12, 100
Next

; A mesh that is changed after it moved shows the change, and so do new ones.
EntityColor cube(0), 10, 20, 250
Frames 8
CheckCube cube(0), 0, 10, 20, 250
cube(1) = CreateCube()
ScaleEntity cube(1), 0.5, 0.5, 0.5
PositionEntity cube(1), -1.5, -4.5, 20
EntityFX cube(1), 1
EntityColor cube(1), 200, 100, 50
Frames 8
CheckCube cube(1), 1, 200, 100, 50
DebugLog "defrag mesh ok"
End
