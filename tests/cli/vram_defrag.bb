; Makes textures, frees every other one and makes more. BLITZLLVM_DEFRAG_TEST=1 moves the memory of the textures together before each one is
; made, and what is drawn on the textures that moved must still be there afterwards.
Graphics 64, 64, 0, 2
Dim tex(15)
Local i, r
For i = 0 To 15
	tex(i) = CreateTexture(256, 256, 1 + 4096)
	SetBuffer TextureBuffer(tex(i))
	Color i * 15, 255 - i * 15, 100
	Rect 0, 0, 256, 256, 1
Next
For i = 0 To 15 Step 2
	FreeTexture tex(i)
	tex(i) = 0
Next
For i = 0 To 15 Step 2
	tex(i) = CreateTexture(256, 256, 1 + 4096)
	SetBuffer TextureBuffer(tex(i))
	Color 7, 8, 9
	Rect 0, 0, 256, 256, 1
Next
For i = 0 To 15
	SetBuffer TextureBuffer(tex(i))
	LockBuffer TextureBuffer(tex(i))
	r = ReadPixel(10, 10) And $FFFFFF
	UnlockBuffer TextureBuffer(tex(i))
	If i Mod 2 = 1 Then
		If r <> ((i * 15) Shl 16) + ((255 - i * 15) Shl 8) + 100 Then RuntimeError "texture " + i + " lost its picture: " + Hex$(r)
	Else
		If r <> $070809 Then RuntimeError "texture " + i + " is wrong: " + Hex$(r)
	EndIf
Next
SetBuffer BackBuffer()
DebugLog "defrag ok"
End
