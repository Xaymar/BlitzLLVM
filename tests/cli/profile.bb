; Flips for a bit more than a second, as that is how often BLITZ_FPS=1 reports if the runtime was built with --profile.
Graphics 64, 64, 0, 2
Local start = MilliSecs()
While MilliSecs() - start < 1300
	Cls
	Flip
Wend
End
