; Texture streaming: textures with mip maps that were loaded from a file lose their biggest levels (instead of going to system memory) when a
; texture with flag 256 needs the room, get them back when they are drawn and video memory has room to spare, and still read back as the file.
Graphics 320, 240, 0, 2
Local i, f, source, big, r
Dim t(4)
Dim c(4)

; The picture: green top left quarter, red elsewhere.
source = CreateTexture(2048, 2048, 1 + 4096)
SetBuffer TextureBuffer(source)
Color 200, 40, 90
Rect 0, 0, 2048, 2048, 1
Color 10, 220, 30
Rect 0, 0, 1024, 1024, 1
SaveBuffer TextureBuffer(source), "vram_mips.bmp"
SetBuffer BackBuffer()
FreeTexture source
For f = 1 To 3
	Flip
Next
DebugLog "avail after source " + (AvailVidMem() / 1048576)

Local cam = CreateCamera()
MoveEntity cam, 0.0, 0.0, -12.0
For i = 0 To 4
	t(i) = LoadTexture("vram_mips.bmp", 1 + 8)
	c(i) = CreateCube()
	ScaleEntity c(i), 0.8, 0.8, 0.8
	PositionEntity c(i), i * 2.2 - 4.4, 0, 0
	EntityTexture c(i), t(i)
	DebugLog "avail after texture " + i + ": " + (AvailVidMem() / 1048576)
Next
For f = 1 To 10
	RenderWorld
	Flip
Next

; Needs room that only the biggest levels of the textures above can give.
DebugLog "avail before big " + (AvailVidMem() / 1048576)
big = CreateTexture(4096, 4096, 1 + 256)
DebugLog "avail after big " + (AvailVidMem() / 1048576)
For f = 1 To 20
	RenderWorld
	Flip
Next

; With room to spare the drawn textures get levels back, one at a time.
FreeTexture big
DebugLog "big freed"
For f = 1 To 80
	RenderWorld
	Flip
Next

For i = 0 To 4
	SetBuffer TextureBuffer(t(i))
	LockBuffer TextureBuffer(t(i))
	r = ReadPixel(10, 10) And $FFFFFF
	If r <> $0ADC1E Then RuntimeError "texture " + i + " lost its picture: " + Hex$(r)
	r = ReadPixel(1500, 1500) And $FFFFFF
	If r <> $C8285A Then RuntimeError "texture " + i + " lost its picture: " + Hex$(r)
	UnlockBuffer TextureBuffer(t(i))
Next
SetBuffer BackBuffer()
DeleteFile "vram_mips.bmp"
DebugLog "streaming ok"
End
