; Prints in which order the arguments of a userlib call are evaluated.
Global log$ = ""
Function T(n)
	log$ = log$ + n
	Return n
End Function

; The second argument needs more registers than the first, so the original evaluates it first.
r = UlAdd(T(1), T(2) + T(3) * T(4))
Print log$
