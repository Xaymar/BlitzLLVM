; Used by the debug_info CLI case: what a debugger shows for a Type, a String and a Dim array.
Type Monster
	Field Name$
	Field Health%
	Field Speed#
	Field Friend.Monster
	Field Scores%[3]
End Type

Dim Grid%(2, 3)
Dim Words$(4)
Global Title$ = "Hello"

Function Check%()
	Local Boss.Monster = New Monster
	Boss\Name = "Grunt"
	Boss\Health = 42
	Boss\Speed = 1.5
	Boss\Friend = Boss
	Boss\Scores[2] = 7
	Grid(1, 2) = 5
	Words(3) = "Blitz"
	Local Message$ = "Local text"
	Return Boss\Health + Grid(1, 2)
End Function

Print Check()
