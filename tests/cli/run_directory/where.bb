; Run from another folder, it prints where it runs and reads a file next to it by its relative name.
Print "cwd:" + CurrentDir$()
Print "appdir:" + SystemProperty$("appdir")
file = ReadFile("data.txt")
If file
	Print "data:" + ReadLine$(file)
	CloseFile file
Else
	Print "data:missing"
EndIf
