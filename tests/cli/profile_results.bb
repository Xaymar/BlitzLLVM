; Takes the results of the profiling into the program: as text, in a file and as the numbers of every frame. Prints what it got on one line:
; frames=<kept frames> frame0=<time of frame 0 is positive> text=<characters captured> file=<size of the file> items=<names of all items exist>
Graphics 64, 64, 0, 2
Local file$ = "profile_results.txt"
ProfileOutput file
ProfileCapture 1
ProfileFrames 1
ProfileSlow 0.0001 ; every frame is slow
Local i
For i = 1 To 20
	Cls
	Flip
Next
ProfileSlow 0
ProfileFrames 0
ProfileOutput ""
Local text$ = ProfileText$()
Local size = 0
Local f = ReadFile(file)
If f <> 0 Then size = FileSize(file) : CloseFile f
Local items = 1
For i = 0 To ProfileItemCount() - 1
	If ProfileItemName$(i) = "" Then items = 0
Next
DebugLog "frames=" + ProfileFrameCount() + " frame0=" + (ProfileFrameValue(0, 0) > 0) + " text=" + Len(text) + " file=" + size + " items=" + items + " number=" + (ProfileFrameNumber(0) > 0)
DeleteFile file
End
