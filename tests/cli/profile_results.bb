; Takes the results of the profiling into the program: in a file and as the numbers of the last frame. Prints what it got on one line:
; mine=<the section took the 2 ms of its Delay> frame0=<time of the last frame is positive> number=<the number of the last frame is positive> file=<size of the file> items=<names of all items exist>
Graphics 64, 64, 0, 2
Local file$ = "profile_results.txt"
ProfileOutput file
ProfileSlow 0.0001 ; every frame is slow
Local i
For i = 1 To 20
	ProfileBegin "Mine"
	Delay 2
	ProfileEnd "mine"
	ProfileEnd "never started"
	Cls
	Flip
Next
ProfileSlow 0
ProfileOutput ""
Local size = 0
Local f = ReadFile(file)
If f <> 0 Then size = FileSize(file) : CloseFile f
Local items = 1
For i = 0 To ProfileItemCount() - 1
	If ProfileItemName$(i) = "" Then items = 0
Next
DebugLog "frame0=" + (ProfileValue("frame") > 0) + " file=" + size + " mine=" + (ProfileValue("MINE") > 1) + " items=" + items + " number=" + (ProfileFlipCount() > 0)
DeleteFile file
End
