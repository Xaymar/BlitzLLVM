; Fills the video memory that BLITZLLVM_VRAM_LIMIT_MB leaves with textures that may use system memory (no flag 256), then makes one that has to
; be in video memory. The first ones make room for it, so this works instead of stopping with "out of video memory".
Graphics 64, 64, 0, 2
Local i
For i = 0 To 4
	CreateTexture(2048, 2048, 1)
Next
CreateTexture(4096, 4096, 1 + 256)
DebugLog "evicted ok"
End
