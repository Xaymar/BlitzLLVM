; Used by the debug_info CLI case: string temporaries make the compiler emit bb_str_mark and bb_str_release, and those need a location too.
Function Greet$(Name$)
	Return "Hi " + Name + "!"
End Function
Local Text$ = "a"
Local Index% = 0
For Index = 1 To 3
	Text = Text + Greet("x" + Str(Index))
Next
Print Text
