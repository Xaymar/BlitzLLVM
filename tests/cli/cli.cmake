	expect_line("Runtime version:${VERSION}")
	expect_missing("Usage")
	# It's the timestamp version Y.M.D.T, then the short commit after a dash if the build knows it.
	if(NOT VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z]+)?$")
		message(FATAL_ERROR "'${VERSION}' is not a timestamp version.")
	endif()
	# Together with a file it still compiles.
	blitzcc(-v +q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_line("Compiler version:${VERSION}")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()

elseif(CASE STREQUAL "long_version")
	# --version is the name and the version of the program, the same format as blitz-format and blitz-tidy, and then it stops.
	blitzcc(--version)
	expect_ok()
	expect_line("blitzcc ${VERSION}")
	expect_missing("Usage")
	expect_missing("Compiler version")
	# It answers before anything else: a bad option, a missing file or an output file do not matter and nothing is written.
	blitzcc(--bogus-option --version "${WORK}/missing.bb" -o "${EXE}")
	expect_ok()
	expect_line("blitzcc ${VERSION}")
	blitzcc("${PROGRAM}" --version -o "${EXE}")
	expect_ok()
	expect_line("blitzcc ${VERSION}")
	if(EXISTS "${EXE}")
		message(FATAL_ERROR "--version built the program.")
	endif()
	# Whichever of the two comes first answers.
	blitzcc(--help --version)
	expect_ok()
	expect_contains("Usage")
	blitzcc(--version --help)
	expect_ok()
	expect_missing("Usage")
	# The value of an option is not an option: here --version is the (missing) runtime directory.
	blitzcc(--runtime-dir --version "${PROGRAM}" -o "${EXE}")
	expect_missing("blitzcc ${VERSION}")
	expect_missing("Usage")

elseif(CASE STREQUAL "runtime_inline")
	# The hot parts of the runtime are compiled with the program, unless that is turned off, or -O0 or -d is used.
	blitzcc(--verbose "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains("-flto=thin")
	expect_contains("banks.c")
	if(NOT CMAKE_HOST_APPLE)
		# clang only does LTO with lld (on Windows it refuses with "LTO requires -fuse-ld=lld" otherwise).
		expect_contains("-fuse-ld=lld")
	endif()
	blitzcc(--verbose --target aarch64-apple-darwin "${PROGRAM}" -o "${WORK}/mac")
	expect_missing("-fuse-ld=lld")
	blitzcc(--verbose --no-runtime-inline "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_missing("-flto=thin")
	blitzcc(--verbose -O0 "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_missing("-flto=thin")

elseif(CASE STREQUAL "runtime_layout")
	# The compiler finds the runtime from where it is: <prefix>/lib/blitzllvm/runtime for <prefix>/bin/blitzcc (zips and packages),
	# and 'runtime' next to it in the build directory, which is what the other tests use.
	get_filename_component(_BIN_DIR "${BLITZCC}" DIRECTORY)
	get_filename_component(_NAME "${BLITZCC}" NAME)
	file(MAKE_DIRECTORY "${WORK}/prefix/bin")
	file(COPY "${BLITZCC}" DESTINATION "${WORK}/prefix/bin")
	file(COPY "${_BIN_DIR}/runtime/" DESTINATION "${WORK}/prefix/lib/blitzllvm/runtime")
	set(BLITZCC "${WORK}/prefix/bin/${_NAME}")
	blitzcc(--verbose "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains("-flto=thin")
	expect_contains("prefix/lib/blitzllvm/runtime")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()
	# Without the runtime there is nothing to link, and the message says where was looked.
	file(REMOVE_RECURSE "${WORK}/prefix/lib")
	blitzcc("${PROGRAM}" -o "${EXE}")
	if(RC EQUAL 0)
		message(FATAL_ERROR "Expected a failure without the runtime.")
	endif()
	string(FIND "${ERR}" "No runtime libraries found, looked in" _AT)
	string(FIND "${ERR}" "lib/blitzllvm/runtime" _AT2)
	if((_AT EQUAL -1) OR (_AT2 EQUAL -1))
		message(FATAL_ERROR "Expected the message to say where it looked, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "runtime_architecture")
	# The libraries of the target are in the folder of its architecture, when there is one. Cross-compiling shows the link line even
	# though the link itself may fail here, so the result is not checked.
	get_filename_component(_BIN_DIR "${BLITZCC}" DIRECTORY)
	# The libraries are in the folder of this computer's architecture, or directly in the runtime (macOS).
	file(GLOB _LIBRARY_DIRS LIST_DIRECTORIES true "${_BIN_DIR}/runtime/*")
	list(FILTER _LIBRARY_DIRS EXCLUDE REGEX "/inline$")
	set(_LIBRARIES "${_BIN_DIR}/runtime")
	foreach(_DIR IN LISTS _LIBRARY_DIRS)
		if(IS_DIRECTORY "${_DIR}")
			set(_LIBRARIES "${_DIR}")
		endif()
	endforeach()
	file(COPY "${_LIBRARIES}/" DESTINATION "${WORK}/runtime/x86_64" PATTERN "inline" EXCLUDE)
	file(COPY "${_LIBRARIES}/" DESTINATION "${WORK}/runtime/arm64" PATTERN "inline" EXCLUDE)
	file(COPY "${_BIN_DIR}/runtime/inline" DESTINATION "${WORK}/runtime")
	blitzcc(--verbose --runtime-dir "${WORK}/runtime" --target aarch64-unknown-linux-gnu "${PROGRAM}" -o "${WORK}/arm64")
	expect_contains("runtime/arm64/")
	expect_missing("runtime/x86_64/")
	blitzcc(--verbose --runtime-dir "${WORK}/runtime" --target x86_64-unknown-linux-gnu "${PROGRAM}" -o "${WORK}/x64")
	expect_contains("runtime/x86_64/")
	expect_missing("runtime/arm64/")
	# The sources to inline are shared by all architectures.
	expect_contains("runtime/inline")
	# Without the folder the libraries next to it are used, and the message says that they are for this computer.
	file(REMOVE_RECURSE "${WORK}/runtime/arm64")
	blitzcc(--verbose --runtime-dir "${WORK}/runtime" --target aarch64-unknown-linux-gnu "${PROGRAM}" -o "${WORK}/arm64")
	string(FIND "${ERR}" "The runtime has no 'arm64' libraries" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected a warning for the missing arm64 libraries, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "image_codecs")
	# The codecs of SDL_image for AVIF, JPEG XL and WebP are shared libraries that are loaded when a program opens such a file. A program that
	# has a window (and so can load images) gets them copied next to it from the runtime directory, one that has none does not.
	file(MAKE_DIRECTORY "${WORK}/gfx" "${WORK}/text")
	blitzcc("${TESTS}/cli/image_codecs.bb" -o "${WORK}/gfx/image_codecs${CMAKE_EXECUTABLE_SUFFIX}")
	expect_ok()
	blitzcc("${PROGRAM}" -o "${WORK}/text/program${CMAKE_EXECUTABLE_SUFFIX}")
	expect_ok()
	# A runtime built with the system's codecs (system-libraries.txt says so) ships none, so none are copied.
	get_filename_component(_BIN_DIR "${BLITZCC}" DIRECTORY)
	file(GLOB_RECURSE _SYSTEM_LIST "${_BIN_DIR}/runtime/system-libraries.txt")
	set(_SYSTEM_CODECS OFF)
	foreach(_FILE IN LISTS _SYSTEM_LIST)
		file(STRINGS "${_FILE}" _MARKER REGEX "^#system image-codecs$")
		if(_MARKER)
			set(_SYSTEM_CODECS ON)
		endif()
	endforeach()
	set(_FAMILIES avif dav1d jxl webp)
	if(NOT CMAKE_HOST_APPLE)
		list(APPEND _FAMILIES tiff)
	endif()
	foreach(_FAMILY IN LISTS _FAMILIES)
		file(GLOB _FOUND "${WORK}/gfx/*${_FAMILY}*")
		if(_SYSTEM_CODECS AND _FOUND)
			message(FATAL_ERROR "The runtime uses the system's codecs, but '${_FOUND}' was copied next to the program.")
		endif()
		if(NOT _SYSTEM_CODECS AND NOT _FOUND)
			message(FATAL_ERROR "The program with a window did not get the library of ${_FAMILY} copied next to it.")
		endif()
		file(GLOB _FOUND "${WORK}/text/*${_FAMILY}*")
		if(_FOUND)
			message(FATAL_ERROR "The program without a window got '${_FOUND}' copied next to it.")
		endif()
	endforeach()

elseif(CASE STREQUAL "audio_codecs")
	# Opus (libopus, opusfile and libogg) is a set of shared libraries that are loaded when a program plays an Opus file or a movie with Opus
	# sound. A program that loads sounds gets them copied next to it from the runtime directory, one that does not load sounds or movies does not.
	file(MAKE_DIRECTORY "${WORK}/sound" "${WORK}/window" "${WORK}/text")
	blitzcc("${TESTS}/cli/audio_codecs.bb" -o "${WORK}/sound/audio_codecs${CMAKE_EXECUTABLE_SUFFIX}")
	expect_ok()
	blitzcc("${TESTS}/cli/image_codecs.bb" -o "${WORK}/window/image_codecs${CMAKE_EXECUTABLE_SUFFIX}")
	expect_ok()
	blitzcc("${PROGRAM}" -o "${WORK}/text/program${CMAKE_EXECUTABLE_SUFFIX}")
	expect_ok()
	# A runtime built with the system's codecs (system-libraries.txt says so) ships none, so none are copied.
	get_filename_component(_BIN_DIR "${BLITZCC}" DIRECTORY)
	file(GLOB_RECURSE _SYSTEM_LIST "${_BIN_DIR}/runtime/system-libraries.txt")
	set(_SYSTEM_CODECS OFF)
	foreach(_FILE IN LISTS _SYSTEM_LIST)
		file(STRINGS "${_FILE}" _MARKER REGEX "^#system audio-codecs$")
		if(_MARKER)
			set(_SYSTEM_CODECS ON)
		endif()
	endforeach()
	foreach(_FAMILY IN ITEMS opus opusfile ogg)
		file(GLOB _FOUND "${WORK}/sound/*${_FAMILY}*")
		if(_SYSTEM_CODECS AND _FOUND)
			message(FATAL_ERROR "The runtime uses the system's codecs, but '${_FOUND}' was copied next to the program.")
		endif()
		if(NOT _SYSTEM_CODECS AND NOT _FOUND)
			message(FATAL_ERROR "The program that loads sounds did not get the library of ${_FAMILY} copied next to it.")
		endif()
		file(GLOB _FOUND "${WORK}/window/*${_FAMILY}*" "${WORK}/text/*${_FAMILY}*")
		if(_FOUND)
			message(FATAL_ERROR "A program that plays no sounds got '${_FOUND}' copied next to it.")
		endif()
	endforeach()

elseif(CASE STREQUAL "verbose_long_only")
	# -v used to be the short form of --verbose, now it is the version like in the original.
	blitzcc(--verbose "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains("-lm")
	blitzcc(-v "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_missing("-lm")

elseif(CASE STREQUAL "console_subsystem")
	# On Windows programs are GUI programs unless --console is given. Cross-compiling shows the link line even though the
	# link itself may fail here, so the result is not checked.
	blitzcc(--verbose --target x86_64-pc-windows-msvc "${PROGRAM}" -o "${WORK}/gui.exe")
	expect_contains("-Wl,/subsystem:windows")
	expect_contains("-Wl,/entry:mainCRTStartup")
