################################################################################
# Tests for the command line options of blitzcc, run as 'cmake -DCASE=<name> ... -P cli.cmake'.
#
# Variables: BLITZCC (the compiler), TESTS (the tests directory), WORK (an empty directory to write to), VERSION (what
# -v has to report).
################################################################################
cmake_minimum_required(VERSION 3.20)

set(PROGRAM "${TESTS}/cli/program.bb")
set(USERLIBS "${TESTS}/cli/userlibs")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# Run the compiler in WORK, results are RC, OUT and ERR.
function(blitzcc)
	execute_process(
		COMMAND "${BLITZCC}" ${ARGN}
		WORKING_DIRECTORY "${WORK}"
		RESULT_VARIABLE _RC
		OUTPUT_VARIABLE _OUT
		ERROR_VARIABLE _ERR
	)
	set(RC "${_RC}" PARENT_SCOPE)
	set(OUT "${_OUT}" PARENT_SCOPE)
	set(ERR "${_ERR}" PARENT_SCOPE)
endfunction()

macro(expect_ok)
	if(NOT RC EQUAL 0)
		message(FATAL_ERROR "Expected success, got '${RC}'.\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
endmacro()

macro(expect_contains TEXT)
	string(FIND "${OUT}" "${TEXT}" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected '${TEXT}' in the output, got:\n${OUT}")
	endif()
endmacro()

macro(expect_missing TEXT)
	string(FIND "${OUT}" "${TEXT}" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Did not expect '${TEXT}' in the output, got:\n${OUT}")
	endif()
endmacro()

# Build the test userlib (tests/cli/userlib) into DIR as a shared library or, with STATIC, as a static one, and copy the .decls.
# Names are what the platform uses, so that the .dll of the .decls file has to be found by its other names.
function(build_userlib DIR KIND)
	set(_CC "$ENV{BLITZLLVM_CC}")
	if(NOT _CC)
		set(_CC clang)
	endif()
	file(MAKE_DIRECTORY "${DIR}")
	set(_SRC "${TESTS}/cli/userlib/ultest.c")
	if(CMAKE_HOST_WIN32)
		set(_OUTPUT "${DIR}/ultest.dll")
	elseif(CMAKE_HOST_APPLE)
		set(_OUTPUT "${DIR}/libultest.dylib")
	else()
		set(_OUTPUT "${DIR}/libultest.so")
	endif()
	execute_process(COMMAND "${_CC}" -shared -fPIC "${_SRC}" -o "${_OUTPUT}" RESULT_VARIABLE _RC ERROR_VARIABLE _ERR)
	if(NOT _RC EQUAL 0)
		message(FATAL_ERROR "Building the test userlib failed: ${_ERR}")
	endif()
	file(COPY "${TESTS}/cli/userlib/ultest.decls" DESTINATION "${DIR}")
endfunction()

macro(expect_userlib_output)
	expect_ok()
	expect_contains("5\n")
	expect_contains("6.0\n")
	expect_contains("hello, World\n")
	expect_contains("1234\n")
	# The short and the long form of the types, and every size of number.
	expect_contains("5\n9\n3.0\n3.0\nhello, a\nhello, b\n78\n")
	expect_contains("-100\n44\n-30000\n4464\n1705032704\n-10000000000\n-10000000000\n18446744073709551615\n0.5\n1.0\n")
endmacro()


# A whole line, so that 'Left' does not match 'LeftHand'.
macro(expect_line LINE)
	string(REGEX REPLACE "([][+.*^$?|()\\\\])" "\\\\\\1" _ESCAPED "${LINE}")
	if(NOT "\n${OUT}" MATCHES "\n${_ESCAPED}\n")
		message(FATAL_ERROR "Expected the line '${LINE}' in the output, got:\n${OUT}")
	endif()
endmacro()

set(EXE "${WORK}/program${CMAKE_EXECUTABLE_SUFFIX}")

if(CASE STREQUAL "default")
	# Nothing given: Banner and every step.
	blitzcc("${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains("BlitzCC V${VERSION}")
	expect_contains("Compiling \"")
	expect_contains("Parsing...")
	expect_contains("Generating...")
	expect_contains("Creating executable \"")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()

elseif(CASE STREQUAL "quiet")
	# -q drops the banner and the warnings, but not the errors.
	blitzcc(-q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_missing("BlitzCC")
	expect_missing("Compiling")
	expect_contains("Parsing...")
	expect_contains("Creating executable \"")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()
	file(WRITE "${WORK}/warning.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(-c "${WORK}/warning.bb")
	expect_ok()
	string(FIND "${ERR}" "warning" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected a warning without -q, got:\n${ERR}")
	endif()
	blitzcc(-q -c "${WORK}/warning.bb")
	expect_ok()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no warnings with -q, got:\n${ERR}")
	endif()
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc(-q -c "${WORK}/broken.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	string(FIND "${ERR}" "error" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected an error message with -q, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "very_quiet")
	# +q drops every message, but the executable is still created.
	blitzcc(+q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	if(NOT OUT STREQUAL "")
		message(FATAL_ERROR "Expected no output, got:\n${OUT}")
	endif()
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()
	# Warnings and errors are silent too, but a broken program still fails.
	file(WRITE "${WORK}/warning.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(+q -c "${WORK}/warning.bb")
	expect_ok()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no warnings, got:\n${ERR}")
	endif()
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc(+q "${WORK}/broken.bb" -o "${EXE}.broken")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	if(NOT ERR STREQUAL "" OR NOT OUT STREQUAL "")
		message(FATAL_ERROR "Expected no messages, got:\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
	if(EXISTS "${EXE}.broken")
		message(FATAL_ERROR "An executable was created for a broken program.")
	endif()

elseif(CASE STREQUAL "options_not_case_sensitive")
	blitzcc(+Q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	if(NOT OUT STREQUAL "")
		message(FATAL_ERROR "Expected no output, got:\n${OUT}")
	endif()

elseif(CASE STREQUAL "compile_only")
	# -c checks the program, but doesn't create anything.
	blitzcc(-c "${PROGRAM}")
	expect_ok()
	expect_contains("Generating...")
	expect_missing("Creating")
	file(GLOB _CREATED "${WORK}/*")
	if(_CREATED)
		message(FATAL_ERROR "Compile only created files: ${_CREATED}")
	endif()
	# It still reports errors.
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc(-c "${WORK}/broken.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	# -o wins, like in the original.
	blitzcc(-c "${PROGRAM}" -o "${EXE}")
	expect_ok()
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "-c with -o did not create the executable.")
	endif()

elseif(CASE STREQUAL "debug")
	# -d never optimizes and adds debug information, wherever the optimization level is.
	foreach(_ARGS IN ITEMS "-d;-O3" "-O3;-d")
		blitzcc(${_ARGS} --verbose "${PROGRAM}" -o "${EXE}")
		expect_ok()
		expect_contains(" -O0 ")
		expect_contains(" -g ")
		expect_missing("-O3")
	endforeach()
	# Without -d it is optimized and has no debug information.
	blitzcc(--verbose "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains(" -O3 ")
	expect_missing(" -g ")
	# And the result runs.
	blitzcc(-d "${PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" WORKING_DIRECTORY "${TESTS}" RESULT_VARIABLE _RUN OUTPUT_QUIET ERROR_QUIET)
	if(NOT _RUN EQUAL 0)
		message(FATAL_ERROR "The debug build failed to run: ${_RUN}")
	endif()

elseif(CASE STREQUAL "profile")
	# --profile (and -d) make the program turn the runtime timers on; without them the program never asks for them.
	foreach(_ARGS IN ITEMS "--profile" "-d" "")
		blitzcc(-S ${_ARGS} "${PROGRAM}" -o "${WORK}/profile.ll")
		expect_ok()
		file(READ "${WORK}/profile.ll" _IR)
		string(FIND "${_IR}" "@bb_set_profile(" _AT)
		if(_ARGS STREQUAL "" AND NOT _AT EQUAL -1)
			message(FATAL_ERROR "A program without --profile turns the profiling on.")
		elseif(NOT _ARGS STREQUAL "" AND _AT EQUAL -1)
			message(FATAL_ERROR "'${_ARGS}' does not turn the profiling on.")
		endif()
	endforeach()

elseif(CASE STREQUAL "debug_info")
	# -d and -g describe the program to debuggers, in the files, lines and columns of the source.
	set(DEBUG_PROGRAM "${TESTS}/cli/debug.bb")
	blitzcc(-S -d "${DEBUG_PROGRAM}" -o "${WORK}/debug.ll")
	expect_ok()
	file(READ "${WORK}/debug.ll" _IR)
	foreach(_NEEDED IN ITEMS "!DICompileUnit(" "emissionKind: FullDebug" "\"Debug Info Version\"" "\"Dwarf Version\""
		"filename: \"debug.bb\"" "filename: \"debug_include.bb\"" "!DISubprogram(name: \"Double\"" "!DISubprogram(name: \"main\""
		"!DILocalVariable(name: \"Value\", arg: 1" "!DILocalVariable(name: \"Total\"" "!DIGlobalVariable(name: \"Counter\"" "!DIGlobalVariable(name: \"Included\""
		"call void @llvm.dbg.declare(" "!DILexicalBlockFile(" "!DILocation(line: 14, column: 1,")
		string(FIND "${_IR}" "${_NEEDED}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "The debug IR does not contain '${_NEEDED}'.")
		endif()
	endforeach()
	string(FIND "${_IR}" "CodeView" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "A DWARF target got CodeView.")
	endif()
	# Windows with MSVC uses CodeView.
	blitzcc(-S -d --target x86_64-pc-windows-msvc "${DEBUG_PROGRAM}" -o "${WORK}/codeview.ll")
	expect_ok()
	file(READ "${WORK}/codeview.ll" _IR)
	foreach(_NEEDED IN ITEMS "\"CodeView\"" "\"Debug Info Version\"")
		string(FIND "${_IR}" "${_NEEDED}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "The CodeView IR does not contain '${_NEEDED}'.")
		endif()
	endforeach()
	string(FIND "${_IR}" "Dwarf Version" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "A CodeView target got DWARF.")
	endif()
	# MinGW uses DWARF.
	blitzcc(-S -d --target x86_64-w64-mingw32 "${DEBUG_PROGRAM}" -o "${WORK}/mingw.ll")
	expect_ok()
	file(READ "${WORK}/mingw.ll" _IR)
	string(FIND "${_IR}" "Dwarf Version" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "A MinGW target did not get DWARF.")
	endif()
	# Without either option there is none of it.
	blitzcc(-S "${DEBUG_PROGRAM}" -o "${WORK}/release.ll")
	expect_ok()
	file(READ "${WORK}/release.ll" _IR)
	foreach(_FORBIDDEN IN ITEMS "!dbg" "DICompileUnit" "llvm.dbg" "!llvm.module.flags")
		string(FIND "${_IR}" "${_FORBIDDEN}" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "A build without debug information contains '${_FORBIDDEN}'.")
		endif()
	endforeach()
	# -g keeps the optimization level, -d does not.
	blitzcc(-g --verbose "${DEBUG_PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains(" -O3 ")
	expect_contains(" -g ")
	blitzcc(-S -g "${DEBUG_PROGRAM}" -o "${WORK}/g.ll")
	expect_ok()
	file(READ "${WORK}/g.ll" _IR)
	string(FIND "${_IR}" "DICompileUnit" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "-g did not add debug information.")
	endif()
	# What LLVM makes of it: the line table maps instructions back to the lines and the file of the source.
	find_program(CLANG clang)
	find_program(DWARFDUMP NAMES llvm-dwarfdump llvm-dwarfdump-18 llvm-dwarfdump-19 llvm-dwarfdump-20 llvm-dwarfdump-21)
	if(CLANG AND DWARFDUMP)
		execute_process(COMMAND "${CLANG}" -c -w "${WORK}/debug.ll" -o "${WORK}/debug.o" RESULT_VARIABLE _RC ERROR_VARIABLE _ERR)
		if(NOT _RC EQUAL 0)
			message(FATAL_ERROR "LLVM did not accept the debug information: ${_ERR}")
		endif()
		execute_process(COMMAND "${DWARFDUMP}" --debug-line "${WORK}/debug.o" OUTPUT_VARIABLE _LINES RESULT_VARIABLE _RC)
		execute_process(COMMAND "${DWARFDUMP}" --debug-info "${WORK}/debug.o" OUTPUT_VARIABLE _INFO)
		foreach(_NEEDED IN ITEMS "name: \"debug.bb\"" "name: \"debug_include.bb\"")
			string(FIND "${_LINES}" "${_NEEDED}" _AT)
			if(_AT EQUAL -1)
				message(FATAL_ERROR "The line table does not contain '${_NEEDED}':\n${_LINES}")
			endif()
		endforeach()
		# Lines 12 (in Double) and 15 (the main program) have instructions.
		foreach(_LINE IN ITEMS 12 15)
			if(NOT "${_LINES}" MATCHES "\n0x[0-9a-f]+ +${_LINE} ")
				message(FATAL_ERROR "The line table has no instructions for line ${_LINE}:\n${_LINES}")
			endif()
		endforeach()
		foreach(_NEEDED IN ITEMS "DW_AT_name\t(\"Double\")" "DW_AT_name\t(\"Total\")" "DW_AT_name\t(\"Counter\")")
			string(FIND "${_INFO}" "${_NEEDED}" _AT)
			if(_AT EQUAL -1)
				message(FATAL_ERROR "The debug info does not contain '${_NEEDED}':\n${_INFO}")
			endif()
		endforeach()
	endif()

elseif(CASE STREQUAL "fast_math")
	# Float math is fast-math by default, but without the NaN and Infinity assumptions, which would break "x <> x" checks.
	set(FM_PROGRAM "${TESTS}/cli/fast_math.bb")
	blitzcc(-S "${FM_PROGRAM}" -o "${WORK}/safe.ll")
	expect_ok()
	file(READ "${WORK}/safe.ll" _IR)
	if(NOT _IR MATCHES "fmul reassoc nsz arcp contract afn float")
		message(FATAL_ERROR "The default build has no fast-math flags on Float operations.")
	endif()
	if(_IR MATCHES "nnan|ninf")
		message(FATAL_ERROR "The default build assumes no NaN or Infinity.")
	endif()
	blitzcc(-S --fast-math full "${FM_PROGRAM}" -o "${WORK}/full.ll")
	expect_ok()
	file(READ "${WORK}/full.ll" _IR)
	if(NOT _IR MATCHES "fmul fast float")
		message(FATAL_ERROR "--fast-math full did not put fast on Float operations.")
	endif()
	foreach(_ARGS IN ITEMS "-S;--fast-math;off" "-S;-d")
		blitzcc(${_ARGS} "${FM_PROGRAM}" -o "${WORK}/off.ll")
		expect_ok()
		file(READ "${WORK}/off.ll" _IR)
		if(_IR MATCHES "f(add|sub|mul|div|cmp) (reassoc|fast|nsz)")
			message(FATAL_ERROR "Fast-math flags found with ${_ARGS}.")
		endif()
	endforeach()
	# NaN and Infinity still behave in the default build.
	blitzcc("${FM_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED)
	if(NOT _PRINTED MATCHES "nan 1 inf 1")
		message(FATAL_ERROR "NaN or Infinity misbehaved: ${_PRINTED}")
	endif()

elseif(CASE STREQUAL "inline_checks")
	# The array, division and object checks are part of the program and still report the same errors, which also holds for
	# negative indices and objects that were deleted.
	set(_HEAD "Dim a(3)\nType T\nField v\nEnd Type\nLocal t.T = New T\nDelete t\nLocal z = 0\n")
	foreach(_CASE_ITEM IN ITEMS "a(-1) = 1|Array index out of bounds." "a(4) = 1|Array index out of bounds." "Print 5 / z|Integer divide by zero" "Print 5 Mod z|Integer divide by zero" "Print t\\v|Object does not exist.")
		string(REPLACE "|" ";" _PARTS "${_CASE_ITEM}")
		list(GET _PARTS 0 _CODE)
		list(GET _PARTS 1 _MESSAGE)
		file(WRITE "${WORK}/inline_checks.bb" "${_HEAD}${_CODE}\nPrint \"survived\"\n")
		blitzcc(-q "${WORK}/inline_checks.bb")
		if(RC EQUAL 0 OR NOT "${OUT}${ERR}" MATCHES "${_MESSAGE}" OR "${OUT}${ERR}" MATCHES "survived")
			message(FATAL_ERROR "'${_CODE}' did not report '${_MESSAGE}' (${RC}):\nstdout: ${OUT}\nstderr: ${ERR}")
		endif()
	endforeach()
	file(WRITE "${WORK}/inline_ok.bb" "Dim a(3)\na(3) = 7\nLocal z = 2\nPrint a(3) + 10 / z + Sqr(16.0) + Floor(2.5) + Ceil(2.5)\n")
	blitzcc(-q "${WORK}/inline_ok.bb")
	expect_ok()
	expect_contains("21.0")

elseif(CASE STREQUAL "stop")
	# Stop is a breakpoint in a debug build, and nothing in any other. Neither is run with the trap in it.
	set(STOP_PROGRAM "${TESTS}/cli/stop.bb")
	blitzcc(-S -d "${STOP_PROGRAM}" -o "${WORK}/debug.ll")
	expect_ok()
	file(READ "${WORK}/debug.ll" _DEBUG_IR)
	string(FIND "${_DEBUG_IR}" "call void @llvm.debugtrap()" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "A debug build did not trap at Stop.")
	endif()
	foreach(_ARGS IN ITEMS "-S" "-S;-O3")
		blitzcc(${_ARGS} "${STOP_PROGRAM}" -o "${WORK}/release.ll")
		expect_ok()
		file(READ "${WORK}/release.ll" _RELEASE_IR)
		string(FIND "${_RELEASE_IR}" "debugtrap" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "A build without -d traps at Stop.")
		endif()
	endforeach()
	# And the program carries on past it.
	blitzcc("${STOP_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED)
	string(FIND "${_PRINTED}" "after" _AT)
	if(NOT _RUN EQUAL 0 OR _AT EQUAL -1)
		message(FATAL_ERROR "The program did not carry on after Stop: ${_RUN} ${_PRINTED}")
	endif()

elseif(CASE STREQUAL "gfx_driver")
	# SetGfxDriver once something needs the GPU stops a debug build with an error, and is ignored by any other build.
	# The programs run without a window (BLITZ_HEADLESS), where there is the one driver "Default".
	set(ENV{BLITZ_HEADLESS} "1")
	set(DRIVER_PROGRAM "${TESTS}/cli/gfx_driver.bb")
	blitzcc("${DRIVER_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED ERROR_VARIABLE _ERRORS)
	string(FIND "${_PRINTED}" "after" _AT)
	if(NOT _RUN EQUAL 0 OR _AT EQUAL -1)
		message(FATAL_ERROR "A build without -d did not ignore SetGfxDriver after an image was made: ${_RUN} ${_PRINTED} ${_ERRORS}")
	endif()
	blitzcc(-d "${DRIVER_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED ERROR_VARIABLE _ERRORS)
	string(FIND "${_ERRORS}" "SetGfxDriver" _AT)
	string(FIND "${_PRINTED}" "after" _AFTER)
	if(_RUN EQUAL 0 OR _AT EQUAL -1 OR NOT _AFTER EQUAL -1)
		message(FATAL_ERROR "A debug build did not stop at SetGfxDriver after an image was made: ${_RUN} ${_PRINTED} ${_ERRORS}")
	endif()
	unset(ENV{BLITZ_HEADLESS})

elseif(CASE STREQUAL "keywords")
	blitzcc(-k --userlibs-dir "${USERLIBS}")
	expect_ok()
	# The language, the runtime, and the userlibs.
	expect_line("Dim")
	expect_line("While")
	expect_line("Wend")
	expect_line("Sar")
	expect_line("print")
	expect_line("createcube")
	expect_line("CliAdd")
	expect_line("CliShow")
	# Words with a space are the same keyword as the one without it, and are not listed.
	expect_missing("End If")
	# Keywords only, no syntax.
	expect_missing("(")
	# Nothing is compiled.
	file(GLOB _CREATED "${WORK}/*")
	if(_CREATED)
		message(FATAL_ERROR "Dumping keywords created files: ${_CREATED}")
	endif()
	# Without userlibs there are none of theirs.
	blitzcc(-k --userlibs-dir "${WORK}")
	expect_ok()
	expect_line("Dim")
	expect_missing("CliAdd")

elseif(CASE STREQUAL "keywords_syntax")
	blitzcc(+k --userlibs-dir "${USERLIBS}")
	expect_ok()
	expect_line("Dim")
	# Returns something: 'Name$ ( parameters )', parameters with a default are in brackets.
	expect_line("left$ ( param1$,param2 )")
	expect_line("mid$ ( param1$,param2,[param3] )")
	expect_line("rand ( param1,[param2] )")
	# Returns nothing: 'Name parameters'.
	expect_line("print [param1$]")
	# Userlibs.
	expect_line("CliAdd ( a,b )")
	expect_line("CliScale# ( value#,factor# )")
	expect_line("CliName$ ( id )")
	expect_line("CliShow text$,handle*")

elseif(CASE STREQUAL "keywords_bad_userlib")
	file(WRITE "${WORK}/userlibs/bad.decls" "CliAdd%(a%)\n")
	blitzcc(-k --userlibs-dir "${WORK}/userlibs")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A userlib without .lib was accepted.")
	endif()
	string(FIND "${ERR}" "Error in userlib 'bad.decls' - function decl without lib directive" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected the error to name the file and the problem, got:\n${ERR}")
	endif()
	file(WRITE "${WORK}/userlibs/bad.decls" ".lib \"a.dll\"\nCliAdd%(a%)\nCLIADD%(b%)\n")
	blitzcc(-k --userlibs-dir "${WORK}/userlibs")
	string(FIND "${ERR}" "duplicate identifier" _AT)
	if(RC EQUAL 0 OR _AT EQUAL -1)
		message(FATAL_ERROR "A duplicate name was accepted: ${ERR}")
	endif()
	file(WRITE "${WORK}/userlibs/bad.decls" ".lib \"a.dll\"\nCliAdd:Nothing(a:Int)\n")
	blitzcc(-k --userlibs-dir "${WORK}/userlibs")
	string(FIND "${ERR}" "unknown type 'nothing'" _AT)
	if(RC EQUAL 0 OR _AT EQUAL -1)
		message(FATAL_ERROR "An unknown type was accepted: ${ERR}")
	endif()
	file(WRITE "${WORK}/userlibs/bad.decls" ".lib \"a.dll\"\nCliAdd*(a:Int)\n")
	blitzcc(-k --userlibs-dir "${WORK}/userlibs")
	string(FIND "${ERR}" "can't return a pointer" _AT)
