	expect_ok()
	expect_missing("-flto=thin")

elseif(CASE STREQUAL "runtime_layout")
	# The compiler finds the runtime from where it is: <prefix>/lib/blitzllvm/runtime for <prefix>/bin/blitzcc (zips and packages),
	# and 'runtime' next to it in the build directory, which is what the other tests use.
	get_filename_component(_BIN_DIR "${BLITZCC}" DIRECTORY)
	get_filename_component(_NAME "${BLITZCC}" NAME)
	file(MAKE_DIRECTORY "${WORK}/prefix/bin")
	file(COPY "${BLITZCC}" DESTINATION "${WORK}/prefix/bin")
	file(COPY "${_BIN_DIR}/runtime/" DESTINATION "${WORK}/prefix/lib/blitzllvm/runtime")
	set(BLITZCC "${WORK}/prefix/bin/${_NAME}")
	blitzcc(--verbose "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains("-flto=thin")
	expect_contains("prefix/lib/blitzllvm/runtime")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()
	# Without the runtime there is nothing to link, and the message says where was looked.
	file(REMOVE_RECURSE "${WORK}/prefix/lib")
	blitzcc("${PROGRAM}" -o "${EXE}")
	if(RC EQUAL 0)
		message(FATAL_ERROR "Expected a failure without the runtime.")
	endif()
	string(FIND "${ERR}" "No runtime libraries found, looked in" _AT)
	string(FIND "${ERR}" "lib/blitzllvm/runtime" _AT2)
	if((_AT EQUAL -1) OR (_AT2 EQUAL -1))
		message(FATAL_ERROR "Expected the message to say where it looked, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "runtime_architecture")
	# The libraries of the target are in the folder of its architecture, when there is one. Cross-compiling shows the link line even
	# though the link itself may fail here, so the result is not checked.
	get_filename_component(_BIN_DIR "${BLITZCC}" DIRECTORY)
	# The libraries are in the folder of this computer's architecture, or directly in the runtime (macOS).
	file(GLOB _LIBRARY_DIRS LIST_DIRECTORIES true "${_BIN_DIR}/runtime/*")
	list(FILTER _LIBRARY_DIRS EXCLUDE REGEX "/inline$")
	set(_LIBRARIES "${_BIN_DIR}/runtime")
	foreach(_DIR IN LISTS _LIBRARY_DIRS)
		if(IS_DIRECTORY "${_DIR}")
			set(_LIBRARIES "${_DIR}")
		endif()
	endforeach()
	file(COPY "${_LIBRARIES}/" DESTINATION "${WORK}/runtime/x86_64" PATTERN "inline" EXCLUDE)
	file(COPY "${_LIBRARIES}/" DESTINATION "${WORK}/runtime/arm64" PATTERN "inline" EXCLUDE)
	file(COPY "${_BIN_DIR}/runtime/inline" DESTINATION "${WORK}/runtime")
	blitzcc(--verbose --runtime-dir "${WORK}/runtime" --target aarch64-unknown-linux-gnu "${PROGRAM}" -o "${WORK}/arm64")
	expect_contains("runtime/arm64/")
	expect_missing("runtime/x86_64/")
	blitzcc(--verbose --runtime-dir "${WORK}/runtime" --target x86_64-unknown-linux-gnu "${PROGRAM}" -o "${WORK}/x64")
	expect_contains("runtime/x86_64/")
	expect_missing("runtime/arm64/")
	# The sources to inline are shared by all architectures.
	expect_contains("runtime/inline")
	# Without the folder the libraries next to it are used, and the message says that they are for this computer.
	file(REMOVE_RECURSE "${WORK}/runtime/arm64")
	blitzcc(--verbose --runtime-dir "${WORK}/runtime" --target aarch64-unknown-linux-gnu "${PROGRAM}" -o "${WORK}/arm64")
	string(FIND "${ERR}" "The runtime has no 'arm64' libraries" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected a warning for the missing arm64 libraries, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "image_codecs")
	# The codecs of SDL_image for AVIF, JPEG XL and WebP are shared libraries that are loaded when a program opens such a file. A program that
