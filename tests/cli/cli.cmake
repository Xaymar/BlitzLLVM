	file(COPY "${_BIN_DIR}/runtime/" DESTINATION "${WORK}/prefix/lib/blitzllvm/runtime")
	build_userlib("${WORK}/prefix/userlibs" shared)
	get_filename_component(_NAME "${BLITZCC}" NAME)
	set(BLITZCC "${WORK}/prefix/bin/${_NAME}")
	unset(ENV{BLITZLLVM_USERLIBS})
	blitzcc(+q "${TESTS}/cli/userlib/call.bb")
	expect_userlib_output()
	blitzcc(-k)
	expect_contains("UlAdd\n")
	# The layout of a package: <prefix>/share/blitzllvm/userlibs.
	file(RENAME "${WORK}/prefix/userlibs" "${WORK}/prefix/share")
	file(MAKE_DIRECTORY "${WORK}/prefix/share2/blitzllvm")
	file(RENAME "${WORK}/prefix/share" "${WORK}/prefix/share2/blitzllvm/userlibs")
	file(RENAME "${WORK}/prefix/share2" "${WORK}/prefix/share")
	blitzcc(+q "${TESTS}/cli/userlib/call.bb")
	expect_userlib_output()

elseif(CASE STREQUAL "run")
	# Without -o the program is built and run, and nothing is left behind.
	blitzcc("${TESTS}/cli/run.bb" --args one two)
	expect_ok()
	expect_contains("Executing...")
	expect_contains("ran:one two")
	file(GLOB _CREATED "${WORK}/*")
	if(_CREATED)
		message(FATAL_ERROR "Running created files: ${_CREATED}")
	endif()
	# +q only leaves what the program prints.
	blitzcc(+q "${TESTS}/cli/run.bb")
	expect_ok()
	if(NOT OUT STREQUAL "ran:\n")
		message(FATAL_ERROR "Expected only the output of the program, got:\n${OUT}")
	endif()
	# The program that is run gets a name that is new for every build, as Windows and the drivers force VSync or Auto HDR on programs
	# with names they know as games. Two builds keep two folders with one program each, named blitzllvm_ and 12 hexadecimal digits.
	set(_TEMP "${WORK}/temp")
	file(MAKE_DIRECTORY "${_TEMP}")
	foreach(_RUN IN ITEMS 1 2)
		execute_process(
			COMMAND "${CMAKE_COMMAND}" -E env "TMPDIR=${_TEMP}" "TEMP=${_TEMP}" "TMP=${_TEMP}" "${BLITZCC}" +q --keep-temps "${TESTS}/cli/run.bb"
			WORKING_DIRECTORY "${WORK}"
			RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR
		)
		expect_ok()
	endforeach()
	file(GLOB _PROGRAMS "${_TEMP}/blitzllvm-*/blitzllvm_*")
	list(FILTER _PROGRAMS EXCLUDE REGEX "\\.(ll|pdb|res|o|obj)$")
	set(_NAMES)
	foreach(_PROGRAM IN LISTS _PROGRAMS)
		get_filename_component(_NAME "${_PROGRAM}" NAME)
		if(NOT _NAME MATCHES "^blitzllvm_[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f](\\.exe)?$")
			message(FATAL_ERROR "The program that is run is named '${_NAME}', expected blitzllvm_ and 12 hexadecimal digits.")
		endif()
		list(APPEND _NAMES "${_NAME}")
	endforeach()
	list(REMOVE_DUPLICATES _NAMES)
	list(LENGTH _NAMES _COUNT)
	if(NOT _COUNT EQUAL 2)
		message(FATAL_ERROR "Two runs should have built two programs with different names, found: ${_PROGRAMS}")
	endif()
	file(REMOVE_RECURSE "${_TEMP}")
	# With -o it is built, but not run.
	blitzcc("${TESTS}/cli/run.bb" -o "${EXE}")
	expect_ok()
	expect_missing("Executing")
	expect_missing("ran:")
	# Neither -c nor -S run it.
	blitzcc(-c "${TESTS}/cli/run.bb")
	expect_ok()
	expect_missing("ran:")
	blitzcc(-S "${TESTS}/cli/run.bb" -o "${WORK}/run.ll")
	expect_ok()
	expect_missing("ran:")

elseif(CASE STREQUAL "run_exit_code")
	# blitzcc returns what the program returns.
	blitzcc(+q "${TESTS}/cli/fail.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "The failure of the program was not returned.")
	endif()
	# A program that doesn't compile is not run.
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc("${WORK}/broken.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	expect_missing("Executing")

elseif(CASE STREQUAL "diagnostics")
	# Errors and warnings show the line and point at the column, also with -q (which only drops warnings).
	macro(expect_err TEXT)
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "Expected '${TEXT}' in the messages, got:\n${ERR}")
		endif()
	endmacro()

	# Lexer error, with a tab in front: the tab is kept so that the caret lines up.
	file(WRITE "${WORK}/lexer.bb" "Local a = 1\n\tLocal b = 2 @ 3\n")
	blitzcc(-q -c "${WORK}/lexer.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	expect_err("lexer.bb:2:14: error: ")
	expect_err("\n\tLocal b = 2 @ 3\n\t            ^-- HERE")

	# Parser error at the end of a line.
	file(WRITE "${WORK}/parser.bb" "Local a = \n")
	blitzcc(-q -c "${WORK}/parser.bb")
	expect_err("\nLocal a = \n          ^ HERE")

	# Parser error at the end of the file, which has no line break.
	file(WRITE "${WORK}/eof.bb" "Local a = (1 +")
	blitzcc(-c "${WORK}/eof.bb")
	expect_err("\nLocal a = (1 +\n              ^ HERE")

	# Semantic error.
	file(WRITE "${WORK}/semantic.bb" "Print nofunc(1)\n")
	blitzcc(-c "${WORK}/semantic.bb")
	expect_err("\nPrint nofunc(1)\n      ^-------- HERE")

	# Warnings point at the expression, and don't fail the build.
	file(WRITE "${WORK}/warning.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(-c "${WORK}/warning.bb")
	expect_ok()
	expect_err("warning.bb:1:12: warning: ")
	expect_err("\nLocal i% = 2.5\n           ^^^ HERE")

	# The dashes reach to the end of the line, also when the span ends before it.
	file(WRITE "${WORK}/point.bb" "Local i% = 2.5 + 1.5 ; note\nPrint i\n")
	blitzcc(-c "${WORK}/point.bb")
	expect_err("\nLocal i% = 2.5 + 1.5 ; note\n               ^----------- HERE")

	# Long lines are cut around the column.
	string(REPEAT "a" 300 _LONG)
	file(WRITE "${WORK}/long.bb" "Local ${_LONG} = 1 @\n")
	blitzcc(-c "${WORK}/long.bb")
	expect_err("\n...")
	string(FIND "${ERR}" "${_LONG}" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "The long line was not cut:\n${ERR}")
	endif()
	expect_err("^ HERE")

	# Paths have no "." or ".." parts, for the file on the command line and for included files.
	file(MAKE_DIRECTORY "${WORK}/sub/deeper")
	file(WRITE "${WORK}/sub/inc.bb" "Local a = 1 @\n")
	file(WRITE "${WORK}/sub/deeper/main.bb" "Include \"../inc.bb\"\n")
	blitzcc(-q -c "${WORK}/sub/deeper/../deeper/./main.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken include was accepted.")
	endif()
	string(FIND "${ERR}" ".." _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Expected a path without '..', got:\n${ERR}")
	endif()
	string(FIND "${ERR}" "/./" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Expected a path without '.', got:\n${ERR}")
	endif()
	expect_err("/sub/inc.bb:1:13: error: ")
	expect_err("\nLocal a = 1 @\n            ^ HERE")
	# The same for a warning.
	file(WRITE "${WORK}/sub/warn.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(-c "${WORK}/sub/deeper/../warn.bb")
	expect_ok()
	expect_err("/sub/warn.bb:1:12: warning: ")
	string(FIND "${ERR}" ".." _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Expected a path without '..', got:\n${ERR}")
	endif()

	# Without a source file there is nothing to show, but the message stays.
	blitzcc(-c "${WORK}/missing.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A missing file was accepted.")
	endif()
	expect_err("error: ")

elseif(CASE STREQUAL "warnings")
	macro(expect_err TEXT)
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "Expected '${TEXT}' in the messages, got:\n${ERR}")
		endif()
	endmacro()
	macro(expect_no_err TEXT)
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "Did not expect '${TEXT}' in the messages, got:\n${ERR}")
		endif()
	endmacro()
	macro(expect_failed)
		if(RC EQUAL 0)
			message(FATAL_ERROR "Expected a failure, got success.\nstderr: ${ERR}")
		endif()
	endmacro()

	# One of each kind of warning.
	file(WRITE "${WORK}/w.bb"
		"Local i% = 2.5\n"
		"Local s$ = 5\n"
		"Local n% = \"7\"\n"
		"Local t = 1\n"
		"Local b:byte = 300\n"
		"Local f# = i\n"
		"Local d:double = 1.5\n"
		"Local h:float = d\n"
		"Local unused% = 1\n"
		"x = 3\n"
		"Foo(1)\n"
		"Goto done\n"
		"Print \"never\"\n"
		".done\n"
		"Print s + (i + n + t + b + f + h + x)\n"
		"Function Foo%(a%)\n"
		"\tReturn a\n"
		"End Function\n"
		"Function Bar%()\n"
		"\tReturn 1\n"
		"End Function\n"
		"Function Mismatch%()\n"
		"\tReturn \"5\"\n"
		"End Function\n"
		"Print Mismatch()\n"
		"Function Bare%()\n"
		"\tReturn\n"
		"End Function\n"
		"Print Bare()\n"
		"Local lstep# = 0.5\n"
		"For lreal# = 0 To 1 Step lstep\n"
		"Next\n"
		"Function KeepsValue(InOut a%)\n"
		"\tIf a > 0 Then Return\n"
		"\ta = 1\n"
		"End Function\n"
		"Local kept% = 0\n"
		"KeepsValue kept\n"
		"Local lend% = 5\n"
		"Local lsmall:byte\n"
		"For lsmall = 0 To lend\n"
		"Next\n")

	# Every warning turns on at its level, and stays on above it. -W2 is the default.
	set(_WARNINGS
		"implicit-lossy-int-to-int:1" "loop-iterator-type-unsafe:1" "loop-type-mismatch:1" "implicit-lossy-real-to-int:1" "implicit-lossy-real-to-real:1" "implicit-string-to-number:1"
		"implicit-lossy-int-to-real:2" "implicit-variable:2" "return-missing-value:2" "return-type-mismatch:2"
		"implicit-number-to-string:3" "inout-parameter-unwritten:3" "short-type-notation:3" "unreachable-code:3" "unused-variable:3"
		"typeless-declaration:4" "unused-result:4" "unused-function:4" "loop-unroll-requires-constant:4")
	foreach(_LEVEL RANGE 0 4)
		blitzcc(-c -W${_LEVEL} "${WORK}/w.bb")
		expect_ok()
		foreach(_ENTRY IN LISTS _WARNINGS)
			string(REPLACE ":" ";" _PARTS "${_ENTRY}")
			list(GET _PARTS 0 _NAME)
			list(GET _PARTS 1 _AT_LEVEL)
			if(_LEVEL GREATER_EQUAL _AT_LEVEL)
				expect_err("[-W${_NAME}]")
			else()
				expect_no_err("[-W${_NAME}]")
			endif()
		endforeach()
	endforeach()
	blitzcc(-c "${WORK}/w.bb")
	expect_err("[-Wimplicit-variable]")
	expect_no_err("[-Wunreachable-code]")

	# Messages: the kind, the span, and a suggestion.
	blitzcc(-c -W4 "${WORK}/w.bb")
	expect_err("w.bb:1:12: warning: Implicit conversion from Float32 to Int32, the fractional part is lost. [-Wimplicit-lossy-real-to-int]\nLocal i% = 2.5\n           ^^^ HERE\nnotice: Use Int(value) to convert on purpose, or SatInt(value) to stop at the limits of Int32.")
	expect_err("w.bb:13:1: notice: This statement can never run. [-Wunreachable-code]")
	expect_err("notice: 'unused' is never read, it is optimized away. [-Wunused-variable]")
	expect_err("notice: Function 'Bar' is never called, it is optimized away. [-Wunused-function]")
	expect_err("w.bb:10:1: warning: 'x' was not declared, it is a new local variable. [-Wimplicit-variable]")
	expect_err("w.bb:11:1: notice: The result of 'Foo' is not used. [-Wunused-result]")
	expect_err("w.bb:4:7: warning: 't' has no type, it is an Int. [-Wtypeless-declaration]")

	# A Field with a default value compiles like in the original, which never uses the value (level 2, on by default).
	file(WRITE "${WORK}/fielddefault.bb"
		"Type Thing\n"
		"\tField count% = 5, plain%\n"
		"End Type\n"
		"t.Thing = New Thing\n"
		"Print t\\count\n")
	blitzcc(-c "${WORK}/fielddefault.bb")
	expect_ok()
	expect_err("fielddefault.bb:2:15: warning: The default value of field 'count' is never used, New sets the field to 0, 0.0, \"\" or Null like in the original. [-Wfield-default-ignored]")
	expect_err("\nnotice: Set the field after New instead, or build with --field-defaults to use the default values.")
	expect_no_err("'plain'")
	blitzcc(-c -W1 "${WORK}/fielddefault.bb")
	expect_ok()
	expect_no_err("[-Wfield-default-ignored]")
	blitzcc(-c --field-defaults "${WORK}/fielddefault.bb")
	expect_ok()
	expect_no_err("[-Wfield-default-ignored]")
	# A call with its arguments in parentheses right before Else, which the original rejects (off at every level, -Wcompatibility).
	file(WRITE "${WORK}/onelineif.bb"
		"Function Pick(a%, b%)\n"
		"End Function\n"
		"Function Nothing()\n"
		"End Function\n"
		"Local c% = 1\n"
		"If c Then Pick(1, 2) Else Pick(3, 4)\n"
		"If c Then Nothing() Else Nothing()\n"
		"If c Then Pick 5, 6 Else Pick(7, 8)\n"
		"If c Then Print(1) Else Print(2)\n"
		"If c Then Pick (1, 2) Else Nothing\n"
		"If c Then Pick(1, 2) : Nothing() Else Nothing\n")
	foreach(_LEVEL RANGE 0 4)
		blitzcc(-c -W${_LEVEL} "${WORK}/onelineif.bb")
		expect_ok()
		expect_no_err("[-Wcompatibility-one-line-if-else]")
	endforeach()
	foreach(_OPTION IN ITEMS -Wcompatibility -Wcompatibility-one-line-if-else -WCOMPATIBILITY)
		blitzcc(-c ${_OPTION} "${WORK}/onelineif.bb")
		expect_ok()
		expect_err("onelineif.bb:6:11: warning: The original rejects the parentheses around the arguments of 'Pick' before Else (\"')' expected\"). [-Wcompatibility-one-line-if-else]")
		expect_err("\nnotice: Leave out the parentheses ('Pick a, b Else'), or write the If on several lines.")
		expect_err("onelineif.bb:7:11: warning: The original rejects the parentheses around the arguments of 'Nothing' before Else (\"Expecting expression\").")
		expect_err("onelineif.bb:10:11: warning:")
		expect_err("onelineif.bb:11:24: warning:")
		# The last call of a line, one with a single argument (read as (1) by the original) and Pick 5, 6 are fine.
		foreach(_FINE IN ITEMS "onelineif.bb:6:27:" "onelineif.bb:7:26:" "onelineif.bb:8:" "onelineif.bb:9:" "onelineif.bb:11:11:")
			expect_no_err("${_FINE}")
		endforeach()
	endforeach()
	blitzcc(-c -Wcompatibility -Wno-compatibility-one-line-if-else "${WORK}/onelineif.bb")
	expect_ok()
	expect_no_err("[-Wcompatibility-one-line-if-else]")
	blitzcc(-c -Werror=compatibility "${WORK}/onelineif.bb")
	expect_failed()
	expect_err("onelineif.bb:6:11: error: The original rejects the parentheses around the arguments of 'Pick' before Else (\"')' expected\"). [-Werror=compatibility-one-line-if-else]")
	blitzcc(-c -Werror "${WORK}/onelineif.bb")
	expect_ok()
	blitzcc(-c -Wcompatibility-bogus "${WORK}/onelineif.bb")
	expect_failed()
	# A Blitz array used with a type behind its name, which the original rejects (off at every level, -Wcompatibility). A field keeps it.
	file(WRITE "${WORK}/arraysuffix.bb"
		"Global weights#[5]\n"
		"Local names$[2]\n"
		"weights#[0] = 10.0 : weights[1] = 35.0\n"
		"names$[1] = \"x\"\n"
		"Print weights#[0] + weights[1] + Len(names[1])\n"
		"Type Thing\n"
		"\tField v#[3]\n"
		"End Type\n"
		"Local t.Thing = New Thing\n"
		"t\\v#[1] = 2\n")
	blitzcc(-c -W4 "${WORK}/arraysuffix.bb")
	expect_ok()
	expect_no_err("[-Wcompatibility-blitz-array-suffix]")
	blitzcc(-c -Wcompatibility "${WORK}/arraysuffix.bb")
	expect_ok()
	expect_err("arraysuffix.bb:3:1: warning: The original rejects a type behind the name of the Blitz array 'weights' where it is used (\"Variable type mismatch\"). [-Wcompatibility-blitz-array-suffix]")
	expect_err("\nnotice: Leave out the type here ('weights[...]'), it only belongs where the array is declared.")
	expect_err("arraysuffix.bb:4:1: warning: The original rejects a type behind the name of the Blitz array 'names'")
	expect_err("arraysuffix.bb:5:7: warning:")
	foreach(_FINE IN ITEMS "arraysuffix.bb:1:" "arraysuffix.bb:2:" "arraysuffix.bb:3:22:" "arraysuffix.bb:5:21:" "arraysuffix.bb:10:")
		expect_no_err("${_FINE}")
	endforeach()
	file(WRITE "${WORK}/fielddefault_array.bb"
		"Type Thing\n"
		"\tField list[3] = 1\n"
		"End Type\n")
	blitzcc(-c "${WORK}/fielddefault_array.bb")
	expect_failed()

	# Local arrays above 4 KiB in a function (level 1); the main program, small arrays and Global/Dim ones are left alone.
	file(WRITE "${WORK}/bigarray.bb"
		"Local mainbig%[5000]\n"
		"Dim dimmed%(5000)\n"
		"Function Big%()\n"
		"\tLocal big%[2000]\n"
		"\tLocal small%[1000]\n"
		"\tLocal names$[600]\n"
		"\tReturn big[1] + small[1] + Len(names[1])\n"
		"End Function\n"
		"Print Big() + mainbig[1] + dimmed(1)\n")
	blitzcc(-c -W1 "${WORK}/bigarray.bb")
	expect_ok()
	expect_err("bigarray.bb:4:8: warning: 'big' is a Local array of 8 KiB, which is made again on every call of the function. [-Wlarge-local-array]")
	expect_err("\nnotice: A Local array above 4 KiB costs time on every call, and above 64 KiB it lives on the heap.")
	expect_err("'names' is a Local array of 5 KiB")
	expect_no_err("'small'")
	expect_no_err("'mainbig'")
	expect_no_err("'dimmed'")
	blitzcc(-c -W0 "${WORK}/bigarray.bb")
	expect_no_err("[-Wlarge-local-array]")
	blitzcc(-c -Wno-large-local-array "${WORK}/bigarray.bb")
	expect_no_err("[-Wlarge-local-array]")

	# A very long chain of operators (a + a + a ...) is generated in linear time. It used to copy the code of the whole chain at
	# every operator, which took about a minute and a half for 100000 terms.
	string(REPEAT "a + " 60000 _CHAIN)
	file(WRITE "${WORK}/chain.bb" "Local a% = 1\nLocal x% = ${_CHAIN}a\nPrint x\n")
	execute_process(COMMAND "${BLITZCC}" -q -S -o "${WORK}/chain.ll" "${WORK}/chain.bb" WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE RC TIMEOUT 20)
	expect_ok()

	# A For loop whose start, end or step has another type than the counter is a warning, with -d too.
	file(WRITE "${WORK}/looptype.bb" "Local n% = 300\nFor b:Byte = 0 To n\nNext\n")
	blitzcc(-c "${WORK}/looptype.bb")
	expect_ok()
	expect_err("looptype.bb:2:19: warning: The End of the For loop is Int, but 'b' is Byte.")
	expect_err("[-Wloop-type-mismatch]")
	blitzcc(-c -d "${WORK}/looptype.bb")
	expect_ok()
	expect_err("looptype.bb:2:19: warning: The End of the For loop is Int, but 'b' is Byte.")
	file(WRITE "${WORK}/looptype_round.bb" "Local x# = 2.5\nFor k = 1 To x\nNext\n")
	blitzcc(-c -d "${WORK}/looptype_round.bb")
	expect_ok()
	expect_err("warning: The End of the For loop is Float, but 'k' is Int. The counter is an integer, so the End is rounded. [-Wloop-type-mismatch]")
	blitzcc(-c -d -Werror=loop-type-mismatch "${WORK}/looptype.bb")
	expect_failed()
	expect_err("[-Werror=loop-type-mismatch]")
	blitzcc(-c -d -Wno-loop-type-mismatch "${WORK}/looptype.bb")
	expect_ok()
	expect_no_err("[-Wloop-type-mismatch]")
	blitzcc(-c -d -W0 "${WORK}/looptype.bb")
	expect_ok()

	# A number that does not fit an Int is clamped like in the original, with a warning that says so. A suffix keeps the number.
	file(WRITE "${WORK}/literal_range.bb" "Print 5000000000\nPrint -2147483648\nPrint 5000000000i64\n")
	blitzcc(-c "${WORK}/literal_range.bb")
	expect_ok()
	expect_err("warning: The number '5000000000' does not fit into an Int, it is 2147483647 instead. [-Wliteral-out-of-range]")
	expect_err("warning: The number '-2147483648' does not fit into an Int, it is -2147483647 instead. [-Wliteral-out-of-range]")
	blitzcc(-c -Wno-literal-out-of-range "${WORK}/literal_range.bb")
	expect_ok()
	expect_no_err("[-Wliteral-out-of-range]")

	# Conversions name both types and the function that converts on purpose.
	file(WRITE "${WORK}/conv.bb" "Local i% = Long(5000000000i64)\nLocal f# = Long(5)\nLocal s$ = 5\nLocal n% = \"12\"\nLocal d# = Double(3)\nPrint i + f + d + n + s\n")
	blitzcc(-c -W4 "${WORK}/conv.bb")
	expect_err("warning: Implicit conversion from Int64 to Int32 can change the value. [-Wimplicit-lossy-int-to-int]")
	expect_err("\nnotice: Use Int(value) to convert on purpose, or SatInt(value) to stop at the limits instead of wrapping around.")
	expect_err("warning: Implicit conversion from Int64 to Float32 can change the value. [-Wimplicit-lossy-int-to-real]\nLocal f# = Long(5)\n           ^^^^--- HERE\nnotice: Use Float(value) to convert on purpose.")
	expect_err("warning: Implicit conversion from Int32 to String. [-Wimplicit-number-to-string]")
	expect_err("\nnotice: Use Str(value) to convert on purpose.")
	expect_err("warning: Implicit conversion from String to Int32. [-Wimplicit-string-to-number]")
	expect_err("warning: Implicit conversion from Float64 to Float32 can change the value. [-Wimplicit-lossy-real-to-real]")
	expect_no_err("[-Wunused-variable]\nLocal i")

	# Integers known while compiling (negative numbers, Consts, what is made of them) only warn when they really change.
	file(WRITE "${WORK}/known.bb"
		"Const K = 30\nConst BIG = 16777217\nConst NK = -K * 2\n"
		"Local a# = Rnd(-30, 30)\nLocal b# = Rnd(K, -K)\nLocal c# = NK + 1\nLocal d# = 16777218\nLocal e:half = -2048\nLocal g:byte = -K\nLocal h:double = BIG\n"
		"Local i# = BIG\nLocal j# = -16777217\nLocal m:half = 2049\nLocal n:byte = K * 5\n"
		"Print a + b + c + d + e + g + h + i + j + m + n\n"
		"Function Shadowed#()\n\tLocal k = 16777217\n\tLocal r# = K\n\tReturn r\nEnd Function\nPrint Shadowed()\n"
		"Function Minus#()\n\tReturn -1\nEnd Function\nPrint Minus()\n")
	blitzcc(-c "${WORK}/known.bb")
	expect_ok()
	foreach(_LINE 4 5 6 7 8 9 10 23)
		expect_no_err("known.bb:${_LINE}:")
	endforeach()
	expect_err("known.bb:11:12: warning: Implicit conversion from Int32 to Float32 can change the value. [-Wimplicit-lossy-int-to-real]")
	expect_err("known.bb:12:12: warning: Implicit conversion from Int32 to Float32 can change the value. [-Wimplicit-lossy-int-to-real]")
	expect_err("known.bb:13:16: warning: Implicit conversion from Int32 to Float16 can change the value. [-Wimplicit-lossy-int-to-real]")
	expect_err("known.bb:14:18: warning: Implicit conversion from Int32 to Int8 can change the value. [-Wimplicit-lossy-int-to-int]")
	# A Local of the same name hides the Const, so its value is not known.
	expect_err("known.bb:18:13: warning: Implicit conversion from Int32 to Float32 can change the value. [-Wimplicit-lossy-int-to-real]")

	# Return with another type than the function has: both types, and the function that fixes it.
	blitzcc(-c "${WORK}/w.bb")
	expect_err("w.bb:23:9: warning: Return gives String, but the function returns Int. [-Wreturn-type-mismatch]")
	expect_err("notice: Use Int(value) to convert on purpose.")
	file(WRITE "${WORK}/ret.bb"
		"Print Zero#()\nPrint Same#(1.5)\nPrint Wide#(1)\nLocal d:double = 1.5\nPrint Narrow#(d)\nPrint Text$(1)\nPrint Byt:byte(1)\n"
		"Function Zero#()\n\tReturn 0\nEnd Function\n"
		"Function Same#(f#)\n\tReturn f\nEnd Function\n"
		"Function Wide#(i%)\n\tReturn i\nEnd Function\n"
		"Function Narrow#(d:double)\n\tReturn d\nEnd Function\n"
		"Function Text$(i%)\n\tReturn i\nEnd Function\n"
		"Function Byt:byte(i%)\n\tReturn i\nEnd Function\n")
	blitzcc(-c "${WORK}/ret.bb")
	expect_err("Return gives Int, but the function returns Float. [-Wreturn-type-mismatch]")
	expect_err("Return gives Double, but the function returns Float. [-Wreturn-type-mismatch]\n")
	expect_err("notice: Use Float(value) to convert on purpose.")
	expect_err("Return gives Int, but the function returns String. [-Wreturn-type-mismatch]")
	expect_err("notice: Use Str(value) to convert on purpose.")
	expect_err("Return gives Int, but the function returns Byte. [-Wreturn-type-mismatch]")
	expect_err("notice: Change the type of the function or of the returned value.")
	# A literal that fits (Return 0 in a Float function) and the same type are fine, and the conversion warnings are not said twice.
	expect_no_err("ret.bb:8:")
	expect_no_err("ret.bb:9:")
	expect_no_err("[-Wimplicit-lossy")
	expect_no_err("[-Wimplicit-number-to-string]")
	# Without it, the conversion warnings say it at their levels.
	blitzcc(-c -W1 "${WORK}/ret.bb")
	expect_no_err("[-Wreturn-type-mismatch]")
	expect_err("[-Wimplicit-lossy-real-to-real]")
	blitzcc(-c -Wno-return-type-mismatch "${WORK}/ret.bb")
	expect_no_err("[-Wreturn-type-mismatch]")
	expect_err("[-Wimplicit-lossy-int-to-int]")

	# A bare Return in a function with a type; without one the function is an Int and it is left alone.
	file(WRITE "${WORK}/bare.bb"
		"Print Plain()\nPrint Num%()\nPrint Txt$()\nPrint Flt#()\nProc()\n"
		"Function Plain()\n\tReturn\nEnd Function\n"
		"Function Num%()\n\tReturn\nEnd Function\n"
		"Function Txt$()\n\tReturn\nEnd Function\n"
		"Function Flt#()\n\tReturn\nEnd Function\n"
		"Function Proc()\n\tReturn 1\nEnd Function\n")
	blitzcc(-c "${WORK}/bare.bb")
	expect_err("bare.bb:10:2: warning: Return has no value, but the function returns Int. [-Wreturn-missing-value]")
	expect_err("notice: Return a value, such as 'Return 0'.")
	expect_err("Return has no value, but the function returns String. [-Wreturn-missing-value]")
	expect_err("notice: Return a value, such as 'Return \"\"'.")
	expect_err("Return has no value, but the function returns Float. [-Wreturn-missing-value]")
	expect_err("notice: Return a value, such as 'Return 0.0'.")
	expect_no_err("bare.bb:7:")
	blitzcc(-c -Wno-return-missing-value "${WORK}/bare.bb")
	expect_no_err("[-Wreturn-missing-value]")

	# Functions, parameters and fields without a type are Ints too.
	file(WRITE "${WORK}/typeless.bb"
		"Type Box\n"
		"\tField size\n"
		"\tField weight#\n"
		"End Type\n"
		"Print Plain(1, 2)\nPrint Typed%(1, 2)\n"
		"Function Plain(a, b%)\n\tReturn a\nEnd Function\n"
		"Function Typed%(a%, b%)\n\tReturn a\nEnd Function\n")
	blitzcc(-c -W4 "${WORK}/typeless.bb")
	expect_err("typeless.bb:2:8: warning: Field 'size' has no type, it is an Int. [-Wtypeless-declaration]")
	expect_err("warning: Function 'Plain' has no type, it is an Int. [-Wtypeless-declaration]")
	expect_err("warning: Parameter 'a' has no type, it is an Int. [-Wtypeless-declaration]")
	expect_no_err("'b' has no type")
	expect_no_err("'weight' has no type")
	expect_no_err("'Typed' has no type")
	blitzcc(-c "${WORK}/typeless.bb")
	expect_no_err("[-Wtypeless-declaration]")

	# The short form of a type warns at -W3, the long form and a type name do not. The notice names the long form.
	file(WRITE "${WORK}/short.bb"
		"Type Box\n\tField w#\n\tField next.Box\nEnd Type\n"
		"Global g% = 1\nLocal l:Int32 = 2\nLocal big##, wide%%, name$\n"
		"Function Add$(a%, b:Float32)\n\tReturn Str(a + b)\nEnd Function\n"
		"Print Add(g, l) + name + big + wide\n")
	blitzcc(-c -W3 "${WORK}/short.bb")
	expect_err("short.bb:2:9: warning: The type is written in the short form. [-Wshort-type-notation]")
	expect_err("notice: Write the long form instead: ':Float32'.")
	expect_err("notice: Write the long form instead: ':Int32'.")
	expect_err("notice: Write the long form instead: ':Float64'.")
	expect_err("notice: Write the long form instead: ':Int64'.")
	expect_err("notice: Write the long form instead: ':String'.")
	expect_no_err("short.bb:3:")
	expect_no_err("short.bb:6:")
	blitzcc(-c "${WORK}/short.bb")
	expect_no_err("[-Wshort-type-notation]")
	blitzcc(-c -W3 -Wno-short-type-notation "${WORK}/short.bb")
	expect_no_err("[-Wshort-type-notation]")
	blitzcc(-c -Wshort-type-notation "${WORK}/short.bb")
	expect_err("[-Wshort-type-notation]")
	blitzcc(-c -W3 -Werror=short-type-notation "${WORK}/short.bb")
	expect_failed()
	expect_err("[-Werror=short-type-notation]")

	# Adding the type to a declaration does not trade one warning for another: it is written in the long form.
	file(WRITE "${WORK}/untyped.bb" "Local t = 1\nPrint t\n")
	blitzcc(-c -W4 "${WORK}/untyped.bb")
	expect_err("Add the type to the name: 't:Int32', 't:Float32', 't:String' or 't.TypeName' (object).")
	expect_no_err("[-Wshort-type-notation]")

	# A number that is written in the program and fits is fine.
	file(WRITE "${WORK}/fits.bb" "Local b:byte = 100\nLocal f:Float32 = 1000\nPrint b + f\n")
	blitzcc(-c -W4 "${WORK}/fits.bb")
	expect_ok()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no warnings, got:\n${ERR}")
	endif()

	# Only a call that throws a value away warns: not a built-in without a result, not a function without 'Return value',
	# and not a call that is used in an expression, an If or a Select.
	file(WRITE "${WORK}/calls.bb"
		"Print \"hello\"\n"
		"Proc(1)\n"
		"Proc 2\n"
		"Early(1)\n"
		"If Value(1) = 1 Then Print \"if\"\n"
		"If Value(2) Then Print \"if\"\n"
		"Select Value(3)\n"
		"Case 3\n"
		"\tPrint \"select\"\n"
		"End Select\n"
		"Local v% = Value(4)\n"
		"Print v + Value(5)\n"
		"Nested(1)\n"
		"Value(6)\n"
		"Function Proc(a%)\n"
		"\tPrint a\n"
		"End Function\n"
		"Function Early(a%)\n"
		"\tIf a Then Return\n"
		"\tPrint a\n"
		"End Function\n"
		"Function Value%(a%)\n"
		"\tReturn a\n"
		"End Function\n"
		"Function Nested%(a%)\n"
		"\tWhile a\n"
		"\t\tSelect a\n"
		"\t\tCase 1\n"
		"\t\t\tReturn 1\n"
		"\t\tEnd Select\n"
		"\tWend\n"
		"End Function\n")
	blitzcc(-c -W4 "${WORK}/calls.bb")
	expect_ok()
	expect_err("calls.bb:13:1: notice: The result of 'Nested' is not used. [-Wunused-result]")
	expect_err("calls.bb:14:1: notice: The result of 'Value' is not used. [-Wunused-result]")
	expect_no_err("'Proc' is not used")
	expect_no_err("'Early' is not used")
	expect_no_err("'Print' is not used")
	string(REGEX MATCHALL "\\[-Wunused-result\\]" _UNUSED "${ERR}")
	list(LENGTH _UNUSED _UNUSED_COUNT)
	if(NOT _UNUSED_COUNT EQUAL 2)
		message(FATAL_ERROR "Expected 2 unused-result warnings, got ${_UNUSED_COUNT}:\n${ERR}")
	endif()

	# -W<name> and -Wno-<name> win over the level, in any order, and options are not case sensitive.
	blitzcc(-c -Wno-implicit-lossy-real-to-int "${WORK}/w.bb")
	expect_ok()
	expect_no_err("[-Wimplicit-lossy-real-to-int]")
	expect_err("[-Wimplicit-string-to-number]")
	blitzcc(-Wno-implicit-lossy-real-to-int -c -W4 "${WORK}/w.bb")
	expect_no_err("[-Wimplicit-lossy-real-to-int]")
	expect_err("[-Wunused-function]")
	blitzcc(-W0 -Wunused-function -c "${WORK}/w.bb")
	expect_err("[-Wunused-function]")
	expect_no_err("[-Wimplicit-lossy-real-to-int]")
	blitzcc(-c -WNO-IMPLICIT-VARIABLE "${WORK}/w.bb")
	expect_no_err("[-Wimplicit-variable]")

	# Unknown names are errors.
	blitzcc(-c -Wnothing "${WORK}/w.bb")
	expect_failed()
	expect_err("Unknown warning 'nothing'")
	blitzcc(-c -Wno-nothing "${WORK}/w.bb")
	expect_failed()
	blitzcc(-c -Werror=nothing "${WORK}/w.bb")
	expect_failed()

	# -Werror: the warnings are printed as errors, everything is still checked, and the compilation fails. Notices stay notices.
	blitzcc(-c -W4 -Werror "${WORK}/w.bb")
	expect_failed()
	expect_err("w.bb:1:12: error: Implicit conversion from Float32 to Int32, the fractional part is lost. [-Werror=implicit-lossy-real-to-int]")
	expect_err("[-Werror=implicit-string-to-number]")
	expect_err("notice: This statement can never run. [-Wunreachable-code]")
	expect_err("warning(s) treated as errors")
	blitzcc(-c -Werror -W0 "${WORK}/w.bb")
	expect_ok()
	blitzcc(-c -Werror -Wno-error "${WORK}/w.bb")
	expect_ok()
	file(WRITE "${WORK}/hint.bb" "Local a:Int32 = 1\n")
	blitzcc(-c -W4 -Werror "${WORK}/hint.bb")
	expect_ok()
	expect_err("notice: 'a' is never read")
	blitzcc(-c -W4 -Werror=unused-variable "${WORK}/hint.bb")
	expect_failed()
	expect_err("error: 'a' is never read, it is optimized away. [-Werror=unused-variable]")

	# -Werror=<name> only fails for that warning, and turns it on if the level doesn't.
	blitzcc(-c -Werror=implicit-lossy-real-to-int "${WORK}/w.bb")
	expect_failed()
	expect_err("[-Werror=implicit-lossy-real-to-int]")
	expect_err("warning: Implicit conversion from String to Int32. [-Wimplicit-string-to-number]")
	blitzcc(-c -W0 -Werror=unreachable-code "${WORK}/w.bb")
	expect_failed()
	expect_err("w.bb:13:1: error: This statement can never run. [-Werror=unreachable-code]")
	blitzcc(-c -Werror -Wno-error=implicit-lossy-real-to-int -Wno-error=implicit-lossy-int-to-int -Wno-error=implicit-lossy-int-to-real -Wno-error=implicit-lossy-real-to-real -Wno-error=implicit-string-to-number -Wno-error=typeless-declaration -Wno-error=implicit-variable -Wno-error=loop-iterator-type-unsafe -Wno-error=loop-type-mismatch -Wno-error=unused-result -Wno-error=return-missing-value -Wno-error=return-type-mismatch -Wno-error=implicit-number-to-string "${WORK}/w.bb")
	expect_ok()
	expect_err("[-Wimplicit-lossy-real-to-int]")

	# -q hides warnings but not the ones that are errors, +q hides everything and still fails.
	blitzcc(-q -c -Werror "${WORK}/w.bb")
	expect_failed()
	expect_err("[-Werror=implicit-lossy-real-to-int]")
	blitzcc(+q -c -Werror "${WORK}/w.bb")
	expect_failed()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no messages with +q, got:\n${ERR}")
	endif()

	# The warnings are in the help.
	blitzcc(--help)
	expect_ok()
	foreach(_ENTRY IN LISTS _WARNINGS)
		string(REPLACE ":" ";" _PARTS "${_ENTRY}")
		list(GET _PARTS 0 _NAME)
		expect_contains("-W${_AT_LEVEL}")
		expect_contains("${_NAME}")
	endforeach()
	foreach(_OPTION IN ITEMS "-W0 .. -W4" "-W<name>" "-Werror")
		expect_contains("${_OPTION}")
	endforeach()
	expect_contains("  off  compatibility-one-line-if-else")
	expect_contains("  -Wcompatibility  Every 'compatibility-' warning.")

elseif(CASE STREQUAL "parameter_modes")
	macro(expect_err TEXT)
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "Expected '${TEXT}' in the messages, got:\n${ERR}")
		endif()
	endmacro()
	macro(expect_no_err TEXT)
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "Did not expect '${TEXT}' in the messages, got:\n${ERR}")
		endif()
	endmacro()
	# Writes a program with a function and a call, compiles it, and expects the compiler to refuse it with the message.
	function(refuse NAME TEXT FUNCTION CALL)
		file(WRITE "${WORK}/${NAME}.bb" "${FUNCTION}\n${CALL}\n")
		blitzcc(-c "${WORK}/${NAME}.bb")
		if(RC EQUAL 0)
			message(FATAL_ERROR "${NAME}: the program was accepted.")
		endif()
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "${NAME}: expected '${TEXT}', got:\n${ERR}")
		endif()
	endfunction()
	function(accept NAME FUNCTION CALL)
		file(WRITE "${WORK}/${NAME}.bb" "${FUNCTION}\n${CALL}\n")
		blitzcc(-c -W4 "${WORK}/${NAME}.bb")
		if(NOT RC EQUAL 0)
			message(FATAL_ERROR "${NAME}: the program was refused:\n${ERR}")
		endif()
		set(ERR "${ERR}" PARENT_SCOPE)
	endfunction()

	# What the caller can pass.
	set(_SET "Function Set(Out a:Int32)\n\ta = 1\nEnd Function")
	refuse(literal "needs a variable, array element or field to write to, not a value" "${_SET}" "Set 5")
	refuse(expression "needs a variable, array element or field to write to, not a value" "${_SET}" "Local v:Int32\nSet v + 1")
	refuse(call_result "needs a variable, array element or field to write to, not a value" "${_SET}" "Set Abs(1)")
	refuse(constant "can't write to a constant" "${_SET}" "Const c:Int32 = 3\nSet c")
	refuse(wrong_type "has to be given a variable of type Int, not Float" "${_SET}" "Local f:Float32\nSet f")
	refuse(whole_array "can't take a whole array" "${_SET}" "Local a[3]\nSet a")
	refuse(whole_vector "can't take a IntVector3" "${_SET}" "Local a:IntVector3\nSet a")
	refuse(inout_literal "needs a variable, array element or field to write to, not a value" "Function Inc(InOut a:Int32)\n\ta = a + 1\nEnd Function" "Inc 1")
	refuse(missing_required "expects 1 to 1 arguments, got 0" "${_SET}" "Set")

	# Out has to be written on every path.
	refuse(out_unwritten "Out parameter 'a' of 'Skip' is not written on every path" "Function Skip(Out a:Int32)\nEnd Function" "Local v:Int32\nSkip v")
	refuse(out_one_branch "Out parameter 'a' of 'Skip' is not written on every path" "Function Skip(f:Int32, Out a:Int32)\n\tIf f Then a = 1\nEnd Function" "Local v:Int32\nSkip 1, v")
	refuse(out_early_return "Out parameter 'a' of 'Skip' is not written on every path" "Function Skip(f:Int32, Out a:Int32)\n\tIf f Then Return\n\ta = 1\nEnd Function" "Local v:Int32\nSkip 1, v")
	refuse(out_loop "Out parameter 'a' of 'Skip' is not written on every path" "Function Skip(Out a:Int32)\n\tWhile 0\n\t\ta = 1\n\tWend\nEnd Function" "Local v:Int32\nSkip v")
	refuse(out_exit "Out parameter 'a' of 'Skip' is not written on every path" "Function Skip(f:Int32, Out a:Int32)\n\tRepeat\n\t\tIf f Then Exit\n\t\ta = 1\n\tUntil 1\nEnd Function" "Local v:Int32\nSkip 1, v")
	refuse(out_select "Out parameter 'a' of 'Skip' is not written on every path" "Function Skip(f:Int32, Out a:Int32)\n\tSelect f\n\t\tCase 1\n\t\t\ta = 1\n\tEnd Select\nEnd Function" "Local v:Int32\nSkip 1, v")
	# These write on every path.
	set(_FINE
		"Function Ok(f:Int32, Out a:Int32)\n\tIf f Then\n\t\ta = 1\n\tElse\n\t\ta = 2\n\tEndIf\nEnd Function"
		"Function Ok(f:Int32, Out a:Int32)\n\ta = 0\n\tIf f Then Return\n\ta = 1\nEnd Function"
		"Function Ok(f:Int32, Out a:Int32)\n\tSelect f\n\t\tCase 1\n\t\t\ta = 1\n\t\tDefault\n\t\t\ta = 2\n\tEnd Select\nEnd Function"
		"Function Ok(f:Int32, Out a:Int32)\n\tRepeat\n\t\ta = 1\n\t\tIf f Then Exit\n\tUntil 1\nEnd Function"
		"Function Ok(f:Int32, Out a:Int32)\n\tFor a = 0 To 3\n\tNext\nEnd Function"
		"Function Other(Out b:Int32)\n\tb = 1\nEnd Function\nFunction Ok(f:Int32, Out a:Int32)\n\tOther(a)\nEnd Function")
	set(_INDEX 0)
	foreach(_CODE IN LISTS _FINE)
		accept(fine${_INDEX} "${_CODE}" "Local v:Int32\nOk 1, v")
		expect_no_err("not written")
		math(EXPR _INDEX "${_INDEX} + 1")
	endforeach()

	# InOut only warns, for every path that leaves without writing.
	accept(inout_unwritten "Function Skip(f:Int32, InOut a:Int32)\n\tIf f Then Return\n\tIf f + 1 Then Return\nEnd Function" "Local v:Int32\nSkip 1, v")
	expect_err("inout_unwritten.bb:2:12: warning: InOut parameter 'a' of 'Skip' is not written on this path, the caller keeps the value it had. [-Winout-parameter-unwritten]")
	expect_err("inout_unwritten.bb:3:16: warning: InOut parameter 'a' of 'Skip' is not written on this path")
	expect_err("inout_unwritten.bb:4:1: warning: InOut parameter 'a' of 'Skip' is not written on this path")
	accept(inout_written "Function Add(InOut a:Int32)\n\ta = a + 1\nEnd Function" "Local v:Int32\nAdd v")
	expect_no_err("inout-parameter-unwritten")
	blitzcc(-c -W2 "${WORK}/inout_unwritten.bb")
	expect_ok()
	expect_no_err("inout-parameter-unwritten")
	blitzcc(-c -W2 -Winout-parameter-unwritten "${WORK}/inout_unwritten.bb")
	expect_ok()
	expect_err("inout-parameter-unwritten")
	blitzcc(-c -Werror -W3 "${WORK}/inout_unwritten.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "-Werror should have turned the warning into an error.")
	endif()

	# In, Out and InOut stay usable as names, and In is the default.
	accept(names "Function F(in:Int32, out:Int32, inout:Int32)\n\tPrint in + out + inout\nEnd Function\nFunction G(In a:Int32)\n\ta = 1\nEnd Function" "Local in:Int32 = 1\nF in, 2, 3\nG in")

elseif(CASE STREQUAL "shipped_include")
	# Include "<name>" reads the files shipped with BlitzLLVM, from 'include' next to the compiler in the build directory. -I comes
	# first, a file is read once however its name is written, and a name can't leave the include directory.
	set(_DIR "${TESTS}/cli/include")
	blitzcc(+q "${_DIR}/shipped.bb")
	expect_ok()
	if(NOT OUT STREQUAL "1,28,28,4,2,270\n")
		message(FATAL_ERROR "Expected the shipped constants, got:\n${OUT}${ERR}")
	endif()
	blitzcc(+q "${_DIR}/once.bb")
	expect_ok()
	if(NOT OUT STREQUAL "57\n")
		message(FATAL_ERROR "Expected keys.bb to be read once, got:\n${OUT}${ERR}")
	endif()
	blitzcc(+q -I "${_DIR}/override" "${_DIR}/override.bb")
	expect_ok()
	if(NOT OUT STREQUAL "99\n")
		message(FATAL_ERROR "Expected -I to win over the installation, got:\n${OUT}${ERR}")
	endif()
	blitzcc(+q --include-dir "${_DIR}/override" "${_DIR}/override.bb")
	expect_ok()
	if(NOT OUT STREQUAL "99\n")
		message(FATAL_ERROR "Expected --include-dir to win over the installation, got:\n${OUT}${ERR}")
	endif()
	foreach(_PAIR IN ITEMS "missing|does not exist (looked in" "parent|is not a name of a shipped include" "empty|is not a name of a shipped include")
		string(REPLACE "|" ";" _PAIR "${_PAIR}")
		list(GET _PAIR 0 _FILE)
		list(GET _PAIR 1 _TEXT)
		blitzcc(-c "${_DIR}/${_FILE}.bb")
		string(FIND "${OUT}${ERR}" "${_TEXT}" _AT)
		if((RC EQUAL 0) OR (_AT EQUAL -1))
			message(FATAL_ERROR "Expected '${_TEXT}' for ${_FILE}.bb, got '${RC}':\n${OUT}${ERR}")
		endif()
	endforeach()

elseif(CASE STREQUAL "shipped_include_layout")
	# Installed, the files are in <prefix>/include (Windows, with the compiler in bin or bin/<architecture>) or
	# <prefix>/share/blitzllvm/include (Linux packages). BLITZLLVM_INCLUDE wins over both.
	get_filename_component(_BIN_DIR "${BLITZCC}" DIRECTORY)
	get_filename_component(_NAME "${BLITZCC}" NAME)
	set(_ORIGINAL "${BLITZCC}")
	set(_PROGRAM "${TESTS}/cli/include/shipped.bb")
	foreach(_LAYOUT IN ITEMS "bin|include" "bin/x86_64|include" "bin|share/blitzllvm/include")
		string(REPLACE "|" ";" _LAYOUT "${_LAYOUT}")
		list(GET _LAYOUT 0 _BIN)
		list(GET _LAYOUT 1 _INCLUDE)
		file(REMOVE_RECURSE "${WORK}/prefix")
		file(MAKE_DIRECTORY "${WORK}/prefix/${_BIN}")
		file(COPY "${_ORIGINAL}" DESTINATION "${WORK}/prefix/${_BIN}")
		file(COPY "${_BIN_DIR}/include/" DESTINATION "${WORK}/prefix/${_INCLUDE}")
		set(BLITZCC "${WORK}/prefix/${_BIN}/${_NAME}")
		blitzcc(-c "${_PROGRAM}")
		if(NOT RC EQUAL 0)
			message(FATAL_ERROR "Expected ${_INCLUDE} to be found from ${_BIN}, got '${RC}':\n${OUT}${ERR}")
		endif()
	endforeach()
	# Without the files, the message says so. BLITZLLVM_INCLUDE then gives them back.
	file(REMOVE_RECURSE "${WORK}/prefix/share")
	blitzcc(-c "${_PROGRAM}")
	string(FIND "${OUT}${ERR}" "there is no include directory" _AT)
	if((RC EQUAL 0) OR (_AT EQUAL -1))
		message(FATAL_ERROR "Expected a failure without an include directory, got '${RC}':\n${OUT}${ERR}")
	endif()
	set(ENV{BLITZLLVM_INCLUDE} "${_BIN_DIR}/include")
	blitzcc(-c "${_PROGRAM}")
	if(NOT RC EQUAL 0)
		message(FATAL_ERROR "Expected BLITZLLVM_INCLUDE to be used, got '${RC}':\n${OUT}${ERR}")
	endif()

elseif(CASE STREQUAL "shipped_include_files")
	# Every shipped file compiles on its own, and all of them together (no name is declared twice).
	get_filename_component(_BIN_DIR "${BLITZCC}" DIRECTORY)
	file(GLOB_RECURSE _FILES RELATIVE "${_BIN_DIR}/include" "${_BIN_DIR}/include/*.bb")
	list(LENGTH _FILES _COUNT)
	if(_COUNT LESS 2)
		message(FATAL_ERROR "Expected the shipped include files in ${_BIN_DIR}/include, found: ${_FILES}")
	endif()
	foreach(_FILE IN LISTS _FILES)
		file(WRITE "${WORK}/use.bb" "Include \"<${_FILE}>\"\n")
		blitzcc(-c "${WORK}/use.bb")
		if(NOT RC EQUAL 0)
			message(FATAL_ERROR "${_FILE} does not compile:\n${OUT}${ERR}")
		endif()
	endforeach()

elseif(CASE STREQUAL "include_device_names")
	# Windows opens a device for CON, PRN, AUX, NUL, COM0-9 and LPT0-9 in any folder and with any extension. Neither form of Include
	# takes them, and a directory isn't a file either.
	set(_DIR "${TESTS}/cli/include")
	foreach(_PAIR IN ITEMS "device|name of a Windows device" "device_dir|name of a Windows device" "device_shipped|name of a Windows device" "directory|it is not a file")
		string(REPLACE "|" ";" _PAIR "${_PAIR}")
		list(GET _PAIR 0 _FILE)
		list(GET _PAIR 1 _TEXT)
		blitzcc(-c "${_DIR}/${_FILE}.bb")
		string(FIND "${OUT}${ERR}" "${_TEXT}" _AT)
		if((RC EQUAL 0) OR (_AT EQUAL -1))
			message(FATAL_ERROR "Expected '${_TEXT}' for ${_FILE}.bb, got '${RC}':\n${OUT}${ERR}")
		endif()
	endforeach()

elseif(CASE STREQUAL "temp_directory")
	# A build keeps its files in a folder of its own that is new, can't be guessed from the names of the files, and is private: a folder
	# that another user made (or a name they knew in advance) would be where the compiler wrote and read the program it builds.
	set(_TEMP "${WORK}/temp")
	file(MAKE_DIRECTORY "${_TEMP}")
	foreach(_RUN IN ITEMS 1 2)
		execute_process(
			COMMAND "${CMAKE_COMMAND}" -E env "TMPDIR=${_TEMP}" "TEMP=${_TEMP}" "TMP=${_TEMP}" "${BLITZCC}" +q --keep-temps "${PROGRAM}" -o "${WORK}/program${_RUN}${CMAKE_EXECUTABLE_SUFFIX}"
			RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR
		)
		expect_ok()
	endforeach()
	file(GLOB _DIRECTORIES LIST_DIRECTORIES true "${_TEMP}/blitzllvm-*")
	list(LENGTH _DIRECTORIES _COUNT)
	if(NOT _COUNT EQUAL 2)
		message(FATAL_ERROR "Two builds of the same program with the same output should have kept two folders, found ${_COUNT}: ${_DIRECTORIES}")
	endif()
	if(NOT CMAKE_HOST_WIN32)
		foreach(_DIRECTORY IN LISTS _DIRECTORIES)
			execute_process(COMMAND stat -c %a "${_DIRECTORY}" OUTPUT_VARIABLE _MODE OUTPUT_STRIP_TRAILING_WHITESPACE)
			if(NOT _MODE STREQUAL "700")
				message(FATAL_ERROR "The folder ${_DIRECTORY} of a build has the permissions ${_MODE}, only its owner should be able to use it (700).")
			endif()
		endforeach()
	endif()

elseif(CASE STREQUAL "shell_quoting")
	# The compiler runs clang through a shell, and the names of the files are in the command. A name with a line break in it must not start another
	# command, and a name with a quote, a ~ or a # in it has to be the name of the file.
	if(CMAKE_HOST_WIN32)
		return()
	endif()
	# This script is what a name that starts another command would run: a line break is not one of the characters that used to be quoted.
	file(WRITE "${WORK}/ps" "#!/bin/sh\ntouch pwned\n")
	file(CHMOD "${WORK}/ps" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
	file(MAKE_DIRECTORY "${WORK}/line\n.")
	set(_NAMES "line\n./ps" "quote' && touch pwned && '" "sub\$(touch pwned)" "~tilde" "hash #" "brace{a,b}" "star*" "bang!")
	# The results are checked after the files are removed: a name with a line break in it can't be part of the uploaded test output (the
	# artifact upload refuses it), so it must not be left behind when a check fails either.
	set(_PROBLEMS)
	foreach(_NAME IN LISTS _NAMES)
		blitzcc(+q "${PROGRAM}" -o "${WORK}/${_NAME}")
		if(NOT RC EQUAL 0)
			list(APPEND _PROBLEMS "The name '${_NAME}' was not built, got '${RC}'.\nstdout: ${OUT}\nstderr: ${ERR}")
		elseif(NOT EXISTS "${WORK}/${_NAME}")
			list(APPEND _PROBLEMS "The executable '${_NAME}' was not made with that name.")
		endif()
		if(EXISTS "${WORK}/pwned")
			list(APPEND _PROBLEMS "The name '${_NAME}' started a command.")
			file(REMOVE "${WORK}/pwned")
		endif()
	endforeach()
	file(REMOVE_RECURSE "${WORK}/line\n.")
	if(_PROBLEMS)
		message(FATAL_ERROR "${_PROBLEMS}")
	endif()

elseif(CASE STREQUAL "vector_errors")
	# What the compiler refuses for vectors and matrices, with the message that says why.
	function(refuse NAME TEXT PROGRAM)
		file(WRITE "${WORK}/${NAME}.bb" "${PROGRAM}\n")
		blitzcc(-q -c "${WORK}/${NAME}.bb")
		if(RC EQUAL 0)
			message(FATAL_ERROR "${NAME}: the program was accepted.")
		endif()
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "${NAME}: expected '${TEXT}', got:\n${ERR}")
		endif()
	endfunction()
	function(accept NAME PROGRAM)
		file(WRITE "${WORK}/${NAME}.bb" "${PROGRAM}\n")
		blitzcc(-q -c "${WORK}/${NAME}.bb")
		if(NOT RC EQUAL 0)
			message(FATAL_ERROR "${NAME}: the program was refused:\n${ERR}")
		endif()
	endfunction()

	refuse(too_few_numbers "'FloatVector3' needs 3 numbers (or one number for all of them), but got 2." "Local a:FloatVector3 = FloatVector3(1, 2)")
	refuse(sizes_differ "Can't combine FloatVector3 with FloatVector4, they have to be of the same size." "Local a:FloatVector3\nLocal b:FloatVector4\nLocal c:FloatVector3 = a + b")
	refuse(assign_sizes "Can't assign FloatVector2 to FloatVector3, the sizes have to be the same." "Local a:FloatVector3\nLocal b:FloatVector2\na = b")
	refuse(number_for_vector "Can't assign Int to FloatVector3, the sizes have to be the same." "Local a:FloatVector3\na = 1")
	refuse(vector_for_number "A FloatVector3 can't be used where a single Int is needed." "Local a:FloatVector3\nLocal n = a")
	refuse(print_vector "A FloatVector3 can't be used where a String is needed." "Local a:FloatVector3\nPrint a")
	refuse(condition "A FloatVector3 has no truth value, compare it with = or <>." "Local a:FloatVector3\nIf a Then Print 1")
	refuse(less_than "can only be compared with = and <>" "Local a:FloatVector3\nIf a < a Then Print 1")
	refuse(no_component "A FloatVector2 has no '\\z'." "Local a:FloatVector2\nPrint a\\z")
	refuse(bad_component "is not a component of a vector" "Local a:FloatVector2\nPrint a\\q")
	refuse(swizzle_write "can only be read, not assigned to" "Local a:FloatVector4\na\\xy = a\\zw")
	refuse(matrix_product "Can't multiply FloatMatrix3x2 by FloatMatrix2x2" "Local a:FloatMatrix3x2\nLocal b:FloatMatrix2x2\nLocal c:FloatMatrix2x2 = a * b")
	refuse(const_vector "can't be a Const" "Const a:FloatVector3 = FloatVector3(1, 2, 3)")
	refuse(big_size "has to be between 1 and 1024" "Local a:FloatVector2000")
	refuse(parameter_sizes "Parameter 'v' of 'F' is a FloatVector3, not FloatVector4" "Function F:Void(v:FloatVector3)\nEnd Function\nLocal a:FloatVector4\nF a")
	refuse(parameter_number "Parameter 'v' of 'F' is a FloatVector3, not Int" "Function F:Void(v:FloatVector3)\nEnd Function\nF 1")
	refuse(out_vector "can only be given as an In parameter" "Function F:Void(Out v:FloatVector3)\nEnd Function\nLocal a:FloatVector3\nF a")

	# The size behind a name still counts up to the highest index, a space keeps the old meaning behind a type.
	accept(old_arrays "Local a[3]\na[3] = 1\nLocal b:Float [3]\nb[3] = 1\nLocal c:Float[3]\nc[3] = 1")
	# Names that already mean a number are no vectors.
	accept(scalar_names "Local a:Int8 = 5\nLocal b:Float32 = 1.5\nLocal c:Float16 = 2")
	# A program that has its own functions and variables of those names keeps working.
	accept(own_function "Function FloatVector3:Float(a)\n\tReturn a * 2\nEnd Function\nLocal r:Float = FloatVector3(2)")

elseif(CASE STREQUAL "help")
	blitzcc(--help)
	expect_ok()
	foreach(_OPTION IN ITEMS "-q " "+q " "-c " "-d " "-k " "+k " "-v " "-o <file>" "--console" "--verbose" "--userlibs-dir")
		expect_contains("  ${_OPTION}")
	endforeach()
	expect_contains("  --version")
	# It stops right away, whatever else is given.
	blitzcc(--bogus-option --help "${WORK}/missing.bb" -o "${EXE}")
	expect_ok()
	expect_contains("Usage")
	if(EXISTS "${EXE}")
		message(FATAL_ERROR "--help built the program.")
	endif()

else()
	message(FATAL_ERROR "Unknown test case '${CASE}'.")
endif()
