elseif(CASE STREQUAL "windows_manifest")
	# Programs for Windows carry a manifest that makes them DPI aware (per monitor, version 2) and the icon of BlitzLLVM, as a resource file for the linker.
	# Cross-compiling shows the link line and keeps the file even though the link itself may fail here, so the result is not checked.
	set(_TEMP "${WORK}/temp")
	file(MAKE_DIRECTORY "${_TEMP}")
	execute_process(
		COMMAND "${CMAKE_COMMAND}" -E env "TMPDIR=${_TEMP}" "TEMP=${_TEMP}" "TMP=${_TEMP}" "${BLITZCC}" --verbose --keep-temps --target x86_64-pc-windows-msvc "${PROGRAM}" -o "${WORK}/msvc.exe"
		RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR
	)
	expect_contains("resources.res")
	file(GLOB _FILES "${_TEMP}/blitzllvm-*/resources.res")
	list(LENGTH _FILES _COUNT)
	if(NOT _COUNT EQUAL 1)
		message(FATAL_ERROR "Expected one resources.res kept, found ${_COUNT}: ${_FILES}")
	endif()
	file(READ "${_FILES}" _HEX HEX)
	# The empty entry that starts every 32 bit resource file: no data, a header of 32 bytes, type 0 and name 0.
	string(SUBSTRING "${_HEX}" 0 16 _HEAD)
	if(NOT _HEAD STREQUAL "0000000020000000")
		message(FATAL_ERROR "The resource file does not start with the empty entry: ${_HEAD}")
	endif()
	# The second entry is a manifest (RT_MANIFEST 24) with ID 1.
	string(SUBSTRING "${_HEX}" 80 16 _ENTRY)
	if(NOT _ENTRY STREQUAL "ffff1800ffff0100")
		message(FATAL_ERROR "The second entry is not the manifest with ID 1: ${_ENTRY}")
	endif()
	foreach(_NEEDED IN ITEMS "PerMonitorV2" "true/pm" "longPathAware" "{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" "{35138b9a-5d96-4fbd-8e2d-a2440225f93a}")
		string(HEX "${_NEEDED}" _NEEDED_HEX)
		string(FIND "${_HEX}" "${_NEEDED_HEX}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "The manifest does not contain '${_NEEDED}'.")
		endif()
	endforeach()
	# The icon of BlitzLLVM is the icon of every program: an RT_GROUP_ICON (14) with ID 1 and seven RT_ICON (3) entries, one per size.
	string(FIND "${_HEX}" "ffff0e00ffff0100" _GROUP_AT)
	string(FIND "${_HEX}" "ffff0300ffff0100" _FIRST_AT)
	string(FIND "${_HEX}" "ffff0300ffff0700" _LAST_AT)
	if(_GROUP_AT EQUAL -1 OR _FIRST_AT EQUAL -1 OR _LAST_AT EQUAL -1)
		message(FATAL_ERROR "The resource file does not hold the icon group and its seven images.")
	endif()
	# MinGW has the GNU linker by default, which doesn't take resource files; lld does.
	blitzcc(--verbose --target x86_64-w64-mingw32 "${PROGRAM}" -o "${WORK}/mingw.exe")
	expect_contains("resources.res")
	expect_contains("-fuse-ld=lld")
	# A program that brings its own resources or manifest is left alone.
	blitzcc(--verbose --llvm-flag "${WORK}/own.res" --target x86_64-pc-windows-msvc "${PROGRAM}" -o "${WORK}/own.exe")
	expect_missing("resources.res")
	blitzcc(--verbose --llvm-flag -Wl,/manifestinput:own.manifest --target x86_64-pc-windows-msvc "${PROGRAM}" -o "${WORK}/own.exe")
	expect_missing("resources.res")
	# Other systems have no manifests.
	if(NOT CMAKE_HOST_WIN32)
		blitzcc(--verbose "${PROGRAM}" -o "${EXE}")
		expect_ok()
		expect_missing("resources.res")
	endif()

elseif(CASE STREQUAL "windows_icon_option")
	# --icon replaces the icon of BlitzLLVM in the resource file of a program for Windows. tiny.ico has one image, whose bytes are "ABCD".
	set(_TEMP "${WORK}/temp")
	file(MAKE_DIRECTORY "${_TEMP}")
	execute_process(
		COMMAND "${CMAKE_COMMAND}" -E env "TMPDIR=${_TEMP}" "TEMP=${_TEMP}" "TMP=${_TEMP}" "${BLITZCC}" --verbose --keep-temps --icon "${TESTS}/cli/tiny.ico" --target x86_64-pc-windows-msvc "${PROGRAM}" -o "${WORK}/icon.exe"
		RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR
	)
	expect_contains("resources.res")
	file(GLOB _FILES "${_TEMP}/blitzllvm-*/resources.res")
	list(LENGTH _FILES _COUNT)
	if(NOT _COUNT EQUAL 1)
		message(FATAL_ERROR "Expected one resources.res kept, found ${_COUNT}: ${_FILES}")
	endif()
	file(READ "${_FILES}" _HEX HEX)
	# The group (RT_GROUP_ICON 14, ID 1) and exactly one image (RT_ICON 3, ID 1) with the bytes of the file; the manifest is still there.
	string(FIND "${_HEX}" "ffff0e00ffff0100" _GROUP_AT)
	string(FIND "${_HEX}" "ffff0300ffff0100" _FIRST_AT)
	string(FIND "${_HEX}" "ffff0300ffff0200" _SECOND_AT)
	string(FIND "${_HEX}" "41424344" _DATA_AT)
	string(FIND "${_HEX}" "ffff1800ffff0100" _MANIFEST_AT)
	if(_GROUP_AT EQUAL -1 OR _FIRST_AT EQUAL -1 OR NOT _SECOND_AT EQUAL -1 OR _DATA_AT EQUAL -1 OR _MANIFEST_AT EQUAL -1)
		message(FATAL_ERROR "The resource file does not hold the manifest and exactly the image of --icon.")
	endif()
	# A file that is not an icon, and one that is missing, are errors.
	blitzcc(--icon "${PROGRAM}" --target x86_64-pc-windows-msvc "${PROGRAM}" -o "${WORK}/bad.exe")
	if(RC EQUAL 0)
		message(FATAL_ERROR "Expected a failure for a file that is not an icon.")
	endif()
	string(FIND "${ERR}${OUT}" "is not an .ico file" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected 'is not an .ico file', got:\n${OUT}${ERR}")
	endif()
	blitzcc(--icon "${WORK}/missing.ico" --target x86_64-pc-windows-msvc "${PROGRAM}" -o "${WORK}/bad.exe")
	if(RC EQUAL 0)
		message(FATAL_ERROR "Expected a failure for a missing icon.")
	endif()
	# It can't be combined with resources of the program's own.
	blitzcc(--icon "${TESTS}/cli/tiny.ico" --llvm-flag "${WORK}/own.res" --target x86_64-pc-windows-msvc "${PROGRAM}" -o "${WORK}/own.exe")
	if(RC EQUAL 0)
		message(FATAL_ERROR "Expected a failure for --icon with a resource file of the program's own.")
	endif()
	# Other systems have no icons to embed: the option is left alone, like --console.
	if(NOT CMAKE_HOST_WIN32)
		blitzcc(--icon "${TESTS}/cli/tiny.ico" "${PROGRAM}" -o "${EXE}")
		expect_ok()
	endif()

elseif(CASE STREQUAL "userlib_shared")
