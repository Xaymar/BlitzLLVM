		"Function Foo%(a%)\n"
		"\tReturn a\n"
		"End Function\n"
		"Function Bar%()\n"
		"\tReturn 1\n"
		"End Function\n"
		"Function Mismatch%()\n"
		"\tReturn \"5\"\n"
		"End Function\n"
		"Print Mismatch()\n"
		"Function Bare%()\n"
		"\tReturn\n"
		"End Function\n"
		"Print Bare()\n")

	# Every warning turns on at its level, and stays on above it. -W2 is the default.
	set(_WARNINGS
		"implicit-lossy-int-to-int:1" "implicit-lossy-real-to-int:1" "implicit-lossy-real-to-real:1" "implicit-string-to-number:1"
		"implicit-lossy-int-to-real:2" "implicit-variable:2" "return-missing-value:2" "return-type-mismatch:2" "unused-result:2"
		"implicit-number-to-string:3" "short-type-notation:3" "unreachable-code:3" "unused-variable:3"
		"typeless-declaration:4" "unused-function:4")
	foreach(_LEVEL RANGE 0 4)
		blitzcc(-c -W${_LEVEL} "${WORK}/w.bb")
		expect_ok()
		foreach(_ENTRY IN LISTS _WARNINGS)
			string(REPLACE ":" ";" _PARTS "${_ENTRY}")
			list(GET _PARTS 0 _NAME)
			list(GET _PARTS 1 _AT_LEVEL)
			if(_LEVEL GREATER_EQUAL _AT_LEVEL)
				expect_err("[-W${_NAME}]")
			else()
				expect_no_err("[-W${_NAME}]")
			endif()
		endforeach()
	endforeach()
	blitzcc(-c "${WORK}/w.bb")
	expect_err("[-Wimplicit-variable]")
	expect_no_err("[-Wunreachable-code]")

	# Messages: the kind, the span, and a suggestion.
	blitzcc(-c -W4 "${WORK}/w.bb")
	expect_err("w.bb:1:12: warning: Implicit conversion from Float32 to Int32, the fractional part is lost. [-Wimplicit-lossy-real-to-int]\nLocal i% = 2.5\n           ^^^ HERE\nnotice: Use Int(value) to convert on purpose, or SatInt(value) to stop at the limits of Int32.")
	expect_err("w.bb:13:1: notice: This statement can never run. [-Wunreachable-code]")
	expect_err("notice: 'unused' is never read, it is optimized away. [-Wunused-variable]")
	expect_err("notice: Function 'Bar' is never called, it is optimized away. [-Wunused-function]")
	expect_err("w.bb:10:1: warning: 'x' was not declared, it is a new local variable. [-Wimplicit-variable]")
	expect_err("w.bb:11:1: warning: The result of 'Foo' is not used. [-Wunused-result]")
	expect_err("w.bb:4:7: warning: 't' has no type, it is an Int. [-Wtypeless-declaration]")

	# Conversions name both types and the function that converts on purpose.
	file(WRITE "${WORK}/conv.bb" "Local i% = Long(5000000000)\nLocal f# = Long(5)\nLocal s$ = 5\nLocal n% = \"12\"\nLocal d# = Double(3)\nPrint i + f + d + n + s\n")
	blitzcc(-c -W4 "${WORK}/conv.bb")
	expect_err("warning: Implicit conversion from Int64 to Int32 can change the value. [-Wimplicit-lossy-int-to-int]")
	expect_err("\nnotice: Use Int(value) to convert on purpose, or SatInt(value) to stop at the limits instead of wrapping around.")
	expect_err("warning: Implicit conversion from Int64 to Float32 can change the value. [-Wimplicit-lossy-int-to-real]\nLocal f# = Long(5)\n           ^^^^--- HERE\nnotice: Use Float(value) to convert on purpose.")
	expect_err("warning: Implicit conversion from Int32 to String. [-Wimplicit-number-to-string]")
	expect_err("\nnotice: Use Str(value) to convert on purpose.")
	expect_err("warning: Implicit conversion from String to Int32. [-Wimplicit-string-to-number]")
	expect_err("warning: Implicit conversion from Float64 to Float32 can change the value. [-Wimplicit-lossy-real-to-real]")
	expect_no_err("[-Wunused-variable]\nLocal i")

	# Return with another type than the function has: both types, and the function that fixes it.
	blitzcc(-c "${WORK}/w.bb")
	expect_err("w.bb:23:9: warning: Return gives String, but the function returns Int. [-Wreturn-type-mismatch]")
	expect_err("notice: Use Int(value) to convert on purpose.")
	file(WRITE "${WORK}/ret.bb"
		"Print Zero#()\nPrint Same#(1.5)\nPrint Wide#(1)\nLocal d:double = 1.5\nPrint Narrow#(d)\nPrint Text$(1)\nPrint Byt:byte(1)\n"
		"Function Zero#()\n\tReturn 0\nEnd Function\n"
		"Function Same#(f#)\n\tReturn f\nEnd Function\n"
		"Function Wide#(i%)\n\tReturn i\nEnd Function\n"
		"Function Narrow#(d:double)\n\tReturn d\nEnd Function\n"
		"Function Text$(i%)\n\tReturn i\nEnd Function\n"
		"Function Byt:byte(i%)\n\tReturn i\nEnd Function\n")
	blitzcc(-c "${WORK}/ret.bb")
	expect_err("Return gives Int, but the function returns Float. [-Wreturn-type-mismatch]")
	expect_err("Return gives Double, but the function returns Float. [-Wreturn-type-mismatch]\n")
	expect_err("notice: Use Float(value) to convert on purpose.")
	expect_err("Return gives Int, but the function returns String. [-Wreturn-type-mismatch]")
	expect_err("notice: Use Str(value) to convert on purpose.")
	expect_err("Return gives Int, but the function returns Byte. [-Wreturn-type-mismatch]")
	expect_err("notice: Change the type of the function or of the returned value.")
	# A literal that fits (Return 0 in a Float function) and the same type are fine, and the conversion warnings are not said twice.
	expect_no_err("ret.bb:8:")
	expect_no_err("ret.bb:9:")
	expect_no_err("[-Wimplicit-lossy")
	expect_no_err("[-Wimplicit-number-to-string]")
	# Without it, the conversion warnings say it at their levels.
	blitzcc(-c -W1 "${WORK}/ret.bb")
	expect_no_err("[-Wreturn-type-mismatch]")
	expect_err("[-Wimplicit-lossy-real-to-real]")
	blitzcc(-c -Wno-return-type-mismatch "${WORK}/ret.bb")
	expect_no_err("[-Wreturn-type-mismatch]")
	expect_err("[-Wimplicit-lossy-int-to-int]")

	# A bare Return in a function with a type; without one the function is an Int and it is left alone.
	file(WRITE "${WORK}/bare.bb"
		"Print Plain()\nPrint Num%()\nPrint Txt$()\nPrint Flt#()\nProc()\n"
		"Function Plain()\n\tReturn\nEnd Function\n"
		"Function Num%()\n\tReturn\nEnd Function\n"
		"Function Txt$()\n\tReturn\nEnd Function\n"
		"Function Flt#()\n\tReturn\nEnd Function\n"
		"Function Proc()\n\tReturn 1\nEnd Function\n")
	blitzcc(-c "${WORK}/bare.bb")
	expect_err("bare.bb:10:2: warning: Return has no value, but the function returns Int. [-Wreturn-missing-value]")
	expect_err("notice: Return a value, such as 'Return 0'.")
	expect_err("Return has no value, but the function returns String. [-Wreturn-missing-value]")
	expect_err("notice: Return a value, such as 'Return \"\"'.")
	expect_err("Return has no value, but the function returns Float. [-Wreturn-missing-value]")
	expect_err("notice: Return a value, such as 'Return 0.0'.")
	expect_no_err("bare.bb:7:")
	blitzcc(-c -Wno-return-missing-value "${WORK}/bare.bb")
	expect_no_err("[-Wreturn-missing-value]")

	# Functions, parameters and fields without a type are Ints too.
	file(WRITE "${WORK}/typeless.bb"
		"Type Box\n"
		"\tField size\n"
		"\tField weight#\n"
		"End Type\n"
		"Print Plain(1, 2)\nPrint Typed%(1, 2)\n"
		"Function Plain(a, b%)\n\tReturn a\nEnd Function\n"
		"Function Typed%(a%, b%)\n\tReturn a\nEnd Function\n")
	blitzcc(-c -W4 "${WORK}/typeless.bb")
	expect_err("typeless.bb:2:8: warning: Field 'size' has no type, it is an Int. [-Wtypeless-declaration]")
	expect_err("warning: Function 'Plain' has no type, it is an Int. [-Wtypeless-declaration]")
	expect_err("warning: Parameter 'a' has no type, it is an Int. [-Wtypeless-declaration]")
	expect_no_err("'b' has no type")
	expect_no_err("'weight' has no type")
	expect_no_err("'Typed' has no type")
	blitzcc(-c "${WORK}/typeless.bb")
	expect_no_err("[-Wtypeless-declaration]")

	# The short form of a type warns at -W3, the long form and a type name do not. The notice names the long form.
	file(WRITE "${WORK}/short.bb"
		"Type Box\n\tField w#\n\tField next.Box\nEnd Type\n"
		"Global g% = 1\nLocal l:Int32 = 2\nLocal big##, wide%%, name$\n"
		"Function Add$(a%, b:Float32)\n\tReturn Str(a + b)\nEnd Function\n"
		"Print Add(g, l) + name + big + wide\n")
	blitzcc(-c -W3 "${WORK}/short.bb")
	expect_err("short.bb:2:9: warning: The type is written in the short form. [-Wshort-type-notation]")
	expect_err("notice: Write the long form instead: ':Float32'.")
	expect_err("notice: Write the long form instead: ':Int32'.")
	expect_err("notice: Write the long form instead: ':Float64'.")
	expect_err("notice: Write the long form instead: ':Int64'.")
	expect_err("notice: Write the long form instead: ':String'.")
	expect_no_err("short.bb:3:")
	expect_no_err("short.bb:6:")
	blitzcc(-c "${WORK}/short.bb")
	expect_no_err("[-Wshort-type-notation]")
	blitzcc(-c -W3 -Wno-short-type-notation "${WORK}/short.bb")
	expect_no_err("[-Wshort-type-notation]")
	blitzcc(-c -Wshort-type-notation "${WORK}/short.bb")
	expect_err("[-Wshort-type-notation]")
	blitzcc(-c -W3 -Werror=short-type-notation "${WORK}/short.bb")
	expect_failed()
	expect_err("[-Werror=short-type-notation]")

	# Adding the type to a declaration does not trade one warning for another: it is written in the long form.
	file(WRITE "${WORK}/untyped.bb" "Local t = 1\nPrint t\n")
	blitzcc(-c -W4 "${WORK}/untyped.bb")
	expect_err("Add the type to the name: 't:Int32', 't:Float32', 't:String' or 't.TypeName' (object).")
	expect_no_err("[-Wshort-type-notation]")

	# A number that is written in the program and fits is fine.
	file(WRITE "${WORK}/fits.bb" "Local b:byte = 100\nLocal f:Float32 = 1000\nPrint b + f\n")
	blitzcc(-c -W4 "${WORK}/fits.bb")
	expect_ok()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no warnings, got:\n${ERR}")
	endif()

	# Only a call that throws a value away warns: not a built-in without a result, not a function without 'Return value',
	# and not a call that is used in an expression, an If or a Select.
	file(WRITE "${WORK}/calls.bb"
		"Print \"hello\"\n"
		"Proc(1)\n"
		"Proc 2\n"
		"Early(1)\n"
		"If Value(1) = 1 Then Print \"if\"\n"
		"If Value(2) Then Print \"if\"\n"
		"Select Value(3)\n"
		"Case 3\n"
		"\tPrint \"select\"\n"
		"End Select\n"
		"Local v% = Value(4)\n"
		"Print v + Value(5)\n"
		"Nested(1)\n"
		"Value(6)\n"
		"Function Proc(a%)\n"
		"\tPrint a\n"
		"End Function\n"
		"Function Early(a%)\n"
		"\tIf a Then Return\n"
		"\tPrint a\n"
		"End Function\n"
		"Function Value%(a%)\n"
		"\tReturn a\n"
		"End Function\n"
		"Function Nested%(a%)\n"
		"\tWhile a\n"
		"\t\tSelect a\n"
		"\t\tCase 1\n"
		"\t\t\tReturn 1\n"
		"\t\tEnd Select\n"
		"\tWend\n"
		"End Function\n")
	blitzcc(-c "${WORK}/calls.bb")
	expect_ok()
	expect_err("calls.bb:13:1: warning: The result of 'Nested' is not used. [-Wunused-result]")
	expect_err("calls.bb:14:1: warning: The result of 'Value' is not used. [-Wunused-result]")
	expect_no_err("'Proc' is not used")
	expect_no_err("'Early' is not used")
	expect_no_err("'Print' is not used")
	string(REGEX MATCHALL "\\[-Wunused-result\\]" _UNUSED "${ERR}")
	list(LENGTH _UNUSED _UNUSED_COUNT)
	if(NOT _UNUSED_COUNT EQUAL 2)
		message(FATAL_ERROR "Expected 2 unused-result warnings, got ${_UNUSED_COUNT}:\n${ERR}")
	endif()

	# -W<name> and -Wno-<name> win over the level, in any order, and options are not case sensitive.
	blitzcc(-c -Wno-implicit-lossy-real-to-int "${WORK}/w.bb")
	expect_ok()
	expect_no_err("[-Wimplicit-lossy-real-to-int]")
	expect_err("[-Wimplicit-string-to-number]")
	blitzcc(-Wno-implicit-lossy-real-to-int -c -W4 "${WORK}/w.bb")
	expect_no_err("[-Wimplicit-lossy-real-to-int]")
	expect_err("[-Wunused-function]")
	blitzcc(-W0 -Wunused-function -c "${WORK}/w.bb")
	expect_err("[-Wunused-function]")
	expect_no_err("[-Wimplicit-lossy-real-to-int]")
	blitzcc(-c -WNO-IMPLICIT-VARIABLE "${WORK}/w.bb")
	expect_no_err("[-Wimplicit-variable]")

	# Unknown names are errors.
	blitzcc(-c -Wnothing "${WORK}/w.bb")
	expect_failed()
	expect_err("Unknown warning 'nothing'")
	blitzcc(-c -Wno-nothing "${WORK}/w.bb")
	expect_failed()
	blitzcc(-c -Werror=nothing "${WORK}/w.bb")
	expect_failed()

	# -Werror: the warnings are printed as errors, everything is still checked, and the compilation fails. Notices stay notices.
	blitzcc(-c -W4 -Werror "${WORK}/w.bb")
	expect_failed()
	expect_err("w.bb:1:12: error: Implicit conversion from Float32 to Int32, the fractional part is lost. [-Werror=implicit-lossy-real-to-int]")
	expect_err("[-Werror=implicit-string-to-number]")
	expect_err("notice: This statement can never run. [-Wunreachable-code]")
	expect_err("warning(s) treated as errors")
	blitzcc(-c -Werror -W0 "${WORK}/w.bb")
	expect_ok()
	blitzcc(-c -Werror -Wno-error "${WORK}/w.bb")
	expect_ok()
	file(WRITE "${WORK}/hint.bb" "Local a:Int32 = 1\n")
	blitzcc(-c -W4 -Werror "${WORK}/hint.bb")
	expect_ok()
	expect_err("notice: 'a' is never read")
	blitzcc(-c -W4 -Werror=unused-variable "${WORK}/hint.bb")
	expect_failed()
	expect_err("error: 'a' is never read, it is optimized away. [-Werror=unused-variable]")

	# -Werror=<name> only fails for that warning, and turns it on if the level doesn't.
	blitzcc(-c -Werror=implicit-lossy-real-to-int "${WORK}/w.bb")
	expect_failed()
	expect_err("[-Werror=implicit-lossy-real-to-int]")
	expect_err("warning: Implicit conversion from String to Int32. [-Wimplicit-string-to-number]")
	blitzcc(-c -W0 -Werror=unreachable-code "${WORK}/w.bb")
	expect_failed()
	expect_err("w.bb:13:1: error: This statement can never run. [-Werror=unreachable-code]")
	blitzcc(-c -Werror -Wno-error=implicit-lossy-real-to-int -Wno-error=implicit-lossy-int-to-int -Wno-error=implicit-lossy-int-to-real -Wno-error=implicit-lossy-real-to-real -Wno-error=implicit-string-to-number -Wno-error=typeless-declaration -Wno-error=implicit-variable -Wno-error=unused-result -Wno-error=return-missing-value -Wno-error=return-type-mismatch -Wno-error=implicit-number-to-string "${WORK}/w.bb")
	expect_ok()
	expect_err("[-Wimplicit-lossy-real-to-int]")

	# -q hides warnings but not the ones that are errors, +q hides everything and still fails.
	blitzcc(-q -c -Werror "${WORK}/w.bb")
	expect_failed()
	expect_err("[-Werror=implicit-lossy-real-to-int]")
	blitzcc(+q -c -Werror "${WORK}/w.bb")
	expect_failed()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no messages with +q, got:\n${ERR}")
	endif()

	# The warnings are in the help.
	blitzcc(--help)
	expect_ok()
	foreach(_ENTRY IN LISTS _WARNINGS)
		string(REPLACE ":" ";" _PARTS "${_ENTRY}")
		list(GET _PARTS 0 _NAME)
		expect_contains("-W${_AT_LEVEL}")
		expect_contains("${_NAME}")
	endforeach()
	foreach(_OPTION IN ITEMS "-W0 .. -W4" "-W<name>" "-Werror")
		expect_contains("${_OPTION}")
	endforeach()

elseif(CASE STREQUAL "temp_directory")
	# A build keeps its files in a folder of its own that is new, can't be guessed from the names of the files, and is private: a folder
	# that another user made (or a name they knew in advance) would be where the compiler wrote and read the program it builds.
	set(_TEMP "${WORK}/temp")
	file(MAKE_DIRECTORY "${_TEMP}")
	foreach(_RUN IN ITEMS 1 2)
		execute_process(
			COMMAND "${CMAKE_COMMAND}" -E env "TMPDIR=${_TEMP}" "TEMP=${_TEMP}" "TMP=${_TEMP}" "${BLITZCC}" +q --keep-temps "${PROGRAM}" -o "${WORK}/program${_RUN}${CMAKE_EXECUTABLE_SUFFIX}"
			RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR
		)
		expect_ok()
	endforeach()
	file(GLOB _DIRECTORIES LIST_DIRECTORIES true "${_TEMP}/blitzllvm-*")
	list(LENGTH _DIRECTORIES _COUNT)
	if(NOT _COUNT EQUAL 2)
		message(FATAL_ERROR "Two builds of the same program with the same output should have kept two folders, found ${_COUNT}: ${_DIRECTORIES}")
	endif()
	if(NOT CMAKE_HOST_WIN32)
		foreach(_DIRECTORY IN LISTS _DIRECTORIES)
			execute_process(COMMAND stat -c %a "${_DIRECTORY}" OUTPUT_VARIABLE _MODE OUTPUT_STRIP_TRAILING_WHITESPACE)
			if(NOT _MODE STREQUAL "700")
				message(FATAL_ERROR "The folder ${_DIRECTORY} of a build has the permissions ${_MODE}, only its owner should be able to use it (700).")
			endif()
		endforeach()
	endif()

elseif(CASE STREQUAL "shell_quoting")
	# The compiler runs clang through a shell, and the names of the files are in the command. A name with a line break in it must not start another
	# command, and a name with a quote, a ~ or a # in it has to be the name of the file.
	if(CMAKE_HOST_WIN32)
		return()
	endif()
	# This script is what a name that starts another command would run: a line break is not one of the characters that used to be quoted.
	file(WRITE "${WORK}/ps" "#!/bin/sh\ntouch pwned\n")
	file(CHMOD "${WORK}/ps" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
	file(MAKE_DIRECTORY "${WORK}/line\n.")
	set(_NAMES "line\n./ps" "quote' && touch pwned && '" "sub\$(touch pwned)" "~tilde" "hash #" "brace{a,b}" "star*" "bang!")
	# The results are checked after the files are removed: a name with a line break in it can't be part of the uploaded test output (the
	# artifact upload refuses it), so it must not be left behind when a check fails either.
	set(_PROBLEMS)
	foreach(_NAME IN LISTS _NAMES)
		blitzcc(+q "${PROGRAM}" -o "${WORK}/${_NAME}")
		if(NOT RC EQUAL 0)
			list(APPEND _PROBLEMS "The name '${_NAME}' was not built, got '${RC}'.\nstdout: ${OUT}\nstderr: ${ERR}")
		elseif(NOT EXISTS "${WORK}/${_NAME}")
			list(APPEND _PROBLEMS "The executable '${_NAME}' was not made with that name.")
		endif()
		if(EXISTS "${WORK}/pwned")
			list(APPEND _PROBLEMS "The name '${_NAME}' started a command.")
			file(REMOVE "${WORK}/pwned")
		endif()
	endforeach()
	file(REMOVE_RECURSE "${WORK}/line\n.")
	if(_PROBLEMS)
		message(FATAL_ERROR "${_PROBLEMS}")
	endif()

elseif(CASE STREQUAL "help")
	blitzcc(--help)
	expect_ok()
	foreach(_OPTION IN ITEMS "-q " "+q " "-c " "-d " "-k " "+k " "-v " "-o <file>" "--console" "--verbose" "--userlibs-dir")
		expect_contains("  ${_OPTION}")
	endforeach()

else()
	message(FATAL_ERROR "Unknown test case '${CASE}'.")
endif()
