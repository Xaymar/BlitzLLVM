################################################################################
# Tests for the command line options of blitzcc, run as 'cmake -DCASE=<name> ... -P cli.cmake'.
#
# Variables: BLITZCC (the compiler), TESTS (the tests directory), WORK (an empty directory to write to), VERSION (what
# -v has to report, with the commit).
################################################################################
cmake_minimum_required(VERSION 3.20)

set(PROGRAM "${TESTS}/cli/program.bb")
set(USERLIBS "${TESTS}/cli/userlibs")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# Run the compiler in WORK, results are RC, OUT and ERR.
function(blitzcc)
	execute_process(
		COMMAND "${BLITZCC}" ${ARGN}
		WORKING_DIRECTORY "${WORK}"
		RESULT_VARIABLE _RC
		OUTPUT_VARIABLE _OUT
		ERROR_VARIABLE _ERR
	)
	set(RC "${_RC}" PARENT_SCOPE)
	set(OUT "${_OUT}" PARENT_SCOPE)
	set(ERR "${_ERR}" PARENT_SCOPE)
endfunction()

macro(expect_ok)
	if(NOT RC EQUAL 0)
		message(FATAL_ERROR "Expected success, got '${RC}'.\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
endmacro()

macro(expect_contains TEXT)
	string(FIND "${OUT}" "${TEXT}" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected '${TEXT}' in the output, got:\n${OUT}")
	endif()
endmacro()

macro(expect_missing TEXT)
	string(FIND "${OUT}" "${TEXT}" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Did not expect '${TEXT}' in the output, got:\n${OUT}")
	endif()
endmacro()

# Build the test userlib (tests/cli/userlib) into DIR as a shared library or, with STATIC, as a static one, and copy the .decls.
# Names are what the platform uses, so that the .dll of the .decls file has to be found by its other names.
function(build_userlib DIR KIND)
	set(_CC "$ENV{BLITZLLVM_CC}")
	if(NOT _CC)
		set(_CC clang)
	endif()
	file(MAKE_DIRECTORY "${DIR}")
	set(_SRC "${TESTS}/cli/userlib/ultest.c")
	if(CMAKE_HOST_WIN32)
		set(_OUTPUT "${DIR}/ultest.dll")
	elseif(CMAKE_HOST_APPLE)
		set(_OUTPUT "${DIR}/libultest.dylib")
	else()
		set(_OUTPUT "${DIR}/libultest.so")
	endif()
	execute_process(COMMAND "${_CC}" -shared -fPIC "${_SRC}" -o "${_OUTPUT}" RESULT_VARIABLE _RC ERROR_VARIABLE _ERR)
	if(NOT _RC EQUAL 0)
		message(FATAL_ERROR "Building the test userlib failed: ${_ERR}")
	endif()
	file(COPY "${TESTS}/cli/userlib/ultest.decls" DESTINATION "${DIR}")
endfunction()

macro(expect_userlib_output)
	expect_ok()
	expect_contains("5\n")
	expect_contains("6.0\n")
	expect_contains("hello, World\n")
	expect_contains("1234\n")
	# The short and the long form of the types, and every size of number.
	expect_contains("5\n9\n3.0\n3.0\nhello, a\nhello, b\n78\n")
	expect_contains("-100\n44\n-30000\n4464\n1705032704\n-10000000000\n-10000000000\n18446744073709551615\n0.5\n1.0\n")
endmacro()


# A whole line, so that 'Left' does not match 'LeftHand'.
macro(expect_line LINE)
	string(REGEX REPLACE "([][+.*^$?|()\\\\])" "\\\\\\1" _ESCAPED "${LINE}")
	if(NOT "\n${OUT}" MATCHES "\n${_ESCAPED}\n")
		message(FATAL_ERROR "Expected the line '${LINE}' in the output, got:\n${OUT}")
	endif()
endmacro()

set(EXE "${WORK}/program${CMAKE_EXECUTABLE_SUFFIX}")

if(CASE STREQUAL "default")
	# Nothing given: Banner and every step.
	blitzcc("${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains("BlitzCC V${VERSION}")
	expect_contains("Compiling \"")
	expect_contains("Parsing...")
	expect_contains("Generating...")
	expect_contains("Creating executable \"")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()

elseif(CASE STREQUAL "quiet")
	# -q drops the banner and the warnings, but not the errors.
	blitzcc(-q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_missing("BlitzCC")
	expect_missing("Compiling")
	expect_contains("Parsing...")
	expect_contains("Creating executable \"")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()
	file(WRITE "${WORK}/warning.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(-c "${WORK}/warning.bb")
	expect_ok()
	string(FIND "${ERR}" "warning" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected a warning without -q, got:\n${ERR}")
	endif()
	blitzcc(-q -c "${WORK}/warning.bb")
	expect_ok()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no warnings with -q, got:\n${ERR}")
	endif()
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc(-q -c "${WORK}/broken.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	string(FIND "${ERR}" "error" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected an error message with -q, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "very_quiet")
	# +q drops every message, but the executable is still created.
	blitzcc(+q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	if(NOT OUT STREQUAL "")
		message(FATAL_ERROR "Expected no output, got:\n${OUT}")
	endif()
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()
	# Warnings and errors are silent too, but a broken program still fails.
	file(WRITE "${WORK}/warning.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(+q -c "${WORK}/warning.bb")
	expect_ok()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no warnings, got:\n${ERR}")
	endif()
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc(+q "${WORK}/broken.bb" -o "${EXE}.broken")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	if(NOT ERR STREQUAL "" OR NOT OUT STREQUAL "")
		message(FATAL_ERROR "Expected no messages, got:\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
	if(EXISTS "${EXE}.broken")
		message(FATAL_ERROR "An executable was created for a broken program.")
	endif()

elseif(CASE STREQUAL "options_not_case_sensitive")
	blitzcc(+Q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	if(NOT OUT STREQUAL "")
		message(FATAL_ERROR "Expected no output, got:\n${OUT}")
	endif()

elseif(CASE STREQUAL "compile_only")
	# -c checks the program, but doesn't create anything.
	blitzcc(-c "${PROGRAM}")
	expect_ok()
	expect_contains("Generating...")
	expect_missing("Creating")
	file(GLOB _CREATED "${WORK}/*")
	if(_CREATED)
		message(FATAL_ERROR "Compile only created files: ${_CREATED}")
	endif()
	# It still reports errors.
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc(-c "${WORK}/broken.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	# -o wins, like in the original.
	blitzcc(-c "${PROGRAM}" -o "${EXE}")
	expect_ok()
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "-c with -o did not create the executable.")
	endif()

elseif(CASE STREQUAL "debug")
	# -d never optimizes and adds debug information, wherever the optimization level is.
	foreach(_ARGS IN ITEMS "-d;-O3" "-O3;-d")
		blitzcc(${_ARGS} --verbose "${PROGRAM}" -o "${EXE}")
		expect_ok()
		expect_contains(" -O0 ")
		expect_contains(" -g ")
		expect_missing("-O3")
	endforeach()
	# Without -d it is optimized and has no debug information.
	blitzcc(--verbose "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains(" -O3 ")
	expect_missing(" -g ")
	# And the result runs.
	blitzcc(-d "${PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" WORKING_DIRECTORY "${TESTS}" RESULT_VARIABLE _RUN OUTPUT_QUIET ERROR_QUIET)
	if(NOT _RUN EQUAL 0)
		message(FATAL_ERROR "The debug build failed to run: ${_RUN}")
	endif()

elseif(CASE STREQUAL "profile")
	# --profile (and -d) make the program turn the runtime timers on; without them the program never asks for them.
	foreach(_ARGS IN ITEMS "--profile" "-d" "")
		blitzcc(-S ${_ARGS} "${PROGRAM}" -o "${WORK}/profile.ll")
		expect_ok()
		file(READ "${WORK}/profile.ll" _IR)
		string(FIND "${_IR}" "@bb_set_profile(" _AT)
		if(_ARGS STREQUAL "" AND NOT _AT EQUAL -1)
			message(FATAL_ERROR "A program without --profile turns the profiling on.")
		elseif(NOT _ARGS STREQUAL "" AND _AT EQUAL -1)
			message(FATAL_ERROR "'${_ARGS}' does not turn the profiling on.")
		endif()
	endforeach()
	# Call stacks need symbols: only --profile with -g (or -d) asks for them (the 3), --profile alone just times (the 1).
	foreach(_FLAGS IN ITEMS "--profile" "--profile -g" "-d")
		separate_arguments(_ARGV UNIX_COMMAND "${_FLAGS}")
		if(_FLAGS STREQUAL "--profile")
			set(_VALUE 1)
		else()
			set(_VALUE 3)
		endif()
		blitzcc(-S ${_ARGV} "${PROGRAM}" -o "${WORK}/profile.ll")
		expect_ok()
		file(READ "${WORK}/profile.ll" _IR)
		string(FIND "${_IR}" "@bb_set_profile(i32 ${_VALUE})" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "'${_FLAGS}' does not pass ${_VALUE} to bb_set_profile.")
		endif()
	endforeach()

elseif(CASE STREQUAL "debug_info")
	# -d and -g describe the program to debuggers, in the files, lines and columns of the source.
	set(DEBUG_PROGRAM "${TESTS}/cli/debug.bb")
	# DWARF is for every target but Windows, so the host (which may be Windows) is not left to decide.
	blitzcc(-S -d --target x86_64-unknown-linux-gnu "${DEBUG_PROGRAM}" -o "${WORK}/debug.ll")
	expect_ok()
	file(READ "${WORK}/debug.ll" _IR)
	foreach(_NEEDED IN ITEMS "!DICompileUnit(" "emissionKind: FullDebug" "\"Debug Info Version\"" "\"Dwarf Version\""
		"filename: \"debug.bb\"" "filename: \"debug_include.bb\"" "!DISubprogram(name: \"Double\"" "!DISubprogram(name: \"main\""
		"!DILocalVariable(name: \"Value\", arg: 1" "!DILocalVariable(name: \"Total\"" "!DIGlobalVariable(name: \"Counter\"" "!DIGlobalVariable(name: \"Included\""
		"call void @llvm.dbg.declare(" "!DILexicalBlockFile(" "!DILocation(line: 14, column: 1,")
		string(FIND "${_IR}" "${_NEEDED}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "The debug IR does not contain '${_NEEDED}'.")
		endif()
	endforeach()
	string(FIND "${_IR}" "CodeView" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "A DWARF target got CodeView.")
	endif()
	# Windows uses CodeView.
	blitzcc(-S -d --target x86_64-pc-windows-msvc "${DEBUG_PROGRAM}" -o "${WORK}/codeview.ll")
	expect_ok()
	file(READ "${WORK}/codeview.ll" _IR)
	foreach(_NEEDED IN ITEMS "\"CodeView\"" "\"Debug Info Version\"")
		string(FIND "${_IR}" "${_NEEDED}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "The CodeView IR does not contain '${_NEEDED}'.")
		endif()
	endforeach()
	string(FIND "${_IR}" "Dwarf Version" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "A CodeView target got DWARF.")
	endif()
	# MinGW gets CodeView too, so that the linker makes a .pdb.
	blitzcc(-S -d --target x86_64-w64-mingw32 "${DEBUG_PROGRAM}" -o "${WORK}/mingw.ll")
	expect_ok()
	file(READ "${WORK}/mingw.ll" _IR)
	string(FIND "${_IR}" "\"CodeView\"" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "A MinGW target did not get CodeView.")
	endif()
	string(FIND "${_IR}" "Dwarf Version" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "A MinGW target got DWARF.")
	endif()
	# A debugger shows the text of a String, the fields of a Type and the elements of a Dim array, not just pointers.
	blitzcc(-S -d --target x86_64-unknown-linux-gnu "${TESTS}/cli/debug_types.bb" -o "${WORK}/types.ll")
	expect_ok()
	file(READ "${WORK}/types.ll" _IR)
	foreach(_NEEDED IN ITEMS "name: \"String\", baseType:" "name: \"char\", size: 8, encoding: DW_ATE_signed_char"
		"!DICompositeType(tag: DW_TAG_structure_type, name: \"Monster\", size: 512" "name: \"Health\"" "name: \"Name\"" "name: \"Friend\"" "name: \"__handle\""
		"!DICompositeType(tag: DW_TAG_array_type, baseType: " "!DIGlobalVariable(name: \"Grid\"" "!DIGlobalVariable(name: \"Words\"" "!DIGlobalVariable(name: \"Title\""
		"name: \"Array of Int, 2 dimensions\", size: 256" "name: \"Array of String, 1 dimension\"" "name: \"Pitch\"" "!DILocalVariable(name: \"Boss\"")
		string(FIND "${_IR}" "${_NEEDED}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "The debug IR of the Type, String and Dim program does not contain '${_NEEDED}'.")
		endif()
	endforeach()
	# The IR has to be accepted for CodeView as well.
	blitzcc(-S -d --target x86_64-pc-windows-msvc "${TESTS}/cli/debug_types.bb" -o "${WORK}/types_codeview.ll")
	expect_ok()
	# Without either option there is none of it.
	blitzcc(-S "${DEBUG_PROGRAM}" -o "${WORK}/release.ll")
	expect_ok()
	file(READ "${WORK}/release.ll" _IR)
	foreach(_FORBIDDEN IN ITEMS "!dbg" "DICompileUnit" "llvm.dbg" "!llvm.module.flags")
		string(FIND "${_IR}" "${_FORBIDDEN}" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "A build without debug information contains '${_FORBIDDEN}'.")
		endif()
	endforeach()
	# String temporaries get bb_str_mark and bb_str_release calls, which need a location as well (LLVM aborts without it).
	foreach(_OPTION IN ITEMS -d -g)
		blitzcc(${_OPTION} "${TESTS}/cli/debug_strings.bb" -o "${WORK}/strings${_OPTION}")
		expect_ok()
		# Optimizing the runtime together with the program falls back to a plain build on an LLVM error, which still succeeds.
		string(FIND "${OUT}${ERR}" "failed" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "Building with ${_OPTION} reported a failure:\n${OUT}${ERR}")
		endif()
	endforeach()
	# -g keeps the optimization level, -d does not.
	blitzcc(-g --verbose "${DEBUG_PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains(" -O3 ")
	expect_contains(" -g ")
	blitzcc(-S -g --target x86_64-unknown-linux-gnu "${DEBUG_PROGRAM}" -o "${WORK}/g.ll")
	expect_ok()
	file(READ "${WORK}/g.ll" _IR)
	string(FIND "${_IR}" "DICompileUnit" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "-g did not add debug information.")
	endif()
	# What LLVM makes of it: the line table maps instructions back to the lines and the file of the source.
	find_program(CLANG clang)
	find_program(DWARFDUMP NAMES llvm-dwarfdump llvm-dwarfdump-18 llvm-dwarfdump-19 llvm-dwarfdump-20 llvm-dwarfdump-21)
	if(CLANG AND DWARFDUMP)
		execute_process(COMMAND "${CLANG}" -c -w "${WORK}/debug.ll" -o "${WORK}/debug.o" RESULT_VARIABLE _RC ERROR_VARIABLE _ERR)
		if(NOT _RC EQUAL 0)
			message(FATAL_ERROR "LLVM did not accept the debug information: ${_ERR}")
		endif()
		execute_process(COMMAND "${DWARFDUMP}" --debug-line "${WORK}/debug.o" OUTPUT_VARIABLE _LINES RESULT_VARIABLE _RC)
		execute_process(COMMAND "${DWARFDUMP}" --debug-info "${WORK}/debug.o" OUTPUT_VARIABLE _INFO)
		foreach(_NEEDED IN ITEMS "name: \"debug.bb\"" "name: \"debug_include.bb\"")
			string(FIND "${_LINES}" "${_NEEDED}" _AT)
			if(_AT EQUAL -1)
				message(FATAL_ERROR "The line table does not contain '${_NEEDED}':\n${_LINES}")
			endif()
		endforeach()
		# Lines 12 (in Double) and 15 (the main program) have instructions.
		foreach(_LINE IN ITEMS 12 15)
			if(NOT "${_LINES}" MATCHES "\n0x[0-9a-f]+ +${_LINE} ")
				message(FATAL_ERROR "The line table has no instructions for line ${_LINE}:\n${_LINES}")
			endif()
		endforeach()
		foreach(_NEEDED IN ITEMS "DW_AT_name\t(\"Double\")" "DW_AT_name\t(\"Total\")" "DW_AT_name\t(\"Counter\")")
			string(FIND "${_INFO}" "${_NEEDED}" _AT)
			if(_AT EQUAL -1)
				message(FATAL_ERROR "The debug info does not contain '${_NEEDED}':\n${_INFO}")
			endif()
		endforeach()
	endif()

elseif(CASE STREQUAL "field_defaults")
	# Like the original, New ignores the default values of fields.
	blitzcc(+q "${TESTS}/cli/field_defaults.bb")
	expect_ok()
	if(NOT OUT STREQUAL "0 0.0  0 0 0 0 0\n")
		message(FATAL_ERROR "Expected the defaults to be ignored, got:\n${OUT}")
	endif()
	# --field-defaults lets New set them, with Globals and Consts only.
	blitzcc(+q --field-defaults "${TESTS}/cli/field_defaults.bb")
	expect_ok()
	if(NOT OUT STREQUAL "3 2.5 n3 0 1 1 3 2\n")
		message(FATAL_ERROR "Expected the default values, got:\n${OUT}")
	endif()
	# --modern turns it on too, --no-field-defaults off again; the last option wins.
	blitzcc(+q --modern --no-field-defaults "${TESTS}/cli/field_defaults.bb")
	expect_ok()
	if(NOT OUT STREQUAL "0 0.0  0 0 0 0 0\n")
		message(FATAL_ERROR "Expected the defaults to be ignored with --no-field-defaults, got:\n${OUT}")
	endif()
	blitzcc(+q --no-modern --field-defaults "${TESTS}/cli/field_defaults.bb")
	expect_ok()
	if(NOT OUT STREQUAL "3 2.5 n3 0 1 1 3 2\n")
		message(FATAL_ERROR "Expected the default values with --field-defaults after --no-modern, got:\n${OUT}")
	endif()
	file(WRITE "${WORK}/field_default_local.bb"
		"Type T\n"
		"\tField a% = b\n"
		"End Type\n"
		"Function F(b)\n"
		"\tt.T = New T\n"
		"End Function\n"
		"F 1\n")
	blitzcc(--field-defaults -c "${WORK}/field_default_local.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A parameter in a field default was accepted.")
	endif()
	string(FIND "${ERR}" "'b' is not a Global or Const" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected the error, got:\n${ERR}")
	endif()
	file(WRITE "${WORK}/field_default_self.bb"
		"Type T\n"
		"\tField a.T = New T\n"
		"End Type\n"
		"t.T = New T\n")
	blitzcc(--field-defaults -c "${WORK}/field_default_self.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A field default that makes its own Type was accepted.")
	endif()
	string(FIND "${ERR}" "which would never end" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected the error, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "sane_evaluation_order")
	# The default is the order of the original Blitz3D: F3 takes b, c, a, x + y * z takes y * z first, an array store takes the index (8, 7) before the value (9).
	blitzcc(+q "${TESTS}/cli/sane_evaluation_order.bb")
	expect_ok()
	if(NOT OUT STREQUAL "231564879\n")
		message(FATAL_ERROR "Expected the order of the original, got:\n${OUT}")
	endif()
	# --sane-evaluation-order goes from left to right.
	blitzcc(+q --sane-evaluation-order "${TESTS}/cli/sane_evaluation_order.bb")
	expect_ok()
	if(NOT OUT STREQUAL "123456789\n")
		message(FATAL_ERROR "Expected left to right, got:\n${OUT}")
	endif()
	# --modern turns it on too, --no-sane-evaluation-order off again; the last option wins.
	blitzcc(+q --modern "${TESTS}/cli/sane_evaluation_order.bb")
	expect_ok()
	if(NOT OUT STREQUAL "123456789\n")
		message(FATAL_ERROR "Expected left to right with --modern, got:\n${OUT}")
	endif()
	blitzcc(+q --modern --no-sane-evaluation-order "${TESTS}/cli/sane_evaluation_order.bb")
	expect_ok()
	if(NOT OUT STREQUAL "231564879\n")
		message(FATAL_ERROR "Expected the order of the original with --no-sane-evaluation-order, got:\n${OUT}")
	endif()

elseif(CASE STREQUAL "pragmas")
	# ;#pragma lines in the comments at the top of the main file switch features for the whole program (docs/Modern-Mode.md).
	macro(expect_err TEXT)
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "Expected '${TEXT}' in the messages, got:\n${ERR}")
		endif()
	endmacro()
	macro(expect_no_err TEXT)
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "Did not expect '${TEXT}' in the messages, got:\n${ERR}")
		endif()
	endmacro()
	macro(expect_output TEXT WHAT)
		expect_ok()
		if(NOT OUT STREQUAL "${TEXT}\n")
			message(FATAL_ERROR "Expected ${WHAT} ('${TEXT}'), got:\n${OUT}\n${ERR}")
		endif()
	endmacro()
	file(READ "${TESTS}/cli/sane_evaluation_order.bb" _ORDER)
	file(READ "${TESTS}/cli/field_defaults.bb" _FIELDS)
	set(_ORIGINAL_ORDER "231564879")
	set(_LEFT_TO_RIGHT "123456789")
	set(_IGNORED "0 0.0  0 0 0 0 0")
	set(_APPLIED "3 2.5 n3 0 1 1 3 2")

	# modern turns on every feature, after other comments; the names are not case sensitive.
	file(WRITE "${WORK}/modern.bb" "; A program.\n\n;#PRAGMA Modern ; written for BlitzLLVM\n${_ORDER}")
	blitzcc(+q "${WORK}/modern.bb")
	expect_output("${_LEFT_TO_RIGHT}" "left to right order")
	file(WRITE "${WORK}/modern_fields.bb" ";#pragma modern\n${_FIELDS}")
	blitzcc(+q "${WORK}/modern_fields.bb")
	expect_output("${_APPLIED}" "the default values")

	# Single features, no- and the last name winning.
	file(WRITE "${WORK}/no_fields.bb" ";#pragma modern, no-field-defaults\n${_FIELDS}")
	blitzcc(+q "${WORK}/no_fields.bb")
	expect_output("${_IGNORED}" "the defaults to be ignored")
	file(WRITE "${WORK}/fields_only.bb" ";#pragma no-modern field-defaults\n${_FIELDS}")
	blitzcc(+q "${WORK}/fields_only.bb")
	expect_output("${_APPLIED}" "the default values")
	file(WRITE "${WORK}/order_only.bb" ";#pragma field-defaults\n;#pragma sane-evaluation-order no-field-defaults\n${_ORDER}")
	blitzcc(+q "${WORK}/order_only.bb")
	expect_output("${_LEFT_TO_RIGHT}" "left to right order")

	# The main file wins over the CLI options.
	file(WRITE "${WORK}/no_order.bb" ";#pragma no-sane-evaluation-order\n${_ORDER}")
	blitzcc(+q --sane-evaluation-order "${WORK}/no_order.bb")
	expect_output("${_ORIGINAL_ORDER}" "the order of the original")

	# Only the comments before the first statement count.
	file(WRITE "${WORK}/late.bb" "Global started = 1\n;#pragma modern\n${_ORDER}")
	blitzcc(+q "${WORK}/late.bb")
	expect_output("${_ORIGINAL_ORDER}" "the order of the original")
	blitzcc(-c "${WORK}/late.bb")
	expect_ok()
	expect_err("late.bb:2:10: warning: The pragma 'modern' comes after the first statement of the file, so it does nothing. [-Wpragma-misplaced]")

	# Unknown names warn and do nothing, other ;# comments are comments.
	file(WRITE "${WORK}/unknown.bb" ";#pragma bogus modern\n;#Region\n;#pragmatic\n;# pragma bogus2\n; #pragma bogus3\n${_ORDER}")
	blitzcc(-c "${WORK}/unknown.bb")
	expect_ok()
	expect_err("unknown.bb:1:10: warning: 'bogus' is not a pragma that this BlitzLLVM knows, it does nothing. [-Wpragma-unknown]")
	expect_no_err("bogus2")
	expect_no_err("bogus3")
	expect_no_err("pragmatic")
	expect_no_err("Region")
	blitzcc(+q "${WORK}/unknown.bb")
	expect_output("${_LEFT_TO_RIGHT}" "left to right order")
	blitzcc(-c -Werror=pragma-unknown "${WORK}/unknown.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "-Werror=pragma-unknown did not fail.")
	endif()

	# An Include'd file only says what it was written for: it switches nothing and warns when the program differs.
	file(WRITE "${WORK}/lib_modern.bb" "; A library.\n;#pragma modern\nFunction LibModern()\nEnd Function\n")
	file(WRITE "${WORK}/lib_old.bb" ";#pragma no-sane-evaluation-order\nFunction LibOld()\nEnd Function\n")
	file(WRITE "${WORK}/lib_plain.bb" "Function LibPlain()\nEnd Function\n")
	file(WRITE "${WORK}/lib_late.bb" "Function LibLate()\nEnd Function\n;#pragma modern\n")
	file(WRITE "${WORK}/uses_libs.bb" "Include \"lib_modern.bb\"\nInclude \"lib_plain.bb\"\nInclude \"lib_late.bb\"\n${_ORDER}")
	blitzcc(+q "${WORK}/uses_libs.bb")
	expect_output("${_ORIGINAL_ORDER}" "the order of the original")
	blitzcc(-c "${WORK}/uses_libs.bb")
	expect_ok()
	expect_err("lib_modern.bb:2:10: warning: 'lib_modern.bb' was written for a program that evaluates from left to right, but this one evaluates in the order of the original. [-Wpragma-mismatch]")
	expect_err("notice: The main file decides for the whole program: ;#pragma sane-evaluation-order in it, or --sane-evaluation-order.")
	expect_err("'lib_modern.bb' was written for a program that lets New apply the default values of fields, but this one ignores the default values of fields like the original. [-Wpragma-mismatch]")
	expect_err("lib_late.bb:3:10: warning: The pragma 'modern' comes after the first statement of the file, so it does nothing. [-Wpragma-misplaced]")
	expect_no_err("lib_plain.bb")
	expect_no_err("'lib_late.bb' was written")
	file(WRITE "${WORK}/modern_uses_libs.bb" ";#pragma modern\nInclude \"lib_modern.bb\"\nInclude \"lib_old.bb\"\nInclude \"lib_plain.bb\"\n${_ORDER}")
	blitzcc(+q "${WORK}/modern_uses_libs.bb")
	expect_output("${_LEFT_TO_RIGHT}" "left to right order")
	blitzcc(-c "${WORK}/modern_uses_libs.bb")
	expect_ok()
	expect_err("lib_old.bb:1:10: warning: 'lib_old.bb' was written for a program that evaluates in the order of the original, but this one evaluates from left to right. [-Wpragma-mismatch]")
	expect_err("notice: The main file decides for the whole program: ;#pragma no-sane-evaluation-order in it, or --no-sane-evaluation-order.")
	expect_no_err("'lib_modern.bb' was written")
	# The CLI options count as the program too.
	blitzcc(-c --modern "${WORK}/uses_libs.bb")
	expect_ok()
	expect_no_err("[-Wpragma-mismatch]")
	blitzcc(-c -Werror=pragma-mismatch "${WORK}/uses_libs.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "-Werror=pragma-mismatch did not fail.")
	endif()

	# Warning pragmas can be anywhere and work from their line on, like in C, into Include'd files and out of them again
	# (q is quiet: the Wno- at the end of wp_lib.bb goes on after the Include, until the pop).
	file(WRITE "${WORK}/wp_lib.bb" "Type LibT\n\tField a% = 1\nEnd Type\n;#pragma Wno-implicit-variable\n")
	file(WRITE "${WORK}/wp_main.bb"
		"Global y = 0\n"
		";#pragma warning(push)\n"
		";#pragma warning(disable: field-default-ignored)\n"
		"Include \"wp_lib.bb\"\n"
		"q = 1\n"
		";#pragma warning(pop)\n"
		"Type U\n\tField b% = 2\nEnd Type\n"
		"p = 1\n"
		";#pragma Wimplicit-variable, error(enable: implicit-variable)\n"
		"r = 1\n"
		";#pragma warning(pop) Wbogus warning(frob: x) warning(error: pragma-unknown\n")
	blitzcc(-c "${WORK}/wp_main.bb")
	expect_no_err("wp_lib.bb:2")
	expect_no_err("'q' was not declared")
	expect_err("wp_main.bb:8:11: warning: The default value of field 'b' is never used")
	expect_err("wp_main.bb:10:1: warning: 'p' was not declared, it is a new local variable. [-Wimplicit-variable]")
	expect_err("wp_main.bb:12:1: error: 'r' was not declared, it is a new local variable. [-Werror=implicit-variable]")
	expect_err("wp_main.bb:13:10: warning: 'warning(pop)' has no warning(push) before it, so it does nothing. [-Wpragma-pop-unmatched]")
	expect_err("wp_main.bb:13:23: warning: 'Wbogus' is not a warning pragma that this BlitzLLVM knows, it does nothing. [-Wpragma-unknown]")
	expect_err("'warning(frob: x)' is not a warning pragma")
	expect_err("'warning(error: pragma-unknown' is not a warning pragma")
	if(RC EQUAL 0)
		message(FATAL_ERROR "The warning made an error by a pragma did not fail.")
	endif()
	# The settings of the build are where every file starts; -Werror=x stays an error unless a pragma says otherwise.
	file(WRITE "${WORK}/wp_noerror.bb" ";#pragma Wno-error=implicit-variable\nz = 1\n")
	blitzcc(-c -Werror=implicit-variable "${WORK}/wp_noerror.bb")
	expect_ok()
	expect_err("'z' was not declared, it is a new local variable. [-Wimplicit-variable]")
	# A warning pragma is not a feature: it neither switches nor mismatches anything.
	file(WRITE "${WORK}/wp_quiet_lib.bb" ";#pragma Wno-implicit-variable\nFunction WpQuiet()\nEnd Function\n")
	file(WRITE "${WORK}/wp_quiet.bb" "Include \"wp_quiet_lib.bb\"\n${_ORDER}")
	blitzcc(-c "${WORK}/wp_quiet.bb")
	expect_ok()
	expect_no_err("[-Wpragma")

elseif(CASE STREQUAL "fast_math")
	# Float math is precise by default (the same result on every CPU). --fast-math safe adds everything but the NaN and Infinity
	# assumptions, which would break "x <> x" checks.
	set(FM_PROGRAM "${TESTS}/cli/fast_math.bb")
	blitzcc(-S "${FM_PROGRAM}" -o "${WORK}/precise.ll")
	expect_ok()
	file(READ "${WORK}/precise.ll" _IR)
	if(_IR MATCHES "f(add|sub|mul|div|cmp) (reassoc|fast|nsz|contract|arcp|afn)")
		message(FATAL_ERROR "The default build has fast-math flags on Float operations.")
	endif()
	blitzcc(-S --fast-math safe "${FM_PROGRAM}" -o "${WORK}/safe.ll")
	expect_ok()
	file(READ "${WORK}/safe.ll" _IR)
	if(NOT _IR MATCHES "fmul reassoc nsz arcp contract afn float")
		message(FATAL_ERROR "--fast-math safe has no fast-math flags on Float operations.")
	endif()
	if(_IR MATCHES "nnan|ninf")
		message(FATAL_ERROR "--fast-math safe assumes no NaN or Infinity.")
	endif()
	blitzcc(-S --fast-math full "${FM_PROGRAM}" -o "${WORK}/full.ll")
	expect_ok()
	file(READ "${WORK}/full.ll" _IR)
	if(NOT _IR MATCHES "fmul fast float")
		message(FATAL_ERROR "--fast-math full did not put fast on Float operations.")
	endif()
	foreach(_ARGS IN ITEMS "-S;--fast-math;off" "-S;--fast-math;precise" "-S;-d")
		blitzcc(${_ARGS} "${FM_PROGRAM}" -o "${WORK}/off.ll")
		expect_ok()
		file(READ "${WORK}/off.ll" _IR)
		if(_IR MATCHES "f(add|sub|mul|div|cmp) (reassoc|fast|nsz)")
			message(FATAL_ERROR "Fast-math flags found with ${_ARGS}.")
		endif()
	endforeach()
	# NaN and Infinity still behave in the default build.
	blitzcc("${FM_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED)
	if(NOT _PRINTED MATCHES "nan 1 inf 1")
		message(FATAL_ERROR "NaN or Infinity misbehaved: ${_PRINTED}")
	endif()

elseif(CASE STREQUAL "inline_checks")
	# The array, division and object checks are part of the program and still report the same errors, which also holds for
	# negative indices and objects that were deleted.
	set(_HEAD "Dim a(3)\nType T\nField v\nEnd Type\nLocal t.T = New T\nDelete t\nLocal z = 0\n")
	foreach(_CASE_ITEM IN ITEMS "a(-1) = 1|Array index out of bounds." "a(4) = 1|Array index out of bounds." "Print 5 / z|Integer divide by zero" "Print 5 Mod z|Integer divide by zero" "Print t\\v|Object does not exist.")
		string(REPLACE "|" ";" _PARTS "${_CASE_ITEM}")
		list(GET _PARTS 0 _CODE)
		list(GET _PARTS 1 _MESSAGE)
		file(WRITE "${WORK}/inline_checks.bb" "${_HEAD}${_CODE}\nPrint \"survived\"\n")
		blitzcc(-q "${WORK}/inline_checks.bb")
		if(RC EQUAL 0 OR NOT "${OUT}${ERR}" MATCHES "${_MESSAGE}" OR "${OUT}${ERR}" MATCHES "survived")
			message(FATAL_ERROR "'${_CODE}' did not report '${_MESSAGE}' (${RC}):\nstdout: ${OUT}\nstderr: ${ERR}")
		endif()
	endforeach()
	file(WRITE "${WORK}/inline_ok.bb" "Dim a(3)\na(3) = 7\nLocal z = 2\nPrint a(3) + 10 / z + Sqr(16.0) + Floor(2.5) + Ceil(2.5)\n")
	blitzcc(-q "${WORK}/inline_ok.bb")
	expect_ok()
	expect_contains("21.0")

elseif(CASE STREQUAL "for_step")
	# A step that can never end the loop is refused, and a step that is not a constant only warns.
	foreach(_STEP IN ITEMS "0" "0.0" "-0.0" "1 - 1" "Zero")
		file(WRITE "${WORK}/step.bb" "Const Zero = 0\nFor i% = 1 To 3 Step ${_STEP}\nNext\n")
		blitzcc(-q -c "${WORK}/step.bb")
		if(RC EQUAL 0 OR NOT "${OUT}${ERR}" MATCHES "step of a For loop can't be 0")
			message(FATAL_ERROR "'Step ${_STEP}' was not refused (${RC}):\nstdout: ${OUT}\nstderr: ${ERR}")
		endif()
	endforeach()
	file(WRITE "${WORK}/step.bb" "Local n% = 2\nFor i% = 1 To 3 Step n\nNext\n")
	blitzcc(-c -W4 "${WORK}/step.bb")
	expect_ok()
	string(FIND "${ERR}" "[-Wloop-unroll-requires-constant]" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "A step that is not a constant did not warn:\n${ERR}")
	endif()

elseif(CASE STREQUAL "joined_block_ends")
	# EndIf, EndSelect, EndFunction and EndType are the one-word forms of End If, End Select, End Function and End Type.
	set(_PROGRAM "Function F%(n%)\nSelect n\nCase 1\nReturn 10\nEndSelect\nIf n = 2\nReturn 20\nEndIf\nReturn 0\nEndFunction\nType T\nField a%\nEndType\nLocal t.T = New T\nt\\a = 5\nPrint F(1) + F(2) + F(3) + t\\a\n")
	string(REPLACE "EndSelect" "End Select" _SPACED "${_PROGRAM}")
	string(REPLACE "EndIf" "End If" _SPACED "${_SPACED}")
	string(REPLACE "EndFunction" "End Function" _SPACED "${_SPACED}")
	string(REPLACE "EndType" "End Type" _SPACED "${_SPACED}")
	foreach(_FORM IN ITEMS joined spaced)
		if(_FORM STREQUAL "joined")
			file(WRITE "${WORK}/${_FORM}.bb" "${_PROGRAM}")
		else()
			file(WRITE "${WORK}/${_FORM}.bb" "${_SPACED}")
		endif()
		blitzcc(-q "${WORK}/${_FORM}.bb" -o "${EXE}")
		expect_ok()
		execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED)
		string(STRIP "${_PRINTED}" _PRINTED)
		if(NOT _RUN EQUAL 0 OR NOT _PRINTED STREQUAL "35")
			message(FATAL_ERROR "The ${_FORM} block ends gave '${_PRINTED}' (${_RUN}), expected 35.")
		endif()
	endforeach()

elseif(CASE STREQUAL "error_line")
	# A runtime error in a debug build names the file and line it came from; without -d there is no such line to name.
	set(ERROR_PROGRAM "${TESTS}/cli/error_line.bb")
	blitzcc(-d "${ERROR_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN ERROR_VARIABLE _ERR OUTPUT_QUIET)
	if(_RUN EQUAL 0 OR NOT _ERR MATCHES "Runtime Error: Integer divide by zero" OR NOT _ERR MATCHES "at [^\n]*error_line\\.bb:6")
		message(FATAL_ERROR "The runtime error of a debug build does not say where it is (${_RUN}): ${_ERR}")
	endif()
	blitzcc("${ERROR_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN ERROR_VARIABLE _ERR OUTPUT_QUIET)
	if(_ERR MATCHES "error_line")
		message(FATAL_ERROR "A build without -d names a line: ${_ERR}")
	endif()

elseif(CASE STREQUAL "stop")
	# Stop is a breakpoint in a debug build, and nothing in any other. Neither is run with the trap in it.
	set(STOP_PROGRAM "${TESTS}/cli/stop.bb")
	blitzcc(-S -d "${STOP_PROGRAM}" -o "${WORK}/debug.ll")
	expect_ok()
	file(READ "${WORK}/debug.ll" _DEBUG_IR)
	string(FIND "${_DEBUG_IR}" "call void @llvm.debugtrap()" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "A debug build did not trap at Stop.")
	endif()
	foreach(_ARGS IN ITEMS "-S" "-S;-O3")
		blitzcc(${_ARGS} "${STOP_PROGRAM}" -o "${WORK}/release.ll")
		expect_ok()
		file(READ "${WORK}/release.ll" _RELEASE_IR)
		string(FIND "${_RELEASE_IR}" "debugtrap" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "A build without -d traps at Stop.")
		endif()
	endforeach()
	# And the program carries on past it.
	blitzcc("${STOP_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED)
	string(FIND "${_PRINTED}" "after" _AT)
	if(NOT _RUN EQUAL 0 OR _AT EQUAL -1)
		message(FATAL_ERROR "The program did not carry on after Stop: ${_RUN} ${_PRINTED}")
	endif()

elseif(CASE STREQUAL "gfx_driver")
	# SetGfxDriver once something needs the GPU stops a debug build with an error, and is ignored by any other build.
	# The programs run without a window (BLITZLLVM_HEADLESS), where there is the one driver "Default".
	set(ENV{BLITZLLVM_HEADLESS} "1")
	set(DRIVER_PROGRAM "${TESTS}/cli/gfx_driver.bb")
	blitzcc("${DRIVER_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED ERROR_VARIABLE _ERRORS)
	string(FIND "${_PRINTED}" "after" _AT)
	if(NOT _RUN EQUAL 0 OR _AT EQUAL -1)
		message(FATAL_ERROR "A build without -d did not ignore SetGfxDriver after an image was made: ${_RUN} ${_PRINTED} ${_ERRORS}")
	endif()
	blitzcc(-d "${DRIVER_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED ERROR_VARIABLE _ERRORS)
	string(FIND "${_ERRORS}" "SetGfxDriver" _AT)
	string(FIND "${_PRINTED}" "after" _AFTER)
	if(_RUN EQUAL 0 OR _AT EQUAL -1 OR NOT _AFTER EQUAL -1)
		message(FATAL_ERROR "A debug build did not stop at SetGfxDriver after an image was made: ${_RUN} ${_PRINTED} ${_ERRORS}")
	endif()
	unset(ENV{BLITZLLVM_HEADLESS})

elseif(CASE STREQUAL "gpu_preference")
	# Programs for Windows export NvOptimusEnablement, NvOptimusEnablementCuda and AmdPowerXpressRequestHighPerformance (all 1), which the drivers of hybrid
	# graphics laptops look for to pick the dedicated GPU. Other systems have nothing like it.
	foreach(_TARGET IN ITEMS x86_64-pc-windows-msvc x86_64-w64-mingw32)
		blitzcc(-S --target ${_TARGET} "${PROGRAM}" -o "${WORK}/${_TARGET}.ll")
		expect_ok()
		file(READ "${WORK}/${_TARGET}.ll" _IR)
		foreach(_SYMBOL IN ITEMS NvOptimusEnablement NvOptimusEnablementCuda AmdPowerXpressRequestHighPerformance)
			if(NOT _IR MATCHES "@${_SYMBOL} = dllexport global i32 1")
				message(FATAL_ERROR "A program for ${_TARGET} does not export ${_SYMBOL} as 1.")
			endif()
		endforeach()
	endforeach()
	blitzcc(-S --target x86_64-unknown-linux-gnu "${PROGRAM}" -o "${WORK}/linux.ll")
	expect_ok()
	file(READ "${WORK}/linux.ll" _IR)
	if(_IR MATCHES "NvOptimusEnablement|AmdPowerXpress")
		message(FATAL_ERROR "A program for Linux has the GPU preference symbols.")
	endif()
	# On Windows the finished program has them in its export table.
	if(CMAKE_HOST_WIN32)
		find_program(_READOBJ NAMES llvm-readobj)
		blitzcc("${PROGRAM}" -o "${WORK}/program.exe")
		expect_ok()
		if(_READOBJ)
			execute_process(COMMAND "${_READOBJ}" --coff-exports "${WORK}/program.exe" OUTPUT_VARIABLE _EXPORTS RESULT_VARIABLE _RC)
			foreach(_SYMBOL IN ITEMS NvOptimusEnablement NvOptimusEnablementCuda AmdPowerXpressRequestHighPerformance)
				if(NOT _EXPORTS MATCHES "${_SYMBOL}")
					message(FATAL_ERROR "The export table of the program does not contain ${_SYMBOL}: ${_EXPORTS}")
				endif()
			endforeach()
		endif()
	endif()

