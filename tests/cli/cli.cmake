################################################################################
# Tests for the command line options of blitzcc, run as 'cmake -DCASE=<name> ... -P cli.cmake'.
#
# Variables: BLITZCC (the compiler), TESTS (the tests directory), WORK (an empty directory to write to), VERSION (what
# -v has to report).
################################################################################
cmake_minimum_required(VERSION 3.20)

set(PROGRAM "${TESTS}/cli/program.bb")
set(USERLIBS "${TESTS}/cli/userlibs")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# Run the compiler in WORK, results are RC, OUT and ERR.
function(blitzcc)
	execute_process(
		COMMAND "${BLITZCC}" ${ARGN}
		WORKING_DIRECTORY "${WORK}"
		RESULT_VARIABLE _RC
		OUTPUT_VARIABLE _OUT
		ERROR_VARIABLE _ERR
	)
	set(RC "${_RC}" PARENT_SCOPE)
	set(OUT "${_OUT}" PARENT_SCOPE)
	set(ERR "${_ERR}" PARENT_SCOPE)
endfunction()

macro(expect_ok)
	if(NOT RC EQUAL 0)
		message(FATAL_ERROR "Expected success, got '${RC}'.\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
endmacro()

macro(expect_contains TEXT)
	string(FIND "${OUT}" "${TEXT}" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected '${TEXT}' in the output, got:\n${OUT}")
	endif()
endmacro()

macro(expect_missing TEXT)
	string(FIND "${OUT}" "${TEXT}" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Did not expect '${TEXT}' in the output, got:\n${OUT}")
	endif()
endmacro()

# Build the test userlib (tests/cli/userlib) into DIR as a shared library or, with STATIC, as a static one, and copy the .decls.
# Names are what the platform uses, so that the .dll of the .decls file has to be found by its other names.
function(build_userlib DIR KIND)
	set(_CC "$ENV{BLITZLLVM_CC}")
	if(NOT _CC)
		set(_CC clang)
	endif()
	file(MAKE_DIRECTORY "${DIR}")
	set(_SRC "${TESTS}/cli/userlib/ultest.c")
	if(CMAKE_HOST_WIN32)
		set(_OUTPUT "${DIR}/ultest.dll")
	elseif(CMAKE_HOST_APPLE)
		set(_OUTPUT "${DIR}/libultest.dylib")
	else()
		set(_OUTPUT "${DIR}/libultest.so")
	endif()
	execute_process(COMMAND "${_CC}" -shared -fPIC "${_SRC}" -o "${_OUTPUT}" RESULT_VARIABLE _RC ERROR_VARIABLE _ERR)
	if(NOT _RC EQUAL 0)
		message(FATAL_ERROR "Building the test userlib failed: ${_ERR}")
	endif()
	file(COPY "${TESTS}/cli/userlib/ultest.decls" DESTINATION "${DIR}")
endfunction()

macro(expect_userlib_output)
	expect_ok()
	expect_contains("5\n")
	expect_contains("6.0\n")
	expect_contains("hello, World\n")
	expect_contains("1234\n")
endmacro()


# A whole line, so that 'Left' does not match 'LeftHand'.
macro(expect_line LINE)
	string(REGEX REPLACE "([][+.*^$?|()\\\\])" "\\\\\\1" _ESCAPED "${LINE}")
	if(NOT "\n${OUT}" MATCHES "\n${_ESCAPED}\n")
		message(FATAL_ERROR "Expected the line '${LINE}' in the output, got:\n${OUT}")
	endif()
endmacro()

set(EXE "${WORK}/program${CMAKE_EXECUTABLE_SUFFIX}")

if(CASE STREQUAL "default")
	# Nothing given: Banner and every step.
	blitzcc("${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains("BlitzCC V${VERSION}")
	expect_contains("Compiling \"")
	expect_contains("Parsing...")
	expect_contains("Generating...")
	expect_contains("Creating executable \"")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()

elseif(CASE STREQUAL "quiet")
	# -q drops the banner and the warnings, but not the errors.
	blitzcc(-q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_missing("BlitzCC")
	expect_missing("Compiling")
	expect_contains("Parsing...")
	expect_contains("Creating executable \"")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()
	file(WRITE "${WORK}/warning.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(-c "${WORK}/warning.bb")
	expect_ok()
	string(FIND "${ERR}" "warning" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected a warning without -q, got:\n${ERR}")
	endif()
	blitzcc(-q -c "${WORK}/warning.bb")
	expect_ok()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no warnings with -q, got:\n${ERR}")
	endif()
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc(-q -c "${WORK}/broken.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	string(FIND "${ERR}" "error" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected an error message with -q, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "very_quiet")
	# +q drops every message, but the executable is still created.
	blitzcc(+q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	if(NOT OUT STREQUAL "")
		message(FATAL_ERROR "Expected no output, got:\n${OUT}")
	endif()
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()
	# Warnings and errors are silent too, but a broken program still fails.
	file(WRITE "${WORK}/warning.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(+q -c "${WORK}/warning.bb")
	expect_ok()
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected no warnings, got:\n${ERR}")
	endif()
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc(+q "${WORK}/broken.bb" -o "${EXE}.broken")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	if(NOT ERR STREQUAL "" OR NOT OUT STREQUAL "")
		message(FATAL_ERROR "Expected no messages, got:\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
	if(EXISTS "${EXE}.broken")
		message(FATAL_ERROR "An executable was created for a broken program.")
	endif()

elseif(CASE STREQUAL "options_not_case_sensitive")
	blitzcc(+Q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	if(NOT OUT STREQUAL "")
		message(FATAL_ERROR "Expected no output, got:\n${OUT}")
	endif()

elseif(CASE STREQUAL "compile_only")
	# -c checks the program, but doesn't create anything.
	blitzcc(-c "${PROGRAM}")
	expect_ok()
	expect_contains("Generating...")
	expect_missing("Creating")
	file(GLOB _CREATED "${WORK}/*")
	if(_CREATED)
		message(FATAL_ERROR "Compile only created files: ${_CREATED}")
	endif()
	# It still reports errors.
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc(-c "${WORK}/broken.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	# -o wins, like in the original.
	blitzcc(-c "${PROGRAM}" -o "${EXE}")
	expect_ok()
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "-c with -o did not create the executable.")
	endif()

elseif(CASE STREQUAL "debug")
	# -d never optimizes and adds debug information, wherever the optimization level is.
	foreach(_ARGS IN ITEMS "-d;-O3" "-O3;-d")
		blitzcc(${_ARGS} --verbose "${PROGRAM}" -o "${EXE}")
		expect_ok()
		expect_contains(" -O0 ")
		expect_contains(" -g ")
		expect_missing("-O3")
	endforeach()
	# Without -d it is optimized and has no debug information.
	blitzcc(--verbose "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains(" -O2 ")
	expect_missing(" -g ")
	# And the result runs.
	blitzcc(-d "${PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" WORKING_DIRECTORY "${TESTS}" RESULT_VARIABLE _RUN OUTPUT_QUIET ERROR_QUIET)
	if(NOT _RUN EQUAL 0)
		message(FATAL_ERROR "The debug build failed to run: ${_RUN}")
	endif()

elseif(CASE STREQUAL "debug_info")
	# -d and -g describe the program to debuggers, in the files, lines and columns of the source.
	set(DEBUG_PROGRAM "${TESTS}/cli/debug.bb")
	blitzcc(-S -d "${DEBUG_PROGRAM}" -o "${WORK}/debug.ll")
	expect_ok()
	file(READ "${WORK}/debug.ll" _IR)
	foreach(_NEEDED IN ITEMS "!DICompileUnit(" "emissionKind: FullDebug" "\"Debug Info Version\"" "\"Dwarf Version\""
		"filename: \"debug.bb\"" "filename: \"debug_include.bb\"" "!DISubprogram(name: \"Double\"" "!DISubprogram(name: \"main\""
		"!DILocalVariable(name: \"Value\", arg: 1" "!DILocalVariable(name: \"Total\"" "!DIGlobalVariable(name: \"Counter\"" "!DIGlobalVariable(name: \"Included\""
		"call void @llvm.dbg.declare(" "!DILexicalBlockFile(" "!DILocation(line: 14, column: 1,")
		string(FIND "${_IR}" "${_NEEDED}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "The debug IR does not contain '${_NEEDED}'.")
		endif()
	endforeach()
	string(FIND "${_IR}" "CodeView" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "A DWARF target got CodeView.")
	endif()
	# Windows with MSVC uses CodeView.
	blitzcc(-S -d --target x86_64-pc-windows-msvc "${DEBUG_PROGRAM}" -o "${WORK}/codeview.ll")
	expect_ok()
	file(READ "${WORK}/codeview.ll" _IR)
	foreach(_NEEDED IN ITEMS "\"CodeView\"" "\"Debug Info Version\"")
		string(FIND "${_IR}" "${_NEEDED}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "The CodeView IR does not contain '${_NEEDED}'.")
		endif()
	endforeach()
	string(FIND "${_IR}" "Dwarf Version" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "A CodeView target got DWARF.")
	endif()
	# MinGW uses DWARF.
	blitzcc(-S -d --target x86_64-w64-mingw32 "${DEBUG_PROGRAM}" -o "${WORK}/mingw.ll")
	expect_ok()
	file(READ "${WORK}/mingw.ll" _IR)
	string(FIND "${_IR}" "Dwarf Version" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "A MinGW target did not get DWARF.")
	endif()
	# Without either option there is none of it.
	blitzcc(-S "${DEBUG_PROGRAM}" -o "${WORK}/release.ll")
	expect_ok()
	file(READ "${WORK}/release.ll" _IR)
	foreach(_FORBIDDEN IN ITEMS "!dbg" "DICompileUnit" "llvm.dbg" "!llvm.module.flags")
		string(FIND "${_IR}" "${_FORBIDDEN}" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "A build without debug information contains '${_FORBIDDEN}'.")
		endif()
	endforeach()
	# -g keeps the optimization level, -d does not.
	blitzcc(-g --verbose "${DEBUG_PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains(" -O2 ")
	expect_contains(" -g ")
	blitzcc(-S -g "${DEBUG_PROGRAM}" -o "${WORK}/g.ll")
	expect_ok()
	file(READ "${WORK}/g.ll" _IR)
	string(FIND "${_IR}" "DICompileUnit" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "-g did not add debug information.")
	endif()
	# What LLVM makes of it: the line table maps instructions back to the lines and the file of the source.
	find_program(CLANG clang)
	find_program(DWARFDUMP NAMES llvm-dwarfdump llvm-dwarfdump-18 llvm-dwarfdump-19 llvm-dwarfdump-20 llvm-dwarfdump-21)
	if(CLANG AND DWARFDUMP)
		execute_process(COMMAND "${CLANG}" -c -w "${WORK}/debug.ll" -o "${WORK}/debug.o" RESULT_VARIABLE _RC ERROR_VARIABLE _ERR)
		if(NOT _RC EQUAL 0)
			message(FATAL_ERROR "LLVM did not accept the debug information: ${_ERR}")
		endif()
		execute_process(COMMAND "${DWARFDUMP}" --debug-line "${WORK}/debug.o" OUTPUT_VARIABLE _LINES RESULT_VARIABLE _RC)
		execute_process(COMMAND "${DWARFDUMP}" --debug-info "${WORK}/debug.o" OUTPUT_VARIABLE _INFO)
		foreach(_NEEDED IN ITEMS "name: \"debug.bb\"" "name: \"debug_include.bb\"")
			string(FIND "${_LINES}" "${_NEEDED}" _AT)
			if(_AT EQUAL -1)
				message(FATAL_ERROR "The line table does not contain '${_NEEDED}':\n${_LINES}")
			endif()
		endforeach()
		# Lines 12 (in Double) and 15 (the main program) have instructions.
		foreach(_LINE IN ITEMS 12 15)
			if(NOT "${_LINES}" MATCHES "\n0x[0-9a-f]+ +${_LINE} ")
				message(FATAL_ERROR "The line table has no instructions for line ${_LINE}:\n${_LINES}")
			endif()
		endforeach()
		foreach(_NEEDED IN ITEMS "DW_AT_name\t(\"Double\")" "DW_AT_name\t(\"Total\")" "DW_AT_name\t(\"Counter\")")
			string(FIND "${_INFO}" "${_NEEDED}" _AT)
			if(_AT EQUAL -1)
				message(FATAL_ERROR "The debug info does not contain '${_NEEDED}':\n${_INFO}")
			endif()
		endforeach()
	endif()

elseif(CASE STREQUAL "stop")
	# Stop is a breakpoint in a debug build, and nothing in any other. Neither is run with the trap in it.
	set(STOP_PROGRAM "${TESTS}/cli/stop.bb")
	blitzcc(-S -d "${STOP_PROGRAM}" -o "${WORK}/debug.ll")
	expect_ok()
	file(READ "${WORK}/debug.ll" _DEBUG_IR)
	string(FIND "${_DEBUG_IR}" "call void @llvm.debugtrap()" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "A debug build did not trap at Stop.")
	endif()
	foreach(_ARGS IN ITEMS "-S" "-S;-O3")
		blitzcc(${_ARGS} "${STOP_PROGRAM}" -o "${WORK}/release.ll")
		expect_ok()
		file(READ "${WORK}/release.ll" _RELEASE_IR)
		string(FIND "${_RELEASE_IR}" "debugtrap" _AT)
		if(NOT _AT EQUAL -1)
			message(FATAL_ERROR "A build without -d traps at Stop.")
		endif()
	endforeach()
	# And the program carries on past it.
	blitzcc("${STOP_PROGRAM}" -o "${EXE}")
	expect_ok()
	execute_process(COMMAND "${EXE}" RESULT_VARIABLE _RUN OUTPUT_VARIABLE _PRINTED)
	string(FIND "${_PRINTED}" "after" _AT)
	if(NOT _RUN EQUAL 0 OR _AT EQUAL -1)
		message(FATAL_ERROR "The program did not carry on after Stop: ${_RUN} ${_PRINTED}")
	endif()

elseif(CASE STREQUAL "keywords")
	blitzcc(-k --userlibs-dir "${USERLIBS}")
	expect_ok()
	# The language, the runtime, and the userlibs.
	expect_line("Dim")
	expect_line("While")
	expect_line("Wend")
	expect_line("Sar")
	expect_line("print")
	expect_line("createcube")
	expect_line("CliAdd")
	expect_line("CliShow")
	# Words with a space are the same keyword as the one without it, and are not listed.
	expect_missing("End If")
	# Keywords only, no syntax.
	expect_missing("(")
	# Nothing is compiled.
	file(GLOB _CREATED "${WORK}/*")
	if(_CREATED)
		message(FATAL_ERROR "Dumping keywords created files: ${_CREATED}")
	endif()
	# Without userlibs there are none of theirs.
	blitzcc(-k --userlibs-dir "${WORK}")
	expect_ok()
	expect_line("Dim")
	expect_missing("CliAdd")

elseif(CASE STREQUAL "keywords_syntax")
	blitzcc(+k --userlibs-dir "${USERLIBS}")
	expect_ok()
	expect_line("Dim")
	# Returns something: 'Name$ ( parameters )', parameters with a default are in brackets.
	expect_line("left$ ( param1$,param2 )")
	expect_line("mid$ ( param1$,param2,[param3] )")
	expect_line("rand ( param1,[param2] )")
	# Returns nothing: 'Name parameters'.
	expect_line("print [param1$]")
	# Userlibs.
	expect_line("CliAdd ( a,b )")
	expect_line("CliScale# ( value#,factor# )")
	expect_line("CliName$ ( id )")
	expect_line("CliShow text$,handle*")

elseif(CASE STREQUAL "keywords_bad_userlib")
	file(WRITE "${WORK}/userlibs/bad.decls" "CliAdd%(a%)\n")
	blitzcc(-k --userlibs-dir "${WORK}/userlibs")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A userlib without .lib was accepted.")
	endif()
	string(FIND "${ERR}" "Error in userlib 'bad.decls' - function decl without lib directive" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected the error to name the file and the problem, got:\n${ERR}")
	endif()
	file(WRITE "${WORK}/userlibs/bad.decls" ".lib \"a.dll\"\nCliAdd%(a%)\nCLIADD%(b%)\n")
	blitzcc(-k --userlibs-dir "${WORK}/userlibs")
	string(FIND "${ERR}" "duplicate identifier" _AT)
	if(RC EQUAL 0 OR _AT EQUAL -1)
		message(FATAL_ERROR "A duplicate name was accepted: ${ERR}")
	endif()

elseif(CASE STREQUAL "version")
	blitzcc(-v)
	expect_ok()
	expect_line("Compiler version:${VERSION}")
	expect_line("Runtime version:${VERSION}")
	expect_missing("Usage")
	# It's the timestamp version Y.M.D.T.
	if(NOT VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")
		message(FATAL_ERROR "'${VERSION}' is not a timestamp version.")
	endif()
	# Together with a file it still compiles.
	blitzcc(-v +q "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_line("Compiler version:${VERSION}")
	if(NOT EXISTS "${EXE}")
		message(FATAL_ERROR "The executable was not created.")
	endif()

elseif(CASE STREQUAL "verbose_long_only")
	# -v used to be the short form of --verbose, now it is the version like in the original.
	blitzcc(--verbose "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_contains("-lm")
	blitzcc(-v "${PROGRAM}" -o "${EXE}")
	expect_ok()
	expect_missing("-lm")

elseif(CASE STREQUAL "userlib_shared")
	# A function of a userlib is called, with --userlibs-dir, from a shared library that is loaded when the program runs.
	build_userlib("${WORK}/userlibs" shared)
	blitzcc(+q "${TESTS}/cli/userlib/call.bb" --userlibs-dir "${WORK}/userlibs")
	expect_userlib_output()
	# The functions are listed too.
	blitzcc(-k --userlibs-dir "${WORK}/userlibs")
	expect_contains("UlAdd\n")
	blitzcc(+k --userlibs-dir "${WORK}/userlibs")
	expect_contains("UlScale# ( value#,factor# )\n")
	expect_contains("UlStore memory*,value\n")
	# Without the userlibs the functions don't exist.
	blitzcc(-q "${TESTS}/cli/userlib/call.bb" --userlibs-dir "${WORK}")
	if(RC EQUAL 0)
		message(FATAL_ERROR "Calling a function of a userlib that is not there worked.")
	endif()
	string(FIND "${ERR}" "functions don't exist" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected the missing functions to be reported, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "userlib_env")
	# BLITZLLVM_USERLIBS selects the directory, and --userlibs-dir wins over it.
	build_userlib("${WORK}/env" shared)
	file(MAKE_DIRECTORY "${WORK}/empty")
	set(ENV{BLITZLLVM_USERLIBS} "${WORK}/env")
	blitzcc(+q "${TESTS}/cli/userlib/call.bb")
	expect_userlib_output()
	blitzcc(+q "${TESTS}/cli/userlib/call.bb" --userlibs-dir "${WORK}/empty")
	if(RC EQUAL 0)
		message(FATAL_ERROR "--userlibs-dir did not win over BLITZLLVM_USERLIBS.")
	endif()

elseif(CASE STREQUAL "userlib_missing_library")
	# A declaration whose library is missing is only an error for a program that calls it, when it does, and the error names the library.
	file(MAKE_DIRECTORY "${WORK}/userlibs")
	file(COPY "${TESTS}/cli/userlib/ultest.decls" DESTINATION "${WORK}/userlibs")
	blitzcc(+q "${TESTS}/cli/run.bb" --userlibs-dir "${WORK}/userlibs")
	expect_ok()
	blitzcc(+q "${TESTS}/cli/userlib/call.bb" --userlibs-dir "${WORK}/userlibs")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A missing library was not reported.")
	endif()
	string(FIND "${ERR}" "the library 'ultest.dll' could not be loaded" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected the missing library to be named, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "userlib_missing_function")
	# A function that the library does not have is reported when it is called.
	build_userlib("${WORK}/userlibs" shared)
	file(APPEND "${WORK}/userlibs/ultest.decls" "UlNotThere%(a%)\n")
	file(WRITE "${WORK}/missing.bb" "Print UlNotThere(1)\n")
	blitzcc(+q "${WORK}/missing.bb" --userlibs-dir "${WORK}/userlibs")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A missing function was not reported.")
	endif()
	string(FIND "${ERR}" "the function 'UlNotThere' was not found in 'ultest.dll'" _AT)
	if(_AT EQUAL -1)
		message(FATAL_ERROR "Expected the missing function to be named, got:\n${ERR}")
	endif()

elseif(CASE STREQUAL "userlib_system")
	# A library that is not a file anywhere is left to the system, like user32.dll is, here the C math library.
	if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
		return()
	endif()
	file(MAKE_DIRECTORY "${WORK}/userlibs")
	file(WRITE "${WORK}/userlibs/system.decls" ".lib \"libm.so.6\"\nUlCos#(x#):\"cosf\"\n")
	file(WRITE "${WORK}/system.bb" "Print UlCos(0)\n")
	blitzcc(+q "${WORK}/system.bb" --userlibs-dir "${WORK}/userlibs")
	expect_ok()
	expect_contains("1.0\n")

elseif(CASE STREQUAL "userlib_output_dir")
	# The library is next to the program, and not in the userlibs directory (which only has the .decls file).
	build_userlib("${WORK}/out" shared)
	file(MAKE_DIRECTORY "${WORK}/userlibs")
	file(RENAME "${WORK}/out/ultest.decls" "${WORK}/userlibs/ultest.decls")
	blitzcc(+q "${TESTS}/cli/userlib/call.bb" --userlibs-dir "${WORK}/userlibs" -o "${WORK}/out/call${CMAKE_EXECUTABLE_SUFFIX}")
	expect_ok()
	execute_process(COMMAND "${WORK}/out/call${CMAKE_EXECUTABLE_SUFFIX}" RESULT_VARIABLE _RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
	set(RC "${_RC}")
	expect_userlib_output()
	# Run without -o the library next to the source is found too.
	file(MAKE_DIRECTORY "${WORK}/src")
	build_userlib("${WORK}/src" shared)
	file(RENAME "${WORK}/src/ultest.decls" "${WORK}/src/ultest.decls.unused")
	file(COPY "${TESTS}/cli/userlib/call.bb" DESTINATION "${WORK}/src")
	blitzcc(+q "${WORK}/src/call.bb" --userlibs-dir "${WORK}/userlibs")
	expect_userlib_output()

elseif(CASE STREQUAL "userlib_layout")
	# The compiler finds <prefix>/userlibs on its own when it is installed as <prefix>/bin/blitzcc.
	get_filename_component(_BIN_DIR "${BLITZCC}" DIRECTORY)
	file(MAKE_DIRECTORY "${WORK}/prefix/bin")
	file(COPY "${BLITZCC}" DESTINATION "${WORK}/prefix/bin")
	file(COPY "${_BIN_DIR}/runtime" DESTINATION "${WORK}/prefix/bin")
	build_userlib("${WORK}/prefix/userlibs" shared)
	get_filename_component(_NAME "${BLITZCC}" NAME)
	set(BLITZCC "${WORK}/prefix/bin/${_NAME}")
	unset(ENV{BLITZLLVM_USERLIBS})
	blitzcc(+q "${TESTS}/cli/userlib/call.bb")
	expect_userlib_output()
	blitzcc(-k)
	expect_contains("UlAdd\n")
	# The layout of a package: <prefix>/share/blitzllvm/userlibs.
	file(RENAME "${WORK}/prefix/userlibs" "${WORK}/prefix/share")
	file(MAKE_DIRECTORY "${WORK}/prefix/share2/blitzllvm")
	file(RENAME "${WORK}/prefix/share" "${WORK}/prefix/share2/blitzllvm/userlibs")
	file(RENAME "${WORK}/prefix/share2" "${WORK}/prefix/share")
	blitzcc(+q "${TESTS}/cli/userlib/call.bb")
	expect_userlib_output()

elseif(CASE STREQUAL "run")
	# Without -o the program is built and run, and nothing is left behind.
	blitzcc("${TESTS}/cli/run.bb" --args one two)
	expect_ok()
	expect_contains("Executing...")
	expect_contains("ran:one two")
	file(GLOB _CREATED "${WORK}/*")
	if(_CREATED)
		message(FATAL_ERROR "Running created files: ${_CREATED}")
	endif()
	# +q only leaves what the program prints.
	blitzcc(+q "${TESTS}/cli/run.bb")
	expect_ok()
	if(NOT OUT STREQUAL "ran:\n")
		message(FATAL_ERROR "Expected only the output of the program, got:\n${OUT}")
	endif()
	# With -o it is built, but not run.
	blitzcc("${TESTS}/cli/run.bb" -o "${EXE}")
	expect_ok()
	expect_missing("Executing")
	expect_missing("ran:")
	# Neither -c nor -S run it.
	blitzcc(-c "${TESTS}/cli/run.bb")
	expect_ok()
	expect_missing("ran:")
	blitzcc(-S "${TESTS}/cli/run.bb" -o "${WORK}/run.ll")
	expect_ok()
	expect_missing("ran:")

elseif(CASE STREQUAL "run_exit_code")
	# blitzcc returns what the program returns.
	blitzcc(+q "${TESTS}/cli/fail.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "The failure of the program was not returned.")
	endif()
	# A program that doesn't compile is not run.
	file(WRITE "${WORK}/broken.bb" "Local a = \n")
	blitzcc("${WORK}/broken.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	expect_missing("Executing")

elseif(CASE STREQUAL "diagnostics")
	# Errors and warnings show the line and point at the column, also with -q (which only drops warnings).
	macro(expect_err TEXT)
		string(FIND "${ERR}" "${TEXT}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "Expected '${TEXT}' in the messages, got:\n${ERR}")
		endif()
	endmacro()

	# Lexer error, with a tab in front: the tab is kept so that the caret lines up.
	file(WRITE "${WORK}/lexer.bb" "Local a = 1\n\tLocal b = 2 @ 3\n")
	blitzcc(-q -c "${WORK}/lexer.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken program was accepted.")
	endif()
	expect_err("lexer.bb:2:14: error: ")
	expect_err("\n\tLocal b = 2 @ 3\n\t            ^---------- HERE")

	# Parser error at the end of a line.
	file(WRITE "${WORK}/parser.bb" "Local a = \n")
	blitzcc(-q -c "${WORK}/parser.bb")
	expect_err("\nLocal a = \n          ^---------- HERE")

	# Parser error at the end of the file, which has no line break.
	file(WRITE "${WORK}/eof.bb" "Local a = (1 +")
	blitzcc(-c "${WORK}/eof.bb")
	expect_err("\nLocal a = (1 +\n              ^---------- HERE")

	# Semantic error.
	file(WRITE "${WORK}/semantic.bb" "Print nofunc(1)\n")
	blitzcc(-c "${WORK}/semantic.bb")
	expect_err("\nPrint nofunc(1)\n      ^---------- HERE")

	# Warnings point at the expression, and don't fail the build.
	file(WRITE "${WORK}/warning.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(-c "${WORK}/warning.bb")
	expect_ok()
	expect_err("warning.bb:1:12: warning: ")
	expect_err("\nLocal i% = 2.5\n           ^---------- HERE")

	# Long lines are cut around the column.
	string(REPEAT "a" 300 _LONG)
	file(WRITE "${WORK}/long.bb" "Local ${_LONG} = 1 @\n")
	blitzcc(-c "${WORK}/long.bb")
	expect_err("\n...")
	string(FIND "${ERR}" "${_LONG}" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "The long line was not cut:\n${ERR}")
	endif()
	expect_err("^---------- HERE")

	# Paths have no "." or ".." parts, for the file on the command line and for included files.
	file(MAKE_DIRECTORY "${WORK}/sub/deeper")
	file(WRITE "${WORK}/sub/inc.bb" "Local a = 1 @\n")
	file(WRITE "${WORK}/sub/deeper/main.bb" "Include \"../inc.bb\"\n")
	blitzcc(-q -c "${WORK}/sub/deeper/../deeper/./main.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A broken include was accepted.")
	endif()
	string(FIND "${ERR}" ".." _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Expected a path without '..', got:\n${ERR}")
	endif()
	string(FIND "${ERR}" "/./" _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Expected a path without '.', got:\n${ERR}")
	endif()
	expect_err("/sub/inc.bb:1:13: error: ")
	expect_err("\nLocal a = 1 @\n            ^---------- HERE")
	# The same for a warning.
	file(WRITE "${WORK}/sub/warn.bb" "Local i% = 2.5\nPrint i\n")
	blitzcc(-c "${WORK}/sub/deeper/../warn.bb")
	expect_ok()
	expect_err("/sub/warn.bb:1:12: warning: ")
	string(FIND "${ERR}" ".." _AT)
	if(NOT _AT EQUAL -1)
		message(FATAL_ERROR "Expected a path without '..', got:\n${ERR}")
	endif()

	# Without a source file there is nothing to show, but the message stays.
	blitzcc(-c "${WORK}/missing.bb")
	if(RC EQUAL 0)
		message(FATAL_ERROR "A missing file was accepted.")
	endif()
	expect_err("error: ")

elseif(CASE STREQUAL "help")
	blitzcc(--help)
	expect_ok()
	foreach(_OPTION IN ITEMS "-q " "+q " "-c " "-d " "-k " "+k " "-v " "-o <file>" "--verbose" "--userlibs-dir")
		expect_contains("  ${_OPTION}")
	endforeach()

else()
	message(FATAL_ERROR "Unknown test case '${CASE}'.")
endif()
