; With BLITZLLVM_VRAM_LIMIT_MB set, textures without flag 256 fill the video memory. The buffers that order independent transparency needs for
; the window come first: the textures make room (they go to system memory) instead of the program stopping with "out of video memory".
Graphics 1024, 768, 0, 2
Local i
For i = 0 To 8
	CreateTexture(2048, 2048, 1)
Next
GraphicsOrderIndependentTransparency 1
Local cam = CreateCamera()
Local cube = CreateCube()
MoveEntity cube, 0, 0, 5
EntityAlpha cube, 0.5
RenderWorld
Flip
DebugLog "priority ok"
End
