; Texture streaming on every renderer: textures with mip maps that were loaded from a file lose their biggest levels under a small
; texture budget, get them back (in pieces) when textures are gone, and still read back as the file.
Graphics 320, 240, 0, 2
Local i, f, source, r
Dim t(4)
Dim c(4)

; The picture: green top left quarter, red elsewhere.
source = CreateTexture(2048, 2048, 1 + 4096)
SetBuffer TextureBuffer(source)
Color 200, 40, 90
Rect 0, 0, 2048, 2048, 1
Color 10, 220, 30
Rect 0, 0, 1024, 1024, 1
SaveBuffer TextureBuffer(source), "streaming_mips.bmp"
SetBuffer BackBuffer()
FreeTexture source
For f = 1 To 3
	Flip
Next

Local cam = CreateCamera()
MoveEntity cam, 0.0, 0.0, -12.0
For i = 0 To 4
	t(i) = LoadTexture("streaming_mips.bmp", 1 + 8)
	c(i) = CreateCube()
	ScaleEntity c(i), 0.8, 0.8, 0.8
	PositionEntity c(i), i * 2.2 - 4.4, 0, 0
	EntityTexture c(i), t(i)
Next
For f = 1 To 10
	RenderWorld
	Flip
Next

; Textures that are gone leave room, the ones that are left get their levels back (in pieces, a small budget per frame).
For i = 3 To 4
	FreeEntity c(i)
	FreeTexture t(i)
Next
For f = 1 To 120
	RenderWorld
	Flip
Next

For i = 0 To 2
	SetBuffer TextureBuffer(t(i))
	LockBuffer TextureBuffer(t(i))
	r = ReadPixel(10, 10) And $FFFFFF
	If r <> $0ADC1E Then RuntimeError "texture " + i + " lost its picture: " + Hex$(r)
	r = ReadPixel(1500, 1500) And $FFFFFF
	If r <> $C8285A Then RuntimeError "texture " + i + " lost its picture: " + Hex$(r)
	UnlockBuffer TextureBuffer(t(i))
Next
SetBuffer BackBuffer()
DeleteFile "streaming_mips.bmp"
DebugLog "streaming ok"
End
