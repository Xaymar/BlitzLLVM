; Default values of fields: the original never uses them, --field-defaults lets New set them.
Const START = 3
Global made = 0
Type Vec
	Field x#
End Type
Type Thing
	Field lives% = START
	Field speed# = 2.5, name$ = "n" + Str(START)
	Field plain%, pos.Vec = New Vec
	Field id% = NextId()
End Type
Function NextId()
	made = made + 1
	Return made
End Function
Function Make.Thing(START)
	Return New Thing ; START is the Const here, not the parameter.
End Function
t.Thing = New Thing
u.Thing = Make(9)
Print t\lives + " " + t\speed + " " + t\name + " " + t\plain + " " + (t\pos <> Null) + " " + t\id + " " + u\lives + " " + u\id
