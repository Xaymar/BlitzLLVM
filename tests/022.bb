; Collisions and picking, without a window. Stops with an error if anything is off.
Const T_PLAYER = 1, T_GROUND = 2, T_WALL = 3, T_BALL = 4

; Cubes are 2 x 2 x 2, so this one is 20 wide, 2 high and 20 deep, with its top at y = 0.
Local floor = CreateCube()
ScaleEntity floor, 10, 1, 10
PositionEntity floor, 0, -1, 0
EntityType floor, T_GROUND
EntityPickMode floor, 2

; A wall at x = 5, with its face at x = 4.
Local wall = CreateCube()
ScaleEntity wall, 1, 5, 10
PositionEntity wall, 5, 5, 0
EntityType wall, T_WALL
EntityPickMode wall, 2

Local player = CreatePivot()
EntityType player, T_PLAYER
EntityRadius player, 1
PositionEntity player, -4, 5, 0
ResetEntity player

Collisions T_PLAYER, T_GROUND, 2, 2
Collisions T_PLAYER, T_WALL, 2, 2
UpdateWorld

; Falling lands on the ground: the sphere rests with its middle one radius above it.
For i = 1 To 40
	TranslateEntity player, 0, -0.3, 0
	UpdateWorld
Next
Check "rests on the ground", EntityY(player), 1, 0.05
Check "collided with the ground", EntityCollided(player, T_GROUND), floor
Check "collisions", (CountCollisions(player) > 0), 1
Check "collision entity", CollisionEntity(player, 1), floor
Check "ground is level", CollisionNY(player, 1), 1, 0.05
Check "nothing else", EntityCollided(player, T_WALL), 0

; Running at the wall slides along it: x stops one radius in front of the face, z carries on.
For i = 1 To 40
	TranslateEntity player, 0.3, -0.1, 0.2
	UpdateWorld
Next
Check "stopped by the wall", EntityX(player), 3, 0.05
Check "slid along the wall", EntityZ(player), 8, 0.1
Check "hit the wall", EntityCollided(player, T_WALL), wall
wallhit = 0
For i = 1 To CountCollisions(player)
	If CollisionEntity(player, i) = wall Then wallhit = i
Next
Check "there is a collision with the wall", wallhit > 0, 1
Check "wall faces away", CollisionNX(player, wallhit), -1, 0.1

; Response 1 stops dead.
; A pair of types has one rule until ClearCollisions, so the rules are made again.
ClearCollisions
Collisions T_PLAYER, T_GROUND, 2, 2
Collisions T_PLAYER, T_WALL, 2, 1
PositionEntity player, 0, 1, 0
ResetEntity player
UpdateWorld
For i = 1 To 40
	TranslateEntity player, 0.3, 0, 0.2
	UpdateWorld
Next
Check "stopped, x", EntityX(player), 3, 0.05
Check "stopped, z", EntityZ(player), 2 * 0.2 * ((3 - 0) / 0.3) / 2, 1.5

; Sphere against sphere.
Local ball = CreatePivot()
EntityType ball, T_BALL
EntityRadius ball, 2
PositionEntity ball, 0, 1, -8
Collisions T_PLAYER, T_BALL, 1, 2
PositionEntity player, 0, 1, 0
ResetEntity player
UpdateWorld
For i = 1 To 40
	TranslateEntity player, 0, 0, -0.3
	UpdateWorld
Next
Check "stopped by the ball", EntityZ(player), -8 + 3, 0.1
Check "collided with the ball", EntityCollided(player, T_BALL), ball

; Terrain: it has to stop the player on a hill too.
Local land = CreateTerrain(16)
ScaleEntity land, 1, 4, 1
PositionEntity land, 20, 0, -8
For z = 0 To 16
	For x = 0 To 16
		ModifyTerrain land, x, z, 0.5
	Next
Next
EntityType land, T_GROUND
Local walker = CreatePivot()
EntityType walker, T_PLAYER
EntityRadius walker, 0.5
PositionEntity walker, 28, 5, 0
ResetEntity walker
UpdateWorld
For i = 1 To 40
	TranslateEntity walker, 0, -0.2, 0
	UpdateWorld
Next
Check "on the terrain", EntityY(walker), 2.5, 0.1

; Picking.
Check "line pick", LinePick(-4, 10, 0, 0, -20, 0), floor
Check "picked y", PickedY(), 0, 0.01
Check "picked normal", PickedNY(), 1, 0.01
Check "picked time", PickedTime(), 0.5, 0.01
Check "line pick that misses", LinePick(0, 10, 0, 0, 5, 0), 0
Check "nothing picked", PickedEntity(), 0
Local looker = CreatePivot()
PositionEntity looker, -8, 2, 0
RotateEntity looker, 0, -90, 0
Check "entity pick", EntityPick(looker, 30), wall
Check "entity pick too short", EntityPick(looker, 5), 0

; Looking through things.
Local seen = CreatePivot()
PositionEntity seen, 8, 2, 0
Check "wall in the way", EntityVisible(looker, seen), 0
EntityPickMode wall, 2, False
Check "see through", EntityVisible(looker, seen), 1

; Meshes that touch.
Local a = CreateCube()
Local b = CreateCube()
PositionEntity b, 1, 0, 0
Local c = CreateCube()
PositionEntity c, 5, 0, 0
Check "touching meshes", MeshesIntersect(a, b), 1
Check "separate meshes", MeshesIntersect(a, c), 0

Print "All collision tests passed."

Function Check(name$, got#, want#, tolerance# = 0.001)
	If Abs(got - want) > tolerance Then RuntimeError name + ": got " + got + ", expected " + want
End Function
