; Goto, Gosub and labels. Stops with an error if anything is off.
Global trace$ = ""

; Goto skips code, and can loop.
Local n = 0
.again
n = n + 1
If n < 5 Then Goto again
Check "goto loop", n, 5

Goto skipped
RuntimeError "Goto did not skip"
.skipped

; Gosub comes back to where it was called from.
Gosub first
Gosub second
CheckS "gosub order", trace, "a1 b1 b2 a2 b1 b2 "
Goto finished

.first
trace = trace + "a1 "
Gosub second_inner
trace = trace + "a2 "
Return

.second
trace = trace + "b1 b2 "
Return

.second_inner
trace = trace + "b1 "
trace = trace + "b2 "
Return

.finished
Check "in a function", Subroutines(), 21
Print "All Goto and Gosub tests passed."

; Gosub inside of a function has its own labels. Return with a value leaves the function.
Function Subroutines()
	Local total = 0
	Gosub add
	Gosub add
	Return total + 1

	.add
	total = total + 10
	Return
End Function

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function

Function CheckS(name$, got$, want$)
	If got <> want Then RuntimeError name + ": got '" + got + "', expected '" + want + "'"
End Function
