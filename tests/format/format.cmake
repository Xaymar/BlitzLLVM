################################################################################
# Tests for blitz-format, run as 'cmake -DCASE=<name> ... -P format.cmake'.
#
# Variables: FORMAT (blitz-format), BLITZCC (the compiler), TESTS (the tests directory), WORK (an empty directory to write to).
################################################################################
cmake_minimum_required(VERSION 3.20)
if(POLICY CMP0219)
	cmake_policy(SET CMP0219 NEW) # Macros keep backslashes in their arguments
endif()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# Run blitz-format in WORK, results are RC, OUT and ERR. Set INPUT to a file to read stdin from.
function(blitz_format)
	if(INPUT)
		set(_INPUT INPUT_FILE "${INPUT}")
	endif()
	execute_process(
		COMMAND "${FORMAT}" ${ARGN}
		WORKING_DIRECTORY "${WORK}"
		RESULT_VARIABLE _RC
		OUTPUT_FILE "${WORK}/stdout.txt"
		ERROR_VARIABLE _ERR
		${_INPUT}
	)
	# Read from a file, as the output variable would turn \r\n into \n. The bytes are compared as hex, since reading text
	# loses the \r as well.
	file(READ "${WORK}/stdout.txt" _OUT)
	file(READ "${WORK}/stdout.txt" _HEX HEX)
	set(OUT_HEX "${_HEX}" PARENT_SCOPE)
	set(RC "${_RC}" PARENT_SCOPE)
	set(OUT "${_OUT}" PARENT_SCOPE)
	set(ERR "${_ERR}" PARENT_SCOPE)
endfunction()

macro(expect_rc WANT)
	if(NOT RC EQUAL ${WANT})
		message(FATAL_ERROR "Expected exit code ${WANT}, got '${RC}'.\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
endmacro()

macro(expect_out WANT)
	string(HEX "${WANT}" _WANT_HEX)
	if(NOT OUT_HEX STREQUAL _WANT_HEX)
		message(FATAL_ERROR "Expected the output:\n${WANT}\n---- got:\n${OUT}\n---- stderr:\n${ERR}")
	endif()
endmacro()

# Write the text as it is (file(WRITE) adds no line break), format it from stdin with the arguments and expect the output.
function(expect_format SOURCE WANT)
	file(WRITE "${WORK}/in.bb" "${SOURCE}")
	set(INPUT "${WORK}/in.bb")
	blitz_format(${ARGN})
	expect_rc(0)
	expect_out("${WANT}")
	# The result is stable.
	file(WRITE "${WORK}/again.bb" "${WANT}")
	set(INPUT "${WORK}/again.bb")
	blitz_format(${ARGN})
	expect_rc(0)
	expect_out("${WANT}")
endfunction()

set(MESSY "${TESTS}/format/messy.bb")
set(EXPECTED "${TESTS}/format/messy.expected.bb")
file(READ "${EXPECTED}" EXPECTED_TEXT)

if(CASE STREQUAL "default")
	# The messy program comes out as the expected one, and that one doesn't change.
	blitz_format("${MESSY}")
	expect_rc(0)
	expect_out("${EXPECTED_TEXT}")
	blitz_format("${EXPECTED}")
	expect_rc(0)
	expect_out("${EXPECTED_TEXT}")

elseif(CASE STREQUAL "same_program")
	# Formatting must not change what the compiler makes of the program: The LLVM IR is the same.
	file(COPY "${MESSY}" DESTINATION "${WORK}/before")
	file(COPY "${EXPECTED}" DESTINATION "${WORK}/after")
	foreach(_DIR IN ITEMS before after)
		set(_FILE "${WORK}/${_DIR}/messy.bb")
		if(_DIR STREQUAL "after")
			set(_FILE "${WORK}/after/messy.expected.bb")
		endif()
		execute_process(COMMAND "${BLITZCC}" -q -S "${_FILE}" RESULT_VARIABLE _RC OUTPUT_VARIABLE _OUT ERROR_VARIABLE _ERR)
		if(NOT _RC EQUAL 0)
			message(FATAL_ERROR "Compiling the ${_DIR} program failed:\n${_OUT}${_ERR}")
		endif()
	endforeach()
	file(READ "${WORK}/before/messy.ll" _BEFORE)
	file(READ "${WORK}/after/messy.expected.ll" _AFTER)
	string(REPLACE "messy.expected" "messy" _AFTER "${_AFTER}")
	if(NOT _BEFORE STREQUAL _AFTER)
		message(FATAL_ERROR "The LLVM IR of the formatted program differs from the original.")
	endif()
	if(_BEFORE STREQUAL "")
		message(FATAL_ERROR "No IR was written.")
	endif()

elseif(CASE STREQUAL "check_diff")
	file(COPY "${MESSY}" DESTINATION "${WORK}")
	file(COPY "${EXPECTED}" DESTINATION "${WORK}")
	# --check lists what would change: exit 1 for the messy file, 0 for the formatted one.
	blitz_format(--check messy.bb messy.expected.bb)
	expect_rc(1)
	expect_out("messy.bb\n")
	blitz_format(--check messy.expected.bb)
	expect_rc(0)
	expect_out("")
	# --diff shows it.
	blitz_format(--diff messy.bb)
	expect_rc(1)
	if(NOT OUT MATCHES "^--- a/messy.bb\n\\+\\+\\+ b/messy.bb\n@@ ")
		message(FATAL_ERROR "Not a unified diff:\n${OUT}")
	endif()
	if(NOT OUT MATCHES "\n-Type  Point\n" OR NOT OUT MATCHES "\n\\+Type Point\n")
		message(FATAL_ERROR "The change is missing from the diff:\n${OUT}")
	endif()
	blitz_format(--diff messy.expected.bb)
	expect_rc(0)
	expect_out("")
	# Nothing was written.
	file(READ "${WORK}/messy.bb" _AFTER)
	file(READ "${MESSY}" _BEFORE)
	if(NOT _AFTER STREQUAL _BEFORE)
		message(FATAL_ERROR "--check or --diff changed the file.")
	endif()

elseif(CASE STREQUAL "in_place")
	file(COPY "${MESSY}" DESTINATION "${WORK}")
	file(COPY "${EXPECTED}" DESTINATION "${WORK}")
	blitz_format(-i messy.bb messy.expected.bb)
	expect_rc(0)
	expect_out("")
	file(READ "${WORK}/messy.bb" _TEXT)
	if(NOT _TEXT STREQUAL EXPECTED_TEXT)
		message(FATAL_ERROR "The file was not formatted:\n${_TEXT}")
	endif()
	blitz_format(-i)
	expect_rc(2)
	blitz_format(-i -)
	expect_rc(2)

elseif(CASE STREQUAL "stdin")
	set(INPUT "${MESSY}")
	blitz_format()
	expect_rc(0)
	expect_out("${EXPECTED_TEXT}")
	blitz_format(-)
	expect_rc(0)
	expect_out("${EXPECTED_TEXT}")
	blitz_format(--check)
	expect_rc(1)
	expect_out("<stdin>\n")
	blitz_format(--check --stdin-filepath=some/where.bb)
	expect_out("some/where.bb\n")

elseif(CASE STREQUAL "indent")
	set(SRC "Function F()\nIf a\nSelect a\nCase 1\nPrint 1\nEnd Select\nEndIf\nEnd Function\n")
	expect_format("${SRC}" "Function F()\n\tIf a\n\t\tSelect a\n\t\t\tCase 1\n\t\t\t\tPrint 1\n\t\tEnd Select\n\tEndIf\nEnd Function\n")
	expect_format("${SRC}" "Function F()\n  If a\n    Select a\n      Case 1\n        Print 1\n    End Select\n  EndIf\nEnd Function\n" --indent-style=space --indent-width=2)
	expect_format("${SRC}" "Function F()\n\tIf a\n\t\tSelect a\n\t\tCase 1\n\t\t\tPrint 1\n\t\tEnd Select\n\tEndIf\nEnd Function\n" --no-indent-case)
	# Single line forms don't indent, and neither does a closing keyword on the same line.
	expect_format("If a Then Print 1 Else Print 2\nFor i=1 To 2 : Print i : Next\nPrint 3\n" "If a Then Print 1 Else Print 2\nFor i = 1 To 2 : Print i : Next\nPrint 3\n")
	# Else If is ElseIf, and a block can be opened by a Then with a comment behind it.
	expect_format("If a Then ;c\nPrint 1\nElse If b Then\nPrint 2\nEnd If\n" "If a Then ;c\n\tPrint 1\nElse If b Then\n\tPrint 2\nEnd If\n")
	# Labels start in the first column, unless told otherwise.
	expect_format("Function F()\n.top\nGoto top\nEnd Function\n" "Function F()\n.top\n\tGoto top\nEnd Function\n")
	expect_format("Function F()\n.top\nGoto top\nEnd Function\n" "Function F()\n\t.top\n\tGoto top\nEnd Function\n" --indent-labels)
	# Unbalanced code doesn't go below the first column.
	expect_format("Next\nWend\nEndIf\nPrint 1\n" "Next\nWend\nEndIf\nPrint 1\n")

elseif(CASE STREQUAL "keywords")
	expect_format("IF a THEN print 1\nwhile a\nwend\nend if\n" "If a Then print 1\nWhile a\nWend\nEnd If\n")
	expect_format("if a then x=1\nWHILE b\nWEND\n" "if a then x = 1\nwhile b\nwend\n" --keyword-case=lower)
	expect_format("if a then x=1\nWhile b\nWend\n" "IF a THEN x = 1\nWHILE b\nWEND\n" --keyword-case=upper)
	expect_format("iF a tHeN x=1\n" "iF a tHeN x = 1\n" --keyword-case=preserve)
	# A field with the name of a keyword is a name.
	expect_format("p\\last=p\\First\n" "p\\last = p\\First\n")

elseif(CASE STREQUAL "spacing")
	expect_format("x=a+b*2-c^2\n" "x = a + b * 2 - c ^ 2\n")
	expect_format("x = a + b*2\n" "x=a+b*2\n" --operator-spacing=compact)
	expect_format("x=a+b*2\n" "x=a+b*2\n" --operator-spacing=preserve)
	expect_format("x = a<>b And c<=d Or e>=f\n" "x = a <> b And c <= d Or e >= f\n")
	expect_format("x=a<>b And c\n" "x=a<>b And c\n" --operator-spacing=compact)
	# Signs stay with their number, and Mod is a word.
	expect_format("x=-1+ -2 - -a\nPrint -1\ny=a Mod 2\nReturn -x\n" "x = -1 + -2 - -a\nPrint -1\ny = a Mod 2\nReturn -x\n")
	expect_format("Case -1,-2\nFor i=10 To 0 Step -1\n" "Case -1, -2\nFor i = 10 To 0 Step -1\n")
	expect_format("Print(a ,b ,c)\nPrint f( 1,2 )\nx = ( a+b )*c\n" "Print(a, b, c)\nPrint f(1, 2)\nx = (a + b) * c\n")
	expect_format("f(a,b)\n" "f(a,b)\n" --no-comma-space)
	expect_format("f(a,b)\nx = (a)\n" "f( a, b )\nx = ( a )\n" --paren-inner-space)
	expect_format("Print (1)\nf (2)\nIf(a) Then b\n" "Print(1)\nf(2)\nIf (a) Then b\n" --paren-space=never)
	expect_format("Print (1)\nf (2)\nIf(a) Then b\n" "Print (1)\nf (2)\nIf (a) Then b\n")
	expect_format("a=1:b=2 :c=3\n" "a = 1 : b = 2 : c = 3\n")
	expect_format("a=1 : b=2\n" "a = 1:b = 2\n" --separator-spacing=compact)
	# Fields and types have no spaces; names and numbers keep their text.
	expect_format("p . Foo = New Foo\np\\x = q \\ y\nLocal a.Foo, b# = $FF + 0x1F + .5\n" "p . Foo = New Foo\np\\x = q\\y\nLocal a.Foo, b# = $FF + 0x1F + .5\n")
	# Strings and comments are untouched.
	expect_format("Print \"a  ,  b\"+\"=>\" ;  keep   this  \n" "Print \"a  ,  b\" + \"=>\" ;  keep   this\n")
	# The other spellings of the comparisons stay.
	expect_format("If a=>b Then c\nIf a=<b Then c\nIf a><b Then c\n" "If a => b Then c\nIf a =< b Then c\nIf a >< b Then c\n")

elseif(CASE STREQUAL "comments")
	expect_format("x=1 ;one\ny=2    ;  two\n" "x = 1 ; one\ny = 2 ;  two\n" --comment-space)
	expect_format("x=1 ;one\ny=2    ;two\n" "x = 1 ;one\ny = 2 ;two\n")
	expect_format("x=1    ;two\n" "x = 1    ;two\n" --comment-gap=0)
	expect_format("x=1;two\n" "x = 1   ;two\n" --comment-gap=3)
	expect_format(";;; banner\n;---- x\n;text\n" ";;; banner\n;---- x\n; text\n" --comment-space)
	expect_format("Function F()\n; about\nPrint 1\n  ; indented\nEnd Function\n" "Function F()\n\t; about\n\tPrint 1\n\t; indented\nEnd Function\n")
	expect_format("a = 1   \t\n; c  \n" "a = 1\n; c\n")
	expect_format("a = 1   \n" "a = 1   \n" --no-trim-trailing-space)

elseif(CASE STREQUAL "blank_lines")
	expect_format("\n\n\na=1\n\n\n\n\nb=2\n\n\n" "a = 1\n\nb = 2\n")
	expect_format("a=1\n\n\n\nb=2\n" "a = 1\n\n\nb = 2\n" --max-blank-lines=2)
	expect_format("a=1\n\n\nb=2\n" "a = 1\nb = 2\n" --max-blank-lines=0)
	expect_format("a=1\n\n\n\n\n\nb=2\n" "a = 1\n\n\n\n\n\nb = 2\n" --max-blank-lines=-1)
	# Declarations are set apart, with the comments that belong to them.
	expect_format("a=1\n; about F\nFunction F()\nEnd Function\nb=2\nType T\nField x\nEnd Type\nFunction G()\nEnd Function\n" "a = 1\n\n; about F\nFunction F()\nEnd Function\n\nb = 2\n\nType T\n\tField x\nEnd Type\n\nFunction G()\nEnd Function\n")
	expect_format("a=1\nFunction F()\nEnd Function\nb=2\n" "a = 1\nFunction F()\nEnd Function\nb = 2\n" --blank-lines-around-declarations=0)
	expect_format("a=1\nFunction F()\nEnd Function\nb=2\n" "a = 1\n\n\nFunction F()\nEnd Function\n\n\nb = 2\n" --blank-lines-around-declarations=2 --max-blank-lines=2)
	# Nothing is added at the start or the end of the file.
	expect_format("Function F()\nEnd Function\n" "Function F()\nEnd Function\n")
	# A function inside another block (not valid, but not ours to judge) is not a declaration.
	expect_format("If a\nFunction F()\nEnd Function\nEndIf\n" "If a\n\tFunction F()\n\tEnd Function\nEndIf\n")

elseif(CASE STREQUAL "line_endings")
	# Auto keeps what the first line break is.
	expect_format("a=1\r\nb=2\r\n" "a = 1\r\nb = 2\r\n")
	expect_format("a=1\nb=2\r\n" "a = 1\nb = 2\n")
	expect_format("a=1\rb=2\r" "a = 1\rb = 2\r")
	expect_format("a=1\r\nb=2\r\n" "a = 1\nb = 2\n" --line-ending=lf)
	expect_format("a=1\nb=2\n" "a = 1\r\nb = 2\r\n" --line-ending=crlf)
	expect_format("a=1\nb=2\n" "a = 1\rb = 2\r" --line-ending=cr)
	expect_format("a=1" "a = 1\n")
	expect_format("a=1\n\n" "a = 1\n")
	expect_format("a=1" "a = 1" --no-final-newline)
	expect_format("" "")
	expect_format("\n\n" "")
	string(ASCII 239 187 191 BOM) # The UTF-8 byte order mark is kept
	expect_format("${BOM}a=1\n" "${BOM}a = 1\n")

elseif(CASE STREQUAL "config")
	# The nearest file wins, found from the directory of the file upwards; the command line wins over the file.
	file(MAKE_DIRECTORY "${WORK}/project/sub/deep" "${WORK}/project/other")
	file(WRITE "${WORK}/project/.blitz-format" "# the project style\nindent_style = space\nindent_width = 2\n")
	file(WRITE "${WORK}/project/sub/blitz-format.json" "{ \"indent-style\": \"tab\", \"keyword_case\": \"lower\" }\n")
	foreach(_DIR IN ITEMS project/other project/sub project/sub/deep)
		file(WRITE "${WORK}/${_DIR}/a.bb" "If a\nPRINT 1\nEndIf\n")
	endforeach()
	blitz_format(project/other/a.bb)
	expect_rc(0)
	expect_out("If a\n  PRINT 1\nEndIf\n")
	blitz_format(project/sub/a.bb)
	expect_out("if a\n\tPRINT 1\nendif\n")
	blitz_format(project/sub/deep/a.bb)
	expect_out("if a\n\tPRINT 1\nendif\n")
	blitz_format(--indent-style=space --indent-width=3 --keyword-case=capitalized project/sub/a.bb)
	expect_out("If a\n   PRINT 1\nEndIf\n")
	blitz_format(--no-config project/other/a.bb)
	expect_out("If a\n\tPRINT 1\nEndIf\n")
	blitz_format(--config=project/other/../.blitz-format project/sub/a.bb)
	expect_out("If a\n  PRINT 1\nEndIf\n")
	# The settings that are used.
	blitz_format(--print-config project/other/a.bb)
	expect_rc(0)
	if(NOT OUT MATCHES "indent_style = space\nindent_width = 2\n")
		message(FATAL_ERROR "Unexpected configuration:\n${OUT}")
	endif()

elseif(CASE STREQUAL "recursive")
	# -r takes every .bb, .b3d and .bp beneath a directory (in any case), and nothing else.
	file(MAKE_DIRECTORY "${WORK}/src/sub/deep")
	foreach(_FILE IN ITEMS a.bb sub/b.b3d sub/C.BP sub/deep/d.bb sub/e.txt f.bbx)
		file(WRITE "${WORK}/src/${_FILE}" "x=1\n")
	endforeach()
	blitz_format(src)
	expect_rc(2)
	if(NOT ERR MATCHES "is a directory")
		message(FATAL_ERROR "Expected a hint to use -r:\n${ERR}")
	endif()
	blitz_format(-r --check src)
	expect_rc(1)
	expect_out("src/a.bb\nsrc/sub/C.BP\nsrc/sub/b.b3d\nsrc/sub/deep/d.bb\n")
	blitz_format(--recursive -i -q src)
	expect_rc(0)
	foreach(_FILE IN ITEMS a.bb sub/b.b3d sub/C.BP sub/deep/d.bb)
		file(READ "${WORK}/src/${_FILE}" _TEXT)
		if(NOT _TEXT STREQUAL "x = 1\n")
			message(FATAL_ERROR "${_FILE} was not formatted.")
		endif()
	endforeach()
	foreach(_FILE IN ITEMS sub/e.txt f.bbx)
		file(READ "${WORK}/src/${_FILE}" _TEXT)
		if(NOT _TEXT STREQUAL "x=1\n")
			message(FATAL_ERROR "${_FILE} should not have been touched.")
		endif()
	endforeach()
	blitz_format(-r --check src)
	expect_rc(0)
	# Files given by name are formatted whatever their extension, and an empty directory is fine.
	blitz_format(-r --check src/sub/e.txt)
	expect_rc(1)
	file(MAKE_DIRECTORY "${WORK}/empty")
	blitz_format(-r --check empty)
	expect_rc(0)

elseif(CASE STREQUAL "symlinks")
	# -r rewrites the files it finds, so it leaves links alone: the file a link points to can be anywhere, and a repository that is not trusted
	# is where such a link comes from. A link that is named is followed, and -i changes the file and keeps the link.
	if(CMAKE_HOST_WIN32)
		return()
	endif()
	file(MAKE_DIRECTORY "${WORK}/src" "${WORK}/outside")
	file(WRITE "${WORK}/src/real.bb" "x=1\n")
	file(WRITE "${WORK}/outside/target.bb" "x=1\n")
	file(CREATE_LINK "${WORK}/outside/target.bb" "${WORK}/src/link.bb" SYMBOLIC)
	blitz_format(-r --check src)
	expect_rc(1)
	expect_out("src/real.bb\n")
	blitz_format(-r -i -q src)
	expect_rc(0)
	file(READ "${WORK}/outside/target.bb" _TEXT)
	if(NOT _TEXT STREQUAL "x=1\n")
		message(FATAL_ERROR "A file outside of the directory was rewritten through a link:\n${_TEXT}")
	endif()
	file(READ "${WORK}/src/real.bb" _TEXT)
	if(NOT _TEXT STREQUAL "x = 1\n")
		message(FATAL_ERROR "The file next to the link was not formatted:\n${_TEXT}")
	endif()
	blitz_format(-i -q src/link.bb)
	expect_rc(0)
	file(READ "${WORK}/outside/target.bb" _TEXT)
	if(NOT _TEXT STREQUAL "x = 1\n")
		message(FATAL_ERROR "A link that is named did not format the file:\n${_TEXT}")
	endif()
	if(NOT IS_SYMLINK "${WORK}/src/link.bb")
		message(FATAL_ERROR "The link was replaced by a file.")
	endif()

elseif(CASE STREQUAL "errors")
	file(WRITE "${WORK}/a.bb" "a=1\n")
	blitz_format(--no-such-setting=1 a.bb)
	expect_rc(2)
	blitz_format(--indent-width=0 a.bb)
	expect_rc(2)
	blitz_format(--keyword-case=sideways a.bb)
	expect_rc(2)
	if(NOT ERR MATCHES "keyword_case")
		message(FATAL_ERROR "The error should name the setting:\n${ERR}")
	endif()
	blitz_format(missing.bb)
	expect_rc(2)
	blitz_format(-z a.bb)
	expect_rc(2)
	file(WRITE "${WORK}/.blitz-format" "this is not a setting\n")
	blitz_format(a.bb)
	expect_rc(2)
	if(NOT ERR MATCHES ".blitz-format:1")
		message(FATAL_ERROR "The error should name the file and line:\n${ERR}")
	endif()
	# A bad file doesn't stop the others.
	file(REMOVE "${WORK}/.blitz-format")
	file(WRITE "${WORK}/b.bb" "b=2\n")
	blitz_format(missing.bb a.bb b.bb)
	expect_rc(2)
	expect_out("a = 1\nb = 2\n")

elseif(CASE STREQUAL "help")
	blitz_format(--help)
	expect_rc(0)
	foreach(_TEXT IN ITEMS "--check" "--diff" "--in-place" ".blitz-format" "blitz-format.json" "indent_style" "keyword_case" "operator_spacing" "line_ending")
		if(NOT OUT MATCHES "${_TEXT}")
			message(FATAL_ERROR "--help doesn't mention '${_TEXT}':\n${OUT}")
		endif()
	endforeach()
	blitz_format(--version)
	expect_rc(0)
	if(NOT OUT MATCHES "^blitz-format ${VERSION}")
		message(FATAL_ERROR "Unexpected version:\n${OUT}")
	endif()

elseif(CASE STREQUAL "language_keywords")
	# Every keyword of the language gets the spelling that blitzcc -k lists, whatever case it was written in.
	execute_process(COMMAND "${BLITZCC}" -k OUTPUT_VARIABLE _KEYWORDS RESULT_VARIABLE _RC)
	if(NOT _RC EQUAL 0)
		message(FATAL_ERROR "blitzcc -k failed.")
	endif()
	string(REPLACE "\n" ";" _LINES "${_KEYWORDS}")
	set(_COUNT 0)
	foreach(_WORD IN LISTS _LINES)
		# The language comes first and starts with a capital letter; the functions of the runtime are lower case.
		if(NOT _WORD MATCHES "^[A-Z]")
			break()
		endif()
		string(TOUPPER "${_WORD}" _UPPER)
		expect_format("${_UPPER}\n" "${_WORD}\n")
		math(EXPR _COUNT "${_COUNT} + 1")
	endforeach()
	if(_COUNT LESS 50)
		message(FATAL_ERROR "Only ${_COUNT} keywords were checked.")
	endif()

elseif(CASE STREQUAL "repository")
	# Every program of the repository formats to something that is stable, and is the same program.
	file(GLOB_RECURSE _PROGRAMS "${TESTS}/*.bb")
	set(_N 0)
	foreach(_PROGRAM IN LISTS _PROGRAMS)
		blitz_format("${_PROGRAM}")
		expect_rc(0)
		file(WRITE "${WORK}/once.bb" "${OUT}")
		set(_ONCE "${OUT}")
		blitz_format("${WORK}/once.bb")
		expect_rc(0)
		if(NOT OUT STREQUAL _ONCE)
			message(FATAL_ERROR "Formatting ${_PROGRAM} twice gives something different.")
		endif()
		math(EXPR _N "${_N} + 1")
	endforeach()
	if(_N LESS 50)
		message(FATAL_ERROR "Only ${_N} programs were found.")
	endif()

else()
	message(FATAL_ERROR "Unknown case '${CASE}'.")
endif()
