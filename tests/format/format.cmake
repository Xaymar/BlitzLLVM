################################################################################
# Tests for blitz-format, run as 'cmake -DCASE=<name> ... -P format.cmake'.
#
# Variables: FORMAT (blitz-format), BLITZCC (the compiler), TESTS (the tests directory), WORK (an empty directory to write to).
################################################################################
cmake_minimum_required(VERSION 3.20)

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# file(WRITE) writes text on Windows and turns each \n into \r\n, so the files that blitz-format reads are written through a process,
# whose output is saved byte for byte. The arguments are joined like those of file(WRITE); ARGV<n> keeps the ; of comments that ARGN
# would split on. The text goes on a command line, so keep it well below 32 KB.
function(write_bytes FILE)
	set(_TEXT "")
	if(ARGC GREATER 1)
		math(EXPR _LAST "${ARGC} - 1")
		foreach(_I RANGE 1 ${_LAST})
			string(APPEND _TEXT "${ARGV${_I}}")
		endforeach()
	endif()
	execute_process(COMMAND "${CMAKE_COMMAND}" -E echo_append "${_TEXT}" OUTPUT_FILE "${FILE}" RESULT_VARIABLE _RC)
	if(NOT _RC EQUAL 0)
		message(FATAL_ERROR "Writing ${FILE} failed: ${_RC}")
	endif()
endfunction()

# Run blitz-format in WORK, results are RC, OUT and ERR. Set INPUT to a file to read stdin from.
function(blitz_format)
	if(INPUT)
		set(_INPUT INPUT_FILE "${INPUT}")
	endif()
	execute_process(
		COMMAND "${FORMAT}" ${ARGN}
		WORKING_DIRECTORY "${WORK}"
		RESULT_VARIABLE _RC
		OUTPUT_FILE "${WORK}/stdout.txt"
		ERROR_VARIABLE _ERR
		${_INPUT}
	)
	# Read from a file, as the output variable would turn \r\n into \n. The bytes are compared as hex, since reading text
	# loses the \r as well.
	file(READ "${WORK}/stdout.txt" _OUT)
	file(READ "${WORK}/stdout.txt" _HEX HEX)
	set(OUT_HEX "${_HEX}" PARENT_SCOPE)
	set(RC "${_RC}" PARENT_SCOPE)
	set(OUT "${_OUT}" PARENT_SCOPE)
	set(ERR "${_ERR}" PARENT_SCOPE)
endfunction()

# Format a file through stdin, so that the file stays as it is: OUT is the formatted text. Files named on the command line are rewritten in place
# instead. The last argument is the file.
function(blitz_format_text)
	list(POP_BACK ARGN _FILE)
	set(INPUT "${_FILE}")
	blitz_format(${ARGN} "--stdin-filepath=${_FILE}")
	set(RC "${RC}" PARENT_SCOPE)
	set(OUT "${OUT}" PARENT_SCOPE)
	set(OUT_HEX "${OUT_HEX}" PARENT_SCOPE)
	set(ERR "${ERR}" PARENT_SCOPE)
endfunction()

# Functions, not macros: a macro pastes its arguments into its body as code, so a backslash or bracket in the expected text
# would be read as CMake syntax by CMake versions without policy CMP0219.
function(expect_rc WANT)
	if(NOT RC EQUAL ${WANT})
		message(FATAL_ERROR "Expected exit code ${WANT}, got '${RC}'.\nstdout: ${OUT}\nstderr: ${ERR}")
	endif()
endfunction()

function(expect_out WANT)
	string(HEX "${WANT}" _WANT_HEX)
	if(NOT OUT_HEX STREQUAL _WANT_HEX)
		message(FATAL_ERROR "Expected the output:\n${WANT}\n---- got:\n${OUT}\n---- hex of want:\n${_WANT_HEX}\n---- hex of got:\n${OUT_HEX}\n---- stderr:\n${ERR}")
	endif()
endfunction()

# Write the text as it is (write_bytes adds no line break), format it from stdin with the arguments and expect the output.
function(expect_format SOURCE WANT)
	write_bytes("${WORK}/in.bb" "${SOURCE}")
	set(INPUT "${WORK}/in.bb")
	blitz_format(${ARGN})
	expect_rc(0)
	expect_out("${WANT}")
	# The result is stable.
	write_bytes("${WORK}/again.bb" "${WANT}")
	set(INPUT "${WORK}/again.bb")
	blitz_format(${ARGN})
	expect_rc(0)
	expect_out("${WANT}")
endfunction()

set(MESSY "${TESTS}/format/messy.bb")
set(EXPECTED "${TESTS}/format/messy.expected.bb")
file(READ "${EXPECTED}" EXPECTED_TEXT)

if(CASE STREQUAL "default")
	# The messy program comes out as the expected one, and that one doesn't change.
	blitz_format_text("${MESSY}")
	expect_rc(0)
	expect_out("${EXPECTED_TEXT}")
	blitz_format_text("${EXPECTED}")
	expect_rc(0)
	expect_out("${EXPECTED_TEXT}")

elseif(CASE STREQUAL "same_program")
	# Formatting must not change what the compiler makes of the program: The LLVM IR is the same.
	file(COPY "${MESSY}" DESTINATION "${WORK}/before")
	file(COPY "${EXPECTED}" DESTINATION "${WORK}/after")
	foreach(_DIR IN ITEMS before after)
		set(_FILE "${WORK}/${_DIR}/messy.bb")
		if(_DIR STREQUAL "after")
			set(_FILE "${WORK}/after/messy.expected.bb")
		endif()
		execute_process(COMMAND "${BLITZCC}" -q -S "${_FILE}" RESULT_VARIABLE _RC OUTPUT_VARIABLE _OUT ERROR_VARIABLE _ERR)
		if(NOT _RC EQUAL 0)
			message(FATAL_ERROR "Compiling the ${_DIR} program failed:\n${_OUT}${_ERR}")
		endif()
	endforeach()
	file(READ "${WORK}/before/messy.ll" _BEFORE)
	file(READ "${WORK}/after/messy.expected.ll" _AFTER)
	string(REPLACE "messy.expected" "messy" _AFTER "${_AFTER}")
	if(NOT _BEFORE STREQUAL _AFTER)
		message(FATAL_ERROR "The LLVM IR of the formatted program differs from the original.")
	endif()
	if(_BEFORE STREQUAL "")
		message(FATAL_ERROR "No IR was written.")
	endif()

elseif(CASE STREQUAL "check_diff")
	file(COPY "${MESSY}" DESTINATION "${WORK}")
	file(COPY "${EXPECTED}" DESTINATION "${WORK}")
	# --check lists what would change: exit 1 for the messy file, 0 for the formatted one.
	blitz_format(--check messy.bb messy.expected.bb)
	expect_rc(1)
	expect_out("messy.bb\n")
	blitz_format(--check messy.expected.bb)
	expect_rc(0)
	expect_out("")
	# --diff shows it.
	blitz_format(--diff messy.bb)
	expect_rc(1)
	if(NOT OUT MATCHES "^--- a/messy.bb\n\\+\\+\\+ b/messy.bb\n@@ ")
		message(FATAL_ERROR "Not a unified diff:\n${OUT}")
	endif()
	if(NOT OUT MATCHES "\n-Type  Point\n" OR NOT OUT MATCHES "\n\\+Type Point\n")
		message(FATAL_ERROR "The change is missing from the diff:\n${OUT}")
	endif()
	blitz_format(--diff messy.expected.bb)
	expect_rc(0)
	expect_out("")
	# Nothing was written.
	file(READ "${WORK}/messy.bb" _AFTER)
	file(READ "${MESSY}" _BEFORE)
	if(NOT _AFTER STREQUAL _BEFORE)
		message(FATAL_ERROR "--check or --diff changed the file.")
	endif()

elseif(CASE STREQUAL "in_place")
	# Files are rewritten in place without any option, and the only output is the name of each file, one per line.
	file(COPY "${MESSY}" DESTINATION "${WORK}")
	file(COPY "${EXPECTED}" DESTINATION "${WORK}")
	blitz_format(messy.bb messy.expected.bb)
	expect_rc(0)
	expect_out("messy.bb\nmessy.expected.bb\n")
	if(NOT ERR STREQUAL "")
		message(FATAL_ERROR "Expected nothing on stderr, got:\n${ERR}")
	endif()
	file(READ "${WORK}/messy.bb" _TEXT)
	if(NOT _TEXT STREQUAL EXPECTED_TEXT)
		message(FATAL_ERROR "The file was not formatted:\n${_TEXT}")
	endif()
	# -q writes no names, and -i is accepted and changes nothing.
	file(COPY "${MESSY}" DESTINATION "${WORK}")
	blitz_format(-q messy.bb)
	expect_rc(0)
	expect_out("")
	file(READ "${WORK}/messy.bb" _TEXT)
	if(NOT _TEXT STREQUAL EXPECTED_TEXT)
		message(FATAL_ERROR "-q did not format the file:\n${_TEXT}")
	endif()
	file(COPY "${MESSY}" DESTINATION "${WORK}")
	blitz_format(-i messy.bb)
	expect_rc(0)
	expect_out("messy.bb\n")
	file(READ "${WORK}/messy.bb" _TEXT)
	if(NOT _TEXT STREQUAL EXPECTED_TEXT)
		message(FATAL_ERROR "-i did not format the file:\n${_TEXT}")
	endif()
	# -i alone is the standard input, like no option.
	set(INPUT "${MESSY}")
	blitz_format(-i)
	expect_rc(0)
	expect_out("${EXPECTED_TEXT}")

elseif(CASE STREQUAL "stdin")
	set(INPUT "${MESSY}")
	blitz_format()
	expect_rc(0)
	expect_out("${EXPECTED_TEXT}")
	blitz_format(-)
	expect_rc(0)
	expect_out("${EXPECTED_TEXT}")
	blitz_format(--check)
	expect_rc(1)
	expect_out("<stdin>\n")
	blitz_format(--check --stdin-filepath=some/where.bb)
	expect_out("some/where.bb\n")

elseif(CASE STREQUAL "indent")
	set(SRC "Function F()\nIf a\nSelect a\nCase 1\nPrint 1\nEnd Select\nEndIf\nEnd Function\n")
	expect_format("${SRC}" "Function F()\n\tIf a\n\t\tSelect a\n\t\t\tCase 1\n\t\t\t\tPrint 1\n\t\tEnd Select\n\tEndIf\nEnd Function\n")
	expect_format("${SRC}" "Function F()\n  If a\n    Select a\n      Case 1\n        Print 1\n    End Select\n  EndIf\nEnd Function\n" --indent-style=space --indent-width=2)
	expect_format("${SRC}" "Function F()\n\tIf a\n\t\tSelect a\n\t\tCase 1\n\t\t\tPrint 1\n\t\tEnd Select\n\tEndIf\nEnd Function\n" --no-indent-case)
	# Single line forms don't indent, and neither does a closing keyword on the same line.
	expect_format("If a Then Print 1 Else Print 2\nFor i=1 To 2 : Print i : Next\nPrint 3\n" "If a Then Print 1 Else Print 2\nFor i = 1 To 2 : Print i : Next\nPrint 3\n")
	# Else If is ElseIf, and a block can be opened by a Then with a comment behind it.
	expect_format("If a Then ;c\nPrint 1\nElse If b Then\nPrint 2\nEnd If\n" "If a Then ;c\n\tPrint 1\nElse If b Then\n\tPrint 2\nEnd If\n")
	# Labels start in the first column, unless told otherwise.
	expect_format("Function F()\n.top\nGoto top\nEnd Function\n" "Function F()\n.top\n\tGoto top\nEnd Function\n")
	expect_format("Function F()\n.top\nGoto top\nEnd Function\n" "Function F()\n\t.top\n\tGoto top\nEnd Function\n" --indent-labels)
	# EndSelect, EndFunction and EndIf are block ends like their two-word forms, and are written as they were.
	expect_format("function f()\nif a\nselect a\ncase 1\nprint 1\nendselect\nendif\nendfunction\ntype t\nfield a\nendtype\n" "Function f()\n\tIf a\n\t\tSelect a\n\t\t\tCase 1\n\t\t\t\tprint 1\n\t\tEndSelect\n\tEndIf\nEndFunction\n\nType t\n\tField a\nEndType\n")
	# Unbalanced code doesn't go below the first column.
	expect_format("Next\nWend\nEndIf\nPrint 1\n" "Next\nWend\nEndIf\nPrint 1\n")

elseif(CASE STREQUAL "keywords")
	expect_format("IF a THEN print 1\nwhile a\nwend\nend if\n" "If a Then print 1\nWhile a\nWend\nEnd If\n")
	expect_format("if a then x=1\nWHILE b\nWEND\n" "if a then x = 1\nwhile b\nwend\n" --keyword-case=lower)
	expect_format("if a then x=1\nWhile b\nWend\n" "IF a THEN x = 1\nWHILE b\nWEND\n" --keyword-case=upper)
	expect_format("iF a tHeN x=1\n" "iF a tHeN x = 1\n" --keyword-case=preserve)
	# A field with the name of a keyword is a name.
	expect_format("p\\last=p\\First\n" "p\\last = p\\First\n")

elseif(CASE STREQUAL "spacing")
	expect_format("x=a+b*2-c^2\n" "x = a + b * 2 - c ^ 2\n")
	expect_format("x = a + b*2\n" "x=a+b*2\n" --operator-spacing=compact)
	expect_format("x=a+b*2\n" "x=a+b*2\n" --operator-spacing=preserve)
	expect_format("x = a<>b And c<=d Or e>=f\n" "x = a <> b And c <= d Or e >= f\n")
	expect_format("x=a<>b And c\n" "x=a<>b And c\n" --operator-spacing=compact)
	# Signs stay with their number, and Mod is a word.
	expect_format("x=-1+ -2 - -a\nPrint -1\ny=a Mod 2\nReturn -x\n" "x = -1 + -2 - -a\nPrint -1\ny = a Mod 2\nReturn -x\n")
	expect_format("Case -1,-2\nFor i=10 To 0 Step -1\n" "Case -1, -2\nFor i = 10 To 0 Step -1\n")
	expect_format("Print(a ,b ,c)\nPrint f( 1,2 )\nx = ( a+b )*c\n" "Print(a, b, c)\nPrint f(1, 2)\nx = (a + b) * c\n")
	expect_format("f(a,b)\n" "f(a,b)\n" --no-comma-space)
	expect_format("f(a,b)\nx = (a)\n" "f( a, b )\nx = ( a )\n" --paren-inner-space)
	expect_format("Print (1)\nf (2)\nIf(a) Then b\n" "Print(1)\nf(2)\nIf (a) Then b\n" --paren-space=never)
	expect_format("Print (1)\nf (2)\nIf(a) Then b\n" "Print (1)\nf (2)\nIf (a) Then b\n")
	expect_format("a=1:b=2 :c=3\n" "a = 1 : b = 2 : c = 3\n")
	expect_format("a=1 : b=2\n" "a = 1:b = 2\n" --separator-spacing=compact)
	# Fields and types have no spaces; names and numbers keep their text.
	expect_format("p . Foo = New Foo\np\\x = q \\ y\nLocal a.Foo, b# = $FF + 0x1F + .5\n" "p . Foo = New Foo\np\\x = q\\y\nLocal a.Foo, b# = $FF + 0x1F + .5\n")
	# The : of a type touches the name and the type, and is not a statement separator.
	expect_format("Local a:Int32=1,b:Float\nFunction F:String(x:Int,y:Float32)\nEnd Function\n" "Local a:Int32 = 1, b:Float\n\nFunction F:String(x:Int, y:Float32)\nEnd Function\n")
	expect_format("a=1:b=2 : c:Int=3\n" "a = 1 : b = 2 : c:Int = 3\n")
	# Strings and comments are untouched.
	expect_format("Print \"a  ,  b\"+\"=>\" ;  keep   this  \n" "Print \"a  ,  b\" + \"=>\" ;  keep   this\n")
	# The other spellings of the comparisons stay.
	expect_format("If a=>b Then c\nIf a=<b Then c\nIf a><b Then c\n" "If a => b Then c\nIf a =< b Then c\nIf a >< b Then c\n")

elseif(CASE STREQUAL "comments")
	expect_format("x=1 ;one\ny=2    ;  two\n" "x = 1 ; one\ny = 2 ;  two\n" --comment-space)
	expect_format("x=1 ;one\ny=2    ;two\n" "x = 1 ;one\ny = 2 ;two\n")
	expect_format("x=1    ;two\n" "x = 1    ;two\n" --comment-gap=0)
	expect_format("x=1;two\n" "x = 1   ;two\n" --comment-gap=3)
	expect_format(";;; banner\n;---- x\n;text\n" ";;; banner\n;---- x\n; text\n" --comment-space)
	expect_format("Function F()\n; about\nPrint 1\n  ; indented\nEnd Function\n" "Function F()\n\t; about\n\tPrint 1\n\t; indented\nEnd Function\n")
	expect_format("a = 1   \t\n; c  \n" "a = 1\n; c\n")
	expect_format("a = 1   \n" "a = 1   \n" --no-trim-trailing-space)

elseif(CASE STREQUAL "blank_lines")
	expect_format("\n\n\na=1\n\n\n\n\nb=2\n\n\n" "a = 1\n\nb = 2\n")
	expect_format("a=1\n\n\n\nb=2\n" "a = 1\n\n\nb = 2\n" --max-blank-lines=2)
	expect_format("a=1\n\n\nb=2\n" "a = 1\nb = 2\n" --max-blank-lines=0)
	expect_format("a=1\n\n\n\n\n\nb=2\n" "a = 1\n\n\n\n\n\nb = 2\n" --max-blank-lines=-1)
	# Declarations are set apart, with the comments that belong to them.
	expect_format("a=1\n; about F\nFunction F()\nEnd Function\nb=2\nType T\nField x\nEnd Type\nFunction G()\nEnd Function\n" "a = 1\n\n; about F\nFunction F()\nEnd Function\n\nb = 2\n\nType T\n\tField x\nEnd Type\n\nFunction G()\nEnd Function\n")
	expect_format("a=1\nFunction F()\nEnd Function\nb=2\n" "a = 1\nFunction F()\nEnd Function\nb = 2\n" --blank-lines-around-declarations=0)
	expect_format("a=1\nFunction F()\nEnd Function\nb=2\n" "a = 1\n\n\nFunction F()\nEnd Function\n\n\nb = 2\n" --blank-lines-around-declarations=2 --max-blank-lines=2)
	# Nothing is added at the start or the end of the file.
	expect_format("Function F()\nEnd Function\n" "Function F()\nEnd Function\n")
	# A function inside another block (not valid, but not ours to judge) is not a declaration.
	expect_format("If a\nFunction F()\nEnd Function\nEndIf\n" "If a\n\tFunction F()\n\tEnd Function\nEndIf\n")

elseif(CASE STREQUAL "align")
	# Off by default.
	expect_format("a=1\nlonger=2\n" "a = 1\nlonger = 2\n")
	# Assignments on consecutive lines have their = in the same column. Fields and indexes are part of the target.
	expect_format("a=1\nlonger=2\nx\\y=3\nlist[1]=4\n" "a       = 1\nlonger  = 2\nx\\y     = 3\nlist[1] = 4\n" --align-assignments)
	# A blank line, a comment line, another indent or another kind of line ends a group.
	expect_format("a=1\n\nlonger=2\nb=1\n; text\nlonger=2\nPrint 1\nc=1\nlonger_name=2\n" "a = 1\n\nlonger = 2\nb      = 1\n; text\nlonger = 2\nPrint 1\nc           = 1\nlonger_name = 2\n" --align-assignments)
	expect_format("If x\na=1\nlonger=2\nEndIf\nb=1\n" "If x\n\ta      = 1\n\tlonger = 2\nEndIf\nb = 1\n" --align-assignments)
	# Lines with more than one assignment are left alone, and so are statements that only have an = in them.
	expect_format("a=1\nb=2 : c=3\nlonger=4\nIf d=1 Then e=2\nf=5\nlonger_name=6\n" "a = 1\nb = 2 : c = 3\nlonger = 4\nIf d = 1 Then e = 2\nf           = 5\nlonger_name = 6\n" --align-assignments)
	# A trailing comment stays behind the line.
	expect_format("a=1 ;one\nlonger=2 ;two\n" "a      = 1 ;one\nlonger = 2 ;two\n" --align-assignments)
	# Declarations: the names and the = line up (Dim has no =).
	expect_format("Const A=1\nLocal Longer:Int32=2\nGlobal b=3\nDim arr(5)\n" "Const  A            = 1
Local  Longer:Int32 = 2
Global b            = 3
Dim    arr(5)
" --align-declares)
	expect_format("Local a=1\nLocal b, c=2\nLocal longer=3\n" "Local a      = 1\nLocal b, c = 2\nLocal longer = 3\n" --align-declares)
	# Declarations and assignments are different groups.
	expect_format("Local a=1\nlonger=2\nLocal bbb=3\n" "Local a = 1\nlonger = 2\nLocal bbb = 3\n" --align-declares --align-assignments)
	# Data statements are lined up in columns.
	expect_format("Data 1,22,3\nData 100,2,3333\nData \"a\",5\nPrint 1\nData 1,2\n" "Data 1,   22, 3\nData 100, 2,  3333\nData \"a\", 5\nPrint 1\nData 1, 2\n" --align-data)
	expect_format("Data 1,22\nData 100,2\n" "Data 1, 22\nData 100, 2\n")
	expect_format("Data 1,22,3\nData 100,2,3333\n" "Data 1,   22, 3\nData 100, 2,  3333\n" --align-data=left)
	expect_format("Data 1,22,3\nData 100,2,3333\n" "Data 1,   22, 3\nData 100, 2,  3333\n" --align-data=true)
	expect_format("Data 1,22,3\nData 100,2,3333\n" "Data 1, 22, 3\nData 100, 2, 3333\n" --align-data=false)
	# Right aligned: the commas line up.
	expect_format("Data 1,22,3\nData 100,2,3333\nData \"a\",5\n" "Data   1, 22,    3\nData 100,  2, 3333\nData \"a\",  5\n" --align-data=right)
	# The settings are listed.
	blitz_format(--print-config --align-assignments --align-declares --align-data=right)
	expect_rc(0)
	if(NOT OUT MATCHES "align-assignments = true\nalign-declares = true\nalign-data = right\n")
		message(FATAL_ERROR "Unexpected configuration:\n${OUT}")
	endif()

elseif(CASE STREQUAL "wrap")
	# A line that is too long is broken after a : between statements, and only there.
	set(_LONG "Print \"aaaaaaaaaaaaaaaaaaaa\" : Print \"bbbbbbbbbbbbbbbbbbbb\" : Print \"cccccccccccccccccccc\"\n")
	expect_format("${_LONG}" "Print \"aaaaaaaaaaaaaaaaaaaa\"\nPrint \"bbbbbbbbbbbbbbbbbbbb\"\nPrint \"cccccccccccccccccccc\"\n" --wrap-after=40)
	# As much as fits stays on the line.
	expect_format("${_LONG}" "Print \"aaaaaaaaaaaaaaaaaaaa\" : Print \"bbbbbbbbbbbbbbbbbbbb\"\nPrint \"cccccccccccccccccccc\"\n" --wrap-after=60)
	# Short enough, or 0: nothing changes.
	expect_format("${_LONG}" "Print \"aaaaaaaaaaaaaaaaaaaa\" : Print \"bbbbbbbbbbbbbbbbbbbb\" : Print \"cccccccccccccccccccc\"\n")
	expect_format("${_LONG}" "Print \"aaaaaaaaaaaaaaaaaaaa\" : Print \"bbbbbbbbbbbbbbbbbbbb\" : Print \"cccccccccccccccccccc\"\n" --wrap-after=0)
	# The indent counts, a comment stays behind the last statement, and the lines are indented as the code is.
	expect_format("For i=1 To 2 : Print \"aaaaaaaaaaaaaaaaaaaa\" : Print \"bbbbbbbbbbbbbbbbbbbb\" : Next ;done\n" "For i = 1 To 2\n\tPrint \"aaaaaaaaaaaaaaaaaaaa\"\n\tPrint \"bbbbbbbbbbbbbbbbbbbb\"\nNext ;done\n" --wrap-after=40)
	# What follows an If on its line belongs to the If, so that line is never broken after the If. What is in front of it is.
	expect_format("If a Then Print \"aaaaaaaaaaaaaaaaaaaa\" : Print \"bbbbbbbbbbbbbbbbbbbb\"\n" "If a Then Print \"aaaaaaaaaaaaaaaaaaaa\" : Print \"bbbbbbbbbbbbbbbbbbbb\"\n" --wrap-after=30)
	expect_format("x=1 : If a Then Print \"aaaaaaaaaaaaaaaaaaaa\" : Print \"bbbbbbbbbbbbbbbbbbbb\"\n" "x = 1\nIf a Then Print \"aaaaaaaaaaaaaaaaaaaa\" : Print \"bbbbbbbbbbbbbbbbbbbb\"\n" --wrap-after=30)
	# A statement that is too long on its own can't be broken.
	expect_format("Print \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n" "Print \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n" --wrap-after=20)
	# Types keep their colon.
	expect_format("Local aaaaaaaaaaaa:Int32=1 : Local bbbbbbbbbbbb:Float=2\n" "Local aaaaaaaaaaaa:Int32 = 1\nLocal bbbbbbbbbbbb:Float = 2\n" --wrap-after=30)
	# The default is 120.
	blitz_format(--print-config)
	expect_rc(0)
	if(NOT OUT MATCHES "wrap-after = 120\n")
		message(FATAL_ERROR "Unexpected configuration:\n${OUT}")
	endif()
	blitz_format(--wrap-after=5000 --print-config)
	expect_rc(2)

elseif(CASE STREQUAL "split_if")
	# never leaves one-line Ifs alone. incompatible is the default.
	expect_format("If a Then Foo(1, 2) Else Bar()\n" "If a Then Foo(1, 2) Else Bar()\n" --split-one-line-if=never)
	expect_format("If a Then Foo(1, 2) Else Bar()\nIf a Then Foo(1) Else Bar()\n" "If a Then\n\tFoo(1, 2)\nElse\n\tBar()\nEndIf\nIf a Then Foo(1) Else Bar()\n")
	# incompatible splits the Ifs with a call in parentheses (no or more than one argument) right before Else, which the original rejects.
	expect_format("If a Then Foo(1, 2) Else Bar(3, 4) ;why\n" "If a Then ;why\n\tFoo(1, 2)\nElse\n\tBar(3, 4)\nEndIf\n" --split-one-line-if=incompatible)
	expect_format("If a Then Foo() Else Bar\n" "If a Then\n\tFoo()\nElse\n\tBar\nEndIf\n" --split-one-line-if=incompatible)
	expect_format("If a Then Foo(1) Else Bar(1, 2)\nIf a Then Foo 1, 2 Else Bar(1, 2)\nIf a Then Foo(1, 2)\n" "If a Then Foo(1) Else Bar(1, 2)\nIf a Then Foo 1, 2 Else Bar(1, 2)\nIf a Then Foo(1, 2)\n" --split-one-line-if=incompatible)
	expect_format("If a Then Foo 1 : Bar() Else Baz\n" "If a Then\n\tFoo 1 : Bar()\nElse\n\tBaz\nEndIf\n" --split-one-line-if=incompatible)
	# always splits every one-line If, also the ones inside. The first Else belongs to the inner If.
	expect_format("If a Then Print 1\n" "If a Then\n\tPrint 1\nEndIf\n" --split-one-line-if=always)
	expect_format("x = 1 : If a Then If b Then c() Else d() Else e()\n" "x = 1\nIf a Then\n\tIf b Then\n\t\tc()\n\tElse\n\t\td()\n\tEndIf\nElse\n\te()\nEndIf\n" --split-one-line-if=always)
	expect_format("If a Then If b Then c() Else d()\n" "If a Then\n\tIf b Then\n\t\tc()\n\tElse\n\t\td()\n\tEndIf\nEndIf\n" --split-one-line-if=always)
	expect_format("Local y:Int32 = 3 : If y > 2 Then Print \"big\" Else Print \"small\"\n" "Local y:Int32 = 3\nIf y > 2 Then\n\tPrint \"big\"\nElse\n\tPrint \"small\"\nEndIf\n" --split-one-line-if=always)
	# Left alone: block Ifs, an If without Then, and ElseIf or EndIf on the line.
	foreach(_SAME IN ITEMS "If a Then\n\tFoo(1, 2)\nEndIf\n" "If a Foo(1, 2) Else Bar()\n" "If a Then Foo(1, 2) ElseIf b Then Bar()\n" "If a Then Foo(1, 2) Else Bar() EndIf\n" "If a : Foo(1, 2) : EndIf\n")
		expect_format("${_SAME}" "${_SAME}" --split-one-line-if=always)
	endforeach()
	# Inside a block, with the indent of the block.
	expect_format("While a\nIf b Then Foo(1, 2) Else Bar()\nWend\n" "While a\n\tIf b Then\n\t\tFoo(1, 2)\n\tElse\n\t\tBar()\n\tEndIf\nWend\n" --split-one-line-if=incompatible)
	# The split program is the same program: the compiler makes the same of it, and it gives the same output.
	write_bytes("${WORK}/oneline.bb"
		"Function Pick(a%, b%)\n\tPrint a + b\nEnd Function\n"
		"Function Nothing()\n\tPrint \"n\"\nEnd Function\n"
		"Local c% = 1, d% = 0\n"
		"If c Then Pick(1, 2) Else Pick(3, 4)\n"
		"If d Then Pick 5, 6 : Nothing() Else Pick(7, 8)\n"
		"If c Then If d Then Pick(1, 2) Else Nothing() Else Pick(9, 9)\n"
		"If d Then If c Then Pick(1, 2) Else Nothing() Else Pick(9, 9)\n")
	foreach(_MODE IN ITEMS incompatible always)
		set(INPUT "${WORK}/oneline.bb")
		blitz_format(--split-one-line-if=${_MODE})
		expect_rc(0)
		write_bytes("${WORK}/oneline_${_MODE}.bb" "${OUT}")
	endforeach()
	foreach(_NAME IN ITEMS oneline oneline_incompatible oneline_always)
		execute_process(COMMAND "${BLITZCC}" -q "${WORK}/${_NAME}.bb" -o "${WORK}/${_NAME}${CMAKE_EXECUTABLE_SUFFIX}" RESULT_VARIABLE _RC OUTPUT_VARIABLE _OUT ERROR_VARIABLE _ERR)
		if(NOT _RC EQUAL 0)
			message(FATAL_ERROR "Compiling ${_NAME}.bb failed:\n${_OUT}${_ERR}")
		endif()
		execute_process(COMMAND "${WORK}/${_NAME}${CMAKE_EXECUTABLE_SUFFIX}" RESULT_VARIABLE _RC OUTPUT_VARIABLE _RUN_${_NAME} ERROR_VARIABLE _ERR)
	endforeach()
	if(NOT _RUN_oneline STREQUAL "3\n15\nn\n18\n" OR NOT _RUN_oneline_incompatible STREQUAL _RUN_oneline OR NOT _RUN_oneline_always STREQUAL _RUN_oneline)
		message(FATAL_ERROR "The split programs print something else:\n${_RUN_oneline}----\n${_RUN_oneline_incompatible}----\n${_RUN_oneline_always}")
	endif()
	# The setting is listed, and wrong values are refused.
	blitz_format(--print-config --split-one-line-if=incompatible)
	expect_rc(0)
	if(NOT OUT MATCHES "split-one-line-if = incompatible\n")
		message(FATAL_ERROR "Unexpected configuration:\n${OUT}")
	endif()
	blitz_format(--split-one-line-if=sometimes --print-config)
	expect_rc(2)

elseif(CASE STREQUAL "array_suffix")
	# A used Blitz array loses its type (the original rejects weights#[0]), the declarations and fields keep it. On by default.
	expect_format("Global weights#[5], other%[2]\nLocal names$[2], t.T, objs.T[3]\nweights#[0] = 1.5 : names$[1] = \"x\"\nLocal x# = weights#[1], y% = Max(other%[0], 1)\nIf x > 0 Then Print names$[1] Else Print objs.T[0] = Null\nt\\v#[1] = 2\n" "Global weights#[5], other%[2]\nLocal names$[2], t.T, objs.T[3]\nweights[0] = 1.5 : names[1] = \"x\"\nLocal x# = weights[1], y% = Max(other[0], 1)\nIf x > 0 Then Print names[1] Else Print objs[0] = Null\nt\\v#[1] = 2\n")
	expect_format("weights#[0] = 1.5\n" "weights#[0] = 1.5\n" --remove-array-suffix=false)
	# The program stays the same: it prints the same.
	write_bytes("${WORK}/arrays.bb"
		"Type Thing\n\tField v#[3]\nEnd Type\n"
		"Global weights#[5]\nLocal names$[2], t.Thing = New Thing, things.Thing[2]\n"
		"weights#[0] = 10.5 : weights#[1] = 35.25 : names$[1] = \"x\" : t\\v#[1] = 2.5 : things.Thing[1] = t\n"
		"Print weights#[0] + weights#[1] + t\\v#[1] + things.Thing[1]\\v#[1]\n"
		"Print names$[1]\n")
	set(INPUT "${WORK}/arrays.bb")
	blitz_format()
	expect_rc(0)
	write_bytes("${WORK}/arrays_formatted.bb" "${OUT}")
	if(OUT MATCHES "weights#\\[0" OR OUT MATCHES "names\\$\\[1" OR OUT MATCHES "things\\.Thing\\[1")
		message(FATAL_ERROR "A type is left behind a used array:\n${OUT}")
	endif()
	foreach(_NAME IN ITEMS arrays arrays_formatted)
		execute_process(COMMAND "${BLITZCC}" -q "${WORK}/${_NAME}.bb" -o "${WORK}/${_NAME}${CMAKE_EXECUTABLE_SUFFIX}" RESULT_VARIABLE _RC OUTPUT_VARIABLE _OUT ERROR_VARIABLE _ERR)
		if(NOT _RC EQUAL 0)
			message(FATAL_ERROR "Compiling ${_NAME}.bb failed:\n${_OUT}${_ERR}")
		endif()
		execute_process(COMMAND "${WORK}/${_NAME}${CMAKE_EXECUTABLE_SUFFIX}" OUTPUT_VARIABLE _RUN_${_NAME})
	endforeach()
	if(NOT _RUN_arrays STREQUAL "50.75\nx\n" OR NOT _RUN_arrays_formatted STREQUAL _RUN_arrays)
		message(FATAL_ERROR "The formatted program prints something else:\n${_RUN_arrays}----\n${_RUN_arrays_formatted}")
	endif()
	blitz_format(--print-config)
	expect_rc(0)
	if(NOT OUT MATCHES "remove-array-suffix = true\n")
		message(FATAL_ERROR "Unexpected configuration:\n${OUT}")
	endif()

elseif(CASE STREQUAL "line_endings")
	# Auto keeps what the first line break is.
	expect_format("a=1\r\nb=2\r\n" "a = 1\r\nb = 2\r\n")
	expect_format("a=1\nb=2\r\n" "a = 1\nb = 2\n")
	expect_format("a=1\rb=2\r" "a = 1\rb = 2\r")
	expect_format("a=1\r\nb=2\r\n" "a = 1\nb = 2\n" --line-ending=lf)
	expect_format("a=1\nb=2\n" "a = 1\r\nb = 2\r\n" --line-ending=crlf)
	expect_format("a=1\nb=2\n" "a = 1\rb = 2\r" --line-ending=cr)
	expect_format("a=1" "a = 1\n")
	expect_format("a=1\n\n" "a = 1\n")
	expect_format("a=1" "a = 1" --no-final-newline)
	expect_format("" "")
	expect_format("\n\n" "")
	string(ASCII 239 187 191 BOM) # The UTF-8 byte order mark is kept
	expect_format("${BOM}a=1\n" "${BOM}a = 1\n")

elseif(CASE STREQUAL "config")
	# The nearest file wins, found from the directory of the file upwards; the command line wins over the file.
	file(MAKE_DIRECTORY "${WORK}/project/sub/deep" "${WORK}/project/other")
	file(WRITE "${WORK}/project/.blitz-format" "# the project style\nindent_style = space\nindent_width = 2\n")
	file(WRITE "${WORK}/project/sub/blitz-format.json" "{ \"indent-style\": \"tab\", \"keyword_case\": \"lower\" }\n")
	foreach(_DIR IN ITEMS project/other project/sub project/sub/deep)
		write_bytes("${WORK}/${_DIR}/a.bb" "If a\nPRINT 1\nEndIf\n")
	endforeach()
	blitz_format_text(project/other/a.bb)
	expect_rc(0)
	expect_out("If a\n  PRINT 1\nEndIf\n")
	blitz_format_text(project/sub/a.bb)
	expect_out("if a\n\tPRINT 1\nendif\n")
	blitz_format_text(project/sub/deep/a.bb)
	expect_out("if a\n\tPRINT 1\nendif\n")
	blitz_format_text(--indent-style=space --indent-width=3 --keyword-case=capitalized project/sub/a.bb)
	expect_out("If a\n   PRINT 1\nEndIf\n")
	blitz_format_text(--no-config project/other/a.bb)
	expect_out("If a\n\tPRINT 1\nEndIf\n")
	blitz_format_text(--config=project/other/../.blitz-format project/sub/a.bb)
	expect_out("If a\n  PRINT 1\nEndIf\n")
	# The settings that are used.
	blitz_format(--print-config project/other/a.bb)
	expect_rc(0)
	if(NOT OUT MATCHES "indent-style = space\nindent-width = 2\n")
		message(FATAL_ERROR "Unexpected configuration:\n${OUT}")
	endif()

elseif(CASE STREQUAL "recursive")
	# -r takes every .bb beneath a directory (in any case), and nothing else: .b3d is a model format as well.
	file(MAKE_DIRECTORY "${WORK}/src/sub/deep")
	foreach(_FILE IN ITEMS a.bb sub/b.b3d sub/C.BB sub/deep/d.bb sub/e.txt f.bbx)
		file(WRITE "${WORK}/src/${_FILE}" "x=1\n")
	endforeach()
	blitz_format(src)
	expect_rc(2)
	if(NOT ERR MATCHES "is a directory")
		message(FATAL_ERROR "Expected a hint to use -r:\n${ERR}")
	endif()
	blitz_format(-r --check src)
	expect_rc(1)
	expect_out("src/a.bb\nsrc/sub/C.BB\nsrc/sub/deep/d.bb\n")
	blitz_format(--recursive src)
	expect_rc(0)
	expect_out("src/a.bb\nsrc/sub/C.BB\nsrc/sub/deep/d.bb\n")
	foreach(_FILE IN ITEMS a.bb sub/C.BB sub/deep/d.bb)
		file(READ "${WORK}/src/${_FILE}" _TEXT)
		if(NOT _TEXT STREQUAL "x = 1\n")
			message(FATAL_ERROR "${_FILE} was not formatted.")
		endif()
	endforeach()
	foreach(_FILE IN ITEMS sub/b.b3d sub/e.txt f.bbx)
		file(READ "${WORK}/src/${_FILE}" _TEXT)
		if(NOT _TEXT STREQUAL "x=1\n")
			message(FATAL_ERROR "${_FILE} should not have been touched.")
		endif()
	endforeach()
	blitz_format(-r --check src)
	expect_rc(0)
	# Files given by name are formatted whatever their extension, and an empty directory is fine.
	blitz_format(-r --check src/sub/e.txt)
	expect_rc(1)
	file(MAKE_DIRECTORY "${WORK}/empty")
	blitz_format(-r --check empty)
	expect_rc(0)

elseif(CASE STREQUAL "symlinks")
	# -r rewrites the files it finds, so it leaves links alone: the file a link points to can be anywhere, and a repository that is not trusted
	# is where such a link comes from. A link that is named is followed, and -i changes the file and keeps the link.
	if(CMAKE_HOST_WIN32)
		return()
	endif()
	file(MAKE_DIRECTORY "${WORK}/src" "${WORK}/outside")
	file(WRITE "${WORK}/src/real.bb" "x=1\n")
	file(WRITE "${WORK}/outside/target.bb" "x=1\n")
	file(CREATE_LINK "${WORK}/outside/target.bb" "${WORK}/src/link.bb" SYMBOLIC)
	blitz_format(-r --check src)
	expect_rc(1)
	expect_out("src/real.bb\n")
	blitz_format(-r -q src)
	expect_rc(0)
	file(READ "${WORK}/outside/target.bb" _TEXT)
	if(NOT _TEXT STREQUAL "x=1\n")
		message(FATAL_ERROR "A file outside of the directory was rewritten through a link:\n${_TEXT}")
	endif()
	file(READ "${WORK}/src/real.bb" _TEXT)
	if(NOT _TEXT STREQUAL "x = 1\n")
		message(FATAL_ERROR "The file next to the link was not formatted:\n${_TEXT}")
	endif()
	blitz_format(-q src/link.bb)
	expect_rc(0)
	file(READ "${WORK}/outside/target.bb" _TEXT)
	if(NOT _TEXT STREQUAL "x = 1\n")
		message(FATAL_ERROR "A link that is named did not format the file:\n${_TEXT}")
	endif()
	if(NOT IS_SYMLINK "${WORK}/src/link.bb")
		message(FATAL_ERROR "The link was replaced by a file.")
	endif()

elseif(CASE STREQUAL "in_place_atomic")
	# The new contents take the place of the file in one step, so nothing is left next to it, and what the file allowed stays as it was.
	if(CMAKE_HOST_WIN32)
		return()
	endif()
	file(MAKE_DIRECTORY "${WORK}/src")
	file(WRITE "${WORK}/src/a.bb" "x=1\n")
	file(CHMOD "${WORK}/src/a.bb" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ)
	blitz_format(-q src/a.bb)
	expect_rc(0)
	file(GLOB _FILES RELATIVE "${WORK}/src" LIST_DIRECTORIES true "${WORK}/src/*" "${WORK}/src/.*")
	list(SORT _FILES)
	if(NOT _FILES STREQUAL "a.bb")
		message(FATAL_ERROR "Only a.bb should be in the directory, found: ${_FILES}")
	endif()
	execute_process(COMMAND stat -c %a "${WORK}/src/a.bb" OUTPUT_VARIABLE _MODE OUTPUT_STRIP_TRAILING_WHITESPACE)
	if(NOT _MODE STREQUAL "640")
		message(FATAL_ERROR "The permissions of the file were 640 and are now ${_MODE}.")
	endif()
	file(READ "${WORK}/src/a.bb" _TEXT)
	if(NOT _TEXT STREQUAL "x = 1\n")
		message(FATAL_ERROR "The file was not formatted:\n${_TEXT}")
	endif()

elseif(CASE STREQUAL "errors")
	file(WRITE "${WORK}/a.bb" "a=1\n")
	blitz_format(--no-such-setting=1 a.bb)
	expect_rc(2)
	blitz_format(--indent-width=0 a.bb)
	expect_rc(2)
	blitz_format(--keyword-case=sideways a.bb)
	expect_rc(2)
	if(NOT ERR MATCHES "keyword-case")
		message(FATAL_ERROR "The error should name the setting:\n${ERR}")
	endif()
	blitz_format(missing.bb)
	expect_rc(2)
	blitz_format(-z a.bb)
	expect_rc(2)
	file(WRITE "${WORK}/.blitz-format" "this is not a setting\n")
	blitz_format(a.bb)
	expect_rc(2)
	if(NOT ERR MATCHES ".blitz-format:1")
		message(FATAL_ERROR "The error should name the file and line:\n${ERR}")
	endif()
	# A bad file doesn't stop the others.
	file(REMOVE "${WORK}/.blitz-format")
	file(WRITE "${WORK}/b.bb" "b=2\n")
	blitz_format(missing.bb a.bb b.bb)
	expect_rc(2)
	expect_out("a.bb\nb.bb\n")

elseif(CASE STREQUAL "help")
	blitz_format(--help)
	expect_rc(0)
	foreach(_TEXT IN ITEMS "--check" "--diff" "in place" ".blitz-format" "blitz-format.json" "indent-style" "keyword-case" "operator-spacing" "line-ending")
		if(NOT OUT MATCHES "${_TEXT}")
			message(FATAL_ERROR "--help doesn't mention '${_TEXT}':\n${OUT}")
		endif()
	endforeach()
	blitz_format(--version)
	expect_rc(0)
	if(NOT OUT MATCHES "^blitz-format ${VERSION}")
		message(FATAL_ERROR "Unexpected version:\n${OUT}")
	endif()

elseif(CASE STREQUAL "help_version_first")
	# Both answer before anything else is looked at: a bad option, a missing file or a broken configuration don't matter, and
	# nothing is written.
	file(WRITE "${WORK}/keep.bb" "a=1\n")
	blitz_format(--bogus-option --version missing.bb keep.bb)
	expect_rc(0)
	if(NOT OUT MATCHES "^blitz-format ${VERSION}")
		message(FATAL_ERROR "Unexpected output:\n${OUT}")
	endif()
	blitz_format(--check --config=missing.conf -h keep.bb)
	expect_rc(0)
	if(NOT OUT MATCHES "Usage")
		message(FATAL_ERROR "Unexpected output:\n${OUT}")
	endif()
	blitz_format(--version --help)
	expect_rc(0)
	if(NOT OUT MATCHES "^blitz-format ${VERSION}")
		message(FATAL_ERROR "Unexpected output:\n${OUT}")
	endif()
	blitz_format(-v --in-place keep.bb)
	expect_rc(0)
	file(READ "${WORK}/keep.bb" _KEPT)
	if(NOT _KEPT STREQUAL "a=1\n")
		message(FATAL_ERROR "The file was changed:\n${_KEPT}")
	endif()

elseif(CASE STREQUAL "language_keywords")
	# Every keyword of the language gets the spelling that blitzcc -k lists, whatever case it was written in.
	execute_process(COMMAND "${BLITZCC}" -k OUTPUT_VARIABLE _KEYWORDS RESULT_VARIABLE _RC)
	if(NOT _RC EQUAL 0)
		message(FATAL_ERROR "blitzcc -k failed.")
	endif()
	string(REPLACE "\n" ";" _LINES "${_KEYWORDS}")
	set(_COUNT 0)
	foreach(_WORD IN LISTS _LINES)
		# The language comes first and starts with a capital letter; the functions of the runtime are lower case.
		if(NOT _WORD MATCHES "^[A-Z]")
			break()
		endif()
		string(TOUPPER "${_WORD}" _UPPER)
		expect_format("${_UPPER}\n" "${_WORD}\n")
		math(EXPR _COUNT "${_COUNT} + 1")
	endforeach()
	if(_COUNT LESS 50)
		message(FATAL_ERROR "Only ${_COUNT} keywords were checked.")
	endif()

elseif(CASE STREQUAL "repository")
	# Every program of the repository formats to something that is stable, and is the same program.
	file(GLOB_RECURSE _PROGRAMS "${TESTS}/*.bb")
	set(_N 0)
	foreach(_PROGRAM IN LISTS _PROGRAMS)
		blitz_format_text("${_PROGRAM}")
		expect_rc(0)
		file(WRITE "${WORK}/once.bb" "${OUT}")
		set(_ONCE "${OUT}")
		blitz_format_text("${WORK}/once.bb")
		expect_rc(0)
		if(NOT OUT STREQUAL _ONCE)
			message(FATAL_ERROR "Formatting ${_PROGRAM} twice gives something different.")
		endif()
		math(EXPR _N "${_N} + 1")
	endforeach()
	if(_N LESS 50)
		message(FATAL_ERROR "Only ${_N} programs were found.")
	endif()

elseif(CASE STREQUAL "return_types")
	# The type of a function is written without spaces, Void as well, and the formatter never adds one.
	expect_format("Function Show:Void(a%)\nEnd Function\n" "Function Show:Void(a%)\nEnd Function\n" --line-ending=lf)
	expect_format("Function Show:Void( a% )\nEnd Function\n" "Function Show:Void(a%)\nEnd Function\n" --line-ending=lf)
	expect_format("Function Count:Int32()\n\tReturn 3\nEnd Function\n" "Function Count:Int32()\n\tReturn 3\nEnd Function\n" --line-ending=lf)
	expect_format("Function Show(a%)\nEnd Function\n" "Function Show(a%)\nEnd Function\n" --line-ending=lf)

else()
	message(FATAL_ERROR "Unknown case '${CASE}'.")
endif()
