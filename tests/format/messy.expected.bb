;A program in every style at once.
Type Point
	Field x#, y#
End Type

Global total% = 0 ; running total

Const LIMIT = 3
Dim grid(2, 2)

Function Add%(a%, b%)
	Return a + b
EndFunction

Function Sign%(n%)
	If n < 0 Then Return -1
	If n > 0 Then Return 1
	Return 0
End Function

Function Describe$(n%)
	If n = 1
		Return "one"
	ElseIf n = 2
		Return "two"
	Else
		Return "many"
	EndIf
End Function

.start
Local i%
For i = 1 To LIMIT : total = total + Add(i, i * 2) : Next
Local p.Point = New Point
p\x = 1.5 : p\y = -2.5
While total > 0
	total = total - 4
Wend
Select total
	Case -1, -2
		Print "negative"
	Default
		Print "other"
End Select
Repeat
	total = total + 1
Until total >= 2
Print Describe(2) + " " + Sign(-5)
Print (1 + 2) * 3
Print total : Print p\x
Delete p
Goto done
.done
