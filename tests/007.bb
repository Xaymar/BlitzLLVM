; 3D through Vulkan: lit shapes that turn, with 2D text on top. Runs for 5 seconds, or until Escape is pressed.
Graphics3D 640, 480, 32, 2
AppTitle "BlitzLLVM 3D Test"
SetBuffer BackBuffer()

Local camera = CreateCamera()
PositionEntity camera, 0, 1, -9
CameraClsColor camera, 20, 30, 60

Local sun = CreateLight()
RotateEntity sun, 45, 30, 0
AmbientLight 50, 50, 50

Local lamp = CreateLight(2)
PositionEntity lamp, 0, 3, -3
LightColor lamp, 255, 200, 100
LightRange lamp, 15

Local cube = CreateCube()
EntityColor cube, 255, 80, 80
PositionEntity cube, -4.5, 0, 0

Local sphere = CreateSphere(16)
EntityColor sphere, 80, 255, 80
PositionEntity sphere, -1.5, 0, 0

Local cone = CreateCone(16)
EntityColor cone, 80, 120, 255
PositionEntity cone, 1.5, 0, 0

Local cylinder = CreateCylinder(16)
EntityColor cylinder, 255, 220, 80
PositionEntity cylinder, 4.5, 0, 0

Local glass = CreateCube()
EntityColor glass, 255, 255, 255
EntityAlpha glass, 0.4
PositionEntity glass, 0, -2.5, -1
ScaleEntity glass, 3, 0.2, 1

Local frames = 0
While frames < 300
	TurnEntity cube, 0.5, 1, 0
	TurnEntity sphere, 0, 1, 0
	TurnEntity cone, 0, 1, 0.5
	TurnEntity cylinder, 1, 0.5, 0

	RenderWorld
	Color 255, 255, 255
	Text 10, 10, "Hello 3D from Vulkan! Frame " + frames

	Flip
	frames = frames + 1
	If KeyHit(1) Then Exit
Wend
