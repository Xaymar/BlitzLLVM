; Sound. Needs to be run from this directory. Without a sound device (or with BLITZ_HEADLESS) channels stay empty.
Local file$ = "stranded2\mods\Stranded II\sfx\bite.wav"

Local sound = LoadSound(file)
If sound = 0 Then RuntimeError "Could not load " + file
Check "missing file", LoadSound("does not exist.wav"), 0

SoundVolume sound, 0.2
SoundPan sound, -0.5
Local channel = PlaySound(sound)

If channel <> 0 Then
	; There is a sound device.
	Check "playing", ChannelPlaying(channel), 1
	ChannelVolume channel, 0.1
	ChannelPan channel, 0.5
	ChannelPitch channel, 22050
	For tries = 1 To 100
		If ChannelPlaying(channel) = 0 Then Exit
		Delay 50
	Next
	Check "stopped by itself", ChannelPlaying(channel), 0

	; Stopping early.
	Local loop = LoadSound(file)
	LoopSound loop
	channel = PlaySound(loop)
	Delay 100
	Check "loops", ChannelPlaying(channel), 1
	StopChannel channel
	Check "stopped", ChannelPlaying(channel), 0
	FreeSound loop
EndIf

; 3D sounds follow an entity, and get quieter when it is further away.
Local listener = CreatePivot()
CreateListener listener
Local source = CreatePivot()
PositionEntity source, 50, 0, 0
Local emitted = EmitSound(sound, source)
UpdateWorld
Delay 20
StopChannel emitted

FreeSound sound
Print "All sound tests passed."

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function
