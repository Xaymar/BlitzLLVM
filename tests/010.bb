; Arrays: Dim with up to 4 dimensions, and fixed size arrays. Stops with an error if anything is off.
Type Tthing
	Field id
End Type

Dim numbers(10)
Dim grid#(3, 4)
Dim names$(2)
Dim things.Tthing(2)
Dim cube(1, 2, 3)

Global global_list[5]
Local local_list[5]

For i = 0 To 10
	numbers(i) = i * i
Next
Check "Dim", numbers(7), 49
Check "Dim last", numbers(10), 100

For x = 0 To 3
	For y = 0 To 4
		grid(x, y) = x * 10 + y + 0.5
	Next
Next
Check "2D", grid(2, 3), 23.5
Check "2D corner", grid(3, 4), 34.5

names(0) = "zero" : names(2) = "two"
CheckS "strings", names(2) + names(0), "twozero"
CheckS "empty string", names(1), ""

things(1) = New Tthing
things(1)\id = 42
Check "objects", things(1)\id, 42
Check "null object", (things(0) = Null), 1

cube(1, 2, 3) = 99
cube(0, 0, 0) = 1
Check "3D", cube(1, 2, 3) + cube(0, 0, 0), 100

; Dimensioning again starts from scratch.
Dim numbers(3)
Check "redim", numbers(3), 0

; Fixed arrays.
For i = 0 To 5
	global_list[i] = i
	local_list[i] = i * 2
Next
Check "global array", global_list[5], 5
Check "local array", local_list[5], 10
Sum(local_list[1])

Print "All array tests passed."

Function Sum(a)
	Dim numbers(1)
	numbers(1) = a
	Check "function", numbers(1), 2
End Function

Function Check(name$, got#, want#)
	If Abs(got - want) > 0.001 Then RuntimeError name + ": got " + got + ", expected " + want
End Function

Function CheckS(name$, got$, want$)
	If got <> want Then RuntimeError name + ": got '" + got + "', expected '" + want + "'"
End Function
