; Records the order in which side effects of an expression happen. T(n) appends n to the log and returns n.
Global lg$ = ""
Type Pt
	Field x, y, z
	Field v[3]
End Type
Dim a(9, 9)
Dim b(9)

Function T(n)
	lg$ = lg$ + n + ","
	Return n
End Function
Function TF#(n)
	lg$ = lg$ + n + ","
	Return n
End Function
Function S$(n)
	lg$ = lg$ + n + ","
	Return "s" + n
End Function

Function F1(a) : Return a : End Function
Function F2(a, b) : Return a : End Function
Function F3(a, b, c) : Return a : End Function
Function F4(a, b, c, d) : Return a : End Function
Function F5(a, b, c, d, e) : Return a : End Function
Function F6(a, b, c, d, e, f) : Return a : End Function
Function F7(a, b, c, d, e, f, g) : Return a : End Function
Function F8(a, b, c, d, e, f, g, h) : Return a : End Function
Function F9(a, b, c, d, e, f, g, h, i) : Return a : End Function
Function F12(a, b, c, d, e, f, g, h, i, j, k, l) : Return a : End Function
Function F3F#(a#, b#, c#) : Return a : End Function
Function F3S$(a$, b$, c$) : Return a : End Function
Function F4M(a, b$, c#, d) : Return a : End Function
Function G3(a, b = 7, c = 8) : Return a : End Function

Global fh = WriteFile("order.txt")
Global r, rs$, rf#

Function Seen(name$)
	WriteLine fh, name$ + " " + lg$
	lg$ = ""
End Function

p.Pt = New Pt

; Plain argument lists
r = F1(T(1)) : Seen "F1"
r = F2(T(1), T(2)) : Seen "F2"
r = F3(T(1), T(2), T(3)) : Seen "F3"
r = F4(T(1), T(2), T(3), T(4)) : Seen "F4"
r = F5(T(1), T(2), T(3), T(4), T(5)) : Seen "F5"
r = F6(T(1), T(2), T(3), T(4), T(5), T(6)) : Seen "F6"
r = F7(T(1), T(2), T(3), T(4), T(5), T(6), T(7)) : Seen "F7"
r = F8(T(1), T(2), T(3), T(4), T(5), T(6), T(7), T(8)) : Seen "F8"
r = F9(T(1), T(2), T(3), T(4), T(5), T(6), T(7), T(8), T(9)) : Seen "F9"
r = F12(T(1), T(2), T(3), T(4), T(5), T(6), T(7), T(8), T(9), T(10), T(11), T(12)) : Seen "F12"
F3 T(1), T(2), T(3) : Seen "F3 statement"
F5 T(1), T(2), T(3), T(4), T(5) : Seen "F5 statement"

; Arguments that are not calls cost no registers
r = F3(T(1), 5, T(3)) : Seen "F3 constant middle"
r = F4(T(1), r, T(3), T(4)) : Seen "F4 variable second"
r = F4(r, T(2), T(3), r) : Seen "F4 variables outside"

; Nested calls
r = F3(T(1), F3(T(2), T(3), T(4)), T(5)) : Seen "F3 nested middle"
r = F3(F3(T(1), T(2), T(3)), T(4), T(5)) : Seen "F3 nested first"
r = F3(T(1), T(2), F3(T(3), T(4), T(5))) : Seen "F3 nested last"
r = F2(F2(T(1), T(2)), F2(T(3), T(4))) : Seen "F2 nested both"
r = F4(F2(T(1), T(2)), F2(T(3), T(4)), F2(T(5), T(6)), F2(T(7), T(8))) : Seen "F4 nested all"

; Arguments that are expressions
r = F3(T(1) + T(2) * T(3), T(4), T(5)) : Seen "F3 expression first"
r = F3(T(1), T(2) + T(3) * T(4), T(5)) : Seen "F3 expression middle"
r = F3(T(1), T(2), T(3) + T(4) * T(5)) : Seen "F3 expression last"
r = F4(T(1), T(2) + T(3) * T(4), T(5), T(6)) : Seen "F4 expression second"
r = F2(T(1) * T(2) + T(3), T(4)) : Seen "F2 expression left"
r = F2(T(1), T(2) + T(3) * T(4)) : Seen "F2 expression right"

; Operators
r = T(1) + T(2) : Seen "add"
r = T(1) + T(2) * T(3) : Seen "add mul right"
r = T(1) * T(2) + T(3) : Seen "mul add"
r = T(1) + T(2) + T(3) : Seen "add add"
r = T(1) - (T(2) - T(3)) : Seen "sub paren"
r = (T(1) + T(2)) * (T(3) + T(4)) : Seen "paren paren"
r = T(1) + (T(2) + T(3) * T(4)) : Seen "add deep right"
r = T(1) + T(2) * T(3) * T(4) : Seen "add mul mul"
r = T(1) + 5 : Seen "add constant"
r = 5 + T(1) * T(2) : Seen "constant add mul"
r = T(1) / T(2) : Seen "div"
r = T(1) / T(2) + T(3) * T(4) : Seen "div add mul"
r = T(1) Mod T(2) : Seen "mod"
r = T(1) Mod T(2) + T(3) * T(4) : Seen "mod add mul"
r = T(1) And T(2) : Seen "and"
r = T(1) Or T(2) And T(3) : Seen "or and"
r = T(1) Shl T(2) : Seen "shl"
r = T(1) Shl T(2) + T(3) * T(4) : Seen "shl add mul"
r = T(1) < T(2) : Seen "less"
r = T(1) + T(2) < T(3) * T(4) : Seen "less add mul"
r = T(1) = T(2) + T(3) * T(4) : Seen "equal add mul"
r = -T(1) + T(2) * T(3) : Seen "neg"
r = Abs(T(1)) + T(2) * T(3) : Seen "abs"
r = Not T(1) : Seen "not"

; Floats
rf# = TF(1) + TF(2) : Seen "float add"
rf# = TF(1) + TF(2) * TF(3) : Seen "float add mul"
rf# = TF(1) * TF(2) + TF(3) : Seen "float mul add"
rf# = TF(1) + TF(2) * TF(3) * TF(4) : Seen "float add mul mul"
rf# = TF(1) / TF(2) : Seen "float div"
rf# = TF(1) ^ TF(2) : Seen "float pow"
rf# = TF(1) Mod TF(2) : Seen "float mod"
r = TF(1) < TF(2) : Seen "float less"
r = TF(1) + TF(2) < TF(3) * TF(4) : Seen "float less add mul"
rf# = TF(1) + T(2) * TF(3) : Seen "mixed add mul"
rf# = F3F(TF(1), TF(2), TF(3)) : Seen "float args"
rf# = F3F(TF(1), TF(2) + TF(3), TF(4)) : Seen "float args expression"
r = F4M(T(1), S(2), TF(3), T(4)) : Seen "mixed args"
r = F4M(T(1), S(2) + S(3), TF(4) + TF(5), T(6)) : Seen "mixed args expressions"

; Strings
rs$ = S(1) + S(2) : Seen "concat"
rs$ = S(1) + S(2) + S(3) : Seen "concat concat"
rs$ = S(1) + (S(2) + S(3)) : Seen "concat paren"
rs$ = S(1) + Str(T(2) + T(3) * T(4)) : Seen "concat expression"
rs$ = "x" + S(1) + "y" + S(2) : Seen "concat constants"
r = S(1) < S(2) : Seen "string less"
r = S(1) = S(2) + S(3) : Seen "string equal concat"
rs$ = F3S(S(1), S(2), S(3)) : Seen "string args"
rs$ = F3S(S(1), S(2) + S(3), S(4)) : Seen "string args concat"
rs$ = Mid(S(1), T(2), T(3)) : Seen "Mid"
rs$ = Left(S(1), T(2)) : Seen "Left"
r = Instr(S(1), S(2), T(3)) : Seen "Instr"
rs$ = Replace(S(1), S(2), S(3)) : Seen "Replace"
rs$ = Mid(S(1) + S(2), T(3) + T(4) * T(5), T(6)) : Seen "Mid expressions"
rs$ = Str(T(1)) + Str(T(2)) : Seen "Str Str"
rs$ = String(S(1), T(2)) : Seen "String"

; Optional parameters
r = G3(T(1)) : Seen "G3 one"
r = G3(T(1), T(2)) : Seen "G3 two"
r = G3(T(1), T(2), T(3)) : Seen "G3 three"

; Arrays
a(T(1), T(2)) = T(3) : Seen "Dim store"
r = a(T(1), T(2)) : Seen "Dim load"
r = a(T(1), T(2)) + a(T(3), T(4)) : Seen "Dim load load"
a(T(1) + T(2) * T(3), T(4)) = T(5) : Seen "Dim store expression"
b(T(1)) = T(2) : Seen "Dim1 store"
b(T(1)) = T(2) + T(3) * T(4) : Seen "Dim1 store expression"
b(T(1) + T(2) * T(3)) = T(4) : Seen "Dim1 store index expression"
r = b(T(1)) + b(T(2)) * b(T(3)) : Seen "Dim1 add mul"
p\v[T(1)] = T(2) : Seen "Vector store"
r = p\v[T(1)] : Seen "Vector load"
p\x = T(1) : Seen "Field store"
p\x = T(1) + T(2) * T(3) : Seen "Field store expression"
r = F3(p\x, T(1), p\y) : Seen "Field args"
r = F3(T(1), p\x + T(2) * T(3), p\z) : Seen "Field args expression"
r = F3(a(T(1), T(2)), a(T(3), T(4)), a(T(5), T(6))) : Seen "Dim args"

; Statements
For i = T(1) To T(2) : Exit : Next : Seen "For"
For i = T(1) + T(2) * T(3) To T(4) + T(5) * T(6) : Exit : Next : Seen "For expressions"
If T(1) < T(2) Then r = 1
Seen "If"
Select T(1)
	Case T(2), T(3), T(4)
End Select
Seen "Select"


Dim d(T(1) + T(2) * T(3), T(4))
Seen "Dim expressions"
While T(1) < T(2) : Exit : Wend : Seen "While"
Repeat : Until T(1) < T(2) : Seen "Repeat"
Function Ret(): Return T(1) + T(2) * T(3) : End Function
r = Ret() : Seen "Return"

CloseFile fh
End
