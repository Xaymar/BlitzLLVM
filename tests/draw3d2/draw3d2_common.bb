; Shared by the Draw3D2 tests (tests/suite/draw3d2_*_pixels.bb), which run unchanged under the original Blitz3D 1.118 and BlitzLLVM:
; nothing here may use a command that only BlitzLLVM has. A scene is drawn at 1:1 (one unit is one pixel, 0,0 is the middle), and
; D3DFinish then either saves the picture (capture, see below) or compares it with the one that the original Blitz3D drew.
;
; The metric: a pixel matches when its red, green and blue are each at most D3D_TOLERANCE away from the reference (16 of 255, which
; covers the small differences of texture filtering and rounding between two renderers but not a wrong color, position or alpha).
; Only pixels that are not the clear color in the reference or in the picture count (the empty background would make every scene
; look 80% right), so the score of a scene is the percentage of those pixels that match, and has to be at least D3D_THRESHOLD (95).
;
; Capture (done once, with the original compiler, on a real machine): set D3D2_CAPTURE to a folder and the picture of every scene
; is saved there as <scene>.bmp (tools/draw3d2_references.py turns these into tests/draw3d2/reference/<scene>.png).
; Setting D3D2_ACTUAL to a folder makes a test save what it drew there (as <scene>.bmp) even when it compares.
Include "../draw3d2/userlibs/Draw3D2.bb"

Const D3D_W = 320, D3D_H = 240
Const D3D_TOLERANCE = 16
Const D3D_THRESHOLD# = 95.0

Global d3d_camera
Global d3d_white, d3d_sprite
Global d3d_checks

; A window (never fullscreen), a camera that looks at the middle at the distance Draw3D2 wants, and the white and sprite images.
Function D3DSetup()
	Graphics3D D3D_W, D3D_H, 0, 2
	SetBuffer BackBuffer()
	d3d_camera = CreateCamera()
	CameraClsColor d3d_camera, 40, 40, 60
	DrawInit3D d3d_camera
	d3d_white = LoadImage3D("../draw3d2/images/white.png")
	d3d_sprite = LoadImage3D("../draw3d2/images/sprite.png")
End Function

; Renders what the scene drew and compares (or captures) it.
Function D3DFinish(scene$)
	RenderWorld
	Local capture$ = GetEnv$("D3D2_CAPTURE")
	Local actual$ = GetEnv$("D3D2_ACTUAL")
	If capture$ <> "" Then
		SaveBuffer BackBuffer(), capture$ + "/" + scene$ + ".bmp"
		Print scene$ + ": captured."
		Return
	EndIf
	If actual$ <> "" Then SaveBuffer BackBuffer(), actual$ + "/" + scene$ + ".bmp"
	Local file$ = "../draw3d2/reference/" + scene$ + ".png"
	If FileType(file$) <> 1 Then RuntimeError scene$ + ": there is no reference " + file$
	Local ref = LoadImage(file$)
	If ref = 0 Then RuntimeError scene$ + ": cannot load " + file$
	If ImageWidth(ref) <> D3D_W Or ImageHeight(ref) <> D3D_H Then RuntimeError scene$ + ": reference is " + ImageWidth(ref) + "x" + ImageHeight(ref)
	Local rb = ImageBuffer(ref)
	Local x, y, a, b, same, total
	Local clear = (40 Shl 16) Or (40 Shl 8) Or 60
	LockBuffer BackBuffer()
	LockBuffer rb
	For y = 0 To D3D_H - 1
		For x = 0 To D3D_W - 1
			a = ReadPixelFast(x, y, BackBuffer())
			b = ReadPixelFast(x, y, rb)
			If (a And $FFFFFF) <> clear Or (b And $FFFFFF) <> clear Then
				total = total + 1
				If Abs(((a Shr 16) And 255) - ((b Shr 16) And 255)) <= D3D_TOLERANCE And Abs(((a Shr 8) And 255) - ((b Shr 8) And 255)) <= D3D_TOLERANCE And Abs((a And 255) - (b And 255)) <= D3D_TOLERANCE Then same = same + 1
			EndIf
		Next
	Next
	UnlockBuffer rb
	UnlockBuffer BackBuffer()
	Local score# = same * 100.0 / (total + (total = 0))
	Print scene$ + ": " + score + "% of the pixels match the original (needs " + D3D_THRESHOLD + "%)"
	d3d_checks = d3d_checks + 1
	If score < D3D_THRESHOLD Then RuntimeError scene$ + ": only " + score + "% of the pixels match the original"
End Function
