; The program itself: MilliSecs Delay CommandLine$ SystemProperty$ GetEnv$ SetEnv ExecFile AppTitle DebugLog RuntimeStats
; CreateTimer FreeTimer WaitTimer TimerTicks ResetTimer PauseTimer ResumeTimer PeekEvent WaitEvent EventID EventData EventX
; EventY EventZ EventSource FlushEvents HotKeyEvent Notify Confirm Proceed CreateProcess ActiveObjects DebugObjects
; QueryObject. RuntimeError has a test
; of its own in fail/, because it ends the program.
Include "check.bb"

; MilliSecs only goes forward, and Delay waits at least as long as asked.
start = MilliSecs()
CheckTrue "MilliSecs is positive", start >= 0
Delay 60
elapsed = MilliSecs() - start
CheckTrue "Delay waits (" + elapsed + " ms)", elapsed >= 55
CheckTrue "Delay does not wait much longer (" + elapsed + " ms)", elapsed < 1000
Delay 0
Delay 1
CheckTrue "MilliSecs goes on", MilliSecs() >= start + elapsed

; The command line is a string, which is empty when the program is started without arguments.
command$ = CommandLine$()
CheckTrue "CommandLine$ is a string", Len(command) >= 0

; Some of the properties of the system are paths.
CheckTrue "SystemProperty$ tempdir", Len(SystemProperty$("tempdir")) > 0
CheckTrue "SystemProperty$ appdir", Len(SystemProperty$("appdir")) > 0
CheckTrue "SystemProperty$ windowsdir", Len(SystemProperty$("windowsdir")) > 0
CheckTrue "SystemProperty$ systemdir", Len(SystemProperty$("systemdir")) > 0

; appdir is where the program is, not where it was started from, and ends with a separator.
appdir$ = SystemProperty$("appdir")
CheckTrue "appdir ends with a separator", Right$(appdir, 1) = "/" Or Right$(appdir, 1) = "\"
program$ = GetEnv$("BLITZ_SUITE_PROGRAM")
If Len(program) > 0
	; The test is started from tests/suite, the program is in the build folder.
	slash = 0
	For i = 1 To Len(program)
		If Mid$(program, i, 1) = "/" Or Mid$(program, i, 1) = "\" Then slash = i
	Next
	CheckS "appdir is the folder of the program", Lower$(appdir), Lower$(Left$(program, slash))
EndIf
CheckS "SystemProperty$ unknown", SystemProperty$("this property does not exist"), ""

; Environment variables
CheckS "GetEnv$ without it", GetEnv$("BLITZ_SUITE_UNSET_VARIABLE"), ""
SetEnv "BLITZ_SUITE_VARIABLE", "some value"
CheckS "SetEnv", GetEnv$("BLITZ_SUITE_VARIABLE"), "some value"
SetEnv "BLITZ_SUITE_VARIABLE", "changed"
CheckS "SetEnv again", GetEnv$("BLITZ_SUITE_VARIABLE"), "changed"
CheckTrue "GetEnv$ of what the system has", Len(GetEnv$("PATH")) > 0

; ExecFile starts a program and tells whether that worked.
CheckFalse "ExecFile of something that is not there", ExecFile("suite_does_not_exist.exe")

; Stop does nothing without a debugger.
Stop
suite_checks = suite_checks + 1

; These do not give anything back, so all that can be checked is that they work.
AppTitle "BlitzLLVM suite"
AppTitle "BlitzLLVM suite", "Really quit?"
DebugLog "DebugLog works"
DebugLog ""
suite_checks = suite_checks + 3

; Timers tick at their frequency, and WaitTimer says how many ticks went by since it was last asked.
timer = CreateTimer(50)
CheckTrue "CreateTimer", timer <> 0
start = MilliSecs()
total = 0
For i = 1 To 10
	n = WaitTimer(timer)
	CheckTrue "WaitTimer gives at least one tick", n >= 1
	total = total + n
Next
elapsed = MilliSecs() - start
CheckTrue "WaitTimer waited (" + elapsed + " ms)", elapsed >= 150
CheckTrue "WaitTimer did not wait too long (" + elapsed + " ms)", elapsed < 1000
Check "WaitTimer counted what TimerTicks says", TimerTicks(timer), total, 1

; A paused timer stands still, and goes on when resumed.
PauseTimer timer
ticks = TimerTicks(timer)
Delay 100
Check "PauseTimer", TimerTicks(timer), ticks
ResumeTimer timer
Delay 100
CheckTrue "ResumeTimer", TimerTicks(timer) > ticks

; Reset starts counting from nothing again.
ResetTimer timer
CheckTrue "ResetTimer", TimerTicks(timer) <= 1
FreeTimer timer
FreeTimer 0
slow = CreateTimer(2)
Delay 600
Check "Slow timer ticks", WaitTimer(slow), 1
FreeTimer slow

; The statistics go to the debug log.
RuntimeStats

; Events: a timer makes one event for the ticks that went by, which has the ticks so far.
FlushEvents
Check "PeekEvent without events", PeekEvent(), 0
Check "WaitEvent without events", WaitEvent(0), 0
Check "EventID without an event", EventID(), 0
timer = CreateTimer(100)
kind = WaitEvent(1000)
Check "WaitEvent gives the tick of a timer", kind, $4001
Check "EventID", EventID(), $4001
Check "EventSource is the timer", EventSource(), timer
CheckTrue "EventData is the ticks so far", EventData() >= 1
Check "EventX", EventX(), 0
Check "EventY", EventY(), 0
Check "EventZ", EventZ(), 0
; The ticks that nobody asked for are one event.
Delay 350
Check "More ticks are an event", WaitEvent(0), $4001
CheckTrue "More ticks add up", EventData() >= 3
Delay 150
Check "PeekEvent sees a tick", PeekEvent(), $4001
Check "PeekEvent leaves it", PeekEvent(), $4001
Check "WaitEvent takes it", WaitEvent(0), $4001
; A paused timer makes none, and what is flushed is gone.
Delay 150
PauseTimer timer
FlushEvents
Check "FlushEvents", PeekEvent(), 0
start = MilliSecs()
Check "WaitEvent times out", WaitEvent(150), 0
CheckTrue "WaitEvent waited for the time (" + (MilliSecs() - start) + " ms)", MilliSecs() - start >= 120
Check "EventID after nothing", EventID(), 0
ResumeTimer timer
Delay 150
Check "A timer that goes on makes events", PeekEvent(), $4001
PauseTimer timer
FlushEvents $4001
Check "FlushEvents of a kind", PeekEvent(), 0
ResumeTimer timer
other_timer = CreateTimer(100)
Delay 150
Check "Two timers make events", PeekEvent(), $4001
PauseTimer timer
PauseTimer other_timer
FlushEvents -1, timer
Check "FlushEvents of a source keeps the others", WaitEvent(0), $4001
Check "FlushEvents of a source keeps the other source", EventSource(), other_timer
FlushEvents
FreeTimer timer
FreeTimer other_timer
HotKeyEvent 30, 2, $1234
HotKeyEvent 30, 2, $1235, 7, 1, 2, 3
suite_checks = suite_checks + 1

; Things the program has made are counted.
baseline = ActiveObjects()
bank = CreateBank(8)
Check "ActiveObjects counts a bank", ActiveObjects(), baseline + 1
counted_timer = CreateTimer(10)
Check "ActiveObjects counts a timer", ActiveObjects(), baseline + 2
FreeTimer counted_timer
FreeBank bank
Check "ActiveObjects after freeing", ActiveObjects(), baseline
Type SuiteThing
	Field value
End Type
thing.SuiteThing = New SuiteThing
Check "ActiveObjects counts an object", ActiveObjects(), baseline + 1
Delete thing
Check "ActiveObjects after Delete", ActiveObjects(), baseline
DebugObjects
Check "QueryObject", QueryObject(0, 1), 0

; Other programs are started and not waited for. What a program writes shows that it ran.
output$ = "suite_process.txt"
DeleteFile output
CheckFalse "CreateProcess without a command", CreateProcess("")
If GetEnv$("OS") = "Windows_NT"
	Check "CreateProcess", CreateProcess("cmd /c echo started> " + output), 1
	CheckFalse "CreateProcess of something that is not there", CreateProcess("suite_no_such_program_xyz.exe")
Else
	Check "CreateProcess", CreateProcess("echo started > " + output), 1
EndIf
For i = 1 To 100
	If FileType(output) = 1 And FileSize(output) > 0 Then Exit
	Delay 50
Next
Check "The other program ran", FileType(output), 1
DeleteFile output

; Questions have no one to answer them without a window: nothing is asked, and the safe answer is given.
If GetEnv$("BLITZ_HEADLESS") <> ""
	Notify "Nobody sees this."
	Notify "Nor this.", True
	Check "Confirm without a window", Confirm("Nobody sees this."), 0
	Check "Confirm without a window, serious", Confirm("Nor this.", True), 0
	Check "Proceed without a window", Proceed("Nobody sees this."), -1
	Check "Proceed without a window, serious", Proceed("Nor this.", True), -1
Else
	suite_checks = suite_checks + 6
EndIf

Done "runtime"
