; The display (monitor) commands, which are BlitzLLVM extensions: CountDisplays PrimaryDisplay DisplayName DisplayX
; DisplayY DisplayWidth DisplayHeight DisplayDepth DisplayRefreshRate DisplayScale CountDisplayModes DisplayModeWidth
; DisplayModeHeight DisplayModeDepth DisplayModeRefreshRate CountRefreshRates RefreshRateAt. They are asked without a
; graphics window, so this runs on SDL's dummy display driver or whatever the machine has.
Include "check.bb"

displays = CountDisplays()
CheckTrue "CountDisplays", displays >= 1
Check "CountDisplays again", CountDisplays(), displays
primary = PrimaryDisplay()
CheckTrue "PrimaryDisplay", primary >= 1 And primary <= displays

For display = 1 To displays
	CheckTrue "DisplayName " + display, Len(DisplayName(display)) > 0
	CheckTrue "DisplayScale " + display, DisplayScale(display) > 0
	w = DisplayWidth(display)
	h = DisplayHeight(display)
	d = DisplayDepth(display)
	r = DisplayRefreshRate(display)
	CheckTrue "Display size " + display, w > 0 And h > 0
	CheckTrue "DisplayDepth " + display, d >= 16
	CheckTrue "DisplayRefreshRate " + display, r > 0

	modes = CountDisplayModes(display)
	CheckTrue "CountDisplayModes " + display, modes > 0
	found = 0
	For mode = 1 To modes
		mw = DisplayModeWidth(display, mode)
		mh = DisplayModeHeight(display, mode)
		md = DisplayModeDepth(display, mode)
		mr = DisplayModeRefreshRate(display, mode)
		CheckTrue "DisplayMode " + display + "/" + mode, mw > 0 And mh > 0 And md >= 16 And mr > 0
		If mw = w And mh = h And md = d And mr = r Then found = found + 1

		; Each mode is in the list once, and the list goes from small to large.
		If mode > 1
			pw = DisplayModeWidth(display, mode - 1)
			ph = DisplayModeHeight(display, mode - 1)
			pd = DisplayModeDepth(display, mode - 1)
			pr = DisplayModeRefreshRate(display, mode - 1)
			ordered = (pw < mw) Or (pw = mw And ph < mh) Or (pw = mw And ph = mh And pd < md) Or (pw = mw And ph = mh And pd = md And pr < mr)
			CheckTrue "DisplayMode order " + display + "/" + mode, ordered
		EndIf

		; The refresh rates of the size include the one of the mode.
		rates = CountRefreshRates(display, mw, mh)
		CheckTrue "CountRefreshRates " + display + "/" + mode, rates >= 1
		has = 0
		For rate = 1 To rates
			If RefreshRateAt(display, mw, mh, rate) = mr Then has = has + 1
			If rate > 1 Then CheckTrue "RefreshRateAt order", RefreshRateAt(display, mw, mh, rate) > RefreshRateAt(display, mw, mh, rate - 1)
		Next
		Check "RefreshRateAt has mode " + display + "/" + mode, has, 1
	Next
	Check "Current mode is in the list once " + display, found, 1
Next

; Numbers and sizes that do not exist give 0 or nothing, and do not stop the program.
Check "CountDisplayModes 0", CountDisplayModes(0), 0
Check "CountDisplayModes too high", CountDisplayModes(displays + 1), 0
Check "DisplayWidth 0", DisplayWidth(0), 0
Check "DisplayHeight -1", DisplayHeight(-1), 0
Check "DisplayDepth too high", DisplayDepth(displays + 1), 0
Check "DisplayRefreshRate 0", DisplayRefreshRate(0), 0
Check "DisplayX 0", DisplayX(0), 0
Check "DisplayY 0", DisplayY(0), 0
Check "DisplayScale 0", DisplayScale(0), 0
CheckS "DisplayName 0", DisplayName(0), ""
CheckS "DisplayName too high", DisplayName(displays + 1), ""
Check "DisplayModeWidth mode 0", DisplayModeWidth(1, 0), 0
Check "DisplayModeHeight mode too high", DisplayModeHeight(1, CountDisplayModes(1) + 1), 0
Check "DisplayModeDepth display 0", DisplayModeDepth(0, 1), 0
Check "DisplayModeRefreshRate display too high", DisplayModeRefreshRate(displays + 1, 1), 0
Check "CountRefreshRates no such size", CountRefreshRates(1, 7, 7), 0
Check "CountRefreshRates display 0", CountRefreshRates(0, DisplayWidth(1), DisplayHeight(1)), 0
Check "RefreshRateAt index 0", RefreshRateAt(1, DisplayWidth(1), DisplayHeight(1), 0), 0
Check "RefreshRateAt index too high", RefreshRateAt(1, DisplayWidth(1), DisplayHeight(1), 99), 0

Done "displays"
