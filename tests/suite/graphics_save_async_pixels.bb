; Saving on other threads, which needs a window and a GPU, so this is skipped without one: AsyncSaving SavesPending
; SavesFailed with SaveBuffer SaveImage SaveTexture, and that a program that ends with saves going on still gets its files.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_save_async_pixels: skipped, there is no window."
	End
EndIf

Graphics 160, 120, 32, 2
SetBuffer BackBuffer()

SeedRnd MilliSecs()
unique$ = "suite_save_async_" + Rand(1, 1000000000) + "_"
Const TIMEOUT = 20000

Function Draw()
	Cls
	For y = 0 To 119
		Color y * 2, 255 - y * 2, (y * 7) Mod 256
		Line 0, y, 159, y
	Next
	Color 255, 255, 0
	Oval 20, 20, 80, 60, 1
End Function

; Waits until no save is going on.
Function Settle()
	start = MilliSecs()
	While SavesPending() > 0
		If MilliSecs() - start > TIMEOUT Then RuntimeError "Saves did not finish."
		Delay 5
	Wend
End Function

; The pixels of a file against the front buffer, as the sum of the differences of the colors of a grid: 0 if they are the same.
Function Differs(name$)
	img = LoadImage(name)
	If img = 0 Then Return 1000000
	total = 0
	For y = 0 To 119 Step 3
		For x = 0 To 159 Step 3
			a = ReadPixel(x, y, ImageBuffer(img))
			b = ReadPixel(x, y, FrontBuffer())
			total = total + Abs(((a Shr 16) And 255) - ((b Shr 16) And 255)) + Abs(((a Shr 8) And 255) - ((b Shr 8) And 255)) + Abs((a And 255) - (b And 255))
		Next
	Next
	FreeImage img
	Return total
End Function

Draw
Flip 2

; The child program: it saves on other threads and ends at once, the files still have to be written.
If Instr(CommandLine$(), "child") > 0
	AsyncSaving True
	For i = 0 To 3
		SaveBuffer FrontBuffer(), GetEnv$("BLITZ_SAVE_TEST_PREFIX") + i + ".png", "compression=9"
	Next
	SaveBuffer FrontBuffer(), GetEnv$("BLITZ_SAVE_TEST_PREFIX") + "j.jxl", "lossless=1,effort=7"
	End
EndIf

; Off to begin with, unless the environment turns it on.
Check "Nothing is pending to begin with", SavesPending(), 0
Check "Nothing failed to begin with", SavesFailed(), 0
Check "Saving without threads", SaveBuffer(FrontBuffer(), unique + "sync.png"), 1
Check "Saving without threads is done at once", SavesPending(), 0
Check "The file is there at once", Differs(unique + "sync.png"), 0

AsyncSaving True
Dim names$(5)
names(0) = unique + "0.png" : names(1) = unique + "1.jpg" : names(2) = unique + "2.webp"
names(3) = unique + "3.jxl" : names(4) = unique + "4.tga" : names(5) = unique + "5.bmp"
For i = 0 To 5
	Check "Async SaveBuffer " + names(i), SaveBuffer(FrontBuffer(), names(i), "lossless=1"), 1
Next
Settle
Check "Nothing is pending afterwards", SavesPending(), 0
Check "Nothing failed", SavesFailed(), 0
For i = 0 To 5
	If i <> 1 Then Check "The async file " + names(i), Differs(names(i)), 0
Next
CheckTrue "The async JPEG", Differs(names(1)) < 54 * 40 * 3 * 8

; The pixels are copied when the command is called, so what is drawn afterwards is not in the file.
Draw
expected = ReadPixel(50, 100, BackBuffer()) And $FFFFFF
SaveBuffer BackBuffer(), unique + "copy.png"
Color 255, 0, 0
Rect 0, 0, 160, 120, 1
Flip 2
Settle
img = LoadImage(unique + "copy.png")
CheckTrue "The save of a buffer that was drawn over loads", img <> 0
Check "A save has the picture of its call", ReadPixel(50, 100, ImageBuffer(img)) And $FFFFFF, expected
FreeImage img

; Saving the same file again replaces it with the later picture.
Draw
SaveBuffer BackBuffer(), unique + "twice.png", "compression=9"
Color 0, 0, 255
Rect 0, 0, 160, 120, 1
SaveBuffer BackBuffer(), unique + "twice.png"
Flip 2
Settle
img = LoadImage(unique + "twice.png")
Check "The later save of a file wins", ReadPixel(50, 100, ImageBuffer(img)) And $FFFFFF, $0000FF
FreeImage img

; Slow ones are pending for a while, and a file that can't be written is counted as failed.
Draw
Flip 2
For i = 0 To 2
	SaveBuffer FrontBuffer(), unique + "slow" + i + ".jxl", "lossless=1,effort=9"
Next
CheckTrue "Slow saves are pending", SavesPending() > 0
Check "A file in a folder that does not exist is queued", SaveBuffer(FrontBuffer(), unique + "nodir/x.png"), 1
Settle
Check "The file in a missing folder failed", SavesFailed(), 1
Check "No file was made in the missing folder", FileType(unique + "nodir/x.png"), 0
For i = 0 To 2
	Check "The slow file " + i, Differs(unique + "slow" + i + ".jxl"), 0
Next
Check "AVIF is refused at once", SaveBuffer(FrontBuffer(), unique + "n.avif"), 0
Check "Refused saves are not counted as failed", SavesFailed(), 1

; SaveImage and SaveTexture on other threads.
img = CreateImage(160, 120)
CopyRect 0, 0, 160, 120, 0, 0, FrontBuffer(), ImageBuffer(img)
tex = CreateTexture(160, 120)
CopyRect 0, 0, 160, 120, 0, 0, FrontBuffer(), TextureBuffer(tex)
Check "Async SaveImage", SaveImage(img, unique + "image.png"), 1
Check "Async SaveTexture", SaveTexture(tex, unique + "texture.webp", 0, "lossless=1"), 1
Settle
Check "The async image", Differs(unique + "image.png"), 0
Check "The async texture", Differs(unique + "texture.webp"), 0

; Off again.
AsyncSaving False
Check "Saving without threads again", SaveBuffer(FrontBuffer(), unique + "sync2.png"), 1
Check "Nothing is pending after a save without threads", SavesPending(), 0

; A program that ends with saves going on still has its files: the other program saves and ends at once.
program$ = GetEnv$("BLITZ_SUITE_PROGRAM")
If program = "" Then
	Print "graphics_save_async_pixels: the program is not known, so the ending was not tested."
	suite_checks = suite_checks + 1
Else
	SetEnv "BLITZ_SAVE_TEST_PREFIX", unique + "child_"
	CheckTrue "Starting the other program", CreateProcess(Chr$(34) + program + Chr$(34) + " child")
	start = MilliSecs()
	missing = 5
	While missing > 0 And MilliSecs() - start < TIMEOUT
		missing = 0
		For i = 0 To 3
			If Differs(unique + "child_" + i + ".png") <> 0 Then missing = missing + 1
		Next
		If Differs(unique + "child_j.jxl") <> 0 Then missing = missing + 1
		If missing > 0 Then Delay 50
	Wend
	Check "The files of the program that ended", missing, 0
EndIf

; Clean up what was made.
dir = ReadDir(".")
Repeat
	file$ = NextFile$(dir)
	If file = "" Then Exit
	If Left(file, Len(unique)) = unique Then DeleteFile file
Forever
CloseDir dir

Done "graphics_save_async_pixels"
