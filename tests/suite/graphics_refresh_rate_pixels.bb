; SetGraphicsRefreshRate limits how fast Flip 1 lets a program go. Flip 2 never holds the program (it only shows fewer frames), and Flip 0 is never limited. Needs a window, so it is
; skipped without one. The limit is checked loosely (about 0.65 of the asked time at least, and not slower than 3 times it) since the
; machine may be busy; what it shows is that a limit exists and that the average does not drift under it.
; SetGraphicsRefreshRate GetGraphicsRefreshRate Flip MilliSecs.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_refresh_rate_pixels: skipped, there is no window."
	End
EndIf

Check "The limit starts off", GetGraphicsRefreshRate(), 0

Graphics 64, 64, 0, 2
SetBuffer BackBuffer()

; How long 30 flips take, in milliseconds.
Function Flips30(mode)
	Local start = MilliSecs()
	Local i
	For i = 1 To 30
		Cls
		Flip mode
	Next
	Return MilliSecs() - start
End Function

SetGraphicsRefreshRate 50
Check "SetGraphicsRefreshRate", GetGraphicsRefreshRate(), 50

; Flip 2 does not hold the program: at 20 Hz a held program would need 1.5 seconds for 30 frames.
SetGraphicsRefreshRate 20
Local took2 = Flips30(2)
CheckTrue "Flip 2 does not hold the program", took2 < 1000

; Flip 0 is never limited: it has to be quicker than the limit allows.
SetGraphicsRefreshRate 20
Local took0 = Flips30(0)
CheckTrue "Flip 0 ignores the limit", took0 < 1000

; Flip 1 waits for the display and keeps the limit as well: at 20 Hz, 30 frames take about 1.5 seconds, and not more than a few times that.
SetGraphicsRefreshRate 20
Flips30 1
Local took1 = Flips30(1)
CheckTrue "Flip 1 is limited (at least 1200 ms for 30 frames at 20 Hz)", took1 >= 1200
CheckTrue "Flip 1 is not slower than the limit by far", took1 <= 4000

SetGraphicsRefreshRate 0
Check "The limit can be turned off", GetGraphicsRefreshRate(), 0
EndGraphics
Done "graphics_refresh_rate_pixels"
