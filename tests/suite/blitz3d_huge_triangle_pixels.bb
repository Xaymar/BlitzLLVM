; Triangles with corners hundreds of thousands of units away, which needs a window and a GPU, so this is skipped without one. Direct3D 7
; cuts them to the view before they are drawn, and so do we: a ground that is 524288 units wide with a chess texture has to look the same
; as one that is 6000 units wide, where the texture coordinates of the corners are still exact.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_huge_triangle_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 640, 480, 32, 2
SetBuffer BackBuffer()
AntiAlias 0
Dither 0

; Two chess squares of 32 by 32 pixels in a 64 by 64 texture, so that one texture coordinate unit is one square of the board.
Global tex = CreateTexture(64, 64, 1 + 8)
buf = TextureBuffer(tex)
LockBuffer buf
For x = 0 To 63
	For y = 0 To 63
		c = 0
		If x <= 31 And y <= 31 Then c = $FFFFFFFF
		If x >= 32 And y >= 32 Then c = $FFFFFFFF
		WritePixelFast x, y, c, buf
	Next
Next
UnlockBuffer buf

; A ground made of two triangles, half as wide as the size says on each side, and the texture coordinates are the world coordinates.
Function Ground(half#)
	m = CreateMesh()
	s = CreateSurface(m)
	a = AddVertex(s, -half#, 0, -half#, -half#, -half#)
	b = AddVertex(s, half#, 0, -half#, half#, -half#)
	c = AddVertex(s, -half#, 0, half#, -half#, half#)
	d = AddVertex(s, half#, 0, half#, half#, half#)
	For i = 0 To 3
		VertexNormal s, i, 0, 1, 0
	Next
	AddTriangle s, a, c, b
	AddTriangle s, b, c, d
	EntityFX m, 1
	EntityTexture m, tex
	Return m
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 65535
PositionEntity camera, 0, 2, 0
RotateEntity camera, 30, 20, 0

Dim ref(640 * 480)
ground = Ground(3000.0)
RenderWorld
For y = 100 To 479 Step 2
	For x = 0 To 639 Step 2
		ref(y * 640 + x) = ReadPixel(x, y, BackBuffer()) And 255
	Next
Next
FreeEntity ground

ground = Ground(262144.0)
RenderWorld
different = 0
For y = 100 To 479 Step 2
	For x = 0 To 639 Step 2
		If Abs((ReadPixel(x, y, BackBuffer()) And 255) - ref(y * 640 + x)) > 64 Then different = different + 1
	Next
Next
; The picture is the same: the board is in the same place, a handful of pixels at the edges of squares may land on the other side.
CheckTrue "The huge ground has the same picture as the small one (" + different + " pixels differ)", different < 200
FreeEntity ground

Done "blitz3d_huge_triangle_pixels"
