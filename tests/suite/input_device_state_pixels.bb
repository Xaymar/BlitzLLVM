; What each keyboard and mouse did on its own: the Device argument of KeyDown KeyHit MouseDown MouseHit MouseX MouseY
; MouseXSpeed MouseYSpeed MouseZ MouseZSpeed FlushKeys and FlushMouse. The events come from BLITZLLVM_TEST_EVENTS, where
; +mID +kID plug in a mouse or keyboard and dID says which device the events after it come from.
Include "check.bb"

Graphics 160, 120, 32, 2
Local buffer = SetBuffer(BackBuffer())

SetEnv "BLITZLLVM_TEST_EVENTS", "+m900,+m901,+k900,+k901"
Local m0 = FindMouse("Mouse 900")
Local m1 = FindMouse("Mouse 901")
Local k0 = FindKeyboard("Keyboard 900")
Local k1 = FindKeyboard("Keyboard 901")
CheckTrue "Devices are found", (m0 >= 0) And (m1 >= 0) And (k0 >= 0) And (k1 >= 0)
FlushKeys
FlushMouse

; Keys are counted for the keyboard they came from, and for all keyboards together.
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,k30,d901,k48,k48"
CheckTrue "KeyHit of keyboard 0", KeyHit(30, k0) = 1
CheckTrue "KeyHit of keyboard 0 for the key of keyboard 1", KeyHit(48, k0) = 0
CheckTrue "KeyHit of keyboard 1", KeyHit(48, k1) = 2
CheckTrue "KeyHit of keyboard 1 for the key of keyboard 0", KeyHit(30, k1) = 0
CheckTrue "KeyHit of keyboard 1 starts over", KeyHit(48, k1) = 0
CheckTrue "KeyHit of all keyboards", KeyHit(30) = 1
CheckTrue "KeyHit of all keyboards sees both", KeyHit(48) = 2
CheckFalse "KeyDown of a key that was let go", KeyDown(30, k0)
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,k30,k30"
FlushKeys k0
CheckTrue "FlushKeys of one keyboard", KeyHit(30, k0) = 0
CheckTrue "FlushKeys of one keyboard keeps the others", KeyHit(30) = 2
CheckFalse "KeyDown of a keyboard that doesn't exist", KeyDown(30, 99)
CheckTrue "KeyHit of a keyboard that doesn't exist", KeyHit(30, 99) = 0

; The same for the mouse buttons.
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,m1,m1,d901,m2"
CheckTrue "MouseHit of mouse 0", MouseHit(1, m0) = 2
CheckTrue "MouseHit of mouse 1", MouseHit(2, m1) = 1
CheckTrue "MouseHit of mouse 1 for the button of mouse 0", MouseHit(1, m1) = 0
CheckTrue "MouseHit of all mice", MouseHit(1) = 2
CheckFalse "MouseDown of a button that was let go", MouseDown(1, m0)
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,m3,m3"
FlushMouse m0
CheckTrue "FlushMouse of one mouse", MouseHit(3, m0) = 0
CheckTrue "FlushMouse of one mouse keeps the others", MouseHit(3) = 2
CheckTrue "MouseHit of a mouse that doesn't exist", MouseHit(1, 99) = 0

; Each mouse has a pointer of its own, that starts in the middle and stays in the buffer.
CheckTrue "MouseX starts in the middle", MouseX(0, m0) = 79
CheckTrue "MouseY starts in the middle", MouseY(0, m0) = 59
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,r10:5,r5:0,d901,r-3:4"
CheckTrue "MouseX of mouse 0", MouseX(0, m0) = 94
CheckTrue "MouseY of mouse 0", MouseY(0, m0) = 64
CheckTrue "MouseX of mouse 1", MouseX(0, m1) = 76
CheckTrue "MouseY of mouse 1", MouseY(0, m1) = 63
CheckTrue "MouseXSpeed of mouse 0", MouseXSpeed(0, m0) = 15
CheckTrue "MouseYSpeed of mouse 0", MouseYSpeed(0, m0) = 5
CheckTrue "MouseXSpeed of mouse 0 starts over", MouseXSpeed(0, m0) = 0
CheckTrue "MouseXSpeed of mouse 1", MouseXSpeed(0, m1) = -3
CheckTrue "MouseYSpeed of mouse 1", MouseYSpeed(0, m1) = 4
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,r1000:1000,r-5000:-5000"
CheckTrue "MouseX stays in the buffer", MouseX(0, m0) = 0
CheckTrue "MouseY stays in the buffer", MouseY(0, m0) = 0
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,r5000:5000"
CheckTrue "MouseX stays in the buffer on the other side", MouseX(0, m0) = 159
CheckTrue "MouseY stays in the buffer on the other side", MouseY(0, m0) = 119
CheckTrue "MouseX of a mouse that doesn't exist", MouseX(0, 99) = 0
CheckTrue "MouseXSpeed of a mouse that doesn't exist", MouseXSpeed(0, 99) = 0

; And the wheel.
FlushMouse
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,w2,d901,w-1"
CheckTrue "MouseZ of mouse 0", MouseZ(m0) = 2
CheckTrue "MouseZ of mouse 1", MouseZ(m1) = -1
CheckTrue "MouseZSpeed of mouse 0", MouseZSpeed(m0) = 2
CheckTrue "MouseZSpeed of mouse 0 starts over", MouseZSpeed(m0) = 0
CheckTrue "MouseZSpeed of mouse 1", MouseZSpeed(m1) = -1
CheckTrue "MouseZ of all mice", MouseZ() = 1

Done "input_device_state_pixels"

Function FindMouse(name$)
	Local i
	For i = 0 To MouseDeviceCount() - 1
		If MouseDeviceName(i) = name Then Return i
	Next
	Return -1
End Function

Function FindKeyboard(name$)
	Local i
	For i = 0 To KeyboardDeviceCount() - 1
		If KeyboardDeviceName(i) = name Then Return i
	Next
	Return -1
End Function
