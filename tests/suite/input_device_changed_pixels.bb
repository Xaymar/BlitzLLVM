; Which device the user used last: MouseChanged KeyboardChanged JoyChanged LastMouseDevice LastKeyboardDevice
; LastJoyDevice. The events come from BLITZLLVM_TEST_EVENTS, where +mID +kID +j plug in a device, dID says which device
; the events after it come from, jbN presses a button and jaN:V moves an axis of the joystick that isn't real.
Include "check.bb"

Graphics 160, 120, 32, 2
Local buffer = SetBuffer(BackBuffer())

SetEnv "BLITZLLVM_TEST_EVENTS", "+m900,+m901,+k900,+k901,+j"
Local m0 = FindMouse("Mouse 900")
Local m1 = FindMouse("Mouse 901")
Local k0 = FindKeyboard("Keyboard 900")
Local k1 = FindKeyboard("Keyboard 901")
Local j0 = JoyDeviceCount() - 1

; A device that was just plugged in counts as used once.
CheckTrue "New mouse counts as used", MouseChanged(m0)
CheckTrue "New keyboard counts as used", KeyboardChanged(k0)
CheckTrue "New joystick counts as used", JoyChanged(j0)
MouseChanged
KeyboardChanged
JoyChanged
MouseChanged m1
KeyboardChanged k1

; Nothing happened, so nothing changed.
CheckFalse "MouseChanged without input", MouseChanged()
CheckFalse "KeyboardChanged without input", KeyboardChanged()
CheckFalse "JoyChanged without input", JoyChanged()

; Mice: only the one that moved changed, and reading clears it.
SetEnv "BLITZLLVM_TEST_EVENTS", "d901,r4:0"
CheckFalse "Other mouse didn't change", MouseChanged(m0)
CheckTrue "Moved mouse changed", MouseChanged(m1)
CheckFalse "Mouse changed clears", MouseChanged(m1)
CheckTrue "All mice changed", MouseChanged()
CheckFalse "All mice changed clears", MouseChanged()
Check "LastMouseDevice", LastMouseDevice(), m1
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,m1,d901,w1"
CheckTrue "Button changed", MouseChanged(m0)
CheckTrue "Wheel changed", MouseChanged(m1)
Check "LastMouseDevice follows the latest", LastMouseDevice(), m1
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,m1"
MouseChanged
Check "LastMouseDevice follows the button", LastMouseDevice(), m0

; Keyboards: key presses and releases count.
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,k30"
CheckTrue "Typing keyboard changed", KeyboardChanged(k0)
CheckFalse "Other keyboard didn't change", KeyboardChanged(k1)
CheckFalse "Keyboard changed clears", KeyboardChanged(k0)
CheckTrue "All keyboards changed", KeyboardChanged()
Check "LastKeyboardDevice", LastKeyboardDevice(), k0
SetEnv "BLITZLLVM_TEST_EVENTS", "d901,k48"
KeyboardChanged
Check "LastKeyboardDevice follows the latest", LastKeyboardDevice(), k1

; Joysticks: a button counts, a small axis move doesn't, a big one does.
SetEnv "BLITZLLVM_TEST_EVENTS", "ja0:3000"
CheckFalse "Small axis move inside the dead zone", JoyChanged(j0)
SetEnv "BLITZLLVM_TEST_EVENTS", "ja0:30000"
CheckTrue "Big axis move changed", JoyChanged(j0)
CheckFalse "Joystick changed clears", JoyChanged(j0)
SetEnv "BLITZLLVM_TEST_EVENTS", "jb1"
CheckTrue "Button changed the joystick", JoyChanged()
CheckFalse "All joysticks changed clears", JoyChanged()
Check "LastJoyDevice", LastJoyDevice(), j0

; Devices that don't exist never change.
CheckFalse "MouseChanged of a mouse that doesn't exist", MouseChanged(99)
CheckFalse "KeyboardChanged of a keyboard that doesn't exist", KeyboardChanged(99)
CheckFalse "JoyChanged of a joystick that doesn't exist", JoyChanged(99)

Done "input_device_changed_pixels"

Function FindMouse(name$)
	Local i
	For i = 0 To MouseDeviceCount() - 1
		If MouseDeviceName(i) = name Then Return i
	Next
	Return -1
End Function

Function FindKeyboard(name$)
	Local i
	For i = 0 To KeyboardDeviceCount() - 1
		If KeyboardDeviceName(i) = name Then Return i
	Next
	Return -1
End Function
