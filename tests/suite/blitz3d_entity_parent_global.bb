; EntityParent with global True (the default) keeps position, rotation and scale in the world, so a bullet copied under a plane and then freed from it keeps flying where the plane faced (wing_ring).
Include "check.bb"

Graphics3D 320, 240, 32, 2

plane = CreatePivot()
PositionEntity plane, 10, 20, 30
RotateEntity plane, 0, 90, 0

; Like wing_ring: copy under the plane, then let go of it.
src = CreatePivot()
bullet = CopyEntity(src, plane)
EntityParent bullet, 0
Check "Position kept", EntityX(bullet, True), 10, 0.01
Check "Position kept Y", EntityY(bullet, True), 20, 0.01
Check "Position kept Z", EntityZ(bullet, True), 30, 0.01
Check "Yaw kept", EntityYaw(bullet, True), 90, 0.01
MoveEntity bullet, 0, 0, 100
Check "Flies where the plane faced X", EntityX(bullet, True), -90, 0.01
Check "Flies where the plane faced Z", EntityZ(bullet, True), 30, 0.01

; Reparenting into a rotated, scaled parent keeps the world values too.
parent = CreatePivot()
RotateEntity parent, 0, 45, 0
ScaleEntity parent, 2, 2, 2
child = CreatePivot()
RotateEntity child, 10, 20, 30
ScaleEntity child, 3, 3, 3
EntityParent child, parent
Check "World pitch kept", EntityPitch(child, True), 10, 0.1
Check "World yaw kept", EntityYaw(child, True), 20, 0.1
Check "World roll kept", EntityRoll(child, True), 30, 0.1

; With global False the local values are kept and the world ones change.
child2 = CreatePivot()
RotateEntity child2, 0, 20, 0
EntityParent child2, parent, False
Check "Local yaw kept", EntityYaw(child2, False), 20, 0.1
Check "World yaw changed", EntityYaw(child2, True), 65, 0.1
EndGraphics
