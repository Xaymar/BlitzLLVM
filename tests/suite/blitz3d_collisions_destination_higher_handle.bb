; What a mover hits is also told to the entity it hit, whether that one was made before or after the mover.
; EntityCollided CountCollisions UpdateWorld EntityType EntityRadius Collisions
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Const T_SHOT = 1, T_ASTEROID = 2

Collisions T_SHOT, T_ASTEROID, 1, 1

; The shot has the lower handle, so it is collided before the asteroid is looked at.
shot = CreatePivot()
EntityType shot, T_SHOT
EntityRadius shot, 1

asteroid = CreatePivot()
EntityType asteroid, T_ASTEROID
EntityRadius asteroid, 5
PositionEntity asteroid, 0, 0, 10

PositionEntity shot, 0, 0, 0
ResetEntity shot
UpdateWorld
TranslateEntity shot, 0, 0, 10
UpdateWorld
Check "The shot hit the asteroid", EntityCollided(shot, T_ASTEROID), asteroid
Check "The asteroid was hit by the shot", EntityCollided(asteroid, T_SHOT), shot
Check "The asteroid has one collision", CountCollisions(asteroid), 1
EndGraphics
