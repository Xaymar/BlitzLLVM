; CreateSprite sprites come out like they do with the original Blitz3D 1.118: 15 sprites with different scales, rolls, handles,
; view modes (including numbers that are none of them, which are fixed), FX flags (no fullbright means lit by the ambient light
; only, as a sprite has no normals), a copy and a child of a scaled and turned pivot, seen from two cameras. The pictures
; (images/sprite_modes_original_<n>.png) were made by the original under Wine with BLITZLLVM_TEST_WRITE_REFERENCE=<prefix> set and
; converted to PNG; at least 99% of the pixels are within 8 of a pixel next to them.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_sprite_modes_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 400, 300, 32, 2
SetBuffer BackBuffer()

; Asymmetric texture: a red block top left, a green stripe at the bottom and an F.
tex = LoadTexture("images/sprite_f.png", 1)

camera = CreateCamera()
CameraClsColor camera, 30, 30, 30
CameraRange camera, 0.1, 100
light = CreateLight()
RotateEntity light, 50, -30, 0
AmbientLight 60, 60, 60

Dim s(20)
; scene 0: plain camera. grid 5 x 3 at z=12, spacing 3
For i = 0 To 14
	s(i) = CreateSprite()
	PositionEntity s(i), (i Mod 5) * 3 - 6, 3 - (i / 5) * 3, 12
	EntityTexture s(i), tex
Next
EntityColor s(1), 255, 128, 0
ScaleSprite s(1), 1.5, 0.6
RotateSprite s(2), 30
HandleSprite s(3), 1, 1
RotateSprite s(3), 30 : ScaleSprite s(3), 0.7, 0.5
SpriteViewMode s(4), 2
RotateEntity s(4), 0, 50, 0
SpriteViewMode s(5), 3
RotateEntity s(5), 20, 40, 30
SpriteViewMode s(6), 4
RotateEntity s(6), 20, 40, 30
SpriteViewMode s(7), 0
RotateEntity s(7), 0, 50, 0
SpriteViewMode s(8), 9
RotateEntity s(8), 0, 50, 0
SpriteViewMode s(9), 2
RotateEntity s(9), 0, 150, 0
SpriteViewMode s(10), 2
RotateEntity s(10), 0, 150, 0
EntityFX s(10), 16
EntityFX s(11), 0
EntityColor s(11), 200, 200, 255
ScaleEntity s(12), 2, 0.5, 1
RotateSprite s(12), 45
SpriteViewMode s(13), 2 : ScaleEntity s(13), 1.5, 0.6, 1 : RotateEntity s(13), 0, 20, 40
c = CopyEntity(s(1)) : PositionEntity c, 0, -3, 6 : ScaleSprite c, 0.5, 0.5
pv = CreatePivot() : PositionEntity pv, 4, -4, 8 : ScaleEntity pv, 2, 1, 1 : RotateEntity pv, 0, 0, 20
p = CreateSprite(pv) : EntityTexture p, tex
SpriteViewMode s(14), 3 : ScaleSprite s(14), 1.2, 1.2
Dim wanted(399, 299)
For k = 1 To 2
	Select k
	Case 0 : PositionEntity camera, 0, 0, 0 : RotateEntity camera, 0, 0, 0
	Case 1 : PositionEntity camera, 1, 1, 0 : RotateEntity camera, 15, -20, 25
	Case 2 : PositionEntity camera, -2, 4, 3 : RotateEntity camera, 40, 10, 0
	Case 3 : PositionEntity camera, 5, 0, 20 : RotateEntity camera, 0, 200, 0
	End Select
	RenderWorld
	If GetEnv$("BLITZLLVM_TEST_WRITE_REFERENCE") <> "" Then
		SaveBuffer BackBuffer(), GetEnv$("BLITZLLVM_TEST_WRITE_REFERENCE") + k + ".bmp"
	Else
		reference = LoadImage("images/sprite_modes_original_" + k + ".png")
		CheckTrue "The picture of the original is there (" + k + ")", reference <> 0
		SetBuffer ImageBuffer(reference)
		For y = 0 To 299
			For x = 0 To 399
				wanted(x, y) = ReadPixel(x, y) And $FFFFFF
			Next
		Next
		SetBuffer BackBuffer()
		same = 0
		For y = 0 To 299
			For x = 0 To 399
				got = ReadPixel(x, y, BackBuffer()) And $FFFFFF
				found = 0
				For ny = y - 1 To y + 1
					For nx = x - 1 To x + 1
						If nx >= 0 And nx < 400 And ny >= 0 And ny < 300 And found = 0 Then
							want = wanted(nx, ny)
							If Abs(((got Shr 16) And 255) - ((want Shr 16) And 255)) <= 8 And Abs(((got Shr 8) And 255) - ((want Shr 8) And 255)) <= 8 And Abs((got And 255) - (want And 255)) <= 8 Then found = 1
						EndIf
					Next
				Next
				same = same + found
			Next
		Next
		CheckTrue "Camera " + k + ": at least 99% of the pixels are like the original (" + (same * 100 / 120000) + "%)", same * 100 >= 120000 * 99
	EndIf
Next
End
