; EntityTexture on a mesh whose model has a texture of its own, which needs a window and a GPU, so this is skipped without
; one. Blitz3D puts the brush of the entity over the brushes of the surfaces a layer at a time, so the texture of the entity
; is what is drawn, and the one that LoadMesh found for the model (or PaintMesh put on it) only shows on layers the entity
; has nothing on. The same goes for the blend mode. A masked texture of the entity therefore cuts out its black parts even when the model has an unmasked
; texture of the same picture.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_entity_texture_over_mesh_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

ClearTextureFilters

; A picture of two halves: the left one in the color a, the right one in the color b.
Function SavePicture(file$, a, b)
	Local t = CreateTexture(16, 16, 1 + 4096)
	SetBuffer TextureBuffer(t)
	ClsColor (a Shr 16) And 255, (a Shr 8) And 255, a And 255
	Cls
	Color (b Shr 16) And 255, (b Shr 8) And 255, b And 255
	Rect 8, 0, 8, 16
	SetBuffer BackBuffer()
	SaveBuffer TextureBuffer(t), file$
	FreeTexture t
End Function

; The picture of the model is red, the one for EntityTexture black on the left and white on the right.
SavePicture "suite_entity_texture_model.bmp", $FF0000, $FF0000
SavePicture "suite_entity_texture_mask.bmp", $000000, $FFFFFF

; A square from -1 to 1 with the texture of the model on it, u going from 0 on the left to 1 on the right.
file = WriteFile("suite_entity_texture.x")
WriteLine file, "xof 0302txt 0032"
WriteLine file, "Material Model {"
WriteLine file, "  1.0;1.0;1.0;1.0;;"
WriteLine file, "  0.0;"
WriteLine file, "  0.0;0.0;0.0;;"
WriteLine file, "  0.0;0.0;0.0;;"
WriteLine file, "  TextureFileName { " + Chr(34) + "suite_entity_texture_model.bmp" + Chr(34) + "; }"
WriteLine file, "}"
WriteLine file, "Mesh Square {"
WriteLine file, "  4;"
WriteLine file, "  -1.0;1.0;0.0;, 1.0;1.0;0.0;, 1.0;-1.0;0.0;, -1.0;-1.0;0.0;;"
WriteLine file, "  2;"
WriteLine file, "  3;0,1,2;, 3;0,2,3;;"
WriteLine file, "  MeshMaterialList { 1; 2; 0, 0;; { Model } }"
WriteLine file, "  MeshTextureCoords { 4; 0.0;0.0;, 1.0;0.0;, 1.0;1.0;, 0.0;1.0;; }"
WriteLine file, "}"
CloseFile file

camera = CreateCamera()
CameraClsColor camera, 10, 20, 30

mesh = LoadMesh("suite_entity_texture.x")
CheckTrue "LoadMesh of the square", mesh <> 0
EntityFX mesh, 1 + 16
PositionEntity mesh, 0, 0, 3

; The texture of the model.
RenderWorld
Check "Texture of the model on the left", R(60, 60), 255, 8
Check "Texture of the model on the right", R(100, 60), 255, 8

; EntityTexture with a masked texture: its black half is cut out and its white half is drawn, the red of the model does not
; show anywhere.
mask = LoadTexture("suite_entity_texture_mask.bmp", 4)
CheckTrue "LoadTexture of the mask", mask <> 0
EntityTexture mesh, mask
RenderWorld
Check "Masked black of the entity texture is cut out (red)", R(60, 60), 10, 4
Check "Masked black of the entity texture is cut out (green)", G(60, 60), 20, 4
Check "Masked black of the entity texture is cut out (blue)", B(60, 60), 30, 4
Check "White of the entity texture (red)", R(100, 60), 255, 8
Check "White of the entity texture (blue)", B(100, 60), 255, 8

; Without the texture of the entity the one of the model is back.
EntityTexture mesh, 0
RenderWorld
Check "Texture of the model once EntityTexture 0", R(60, 60), 255, 8
Check "Texture of the model once EntityTexture 0 (blue)", B(60, 60), 0, 8

; PaintMesh puts a brush on the surfaces, which the texture of the entity is drawn over all the same.
green = CreateTexture(4, 4)
SetBuffer TextureBuffer(green)
ClsColor 0, 255, 0
Cls
SetBuffer BackBuffer()
brush = CreateBrush()
BrushTexture brush, green
PaintMesh mesh, brush
RenderWorld
Check "Texture of PaintMesh", G(100, 60), 255, 8
Check "Texture of PaintMesh (red)", R(100, 60), 0, 8
EntityTexture mesh, mask
RenderWorld
Check "Entity texture over PaintMesh: cut out", G(60, 60), 20, 4
Check "Entity texture over PaintMesh: white", R(100, 60), 255, 8

; The blend works the same way: one that the surfaces have is used until EntityBlend gives the entity one.
added = CreateBrush()
BrushTexture added, green
BrushBlend added, 3
PaintMesh mesh, added
EntityTexture mesh, 0
RenderWorld
Check "Blend of the surfaces: added onto the background (red)", R(80, 60), 10, 4
Check "Blend of the surfaces: added onto the background (green)", G(80, 60), 255, 8
EntityBlend mesh, 1
RenderWorld
Check "EntityBlend over the blend of the surfaces (red)", R(80, 60), 0, 4
Check "EntityBlend over the blend of the surfaces (green)", G(80, 60), 255, 8

EndGraphics
DeleteFile "suite_entity_texture.x"
DeleteFile "suite_entity_texture_model.bmp"
DeleteFile "suite_entity_texture_mask.bmp"
Done "blitz3d_entity_texture_over_mesh_pixels"
