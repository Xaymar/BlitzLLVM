; Meshes that stay as they are for a few frames can be drawn by the GPU from a table (BLITZLLVM_GPU_DRAWS=1), which must not change a pixel.
; This lets a grid of cubes settle into the table and then changes each thing the table depends on (the color, the place, hiding, freeing,
; the alpha, the texture, the lights and the camera), looking at the picture right after the change and again once the cubes have settled
; into the table again. Needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_gpu_draws_pixels: skipped, there is no window."
	End
EndIf

SetEnv "BLITZLLVM_GPU_DRAWS", "1"
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, -40
Global light = CreateLight()

Const COUNT = 20
Dim cubes(COUNT - 1)
Dim cr(COUNT - 1), cg(COUNT - 1), cb(COUNT - 1), gx#(COUNT - 1), gy#(COUNT - 1)
For i = 0 To COUNT - 1
	cubes(i) = CreateCube()
	cr(i) = 40 + i * 10 : cg(i) = 250 - i * 10 : cb(i) = 90
	EntityColor cubes(i), cr(i), cg(i), cb(i)
	EntityFX cubes(i), 1
	gx(i) = (i Mod 5) * 8 - 16 : gy(i) = (i / 5) * 8 - 12
	PositionEntity cubes(i), gx(i), gy(i), 0
Next

Function Frames(count)
	For k = 1 To count
		RenderWorld
	Next
End Function

; The color in the middle of a cube, where it is seen from the camera now.
Function Middle(i)
	CameraProject camera, gx(i), gy(i), 0
	Return ReadPixel(ProjectedX(), ProjectedY(), BackBuffer()) And $FFFFFF
End Function

Function CheckColor(name$, i, r, g, b, tolerance = 3)
	c = Middle(i)
	Check name + " (red)", (c Shr 16) And 255, r, tolerance
	Check name + " (green)", (c Shr 8) And 255, g, tolerance
	Check name + " (blue)", c And 255, b, tolerance
End Function

Function CheckAll(name$)
	For i = 0 To COUNT - 1
		If cubes(i) <> 0 Then CheckColor name + " " + i, i, cr(i), cg(i), cb(i)
	Next
End Function

; Settled into the table: all of them are drawn by the GPU, which TrisRendered does not count.
Frames 3
CheckAll "Before settling"
Frames 20
CheckAll "Settled"
CheckTrue "The cubes are drawn from the table (" + TrisRendered() + " triangles from the program)", TrisRendered() < COUNT * 12

; The color.
EntityColor cubes(3), 255, 0, 0
cr(3) = 255 : cg(3) = 0 : cb(3) = 0
Frames 1
CheckAll "Color changed"
Frames 20
CheckAll "Color changed, settled"

; The place.
PositionEntity cubes(4), gx(4), gy(4) + 100, 0
Frames 1
CheckColor "Moved away", 4, 0, 0, 0
PositionEntity cubes(4), gx(4), gy(4), 0
Frames 1
CheckAll "Moved back"
MoveEntity cubes(5), 0, 100, 0
Frames 20
CheckColor "Moved away, settled", 5, 0, 0, 0
MoveEntity cubes(5), 0, -100, 0
Frames 1
CheckAll "Moved back, settled"
Frames 20
CheckAll "Moved back, and settled again"

; Hidden and shown, freed and made again.
HideEntity cubes(6)
Frames 1
CheckColor "Hidden", 6, 0, 0, 0
Frames 20
CheckColor "Hidden, settled", 6, 0, 0, 0
ShowEntity cubes(6)
Frames 1
CheckColor "Shown", 6, cr(6), cg(6), cb(6)
Frames 20
CheckAll "Shown, settled"
FreeEntity cubes(7)
Frames 1
CheckColor "Freed", 7, 0, 0, 0
spare = CreateCube()
EntityFX spare, 1
EntityColor spare, 10, 20, 250
PositionEntity spare, gx(7), gy(7), 0
cubes(7) = spare : cr(7) = 10 : cg(7) = 20 : cb(7) = 250
Frames 1
CheckAll "Made again in the place of the freed one"
Frames 20
CheckAll "Made again, settled"

; See-through things are drawn after the solid ones, and are not in the table.
EntityAlpha cubes(8), 0.5
Frames 1
CheckColor "Half see-through", 8, cr(8) / 2, cg(8) / 2, cb(8) / 2, 6
Frames 20
CheckColor "Half see-through, settled", 8, cr(8) / 2, cg(8) / 2, cb(8) / 2, 6
EntityAlpha cubes(8), 1.0
Frames 1
CheckColor "Solid again", 8, cr(8), cg(8), cb(8)
Frames 20
CheckAll "Solid again, settled"

; A texture changes how everything that has it looks, also for the cubes that are in the table.
tex = CreateTexture(4, 4, 1 + 4096)
SetBuffer TextureBuffer(tex)
ClsColor 0, 255, 0
Cls
SetBuffer BackBuffer()
EntityColor cubes(9), 255, 255, 255
EntityTexture cubes(9), tex
cr(9) = 0 : cg(9) = 255 : cb(9) = 0
Frames 1
CheckAll "Textured"
Frames 20
CheckAll "Textured, settled"
SetBuffer TextureBuffer(tex)
ClsColor 255, 0, 255
Cls
SetBuffer BackBuffer()
cr(9) = 255 : cg(9) = 0 : cb(9) = 255
Frames 1
CheckAll "Texture drawn to"
Frames 20
CheckAll "Texture drawn to, settled"
ScaleTexture tex, 2, 2
Frames 1
CheckAll "Texture scaled"
Frames 20
CheckAll "Texture scaled, settled"

; Cubes that are lit change with the lights.
EntityFX cubes(10), 0
EntityColor cubes(10), 255, 255, 255
PositionEntity light, 0, 0, -100
Frames 20
lit = (Middle(10) Shr 16) And 255
CheckTrue "Lit cube is bright (" + lit + ")", lit > 120
LightColor light, 40, 40, 40
Frames 1
darker = (Middle(10) Shr 16) And 255
CheckTrue "Lit cube is dimmer with the light (" + darker + ")", darker < lit - 60
Frames 20
darker2 = (Middle(10) Shr 16) And 255
Check "Lit cube is as dim when settled", darker2, darker, 3
LightColor light, 255, 255, 255
Frames 1
Check "Light back", (Middle(10) Shr 16) And 255, lit, 3
Frames 20
Check "Light back, settled", (Middle(10) Shr 16) And 255, lit, 3
EntityFX cubes(10), 1
EntityColor cubes(10), cr(10), cg(10), cb(10)
Frames 20
CheckAll "Lit cube back to full-bright"

; The camera moves, and the cubes are seen from other places.
For walk = 1 To 10
	MoveEntity camera, 0.4, 0.15, 0.3
	TurnEntity camera, 0, -0.1, 0
	Frames 1
	CheckAll "Camera walk " + walk
Next
Frames 20
CheckAll "Camera moved, settled"

; A second camera that sees them from another side draws the same table.
camera2 = CreateCamera()
CameraViewport camera2, 0, 0, 40, 30
CameraClsColor camera2, 0, 0, 0
PositionEntity camera2, 0, 0, -60
Frames 3
CheckAll "Second camera"
HideEntity camera2
FreeEntity camera2
Frames 3
CheckAll "Second camera gone"

Done "blitz3d_gpu_draws_pixels"
