; Dither in 3D, which needs a window and a GPU, so this is skipped without one. The shader adds noise of less than half
; a step of 8 bits to what it makes (lighting, textures, fog) before it is rounded: a smooth fog gradient then has pixels
; that are one step off what it is without Dither, none that are two, and exact colors do not change at all.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_dither_pixels: skipped, there is no window."
	End
EndIf

Const W = 128, H = 96
Graphics3D W, H, 32, 2
SetBuffer BackBuffer()

camera = CreateCamera()
PositionEntity camera, 0, 2, -3
RotateEntity camera, 25, 0, 0
CameraClsColor camera, 0, 0, 0
CameraFogMode camera, 1
CameraFogRange camera, 1, 40
CameraFogColor camera, 200, 60, 20
CameraRange camera, 0.1, 100

; A bright floor that fades into the fog with the distance.
floor = CreatePlane()
EntityFX floor, 1
EntityColor floor, 40, 40, 40

Dim off(H), on(H), again(H)


Function Render(mode)
	Dither mode
	RenderWorld
End Function

; Off
Render 0
For y = 0 To H - 1 : off(y) = ReadPixel(W / 2, y, BackBuffer()) And $FFFFFF : Next
Render 0
For y = 0 To H - 1 : again(y) = ReadPixel(W / 2, y, BackBuffer()) And $FFFFFF : Next
Render 1
For y = 0 To H - 1 : on(y) = ReadPixel(W / 2, y, BackBuffer()) And $FFFFFF : Next

Function Channel(c, shift)
	Return (c Shr shift) And 255
End Function

same = 1
For y = 0 To H - 1
	If off(y) <> again(y) Then same = 0
Next
CheckTrue "Without Dither two frames are the same", same

changed = 0 : worst = 0
For y = 0 To H - 1
	For shift = 0 To 16 Step 8
		d = Abs(Channel(on(y), shift) - Channel(off(y), shift))
		If d > worst Then worst = d
		If d > 0 Then changed = changed + 1
	Next
Next
CheckTrue "Dither changes pixels of the gradient", changed > 10
Check "Dither changes no channel by more than one step", worst, 1
Done "blitz3d_dither_pixels"
