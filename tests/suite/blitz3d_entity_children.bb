; Copies, parents and FreeEntity keep the children right: they are counted by the entities, and slots of freed entities are used again.
Include "check.bb"

Graphics3D 320, 240, 32, 2

parent = CreatePivot()
a = CreatePivot(parent)
b = CreatePivot(parent)
c = CreatePivot(a)
Check "Children of the parent", CountChildren(parent), 2
Check "Children of a", CountChildren(a), 1

; A copy has its own copies of the children, at any depth.
copy = CopyEntity(parent)
Check "Children of the copy", CountChildren(copy), 2
Check "Grandchildren of the copy", CountChildren(GetChild(copy, 1)) + CountChildren(GetChild(copy, 2)), 1
Check "The original keeps its children", CountChildren(parent), 2

; Moving a child to another parent moves the count.
EntityParent b, copy
Check "Children of the parent after EntityParent", CountChildren(parent), 1
Check "Children of the copy after EntityParent", CountChildren(copy), 3
EntityParent b, 0
Check "Children of the copy after the child left", CountChildren(copy), 2

; FreeEntity takes the children with it, FreeEntity of a child tells its parent.
FreeEntity c
Check "Children of a after FreeEntity of its child", CountChildren(a), 0
FreeEntity parent
Check "The copy is not touched", CountChildren(copy), 2

; The slot of a freed entity is used by the next one.
x = CreatePivot()
FreeEntity x
y = CreatePivot()
Check "A freed handle is used again", y, x
EndGraphics
Done "blitz3d_entity_children"
