; Samplers work as objects without a window: CreateSampler FreeSampler SamplerFilterMin SamplerFilterMag
; SamplerFilterMip SamplerBorderColor GetSamplerFilterMin GetSamplerFilterMag GetSamplerFilterMip GetSamplerAnisotropy
; GetSamplerAddressModeU GetSamplerAddressModeV GetSamplerAddressModeW GetSamplerLodBias GetSamplerLodMin GetSamplerLodMax
; GetSamplerBorderColorR GetSamplerBorderColorG GetSamplerBorderColorB GetSamplerBorderColorA SamplerAnisotropy SamplerAddressModeU SamplerAddressModeV SamplerAddressModeW
; SamplerLodBias SamplerLodMin SamplerLodMax
; TextureSampler.
Include "check.bb"

a = CreateSampler()
b = CreateSampler()
CheckTrue "CreateSampler", a <> 0
CheckTrue "Samplers are different", a <> b

SamplerFilterMin a, 0
SamplerFilterMag a, 1
SamplerFilterMip a, 0
SamplerAnisotropy a, 4.0
SamplerAddressModeU a, 1
SamplerAddressModeV a, 2
SamplerAddressModeW a, 3
SamplerLodBias a, -0.5
SamplerLodMin a, 1.0
SamplerLodMax a, 3.0

SamplerBorderColor a, 0.25, 0.5, 0.75, 1.5

Check "Defaults, filter min", GetSamplerFilterMin(b), 1
Check "Defaults, filter mag", GetSamplerFilterMag(b), 1
Check "Defaults, filter mip", GetSamplerFilterMip(b), 1
Check "Defaults, anisotropy", GetSamplerAnisotropy(b), 1
Check "Defaults, address mode U", GetSamplerAddressModeU(b), 0
Check "Defaults, lod max", GetSamplerLodMax(b), 1000
Check "Defaults, border alpha", GetSamplerBorderColorA(b), 1
Check "Defaults, border red", GetSamplerBorderColorR(b), 0

Check "GetSamplerFilterMin", GetSamplerFilterMin(a), 0
Check "GetSamplerFilterMag", GetSamplerFilterMag(a), 1
Check "GetSamplerFilterMip", GetSamplerFilterMip(a), 0
Check "GetSamplerAnisotropy", GetSamplerAnisotropy(a), 4
Check "GetSamplerAddressModeU", GetSamplerAddressModeU(a), 1
Check "GetSamplerAddressModeV", GetSamplerAddressModeV(a), 2
Check "GetSamplerAddressModeW", GetSamplerAddressModeW(a), 3
Check "GetSamplerLodBias", GetSamplerLodBias(a), -0.5
Check "GetSamplerLodMin", GetSamplerLodMin(a), 1
Check "GetSamplerLodMax", GetSamplerLodMax(a), 3
Check "GetSamplerBorderColorR", GetSamplerBorderColorR(a), 0.25
Check "GetSamplerBorderColorG", GetSamplerBorderColorG(a), 0.5
Check "GetSamplerBorderColorB", GetSamplerBorderColorB(a), 0.75
Check "Border alpha is kept inside 0 to 1", GetSamplerBorderColorA(a), 1

FreeSampler a
c = CreateSampler()
Check "A freed sampler is used again", c, a

FreeSampler b
FreeSampler c

Done "blitz3d_samplers"
