; Samplers work as objects without a window: CreateSampler FreeSampler SetSamplerFilterMin SetSamplerFilterMag
; SetSamplerFilterMip SetSamplerBorderColor GetSamplerFilterMin GetSamplerFilterMag GetSamplerFilterMip GetSamplerAnisotropy
; GetSamplerAddressModeU GetSamplerAddressModeV GetSamplerAddressModeW GetSamplerLodBias GetSamplerLodMin GetSamplerLodMax
; GetSamplerBorderColorR GetSamplerBorderColorG GetSamplerBorderColorB GetSamplerBorderColorA SetSamplerAnisotropy SetSamplerAddressModeU SetSamplerAddressModeV SetSamplerAddressModeW
; SetSamplerLodBias SetSamplerLodMin SetSamplerLodMax
; SetTextureSampler.
Include "check.bb"

a = CreateSampler()
b = CreateSampler()
CheckTrue "CreateSampler", a <> 0
CheckTrue "Samplers are different", a <> b

SetSamplerFilterMin a, 0
SetSamplerFilterMag a, 1
SetSamplerFilterMip a, 0
SetSamplerAnisotropy a, 4.0
SetSamplerAddressModeU a, 1
SetSamplerAddressModeV a, 2
SetSamplerAddressModeW a, 3
SetSamplerLodBias a, -0.5
SetSamplerLodMin a, 1.0
SetSamplerLodMax a, 3.0

SetSamplerBorderColor a, 0.25, 0.5, 0.75, 1.5

Check "Defaults, filter min", GetSamplerFilterMin(b), 1
Check "Defaults, filter mag", GetSamplerFilterMag(b), 1
Check "Defaults, filter mip", GetSamplerFilterMip(b), 1
Check "Defaults, anisotropy", GetSamplerAnisotropy(b), 1
Check "Defaults, address mode U", GetSamplerAddressModeU(b), 0
Check "Defaults, lod max", GetSamplerLodMax(b), 1000
Check "Defaults, border alpha", GetSamplerBorderColorA(b), 1
Check "Defaults, border red", GetSamplerBorderColorR(b), 0

Check "GetSamplerFilterMin", GetSamplerFilterMin(a), 0
Check "GetSamplerFilterMag", GetSamplerFilterMag(a), 1
Check "GetSamplerFilterMip", GetSamplerFilterMip(a), 0
Check "GetSamplerAnisotropy", GetSamplerAnisotropy(a), 4
Check "GetSamplerAddressModeU", GetSamplerAddressModeU(a), 1
Check "GetSamplerAddressModeV", GetSamplerAddressModeV(a), 2
Check "GetSamplerAddressModeW", GetSamplerAddressModeW(a), 3
Check "GetSamplerLodBias", GetSamplerLodBias(a), -0.5
Check "GetSamplerLodMin", GetSamplerLodMin(a), 1
Check "GetSamplerLodMax", GetSamplerLodMax(a), 3
Check "GetSamplerBorderColorR", GetSamplerBorderColorR(a), 0.25
Check "GetSamplerBorderColorG", GetSamplerBorderColorG(a), 0.5
Check "GetSamplerBorderColorB", GetSamplerBorderColorB(a), 0.75
Check "Border alpha is kept inside 0 to 1", GetSamplerBorderColorA(a), 1

FreeSampler a
c = CreateSampler()
Check "A freed sampler is used again", c, a

FreeSampler b
FreeSampler c

; A handle that is not a sampler does nothing, and a getter gives 0 (a debug build stops instead).
Local gone = c
SetSamplerFilterMin gone, 0
SetSamplerFilterMag gone, 0
SetSamplerFilterMip gone, 0
SetSamplerAnisotropy gone, 4.0
SetSamplerAddressModeU gone, 1
SetSamplerAddressModeV gone, 1
SetSamplerAddressModeW gone, 1
SetSamplerLodBias gone, 1.0
SetSamplerLodMin gone, 1.0
SetSamplerLodMax gone, 1.0
SetSamplerBorderColor gone, 1.0, 1.0, 1.0, 1.0
SetTextureSampler 0, gone
SetTextureSampler 12345, 0
FreeSampler gone
FreeSampler 0
FreeSampler -1
FreeSampler 99999
Check "Freed sampler, GetSamplerFilterMin", GetSamplerFilterMin(gone), 0
Check "Freed sampler, GetSamplerFilterMag", GetSamplerFilterMag(gone), 0
Check "Freed sampler, GetSamplerFilterMip", GetSamplerFilterMip(gone), 0
Check "Freed sampler, GetSamplerAnisotropy", GetSamplerAnisotropy(gone), 0
Check "Freed sampler, GetSamplerAddressModeU", GetSamplerAddressModeU(gone), 0
Check "Freed sampler, GetSamplerAddressModeV", GetSamplerAddressModeV(gone), 0
Check "Freed sampler, GetSamplerAddressModeW", GetSamplerAddressModeW(gone), 0
Check "Freed sampler, GetSamplerLodBias", GetSamplerLodBias(gone), 0
Check "Freed sampler, GetSamplerLodMin", GetSamplerLodMin(gone), 0
Check "Freed sampler, GetSamplerLodMax", GetSamplerLodMax(gone), 0
Check "Freed sampler, GetSamplerBorderColorR", GetSamplerBorderColorR(gone), 0
Check "Freed sampler, GetSamplerBorderColorG", GetSamplerBorderColorG(gone), 0
Check "Freed sampler, GetSamplerBorderColorB", GetSamplerBorderColorB(gone), 0
Check "Freed sampler, GetSamplerBorderColorA", GetSamplerBorderColorA(gone), 0
Check "Sampler 0, GetSamplerFilterMin", GetSamplerFilterMin(0), 0
Check "Sampler -1, GetSamplerAnisotropy", GetSamplerAnisotropy(-1), 0
Check "Sampler 99999, GetSamplerLodMax", GetSamplerLodMax(99999), 0

Done "blitz3d_samplers"
