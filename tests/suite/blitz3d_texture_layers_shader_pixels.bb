; The texture layers of an entity are blended by the fragment shader, in one draw: every TextureBlend on a layer after the first, more than
; two layers in a row, a layer with its own coordinates and on something that is see-through. Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_texture_layers_shader_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global camera = CreateCamera()
PositionEntity camera, 0, 0, -3
CameraClsColor camera, 0, 0, 0
Global quad = CreateMesh()
s = CreateSurface(quad)
v = AddVertex(s, -4, 4, 0, 0, 0)  : VertexNormal s, v, 0, 0, -1
v = AddVertex(s, 4, 4, 0, 1, 0)   : VertexNormal s, v, 0, 0, -1
v = AddVertex(s, 4, -4, 0, 1, 1)  : VertexNormal s, v, 0, 0, -1
v = AddVertex(s, -4, -4, 0, 0, 1) : VertexNormal s, v, 0, 0, -1
AddTriangle s, 0, 1, 2
AddTriangle s, 0, 2, 3
EntityFX quad, 1 ; Full bright: the lit color is the color of the entity.

Function Flat(r, g, b)
	Local t = CreateTexture(4, 4, 1 + 4096)
	SetBuffer TextureBuffer(t)
	Color r, g, b
	Rect 0, 0, 4, 4, 1
	SetBuffer BackBuffer()
	Return t
End Function

; Red on the left half, green on the right half.
Function Halves()
	Local t = CreateTexture(4, 4, 1 + 4096)
	SetBuffer TextureBuffer(t)
	Color 255, 0, 0
	Rect 0, 0, 2, 4, 1
	Color 0, 255, 0
	Rect 2, 0, 2, 4, 1
	SetBuffer BackBuffer()
	Return t
End Function

Global a = Flat(200, 100, 50)
Global b = Flat(180, 90, 140)
Global c = Flat(60, 120, 30)

Function Center()
	RenderWorld
	Return ReadPixel(80, 60, BackBuffer()) And $FFFFFF
End Function

Function Channel(p, shift)
	Return (p Shr shift) And 255
End Function

Function CheckPixel(name$, p, r, g, b, tolerance)
	Check name + " red", Float(Channel(p, 16)), Float(r), Float(tolerance)
	Check name + " green", Float(Channel(p, 8)), Float(g), Float(tolerance)
	Check name + " blue", Float(Channel(p, 0)), Float(b), Float(tolerance)
End Function

Function Clamp255(x#)
	If x < 0 Then x = 0
	If x > 255 Then x = 255
	Return Int(x + 0.5)
End Function

; Every TextureBlend on the second layer, on top of a multiplied base (200, 100, 50).
TextureBlend a, 2
EntityTexture quad, a, 0, 0

TextureBlend b, 2 ; Multiply
EntityTexture quad, b, 0, 1
CheckPixel "multiply", Center(), 200 * 180 / 255, 100 * 90 / 255, 50 * 140 / 255, 2

TextureBlend b, 3 ; Add
EntityTexture quad, b, 0, 1
CheckPixel "add", Center(), Clamp255(200 + 180), Clamp255(100 + 90), Clamp255(50 + 140), 2

TextureBlend b, 5 ; Multiply 2x
EntityTexture quad, b, 0, 1
CheckPixel "multiply 2x", Center(), Clamp255(2 * 200 * 180 / 255.0), Clamp255(2 * 100 * 90 / 255.0), Clamp255(2 * 50 * 140 / 255.0), 2

; Alpha: a texture without an alpha channel has an alpha of 1, so it replaces what is under it.
TextureBlend b, 1
EntityTexture quad, b, 0, 1
CheckPixel "alpha without alpha channel", Center(), 180, 90, 140, 2

; Three layers in a row are three stages: (base * layer 2) + layer 3.
TextureBlend b, 2
TextureBlend c, 3
EntityTexture quad, b, 0, 1
EntityTexture quad, c, 0, 2
CheckPixel "three layers", Center(), Clamp255(200 * 180 / 255.0 + 60), Clamp255(100 * 90 / 255.0 + 120), Clamp255(50 * 140 / 255.0 + 30), 2

; Four layers: ... then multiplied by the fourth.
d = Flat(128, 255, 64)
TextureBlend d, 2
EntityTexture quad, d, 0, 3
CheckPixel "four layers", Center(), Clamp255((200 * 180 / 255.0 + 60) * 128 / 255.0), Clamp255((100 * 90 / 255.0 + 120) * 255 / 255.0), Clamp255((50 * 140 / 255.0 + 30) * 64 / 255.0), 2
EntityTexture quad, 0, 0, 3
EntityTexture quad, 0, 0, 2

; A layer has coordinates of its own: scaled by 2 the middle of the quad is in the left half of the texture (red), and moved by a quarter of
; the texture it is in the right half (green).
h = Halves()
TextureBlend h, 2
EntityTexture quad, Flat(255, 255, 255), 0, 0
EntityTexture quad, h, 0, 1
ScaleTexture h, 2, 1
CheckPixel "layer with its own scale", Center(), 255, 0, 0, 2
ScaleTexture h, 1, 1
PositionTexture h, 0.25, 0
CheckPixel "layer with its own offset", Center(), 0, 255, 0, 2
PositionTexture h, 0, 0

; Something see-through: the layers are blended on it as well.
EntityTexture quad, a, 0, 0
TextureBlend b, 2
EntityTexture quad, b, 0, 1
EntityTexture quad, 0, 0, 2
EntityAlpha quad, 0.5
shown = Center()
CheckPixel "layers on something see-through", shown, Int(200 * 180 / 255.0 * 0.5), Int(100 * 90 / 255.0 * 0.5), Int(50 * 140 / 255.0 * 0.5), 3
EntityAlpha quad, 1.0

Done "blitz3d_texture_layers_shader_pixels"
