; Queries and contacts of the physics worlds. Names: PhysicsRayCast PhysicsPointInside PhysicsOverlapSphere PhysicsOverlapBox
; GetPhysicsOverlap GetPhysicsHitEntity GetPhysicsHitX GetPhysicsHitY GetPhysicsHitZ GetPhysicsHitNX GetPhysicsHitNY GetPhysicsHitNZ
; GetPhysicsHitDistance PhysicsContactReport GetPhysicsContactReport GetPhysicsContactCount GetPhysicsContactEntityA
; GetPhysicsContactEntityB GetPhysicsContactX GetPhysicsContactY GetPhysicsContactZ GetPhysicsContactNX GetPhysicsContactNY
; GetPhysicsContactNZ GetPhysicsContactDepth GetPhysicsContactSensor.
Include "check.bb"

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Const DT# = 1.0 / 60.0

; The top of the floor is at y = 0.
floor = CreatePhysicsBody(1, 1, 50, 0.5, 50)
PositionEntity floor, 0, -0.5, 0
wall = CreatePhysicsBody(1, 1, 1, 1, 1)
PositionEntity wall, 5, 1, 0
PhysicsLayer wall, 3, -1, -1
region = CreatePhysicsBody(1, 1, 1, 1, 1)
PositionEntity region, 10, 1, 0
PhysicsSensor region, True
PhysicsLayer region, 4, -1, -1

; ---- Rays
hit = PhysicsRayCast(0, 5, 0, 0, -5, 0)
Check "the ray hits the floor", hit, floor
Check "hit entity", GetPhysicsHitEntity(), floor
Check "hit y", GetPhysicsHitY(), 0, 0.001
Check "hit x", GetPhysicsHitX(), 0, 0.001
Check "hit normal", GetPhysicsHitNY(), 1, 0.001
Check "hit normal x", GetPhysicsHitNX(), 0, 0.001
Check "hit distance", GetPhysicsHitDistance(), 5, 0.001
Check "a ray that is too short", PhysicsRayCast(0, 5, 0, 0, 3, 0), 0
Check "nothing is kept", GetPhysicsHitEntity(), 0
hit = PhysicsRayCast(0, 1, 0, 20, 1, 0)
Check "the ray hits the wall", hit, wall
Check "wall x", GetPhysicsHitX(), 4, 0.001
Check "wall normal", GetPhysicsHitNX(), -1, 0.001
Check "wall distance", GetPhysicsHitDistance(), 4, 0.001
; Layer 3 is left out (bit 3 of the low mask), and the sensor is skipped unless asked for.
Check "a layer left out", PhysicsRayCast(0, 1, 0, 20, 1, 0, -1 - 8), 0
Check "a sensor is found when asked", PhysicsRayCast(0, 1, 0, 20, 1, 0, -1 - 8, -1, 1), region

; ---- Points
Check "inside the wall", PhysicsPointInside(5.5, 1, 0), wall
Check "outside", PhysicsPointInside(7, 1, 0), 0
Check "a sensor is skipped", PhysicsPointInside(10, 1, 0), 0
Check "a sensor is found when asked", PhysicsPointInside(10, 1, 0, -1, -1, 1), region
Check "the point", GetPhysicsHitX(), 10, 0.001

; ---- Overlaps
Check "a small sphere", PhysicsOverlapSphere(5, 1, 0, 0.5), 1
Check "its entity", GetPhysicsOverlap(0), wall
; The big sphere reaches the floor and the wall; with sensors and the sensor too.
Check "a big sphere", PhysicsOverlapSphere(7.5, 1, 0, 3), 2
Check "a big sphere with sensors", PhysicsOverlapSphere(7.5, 1, 0, 3, -1, -1, 1), 3
Check "in the order they were made 1", GetPhysicsOverlap(0), floor
Check "in the order they were made 2", GetPhysicsOverlap(1), wall
Check "in the order they were made 3", GetPhysicsOverlap(2), region
Check "a box", PhysicsOverlapBox(0, 0.5, 0, 1, 1, 1), 1
Check "its entity (box)", GetPhysicsOverlap(0), floor
Check "no layers", PhysicsOverlapBox(0, 0.5, 0, 1, 1, 1, 0, 0), 0

; ---- Another world has its own bodies
other = CreatePhysicsWorld()
Check "nothing in the other world", PhysicsRayCast(0, 5, 0, 0, -5, 0, -1, -1, 0, other), 0
alone = CreatePhysicsBody(1, 1, 1, 1, 1, 0, other)
PositionEntity alone, 0, 3, 0
Check "the other world finds its body", PhysicsPointInside(0, 3, 0, -1, -1, 0, other), alone
Check "the default world does not", PhysicsPointInside(0, 3, 0), 0
FreeEntity alone
FreePhysicsWorld other

; ---- Contacts
ball = CreatePhysicsBody(2, 3, 0.5, 0, 0)
PositionEntity ball, 0, 0.6, 0
CheckTrue "contacts are not reported by default", GetPhysicsContactReport(ball) = 0
PhysicsUpdate DT
Check "no contacts without a report", GetPhysicsContactCount(), 0
PhysicsContactReport ball, True
CheckTrue "reporting", GetPhysicsContactReport(ball) = 1
For i = 1 To 30
	PhysicsUpdate DT
Next
Check "ball and floor touch", GetPhysicsContactCount(), 1
a = GetPhysicsContactEntityA(0)
b = GetPhysicsContactEntityB(0)
CheckTrue "the pair", (a = ball And b = floor) Or (a = floor And b = ball)
Check "no sensor", GetPhysicsContactSensor(0), 0
CheckTrue "the contact is at the floor", Abs(GetPhysicsContactY(0)) < 0.2
CheckTrue "the contact is under the ball", Abs(GetPhysicsContactX(0)) < 0.2 And Abs(GetPhysicsContactZ(0)) < 0.2
CheckTrue "the normal is vertical", Abs(GetPhysicsContactNY(0)) > 0.9 And Abs(GetPhysicsContactNX(0)) < 0.2 And Abs(GetPhysicsContactNZ(0)) < 0.2
CheckTrue "the depth is small", GetPhysicsContactDepth(0) >= 0 And GetPhysicsContactDepth(0) < 0.1

; A ball that is in the sensor is listed with the sensor flag.
PositionEntity ball, 10, 1, 0
PhysicsLinearVelocity ball, 0, 0, 0, True
PhysicsGravityScale ball, 0
PhysicsUpdate DT
Check "in the region", GetPhysicsContactCount(), 1
Check "the sensor flag", GetPhysicsContactSensor(0), 1
PositionEntity ball, 30, 30, 0
PhysicsUpdate DT
Check "out of the region", GetPhysicsContactCount(), 0
PhysicsContactReport ball, False
CheckTrue "no longer reporting", GetPhysicsContactReport(ball) = 0

Done "blitz3d_physics_queries"
