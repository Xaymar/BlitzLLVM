; 2D graphics that can be told without looking at pixels: Graphics Graphics3D EndGraphics GraphicsWidth GraphicsHeight
; GraphicsDepth GfxMode3DExists Windowed3D AvailVidMem TotalVidMem SetBuffer BackBuffer FrontBuffer Flip Cls ClsColor
; Color ColorRed ColorGreen ColorBlue GetColor StringWidth StringHeight Text Print Write Input CreateImage LoadImage
; LoadAnimImage FreeImage ImageWidth ImageHeight ResizeImage MaskImage MidHandle HandleImage AutoMidHandle ImageBuffer
; HidePointer ShowPointer. What ends up on the screen is in graphics_pixels.bb.
Include "check.bb"

; Opening a window, and what it says about itself.
Graphics 320, 240, 32, 2
Check "GraphicsWidth", GraphicsWidth(), 320
Check "GraphicsHeight", GraphicsHeight(), 240
Check "GraphicsDepth", GraphicsDepth(), 32
SetBuffer BackBuffer()
CheckTrue "BackBuffer", BackBuffer() <> 0
CheckTrue "FrontBuffer", FrontBuffer() <> 0
CheckTrue "The buffers are different", BackBuffer() <> FrontBuffer()
Check "BackBuffer stays the same", BackBuffer(), BackBuffer()
Flip
Flip False
Cls
suite_checks = suite_checks + 3
EndGraphics

; A different size, in 3D.
Graphics3D 400, 300, 32, 2
Check "Graphics3D width", GraphicsWidth(), 400
Check "Graphics3D height", GraphicsHeight(), 300
CheckTrue "Windowed3D", Windowed3D() = 0 Or Windowed3D() = 1
CheckTrue "GfxMode3DExists", GfxMode3DExists(400, 300, 32) = 0 Or GfxMode3DExists(400, 300, 32) = 1
CheckTrue "AvailVidMem", AvailVidMem() >= 0
CheckTrue "TotalVidMem", TotalVidMem() >= AvailVidMem()
EndGraphics

Graphics 320, 240, 32, 2
SetBuffer BackBuffer()

; Drawing colors are 0 to 255, and are kept inside that.
Color 10, 20, 30
Check "ColorRed", ColorRed(), 10
Check "ColorGreen", ColorGreen(), 20
Check "ColorBlue", ColorBlue(), 30
Color 300, -5, 255
Check "ColorRed clamped", ColorRed(), 255
Check "ColorGreen clamped", ColorGreen(), 0
Check "ColorBlue clamped", ColorBlue(), 255
Color 1, 2, 3
ClsColor 40, 50, 60
Check "ClsColor does not change Color", ColorRed(), 1
Cls
Color 255, 255, 255
Check "Color white", ColorGreen(), 255

; Strings have a size on the screen that grows with their length.
w1 = StringWidth("a")
CheckTrue "StringWidth", w1 > 0
Check "StringWidth is linear", StringWidth("aaaa"), w1 * 4
Check "StringWidth empty", StringWidth(""), 0
CheckTrue "StringHeight", StringHeight("a") > 0
Check "StringHeight does not depend on the text", StringHeight("abc"), StringHeight("a")

; Text, Print and Write draw to the buffer, and do nothing that could go wrong without one.
Text 10, 10, "Text"
Text 100, 10, "Centered", True, False
Text 100, 30, "Centered both", True, True
Text 0, 0, ""
Print "Print"
Write "Write"
Print ""
If KeyDown(255) And KeyDown(254) Then line$ = Input$("Input: ")
suite_checks = suite_checks + 7

; Images have the size they were created with.
image = CreateImage(32, 16)
CheckTrue "CreateImage", image <> 0
Check "ImageWidth", ImageWidth(image), 32
Check "ImageHeight", ImageHeight(image), 16
Check "ImageBuffer", ImageBuffer(image) <> 0, 1
frames = CreateImage(8, 8, 4)
Check "CreateImage with frames width", ImageWidth(frames), 8
Check "CreateImage with frames height", ImageHeight(frames), 8
CheckTrue "ImageBuffer of a frame", ImageBuffer(frames, 3) <> 0
CheckTrue "ImageBuffer of frames differ", ImageBuffer(frames, 0) <> ImageBuffer(frames, 3)

; Handles are where the picture is held when it is drawn.
MidHandle image
HandleImage image, 3, 4
MaskImage image, 255, 0, 255
AutoMidHandle True
AutoMidHandle False
suite_checks = suite_checks + 4

; Resizing makes it a different size.
ResizeImage image, 64, 8
Check "ResizeImage width", ImageWidth(image), 64
Check "ResizeImage height", ImageHeight(image), 8

If GetEnv$("BLITZ_HEADLESS") = "" Then
	; Images come from files, with frames next to each other. Without a window nothing is drawn, so nothing is saved.
	folder$ = "suite_tmp_graphics"
	CreateDir folder
	SetBuffer ImageBuffer(frames, 0)
	Cls
	SetBuffer BackBuffer()
	SaveImage frames, folder + "/frames.bmp", 0
	loaded = LoadImage(folder + "/frames.bmp")
	CheckTrue "LoadImage", loaded <> 0
	Check "LoadImage width", ImageWidth(loaded), 8
	Check "LoadImage height", ImageHeight(loaded), 8
	Check "LoadImage missing", LoadImage(folder + "/missing.bmp"), 0
	sheet = CreateImage(32, 8)
	SaveImage sheet, folder + "/sheet.bmp"
	animated = LoadAnimImage(folder + "/sheet.bmp", 8, 8, 0, 4)
	CheckTrue "LoadAnimImage", animated <> 0
	Check "LoadAnimImage width", ImageWidth(animated), 8
	Check "LoadAnimImage height", ImageHeight(animated), 8
	Check "LoadAnimImage missing", LoadAnimImage(folder + "/missing.bmp", 8, 8, 0, 4), 0
	CheckTrue "LoadAnimImage frames", ImageBuffer(animated, 3) <> 0

	FreeImage loaded
	FreeImage animated
	FreeImage sheet
	DeleteFile folder + "/frames.bmp"
	DeleteFile folder + "/sheet.bmp"

EndIf
FreeImage frames
FreeImage image

HidePointer
ShowPointer
suite_checks = suite_checks + 2

EndGraphics
Done "graphics"
