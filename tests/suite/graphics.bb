; 2D graphics that can be told without looking at pixels: Graphics Graphics3D EndGraphics GraphicsWidth GraphicsHeight
; GraphicsDepth GfxMode3DExists Windowed3D AvailVidMem TotalVidMem SetBuffer BackBuffer FrontBuffer Flip Cls ClsColor
; Color ColorRed ColorGreen ColorBlue GetColor StringWidth StringHeight Text Print Write Input CreateImage LoadImage
; LoadAnimImage FreeImage ImageWidth ImageHeight ResizeImage MaskImage MidHandle HandleImage AutoMidHandle ImageBuffer
; HidePointer ShowPointer LoadFont SetFont FreeFont FontWidth FontHeight FontName FontSize FontStyle FontAscent
; FontDescent Origin Viewport Locate
; ImageXHandle ImageYHandle RectsOverlap ImagesOverlap ImageRectOverlap CopyImage ScaleImage RotateImage TFormImage
; TFormFilter. What ends up on the screen is in graphics_pixels.bb.
Include "check.bb"

; Opening a window, and what it says about itself.
Graphics 320, 240, 32, 2
Check "GraphicsWidth", GraphicsWidth(), 320
Check "GraphicsHeight", GraphicsHeight(), 240
Check "GraphicsDepth", GraphicsDepth(), 32
SetBuffer BackBuffer()
CheckTrue "BackBuffer", BackBuffer() <> 0
CheckTrue "FrontBuffer", FrontBuffer() <> 0
CheckTrue "The buffers are different", BackBuffer() <> FrontBuffer()
Check "BackBuffer stays the same", BackBuffer(), BackBuffer()
Flip
Flip False
Cls
suite_checks = suite_checks + 3
EndGraphics

; A different size, in 3D.
Graphics3D 400, 300, 32, 2
Check "Graphics3D width", GraphicsWidth(), 400
Check "Graphics3D height", GraphicsHeight(), 300
CheckTrue "Windowed3D", Windowed3D() = 0 Or Windowed3D() = 1
CheckTrue "GfxMode3DExists", GfxMode3DExists(400, 300, 32) = 0 Or GfxMode3DExists(400, 300, 32) = 1
CheckTrue "AvailVidMem", AvailVidMem() >= 0
CheckTrue "TotalVidMem", TotalVidMem() >= AvailVidMem()
EndGraphics

Graphics 320, 240, 32, 2
SetBuffer BackBuffer()

; Drawing colors are 0 to 255, and are kept inside that.
Color 10, 20, 30
Check "ColorRed", ColorRed(), 10
Check "ColorGreen", ColorGreen(), 20
Check "ColorBlue", ColorBlue(), 30
Color 300, -5, 255
Check "ColorRed clamped", ColorRed(), 255
Check "ColorGreen clamped", ColorGreen(), 0
Check "ColorBlue clamped", ColorBlue(), 255
Color 1, 2, 3
ClsColor 40, 50, 60
Check "ClsColor does not change Color", ColorRed(), 1
Cls
Color 255, 255, 255
Check "Color white", ColorGreen(), 255

; Strings have a size on the screen that grows with their length.
w1 = StringWidth("a")
CheckTrue "StringWidth", w1 > 0
Check "StringWidth is linear", StringWidth("aaaa"), w1 * 4
Check "StringWidth empty", StringWidth(""), 0
CheckTrue "StringHeight", StringHeight("a") > 0
Check "StringHeight does not depend on the text", StringHeight("abc"), StringHeight("a")

; Text, Print and Write draw to the buffer, and do nothing that could go wrong without one.
Text 10, 10, "Text"
Text 100, 10, "Centered", True, False
Text 100, 30, "Centered both", True, True
Text 0, 0, ""
Print "Print"
Write "Write"
Print ""
If KeyDown(255) And KeyDown(254) Then line$ = Input$("Input: ")
suite_checks = suite_checks + 7

; Images have the size they were created with.
image = CreateImage(32, 16)
CheckTrue "CreateImage", image <> 0
Check "ImageWidth", ImageWidth(image), 32
Check "ImageHeight", ImageHeight(image), 16
Check "ImageBuffer", ImageBuffer(image) <> 0, 1
frames = CreateImage(8, 8, 4)
Check "CreateImage with frames width", ImageWidth(frames), 8
Check "CreateImage with frames height", ImageHeight(frames), 8
CheckTrue "ImageBuffer of a frame", ImageBuffer(frames, 3) <> 0
CheckTrue "ImageBuffer of frames differ", ImageBuffer(frames, 0) <> ImageBuffer(frames, 3)

; Handles are where the picture is held when it is drawn.
MidHandle image
HandleImage image, 3, 4
MaskImage image, 255, 0, 255
AutoMidHandle True
AutoMidHandle False
suite_checks = suite_checks + 4

; Resizing makes it a different size.
ResizeImage image, 64, 8
Check "ResizeImage width", ImageWidth(image), 64
Check "ResizeImage height", ImageHeight(image), 8

If GetEnv$("BLITZ_HEADLESS") = "" Then
	; Images come from files, with frames next to each other. Without a window nothing is drawn, so nothing is saved.
	folder$ = "suite_tmp_graphics"
	CreateDir folder
	SetBuffer ImageBuffer(frames, 0)
	Cls
	SetBuffer BackBuffer()
	SaveImage frames, folder + "/frames.bmp", 0
	loaded = LoadImage(folder + "/frames.bmp")
	CheckTrue "LoadImage", loaded <> 0
	Check "LoadImage width", ImageWidth(loaded), 8
	Check "LoadImage height", ImageHeight(loaded), 8
	Check "LoadImage missing", LoadImage(folder + "/missing.bmp"), 0
	sheet = CreateImage(32, 8)
	SaveImage sheet, folder + "/sheet.bmp"
	animated = LoadAnimImage(folder + "/sheet.bmp", 8, 8, 0, 4)
	CheckTrue "LoadAnimImage", animated <> 0
	Check "LoadAnimImage width", ImageWidth(animated), 8
	Check "LoadAnimImage height", ImageHeight(animated), 8
	Check "LoadAnimImage missing", LoadAnimImage(folder + "/missing.bmp", 8, 8, 0, 4), 0
	CheckTrue "LoadAnimImage frames", ImageBuffer(animated, 3) <> 0

	FreeImage loaded
	FreeImage animated
	FreeImage sheet
	DeleteFile folder + "/frames.bmp"
	DeleteFile folder + "/sheet.bmp"

EndIf
FreeImage frames
FreeImage image

HidePointer
ShowPointer
suite_checks = suite_checks + 2

; Fonts are the built-in font, in the height that was asked for.
Check "FontHeight built in", FontHeight(), 8
Check "FontWidth built in", FontWidth(), 8
font = LoadFont("Arial", 16, 1, 0, 1)
CheckTrue "LoadFont", font <> 0
SetFont font
Check "FontHeight", FontHeight(), 16
Check "FontWidth", FontWidth(), 16
Check "StringWidth with a font", StringWidth("abc"), 48
Check "StringHeight with a font", StringHeight("abc"), 16
CheckS "FontName", FontName$(font), "Arial"
Check "FontSize", FontSize(font), 16
Check "FontStyle", FontStyle(font), 5
Check "FontAscent", FontAscent(font), 12
Check "FontDescent", FontDescent(font), 4
second = LoadFont("Courier", 24)
CheckTrue "LoadFont again", second <> font
Check "FontStyle plain", FontStyle(second), 0
SetFont second
Check "SetFont", FontHeight(), 24
SetFont 0
Check "SetFont 0", FontHeight(), 8
; A font that is freed while it is in use is not used any more.
SetFont font
FreeFont font
Check "FreeFont while in use", FontHeight(), 8
FreeFont second
FreeFont 0
suite_checks = suite_checks + 1

; Handles, and which rectangles touch. An image is drawn with its handle at the position it is given.
shape = CreateImage(16, 8, 3)
HandleImage shape, 5, 3
Check "ImageXHandle", ImageXHandle(shape), 5
Check "ImageYHandle", ImageYHandle(shape), 3
Check "RectsOverlap", RectsOverlap(0, 0, 10, 10, 5, 5, 10, 10), 1
Check "RectsOverlap inside", RectsOverlap(0, 0, 10, 10, 2, 2, 3, 3), 1
Check "RectsOverlap touching", RectsOverlap(0, 0, 10, 10, 10, 0, 10, 10), 0
Check "RectsOverlap apart", RectsOverlap(0, 0, 10, 10, 20, 20, 5, 5), 0
other = CreateImage(8, 8)
Check "ImagesOverlap", ImagesOverlap(shape, 100, 100, other, 100, 100), 1
Check "ImagesOverlap edge", ImagesOverlap(shape, 100, 100, other, 110, 100), 1
Check "ImagesOverlap touching", ImagesOverlap(shape, 100, 100, other, 111, 100), 0
Check "ImagesOverlap above", ImagesOverlap(shape, 100, 100, other, 100, 89), 0
Check "ImageRectOverlap", ImageRectOverlap(shape, 100, 100, 90, 90, 6, 8), 1
Check "ImageRectOverlap touching", ImageRectOverlap(shape, 100, 100, 90, 90, 5, 8), 0

; Copies have the same frames and handle, and are their own image.
copy = CopyImage(shape)
CheckTrue "CopyImage", copy <> 0 And copy <> shape
Check "CopyImage width", ImageWidth(copy), 16
Check "CopyImage height", ImageHeight(copy), 8
Check "CopyImage handle x", ImageXHandle(copy), 5
Check "CopyImage handle y", ImageYHandle(copy), 3
DrawImage copy, 50, 50, 2
HandleImage copy, 0, 0
Check "CopyImage is separate", ImageXHandle(shape), 5
FreeImage copy

; Scaling and rotating make a new picture of the frames, with the handle going along.
ScaleImage other, 2, 3
Check "ScaleImage width", ImageWidth(other), 16
Check "ScaleImage height", ImageHeight(other), 24
plain = CreateImage(20, 10, 2)
RotateImage plain, 90
Check "RotateImage width", ImageWidth(plain), 10, 1
Check "RotateImage height", ImageHeight(plain), 20, 1
DrawImage plain, 10, 10, 1
TFormFilter False
TFormImage plain, 1, 0, 0, 1
Check "TFormImage keeps the size", ImageWidth(plain), 10, 1
TFormFilter True
TFormImage plain, 0.5, 0, 0, 0.5
Check "TFormImage matrix", ImageWidth(plain), 5, 1
Check "TFormImage matrix height", ImageHeight(plain), 10, 1
FreeImage shape
FreeImage other
FreeImage plain

; Origin, Viewport and Locate take what they are given. What they do is in graphics_pixels.bb.
Origin 5, 5
Viewport 10, 10, 20, 20
Locate 3, 4
Origin 0, 0
Viewport 0, 0, GraphicsWidth(), GraphicsHeight()
suite_checks = suite_checks + 1

EndGraphics
Done "graphics"
