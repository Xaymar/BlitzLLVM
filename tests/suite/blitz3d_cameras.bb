; Cameras, lights, sprites and sound in 3D: CreateCamera CameraRange CameraZoom CameraViewport CameraClsColor
; CameraClsMode CameraFogMode CameraFogColor CameraFogRange CameraProjMode CameraProject ProjectedX ProjectedY
; ProjectedZ EntityInView CreateLight LightColor LightRange AmbientLight CreateListener EmitSound CreateSprite
; SpriteViewMode ScaleSprite RotateSprite.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; Points that are straight ahead are in the middle of the view.
camera = CreateCamera()
CheckTrue "CreateCamera", camera <> 0
CameraProject camera, 0, 0, 10
Check "Ahead is the middle x", ProjectedX(), 160, 0.5
Check "Ahead is the middle y", ProjectedY(), 120, 0.5
Check "Ahead has the depth", ProjectedZ(), 10, 0.01

; With the default zoom of 1 the view is 90 degrees wide, so what is as far to the side as it is far away is at the edge.
CameraProject camera, 10, 0, 10
Check "Right edge", ProjectedX(), 320, 0.5
CameraProject camera, -10, 0, 10
Check "Left edge", ProjectedX(), 0, 0.5
; The same angle up and down is further because the view is wider than it is tall.
CameraProject camera, 0, 10, 10
Check "Up is above", ProjectedY(), 120 - 160, 0.5
CameraProject camera, 0, -10, 10
Check "Down is below", ProjectedY(), 120 + 160, 0.5

; Zoom makes things bigger.
CameraZoom camera, 2
CameraProject camera, 5, 0, 10
Check "Zoom 2", ProjectedX(), 320, 0.5
CameraZoom camera, 0.5
CameraProject camera, 10, 0, 10
Check "Zoom 0.5", ProjectedX(), 240, 0.5
CameraZoom camera, 1

; The camera can be somewhere else, and look somewhere else.
PositionEntity camera, 10, 0, 0
CameraProject camera, 10, 0, 10
Check "Moved camera x", ProjectedX(), 160, 0.5
RotateEntity camera, 0, -90, 0
CameraProject camera, 20, 0, 0
Check "Turned camera sees what is to the right", ProjectedX(), 160, 0.5
Check "Turned camera depth", ProjectedZ(), 10, 0.01
PositionEntity camera, 0, 0, 0
RotateEntity camera, 0, 0, 0

; A view that is a part of the buffer is projected into that part.
CameraViewport camera, 40, 30, 160, 120
CameraProject camera, 0, 0, 10
Check "Viewport middle x", ProjectedX(), 120, 0.5
Check "Viewport middle y", ProjectedY(), 90, 0.5
CameraProject camera, 10, 0, 10
Check "Viewport right edge", ProjectedX(), 200, 0.5
CameraViewport camera, 0, 0, 320, 240

; Behind the camera there is nothing to project.
CameraProject camera, 0, 0, -10
CheckTrue "Behind the camera", ProjectedZ() <= 0 Or ProjectedX() < 0 Or ProjectedX() > 320

; Things are only in view between the near and far range, and inside the sides.
thing = CreatePivot()
PositionEntity thing, 0, 0, 50
CheckTrue "EntityInView ahead", EntityInView(thing, camera)
PositionEntity thing, 0, 0, -50
CheckFalse "EntityInView behind", EntityInView(thing, camera)
PositionEntity thing, 500, 0, 50
CheckFalse "EntityInView far to the side", EntityInView(thing, camera)
PositionEntity thing, 0, 0, 500
CheckTrue "EntityInView far ahead", EntityInView(thing, camera)
CameraRange camera, 1, 100
CheckFalse "EntityInView beyond the range", EntityInView(thing, camera)
PositionEntity thing, 0, 0, 0.5
CheckFalse "EntityInView before the near range", EntityInView(thing, camera)
CameraRange camera, 0.1, 1000
CheckTrue "EntityInView with a nearer range", EntityInView(thing, camera)

; A mesh is in view if any part of it is.
big = CreateCube()
ScaleEntity big, 10, 10, 10
PositionEntity big, 14, 0, 12
CheckTrue "EntityInView for a part of a mesh", EntityInView(big, camera)
PositionEntity big, 60, 0, 12
CheckFalse "EntityInView for a mesh to the side", EntityInView(big, camera)
FreeEntity big
FreeEntity thing

; Clearing and fog are what is told to the camera, which is seen in graphics_pixels... in blitz3d_pixels.bb.
CameraClsColor camera, 10, 20, 30
CameraClsMode camera, True, False
CameraClsMode camera, True, True
CameraFogMode camera, 1
CameraFogColor camera, 100, 100, 100
CameraFogRange camera, 5, 50
CameraFogMode camera, 0
CameraProjMode camera, 1
CameraProjMode camera, 0
CameraProjMode camera, 1
suite_checks = suite_checks + 10

; Lights
light = CreateLight()
CheckTrue "CreateLight", light <> 0
LightColor light, 255, 200, 100
LightRange light, 50
point = CreateLight(2)
spot = CreateLight(3)
CheckTrue "CreateLight point", point <> 0 And point <> light
CheckTrue "CreateLight spot", spot <> 0 And spot <> point
LightColor point, 0, 255, 0
LightRange point, 10
AmbientLight 50, 60, 70
AmbientLight 0, 0, 0
FreeEntity point
FreeEntity spot
FreeEntity light
suite_checks = suite_checks + 4

; Listeners and what they hear.
listener = CreateListener(camera)
CheckTrue "CreateListener", listener <> 0
folder$ = "suite_tmp_cameras"
CreateDir folder
file = WriteFile(folder + "/silence.wav")
WriteByte file, Asc("R") : WriteByte file, Asc("I") : WriteByte file, Asc("F") : WriteByte file, Asc("F")
WriteInt file, 36 + 200
WriteByte file, Asc("W") : WriteByte file, Asc("A") : WriteByte file, Asc("V") : WriteByte file, Asc("E")
WriteByte file, Asc("f") : WriteByte file, Asc("m") : WriteByte file, Asc("t") : WriteByte file, Asc(" ")
WriteInt file, 16
WriteShort file, 1
WriteShort file, 1
WriteInt file, 22050
WriteInt file, 44100
WriteShort file, 2
WriteShort file, 16
WriteByte file, Asc("d") : WriteByte file, Asc("a") : WriteByte file, Asc("t") : WriteByte file, Asc("a")
WriteInt file, 200
For i = 1 To 100
	WriteShort file, 0
Next
CloseFile file
sound = Load3DSound(folder + "/silence.wav")
CheckTrue "Load3DSound for EmitSound", sound <> 0
source = CreatePivot()
PositionEntity source, 0, 0, 5
channel = EmitSound(sound, source)
CheckTrue "EmitSound", channel >= 0
StopChannel channel
FreeSound sound
FreeEntity source
DeleteFile folder + "/silence.wav"

; Sprites are flat pictures that face the camera.
sprite = CreateSprite()
CheckTrue "CreateSprite", sprite <> 0
ScaleSprite sprite, 2, 3
RotateSprite sprite, 45
SpriteViewMode sprite, 1
SpriteViewMode sprite, 2
SpriteViewMode sprite, 3
SpriteViewMode sprite, 4
PositionEntity sprite, 1, 2, 3
Check "A sprite is an entity", EntityX(sprite), 1
child = CreateSprite(sprite)
CheckTrue "CreateSprite with a parent", child <> 0
FreeEntity child
FreeEntity sprite
suite_checks = suite_checks + 5

EndGraphics
Done "blitz3d_cameras"
