; Goto out of a For Each loop (to a label outside of it) ends the loop's claim on the type, so later deletes free their objects
; again. Goto into a loop, and Goto between labels inside the same loop, keep the claim. None of it may crash, and Delete
; keeps working in every case.
Include "check.bb"

Type Thing
	Field n%
End Type

Local t.Thing, o.Thing
Local i%, seen%

; Goto out of the loop
For i = 1 To 10 : t = New Thing : t\n = i : Next
For t = Each Thing
	If t\n = 3 Then Goto Out1
Next
.Out1
Check "Out of the loop", t\n, 3
For t = Each Thing
	Delete t
Next
Check "Deleted after leaving with Goto", Count(), 0

; Goto out of two nested loops at once
For i = 1 To 5 : t = New Thing : t\n = i : Next
For t = Each Thing
	For o = Each Thing
		If o\n = 2 Then Goto Out2
	Next
Next
.Out2
Check "Out of nested loops", o\n, 2
Delete Each Thing
Check "Delete Each after leaving", Count(), 0

; Goto from the inner loop to a label of the outer one: the outer loop keeps running and deleting inside it works
For i = 1 To 6 : t = New Thing : t\n = i : Next
seen = 0
For t = Each Thing
	For o = Each Thing
		If o\n = 1 Then Goto Skip
	Next
	.Skip
	seen = seen + 1
	If t\n Mod 2 = 0 Then Delete t
Next
Check "Outer loop went on", seen, 6
Local left% = 0
For t = Each Thing : left = left + 1 : Next
Check "Even ones deleted", left, 3
Delete Each Thing

; Goto into a loop from outside, and Goto back out and in again
For i = 1 To 4 : t = New Thing : t\n = i : Next
seen = 0
Local jumped% = 0
For t = Each Thing
	.Inside
	seen = seen + 1
	If seen = 2 And jumped = 0 Then
		jumped = 1
		Goto Outside
	EndIf
	Delete t
Next
Goto Done3
.Outside
Goto Inside
.Done3
Check "Jumped out and back in", jumped, 1
For t = Each Thing : Delete t : Next
Check "Everything deleted", Count(), 0

Function Count%()
	Local c%, x.Thing
	For x = Each Thing : c = c + 1 : Next
	Return c
End Function
