; DirectX .x models are not read yet: LoadMesh and LoadAnimMesh give an empty entity instead of 0, so that a program that
; loaded one goes on without it being on screen.
Include "check.bb"

Graphics3D 64, 64, 32, 2

mesh = LoadMesh("models/directx.x")
CheckTrue "LoadMesh of a .x file gives an entity", mesh <> 0
Check "The mesh of a .x file has no surfaces", CountSurfaces(mesh), 0

anim = LoadAnimMesh("models/directx.x")
CheckTrue "LoadAnimMesh of a .x file gives an entity", anim <> 0
Check "A .x file that is not there is still 0", LoadMesh("models/nothing.x"), 0
