; Strings: Left$ Right$ Mid$ Instr Replace$ Upper$ Lower$ Trim$ LSet$ RSet$ String$ Chr$ Asc Len Hex$ Bin$
; CurrentDate$ CurrentTime$, and the conversions between strings and numbers.
Include "check.bb"

; Len
Check "Len", Len("hello"), 5
Check "Len empty", Len(""), 0
Check "Len spaces", Len("  "), 2

; Left$ and Right$ take characters from the ends, and never fail for lengths that are too long.
CheckS "Left$", Left$("hello", 2), "he"
CheckS "Left$ whole", Left$("hello", 10), "hello"
CheckS "Left$ zero", Left$("hello", 0), ""
CheckS "Right$", Right$("hello", 2), "lo"
CheckS "Right$ whole", Right$("hello", 10), "hello"
CheckS "Right$ zero", Right$("hello", 0), ""

; Mid$ starts at 1, and without a length takes the rest.
CheckS "Mid$", Mid$("hello", 2, 3), "ell"
CheckS "Mid$ rest", Mid$("hello", 3), "llo"
CheckS "Mid$ first", Mid$("hello", 1, 1), "h"
CheckS "Mid$ too long", Mid$("hello", 4, 100), "lo"
CheckS "Mid$ after the end", Mid$("hello", 6, 2), ""
CheckS "Mid$ zero length", Mid$("hello", 2, 0), ""

; Instr is 1 based, 0 for nothing found, and can start somewhere else.
Check "Instr", Instr("hello world", "o"), 5
Check "Instr from", Instr("hello world", "o", 6), 8
Check "Instr word", Instr("hello world", "wor"), 7
Check "Instr missing", Instr("hello", "z"), 0
Check "Instr first", Instr("hello", "h"), 1
Check "Instr case sensitive", Instr("Hello", "h"), 0
Check "Instr past the end", Instr("hello", "o", 6), 0

; Replace$ replaces everything, and does not look at what it put in.
CheckS "Replace$", Replace$("a-b-c", "-", "+"), "a+b+c"
CheckS "Replace$ longer", Replace$("aaa", "a", "bb"), "bbbbbb"
CheckS "Replace$ remove", Replace$("a-b-c", "-", ""), "abc"
CheckS "Replace$ missing", Replace$("abc", "x", "y"), "abc"
CheckS "Replace$ not again", Replace$("aa", "a", "aa"), "aaaa"

; Case
CheckS "Upper$", Upper$("Hello 1!"), "HELLO 1!"
CheckS "Lower$", Lower$("Hello 1!"), "hello 1!"

; Trim$ takes away what is not visible at the start and the end.
CheckS "Trim$", Trim$("  hi there  "), "hi there"
CheckS "Trim$ nothing", Trim$("hi"), "hi"
CheckS "Trim$ only spaces", Trim$("    "), ""
CheckS "Trim$ tabs", Trim$(Chr$(9) + "x" + Chr$(9)), "x"

; LSet$ and RSet$ make strings exactly as long as asked, by cutting off or filling with spaces.
CheckS "LSet$ fill", LSet$("ab", 5), "ab   "
CheckS "LSet$ cut", LSet$("abcdef", 3), "abc"
CheckS "LSet$ exact", LSet$("abc", 3), "abc"
CheckS "RSet$ fill", RSet$("ab", 5), "   ab"
CheckS "RSet$ cut", RSet$("abcdef", 3), "def"
CheckS "RSet$ exact", RSet$("abc", 3), "abc"

; String$ repeats.
CheckS "String$", String$("ab", 3), "ababab"
CheckS "String$ zero", String$("ab", 0), ""

; Chr$ and Asc
CheckS "Chr$", Chr$(65), "A"
Check "Chr$ length", Len(Chr$(1)), 1
; Strings end at the first zero byte here, so Chr$(0) is the same as an empty string.
Check "Asc", Asc("A"), 65
Check "Asc first only", Asc("BCD"), 66
Check "Asc high", Asc(Chr$(200)), 200
Check "Asc round trip", Asc(Chr$(97)), 97

; Hex$ is always 8 digits and Bin$ 32.
CheckS "Hex$", Hex$(255), "000000FF"
CheckS "Hex$ zero", Hex$(0), "00000000"
CheckS "Hex$ negative", Hex$(-1), "FFFFFFFF"
CheckS "Hex$ big", Hex$($DEADBEEF), "DEADBEEF"
CheckS "Bin$", Bin$(5), "00000000000000000000000000000101"
CheckS "Bin$ negative", Bin$(-1), "11111111111111111111111111111111"
Check "Hex literal", $FF, 255
Check "Binary literal", %101, 5

; Conversions
CheckS "Str int", Str(42), "42"
CheckS "Str negative", Str(-7), "-7"
CheckS "Str float", Str(1.5), "1.5"
CheckS "Str whole float", Str(2.0), "2.0"
Check "String to int", Int("123"), 123
Check "String to int with text", Int("12abc"), 12
Check "String to float", Float("2.5"), 2.5
Check "String to int, not a number", Int("abc"), 0
CheckS "Concatenate numbers", "a" + 1 + 2, "a12"
CheckS "Concatenate float", "x" + 0.5, "x0.5"
CheckTrue "Compare equal", "abc" = "abc"
CheckFalse "Compare different", "abc" = "abd"
CheckTrue "Compare less", "abc" < "abd"
CheckTrue "Compare longer", "ab" < "abc"
CheckTrue "Compare case", "A" < "a"

; Date and time have the shape that the original gives: 03 Jan 2025 and 14:05:09.
date$ = CurrentDate$()
Check "CurrentDate$ length", Len(date), 11
CheckS "CurrentDate$ space 1", Mid$(date, 3, 1), " "
CheckS "CurrentDate$ space 2", Mid$(date, 7, 1), " "
Check "CurrentDate$ year", Int(Right$(date, 4)) >= 2024, 1
time$ = CurrentTime$()
Check "CurrentTime$ length", Len(time), 8
CheckS "CurrentTime$ colon 1", Mid$(time, 3, 1), ":"
CheckS "CurrentTime$ colon 2", Mid$(time, 6, 1), ":"
Check "CurrentTime$ hours", Int(Left$(time, 2)) < 24, 1
Check "CurrentTime$ minutes", Int(Mid$(time, 4, 2)) < 60, 1

Done "strings"
