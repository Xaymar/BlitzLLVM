; Expect: Object does not exist
; Insert next to an object that was deleted stops the program (checked in a debug build only, see object_deleted_field).
If GetEnv$("BLITZLLVM_TEST_DEBUG") = "" Then RuntimeError("Object does not exist (release build, not checked).")
Type MyType
	Field a
End Type
Local a.MyType = New MyType
Local c.MyType = New MyType
Local d.MyType = c
Delete c
Insert a Before d
Print "Insert next to a deleted object worked."
