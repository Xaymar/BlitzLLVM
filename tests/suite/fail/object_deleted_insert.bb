; Expect: Object does not exist
; Insert next to an object that was deleted stops the program (see object_deleted_field).
Type MyType
	Field a
End Type
Local a.MyType = New MyType
Local c.MyType = New MyType
Local d.MyType = c
Delete c
Insert a Before d
Print "Insert next to a deleted object worked."
