; Expect: Object does not exist
; A variable that still points at a deleted object stops the program when the object is used, in every build: a deleted object stays
; until nothing holds it, and is marked as deleted.
Type MyType
	Field a
End Type
Local a.MyType = New MyType
Local b.MyType = a
Delete a
If a <> Null Then Print "Delete did not set the variable to Null."
Print b\a
Print "A deleted object could be used."
