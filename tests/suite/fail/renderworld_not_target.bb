; SetBuffer and the 2D commands work on any texture buffer. A debug build (-d) stops RenderWorld when it draws into a
; texture that was not made with flag 4096 (render target). Other builds do not check, so there the same message is
; raised by the program itself.
; Expect: not a render target
Graphics3D 64, 64, 0, 2
texture = CreateTexture(8, 8, 1)
SetBuffer TextureBuffer(texture)
Color 255, 0, 0
Rect 0, 0, 8, 8
camera = CreateCamera()
If GetEnv$("BLITZLLVM_TEST_DEBUG") = "" Then RuntimeError("RenderWorld: the texture is not a render target (release build, not checked).")
RenderWorld
Print "RenderWorld did not stop the program."
