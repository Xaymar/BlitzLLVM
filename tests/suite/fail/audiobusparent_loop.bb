; Expect: AudioBusParent: a bus can't feed itself, or a bus that feeds it
; A bus that fed itself would never reach the speakers. Every build stops here.
a = CreateAudioBus()
b = CreateAudioBus(a)
AudioBusParent a, b
Print "A loop of buses did not stop the program."
