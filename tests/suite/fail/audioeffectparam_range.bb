; Expect: AudioEffectParam: BB_EFFECTPARAM_FEEDBACK [(]6[)] has to be 0 to 0.99, not 1.5
; A feedback of 1 or more would make the echo grow without end.
Include "<audio.bb>"
bus = CreateAudioBus()
effect = AddAudioEffect(bus, BB_EFFECT_ECHO)
AudioEffectParam effect, BB_EFFECTPARAM_FEEDBACK, 1.5
Print "A value out of range did not stop the program."
