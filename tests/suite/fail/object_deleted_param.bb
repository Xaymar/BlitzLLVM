; Expect: Object does not exist
; An object that a function was given stays held while it runs, and a deleted one is reported when another variable uses it.
Type MyType
	Field a
End Type

Global kept.MyType = New MyType
kept\a = 5

Function Remove(o.MyType)
	Delete kept
	Print o\a
End Function

Remove(kept)
Print "A deleted object could be used."
