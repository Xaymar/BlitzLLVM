; Collisions with many entities, where UpdateWorld only looks at what is near the path of a mover: Collisions EntityType
; EntityRadius EntityBox ResetEntity EntityParent UpdateWorld CountCollisions CollisionEntity Stats3D.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Const T_MOVER = 1, T_STATIC = 2, T_SPHERE = 3, T_BOX = 4

; A lot of things that are far from where the movers go.
far = CreateCube()
For i = 1 To 60
	e = CopyEntity(far)
	PositionEntity e, (i Mod 10) * 6 - 30, 0, 200 + (i / 10) * 6
	EntityType e, T_STATIC
	e = CopyEntity(far)
	PositionEntity e, (i Mod 10) * 6 - 30, 0, -200 - (i / 10) * 6
	EntityType e, T_SPHERE
	EntityRadius e, 2
	e = CopyEntity(far)
	PositionEntity e, (i Mod 10) * 6 - 30, 60, (i / 10) * 6
	EntityType e, T_BOX
Next
FreeEntity far

; A wall of polygons, a sphere and a box on the way of three movers.
wall = CreateCube()
ScaleEntity wall, 1, 5, 5
PositionEntity wall, 20, 0, 0
EntityType wall, T_STATIC

ball = CreateSphere(8)
ScaleEntity ball, 2, 2, 2
PositionEntity ball, 20, 0, 30
EntityType ball, T_SPHERE
EntityRadius ball, 2

crate = CreateCube()
PositionEntity crate, 20, 0, 60
EntityType crate, T_BOX

Collisions T_MOVER, T_STATIC, 2, 1
Collisions T_MOVER, T_SPHERE, 1, 1
Collisions T_MOVER, T_BOX, 3, 1

m1 = CreatePivot()
EntityType m1, T_MOVER
EntityRadius m1, 1
m2 = CreatePivot()
EntityType m2, T_MOVER
EntityRadius m2, 1
PositionEntity m2, 0, 0, 30
m3 = CreatePivot()
EntityType m3, T_MOVER
EntityRadius m3, 1
PositionEntity m3, 0, 0, 60
UpdateWorld

TranslateEntity m1, 40, 0, 0
TranslateEntity m2, 40, 0, 0
TranslateEntity m3, 40, 0, 0
UpdateWorld
Check "Stopped by the wall", EntityX(m1), 18, 0.05
Check "Stopped by the sphere", EntityX(m2), 17, 0.05
Check "Stopped by the box", EntityX(m3), 18, 0.05
Check "The wall is what was hit", CollisionEntity(m1, 1), wall
Check "The sphere is what was hit", CollisionEntity(m2, 1), ball
Check "The box is what was hit", CollisionEntity(m3, 1), crate

; What is moved to the path is in the way, and what is moved off it is not.
PositionEntity m1, 0, 0, 100
ResetEntity m1
PositionEntity wall, 20, 0, 400
ResetEntity wall
UpdateWorld
blocker = CreateCube()
PositionEntity blocker, 40, 0, 100
EntityType blocker, T_STATIC
ResetEntity blocker
TranslateEntity m1, 60, 0, 0
UpdateWorld
Check "Stopped by what was moved onto the path", EntityX(m1), 38, 0.05
Check "The wall that was moved away is not in the way", EntityZ(m1), 100, 0.001

; What is below a parent that moves is where the parent put it.
parent = CreatePivot()
PositionEntity parent, 0, 0, -50
child = CreateCube()
EntityParent child, parent
PositionEntity child, 30, 0, 0
EntityType child, T_STATIC
ResetEntity child
m4 = CreatePivot()
EntityType m4, T_MOVER
EntityRadius m4, 1
PositionEntity m4, 0, 0, -50
ResetEntity m4
UpdateWorld
TranslateEntity m4, 60, 0, 0
UpdateWorld
Check "Stopped by what is below a parent", EntityX(m4), 28, 0.05

; Many movers that are in the way of each other.
For i = 1 To 40
	e = CreatePivot()
	PositionEntity e, i * 4, 0, -100
	EntityType e, T_MOVER
	EntityRadius e, 1
	ResetEntity e
Next
Collisions T_MOVER, T_MOVER, 1, 1
UpdateWorld
Check "Movers that stand apart do not collide", CountCollisions(e), 0

EndGraphics
Done "blitz3d_collisions_many"
