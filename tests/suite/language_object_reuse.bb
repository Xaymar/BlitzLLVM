; Delete frees the object at once and sets the variable it was given to Null. A For Each loop can delete the object it
; stands on and any other object, and Return or Exit out of the loop leaves later deletes free to work.
Include "check.bb"

Type Thing
	Field n%
	Field s$
	Field a%[3]
End Type

Local t.Thing
For i% = 1 To 70000
	t = New Thing
	t\n = i
	t\s = "x" + i
	t\a[2] = i
	Delete t
	If t <> Null Then RuntimeError "Delete did not set the variable to Null"
Next

Local dirty% = 0
For i% = 1 To 1000
	t = New Thing
	If t\n <> 0 Or t\s <> "" Or t\a[2] <> 0 Then dirty = dirty + 1
	t\n = i
	t\s = "y"
	t\a[2] = i
Next
Local count% = 0
For t = Each Thing
	count = count + 1
Next
Check "Living objects", count, 1000
Check "Reused objects are empty", dirty, 0

Local sum% = 0
For t = Each Thing
	sum = sum + t\n
Next
Check "Fields of the living", sum, 500500

; Deleting the object of the loop, and others, while it runs
Local visited% = 0
Local other.Thing
For t = Each Thing
	visited = visited + 1
	other = Last Thing
	If other <> t Then Delete other
	Delete t
	If t <> Null Then RuntimeError "Delete in a loop did not set the variable to Null"
Next
Check "Loop with deletes", visited, 500
Check "Everything deleted", Count(), 0

; Leaving a loop with Return and Exit
For i% = 1 To 5 : t = New Thing : t\n = i : Next
Check "Return from a loop", FindThing(3), 3
For t = Each Thing
	Exit
Next
Delete Each Thing
For i% = 1 To 100 : t = New Thing : Next
For t = Each Thing
	Delete t
Next
Check "Delete after leaving loops", Count(), 0

Function FindThing%(n%)
	Local t.Thing
	For t = Each Thing
		If t\n = n Then Return t\n
	Next
	Return 0
End Function

Function Count%()
	Local c% = 0
	Local t.Thing
	For t = Each Thing
		c = c + 1
	Next
	Return c
End Function

Done "language_object_reuse"
