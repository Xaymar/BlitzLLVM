; Deleted objects are handed out again once enough objects of the same type were deleted after them. A reused object
; starts empty, like a new one, and a loop over the type only sees the living.
Include "check.bb"

Type Thing
	Field n%
	Field s$
	Field a%[3]
End Type

Local one.Thing = New Thing
one\n = 7
Delete one

For i% = 1 To 70000
	Local t.Thing = New Thing
	t\n = i
	t\s = "x" + i
	t\a[2] = i
	Delete t
Next

Local count% = 0
Local dirty% = 0
For i% = 1 To 1000
	t.Thing = New Thing
	If t\n <> 0 Or t\s <> "" Or t\a[2] <> 0 Then dirty = dirty + 1
	t\n = i
	t\s = "y"
	t\a[2] = i
Next
For t.Thing = Each Thing
	count = count + 1
Next
Check "Living objects", count, 1000
Check "Reused objects are empty", dirty, 0

Local sum% = 0
For t.Thing = Each Thing
	sum = sum + t\n
Next
Check "Fields of the living", sum, 500500

Delete Each Thing
Check "Delete Each", Count(), 0

Function Count%()
	Local c% = 0
	Local t.Thing
	For t = Each Thing
		c = c + 1
	Next
	Return c
End Function

Done "language_object_reuse"
