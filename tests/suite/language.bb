; The language: variables and their types, Const Global Local, If Select For Repeat While, Functions with default
; values, Dim, Type with New Delete First Last Before After Each Insert Handle Object, Data Read Restore, Goto Gosub.
Include "check.bb"

; Types of variables come from the sign that ends their name.
a% = 5
b# = 2.5
c$ = "text"
d = 7
Check "integer", a, 5
Check "float", b, 2.5
CheckS "string", c, "text"
Check "no sign is an integer", d / 2, 3
e = 7 / 2.0
Check "an integer variable holds the whole number", e, 4
b = 7
Check "a float can hold a whole number", b / 2, 3.5
Const LIMIT = 10, NAME$ = "const"
Check "Const", LIMIT * 2, 20
CheckS "Const string", NAME, "const"
Global total = 100
Function AddToTotal(n)
	total = total + n
End Function
AddToTotal 5
Check "Global is seen in functions", total, 105
Function ScopeCheck()
	Local total = 1
	Return total
End Function
Check "Local is only inside", ScopeCheck(), 1
Check "Local does not change the global", total, 105

; Conditions
If 1 = 1 Then r = 1 Else r = 2
Check "If Then Else on a line", r, 1
If 1 = 2
	r = 1
ElseIf 2 = 2
	r = 2
Else
	r = 3
EndIf
Check "ElseIf", r, 2
If Not (1 = 2) And (2 = 2 Or 3 = 4) Then r = 9
Check "And Or Not", r, 9

Select 3
	Case 1
		r = 10
	Case 2, 3
		r = 20
	Default
		r = 30
End Select
Check "Select with several values", r, 20
Select "b"
	Case "a" : r = 1
	Case "b" : r = 2
End Select
Check "Select on a string", r, 2
Select 99
	Case 1 : r = 1
	Default : r = 5
End Select
Check "Select default", r, 5

; Loops
sum = 0
For i = 1 To 10
	sum = sum + i
Next
Check "For", sum, 55
sum = 0
For i = 10 To 1 Step -3
	sum = sum + i
Next
Check "For with a negative step", sum, 10 + 7 + 4 + 1
sum = 0
; The limit is worked out again before every pass, like in the original.
Local limit_n = 5
sum = 0
For i = 1 To limit_n
	sum = sum + 1
	limit_n = 3
Next
Check "For works out the limit again", sum, 3
sum = 0

For i = 1 To 0
	sum = sum + 1
Next
Check "For that does not run", sum, 0
For i = 1 To 10
	If i = 4 Then Exit
Next
Check "Exit leaves the loop and keeps the counter", i, 4
n = 0
Repeat
	n = n + 1
Until n = 5
Check "Repeat Until", n, 5
n = 0
Repeat
	n = n + 1
	If n = 3 Then Exit
Forever
Check "Repeat Forever with Exit", n, 3
n = 0
While n < 7
	n = n + 2
Wend
Check "While", n, 8

; Functions take values, give one back, have optional parameters, and can call themselves.
Function Square(x)
	Return x * x
End Function
Function Greet$(name$, greeting$ = "Hello")
	Return greeting + ", " + name
End Function
Function Factorial(n)
	If n <= 1 Then Return 1
	Return n * Factorial(n - 1)
End Function
Function Half#(x#)
	Return x / 2
End Function
Check "Function", Square(7), 49
CheckS "Optional parameter", Greet$("you"), "Hello, you"
CheckS "Given optional parameter", Greet$("you", "Hi"), "Hi, you"
Check "Recursion", Factorial(6), 720
Check "Function with a float", Half(5), 2.5

; Arrays have one more place than their size says.
Dim numbers(4)
For i = 0 To 4
	numbers(i) = i * i
Next
Check "Dim", numbers(3), 9
Check "Dim last", numbers(4), 16
; Making a string array again frees the strings that it had, and it starts empty.
Dim words$(3)
For i = 0 To 3
	words$(i) = "word number " + i
Next
CheckS "String array before Dim again", words$(2), "word number 2"
Dim words$(5)
CheckS "String array after Dim again", words$(2), ""
words$(5) = "last"
CheckS "String array bigger", words$(5), "last"
For i = 1 To 200
	Dim words$(50)
	words$(i Mod 50) = "round " + i
Next
CheckS "String array made again many times", words$(200 Mod 50), "round 200"
Dim grid(2, 3)
grid(2, 3) = 23
grid(0, 0) = 1
Check "Dim with two sizes", grid(2, 3), 23
Check "Dim with two sizes, other place", grid(0, 0), 1
Dim words$(2)
words(1) = "one"
CheckS "Dim of strings", words(1), "one"
Dim decimals#(1)
decimals(1) = 0.5
Check "Dim of floats", decimals(1), 0.5
Dim numbers(9)
Check "Dim again makes it empty", numbers(3), 0
Local fixed[3]
fixed[3] = 33
Check "Array in brackets", fixed[3], 33

; Types are records that are kept in a list.
Type Item
	Field name$
	Field value
	Field weight#
End Type

first_item.Item = New Item
first_item\name = "first"
first_item\value = 10
first_item\weight = 1.5
second_item.Item = New Item
second_item\name = "second"
second_item\value = 20
third_item.Item = New Item
third_item\name = "third"
third_item\value = 30

CheckS "Field of a string", first_item\name, "first"
Check "Field of an integer", first_item\value, 10
Check "Field of a float", first_item\weight, 1.5
Check "Fields start empty", second_item\weight, 0
CheckS "First", (First Item)\name, "first"
CheckS "Last", (Last Item)\name, "third"
CheckS "After", (After first_item)\name, "second"
CheckS "Before", (Before third_item)\name, "second"
total = 0
count = 0
For it.Item = Each Item
	total = total + it\value
	count = count + 1
Next
Check "Each goes over everything", total, 60
Check "Each counts", count, 3

; Handles are numbers that stand for objects.
handle_number = Handle(second_item)
CheckTrue "Handle", handle_number <> 0
found.Item = Object.Item(handle_number)
CheckS "Object", found\name, "second"
Check "Handles of different objects differ", Handle(first_item) <> Handle(third_item), 1

; Moving things in the list.
Insert first_item After third_item
CheckS "Insert After", (Last Item)\name, "first"
Insert third_item Before second_item
CheckS "Insert Before", (First Item)\name, "third"

; Deleting
Delete second_item
count = 0
For it.Item = Each Item
	count = count + 1
Next
Check "Delete", count, 2
Delete Each Item
count = 0
For it.Item = Each Item
	count = count + 1
Next
Check "Delete Each", count, 0
Check "First of nothing", (First Item) = Null, 1

; Objects that point at others.
Type Node
	Field next.Node
	Field id
End Type
n1.Node = New Node
n1\id = 1
n2.Node = New Node
n2\id = 2
n1\next = n2
Check "A field that is an object", n1\next\id, 2
Check "Null", n2\next = Null, 1
Delete Each Node

; Data
Restore numbers_data
Read x, y
Check "Read", x, 10
Check "Read second", y, 20
Read word$
CheckS "Read a string", word, "text"
Read f#
Check "Read a float", f, 1.5
Restore numbers_data
Read x
