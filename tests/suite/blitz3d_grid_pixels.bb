; With very many meshes the renderer finds the ones near the view through a grid in the world instead of reading all of them. What it
; draws must be the same as without: this moves, hides, frees, copies, scales and parents meshes, and moves the camera, and checks
; what is drawn after each (the grid is only used above a few thousand meshes, and after the meshes stayed as they are for a few frames).
; Debug programs also compare the grid with a look at every mesh, and stop with an error if it left out one that is in view.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_grid_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

cam = CreateCamera()
light = CreateLight()

; A row of 5000 cubes of 2 by 2 by 2, 10 apart along X and 100 in front of the camera. It sees 100 to either side there, so
; the cubes at 5, 15 ... 95 are in view.
Const COUNT = 5000
Dim cubes(COUNT - 1)
For i = 0 To COUNT - 1
	cubes(i) = CreateCube()
	PositionEntity cubes(i), i * 10 + 5, 0, 100
Next

Function Frames()
	For k = 1 To 3
		RenderWorld
	Next
End Function

; The grid is made after a few frames of the meshes staying as they are.
For k = 1 To 8
	RenderWorld
Next
Check "Row in view", TrisRendered(), 120, 0
Frames
Check "Row in view again", TrisRendered(), 120, 0

; Moved into view, and out of it again.
PositionEntity cubes(4000), 55, 0, 100
Frames
Check "Cube moved into view", TrisRendered(), 132, 0
PositionEntity cubes(4000), 40005, 0, 100
Frames
Check "Cube moved out again", TrisRendered(), 120, 0
PositionEntity cubes(1), 9000, 0, 100
Frames
Check "Visible cube moved out", TrisRendered(), 108, 0
PositionEntity cubes(1), 15, 0, 100
Frames
Check "Visible cube moved back", TrisRendered(), 120, 0

; The other ways to move something.
TranslateEntity cubes(4001), -40000, 0, 0
Frames
Check "TranslateEntity into view", TrisRendered(), 132, 0
TranslateEntity cubes(4001), 40000, 0, 0
Frames
Check "TranslateEntity out of view", TrisRendered(), 120, 0
MoveEntity cubes(4002), -40000, 0, 0
Frames
Check "MoveEntity into view", TrisRendered(), 132, 0
MoveEntity cubes(4002), 40000, 0, 0
Frames
Check "MoveEntity out of view", TrisRendered(), 120, 0

; Hidden, shown, freed, and a new mesh in the place of a freed one.
HideEntity cubes(3)
Frames
Check "Hidden", TrisRendered(), 108, 0
ShowEntity cubes(3)
Frames
Check "Shown again", TrisRendered(), 120, 0
FreeEntity cubes(2)
Frames
Check "Freed", TrisRendered(), 108, 0
cubes(2) = CreateCube()
PositionEntity cubes(2), 25, 0, 100
Frames
Check "New mesh in the place of the freed one", TrisRendered(), 120, 0
FreeEntity cubes(4003)
nc = CreateCube()
PositionEntity nc, 45, 0, 100
Frames
Check "New mesh in view, another was freed far away", TrisRendered(), 132, 0
FreeEntity nc

; Bigger, and with other vertices.
PositionEntity cubes(4004), 150, 0, 100
Frames
Check "Cube to the side", TrisRendered(), 120, 0
ScaleEntity cubes(4004), 200, 200, 200
Frames
Check "Cube scaled up into view", TrisRendered(), 132, 0
ScaleEntity cubes(4004), 1, 1, 1
Frames
Check "Cube scaled down", TrisRendered(), 120, 0
PositionMesh cubes(4005), -40000, 0, 0
Frames
Check "Vertices moved into view", TrisRendered(), 132, 0
PositionMesh cubes(4005), 40000, 0, 0
Frames
Check "Vertices moved out", TrisRendered(), 120, 0

; A mesh with a parent is moved by it.
pivot = CreatePivot()
EntityParent cubes(4006), pivot, False
Frames
Check "Parented, still far away", TrisRendered(), 120, 0
PositionEntity pivot, -40000, 0, 0
Frames
Check "Parent moved the child into view", TrisRendered(), 132, 0
PositionEntity pivot, 0, 0, 0
Frames
Check "Parent moved the child out", TrisRendered(), 120, 0
EntityParent cubes(4006), 0, True
FreeEntity pivot

; A copy, which has its own place.
copy = CopyEntity(cubes(0))
PositionEntity copy, 35, 0, 100
Frames
Check "Copy in view", TrisRendered(), 132, 0
FreeEntity copy
Frames
Check "Copy freed", TrisRendered(), 120, 0

; The camera: it sees 100 to either side of itself, so at 3000 the cubes at 2905 to 3095 are in view.
PositionEntity cam, 3000, 0, 0
Frames
Check "Camera moved", TrisRendered(), 240, 0
PositionEntity cam, 0, 0, 0
Frames
Check "Camera moved back", TrisRendered(), 120, 0
TurnEntity cam, 0, 180, 0
Frames
Check "Camera turned away", TrisRendered(), 0, 0
TurnEntity cam, 0, 180, 0
Frames
Check "Camera turned back", TrisRendered(), 120, 0

; So many meshes moving every frame that the grid is not used for a while (more than 5% of them), and then used again. The picture is
; the same in both, also for meshes that are moved while it is not used.
For k = 1 To 6
	For i = 1000 To 1299
		TranslateEntity cubes(i), 0, 0.01, 0
	Next
	RenderWorld
Next
Check "Many moving", TrisRendered(), 120, 0
PositionEntity cubes(4010), 65, 0, 100
For k = 1 To 3
	For i = 1000 To 1299
		TranslateEntity cubes(i), 0, 0.01, 0
	Next
	RenderWorld
Next
Check "Moved into view while many are moving", TrisRendered(), 132, 0
Frames
Frames
Check "Moving stopped", TrisRendered(), 132, 0
PositionEntity cubes(4011), 75, 0, 100
Frames
Check "Moved into view after the grid is used again", TrisRendered(), 144, 0
PositionEntity cubes(4010), 40005, 0, 100
PositionEntity cubes(4011), 40005, 0, 100
Frames
Check "And out again", TrisRendered(), 120, 0

; Seeing all of the cubes, the grid has nothing to save, and reading every mesh is used instead (more than a tenth of them are in cells that
; are in view). The picture is the same, also when the camera goes back (at this distance a cube is lost to rounding with or without the grid).
PositionEntity cam, 25000, 0, -59900
CameraRange cam, 1, 200000
Frames
Check "Everything in view", TrisRendered(), 60000, 12
PositionEntity cam, 0, 0, 0
CameraRange cam, 1, 1000
Frames
Check "Back to a few in view", TrisRendered(), 120, 0
PositionEntity cubes(4010), 65, 0, 100
Frames
Check "Moved into view after reading everything", TrisRendered(), 132, 0

End
