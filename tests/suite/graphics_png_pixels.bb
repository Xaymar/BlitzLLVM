; What PNG files look like once loaded, which needs a window and a GPU, so this is skipped without one: LoadImage DrawBlock
; ReadPixel and LoadTexture TextureBuffer with every color type, bit depth and interlacing, and a texture that is read and
; written pixel by pixel keeping its alpha. Each file has a red left half and a blue right half, the grey ones a white and a
; black one, and the ones with alpha are see-through on the right half.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_png_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function CheckColor(name$, color, red, green, blue)
	Check name + " red", (color Shr 16) And 255, red, 2
	Check name + " green", (color Shr 8) And 255, green, 2
	Check name + " blue", color And 255, blue, 2
End Function

; The colors of both halves of a picture, and the alpha of the right one.
Function CheckPixels(name$, left, right, alpha, grey)
	If grey Then
		CheckColor name + " left", left And $FFFFFF, 255, 255, 255
		CheckColor name + " right", right And $FFFFFF, 0, 0, 0
	Else
		CheckColor name + " left", left And $FFFFFF, 255, 0, 0
		If alpha = 0 Then CheckColor name + " right", right And $FFFFFF, 0, 0, 255
	EndIf
	Check name + " alpha on the left", (left Shr 24) And 255, 255
	If alpha Then Check name + " alpha on the right", (right Shr 24) And 255, 0 Else Check name + " alpha on the right", (right Shr 24) And 255, 255
End Function

Function CheckFile(name$, alpha, grey)
	file$ = "images/png/" + name + ".png"
	; As an image: drawn over green, which shows through the see-through half.
	ClsColor 0, 255, 0
	Cls
	image = LoadImage(file)
	CheckTrue name + " loads", image <> 0
	Check name + " width", ImageWidth(image), 8
	Check name + " height", ImageHeight(image), 4
	If alpha Then DrawImage image, 0, 0 Else DrawBlock image, 0, 0
	If grey Then
		CheckColor name + " image left", ReadPixel(1, 1) And $FFFFFF, 255, 255, 255
		If alpha Then CheckColor name + " image right", ReadPixel(6, 1) And $FFFFFF, 0, 255, 0 Else CheckColor name + " image right", ReadPixel(6, 1) And $FFFFFF, 0, 0, 0
	Else
		CheckColor name + " image left", ReadPixel(1, 1) And $FFFFFF, 255, 0, 0
		If alpha Then CheckColor name + " image right", ReadPixel(6, 1) And $FFFFFF, 0, 255, 0 Else CheckColor name + " image right", ReadPixel(6, 1) And $FFFFFF, 0, 0, 255
	EndIf
	FreeImage image

	; As a texture, with the color flag and with the alpha flag when the picture has alpha.
	flags = 1
	If alpha Then flags = 1 + 2
	texture = LoadTexture(file, flags + 4096)
	CheckTrue name + " loads as a texture", texture <> 0
	SetBuffer TextureBuffer(texture)
	CheckPixels name + " texture", ReadPixel(1, 1), ReadPixel(6, 1), alpha, grey

	; Reading and writing every pixel with the fast commands changes nothing.
	LockBuffer
	For y = 0 To 3
		For x = 0 To 7
			WritePixelFast x, y, ReadPixelFast(x, y)
		Next
	Next
	UnlockBuffer
	CheckPixels name + " texture after WritePixelFast", ReadPixel(1, 1), ReadPixel(6, 1), alpha, grey

	; And so does writing them one by one.
	For y = 0 To 3
		For x = 0 To 7
			WritePixel x, y, ReadPixel(x, y)
		Next
	Next
	CheckPixels name + " texture after WritePixel", ReadPixel(1, 1), ReadPixel(6, 1), alpha, grey
	SetBuffer BackBuffer()
	FreeTexture texture
End Function

Restore files
Repeat
	Read name$
	If name <> "" Then
		Read alpha
		Read grey
		CheckFile name, alpha, grey
	EndIf
Until name = ""

.files
Data "grey1", 0, 1
Data "grey16", 0, 1
Data "grey16_interlaced", 0, 1
Data "grey1_interlaced", 0, 1
Data "grey2", 0, 1
Data "grey2_interlaced", 0, 1
Data "grey4", 0, 1
Data "grey4_interlaced", 0, 1
Data "grey8", 0, 1
Data "grey8_interlaced", 0, 1
Data "grey_alpha16", 1, 1
Data "grey_alpha8", 1, 1
Data "palette1", 0, 0
Data "palette1_alpha", 1, 0
Data "palette2", 0, 0
Data "palette2_alpha", 1, 0
Data "palette4", 0, 0
Data "palette4_alpha", 1, 0
Data "palette8", 0, 0
Data "palette8_alpha", 1, 0
Data "palette8_interlaced", 1, 0
Data "rgb16", 0, 0
Data "rgb16_key", 1, 0
Data "rgb8", 0, 0
Data "rgb8_interlaced", 0, 0
Data "rgb8_key", 1, 0
Data "rgba16", 1, 0
Data "rgba8", 1, 0
Data "rgba8_interlaced", 1, 0
Data "", 0, 0

EndGraphics
Done "graphics_png_pixels"
