; EntityBlend 4 (stochastic alpha): the entity is drawn solid and each pixel is kept or dropped with the chance of its alpha,
; so a pixel is either the color of the entity or what was behind it, never a mix. Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_stochastic_alpha_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global camera = CreateCamera()
PositionEntity camera, 0, 0, -6
CameraClsColor camera, 0, 0, 200
CameraRange camera, 0.1, 100
AmbientLight 255, 255, 255

; A quad that covers the middle of the picture: the share of its pixels that show it, and how many are neither it nor the background.
Global Kept, Mixed, Signature

Function Measure(alpha#, back)
	q = CreateCube()
	ScaleEntity q, 2, 1.5, 0.01
	EntityFX q, 1
	EntityColor q, 255, 255, 255
	EntityBlend q, 4
	EntityAlpha q, alpha
	If back Then
		b = CreateCube()
		ScaleEntity b, 4, 3, 0.01
		PositionEntity b, 0, 0, 1
		EntityFX b, 1
		EntityColor b, 255, 0, 0
	EndIf
	RenderWorld
	Kept = 0 : Mixed = 0 : Signature = 0
	For x = 55 To 105
		For y = 40 To 80
			p = ReadPixel(x, y, BackBuffer())
			r = (p Shr 16) And 255
			bl = p And 255
			If r > 200 And bl > 200 Then Kept = Kept + 1 : Signature = Signature + x * 131 + y
			If Not ((r > 200 And bl > 200) Or (r < 40 And bl > 160) Or (r > 200 And bl < 40)) Then Mixed = Mixed + 1
		Next
	Next
	FreeEntity q
	If back Then FreeEntity b
End Function

total = 51 * 41

Measure 1.0, False
Check "Alpha 1: every pixel shows the entity", Kept, total, 0

Measure 0.5, False
Check "Alpha 0.5: about half of the pixels show the entity", Kept * 100 / total, 50, 12
Check "Alpha 0.5: no pixel is a mix", Mixed, 0, 0

Measure 0.25, False
Check "Alpha 0.25: about a quarter of the pixels show the entity", Kept * 100 / total, 25, 12

Measure 0.5, True
Check "Alpha 0.5 over something solid: still no mixed pixels", Mixed, 0, 0

; The noise moves from picture to picture.
Measure 0.5, False
earlier = Signature
Flip
Measure 0.5, False
CheckTrue "The pattern changes with the next picture", Signature <> earlier
