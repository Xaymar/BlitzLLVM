; Dither comes after AntiAlias, which needs a window and a GPU, so this is skipped without one. A gray triangle on black has colors
; that 8 bits show exactly (and no noise in them), so the only pixels with a color between two steps are the ones that AntiAlias
; blends along the edge. Dither has to reach those: with it on, some of them differ from the picture without it by one step, the
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_antialias_dither_pixels: skipped, there is no window."
	End
EndIf

Const SIZE = 128

Graphics3D SIZE, SIZE, 32, 2
SetBuffer BackBuffer()

Dim plain(SIZE * SIZE - 1)
Global changed, biggest, total_change, far_changed

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0

m = CreateMesh()
s = CreateSurface(m)
a = AddVertex(s, -48, -8.1, 10)
b = AddVertex(s, 48, 11.7, 10)
c = AddVertex(s, 0, 60, 10)
AddTriangle s, a, c, b
EntityFX m, 1 + 16   ; Fullbright, both sides.
EntityColor m, 127, 127, 127

Function Red(p)
	Return (p Shr 16) And 255
End Function

; Draws the picture `pictures` times (T2x needs the one before) and keeps the red of every pixel in plain() when `keep` is set,
; or compares with it.
Function Picture(pictures, keep)
	Local k, x, y, v, d
	For k = 1 To pictures
		RenderWorld
	Next
	changed = 0 : biggest = 0 : total_change = 0 : far_changed = 0
	For y = 0 To SIZE - 1
		For x = 0 To SIZE - 1
			v = Red(ReadPixel(x, y, BackBuffer()))
			If keep Then
				plain(y * SIZE + x) = v
			Else
				d = v - plain(y * SIZE + x)
				If d <> 0 Then
					changed = changed + 1
					total_change = total_change + d
					If Abs(d) > biggest Then biggest = Abs(d)
					; Where the picture is all black or all white, with nothing of an edge in reach, nothing can change.
					If plain(y * SIZE + x) = 0 Or plain(y * SIZE + x) = 127 Then
						If x > 3 And x < SIZE - 4 And y > 3 And y < SIZE - 4 Then
							If plain(y * SIZE + x + 3) = plain(y * SIZE + x) And plain(y * SIZE + x - 3) = plain(y * SIZE + x) And plain((y + 3) * SIZE + x) = plain(y * SIZE + x) And plain((y - 3) * SIZE + x) = plain(y * SIZE + x) Then far_changed = far_changed + 1
						EndIf
					EndIf
				EndIf
			EndIf
		Next
	Next
End Function

Function Run(mode, pictures, label$)
	; A software GPU (llvmpipe) filters 8 bit textures in 8 bit fixed point, so the blend of AntiAlias 1 is whole steps there and has nothing to dither; the mix
	; of AntiAlias 2 with the picture before is halves of steps on every GPU.
	Dither 0
	AntiAlias 0
	AntiAlias mode
	Picture pictures, True
	Dither 1
	AntiAlias 0
	AntiAlias mode
	Picture pictures, False
	Print label + ": " + changed + " pixels changed, the most by " + biggest + ", total " + total_change + ", away from the edge " + far_changed
	If mode = 2 Then CheckTrue label + ": Dither reaches the pixels that AntiAlias blended (" + changed + ")", changed > 10
	CheckTrue label + ": the noise is a step at most (" + biggest + ")", biggest <= 1
	CheckTrue label + ": nothing changes away from the edge (" + far_changed + ")", far_changed = 0
End Function

Run 1, 1, "AntiAlias 1"
Run 2, 4, "AntiAlias 2"
DitherMode 1, 3
Run 1, 1, "AntiAlias 1 with Bayer"
Run 2, 4, "AntiAlias 2 with Bayer"

; Dither 2 blends in the shader, which smoothing can not follow, so it is Dither 1 while AntiAlias is on: a blended triangle is the same picture.
DitherMode 0, 1
EntityAlpha m, 0.5
Local same, i
Dither 1
AntiAlias 1
Picture 1, True
Dither 2
Picture 1, False
CheckTrue "Dither 2 is Dither 1 while AntiAlias is on (" + changed + " pixels differ)", changed = 0
Done "blitz3d_antialias_dither_pixels"
