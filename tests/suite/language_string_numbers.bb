; Blitz converts a String to an Int or Float wherever one is needed, the way the original does it: like atoi and atof, so
; white space is skipped, the first character that does not belong to the number ends it, and there are no prefixes.
Include "check.bb"

Type Box
	Field n
	Field f#
End Type

Function AddUp(a, b#)
	Return a + b
End Function
Function IntOf%()
	Return " 12 apples"
End Function
Function FloatOf#()
	Return "2.5"
End Function
Function WithDefaults(a = "5", b# = "1.5")
	Return a * 10 + b
End Function

; Assignments to variables, fields and arrays.
a = "42"
Check "Int variable", a, 42
f# = "3.25"
Check "Float variable", f, 3.25
Local l% = "7", m# = "0.5"
Check "Local with a value", l, 7
Check "Local float with a value", m, 0.5
b.Box = New Box
b\n = "8"
b\f = "1.25"
Check "Int field", b\n, 8
Check "Float field", b\f, 1.25
Dim ints(2)
Dim reals#(2)
ints(1) = "4"
reals(1) = "4.5"
Check "Int array", ints(1), 4
Check "Float array", reals(1), 4.5

; Arguments, default values and return values.
Check "Arguments", AddUp("7", "1.5"), 8
Check "Default values", WithDefaults(), 52
Check "Return an Int", IntOf(), 12
Check "Return a Float", FloatOf(), 2.5
Check "Built-in argument", Len(Left$("hello", "3")), 3
Check "Built-in float argument", Sqr("16"), 4

; Parsing is atoi and atof: no hexadecimal, no binary and no exponent for an Int.
Check "Leading white space", Int("   15"), 15
Check "Negative", Int("-9"), -9
Check "Plus sign", Int("+9"), 9
Check "Garbage after", Int("33x7"), 33
Check "Garbage before", Int("x33"), 0
Check "Empty", Int(""), 0
Check "Fraction is cut off", Int("1.9"), 1
Check "Negative fraction is cut off", Int("-1.9"), -1
Check "Exponent is ignored for an Int", Int("1e3"), 1
Check "Exponent works for a Float", Float("1e3"), 1000
Check "Dollar sign is no hexadecimal", Int("$FF"), 0
Check "0x is no hexadecimal", Int("0x10"), 0
Check "Percent sign is no binary", Int("%101"), 0
Check "Float with white space", Float("  -0.25z"), -0.25
Check "Too large stops at the maximum", Int("99999999999"), 2147483647
Check "Too small stops at the minimum", Int("-99999999999"), -2147483647 - 1

; Conditions are Ints.
x = 0
If "3" Then x = 1
Check "True string condition", x, 1
x = 0
If "0" Then x = 1
Check "0 string condition", x, 0
If "abc" Then x = 1
Check "Text string condition", x, 0
If "" Then x = 1
Check "Empty string condition", x, 0
While "0"
	x = 5
Wend
Check "While with 0", x, 0
Repeat
	x = x + 1
Until "1"
Check "Until with 1", x, 1

; Loops, indices and Select.
total = 0
For i = "1" To "3" Step "1"
	total = total + i
Next
Check "For loop", total, 6
Dim arr(5)
arr("2") = 9
Check "Array index", arr(2), 9
Check "Array index when reading", arr("2"), 9
Select 2
	Case "2"
		x = 20
	Default
		x = 30
End Select
Check "Select with a string case", x, 20
Select "7"
	Case 7
		x = 40
	Default
		x = 50
End Select
Check "Select on a string", x, 40

; The bitwise operators take Ints, so a String is converted. The others do not take strings: + joins them.
Check "And", "6" And 3, 2
Check "Or", 4 Or "1", 5
Check "Xor", "5" Xor "1", 4
Check "Shl", 1 Shl "3", 8
Check "Shr", "16" Shr 2, 4
Check "Sar", "-16" Sar 2, -4
CheckS "Plus joins", "1" + 2, "12"
CheckS "Plus joins numbers after", 1 + "2", "12"
CheckS "Plus joins floats", "1" + 2.5, "12.5"

; Comparing a string with a number compares text, and so does Not.
CheckTrue "Number as text", "10" < 9
CheckTrue "Equal as text", 10 = "10"
CheckFalse "Different as text", "1.0" = 1
CheckTrue "Not on a zero string", Not "0"
CheckFalse "Not on a text", Not "abc"
CheckFalse "Not on an empty string", Not ""

Done "language_string_numbers"
