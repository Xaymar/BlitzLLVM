; What a camera cannot see is not drawn for it: meshes and sprites behind the camera or to the side of it, for each of
; the cameras on their own. TrisRendered counts what was handed to the GPU, so this needs a window and a GPU.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_culling_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

cam1 = CreateCamera()
CameraViewport cam1, 0, 0, 80, 120
PositionEntity cam1, 0, 0, -10
cam2 = CreateCamera()
CameraViewport cam2, 80, 0, 80, 120
PositionEntity cam2, 100, 0, -10
light = CreateLight()

; A sprite in view is drawn (2 triangles), one behind the camera or far to the side is not.
spr = CreateSprite()
PositionEntity spr, 0, 0, 0
HideEntity cam2
RenderWorld
Check "Sprite in view", TrisRendered(), 2, 0
PositionEntity spr, 0, 0, -50
RenderWorld
Check "Sprite behind the camera", TrisRendered(), 0, 0
PositionEntity spr, 500, 0, 0
RenderWorld
Check "Sprite far to the side", TrisRendered(), 0, 0
PositionEntity spr, 0, 0, 0
FreeEntity spr

; Each camera only draws what it sees: one cube is in front of the first camera, one in front of the second.
cube1 = CreateCube()
PositionEntity cube1, 0, 0, 0
cube2 = CreateCube()
PositionEntity cube2, 100, 0, 0
ShowEntity cam2
RenderWorld
Check "Each camera draws its own cube", TrisRendered(), 24, 0
PositionEntity cube2, 0, 0, 0
RenderWorld
Check "Only the first camera sees both", TrisRendered(), 24, 0
PositionEntity cube1, 300, 0, 0
PositionEntity cube2, -300, 0, 0
RenderWorld
Check "Neither camera sees them", TrisRendered(), 0, 0

; What the renderer remembers of a mesh to cull it again (a sphere around it) has to follow every change of the mesh: where it is,
; how big it is, its vertices, and a new entity in the place of a freed one. Each is rendered twice, so that the second time
; is from what was remembered.
FreeEntity cube1
FreeEntity cube2
HideEntity cam2
box = CreateCube()
PositionEntity box, 200, 0, 0
RenderWorld
Check "Remembered: cube to the side", TrisRendered(), 0, 0
RenderWorld
Check "Remembered: cube to the side again", TrisRendered(), 0, 0
PositionEntity box, 0, 0, 0
RenderWorld
Check "Remembered: cube moved into view", TrisRendered(), 12, 0
RenderWorld
Check "Remembered: cube in view again", TrisRendered(), 12, 0
PositionEntity box, 200, 0, 0
RenderWorld
Check "Remembered: cube moved out", TrisRendered(), 0, 0
RenderWorld
ScaleEntity box, 300, 300, 300
RenderWorld
Check "Remembered: cube scaled up around the camera", TrisRendered(), 12, 0
ScaleEntity box, 1, 1, 1
RenderWorld
RenderWorld
Check "Remembered: cube scaled down", TrisRendered(), 0, 0
PositionMesh box, -200, 0, 0
RenderWorld
Check "Remembered: vertices moved into view", TrisRendered(), 12, 0
RenderWorld
PositionMesh box, 400, 0, 0
RenderWorld
Check "Remembered: vertices moved out", TrisRendered(), 0, 0
RenderWorld
copy = CopyEntity(box)
PositionEntity copy, -200, 0, 0
RenderWorld
Check "Remembered: copy in view through the shared vertices", TrisRendered(), 12, 0
RenderWorld
PositionMesh box, -200, 0, 0
RenderWorld
Check "Remembered: shared vertices moved for the copy", TrisRendered(), 0, 0
FreeEntity copy
FreeEntity box
RenderWorld
Check "Remembered: nothing left", TrisRendered(), 0, 0
box = CreateCube()
PositionEntity box, 200, 0, 0
RenderWorld
RenderWorld
FreeEntity box
box = CreateCube()
RenderWorld
Check "Remembered: new cube in the place of a freed one", TrisRendered(), 12, 0

; A sprite is remembered by a sphere that has its size and where it is held in it.
FreeEntity box
spr = CreateSprite()
PositionEntity spr, 200, 0, 0
RenderWorld
RenderWorld
Check "Remembered: sprite to the side", TrisRendered(), 0, 0
ScaleSprite spr, 300, 300
RenderWorld
Check "Remembered: sprite scaled up", TrisRendered(), 2, 0
ScaleSprite spr, 1, 1
RenderWorld
RenderWorld
Check "Remembered: sprite scaled down", TrisRendered(), 0, 0
HandleSprite spr, 200, 0
RenderWorld
Check "Remembered: sprite held far from its middle", TrisRendered(), 2, 0
HandleSprite spr, 0, 0
RenderWorld
Check "Remembered: sprite held in its middle again", TrisRendered(), 0, 0

Done "blitz3d_culling_pixels"
