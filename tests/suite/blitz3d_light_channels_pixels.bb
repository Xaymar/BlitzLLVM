; Which lights light which entities (EntityLightChannel), which needs a window and a GPU, so this is
; skipped without one.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_light_channels_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 0, 0, 0

; A light that shines the way the camera looks, on a sphere that has a corner in the middle of the picture.
AmbientLight 0, 0, 0
light = CreateLight()
sphere = CreateSphere(32)
EntityColor sphere, 30, 30, 30

RenderWorld
Check "Every light and entity is in every channel", R(80, 60), 30, 6

EntityLightChannel light, 2
RenderWorld
Check "A light in channel 2 lights the entity in all channels", R(80, 60), 30, 6

EntityLightChannel sphere, 1
RenderWorld
Check "A light in channel 2 does not light an entity in channel 1", R(80, 60), 0, 3

EntityLightChannel sphere, 3
RenderWorld
Check "Sharing one of two channels is enough", R(80, 60), 30, 6

EntityLightChannel sphere, 0
EntityLightChannel light, 255
RenderWorld
Check "An entity in no channel is not lit", R(80, 60), 0, 3

; Lights that do not share a channel with the entity do not count towards the eight that light it. Eight bright lights of
; channel 2 come before a dim one of channel 1, which would be left out if the channels were not looked at first.
FreeEntity light
For i = 1 To 8
	bright = CreateLight()
	LightColor bright, 0, 255, 255
	EntityLightChannel bright, 2
Next
light = CreateLight()
LightColor light, 40, 40, 40
EntityLightChannel light, 1
EntityColor sphere, 200, 200, 200
EntityLightChannel sphere, 1
RenderWorld
Check "The dim light of the entity is picked from nine", R(80, 60), 31, 6
EntityLightChannel sphere, 2
RenderWorld
Check "Eight lights of another channel do not light it either", R(80, 60), 0, 3
EntityLightChannel sphere, 3
RenderWorld
Check "Both channels, the eight bright lights come first", R(80, 60), 0, 3

EndGraphics
Done "blitz3d_light_channels_pixels"
