; Draw3D2 text against the original Blitz3D: FontRange3D, SetFont3D, Text3D (alignment, color, alpha, angle), StringWidth3D, StringHeight3D. Needs a window and a GPU. See draw3d2_common.bb for the metric.
If GetEnv$("BLITZ_HEADLESS") <> "" And GetEnv$("D3D2_CAPTURE") = "" Then
	Print "draw3d2_text_pixels: skipped, there is no window."
	End
EndIf
Include "check.bb"
Include "../draw3d2/draw3d2_common.bb"

D3DSetup
font_image = LoadImage3D("../draw3d2/images/font.png")
font = FontRange3D(font_image)
Clear3D

ColorT3D 255, 255, 255
Text3D font, -150, 100, "Hello, Blitz3D 123!"
ColorT3D 255, 200, 0
Text3D font, 0, 70, "Centered", 1
ColorT3D 0, 255, 128
Text3D font, 150, 50, "Right aligned", 2
ColorT3D 255, 255, 255, 0.5
Text3D font, -150, 30, "Half see-through"
SetFont3D font, 2, 2
ColorT3D 255, 80, 80
Text3D font, -150, 0, "Big"
SetFont3D font, 1, 1, 4
ColorT3D 255, 255, 255
Text3D font, -150, -30, "Spaced out"
SetFont3D font
ColorT3D 128, 200, 255
Text3D font, 0, -60, "Turned", 1, 0, 30
ColorT3D 255, 255, 255
Text3D font, -150, -100, "w=" + StringWidth3D(font, "Width") + " h=" + StringHeight3D(font)

D3DFinish "draw3d2_text"
Done "draw3d2_text_pixels"
