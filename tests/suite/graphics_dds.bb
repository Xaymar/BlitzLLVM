; LoadImage and LoadTexture with DDS files. images/ has them 8 pixels wide and 4 high, in the compressed formats DXT1, DXT3,
; DXT5, BC4 and BC7 (with a DX10 header) and in the uncompressed formats BGRA, 24 bit RGB and 5 6 5 bit RGB.
Include "check.bb"

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function CheckDDS(name$, file$)
	image = LoadImage(file)
	CheckTrue name + " LoadImage", image <> 0
	Check name + " image width", ImageWidth(image), 8
	Check name + " image height", ImageHeight(image), 4
	FreeImage image
	texture = LoadTexture(file)
	CheckTrue name + " LoadTexture", texture <> 0
	Check name + " texture width", TextureWidth(texture), 8
	Check name + " texture height", TextureHeight(texture), 4
	FreeTexture texture
End Function

CheckDDS "DXT1", "images/dxt1.dds"
CheckDDS "DXT3", "images/dxt3.dds"
CheckDDS "DXT5", "images/dxt5.dds"
CheckDDS "BC4", "images/bc4.dds"
CheckDDS "BC7", "images/bc7.dds"
CheckDDS "BGRA", "images/bgra.dds"
CheckDDS "RGB 24 bit", "images/rgb24.dds"
CheckDDS "RGB 565", "images/rgb565.dds"

; Pictures that are not whole or not DDS files give 0, like any other file that cannot be read.
Check "LoadImage missing DDS", LoadImage("images/missing.dds"), 0
Check "LoadTexture missing DDS", LoadTexture("images/missing.dds"), 0

folder$ = "suite_tmp_dds"
CreateDir folder
source = ReadFile("images/dxt5.dds")
cut = WriteFile(folder + "/cut.dds")
For i = 1 To 140
	WriteByte cut, ReadByte(source)
Next
CloseFile cut
CloseFile source
Check "LoadImage with a DDS that ends early", LoadImage(folder + "/cut.dds"), 0
Check "LoadTexture with a DDS that ends early", LoadTexture(folder + "/cut.dds"), 0
DeleteFile folder + "/cut.dds"

junk = WriteFile(folder + "/junk.dds")
WriteInt junk, $20534444
For i = 1 To 40
	WriteInt junk, 0
Next
CloseFile junk
Check "LoadImage with a DDS header that is wrong", LoadImage(folder + "/junk.dds"), 0
Check "LoadTexture with a DDS header that is wrong", LoadTexture(folder + "/junk.dds"), 0
DeleteFile folder + "/junk.dds"
DeleteDir folder

EndGraphics
Done "graphics_dds"
