; Shape casts against physics bodies. Names: PhysicsSphereCast PhysicsBoxCast PhysicsCapsuleCast
Include "check.bb"

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

floor = CreatePhysicsBody(1, 1, 10, 0.5, 10)
PositionEntity floor, 0, -0.5, 0
wall = CreatePhysicsBody(1, 1, 0.5, 2, 5)
PositionEntity wall, 4, 2, 0

; A sphere of radius 0.5 dropped from y=3 stops at the floor after 2.5
Check "sphere hits the floor", PhysicsSphereCast(0, 3, 0, 0, -7, 0, 0.5), floor, 0
Check "sphere distance", GetPhysicsHitDistance(), 2.5, 0.02
Check "sphere point", GetPhysicsHitY(), 0, 0.02
Check "sphere normal", GetPhysicsHitNY(), 1, 0.02
Check "too short to reach", PhysicsSphereCast(0, 3, 0, 0, 1, 0, 0.5), 0, 0
Check "nothing is kept", GetPhysicsHitDistance(), 0, 0

; A box sweeping sideways stops at the wall
Check "box hits the wall", PhysicsBoxCast(0, 1, 0, 10, 1, 0, 0.25, 0.25, 0.25), wall, 0
Check "box distance", GetPhysicsHitDistance(), 3.25, 0.03
Check "box normal", GetPhysicsHitNX(), -1, 0.02

; A capsule as well
Check "capsule hits the wall", PhysicsCapsuleCast(0, 1, 0, 10, 1, 0, 0.3, 0.5), wall, 0
Check "capsule distance", GetPhysicsHitDistance(), 3.2, 0.03

; A turned box is wider: a flat 1.0 x 0.1 slab turned 90 degrees around yaw reaches 0.1 to each side instead of 1.0
Check "slab as it is", PhysicsBoxCast(0, 1, 0, 10, 1, 0, 1, 0.1, 0.1), wall, 0
Check "slab as it is, distance", GetPhysicsHitDistance(), 2.5, 0.03
Check "slab turned", PhysicsBoxCast(0, 1, 0, 10, 1, 0, 1, 0.1, 0.1, 0, 90, 0), wall, 0
Check "slab turned, distance", GetPhysicsHitDistance(), 3.4, 0.03
Check "capsule lying", PhysicsCapsuleCast(0, 1, 0, 10, 1, 0, 0.3, 0.5, 0, 0, 90), wall, 0
Check "capsule lying, distance", GetPhysicsHitDistance(), 2.7, 0.03
Check "overlap box turned", PhysicsOverlapBox(4, 2, 0, 0.1, 0.1, 0.1, 0, 45, 0), 1, 0

; Layers: leave out layer 0 where the floor is
Check "layer left out", PhysicsSphereCast(0, 3, 0, 0, -7, 0, 0.5, -2, -1), 0, 0

Done "blitz3d_physics_sweeps"
