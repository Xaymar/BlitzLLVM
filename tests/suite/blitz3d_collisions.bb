; Collisions and picking: Stats3D EntityType EntityRadius EntityBox EntityPickMode ResetEntity Collisions ClearCollisions UpdateWorld
; CountCollisions CollisionEntity CollisionX CollisionY CollisionZ CollisionNX CollisionNY CollisionNZ CollisionTime
; CollisionSurface CollisionTriangle EntityCollided LinePick EntityPick CameraPick PickedEntity PickedX PickedY PickedZ
; PickedNX PickedNY PickedNZ PickedTime PickedSurface PickedTriangle EntityVisible MeshesIntersect.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Const T_PLAYER = 1, T_GROUND = 2, T_WALL = 3, T_BALL = 4, T_BOX = 5

; The ground is a cube that is 20 wide, 2 high and 20 deep, with its top at y = 0.
ground = CreateCube()
ScaleEntity ground, 10, 1, 10
PositionEntity ground, 0, -1, 0
EntityType ground, T_GROUND
EntityPickMode ground, 2

; A wall with its face at x = 4.
wall = CreateCube()
ScaleEntity wall, 1, 5, 10
PositionEntity wall, 5, 5, 0
EntityType wall, T_WALL
EntityPickMode wall, 2

player = CreatePivot()
EntityType player, T_PLAYER
EntityRadius player, 1
PositionEntity player, -4, 5, 0
ResetEntity player

; Without rules nothing collides.
UpdateWorld
Check "No rules, no collisions", CountCollisions(player), 0
Check "No rules, EntityCollided", EntityCollided(player, T_GROUND), 0
TranslateEntity player, 0, -10, 0
UpdateWorld
CheckTrue "No rules, falls through", EntityY(player) < 0
PositionEntity player, -4, 5, 0
ResetEntity player
UpdateWorld

; Spheres against polygons. Method 2, response 2 slides along what is hit.
Collisions T_PLAYER, T_GROUND, 2, 2
Collisions T_PLAYER, T_WALL, 2, 2
tested = 0
For i = 1 To 40
	TranslateEntity player, 0, -0.3, 0
	UpdateWorld
	If Stats3D(0) > 0 Then tested = tested + 1
Next
CheckTrue "Stats3D counts the triangles that collisions looked at", tested > 0
Check "Lands on the ground", EntityY(player), 1, 0.05
Check "EntityCollided", EntityCollided(player, T_GROUND), ground
Check "CountCollisions", CountCollisions(player) > 0, 1
Check "CollisionEntity", CollisionEntity(player, 1), ground
Check "CollisionNY of level ground", CollisionNY(player, 1), 1, 0.05
Check "CollisionNX of level ground", CollisionNX(player, 1), 0, 0.05
Check "CollisionNZ of level ground", CollisionNZ(player, 1), 0, 0.05
Check "CollisionY is the place that was touched", CollisionY(player, 1), 0, 0.1
CheckTrue "CollisionX is on the ground", Abs(CollisionX(player, 1)) <= 11
CheckTrue "CollisionZ is on the ground", Abs(CollisionZ(player, 1)) <= 11
CheckTrue "CollisionTime", CollisionTime(player, 1) >= 0 And CollisionTime(player, 1) <= 1
Check "CollisionSurface", CollisionSurface(player, 1), GetSurface(ground, 1)
CheckTrue "CollisionTriangle", CollisionTriangle(player, 1) >= 0 And CollisionTriangle(player, 1) < CountTriangles(GetSurface(ground, 1))
Check "Nothing was hit that was not in the way", EntityCollided(player, T_WALL), 0

; Running into the wall stops at its face, and slides on in the other direction.
For i = 1 To 40
	TranslateEntity player, 0.3, -0.1, 0.2
	UpdateWorld
Next
Check "Stopped by the wall", EntityX(player), 3, 0.05
Check "Slid along the wall", EntityZ(player), 8, 0.1
Check "EntityCollided with the wall", EntityCollided(player, T_WALL), wall
wallhit = 0
For i = 1 To CountCollisions(player)
	If CollisionEntity(player, i) = wall Then wallhit = i
Next
CheckTrue "there is a collision with the wall", wallhit > 0
Check "The wall faces away", CollisionNX(player, wallhit), -1, 0.1

; ClearCollisions takes the rules away.
ClearCollisions
PositionEntity player, -4, 5, 0
ResetEntity player
UpdateWorld
For i = 1 To 20
	TranslateEntity player, 0, -0.5, 0
	UpdateWorld
Next
CheckTrue "ClearCollisions", EntityY(player) < 0

; Response 1 stops where it hits.
Collisions T_PLAYER, T_GROUND, 2, 2
Collisions T_PLAYER, T_WALL, 2, 1
PositionEntity player, 0, 1, 0
ResetEntity player
UpdateWorld
For i = 1 To 40
	TranslateEntity player, 0.3, 0, 0.2
	UpdateWorld
Next
Check "Stopped dead, x", EntityX(player), 3, 0.05
CheckTrue "Stopped dead, z", EntityZ(player) < 2.5

; Spheres against spheres.
ball = CreatePivot()
EntityType ball, T_BALL
EntityRadius ball, 2
PositionEntity ball, 0, 1, -8
Collisions T_PLAYER, T_BALL, 1, 2
PositionEntity player, 0, 1, 0
ResetEntity player
UpdateWorld
For i = 1 To 40
	TranslateEntity player, 0, 0, -0.3
	UpdateWorld
Next
Check "Stopped by the ball", EntityZ(player), -5, 0.1
Check "Collided with the ball", EntityCollided(player, T_BALL), ball

; Spheres against boxes: the box is the one that the entity was given.
box = CreateCube()
EntityType box, T_BOX
EntityBox box, -2, -2, -2, 4, 4, 4
PositionEntity box, 0, 1, 10
Collisions T_PLAYER, T_BOX, 3, 2
PositionEntity player, 0, 1, 0
ResetEntity player
UpdateWorld
For i = 1 To 60
	TranslateEntity player, 0, 0, 0.3
	UpdateWorld
Next
Check "Stopped by the box", EntityZ(player), 7, 0.1
Check "Collided with the box", EntityCollided(player, T_BOX), box

; Picking: lines, from entities and through the camera.
Check "LinePick", LinePick(-4, 10, 0, 0, -20, 0), ground
Check "PickedEntity", PickedEntity(), ground
Check "PickedX", PickedX(), -4, 0.01
Check "PickedY", PickedY(), 0, 0.01
Check "PickedZ", PickedZ(), 0, 0.01
Check "PickedNX", PickedNX(), 0, 0.01
Check "PickedNY", PickedNY(), 1, 0.01
Check "PickedNZ", PickedNZ(), 0, 0.01
Check "PickedTime", PickedTime(), 0.5, 0.01
Check "PickedSurface", PickedSurface(), GetSurface(ground, 1)
CheckTrue "PickedTriangle", PickedTriangle() >= 0
Check "LinePick that misses", LinePick(0, 10, 0, 0, 5, 0), 0
Check "Nothing is picked", PickedEntity(), 0
Check "Nothing is picked, time", PickedTime(), 1, 0.01
Check "LinePick of a wall", LinePick(0, 5, 0, 20, 0, 0), wall
Check "LinePick of a wall, x", PickedX(), 4, 0.01
Check "LinePick of a wall, normal", PickedNX(), -1, 0.01
Check "LinePick with a radius", LinePick(-4, 10, 0, 0, -20, 0, 0.5), ground

; Things that are not meant to be picked are not.
EntityPickMode wall, 0
Check "A wall that can not be picked", LinePick(0, 5, 0, 20, 0, 0), 0
EntityPickMode wall, 2, False
Check "A wall that does not hide things", LinePick(0, 5, 0, 20, 0, 0), wall
EntityPickMode wall, 1
CheckTrue "Spheres can be picked", LinePick(0, 5, 0, 20, 0, 0) = wall Or LinePick(0, 5, 0, 20, 0, 0) = 0
EntityPickMode wall, 3
CheckTrue "Boxes can be picked", LinePick(0, 5, 0, 20, 0, 0) = wall Or LinePick(0, 5, 0, 20, 0, 0) = 0
EntityPickMode wall, 2

; An entity picks what is in front of it, as far as it is asked to.
looker = CreatePivot()
PositionEntity looker, -8, 2, 0
RotateEntity looker, 0, -90, 0
Check "EntityPick", EntityPick(looker, 30), wall
Check "EntityPick that is too short", EntityPick(looker, 5), 0

; The camera picks what is at a place of the screen.
camera = CreateCamera()
PositionEntity camera, -4, 10, 0
RotateEntity camera, 90, 0, 0
Check "CameraPick", CameraPick(camera, 160, 120), ground
Check "CameraPick at the edge", CameraPick(camera, 0, 0) <> wall, 1
Check "CameraPick position", PickedY(), 0, 0.01
Check "CameraPick of the sky", CameraPick(camera, 160, 120) <> 0, 1

; Looking through things.
seen = CreatePivot()
PositionEntity seen, 8, 2, 0
PositionEntity looker, -8, 2, 0
Check "A wall in the way", EntityVisible(looker, seen), 0
Check "Nothing in the way", EntityVisible(looker, ground), 1
EntityPickMode wall, 2, False
Check "Seeing through what does not obscure", EntityVisible(looker, seen), 1

; Meshes that touch.
a = CreateCube()
b = CreateCube()
PositionEntity b, 1, 0, 0
c = CreateCube()
PositionEntity c, 5, 0, 0
Check "MeshesIntersect", MeshesIntersect(a, b), 1
Check "MeshesIntersect apart", MeshesIntersect(a, c), 0

EndGraphics
Done "blitz3d_collisions"
