; Skinned models: the vertices that a bone pulls on are moved by it, and the ones that no bone pulls on stay where they are.
Include "check.bb"

Graphics3D 320, 240, 32, 2

Function WriteTag(file, tag$, size)
	For i = 1 To 4
		WriteByte file, Asc(Mid$(tag, i, 1))
	Next
	WriteInt file, size
End Function

; The head of a node: a name of one letter, a position, a scale of 1 and no turn. A node ahead of it has the size of what follows.
Function WriteNode(file, size, name$, x#, y#, z#)
	WriteTag file, "NODE", size
	WriteByte file, Asc(name) : WriteByte file, 0
	WriteFloat file, x : WriteFloat file, y : WriteFloat file, z
	WriteFloat file, 1 : WriteFloat file, 1 : WriteFloat file, 1
	WriteFloat file, 1 : WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
End Function

Function WriteVertex(file, x#, y#, z#)
	WriteFloat file, x : WriteFloat file, y : WriteFloat file, z
End Function

; A mesh of one triangle with a bone below it. The bone pulls on the first two vertices (a bone at rest does not move them), the third
; vertex is not pulled on by anything and is 5 units away from the plane the others are in.
; The vertices are 3 * 12 + 12 = 48 bytes, the triangle 4 + 3 * 4 = 16, the mesh 4 + (8 + 48) + (8 + 16) = 84, the bone 2 * 8 = 16, the node
; of the bone 42 + (8 + 16) = 66 and the one of the mesh 42 + (8 + 84) + (8 + 66) = 208.
folder$ = "suite_tmp_skinning"
CreateDir folder
name$ = folder + "/skinned.b3d"
file = WriteFile(name)
WriteTag file, "BB3D", 4 + 8 + 208
WriteInt file, 1
WriteNode file, 208, "m", 0, 0, 0
WriteTag file, "MESH", 84
WriteInt file, -1
WriteTag file, "VRTS", 48
WriteInt file, 0 : WriteInt file, 0 : WriteInt file, 0
WriteVertex file, 0, 0, 0
WriteVertex file, 1, 0, 0
WriteVertex file, 0, 1, 5
WriteTag file, "TRIS", 16
WriteInt file, -1
WriteInt file, 0 : WriteInt file, 1 : WriteInt file, 2
WriteNode file, 66, "b", 0, 0, 0
WriteTag file, "BONE", 16
WriteInt file, 0 : WriteFloat file, 1
WriteInt file, 1 : WriteFloat file, 1
CloseFile file

model = LoadAnimMesh(name)
CheckTrue "LoadAnimMesh of the skinned fixture", model <> 0
surf = GetSurface(model, 1)
CheckTrue "The mesh has a surface", surf <> 0
Check "Vertices before posing", VertexZ(surf, 2), 5

SetAnimTime model, 0
Check "A vertex of a bone at rest stays x", VertexX(surf, 1), 1
Check "A vertex of a bone at rest stays y", VertexY(surf, 1), 0
Check "A vertex of a bone at rest stays z", VertexZ(surf, 1), 0
Check "A vertex without a bone stays x", VertexX(surf, 2), 0
Check "A vertex without a bone stays y", VertexY(surf, 2), 1
Check "A vertex without a bone stays z", VertexZ(surf, 2), 5

FreeEntity model
DeleteFile name
DeleteDir folder
Done "blitz3d_skinning"
