; What the host of a multiplayer game lets a program do that joined it: a program that has not said hello can't send more than a hello, and
; a program that said hello can have a number of players, not as many as it likes. The programs are made here with streams, by hand.
Include "check.bb"

Const GAME$ = "limits game"
Const PORT = 40612

SetEnv "BLITZLLVM_NETGAME_PORT", Str$(PORT)
Check "HostNetGame", HostNetGame(GAME), 2

; Lets the host take in what arrived.
Function Pump(rounds)
	For i = 1 To rounds
		While RecvNetMsg() : Wend
		Delay 10
	Next
End Function

; A frame is its length (the kind and what follows it), the kind, and what follows.
Function WriteFrameHead(stream, kind, size)
	WriteInt stream, size + 1
	WriteByte stream, kind
End Function

; A program that says it has a frame of a million bytes and sends some of it is dropped before the rest comes.
junk = OpenTCPStream("127.0.0.1", PORT)
CheckTrue "OpenTCPStream for the junk", junk <> 0
WriteFrameHead junk, 1, 1000000
For i = 1 To 1500 : WriteInt junk, 0 : Next
Pump 50
CheckTrue "A frame that is too big for a hello closes the connection", Eof(junk)
CloseTCPStream junk

; A program that says hello and then asks for 70 players gets 64.
client = OpenTCPStream("127.0.0.1", PORT)
CheckTrue "OpenTCPStream for the player", client <> 0
WriteFrameHead client, 1, Len(GAME)
WriteLineless client, GAME
Pump 20
CheckTrue "The hello is answered", ReadAvail(client) >= 5
Check "Length of the welcome", ReadInt(client), 1
Check "Kind of the welcome", ReadByte(client), 10
For i = 1 To 70
	WriteFrameHead client, 2, 1
	WriteByte client, Asc("p")
Next
Pump 50
made = 0
For i = 1 To 70
	If ReadAvail(client) < 9 Then Exit
	ReadInt client
	ReadByte client
	If ReadInt(client) <> 0 Then made = made + 1
Next
Check "A program has at most 64 players", made, 64
CloseTCPStream client
Pump 10

StopNetGame
Done "multiplayer_limits"

; The bytes of a text and nothing after them.
Function WriteLineless(stream, text$)
	For i = 1 To Len(text)
		WriteByte stream, Asc(Mid$(text, i, 1))
	Next
End Function
