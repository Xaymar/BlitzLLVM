; SetGamma and UpdateGamma change what the window shows, not what was drawn, and never the gamma of the display. This
; needs a window and a GPU, so it is skipped without one. BLITZ_TEST_PRESENT makes the runtime write what it showed
; to a file after every present.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_gamma_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 48

; The color the window showed at a point, from the picture the runtime wrote.
Function Shown(x, y)
	f = ReadFile("present.tmp")
	If f = 0 Then RuntimeError "Nothing was presented."
	skip = 0
	For line = 1 To 3
		skip = skip + Len(ReadLine$(f)) + 1
	Next
	SeekFile f, skip + (y * W + x) * 3
	r = ReadByte(f)
	g = ReadByte(f)
	b = ReadByte(f)
	CloseFile f
	Return (r Shl 16) Or (g Shl 8) Or b
End Function

Function ResetGamma()
	For i = 0 To 255
		SetGamma i, i, i, i, i, i
	Next
	UpdateGamma
End Function

SetEnv "BLITZ_TEST_PRESENT", "present.tmp"
Graphics W, H, 32, 2
SetBuffer BackBuffer()
Color 100, 150, 200
Rect 0, 0, W, H, 1
Flip

Check "nothing changed shows what was drawn", Shown(10, 10), $6496C8

; The tables are only remembered until UpdateGamma.
SetGamma 100, 150, 200, 10, 20, 30
Check "GammaRed is set", GammaRed(100), 10
Check "GammaGreen is set", GammaGreen(150), 20
Check "GammaBlue is set", GammaBlue(200), 30
Flip
Check "SetGamma alone shows nothing", Shown(10, 10), $6496C8

UpdateGamma
Flip
Check "UpdateGamma shows the tables", Shown(10, 10), $0A141E
; What was drawn is not changed, only what the window shows.
Check "ReadPixel is not gamma corrected", ReadPixel(10, 10) And $FFFFFF, $6496C8

; A color without an entry of its own is shown as it is.
Color 7, 8, 9
Rect 20, 20, 10, 10, 1
Flip
Check "other colors are not changed", Shown(25, 25), $070809

; Every step can be set: this turns the picture into its negative.
For i = 0 To 255
	SetGamma i, i, i, 255 - i, 255 - i, 255 - i
Next
UpdateGamma
Flip
Check "negative of a dark color", Shown(25, 25), $F8F7F6
Check "negative of the other color", Shown(10, 10), $9B6937

ResetGamma
Flip
Check "back to normal", Shown(10, 10), $6496C8

; UpdateGamma also changes what a program shows that draws to the front buffer and never flips.
SetBuffer FrontBuffer()
Color 40, 80, 120
Rect 0, 0, W, H, 1
SetGamma 40, 80, 120, 200, 100, 50
UpdateGamma
Check "the front buffer is shown through the tables", Shown(5, 5), $C86432
Check "the front buffer is not changed", ReadPixel(5, 5) And $FFFFFF, $285078

ResetGamma
Check "front buffer back to normal", Shown(5, 5), $285078

; Fractions and values out of range are kept.
SetGamma 3, 3, 3, 12.25, -4, 999
Check "fraction", GammaRed(3), 12.25
Check "below zero", GammaGreen(3), 0
Check "above 255", GammaBlue(3), 255
ResetGamma

; Dither adds noise of up to half a step to what is shown, so a value the picture can't show is a mix of its two
; neighbors in the right amounts, and one it can show stays as it is.
Function CountShown(value)
	f = ReadFile("present.tmp")
	If f = 0 Then RuntimeError "Nothing was presented."
	For line = 1 To 3
		ReadLine$(f)
	Next
	same = 0
	other = 0
	For i = 1 To W * H
		r = ReadByte(f)
		ReadByte(f)
		ReadByte(f)
		If r = value Then same = same + 1
		If r = value + 1 Then other = other + 1
	Next
	CloseFile f
	If same + other <> W * H Then RuntimeError "A value of the dithered picture is not one of the two neighbors."
	Return other
End Function

SetBuffer BackBuffer()
Color 100, 100, 100
Rect 0, 0, W, H, 1
SetGamma 100, 100, 100, 100.25, 100.25, 100.25
UpdateGamma
Flip
Check "without Dither a fraction is rounded", CountShown(100), 0

Dither True
Flip
other = CountShown(100)
Check "with Dither the fraction is spread, not rounded away", other > (W * H) / 8 And other < (W * H) * 3 / 8, True

Dither False
Flip
Check "Dither False is rounding again", CountShown(100), 0

ResetGamma
Dither True
Color 100, 150, 200
Rect 0, 0, W, H, 1
Flip
Check "Dither does not change a color that is shown exactly", Shown(10, 10), $6496C8
Dither False
EndGraphics
DeleteFile "present.tmp"
Done "graphics_gamma_pixels"
