; Writing to a TCP stream that the other side has closed: the writes get nowhere, and the program goes on (on Linux and macOS it would
; be ended by the system if the signal for a broken connection was not turned off).
Include "check.bb"

TCPTimeouts 1000, 1000
port = 40733
server = CreateTCPServer(port)
CheckTrue "CreateTCPServer", server <> 0
client = OpenTCPStream("127.0.0.1", port)
CheckTrue "OpenTCPStream", client <> 0
accepted = 0
For i = 1 To 50
	accepted = AcceptTCPStream(server)
	If accepted <> 0 Then Exit
	Delay 20
Next
CheckTrue "AcceptTCPStream", accepted <> 0

; The client goes away. The first write after that is sent and answered with a reset, and the ones after it are the broken connection.
CloseTCPStream client
Delay 100
For i = 1 To 20
	WriteLine accepted, "Is anybody there?"
	Delay 10
Next
CheckTrue "The program goes on after writing to a closed connection", True

CloseTCPStream accepted
CloseTCPServer server
Done "network_closed_peer"
