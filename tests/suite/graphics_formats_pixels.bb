; What the image formats that are built into the runtime look like once loaded, which needs a window and a GPU, so
; this is skipped without one: LoadImage DrawBlock ReadPixel with WebP, AVIF and JPEG XL files. Each file has a red
; left half and a blue right half.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_formats_pixels: skipped, there is no window."
	End
EndIf

Graphics 160, 120, 32, 2
SetBuffer BackBuffer()

; Draws the image at the top left and checks the middle of both halves. Lossy formats are allowed to be a bit off.
Function CheckHalves(name$, file$, width)
	Cls
	image = LoadImage(file)
	CheckTrue name + " loads", image <> 0
	Check name + " width", ImageWidth(image), width
	DrawBlock image, 0, 0
	left = ReadPixel(width / 4, 4) And $FFFFFF
	right = ReadPixel(width - width / 4, 4) And $FFFFFF
	Check name + " left red", (left Shr 16) And 255, 255, 8
	Check name + " left green", (left Shr 8) And 255, 0, 8
	Check name + " left blue", left And 255, 0, 8
	Check name + " right red", (right Shr 16) And 255, 0, 8
	Check name + " right green", (right Shr 8) And 255, 0, 8
	Check name + " right blue", right And 255, 255, 8
	FreeImage image
End Function

CheckHalves "WebP", "images/pixels.webp", 16
CheckHalves "AVIF", "images/pixels.avif", 24
CheckHalves "JPEG XL", "images/pixels.jxl", 32

EndGraphics
Done "graphics_formats_pixels"
