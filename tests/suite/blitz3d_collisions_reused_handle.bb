; Collisions of an entity that was freed: a new entity must start with none, even when it gets the freed entity's handle.
; CountCollisions CollisionEntity FreeEntity UpdateWorld EntityType EntityRadius Collisions
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Const T_SHOT = 1, T_ASTEROID = 2

Collisions T_SHOT, T_ASTEROID, 1, 1

asteroid = CreatePivot()
EntityType asteroid, T_ASTEROID
EntityRadius asteroid, 5
PositionEntity asteroid, 0, 0, 10

shot = CreatePivot()
EntityType shot, T_SHOT
EntityRadius shot, 1
PositionEntity shot, 0, 0, 0
ResetEntity shot
TranslateEntity shot, 0, 0, 10
UpdateWorld
Check "The shot hit the asteroid", CountCollisions(shot), 1
Check "The shot hit the asteroid, entity", CollisionEntity(shot, 1), asteroid

; Free the shot and the asteroid. A new shot has no collisions yet, whatever the freed entity had.
FreeEntity shot
FreeEntity asteroid
shot2 = CreatePivot()
EntityType shot2, T_SHOT
EntityRadius shot2, 1
Check "A new shot has no collisions", CountCollisions(shot2), 0
Check "A new shot has no collided entity", EntityCollided(shot2, T_ASTEROID), 0
EndGraphics
