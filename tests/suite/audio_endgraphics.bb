; EndGraphics takes down the window and the graphics device, not the sound: a sound that was loaded before keeps working after it, and the
; program ends without a crash of the sound system that was taken down twice. Without a sound device (like in the automatic tests) nothing
; plays, which only leaves the part about the crash at the end of the program to be tested on a computer that has one.
Include "check.bb"

folder$ = "suite_tmp_audio_endgraphics"
CreateDir folder
name$ = folder + "/tone.wav"
rate = 22050
samples = rate / 10
file = WriteFile(name)
WriteByte file, Asc("R") : WriteByte file, Asc("I") : WriteByte file, Asc("F") : WriteByte file, Asc("F")
WriteInt file, 36 + samples * 2
WriteByte file, Asc("W") : WriteByte file, Asc("A") : WriteByte file, Asc("V") : WriteByte file, Asc("E")
WriteByte file, Asc("f") : WriteByte file, Asc("m") : WriteByte file, Asc("t") : WriteByte file, Asc(" ")
WriteInt file, 16
WriteShort file, 1
WriteShort file, 1
WriteInt file, rate
WriteInt file, rate * 2
WriteShort file, 2
WriteShort file, 16
WriteByte file, Asc("d") : WriteByte file, Asc("a") : WriteByte file, Asc("t") : WriteByte file, Asc("a")
WriteInt file, samples * 2
For i = 0 To samples - 1
	WriteShort file, Sin(Float(i) * 360.0 * 440.0 / rate) * 8000
Next
CloseFile file

sound = LoadSound(name)
CheckTrue "LoadSound", sound <> 0
Graphics3D 64, 64, 0, 2
channel = PlaySound(sound)
EndGraphics
; The sound system is still there: the same sound plays again.
channel = PlaySound(sound)
If channel <> 0 Then StopChannel channel

FreeSound sound
DeleteFile name
DeleteDir folder
Done "audio_endgraphics"
