; TextureBlend 0 to 5 of the first texture, with and without an alpha channel and vertex colors, against pixels read from the
; original Blitz3D 1.118 (Direct3D 7 through Wine) with tests/lighting_compare/texblend.bb. Every channel has to be within 8 levels.
; Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_texture_blend_original_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 40, 60, 90
CameraRange camera, 0.1, 100

Global quad = CreateMesh()
s = CreateSurface(quad)
For iy = 0 To 8
For ix = 0 To 16
	v = AddVertex(s, -3 + ix * 6.0 / 16, 1.5 - iy * 3.0 / 8, ix * 0.5, ix / 16.0, iy / 8.0)
	VertexNormal s, v, 0, 0, -1
	VertexColor s, v, 255 - ix * 12, 60 + iy * 12, 128 + ix * 4 - iy * 4, 1.0 - ix / 40.0
Next
Next
For iy = 0 To 7
For ix = 0 To 15
	a = iy * 17 + ix
	AddTriangle s, a, a + 1, a + 17
	AddTriangle s, a + 1, a + 18, a + 17
Next
Next

Global tex = CreateTexture(32, 32, 3 + 4096)
SetBuffer TextureBuffer(tex)
For y = 0 To 31
For x = 0 To 31
	WritePixel x, y, ((100 + x * 4) Shl 24) Or ((50 + x * 6) Shl 16) Or ((200 - y * 5) Shl 8) Or (80 + y * 5)
Next
Next
SetBuffer BackBuffer()
EntityTexture quad, tex
Global light = CreateLight()
RotateEntity light, 30, 20, 0
AmbientLight 60, 60, 60


; Pixels x = 34, 52, 70, 88, 106, 124 of the row y = 60, as red, green and blue each.
Function CheckRow(name$, r1, g1, b1, r2, g2, b2, r3, g3, b3, r4, g4, b4, r5, g5, b5, r6, g6, b6)
	RenderWorld
	Local x
	For i = 0 To 5
		x = 34 + i * 18
		p = ReadPixel(x, 60, BackBuffer())
		Select i
			Case 0 : wr = r1 : wg = g1 : wb = b1
			Case 1 : wr = r2 : wg = g2 : wb = b2
			Case 2 : wr = r3 : wg = g3 : wb = b3
			Case 3 : wr = r4 : wg = g4 : wb = b4
			Case 4 : wr = r5 : wg = g5 : wb = b5
			Case 5 : wr = r6 : wg = g6 : wb = b6
		End Select
		Check name$ + " red at " + x, (p Shr 16) And 255, wr, 8
		Check name$ + " green at " + x, (p Shr 8) And 255, wg, 8
		Check name$ + " blue at " + x, p And 255, wb, 8
	Next
End Function

Global tex2 = CreateTexture(32, 32, 1 + 4096)
SetBuffer TextureBuffer(tex2)
For y = 0 To 31
For x = 0 To 31
	WritePixel x, y, ((30 + x * 6) Shl 16) Or ((220 - y * 6) Shl 8) Or (60 + x * 3)
Next
