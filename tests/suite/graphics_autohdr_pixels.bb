; AutoHDR turns the picture into scRGB for an HDR swapchain. A test machine has no HDR display, so BLITZLLVM_TEST_HDR makes
; the runtime run that pass anyway and write what it made after every present: "HDR", the size, then red, green and blue of
; every pixel as 32 bit floats. This needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_autohdr_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 48

; One channel (0 red, 1 green, 2 blue) of the pixel the HDR pass made at a point.
Function Shown#(x, y, channel)
	f = ReadFile("hdr.tmp")
	If f = 0 Then RuntimeError "Nothing was presented."
	skip = 0
	For line = 1 To 2
		skip = skip + Len(ReadLine$(f)) + 1
	Next
	SeekFile f, skip + ((y * W + x) * 3 + channel) * 4
	Local v# = ReadFloat(f)
	CloseFile f
	Return v
End Function

Function Fill(r, g, b)
	Color r, g, b
	Rect 0, 0, W, H, 1
End Function

DeleteFile "hdr.tmp" ; Not one of an earlier run.
SetEnv "BLITZLLVM_TEST_HDR", "hdr.tmp"

; It can be set before Graphics, and the test window has no HDR.
AutoHDR 1
AutoHDRWhite 160
Graphics W, H, 32, 2
SetBuffer BackBuffer()
CheckFalse "a test window is not shown in HDR", HWHDRActive()
CheckFalse "a test display has no HDR", HWHDRSupported()
Check "no peak is known", HWHDRPeakNits(), 0

; Mode 1 is the same picture, linear, with SDR white at 160 nits (2.0 in scRGB, where 1.0 is 80 nits).
Fill 100, 150, 200
Flip 2
Check "red is linear and scaled", Shown(10, 10, 0), 0.127438 * 2, 0.005
Check "green is linear and scaled", Shown(10, 10, 1), 0.304987 * 2, 0.005
Check "blue is linear and scaled", Shown(10, 10, 2), 0.577580 * 2, 0.005
Fill 0, 0, 0
Flip 2
Check "black stays black", Shown(10, 10, 1), 0, 0.001
Fill 255, 255, 255
Flip 2
Check "white is SDR white", Shown(10, 10, 0), 2, 0.005

; The brightness follows AutoHDRWhite.
AutoHDRWhite 320
Flip 2
Check "white at 320 nits", Shown(10, 10, 0), 4, 0.01

; Mode 2 lifts the highlights: with the strength 1 white reaches the peak (1000 nits is 12.5), mid tones are lifted less.
AutoHDR 2
AutoHDRWhite 160
AutoHDRPeak 1000
AutoHDRExpand 1
Flip 2
Check "white reaches the peak", Shown(10, 10, 0), 12.5, 0.05
Fill 128, 128, 128
Flip 2
Check "mid grey is lifted a little", Shown(10, 10, 1), 0.53733, 0.01
Fill 100, 150, 200
Flip 2
Check "a color is lifted by its luminance", Shown(10, 10, 2), 1.65442, 0.02

; Without the lift the picture is as in mode 1 again.
AutoHDRExpand 0
Flip 2
Check "no strength, no lift", Shown(10, 10, 2), 0.577580 * 2, 0.005

; The metadata is only told to the system, and any value is taken.
AutoHDRMetadata 0.01, 100, 1000
AutoHDRMetadata 0, 0, 0
Flip 2
Check "still the same picture", Shown(10, 10, 2), 0.577580 * 2, 0.005

DeleteFile "hdr.tmp"
Done "graphics_autohdr_pixels"
