; AutoHDR turns the picture into scRGB for an HDR swapchain. A test machine has no HDR display, so BLITZLLVM_TEST_HDR makes
; the runtime run that pass anyway and write what it made after every present: "HDR", the size, then red, green and blue of
; every pixel as 32 bit floats. This needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_autohdr_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 48

; One channel (0 red, 1 green, 2 blue) of the pixel the HDR pass made at a point.
Function Shown#(x, y, channel)
	f = ReadFile("hdr_pixels.tmp")
	If f = 0 Then RuntimeError "Nothing was presented."
	skip = 0
	For line = 1 To 2
		skip = skip + Len(ReadLine$(f)) + 1
	Next
	SeekFile f, skip + ((y * W + x) * 3 + channel) * 4
	Local v# = ReadFloat(f)
	CloseFile f
	Return v
End Function

; The picture of a Flip is written when it is shown, and a window can show one of its own before that (the first one the system asks for, or the one
; before it) at about the same time, so the file may still have an older picture. Two of the same picture, and the file has this one.
Function Show()
	Flip 2
	Flip 2
End Function

Function Fill(r, g, b)
	Color r, g, b
	Rect 0, 0, W, H, 1
End Function

DeleteFile "hdr_pixels.tmp" ; Not one of an earlier run.
SetEnv "BLITZLLVM_TEST_HDR", "hdr_pixels.tmp"

; It can be set before Graphics, and the test window has no HDR.
SetGraphicsHDR 1, 0, 160
Graphics W, H, 32, 2
SetBuffer BackBuffer()
CheckFalse "a test window is not shown in HDR", HWHDRActive()
CheckFalse "a test display has no HDR", HWHDRSupported()
Check "no peak is known", HWHDRPeakNits(), 0

; Mode 1 is the same picture, linear, with SDR white at 160 nits (2.0 in scRGB, where 1.0 is 80 nits).
Fill 100, 150, 200
Show
Check "red is linear and scaled", Shown(10, 10, 0), 0.127438 * 2, 0.005
Check "green is linear and scaled", Shown(10, 10, 1), 0.304987 * 2, 0.005
Check "blue is linear and scaled", Shown(10, 10, 2), 0.577580 * 2, 0.005
Fill 0, 0, 0
Show
Check "black stays black", Shown(10, 10, 1), 0, 0.001
Fill 255, 255, 255
Show
Check "white is SDR white", Shown(10, 10, 0), 2, 0.005

; The brightness follows AutoHDRWhite.
SetGraphicsHDR 1, 0, 320
Show
Check "white at 320 nits", Shown(10, 10, 0), 4, 0.01

; Mode 2 shows an 8 bit buffer as mode 1 does.
SetGraphicsHDR 2, 0, 160
Fill 100, 150, 200
Show
Check "mode 2 shows 8 bits as mode 1", Shown(10, 10, 2), 0.577580 * 2, 0.005
Fill 255, 255, 255
Show
Check "white stays SDR white", Shown(10, 10, 0), 2, 0.005

; The metadata is only told to the system, and any value is taken.
SetGraphicsHDR 2, 0.01, 160, 1000
SetGraphicsHDR 2, 0, 160, 0
Show
Check "still the same picture", Shown(10, 10, 0), 2, 0.005

; GetGraphicsHDR gives back what is in use.
SetGraphicsHDR 2, 0.5, 160, 800
GetGraphicsHDR m, lo#, av#, hi#
Check "the mode", m, 2
Check "the black level", lo, 0.5, 0.001
Check "the SDR white", av, 160, 0.001
Check "the peak", hi, 800, 0.001
GetGraphicsHDR m
Check "one value is enough", m, 2
Show
Check "white is below the peak", Shown(10, 10, 0), 2, 0.005

DeleteFile "hdr_pixels.tmp"
Done "graphics_autohdr_pixels"
