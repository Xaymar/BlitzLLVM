; Loading .b3d files that say more than they have: nodes inside of nodes without end, and counts that are for every vertex.
; Models come from other people, so a file like this has to be refused and not make the program crash or wait for ever.
Include "check.bb"

Graphics3D 320, 240, 32, 2

folder$ = "suite_tmp_b3d_limits"
CreateDir folder

; The start of a NODE chunk: its name, position, scale and turn.
Function WriteNode(file, size)
	WriteByte file, Asc("N") : WriteByte file, Asc("O") : WriteByte file, Asc("D") : WriteByte file, Asc("E")
	WriteInt file, size
	WriteByte file, 0
	For i = 1 To 3 : WriteFloat file, 0.0 : Next
	For i = 1 To 3 : WriteFloat file, 1.0 : Next
	WriteFloat file, 1.0
	For i = 1 To 3 : WriteFloat file, 0.0 : Next
End Function

Function WriteTag(file, a$, b$, c$, d$, size)
	WriteByte file, Asc(a) : WriteByte file, Asc(b) : WriteByte file, Asc(c) : WriteByte file, Asc(d)
	WriteInt file, size
End Function

; Every node has another one in it, 400000 deep. Each takes 41 bytes for itself and 8 for the one inside.
depth = 400000
name$ = folder + "/nested.b3d"
file = WriteFile(name)
WriteTag file, "B", "B", "3", "D", 4 + 8 + 41 + 49 * (depth - 1)
WriteInt file, 1
For i = 0 To depth - 1
	WriteNode file, 41 + 49 * (depth - 1 - i)
Next
CloseFile file
Check "Nested nodes are refused", LoadMesh(name), 0
Check "Nested nodes are refused (animated)", LoadAnimMesh(name), 0
DeleteFile name

; A vertex chunk that has 2 billion sets of 2 billion numbers for each vertex, and one vertex.
name$ = folder + "/sets.b3d"
file = WriteFile(name)
mesh_size = 4 + 8 + 12 + 12
node_size = 41 + 8 + mesh_size
WriteTag file, "B", "B", "3", "D", 4 + 8 + node_size
WriteInt file, 1
WriteNode file, node_size
WriteTag file, "M", "E", "S", "H", mesh_size
WriteInt file, -1
WriteTag file, "V", "R", "T", "S", 12 + 12
WriteInt file, 0
WriteInt file, $7FFFFFFF
WriteInt file, $7FFFFFFF
For i = 1 To 3 : WriteFloat file, 0.0 : Next
CloseFile file
Check "Too many sets are refused", LoadMesh(name), 0
DeleteFile name

; A brush with 2 billion textures.
name$ = folder + "/brush.b3d"
file = WriteFile(name)
WriteTag file, "B", "B", "3", "D", 4 + 8 + 4 + 1 + 32
WriteInt file, 1
WriteTag file, "B", "R", "U", "S", 4 + 1 + 32
WriteInt file, $7FFFFFFF
WriteByte file, 0
For i = 1 To 8 : WriteFloat file, 0.0 : Next
CloseFile file
Check "Too many textures are refused", LoadMesh(name), 0
DeleteFile name

DeleteDir folder
Done "blitz3d_b3d_limits"
