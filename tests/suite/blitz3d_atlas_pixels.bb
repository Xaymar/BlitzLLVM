; LoadAtlas and AtlasTexture, which need a window and a GPU, so this is skipped without one. A picture of four colored
; tiles is loaded once, and a view of each tile is shown fullbright on a cube that is magnified, where linear filtering would
; mix in the neighbouring tile at every edge if the views did not keep half a texel away from it.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_atlas_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
Global cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 255, 255
PositionEntity cube, 0, 0, 3
ClearTextureFilters

; Four tiles of 32 pixels: red, green, blue and yellow.
sheet = CreateTexture(64, 64, 1 + 4096)
SetBuffer TextureBuffer(sheet)
Color 255, 0, 0 : Rect 0, 0, 32, 32, 1
Color 0, 255, 0 : Rect 32, 0, 32, 32, 1
Color 0, 0, 255 : Rect 0, 32, 32, 32, 1
Color 255, 255, 0 : Rect 32, 32, 32, 32, 1
SaveBuffer TextureBuffer(sheet), "suite_atlas.bmp"
SetBuffer BackBuffer()
FreeTexture sheet

Function Rgb(x, y)
	Return ReadPixel(x, y, BackBuffer()) And $FFFFFF
End Function

; Where the front of the cube is, found by drawing it white.
RenderWorld
Global x0 = 1000, x1 = -1, y0 = 1000, y1 = -1
For y = 0 To 119
	For x = 0 To 159
		If ReadPixel(x, y, BackBuffer()) And $FFFFFF Then
			If x < x0 Then x0 = x
			If x > x1 Then x1 = x
			If y < y0 Then y0 = y
			If y > y1 Then y1 = y
		EndIf
	Next
Next
CheckTrue "The cube is on screen", x1 - x0 > 60 And y1 - y0 > 60

; How many pixels of the front of the cube are not this color.
Function Wrong(texture, r, g, b)
	EntityTexture cube, texture
	RenderWorld
	bad = 0
	For y = y0 To y1
		For x = x0 To x1
			c = ReadPixel(x, y, BackBuffer())
			If Abs(((c Shr 16) And 255) - r) > 12 Or Abs(((c Shr 8) And 255) - g) > 12 Or Abs((c And 255) - b) > 12 Then bad = bad + 1
		Next
	Next
	Return bad
End Function

For mips = 0 To 8 Step 8
	atlas = LoadAtlas("suite_atlas.bmp", 1 + mips)
	CheckTrue "LoadAtlas", atlas <> 0
	red = AtlasTexture(atlas, 0, 0, 32, 32)
	green = AtlasTexture(atlas, 32, 0, 32, 32)
	blue = AtlasTexture(atlas, 0, 32, 32, 32)
	yellow = AtlasTexture(atlas, 32, 32, 32, 32)
	CheckTrue "AtlasTexture", red <> 0 And green <> 0 And blue <> 0 And yellow <> 0 And red <> atlas

	Check "TextureWidth of a view", TextureWidth(red), 32
	Check "TextureHeight of a view", TextureHeight(yellow), 32
	Check "TextureWidth of the atlas", TextureWidth(atlas), 64

	Check "A tile outside the atlas", AtlasTexture(atlas, 40, 0, 32, 32), 0
	Check "A tile with no size", AtlasTexture(atlas, 0, 0, 0, 8), 0
	Check "A tile at a negative position", AtlasTexture(atlas, -1, 0, 8, 8), 0

	Check "Red tile, no other color (mips " + mips + ")", Wrong(red, 255, 0, 0), 0
	Check "Green tile (mips " + mips + ")", Wrong(green, 0, 255, 0), 0
	Check "Blue tile (mips " + mips + ")", Wrong(blue, 0, 0, 255), 0
	Check "Yellow tile (mips " + mips + ")", Wrong(yellow, 255, 255, 0), 0

	; The atlas can go while its views are still used, which keep the picture.
	FreeTexture atlas
	Check "A freed atlas has no width", TextureWidth(atlas), 0
	Check "A view outlives its atlas", Wrong(green, 0, 255, 0), 0
	Check "The width of a view outlives its atlas", TextureWidth(green), 32
	FreeTexture red
	FreeTexture green
	FreeTexture blue
	FreeTexture yellow
Next

; A view can be any rectangle: the top half of the picture shows red and green next to each other.
atlas = LoadAtlas("suite_atlas.bmp", 1)
half = AtlasTexture(atlas, 0, 0, 64, 32)
EntityTexture cube, half
RenderWorld
CheckTrue "The top half shows red on the left", Abs(((Rgb(60, 60) Shr 16) And 255) - 255) < 12 And (Rgb(60, 60) And $FF00) < $0C00
CheckTrue "The top half shows green on the right", ((Rgb(100, 60) Shr 8) And 255) > 240 And ((Rgb(100, 60) Shr 16) And 255) < 12
Done "blitz3d_atlas_pixels"
