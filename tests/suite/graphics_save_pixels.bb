; Writing pictures, which needs a window and a GPU, so this is skipped without one: SaveBuffer SaveImage SaveTexture with
; BMP, PNG, JPEG, WebP, JPEG XL and TGA files, their settings, and the metadata that says which program made the file.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_save_pixels: skipped, there is no window."
	End
EndIf

Graphics 96, 64, 32, 2
SetBuffer BackBuffer()

; The files this test makes have a name of their own, because the release and debug runs of it can be at the same time.
SeedRnd MilliSecs()
unique$ = "suite_save_" + Rand(1, 1000000000) + "_"

Const W = 96, H = 64

; What is drawn: a gradient, shapes and a flat area, so that both smooth and sharp parts have to be written.
Function Draw()
	Cls
	For y = 0 To H - 1
		Color y * 4, 255 - y * 4, (y * 9) Mod 256
		Line 0, y, W - 1, y
	Next
	Color 255, 255, 0
	Oval 8, 6, 40, 36, 1
	Color 0, 0, 255
	Rect 52, 20, 36, 28, 1
	Color 255, 255, 255
	Rect 0, 0, 20, 8, 1
End Function

; The file as bytes.
Function FileBank(name$)
	size = FileSize(name)
	bank = CreateBank(size)
	f = ReadFile(name)
	If f <> 0 Then
		ReadBytes bank, f, 0, size
		CloseFile f
	EndIf
	Return bank
End Function

; Whether the text is somewhere in the file.
Function Contains(name$, text$)
	bank = FileBank(name)
	n = BankSize(bank)
	t = Len(text)
	found = False
	For i = 0 To n - t
		If PeekByte(bank, i) = Asc(Left(text, 1)) Then
			ok = True
			For k = 1 To t - 1
				If PeekByte(bank, i + k) <> Asc(Mid(text, k + 1, 1)) Then ok = False : Exit
			Next
			If ok Then found = True : Exit
		EndIf
	Next
	FreeBank bank
	Return found
End Function

; The offset of a two byte marker (FF xx) in a JPEG file, or -1.
Function Marker(name$, kind)
	bank = FileBank(name)
	at = -1
	For i = 0 To BankSize(bank) - 2
		If PeekByte(bank, i) = $FF And PeekByte(bank, i + 1) = kind Then at = i : Exit
	Next
	FreeBank bank
	Return at
End Function

; The sampling factors of the first component of a JPEG file: 17 (1x1), 33 (2x1) or 34 (2x2).
Function Sampling(name$)
	bank = FileBank(name)
	at = -1
	For i = 0 To BankSize(bank) - 2
		If PeekByte(bank, i) = $FF And (PeekByte(bank, i + 1) = $C0 Or PeekByte(bank, i + 1) = $C2) Then at = i : Exit
	Next
	result = 0
	If at >= 0 Then result = PeekByte(bank, at + 11)
	FreeBank bank
	Return result
End Function

; How far the picture in a file is from the front buffer, in the average of a color channel over a grid of pixels.
Function Error#(name$)
	img = LoadImage(name)
	If img = 0 Then Return 1000
	total# = 0
	count = 0
	For y = 0 To H - 1 Step 3
		For x = 0 To W - 1 Step 3
			a = ReadPixel(x, y, ImageBuffer(img))
			b = ReadPixel(x, y, FrontBuffer())
			total = total + Abs(((a Shr 16) And 255) - ((b Shr 16) And 255)) + Abs(((a Shr 8) And 255) - ((b Shr 8) And 255)) + Abs((a And 255) - (b And 255))
			count = count + 3
		Next
	Next
	FreeImage img
	Return total / count
End Function

Draw
Flip

; Every format: the call works, the file is made, and it holds the picture (exactly for what has no loss).
Dim names$(6)
names(0) = unique + "a.bmp"
names(1) = unique + "a.png"
names(2) = unique + "a.tga"
names(3) = unique + "b.webp"
names(4) = unique + "b.jxl"
names(5) = unique + "b.jpg"
names(6) = unique + "c.jpeg"
For i = 0 To 6
	Check "SaveBuffer " + names(i), SaveBuffer(FrontBuffer(), names(i)), 1
	CheckTrue "The file of " + names(i), FileSize(names(i)) > 100
Next
; The ones with no loss.
For i = 0 To 2
	Check "No loss in " + names(i), Error(names(i)), 0
Next
Check "Lossy WebP", Error(names(3)), 2.5, 2.5
Check "Lossy JPEG XL", Error(names(4)), 2.5, 2.5
Check "JPEG", Error(names(5)), 5, 5
Check "JPEG with the .jpeg extension", Error(names(6)), 5, 5

; Lossless settings.
Check "SaveBuffer lossless WebP", SaveBuffer(FrontBuffer(), unique + "l.webp", "lossless=1"), 1
Check "Lossless WebP has no loss", Error(unique + "l.webp"), 0
Check "SaveBuffer lossless JPEG XL", SaveBuffer(FrontBuffer(), unique + "l.jxl", "lossless=1"), 1
Check "Lossless JPEG XL has no loss", Error(unique + "l.jxl"), 0
Check "Distance 0 is lossless too", SaveBuffer(FrontBuffer(), unique + "d.jxl", "distance=0"), 1
Check "Distance 0 JPEG XL has no loss", Error(unique + "d.jxl"), 0

; The settings change the files.
SaveBuffer FrontBuffer(), unique + "q10.jpg", "quality=10"
SaveBuffer FrontBuffer(), unique + "q95.jpg", "quality=95"
CheckTrue "A lower quality is a smaller JPEG", FileSize(unique + "q10.jpg") < FileSize(unique + "q95.jpg")
CheckTrue "A lower quality is further from the picture", Error(unique + "q10.jpg") > Error(unique + "q95.jpg")
SaveBuffer FrontBuffer(), unique + "s444.jpg", "subsampling=444"
SaveBuffer FrontBuffer(), unique + "s422.jpg", "subsampling=4:2:2"
SaveBuffer FrontBuffer(), unique + "s420.jpg", "subsampling=420"
Check "4:4:4 sampling", Sampling(unique + "s444.jpg"), 17
Check "4:2:2 sampling", Sampling(unique + "s422.jpg"), 33
Check "4:2:0 sampling", Sampling(unique + "s420.jpg"), 34
Check "4:2:0 is the default", Sampling(names(5)), 34
CheckTrue "4:2:0 is smaller than 4:4:4", FileSize(unique + "s420.jpg") < FileSize(unique + "s444.jpg")
Check "A 4:2:2 JPEG is close to the picture", Error(unique + "s422.jpg"), 5, 5
Check "A 4:4:4 JPEG is close to the picture", Error(unique + "s444.jpg"), 5, 5
SaveBuffer FrontBuffer(), unique + "prog.jpg", "progressive=1, subsampling=422"
CheckTrue "A progressive JPEG has a progressive frame", Marker(unique + "prog.jpg", $C2) >= 0
CheckTrue "A baseline JPEG has a baseline frame", Marker(unique + "s420.jpg", $C0) >= 0 And Marker(unique + "s420.jpg", $C2) < 0
Check "A progressive JPEG is close to the picture", Error(unique + "prog.jpg"), 5, 5
SaveBuffer FrontBuffer(), unique + "c0.png", "compression=0"
SaveBuffer FrontBuffer(), unique + "c9.png", "compression=9"
CheckTrue "More PNG compression is smaller", FileSize(unique + "c9.png") <= FileSize(unique + "c0.png")
Check "PNG with the most compression has no loss", Error(unique + "c9.png"), 0
SaveBuffer FrontBuffer(), unique + "rle.tga", "rle=1"
SaveBuffer FrontBuffer(), unique + "raw.tga", "rle=0"
CheckTrue "RLE makes a TGA smaller", FileSize(unique + "rle.tga") < FileSize(unique + "raw.tga")
Check "TGA without RLE has no loss", Error(unique + "raw.tga"), 0
SaveBuffer FrontBuffer(), unique + "e9.jxl", "effort=9"
Check "JPEG XL with the most effort", Error(unique + "e9.jxl"), 2.5, 2.5

; Settings that don't exist or don't fit are not an error, and the ones that fit still count.
Check "Unknown setting", SaveBuffer(FrontBuffer(), unique + "u.png", "nothing=1, compression=9"), 1
Check "Setting with a bad value", SaveBuffer(FrontBuffer(), unique + "v.jpg", "quality=high"), 1
Check "Settings of other formats", SaveBuffer(FrontBuffer(), unique + "w.png", "quality=5,subsampling=444,progressive=1"), 1
Check "Settings of other formats leave the picture alone", Error(unique + "w.png"), 0
Check "Upper case and separators", SaveBuffer(FrontBuffer(), unique + "x.jpg", "Quality=20;Subsampling=444 Progressive"), 1
Check "Upper case settings count", Sampling(unique + "x.jpg"), 17
CheckTrue "A bare setting is on", Marker(unique + "x.jpg", $C2) >= 0

; Formats that can't be written, and what is not a format: the name is a BMP, like the original always wrote.
Check "AVIF is not written", SaveBuffer(FrontBuffer(), unique + "n.avif"), 0
CheckFalse "No AVIF file is left", FileSize(unique + "n.avif") > 0
Check "Other extension", SaveBuffer(FrontBuffer(), unique + "o.dat"), 1
bank = FileBank(unique + "o.dat")
Check "An unknown extension is a BMP", PeekByte(bank, 0) * 256 + PeekByte(bank, 1), Asc("B") * 256 + Asc("M")
FreeBank bank
Check "No extension", SaveBuffer(FrontBuffer(), unique + "noext"), 1
Check "A folder that does not exist", SaveBuffer(FrontBuffer(), unique + "nodir/x.png"), 0
Check "A bad buffer", SaveBuffer(0, unique + "z.png"), 0

; SaveImage and SaveTexture.
img = CreateImage(W, H)
CopyRect 0, 0, W, H, 0, 0, FrontBuffer(), ImageBuffer(img)
Check "SaveImage as PNG", SaveImage(img, unique + "i.png"), 1
Check "SaveImage frame 0", SaveImage(img, unique + "i2.png", 0), 1
Check "SaveImage with settings", SaveImage(img, unique + "i.jpg", 0, "quality=50,subsampling=444"), 1
Check "SaveImage has no loss in PNG", Error(unique + "i.png"), 0
Check "SaveImage frame that does not exist", SaveImage(img, unique + "i3.png", 5), 0
Check "SaveImage JPEG", Error(unique + "i.jpg"), 5, 5
Check "SaveImage the same as SaveBuffer", FileSize(unique + "i.png"), FileSize(unique + "a.png"), 200
tex = CreateTexture(W, H)
CopyRect 0, 0, W, H, 0, 0, FrontBuffer(), TextureBuffer(tex)
Check "SaveTexture as PNG", SaveTexture(tex, unique + "t.png"), 1
Check "SaveTexture with settings", SaveTexture(tex, unique + "t.webp", 0, "lossless=1"), 1
Check "SaveTexture has no loss in PNG", Error(unique + "t.png"), 0
Check "SaveTexture has no loss in lossless WebP", Error(unique + "t.webp"), 0
Check "SaveTexture frame that does not exist", SaveTexture(tex, unique + "t2.png", 3), 0

; A picture with see-through pixels (a 32 bit TGA made here, as a picture can only get its alpha from a file) keeps them.
f = WriteFile(unique + "alpha.tga")
WriteByte f, 0 : WriteByte f, 0 : WriteByte f, 2
WriteShort f, 0 : WriteShort f, 0 : WriteByte f, 0
WriteShort f, 0 : WriteShort f, 0 : WriteShort f, 16 : WriteShort f, 16
WriteByte f, 32 : WriteByte f, 40
For y = 0 To 15
	For x = 0 To 15
		WriteByte f, 0 : WriteByte f, 100 : WriteByte f, 200 : WriteByte f, 16 * x + 8 ; B, G, R, A
	Next
Next
CloseFile f
src = LoadImage(unique + "alpha.tga")
CheckTrue "The image with alpha loads", src <> 0
Check "The alpha of the image", ReadPixel(0, 0, ImageBuffer(src)) Shr 24 And 255, 8
Dim out$(3)
out(0) = unique + "alpha_out.png"
out(1) = unique + "alpha_out.tga"
out(2) = unique + "alpha_out.bmp"
out(3) = unique + "alpha_out.webp"
For i = 0 To 3
	Check "SaveImage with alpha " + out(i), SaveImage(src, out(i), 0, "lossless=1"), 1
	copy = LoadImage(out(i))
	CheckTrue "Load " + out(i), copy <> 0
	Check "The alpha of " + out(i), (ReadPixel(5, 7, ImageBuffer(copy)) Shr 24) And 255, 88
	Check "The color of " + out(i), ReadPixel(5, 7, ImageBuffer(copy)) And $FFFFFF, $C86400
	FreeImage copy
Next
SaveImage src, unique + "alpha.jxl", 0, "lossless=1"
copy = LoadImage(unique + "alpha.jxl")
CheckTrue "Load the JPEG XL with alpha", copy <> 0
Check "The alpha of the JPEG XL", (ReadPixel(5, 7, ImageBuffer(copy)) Shr 24) And 255, 88
FreeImage copy
SaveImage src, unique + "alpha.jpg"
CheckTrue "A JPEG of a picture with alpha loads", LoadImage(unique + "alpha.jpg") <> 0

; The metadata: Exif that says which program made the file, with the title of the program.
Check "SaveBuffer for the metadata", SaveBuffer(FrontBuffer(), unique + "m1.png"), 1
CheckTrue "The default title in a PNG", Contains(unique + "m1.png", "Generated by BlitzLLVM")
AppTitle "Save Test"
Dim exts$(3)
exts(0) = "png" : exts(1) = "jpg" : exts(2) = "webp" : exts(3) = "jxl"
For i = 0 To 3
	ext$ = exts(i)
	name$ = unique + "m2." + ext
	Check "SaveBuffer " + ext + " with a title", SaveBuffer(FrontBuffer(), name), 1
	CheckTrue "The title of AppTitle is in " + ext, Contains(name, "Generated by Save Test")
	CheckFalse "The default title is gone from " + ext, Contains(name, "BlitzLLVM")
	name2$ = unique + "m3." + ext
	SaveBuffer FrontBuffer(), name2, "metadata=0"
	CheckFalse "No metadata in " + ext, Contains(name2, "Generated by")
Next
CheckFalse "A BMP has no metadata", Contains(names(0), "Generated by")
CheckFalse "A TGA has no metadata", Contains(names(2), "Generated by")
CheckTrue "A PNG has the Exif chunk", Contains(unique + "m2.png", "eXIf")
CheckTrue "A PNG has the Software text", Contains(unique + "m2.png", "Software")
CheckTrue "A JPEG has the Exif segment", Contains(unique + "m2.jpg", "Exif")
CheckTrue "A WebP has the Exif chunk", Contains(unique + "m2.webp", "EXIF")
CheckTrue "A JPEG XL has the Exif box", Contains(unique + "m2.jxl", "Exif")
Check "Pictures with metadata load", Error(unique + "m2.png"), 0

; Clean up what was made.
dir = ReadDir(".")
Repeat
	file$ = NextFile$(dir)
	If file = "" Then Exit
	If Left(file, Len(unique)) = unique Then DeleteFile file
Forever
CloseDir dir

Done "graphics_save_pixels"
