; The GPU can leave out the faces of big meshes that are not in view (CameraCulling flag 2), which must not change a pixel. A mesh
; of many faces is looked at from many places with and without it, and the pictures have to be the same. Stats3D 1004 says how many
; runs of faces the GPU decided about. Needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_gpu_culling_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Const N = 80 ; 80 by 80 squares are 12800 faces.

; Colors that depend on the place, so that a face in the wrong place is a wrong color.
mesh = CreateMesh()
surf = CreateSurface(mesh)
For y = 0 To N
	For x = 0 To N
		v = AddVertex(surf, x - N / 2, 0, y - N / 2, 0, 0)
		VertexColor surf, v, (x * 255) / N, (y * 255) / N, 255 - (x * 255) / N
	Next
Next
For y = 0 To N - 1
	For x = 0 To N - 1
		i = y * (N + 1) + x
		AddTriangle surf, i, i + N + 1, i + 1
		AddTriangle surf, i + 1, i + N + 1, i + N + 2
	Next
Next
UpdateNormals mesh
EntityFX mesh, 1 + 2
CheckTrue "The mesh is big", CountTriangles(surf) = 12800

Global camera = CreateCamera()
CameraClsColor camera, 10, 20, 30
CameraRange camera, 0.5, 200

Dim a(39, 29)

; Takes the picture of the camera at a place, as a grid of samples.
Function Look(x#, y#, z#, pitch#, yaw#, roll#)
	PositionEntity camera, x, y, z
	RotateEntity camera, pitch, yaw, roll
	RenderWorld
	For j = 0 To 29
		For i = 0 To 39
			a(i, j) = ReadPixel(i * 4 + 2, j * 4 + 2, BackBuffer()) And $FFFFFF
		Next
	Next
End Function

Dim places#(10, 5)
; x, y, z, pitch, yaw, roll
Data 0, 10, -45, 30, 0, 0
Data 0, 5, 0, 20, 90, 0
Data 25, 8, 25, 25, 225, 0
Data -30, 3, -10, 0, 270, 10
Data 0, 60, 0, 90, 0, 0
Data 0, 1, 0, 0, 0, 0
Data 100, 10, 0, 10, 90, 0
Data 38, 4, 38, 10, 45, 0
Data -38, 4, -38, 15, 200, 0
Data 5, 12, -5, 45, 135, 0
Data 3, -10, 4, -60, 20, 0 ; From below, where the faces look away.
For p = 0 To 10
	For k = 0 To 5
		Read places(p, k)
	Next
Next

; The picture for each place when only the meshes are culled, to compare with.
Dim want(10, 39, 29)
CameraCulling camera, 1
RenderWorld
Check "No faces are given to the GPU to decide when the setting is off", Stats3D(1004), 0, 0
For p = 0 To 10
	Look places(p, 0), places(p, 1), places(p, 2), places(p, 3), places(p, 4), places(p, 5)
	For j = 0 To 29
		For i = 0 To 39
			want(p, i, j) = a(i, j)
		Next
	Next
Next

CameraCulling camera, 3
Look places(0, 0), places(0, 1), places(0, 2), places(0, 3), places(0, 4), places(0, 5)
gpu = Stats3D(1004)
If gpu = 0 Then
	Print "blitz3d_gpu_culling_pixels: the GPU can not cull, compared without it."
Else
	; 12800 faces are 100 runs of 128.
	Check "Runs of faces the GPU decided about", gpu, 100, 0
EndIf

; All of the mesh is in view from above, where there is nothing to cull.
Look places(4, 0), places(4, 1), places(4, 2), places(4, 3), places(4, 4), places(4, 5)
If gpu <> 0 Then Check "A mesh that is completely in view is not given to the GPU", Stats3D(1004), 0, 0

For p = 0 To 10
	Look places(p, 0), places(p, 1), places(p, 2), places(p, 3), places(p, 4), places(p, 5)
	diff = 0
	For j = 0 To 29
		For i = 0 To 39
			If a(i, j) <> want(p, i, j) Then diff = diff + 1
		Next
	Next
	Check "Same picture with GPU culling at place " + p + " (" + diff + " samples differ)", diff, 0, 0
Next

; Leaving out the faces that look away (bit 4) is the same picture too.
CameraCulling camera, 7
For p = 0 To 10
	Look places(p, 0), places(p, 1), places(p, 2), places(p, 3), places(p, 4), places(p, 5)
	diff = 0
	For j = 0 To 29
		For i = 0 To 39
			If a(i, j) <> want(p, i, j) Then diff = diff + 1
		Next
	Next
	Check "Same picture with culling of faces that look away at place " + p + " (" + diff + " samples differ)", diff, 0, 0
Next
CameraCulling camera, 3

; Moved, turned and scaled, the mesh is still drawn the same.
ScaleEntity mesh, 1.5, 0.5, 2
TurnEntity mesh, 10, 33, 5
PositionEntity mesh, 4, 1, 7
CameraCulling camera, 1
Look 0, 10, -45, 30, 0, 0
For j = 0 To 29
	For i = 0 To 39
		want(0, i, j) = a(i, j)
	Next
Next
CameraCulling camera, 3
Look 0, 10, -45, 30, 0, 0
diff = 0
For j = 0 To 29
	For i = 0 To 39
		If a(i, j) <> want(0, i, j) Then diff = diff + 1
	Next
Next
Check "Same picture when the mesh is moved and turned (" + diff + " samples differ)", diff, 0, 0
CameraCulling camera, 7
Look 0, 10, -45, 30, 0, 0
diff = 0
For j = 0 To 29
	For i = 0 To 39
		If a(i, j) <> want(0, i, j) Then diff = diff + 1
	Next
Next
Check "Same picture when the mesh is moved and turned, leaving out faces that look away (" + diff + " samples differ)", diff, 0, 0

; Changing the faces makes the GPU know the new ones.
VertexCoords surf, 0, -100, 50, -100
CameraCulling camera, 1
Look 0, 10, -45, 30, 0, 0
For j = 0 To 29
	For i = 0 To 39
		want(0, i, j) = a(i, j)
	Next
Next
CameraCulling camera, 3
Look 0, 10, -45, 30, 0, 0
diff = 0
For j = 0 To 29
	For i = 0 To 39
		If a(i, j) <> want(0, i, j) Then diff = diff + 1
	Next
Next
Check "Same picture after a vertex moved (" + diff + " samples differ)", diff, 0, 0

; A mesh with few faces is left to the CPU.
small = CreateCube()
HideEntity mesh
RenderWorld
Check "A cube has no runs for the GPU", Stats3D(1004), 0, 0

Done "blitz3d_gpu_culling_pixels"
