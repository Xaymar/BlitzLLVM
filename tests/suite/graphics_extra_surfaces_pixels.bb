; The runtime can show pictures in more windows than the one of Graphics: each has its own SDL window, Vulkan surface and
; swapchain on the shared device. Nothing in a program opens one yet, BLITZLLVM_TEST_EXTRA_SURFACES makes Graphics open four, show a
; color in each, close two, show in the rest, and open and close one a hundred times, and write what happened to a file.
; This needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_extra_surfaces_pixels: skipped, there is no window."
	End
EndIf

SetEnv "BLITZLLVM_TEST_EXTRA_SURFACES", "extra_surfaces.tmp"
Graphics 320, 240, 32, 2
AutoSuspend False ; Other windows of tests that run at the same time must not stop this one.

f = ReadFile("extra_surfaces.tmp")
If f = 0 Then RuntimeError "The result was not written."
opened = Int(ReadLine$(f))
shown = Int(ReadLine$(f))
w = Int(ReadLine$(f))
h = Int(ReadLine$(f))
left = Int(ReadLine$(f))
loops = Int(ReadLine$(f))
CloseFile f
DeleteFile "extra_surfaces.tmp"

Check "Windows opened", opened, 4
Check "Colors shown (4, then 2 of the rest)", shown, 6
Check "Width of the first window", w, 200
Check "Height of the first window", h, 150
Check "Windows left after closing two", left, 2
Check "Windows opened and closed in a loop", loops, 100

; The window of Graphics still works.
Cls
Color 255, 0, 0
Rect 10, 10, 20, 20
Flip
CheckTrue "Graphics is still there", GraphicsWidth() = 320
