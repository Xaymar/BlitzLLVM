; The BlitzPlus GUI, what can be told without looking at the window: Desktop CreateWindow ActiveWindow ActivateWindow
; UpdateWindowMenu SetStatusText SetMinWindowSize MinimizeWindow MaximizeWindow RestoreWindow WindowMinimized
; WindowMaximized WindowMenu CreateMenu SetMenuText CheckMenu UncheckMenu EnableMenu DisableMenu MenuChecked MenuEnabled
; MenuText CreateLabel CreateButton CreateTextField CreateTextArea CreateListBox CreateComboBox CreateTabber CreatePanel
; CreateSlider CreateProgBar CreateTreeView CreateCanvas CreateHtmlView HtmlViewGo HtmlViewRun HtmlViewBack HtmlViewForward HtmlViewStatus HtmlViewCurrentURL HtmlViewEventURL FreeGadget ShowGadget HideGadget EnableGadget DisableGadget
; ActivateGadget SetGadgetText GadgetText SetGadgetFont GadgetFont SetGadgetShape SetGadgetLayout GadgetX GadgetY GadgetWidth
; GadgetHeight GadgetGroup ClientWidth ClientHeight SetButtonState ButtonState UpdateProgBar SetSliderRange SetSliderValue
; SliderValue SetPanelColor AddGadgetItem InsertGadgetItem ModifyGadgetItem RemoveGadgetItem ClearGadgetItems
; CountGadgetItems GadgetItemText SelectGadgetItem SelectedGadgetItem TextFieldText AddTextAreaText SetTextAreaText
; TextAreaText TextAreaLen TextAreaLineLen TextAreaChar TextAreaLine TextAreaCursor TextAreaSelLen FormatTextAreaText
; SetTextAreaColor SetTextAreaFont SetTextAreaTabs LockTextArea UnlockTextArea TreeViewRoot AddTreeViewNode
; InsertTreeViewNode ModifyTreeViewNode CountTreeViewNodes TreeViewNodeText SelectTreeViewNode SelectedTreeViewNode
; ExpandTreeViewNode CollapseTreeViewNode FreeTreeViewNode CanvasBuffer FlipCanvas DesktopBuffer RequestColor
; RequestedRed RequestedGreen RequestedBlue RequestFont RequestFile RequestDir. Icons, toolbars and what is drawn are in
; plusgui_pixels.bb, as they need a window.
Include "check.bb"

desk = Desktop()
CheckTrue "Desktop", desk <> 0
Check "Desktop is the same every time", Desktop(), desk
CheckTrue "DesktopBuffer", DesktopBuffer() <> 0

; Nothing is drawn on or read from the desktop: the buffer is one black pixel that starts over every time.
SetBuffer DesktopBuffer()
Color 255, 0, 255
Rect 0, 0, 100, 100, 1
SetBuffer BackBuffer()
Check "DesktopBuffer starts black again", ReadPixel(0, 0, DesktopBuffer()) And $FFFFFF, 0
Check "DesktopBuffer has nothing outside of its pixel", ReadPixel(1, 1, DesktopBuffer()), 0

; Windows are on the desktop. With style 32, what is asked for is the size of what is inside.
win = CreateWindow("First", 10, 20, 300, 200, 0, 1 + 2 + 32)
Check "CreateWindow group", GadgetGroup(win), desk
CheckS "CreateWindow text", GadgetText(win), "First"
Check "CreateWindow x", GadgetX(win), 10
Check "CreateWindow y", GadgetY(win), 20
Check "ClientWidth", ClientWidth(win), 300
Check "ClientHeight", ClientHeight(win), 200
CheckTrue "CreateWindow is bigger than what is in it", GadgetWidth(win) > 300 And GadgetHeight(win) > 200
Check "ActiveWindow is the one that was made", ActiveWindow(), win

; Without a frame, a window is as big as asked.
plain = CreateWindow("Plain", 0, 0, 120, 80, 0, 0)
Check "Plain width", GadgetWidth(plain), 120
Check "Plain height", GadgetHeight(plain), 80
Check "ActiveWindow after another", ActiveWindow(), plain
ActivateWindow win
Check "ActivateWindow", ActiveWindow(), win

SetGadgetText win, "Renamed"
CheckS "SetGadgetText", GadgetText(win), "Renamed"
Check "SetStatusText", SetStatusText(win, "Ready"), 0
SetGadgetShape plain, 5, 6, 200, 100
Check "SetGadgetShape x", GadgetX(plain), 5
Check "SetGadgetShape y", GadgetY(plain), 6
Check "SetGadgetShape width", GadgetWidth(plain), 200
Check "SetGadgetShape height", GadgetHeight(plain), 100
CheckTrue "Window follows its shape", ClientWidth(plain) > 150 And ClientWidth(plain) <= 200

; A window can't be made smaller than its minimum size, by the program or by the person using it.
small = CreateWindow("Small", 0, 0, 300, 200, 0, 1 + 2)
SetMinWindowSize small, 200, 150
SetGadgetShape small, 10, 20, 100, 50
Check "Minimum width", GadgetWidth(small), 200
Check "Minimum height", GadgetHeight(small), 150
Check "Minimum keeps x", GadgetX(small), 10
Check "Minimum keeps y", GadgetY(small), 20
SetGadgetShape small, 0, 0, 400, 50
Check "Bigger than the minimum width", GadgetWidth(small), 400
Check "Minimum height again", GadgetHeight(small), 150
SetMinWindowSize small
SetGadgetShape small, 0, 0, 10, 10
Check "Minimum from the current width", GadgetWidth(small), 400
Check "Minimum from the current height", GadgetHeight(small), 150
SetMinWindowSize small, 120, 90
SetGadgetShape small, 0, 0, 50, 50
Check "A new minimum width", GadgetWidth(small), 120
Check "A new minimum height", GadgetHeight(small), 90
; Windows that were asked for by the size inside are held to the minimum as a whole.
inner = CreateWindow("Inner", 0, 0, 300, 200, 0, 1 + 2 + 32)
SetMinWindowSize inner, 250, 220
SetGadgetShape inner, 0, 0, 50, 50
Check "Minimum with the size inside", GadgetWidth(inner), 250
Check "Minimum with the size inside, height", GadgetHeight(inner), 220
FreeGadget inner
FreeGadget small

; Tool windows have a thinner title than the others, so they are lower by the difference with the same inside.
normal = CreateWindow("Normal", 0, 0, 300, 200, 0, 1 + 2 + 32)
tool = CreateWindow("Tool", 0, 0, 300, 200, 0, 1 + 2 + 16 + 32)
Check "Tool window inside width", ClientWidth(tool), 300
Check "Tool window inside height", ClientHeight(tool), 200
CheckTrue "Tool window is thinner", GadgetHeight(tool) < GadgetHeight(normal)
Check "Tool window is as wide", GadgetWidth(tool), GadgetWidth(normal)
FreeGadget tool
FreeGadget normal

; The desktop is the screen when there is one to ask, and as big as the program's window if not.
CheckTrue "Desktop width", ClientWidth(desk) > 0
CheckTrue "Desktop height", ClientHeight(desk) > 0
Check "Desktop GadgetWidth", GadgetWidth(desk), ClientWidth(desk)
Check "Desktop GadgetHeight", GadgetHeight(desk), ClientHeight(desk)

; Minimize, maximize and restore.
CheckFalse "WindowMinimized at first", WindowMinimized(win)
CheckFalse "WindowMaximized at first", WindowMaximized(win)
MaximizeWindow win
CheckTrue "MaximizeWindow", WindowMaximized(win)
CheckFalse "Maximized is not minimized", WindowMinimized(win)
Check "Maximized fills the desktop", GadgetWidth(win), ClientWidth(desk)
RestoreWindow win
CheckFalse "RestoreWindow", WindowMaximized(win)
Check "RestoreWindow x", GadgetX(win), 10
MinimizeWindow win
CheckTrue "MinimizeWindow", WindowMinimized(win)
RestoreWindow win
CheckFalse "Restored from minimized", WindowMinimized(win)
SetMinWindowSize win, 150, 120
SetMinWindowSize win
UpdateWindowMenu win

; Menus: a window has a root that holds the menus of its bar.
root = WindowMenu(win)
CheckTrue "WindowMenu", root <> 0
Check "WindowMenu is the same every time", WindowMenu(win), root
file = CreateMenu("File", 0, root)
open = CreateMenu("Open", 10, file)
quit = CreateMenu("Quit", 11, file)
CheckS "MenuText", MenuText(open), "Open"
SetMenuText open, "Open..."
CheckS "SetMenuText", MenuText(open), "Open..."
CheckTrue "MenuEnabled at first", MenuEnabled(open)
DisableMenu open
CheckFalse "DisableMenu", MenuEnabled(open)
EnableMenu open
CheckTrue "EnableMenu", MenuEnabled(open)
CheckFalse "MenuChecked at first", MenuChecked(quit)
CheckMenu quit
CheckTrue "CheckMenu", MenuChecked(quit)
UncheckMenu quit
CheckFalse "UncheckMenu", MenuChecked(quit)
UpdateWindowMenu win

; Gadgets of a window.
lbl = CreateLabel("Name:", 4, 4, 80, 20, win)
Check "CreateLabel group", GadgetGroup(lbl), win
CheckS "CreateLabel text", GadgetText(lbl), "Name:"
btn = CreateButton("OK", 4, 30, 80, 24, win)
CheckS "CreateButton text", GadgetText(btn), "OK"
chk = CreateButton("Check", 4, 60, 80, 20, win, 2)
rad = CreateButton("Radio", 4, 84, 80, 20, win, 3)
Check "ButtonState at first", ButtonState(chk), 0
SetButtonState chk, 1
Check "SetButtonState", ButtonState(chk), 1
SetButtonState chk, 0
Check "SetButtonState off", ButtonState(chk), 0
SetButtonState rad, 1
Check "ButtonState radio", ButtonState(rad), 1
Check "A push button has no state", ButtonState(btn), 0

; Showing, hiding, enabling.
HideGadget btn
ShowGadget btn
DisableGadget btn
EnableGadget btn
ActivateGadget btn

; Text fields hold one line.
tf = CreateTextField(100, 4, 150, 22, win)
CheckS "TextFieldText at first", TextFieldText(tf), ""
SetGadgetText tf, "Hello"
CheckS "SetGadgetText on a text field", TextFieldText(tf), "Hello"
CheckS "GadgetText of a text field", GadgetText(tf), "Hello"
SetGadgetText tf, "Two" + Chr(13) + "lines"
CheckS "A text field stops at the end of a line", TextFieldText(tf), "Two"

; Text areas keep lines that end with Chr(13).
ta = CreateTextArea(100, 30, 200, 100, win)
Check "TextAreaLen at first", TextAreaLen(ta), 0
AddTextAreaText ta, "One" + Chr(10) + "Two"
CheckS "AddTextAreaText", TextAreaText(ta), "One" + Chr(13) + "Two"
Check "TextAreaLen", TextAreaLen(ta), 7
Check "TextAreaLen in lines", TextAreaLen(ta, 2), 2
Check "TextAreaLineLen", TextAreaLineLen(ta, 0), 4
Check "TextAreaLineLen of the last", TextAreaLineLen(ta, 1), 3
Check "TextAreaChar", TextAreaChar(ta, 1), 4
Check "TextAreaLine", TextAreaLine(ta, 5), 1
Check "TextAreaLine at the start", TextAreaLine(ta, 0), 0
AddTextAreaText ta, "!"
CheckS "AddTextAreaText adds at the end", TextAreaText(ta, 6, 2), "o!"
SetTextAreaText ta, "ABC", 4, 3
CheckS "SetTextAreaText replaces", TextAreaText(ta), "One" + Chr(13) + "ABC!"
CheckS "TextAreaText of a part", TextAreaText(ta, 1, 2), "ne"
CheckS "TextAreaText of lines", TextAreaText(ta, 1, 1, 2), "ABC!"
Check "TextAreaCursor after adding", TextAreaCursor(ta), 8
Check "TextAreaSelLen after adding", TextAreaSelLen(ta), 0
SetGadgetText ta, "Reset"
CheckS "SetGadgetText on a text area", GadgetText(ta), "Reset"
CheckS "TextAreaText", TextAreaText(ta), "Reset"
FormatTextAreaText ta, 255, 0, 0, 1, 0, 3
SetTextAreaColor ta, 10, 20, 30
SetTextAreaColor ta, 200, 210, 220, 1
SetTextAreaTabs ta, 8
LockTextArea ta
SetTextAreaText ta, "Locked"
UnlockTextArea ta
CheckS "A locked text area can be changed", TextAreaText(ta), "Locked"

; Lists have items that are counted from 0.
lb = CreateListBox(4, 110, 90, 60, win)
Check "CountGadgetItems at first", CountGadgetItems(lb), 0
Check "SelectedGadgetItem at first", SelectedGadgetItem(lb), -1
AddGadgetItem lb, "a"
AddGadgetItem lb, "c"
InsertGadgetItem lb, 1, "b"
Check "CountGadgetItems", CountGadgetItems(lb), 3
CheckS "InsertGadgetItem", GadgetItemText(lb, 1), "b"
CheckS "GadgetItemText", GadgetItemText(lb, 2), "c"
ModifyGadgetItem lb, 0, "A"
CheckS "ModifyGadgetItem", GadgetItemText(lb, 0), "A"
SelectGadgetItem lb, 2
Check "SelectGadgetItem", SelectedGadgetItem(lb), 2
RemoveGadgetItem lb, 0
Check "RemoveGadgetItem", CountGadgetItems(lb), 2
Check "The selection follows its item", SelectedGadgetItem(lb), 1
RemoveGadgetItem lb, 1
Check "Removing what is selected", SelectedGadgetItem(lb), -1
SelectGadgetItem lb, 0
SelectGadgetItem lb, -1
Check "SelectGadgetItem -1", SelectedGadgetItem(lb), -1
AddGadgetItem lb, "d", 1
Check "AddGadgetItem with select", SelectedGadgetItem(lb), 1
ClearGadgetItems lb
Check "ClearGadgetItems", CountGadgetItems(lb), 0

cb = CreateComboBox(100, 140, 100, 22, win)
AddGadgetItem cb, "x"
AddGadgetItem cb, "y"
SelectGadgetItem cb, 1
Check "ComboBox selection", SelectedGadgetItem(cb), 1

tab = CreateTabber(4, 180, 200, 100, win)
AddGadgetItem tab, "One"
AddGadgetItem tab, "Two"
Check "The first tab is selected", SelectedGadgetItem(tab), 0
SelectGadgetItem tab, 1
Check "Tabber selection", SelectedGadgetItem(tab), 1
CheckTrue "A tabber has client area", ClientWidth(tab) > 0 And ClientHeight(tab) > 0
CheckTrue "The client area is smaller", ClientHeight(tab) < GadgetHeight(tab)
inner = CreateButton("In", 2, 2, 50, 20, tab)
Check "Gadgets can be in a tabber", GadgetGroup(inner), tab

pn = CreatePanel(220, 180, 100, 60, win, 1)
SetPanelColor pn, 10, 20, 30
inpn = CreateLabel("L", 1, 1, 20, 10, pn)
Check "Gadgets can be in a panel", GadgetGroup(inpn), pn
Check "ClientWidth of a panel", ClientWidth(pn), 100

; Sliders go from 0 to what is left of the total when what is seen is taken away.
sl = CreateSlider(4, 290, 200, 16, win)
SetSliderRange sl, 10, 100
SetSliderValue sl, 50
Check "SliderValue", SliderValue(sl), 50
SetSliderValue sl, 500
Check "SliderValue is limited", SliderValue(sl), 90
SetSliderValue sl, -5
Check "SliderValue is not below 0", SliderValue(sl), 0

pb = CreateProgBar(4, 310, 200, 16, win)
UpdateProgBar pb, 0.5
UpdateProgBar pb, 2.0

; Tree views have a root that is not shown.
tv = CreateTreeView(4, 330, 150, 100, win)
tr = TreeViewRoot(tv)
CheckTrue "TreeViewRoot", tr <> 0
Check "TreeViewRoot is the same every time", TreeViewRoot(tv), tr
Check "SelectedTreeViewNode at first", SelectedTreeViewNode(tv), 0
Check "CountTreeViewNodes at first", CountTreeViewNodes(tr), 0
n1 = AddTreeViewNode("One", tr)
n2 = AddTreeViewNode("Two", tr)
n11 = AddTreeViewNode("One.One", n1)
n0 = InsertTreeViewNode(0, "Zero", tr)
n15 = InsertTreeViewNode(1, "Inserted", tr)
Check "CountTreeViewNodes", CountTreeViewNodes(tr), 4
Check "CountTreeViewNodes of a child", CountTreeViewNodes(n1), 1
CheckS "TreeViewNodeText", TreeViewNodeText(n11), "One.One"
ModifyTreeViewNode n11, "Changed"
CheckS "ModifyTreeViewNode", TreeViewNodeText(n11), "Changed"
SelectTreeViewNode n2
Check "SelectTreeViewNode", SelectedTreeViewNode(tv), n2
ExpandTreeViewNode n1
CollapseTreeViewNode n1
FreeTreeViewNode n11
Check "FreeTreeViewNode", CountTreeViewNodes(n1), 0
FreeTreeViewNode n2
Check "Freeing the selected node", SelectedTreeViewNode(tv), 0
Check "Freeing a node takes it out of its parent", CountTreeViewNodes(tr), 3
FreeTreeViewNode n1

; An HTML view keeps the history of the addresses it was sent to, but does not load them.
hv = CreateHtmlView(4, 380, 100, 50, win)
CheckS "HtmlViewCurrentURL before", HtmlViewCurrentURL(hv), ""
HtmlViewGo hv, "first"
HtmlViewGo hv, "second"
CheckS "HtmlViewCurrentURL", HtmlViewCurrentURL(hv), "second"
HtmlViewBack hv
CheckS "HtmlViewBack", HtmlViewCurrentURL(hv), "first"
HtmlViewBack hv
CheckS "HtmlViewBack at the first", HtmlViewCurrentURL(hv), "first"
HtmlViewForward hv
CheckS "HtmlViewForward", HtmlViewCurrentURL(hv), "second"
HtmlViewGo hv, "third"
HtmlViewBack hv
HtmlViewGo hv, "other"
HtmlViewForward hv
CheckS "HtmlViewGo drops the forward pages", HtmlViewCurrentURL(hv), "other"
Check "HtmlViewStatus", HtmlViewStatus(hv), 0
CheckS "HtmlViewEventURL", HtmlViewEventURL(hv), ""
HtmlViewRun hv, "alert(1)"
FreeGadget hv

; A canvas has a buffer to draw to.
cv = CreateCanvas(4, 440, 100, 60, win)
Check "ClientWidth of a canvas", ClientWidth(cv), 100
cvb = CanvasBuffer(cv)
CheckTrue "CanvasBuffer", cvb <> 0
Check "CanvasBuffer is the same every time", CanvasBuffer(cv), cvb
FlipCanvas cv
FlipCanvas cv, 1

; Fonts and shapes.
fnt = LoadFont("Arial", 14)
SetGadgetFont lbl, fnt
Check "GadgetFont", GadgetFont(lbl), fnt
SetTextAreaFont ta, fnt
SetGadgetLayout btn, 1, 0, 1, 0
SetGadgetLayout btn, 2, 2, 0, 0

; Free what was made. What is in a gadget goes with it.
FreeGadget cb
FreeGadget pn
FreeGadget tab
FreeGadget plain
FreeGadget win
If GetEnv$("BLITZ_SUITE_DEBUG") = "" Then FreeGadget 0

; Requesters that have nobody to ask give nothing.
CheckFalse "RequestColor without a window", RequestColor(10, 20, 30)
CheckS "RequestFile without a window", RequestFile("Open"), ""
CheckS "RequestDir without a window", RequestDir("Folder"), ""
Check "RequestFont without a window", RequestFont(), 0
Check "RequestedRed", RequestedRed(), 0
Check "RequestedGreen", RequestedGreen(), 0
Check "RequestedBlue", RequestedBlue(), 0

Done "plusgui"
