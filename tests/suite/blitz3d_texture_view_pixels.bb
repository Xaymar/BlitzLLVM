; Merged textures (TextureAtlas) are views of a shared image, which the fragment shader reads itself: they have to wrap, mirror, use the
; border color and go down the mip levels like a texture of their own does. Each of these is drawn with the merge off and on, and
; the two pictures have to be the same up to the rounding of a sampler. Needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_texture_view_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 96, 72, 32, 2
SetBuffer BackBuffer()
ClearTextureFilters

Const COUNT = 8

Local i, tex, y
For i = 0 To COUNT - 1
	tex = CreateTexture(24, 24, 1 + 4096)
	SetBuffer TextureBuffer(tex)
	For y = 0 To 23
		Color i * 30 + 10, y * 10, 255 - y * 10
		Rect 0, y, 24, 1, 1
	Next
	Color 255, 255, 255 : Plot 0, 0
	Color 0, 0, 0 : Plot 23, 0
	Color 255, 0, 255 : Plot 0, 23
	Color 0, 255, 0 : Plot 23, 23
	Color 255, 255, 0 : Line 4, 4, 19, 19
	Color 0, 0, 255 : Rect 8, 8, 8, 8, 0
	SaveBuffer TextureBuffer(tex), "suite_texture_view" + i + ".bmp"
	SetBuffer BackBuffer()
	FreeTexture tex
Next

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, -9
Global original = CreateCube()
HideEntity original
Dim cubes(COUNT - 1)
Dim textures(COUNT - 1)
Global flags, mode, sampler

Function Build()
	For i = 0 To COUNT - 1
		textures(i) = LoadTexture("suite_texture_view" + i + ".bmp", flags)
		cubes(i) = CopyEntity(original)
		EntityFX cubes(i), 1
		ScaleEntity cubes(i), 0.9, 0.9, 0.9
		PositionEntity cubes(i), (i Mod 4) * 2.2 - 3.3, (i / 4) * 2.2 - 1.1, 0
		TurnEntity cubes(i), 20 + i * 7, 30 - i * 5, 0
		EntityTexture cubes(i), textures(i)
		; Coordinates far outside of 0 to 1: the texture is repeated, mirrored or shows its border.
		ScaleTexture textures(i), 0.2 + (i Mod 3) * 0.1, 0.25
		PositionTexture textures(i), 0.1 * i, 0.3
		If i Mod 2 Then RotateTexture textures(i), 15 * i
		If sampler Then SetTextureSampler textures(i), sampler
	Next
End Function

Function Clean()
	For i = 0 To COUNT - 1
		FreeEntity cubes(i)
		FreeTexture textures(i)
	Next
End Function

Dim plain(96 * 72 - 1)
Function Store()
	For y = 0 To 71
		For x = 0 To 95
			plain(y * 96 + x) = ReadPixel(x, y, BackBuffer()) And $FFFFFF
		Next
	Next
End Function

; How many pixels differ by more than 12 steps in a channel. A sampler rounds its weights and picks the level of detail with
; an approximation, the shader does neither, so single steps are no difference.
Function Differences()
	Local n = 0, a, b, d
	For y = 0 To 71
		For x = 0 To 95
			a = ReadPixel(x, y, BackBuffer()) And $FFFFFF
			b = plain(y * 96 + x)
			d = Abs((a And 255) - (b And 255))
			d = Max(d, Abs(((a Shr 8) And 255) - ((b Shr 8) And 255)))
			d = Max(d, Abs(((a Shr 16) And 255) - ((b Shr 16) And 255)))
			If d > 12 Then n = n + 1
		Next
	Next
	Return n
End Function

; `allowed` pixels may differ: with the nearest level the pick flips at the border between two levels, where the sampler and the shader do not agree.
Function Compare(name$, allowed = 0)
	TextureAtlas False
	Build()
	RenderWorld
	Store()
	Check name + ": without the merge every texture is a call", Stats3D(1000), COUNT, 0
	Clean()
	TextureAtlas True
	Build()
	RenderWorld
	Check name + ": merged, one call", Stats3D(1000), 1, 0
	CheckTrue name + ": looks the same", Differences() <= allowed
	Clean()
End Function

sampler = 0
flags = 1
Compare("Repeat")

flags = 1 + 8
Compare("Repeat with mip maps")

flags = 1 + 1024
Compare("Repeat, nearest texel")

flags = 1 + 8 + 1024
Compare("Repeat, nearest texel, mip maps", 40)

flags = 1 + 16 + 32
Compare("Clamp")

sampler = CreateSampler()
SetSamplerAddressModeU sampler, 1
SetSamplerAddressModeV sampler, 1
flags = 1
Compare("Mirror")

flags = 1 + 8
Compare("Mirror with mip maps")

SetSamplerAddressModeU sampler, 3
SetSamplerAddressModeV sampler, 3
SetSamplerBorderColor sampler, 1, 0, 0, 1
flags = 1
Compare("Border color")

For i = 0 To COUNT - 1
	DeleteFile "suite_texture_view" + i + ".bmp"
Next

Done "blitz3d_texture_view_pixels"
