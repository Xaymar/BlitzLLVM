; see-through things are drawn like Blitz3D draws them: after everything solid, one entity after the other from the one whose
; origin is the farthest from the camera (the distance in space, not the one in front of the camera), also when things are
; about as far as each other: the order is never changed to make fewer calls.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_transparency_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 1000

; A flat quad facing the camera, half as wide as given, with half the see-through there is in alpha.
Function Quad(x#, z#, half#, red, green, blue, alpha#)
	m = CreateMesh()
	s = CreateSurface(m)
	AddVertex s, -half, -half, 0
	AddVertex s, -half, half, 0
	AddVertex s, half, half, 0
	AddVertex s, half, -half, 0
	AddTriangle s, 0, 1, 2
	AddTriangle s, 0, 2, 3
	EntityColor m, red, green, blue
	EntityAlpha m, alpha
	EntityFX m, 1
	PositionEntity m, x, 0, z
	Return m
End Function

; Two quads that are 2% apart, whichever is made lower: the nearer one is drawn over the other, one half of each.
red = Quad(0, 10, 4, 255, 0, 0, 0.5)
green = Quad(0, 10.2, 4, 0, 255, 0, 0.5)
RenderWorld
Check "Near red over far green: red", R(80, 60), 128, 6
Check "Near red over far green: green", G(80, 60), 64, 6
FreeEntity red
FreeEntity green
green = Quad(0, 10.2, 4, 0, 255, 0, 0.5)
red = Quad(0, 10, 4, 255, 0, 0, 0.5)
RenderWorld
Check "Made the other way: red", R(80, 60), 128, 6
Check "Made the other way: green", G(80, 60), 64, 6
FreeEntity red
FreeEntity green
red = Quad(0, 10.2, 4, 255, 0, 0, 0.5)
green = Quad(0, 10, 4, 0, 255, 0, 0.5)
RenderWorld
Check "Near green over far red: red", R(80, 60), 64, 6
Check "Near green over far red: green", G(80, 60), 128, 6
FreeEntity red
FreeEntity green

; The distance is the one in space: the green one is in front of the red one as seen by the camera (9 against 10), but its
; origin is 12.7 away from the camera, and the red one is 10 away, so the red one is drawn over the green one.
red = Quad(0, 10, 4, 255, 0, 0, 0.5)
green = Quad(9, 9, 12, 0, 255, 0, 0.5)
RenderWorld
Check "Distance in space: red", R(80, 60), 128, 6
Check "Distance in space: green", G(80, 60), 64, 6
FreeEntity red
FreeEntity green

; The surfaces of one entity are drawn from the last one to the lower one: the red surface is the last one, so it is drawn lower
; and the green one over it, although the red one is the one that is made lower.
m = CreateMesh()
lower = CreateSurface(m)
AddVertex lower, -4, -4, 10 : AddVertex lower, -4, 4, 10 : AddVertex lower, 4, 4, 10
AddTriangle lower, 0, 1, 2
upper = CreateSurface(m)
AddVertex upper, -4, -4, 10 : AddVertex upper, -4, 4, 10 : AddVertex upper, 4, 4, 10
AddTriangle upper, 0, 1, 2
b1 = CreateBrush(255, 0, 0) : BrushAlpha b1, 0.5 : BrushFX b1, 1
b2 = CreateBrush(0, 255, 0) : BrushAlpha b2, 0.5 : BrushFX b2, 1
PaintSurface lower, b1 : PaintSurface upper, b2
RenderWorld
Check "Surfaces from the last: red", R(60, 60), 128, 6
Check "Surfaces from the last: green", G(60, 60), 64, 6
FreeEntity m

End
