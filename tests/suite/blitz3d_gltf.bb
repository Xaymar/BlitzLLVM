; Loading glTF 2.0 models (.gltf and .glb) with LoadMesh and LoadAnimMesh, and their pictures with LoadTexture and LoadImage: meshes, materials,
; the hierarchy, skins and animations. models/ has the models, which tools/generate_gltf_fixtures.py writes. glTF is right-handed, so x is mirrored here.
Include "check.bb"

Graphics3D 320, 240, 32, 2

; A triangle with the buffer inside the file, on a node at x = 2 (which is x = -2 here).
tri = LoadAnimMesh("models/gltf_triangle.gltf")
CheckTrue "LoadAnimMesh of a .gltf", tri <> 0
node = FindChild(tri, "tri")
CheckTrue "The node is there with its name", node <> 0
Check "Node position x is mirrored", EntityX(node), -2
Check "Not animated", AnimLength(tri), -1
Check "The node has a surface", CountSurfaces(node), 1
s = GetSurface(node, 1)
Check "Three vertices", CountVertices(s), 3
Check "One triangle", CountTriangles(s), 1
; The vertices come in the order that the faces use them, and the corners of a face change places (see below): the file's corners 0, 2, 1.
Check "Corner 1 is the top", VertexY(s, 1), 1
Check "Corner 2 x", VertexX(s, 2), -1
Check "Normal z", VertexNZ(s, 0), 1, 0.001
Check "Corner 1 v", VertexV(s, 1), 1
; The front of a face is where its corners go around the other way, so the second and third corner change places: the pixel test looks
; at which side can be seen.
Check "Triangle second", TriangleVertex(s, 0, 1), 1
Check "Triangle third", TriangleVertex(s, 0, 2), 2
brush = GetSurfaceBrush(s)
CheckTrue "The material is a brush", brush <> 0

; LoadMesh puts the node in place.
flat = LoadMesh("models/gltf_triangle.gltf")
CheckTrue "LoadMesh of a .gltf", flat <> 0
s = GetSurface(flat, 1)
Check "Corner 0 x with the node", VertexX(s, 0), -2
Check "Corner 2 x with the node", VertexX(s, 2), -3
Check "Corner 1 x with the node", VertexX(s, 1), -2
Check "Corner 1 y with the node", VertexY(s, 1), 1

; Files that are not models.
CheckFalse "A damaged file gives nothing", LoadMesh("models/gltf_bad.gltf") <> 0

; Pictures, colors for the vertices, a second set of coordinates, a transform of the coordinates and a clamped sampler, all in a .glb file.
quad = LoadMesh("models/gltf_textured.glb")
CheckTrue "LoadMesh of a .glb", quad <> 0
s = GetSurface(quad, 1)
Check "Four vertices", CountVertices(s), 4
Check "Two triangles", CountTriangles(s), 2
brush = GetSurfaceBrush(s)
tex = GetBrushTexture(brush)
CheckTrue "The picture inside the file is the texture", tex <> 0
Check "The picture is 2 wide", TextureWidth(tex), 2
Check "The picture is 2 high", TextureHeight(tex), 2
; offset (0.25, 0.5) and scale (2, 4) on the coordinates (0, 1) of the first corner and (1, 0) of the third.
Check "Transformed u of 0", VertexU(s, 0), 0.25, 0.001
Check "Transformed v of 0", VertexV(s, 0), 4.5, 0.001
; The vertices come in the order that the faces use them: the file's corners 0, 2, 1, 3.
Check "Transformed u of the third corner", VertexU(s, 1), 2.25, 0.001
Check "Transformed v of the third corner", VertexV(s, 1), 0.5, 0.001
Check "Second set u", VertexU(s, 2, 1), 0.5, 0.001
Check "Second set v", VertexV(s, 0, 1), 0.5, 0.001
Check "Vertex color red", VertexRed(s, 0), 255, 1
Check "Vertex color green", VertexGreen(s, 0), 128, 1
Check "Vertex color blue", VertexBlue(s, 0), 0, 1

; The pictures of a glTF file are found by LoadTexture and LoadImage: the file is the first, "#1" the second.
direct = LoadTexture("models/gltf_textured.glb")
CheckTrue "LoadTexture of a .glb", direct <> 0
Check "Width of the first picture", TextureWidth(direct), 2
named = LoadTexture("models/gltf_textured.glb#0")
CheckTrue "LoadTexture of the first picture by number", named <> 0
CheckFalse "There is no second picture", LoadTexture("models/gltf_textured.glb#1") <> 0
picture = LoadImage("models/gltf_textured.glb#0")
CheckTrue "LoadImage of a picture inside a .glb", picture <> 0
Check "Width of the image", ImageWidth(picture), 2
Check "Height of the image", ImageHeight(picture), 2
CheckFalse "A glTF file without that picture gives 0", LoadImage("models/gltf_triangle.gltf") <> 0

; A skinned strip with two joints and a node that turns, with the buffer in a file of its own.
rig = LoadAnimMesh("models/gltf_rig.gltf")
CheckTrue "LoadAnimMesh of a rig", rig <> 0
skin = FindChild(rig, "skin")
bone = FindChild(rig, "bone_b")
spinner = FindChild(rig, "spinner")
tip = FindChild(spinner, "tip")
CheckTrue "The nodes are there", skin <> 0 And bone <> 0 And spinner <> 0 And tip <> 0
; Two animations: the first is 60 frames, the second 60 frames and starts one frame later.
Check "Animation length", AnimLength(rig), 121, 0.01
sf = GetSurface(skin, 1)
Check "Strip vertices", CountVertices(sf), 4

; At the start the node of the mesh is left out: the vertices are where the joints say, not where the node is.
SetAnimTime rig, 0
TFormPoint VertexX(sf, 0), VertexY(sf, 0), VertexZ(sf, 0), skin, 0
Check "Bottom corner x", TFormedX(), 1, 0.01
Check "Bottom corner y", TFormedY(), 0, 0.01
TFormPoint VertexX(sf, 3), VertexY(sf, 3), VertexZ(sf, 3), skin, 0
Check "Top corner x", TFormedX(), -1, 0.01
Check "Top corner y", TFormedY(), 2, 0.01

; Halfway through the first animation the top joint is at x = 1.5 (-1.5 here), and the strip follows with the weight of it.
SetAnimTime rig, 30
Check "Joint moved", EntityX(bone), -1.5, 0.01
TFormPoint VertexX(sf, 0), VertexY(sf, 0), VertexZ(sf, 0), skin, 0
Check "A vertex of the first joint stays", TFormedX(), 1, 0.01
TFormPoint VertexX(sf, 1), VertexY(sf, 1), VertexZ(sf, 1), skin, 0
Check "A vertex of both joints follows halfway", TFormedX(), 1 - 0.75, 0.01
TFormPoint VertexX(sf, 3), VertexY(sf, 3), VertexZ(sf, 3), skin, 0
Check "Other vertex of both joints", TFormedX(), -1 - 0.75, 0.01

; The node that turns: yaw 90 about y takes the tip from z to x (-x here).
SetAnimTime rig, 60
Check "Yaw of the turned node", EntityYaw(spinner), 90, 0.01
Check "Tip x", EntityX(tip, True), -1, 0.01
Check "Tip z", EntityZ(tip, True), 0, 0.01

; The second animation holds the lift until its second key (STEP), a node that it does not touch goes back to where it was.
SetAnimTime rig, 61 + 15
Check "Step holds the first value", EntityY(bone), 2, 0.01
SetAnimTime rig, 61 + 30
Check "Step jumps to the second value", EntityY(bone), 4, 0.01
Check "A node of the other animation is at rest", EntityYaw(spinner), 0, 0.01
TFormVector 1, 0, 0, tip, 0
Check "A cubic spline in between", TFormedX(), 2, 0.05

; Without animation, the whole thing as it looks in its bind pose.
still = LoadMesh("models/gltf_rig.gltf")
CheckTrue "LoadMesh of a skinned model", still <> 0
Check "The strip is one surface", CountSurfaces(still), 1
sf = GetSurface(still, 1)
Check "Vertex 0 x", VertexX(sf, 0), 1, 0.01
Check "Vertex 3 y", VertexY(sf, 3), 2, 0.01

; Files that end anywhere, and bytes that are wrong, never crash: the model is found or LoadMesh gives 0.
source = ReadFile("models/gltf_textured.glb")
total = FileSize("models/gltf_textured.glb")
For cut = 0 To total Step 37
	SeekFile source, 0
	damaged = WriteFile("suite_gltf_cut.glb")
	For i = 1 To cut
		WriteByte damaged, ReadByte(source)
	Next
	CloseFile damaged
	m = LoadMesh("suite_gltf_cut.glb")
	If m <> 0 Then FreeEntity m
Next
For at = 12 To total - 1 Step 41
	SeekFile source, 0
	damaged = WriteFile("suite_gltf_cut.glb")
	For i = 0 To total - 1
		b = ReadByte(source)
		If i = at Then b = (b + 77) And 255
		WriteByte damaged, b
	Next
	CloseFile damaged
	m = LoadMesh("suite_gltf_cut.glb")
	If m <> 0 Then FreeEntity m
	picture = LoadImage("suite_gltf_cut.glb")
	If picture <> 0 Then FreeImage picture
Next
CloseFile source
DeleteFile "suite_gltf_cut.glb"
CheckTrue "Damaged files were survived", True

EndGraphics
Done "blitz3d_gltf"
