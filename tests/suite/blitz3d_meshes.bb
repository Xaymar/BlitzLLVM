; Meshes: CreateMesh CreateCube CreateSphere CreateCylinder CreateCone CreatePlane CreateSurface GetSurface
; CountSurfaces AddVertex AddTriangle CountVertices CountTriangles VertexX VertexY VertexZ VertexNX VertexNY VertexNZ
; VertexNormal VertexColor VertexRed VertexGreen VertexBlue VertexAlpha VertexU VertexV VertexTexCoords TriangleVertex
; UpdateNormals FlipMesh PositionMesh RotateMesh ScaleMesh MeshWidth MeshHeight MeshDepth PaintMesh PaintSurface
; GetSurfaceBrush AddMesh CopyMesh FitMesh MeshCullBox ClearSurface VertexCoords VertexW LightMesh.
Include "check.bb"

; The triangles of all the surfaces of a mesh.
Function MeshTriangles(mesh)
	total = 0
	For i = 1 To CountSurfaces(mesh)
		total = total + CountTriangles(GetSurface(mesh, i))
	Next
	Return total
End Function

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; An empty mesh has no surfaces, and surfaces start empty.
mesh = CreateMesh()
CheckTrue "CreateMesh", mesh <> 0
Check "A new mesh has no surfaces", CountSurfaces(mesh), 0
surface = CreateSurface(mesh)
CheckTrue "CreateSurface", surface <> 0
Check "CountSurfaces", CountSurfaces(mesh), 1
Check "A new surface has no vertices", CountVertices(surface), 0
Check "A new surface has no triangles", CountTriangles(surface), 0
Check "GetSurface", GetSurface(mesh, 1), surface
second = CreateSurface(mesh)
Check "CountSurfaces of two", CountSurfaces(mesh), 2
Check "GetSurface second", GetSurface(mesh, 2), second
CheckTrue "Surfaces are different", second <> surface

; Vertices come back with the numbers 0, 1, 2...
v0 = AddVertex(surface, 0, 0, 0, 0, 0)
v1 = AddVertex(surface, 0, 1, 0, 0, 1)
v2 = AddVertex(surface, 1, 0, 0, 1, 0)
Check "AddVertex 0", v0, 0
Check "AddVertex 1", v1, 1
Check "AddVertex 2", v2, 2
Check "CountVertices", CountVertices(surface), 3
Check "AddTriangle", AddTriangle(surface, v0, v1, v2), 0
Check "AddTriangle second", AddTriangle(surface, v2, v1, v0), 1
Check "CountTriangles", CountTriangles(surface), 2

; What was put in can be read back.
Check "VertexX", VertexX(surface, v2), 1
Check "VertexY", VertexY(surface, v1), 1
Check "VertexZ", VertexZ(surface, v0), 0
Check "VertexU", VertexU(surface, v2), 1
Check "VertexV", VertexV(surface, v1), 1
Check "VertexU zero", VertexU(surface, v0), 0
Check "TriangleVertex 0", TriangleVertex(surface, 0, 0), v0
Check "TriangleVertex 1", TriangleVertex(surface, 0, 1), v1
Check "TriangleVertex 2", TriangleVertex(surface, 0, 2), v2
Check "TriangleVertex of the second triangle", TriangleVertex(surface, 1, 0), v2

; Colors are white until told otherwise.
Check "VertexRed default", VertexRed(surface, v0), 255
Check "VertexGreen default", VertexGreen(surface, v0), 255
Check "VertexBlue default", VertexBlue(surface, v0), 255
Check "VertexAlpha default", VertexAlpha(surface, v0), 1
VertexColor surface, v0, 10, 20, 30, 0.5
Check "VertexColor red", VertexRed(surface, v0), 10, 0.1
Check "VertexColor green", VertexGreen(surface, v0), 20, 0.1
Check "VertexColor blue", VertexBlue(surface, v0), 30, 0.1
Check "VertexColor alpha", VertexAlpha(surface, v0), 0.5, 0.01
Check "VertexColor is for one vertex", VertexRed(surface, v1), 255
VertexColor surface, v1, 1, 2, 3
Check "VertexColor without alpha", VertexAlpha(surface, v1), 1
VertexColor surface, v1, 12.25, 100.5, 200.75, 0.123
Check "VertexColor keeps fractions of red", VertexRed(surface, v1), 12.25, 0.02
Check "VertexColor keeps fractions of green", VertexGreen(surface, v1), 100.5, 0.07
Check "VertexColor keeps fractions of blue", VertexBlue(surface, v1), 200.75, 0.15
Check "VertexColor keeps fractions of alpha", VertexAlpha(surface, v1), 0.123, 0.0005
VertexColor surface, v1, 300, -5, 0.001
Check "VertexColor clamps above 255", VertexRed(surface, v1), 255
Check "VertexColor clamps below 0", VertexGreen(surface, v1), 0
VertexColor surface, v1, 1, 128, 254
Check "VertexColor keeps single steps of red", VertexRed(surface, v1), 1, 0.01
Check "VertexColor keeps single steps of green", VertexGreen(surface, v1), 128, 0.1
Check "VertexColor keeps single steps of blue", VertexBlue(surface, v1), 254, 0.15
VertexColor surface, v1, 128, 128.5, 129
Check "VertexColor tells a half step apart", VertexGreen(surface, v1) - VertexRed(surface, v1) > 0.1, 1
VertexColor surface, v1, 300, -5, 0.001
Check "VertexColor keeps tiny values", VertexBlue(surface, v1), 0.001, 0.0001

; Texture coordinates can be changed.
VertexTexCoords surface, v0, 0.25, 0.75
Check "VertexTexCoords u", VertexU(surface, v0), 0.25
Check "VertexTexCoords v", VertexV(surface, v0), 0.75
; There is a second set, which AddVertex gives the same coordinates as the first and is changed on its own.
Check "VertexU of the second set is from AddVertex", VertexU(surface, v0, 1), 0
VertexTexCoords surface, v0, 0.5, 0.125, 1, 1
Check "VertexU of the second set", VertexU(surface, v0, 1), 0.5
Check "VertexV of the second set", VertexV(surface, v0, 1), 0.125
Check "The first set does not change", VertexU(surface, v0, 0), 0.25

; Normals are made from the triangles. This one faces away from the side that clockwise triangles are seen from.
UpdateNormals mesh
flat = CreateSurface(mesh)
a = AddVertex(flat, 0, 0, 0)
b = AddVertex(flat, 0, 1, 0)
c = AddVertex(flat, 1, 0, 0)
AddTriangle flat, a, b, c
UpdateNormals mesh
Check "Normal length", Sqr(VertexNX(flat, a) ^ 2 + VertexNY(flat, a) ^ 2 + VertexNZ(flat, a) ^ 2), 1, 0.01
Check "VertexNX", VertexNX(flat, a), 0, 0.01
Check "VertexNY", VertexNY(flat, a), 0, 0.01
Check "A triangle that is clockwise seen from behind faces away", VertexNZ(flat, a), -1, 0.01
VertexNormal flat, a, 0, 0, 1
Check "VertexNormal x", VertexNX(flat, a), 0
Check "VertexNormal z", VertexNZ(flat, a), 1
VertexNormal flat, a, 0.5, 0, 0
Check "VertexNormal sets", VertexNX(flat, a), 0.5

; Flipping turns the triangles around, which turns the normals.
FlipMesh mesh
Check "FlipMesh swaps corners", TriangleVertex(flat, 0, 1) <> b Or TriangleVertex(flat, 0, 2) <> c, 1
UpdateNormals mesh
Check "FlipMesh flips the normal", VertexNZ(flat, a), 1, 0.01
FreeEntity mesh

; The shapes: a cube of 2 by 2 by 2, around the middle.
cube = CreateCube()
Check "Cube width", MeshWidth(cube), 2, 0.001
Check "Cube height", MeshHeight(cube), 2, 0.001
Check "Cube depth", MeshDepth(cube), 2, 0.001
cubeSurface = GetSurface(cube, 1)
CheckTrue "Cube has vertices", CountVertices(cubeSurface) >= 8
Check "Cube has 12 triangles", CountTriangles(cubeSurface), 12
Check "Cube is centered", VertexX(cubeSurface, 0) ^ 2, 1, 0.001
; The order of the triangles and of their corners is the one of the original, because CollisionTriangle and TriangleVertex show it.
Check "Cube triangle 0 corner 0 x", VertexX(cubeSurface, TriangleVertex(cubeSurface, 0, 0)), -1
Check "Cube triangle 0 corner 0 y", VertexY(cubeSurface, TriangleVertex(cubeSurface, 0, 0)), 1
Check "Cube triangle 0 corner 0 z", VertexZ(cubeSurface, TriangleVertex(cubeSurface, 0, 0)), -1
Check "Cube triangle 1 corner 1 x", VertexX(cubeSurface, TriangleVertex(cubeSurface, 1, 1)), 1
Check "Cube triangle 1 corner 1 y", VertexY(cubeSurface, TriangleVertex(cubeSurface, 1, 1)), -1
Check "Cube triangle 1 corner 1 z", VertexZ(cubeSurface, TriangleVertex(cubeSurface, 1, 1)), -1

; Spheres, cylinders and cones are 2 high and 2 wide, and have more detail with more segments.
sphere = CreateSphere()
Check "Sphere width", MeshWidth(sphere), 2, 0.001
Check "Sphere height", MeshHeight(sphere), 2, 0.001
; The numbers of vertices and triangles are the ones of the original: a pole vertex for every segment, rings with the seam
; vertex repeated. (8 segments: 16 + 7 * 17 + 16 = 151 vertices and 224 triangles.)
sphereSurface = GetSurface(sphere, 1)
Check "Sphere vertices", CountVertices(sphereSurface), 151
Check "Sphere triangles", CountTriangles(sphereSurface), 224
Check "Sphere with 4 segments vertices", CountVertices(GetSurface(CreateSphere(4), 1)), 43
Check "Sphere with 4 segments triangles", CountTriangles(GetSurface(CreateSphere(4), 1)), 48
Check "Sphere with 16 segments vertices", CountVertices(GetSurface(CreateSphere(16), 1)), 559
Check "Sphere with 16 segments triangles", CountTriangles(GetSurface(CreateSphere(16), 1)), 960
Check "Sphere with 32 segments vertices", CountVertices(GetSurface(CreateSphere(32), 1)), 2143
Check "The pole is a vertex of every segment", VertexY(sphereSurface, 0), 1, 0.001
Check "The next pole vertex has its own place in the texture", VertexU(sphereSurface, 1), 1.5 / 16, 0.001
Check "The last vertex is the bottom pole", VertexY(sphereSurface, 150), -1, 0.001
detailed = CreateSphere(16)
CheckTrue "More segments make more triangles", CountTriangles(GetSurface(detailed, 1)) > CountTriangles(GetSurface(sphere, 1))
cylinder = CreateCylinder()
Check "Cylinder width", MeshWidth(cylinder), 2, 0.001
Check "Cylinder height", MeshHeight(cylinder), 2, 0.001
open = CreateCylinder(8, False)
; The sides are a surface of their own, and the caps are another with a triangle less than they have corners.
Check "Open cylinder surfaces", CountSurfaces(open), 1
Check "Open cylinder triangles", MeshTriangles(open), 16
Check "Cylinder surfaces", CountSurfaces(cylinder), 2
Check "Cylinder triangles", MeshTriangles(cylinder), 4 * 8 - 4
cone = CreateCone()
Check "Cone width", MeshWidth(cone), 2, 0.001
Check "Cone height", MeshHeight(cone), 2, 0.001
open_cone = CreateCone(8, False)
Check "Open cone surfaces", CountSurfaces(open_cone), 1
Check "Open cone triangles", MeshTriangles(open_cone), 8
Check "Cone surfaces", CountSurfaces(cone), 2
Check "Cone triangles", MeshTriangles(cone), 2 * 8 - 2
Check "Cone with 20 segments", MeshTriangles(CreateCone(20)), 2 * 20 - 2
Check "Cylinder with 3 segments", MeshTriangles(CreateCylinder(3)), 4 * 3 - 4
plane = CreatePlane()
CheckTrue "CreatePlane", plane <> 0
CheckTrue "A plane has triangles", CountTriangles(GetSurface(plane, 1)) >= 2
child = CreateCube(cube)
Check "CreateCube with a parent keeps the place", EntityX(child, True), 0
FreeEntity child

; Changing the mesh itself, and not the entity.
PositionMesh cube, 10, 0, 0
Check "PositionMesh moves the vertices", VertexX(cubeSurface, 0) > 8, 1
Check "PositionMesh does not move the entity", EntityX(cube), 0
Check "PositionMesh keeps the size", MeshWidth(cube), 2, 0.001
ScaleMesh cube, 2, 3, 4
Check "ScaleMesh width", MeshWidth(cube), 4, 0.001
Check "ScaleMesh height", MeshHeight(cube), 6, 0.001
Check "ScaleMesh depth", MeshDepth(cube), 8, 0.001
Check "ScaleMesh does not scale the entity", EntityScaleCheck(cube), 1

box = CreateCube()
ScaleMesh box, 1, 2, 3
RotateMesh box, 0, 90, 0
Check "RotateMesh turns width into depth", MeshWidth(box), 6, 0.01
Check "RotateMesh turns depth into width", MeshDepth(box), 2, 0.01
Check "RotateMesh keeps the height", MeshHeight(box), 4, 0.01

; Painting
brush = CreateBrush(10, 20, 30)
sheet = CreateCube()
PaintMesh sheet, brush
got = GetSurfaceBrush(GetSurface(sheet, 1))
CheckTrue "GetSurfaceBrush", got <> 0
partial = CreateCube()
PaintSurface GetSurface(partial, 1), brush
CheckTrue "PaintSurface", GetSurfaceBrush(GetSurface(partial, 1)) <> 0
FreeBrush got
FreeBrush brush
FreeEntity sheet
FreeEntity partial
FreeEntity box
FreeEntity plane
FreeEntity cone
FreeEntity open
FreeEntity cylinder
FreeEntity detailed
FreeEntity sphere
FreeEntity cube

; The smallest or biggest value of a coordinate in a mesh, 0 for x, 1 for y and 2 for z.
Function Extreme#(mesh, axis, biggest)
	result# = 0
	found = False
	For s = 1 To CountSurfaces(mesh)
		surf = GetSurface(mesh, s)
		For v = 0 To CountVertices(surf) - 1
			If axis = 0 Then value# = VertexX(surf, v)
			If axis = 1 Then value# = VertexY(surf, v)
			If axis = 2 Then value# = VertexZ(surf, v)
			If (found = False) Or (biggest And value > result) Or ((biggest = False) And value < result) Then result = value
			found = True
		Next
	Next
	Return result
End Function

; AddMesh puts a mesh into another, and surfaces that look the same become one.
target = CreateCube()
source = CreateCube()
vertices_each = CountVertices(GetSurface(target, 1))
triangles_each = CountTriangles(GetSurface(target, 1))
AddMesh source, target
Check "AddMesh keeps the surface", CountSurfaces(target), 1
Check "AddMesh vertices", CountVertices(GetSurface(target, 1)), vertices_each * 2
Check "AddMesh triangles", CountTriangles(GetSurface(target, 1)), triangles_each * 2
Check "AddMesh keeps the source", CountVertices(GetSurface(source, 1)), vertices_each
red = CreateBrush(255, 0, 0)
painted = CreateCube()
PaintMesh painted, red
AddMesh painted, target
Check "AddMesh adds a surface for another brush", CountSurfaces(target), 2
Check "AddMesh vertices of the new surface", CountVertices(GetSurface(target, 2)), vertices_each
Check "AddMesh the source has its surface", CountSurfaces(painted), 1
; Triangles refer to the vertices of their own surface.
last_surface = GetSurface(target, 1)
Check "AddMesh moved the triangles", TriangleVertex(last_surface, triangles_each, 0) >= vertices_each, 1

; A copy is a mesh of its own.
width# = MeshWidth(target)
duplicate = CopyMesh(target)
CheckTrue "CopyMesh", duplicate <> 0 And duplicate <> target
Check "CopyMesh surfaces", CountSurfaces(duplicate), 2
Check "CopyMesh vertices", CountVertices(GetSurface(duplicate, 1)), vertices_each * 2
Check "CopyMesh width", MeshWidth(duplicate), width
ScaleMesh duplicate, 3, 1, 1
Check "CopyMesh is separate", MeshWidth(target), width
Check "ScaleMesh on the copy", MeshWidth(duplicate), width * 3
holder = CreatePivot()
kept = CopyMesh(target, holder)
Check "CopyMesh parent", GetParent(kept), holder

; FitMesh scales and moves a mesh until it fills a box.
fitted = CreateCube()
FitMesh fitted, 10, 20, 30, 4, 6, 8
Check "FitMesh width", MeshWidth(fitted), 4, 0.001
Check "FitMesh height", MeshHeight(fitted), 6, 0.001
Check "FitMesh depth", MeshDepth(fitted), 8, 0.001
Check "FitMesh left", Extreme(fitted, 0, False), 10, 0.001
Check "FitMesh right", Extreme(fitted, 0, True), 14, 0.001
Check "FitMesh bottom", Extreme(fitted, 1, False), 20, 0.001
Check "FitMesh back", Extreme(fitted, 2, True), 38, 0.001
; Uniform keeps the shape: the cube stays a cube, as big as fits.
even = CreateCube()
FitMesh even, 0, 0, 0, 4, 8, 2, True
Check "FitMesh uniform width", MeshWidth(even), 2, 0.001
Check "FitMesh uniform height", MeshHeight(even), 2, 0.001
Check "FitMesh uniform depth", MeshDepth(even), 2, 0.001
Check "FitMesh uniform middle", Extreme(even, 0, False), 1, 0.001
Check "FitMesh uniform middle height", Extreme(even, 1, False), 3, 0.001

; The cull box decides whether a mesh is seen: this cube is far to the side, but its box reaches the middle.
camera = CreateCamera()
far_off = CreateCube()
PositionEntity far_off, 30, 0, 10
Check "Far off, not in view", EntityInView(far_off, camera), 0
MeshCullBox far_off, -40, -1, -1, 80, 2, 2
Check "MeshCullBox", EntityInView(far_off, camera), 1
FreeEntity camera

; Surfaces can be emptied: the vertices, the triangles, or both.
emptied = CreateCube()
part = GetSurface(emptied, 1)
ClearSurface part, False, True
Check "ClearSurface triangles", CountTriangles(part), 0
Check "ClearSurface keeps the vertices", CountVertices(part), vertices_each
ClearSurface part, True, False
Check "ClearSurface vertices", CountVertices(part), 0
emptied = CreateCube()
part = GetSurface(emptied, 1)
ClearSurface part
Check "ClearSurface both, vertices", CountVertices(part), 0
Check "ClearSurface both, triangles", CountTriangles(part), 0
a = AddVertex(part, 0, 0, 0)
b = AddVertex(part, 1, 0, 0)
c = AddVertex(part, 0, 1, 0)
AddTriangle part, a, b, c
Check "A cleared surface can be filled again", CountTriangles(part), 1

; Vertices can be moved.
VertexCoords part, 1, 5, 6, 7
Check "VertexCoords x", VertexX(part, 1), 5
Check "VertexCoords y", VertexY(part, 1), 6
Check "VertexCoords z", VertexZ(part, 1), 7
Check "VertexCoords leaves the others", VertexX(part, 0), 0
Check "VertexW", VertexW(part, 1), 1
Check "VertexW coord set", VertexW(part, 1, 1), 1

; LightMesh adds light to the colors of the vertices: everywhere without a range, and only where it shines with one.
lit = CreateCube()
surf = GetSurface(lit, 1)
For v = 0 To CountVertices(surf) - 1
	VertexColor surf, v, 0, 0, 0
Next
LightMesh lit, 50, 100, 150
Check "LightMesh red", VertexRed(surf, 0), 50, 0.1
Check "LightMesh green", VertexGreen(surf, 0), 100, 0.1
Check "LightMesh blue", VertexBlue(surf, CountVertices(surf) - 1), 150, 0.1
LightMesh lit, 255, 255, 255
Check "LightMesh stays within bounds", VertexRed(surf, 0), 255
lit = CreateCube()
surf = GetSurface(lit, 1)
For v = 0 To CountVertices(surf) - 1
	VertexColor surf, v, 0, 0, 0
Next
LightMesh lit, 50, 50, 50, 10, 0, 0, -5
facing = -1
away = -1
For v = 0 To CountVertices(surf) - 1
	If VertexNZ(surf, v) < -0.5 Then facing = v
	If VertexNZ(surf, v) > 0.5 Then away = v
Next
CheckTrue "The cube has faces to the light and away from it", facing >= 0 And away >= 0
Check "LightMesh with a range, facing the light", VertexRed(surf, facing), 111, 2
Check "LightMesh with a range, facing away", VertexRed(surf, away), 0

EndGraphics
Done "blitz3d_meshes"

; There is no way to ask for the scale of an entity, so what that is can be seen from where its children end up.
Function EntityScaleCheck(entity)
	scaled = CreatePivot(entity)
	PositionEntity scaled, 1, 0, 0
	result# = EntityX(scaled, True) - EntityX(entity, True)
	FreeEntity scaled
	Return result
End Function
