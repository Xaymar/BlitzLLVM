; A program that never calls Graphics opens exactly the windows it makes and no window of Graphics: its desktop is the display,
; its windows are windows of the computer with buttons and canvases that work, and a Graphics call after them keeps them (they
; are made again on the new device). This needs a window and a GPU, so it is skipped without one. Test events: @N sends what
; follows to the window of gadget N, pX:Y puts the mouse there, mN presses a button.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "plusgui_only_pixels: skipped, there is no window."
	End
EndIf

Global folder$ = "suite_tmp_only"
CreateDir folder
SetEnv "BLITZLLVM_TEST_WINDOW_SHOTS", folder

Const RED = $FF0000, GREEN = $00FF00, BLACK = 0

Global shot = 0
Function Show(win)
	If shot Then FreeImage shot
	shot = LoadImage(folder + "/window_" + QueryObject(win, 1) + ".bmp")
	If shot = 0 Then RuntimeError "The picture of the window was not saved."
End Function

Function Px(x, y)
	Return ReadPixel(x, y, ImageBuffer(shot)) And $FFFFFF
End Function

; Waits until nothing comes any more, and tells how many actions a gadget had.
Function Actions(gadget)
	count = 0
	quiet = 0
	While quiet < 6
		e = WaitEvent(50)
		If e = 0 Then
			quiet = quiet + 1
		Else
			quiet = 0
			If (e = $401) And (EventSource() = gadget) Then count = count + 1
		EndIf
	Wend
	Return count
End Function

; The desktop is the display, not a window of Graphics.
CheckTrue "The desktop is as wide as the display", ClientWidth(Desktop()) >= 640
CheckTrue "The desktop is as high as the display", ClientHeight(Desktop()) >= 480

; A window with a button and a canvas, without Graphics.
win = CreateWindow("Only", 30, 30, 200, 150, 0, 0)
number = QueryObject(win, 1)
CheckTrue "A window without Graphics is a window of the computer", number <> 0
btn = CreateButton("Press", 10, 10, 80, 24, win)
cv = CreateCanvas(0, 50, 200, 100, win)
Actions(0)
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + btn + ",p20:20,m1"
Check "A press in the window presses its button", Actions(btn), 1

SetBuffer CanvasBuffer(cv)
Color 255, 0, 0
Rect 0, 0, 200, 100, 1
FlipCanvas cv, 1
Show(win)
Check "A canvas without Graphics shows what was drawn", Px(100, 100), RED

; Graphics after the windows: they stay, on the new device, and go on working.
Graphics 320, 240, 32, 2
AutoSuspend False
Actions(0)
CheckTrue "The window is still a window of the computer after Graphics", QueryObject(win, 1) <> 0
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + btn + ",p20:20,m1"
Check "A press after Graphics presses its button", Actions(btn), 1
SetBuffer CanvasBuffer(cv)
Color 0, 255, 0
Rect 0, 0, 200, 100, 1
SetBuffer BackBuffer()
FlipCanvas cv, 1
Show(win)
Check "A canvas after Graphics shows what was drawn", Px(100, 100), GREEN

FreeGadget win
Done "plusgui_only_pixels"
