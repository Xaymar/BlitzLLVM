; Choosing the GPU with SetGfxDriver, which needs a window and a GPU so this is skipped without one: every driver that can draw
; opens a window and is the one in use, and choosing another driver once the window exists changes nothing.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "gfx_driver_pixels: skipped, there is no window."
	End
EndIf

count = CountGfxDrivers()
CheckTrue "CountGfxDrivers", count >= 1
; Before the window the driver is the first one, which is the one that is used without SetGfxDriver.
Check "GfxDriver default", GfxDriver(), 1
For d = 1 To count
	CheckTrue "GfxDriverName " + d, Len(GfxDriverName$(d)) > 0
Next

; Every driver that can draw 3D has to work with a window of its own.
tested = 0
For d = 1 To count
	If GfxDriver3D(d) Then
		SetGfxDriver d
		Check "GfxDriver chosen " + d, GfxDriver(), d
		Graphics3D 64, 48, 32, 2
		Check "GfxDriver in use " + d, GfxDriver(), d
		SetBuffer BackBuffer()
		Color 255, 0, 0
		Rect 0, 0, 64, 48
		Check "Pixel with driver " + d, ReadPixel(10, 10, BackBuffer()) And $FFFFFF, $FF0000
		EndGraphics
		tested = tested + 1
	EndIf
Next
CheckTrue "A driver can draw", tested >= 1

; With the window open the GPU cannot change any more. A release build ignores the call, a debug build stops with an error.
SetGfxDriver 1
Graphics3D 64, 48, 32, 2
If count > 1 Then SetGfxDriver count
Check "GfxDriver stays", GfxDriver(), 1
EndGraphics
