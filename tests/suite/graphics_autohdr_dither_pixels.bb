; The 8 bit picture of the gamma pass (Dither, a buffer of 30 bits, gamma tables) is what the HDR pass reads in AutoHDR 1 and 2. If that
; picture cannot be sampled, the HDR pass reads black. BLITZLLVM_TEST_HDR makes the runtime run the HDR pass without an HDR display
; and write what it made (see graphics_autohdr_pixels). Needs a window and a GPU.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_autohdr_dither_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 48

; One channel (0 red, 1 green, 2 blue) of the pixel the HDR pass made at a point.
Function Shown#(x, y, channel)
	f = ReadFile("hdr.tmp")
	If f = 0 Then RuntimeError "Nothing was presented."
	skip = 0
	For line = 1 To 2
		skip = skip + Len(ReadLine$(f)) + 1
	Next
	SeekFile f, skip + ((y * W + x) * 3 + channel) * 4
	Local v# = ReadFloat(f)
	CloseFile f
	Return v
End Function

DeleteFile "hdr.tmp" ; Not one of an earlier run.
SetEnv "BLITZLLVM_TEST_HDR", "hdr.tmp"

AutoHDR 1
AutoHDRWhite 160 ; 2.0 in scRGB
Dither 1
Graphics W, H, 32, 2
SetBuffer BackBuffer()

; Mid grey 128 is 0.2158 linear, 0.4316 at 160 nits. The noise of Dither is half a step of 8 bits, so it moves that a little.
Color 128, 128, 128
Rect 0, 0, W, H, 1
Flip 2
Check "Dither 1 does not make the picture black", Shown(10, 10, 1), 0.4316, 0.02
AutoHDR 2
AutoHDRPeak 1000
Flip 2
Check "Dither 1 in mode 2 does not make the picture black", Shown(10, 10, 1), 0.53733, 0.1
; A buffer of 30 bits always goes through the 8 bit picture in modes 1 and 2.
EndGraphics
AutoHDR 1
Dither 0
Graphics W, H, 30, 2
SetBuffer BackBuffer()
Color 128, 128, 128
Rect 0, 0, W, H, 1
Flip 2
Check "a buffer of 30 bits in mode 1 is not black", Shown(10, 10, 1), 0.4316, 0.02

DeleteFile "hdr.tmp"
Done "graphics_autohdr_dither_pixels"
