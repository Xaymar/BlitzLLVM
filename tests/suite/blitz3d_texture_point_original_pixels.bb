; Texture flag 1024 (point sampling) against pixels read from the original Blitz3D 1.118 (Direct3D 7 through Wine) with
; tests/lighting_compare/pointflag.bb: a texture of two texels, red and blue, magnified over a cube face. With the flag
; the texels stay apart, without it they blend. A sampler set with SetTextureSampler overrides the flag.
; Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_texture_point_original_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
Global cube = CreateCube()
EntityFX cube, 1

Function Strip(flags)
	t = CreateTexture(2, 1, flags + 4096)
	SetBuffer TextureBuffer(t)
	WritePixel 0, 0, $FFFF0000
	WritePixel 1, 0, $FF0000FF
	SetBuffer BackBuffer()
	Return t
End Function

Function Show(t)
	EntityTexture cube, t
	PositionEntity cube, 0, 0, 3
	RenderWorld
End Function

; Pixels x = 40, 48 ... 112 of the row y = 60, as red and blue each (green is 0 in all of them).
Function CheckRow(name$, r0, b0, r1, b1, r2, b2, r3, b3, r4, b4, r5, b5, r6, b6, r7, b7, r8, b8, r9, b9)
	Local x, p, wr, wb
	For i = 0 To 9
		x = 40 + i * 8
		p = ReadPixel(x, 60, BackBuffer())
		Select i
			Case 0 : wr = r0 : wb = b0
			Case 1 : wr = r1 : wb = b1
			Case 2 : wr = r2 : wb = b2
			Case 3 : wr = r3 : wb = b3
			Case 4 : wr = r4 : wb = b4
			Case 5 : wr = r5 : wb = b5
			Case 6 : wr = r6 : wb = b6
			Case 7 : wr = r7 : wb = b7
			Case 8 : wr = r8 : wb = b8
			Case 9 : wr = r9 : wb = b9
		End Select
		Check name$ + " red at " + x, (p Shr 16) And 255, wr, 8
		Check name$ + " green at " + x, (p Shr 8) And 255, 0, 8
		Check name$ + " blue at " + x, p And 255, wb, 8
	Next
End Function

ClearTextureFilters

Show Strip(1)
CheckRow "Linear", 128, 128, 178, 77, 229, 26, 229, 26, 178, 77, 128, 128, 77, 178, 26, 229, 26, 229, 77, 178

Show Strip(1024)
; The square must be there at all: a red half, a blue half and the black of the camera around it.
CheckTrue "Red half is drawn", ((ReadPixel(60, 60, BackBuffer()) Shr 16) And 255) > 200
CheckTrue "Blue half is drawn", (ReadPixel(100, 60, BackBuffer()) And 255) > 200
CheckTrue "Outside the square is black", (ReadPixel(10, 60, BackBuffer()) And $FFFFFF) = 0
CheckRow "Point", 255, 0, 255, 0, 255, 0, 255, 0, 255, 0, 255, 0, 0, 255, 0, 255, 0, 255, 0, 255

Show Strip(1025)
CheckRow "Point with the color flag", 255, 0, 255, 0, 255, 0, 255, 0, 255, 0, 255, 0, 0, 255, 0, 255, 0, 255, 0, 255

; A sampler overrides the flag, and taking it away brings the flag back.
sampler = CreateSampler()
SetSamplerFilterMin sampler, 1
SetSamplerFilterMag sampler, 1
point = Strip(1024)
SetTextureSampler point, sampler
Show point
CheckRow "Linear sampler on a point texture", 128, 128, 178, 77, 229, 26, 229, 26, 178, 77, 128, 128, 77, 178, 26, 229, 26, 229, 77, 178
SetTextureSampler point, 0
Show point
CheckRow "Flag again", 255, 0, 255, 0, 255, 0, 255, 0, 255, 0, 255, 0, 0, 255, 0, 255, 0, 255, 0, 255

Done "blitz3d_texture_point_original_pixels"
End
