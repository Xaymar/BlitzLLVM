; More than eight lights: each draw is lit by the eight lights that are the nearest to it, where the original (and
; the 3D hardware of its time) lit everything with the first eight. Needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_many_lights_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
AmbientLight 0, 0, 0

; Twelve small spheres, far apart, with a light each (light fades with distance, so far that the others add nothing).
Dim spheres(12)
Dim lights(12)
For i = 0 To 11
	spheres(i) = CreateSphere(16)
	PositionEntity spheres(i), i * 2000, 0, 0
	EntityColor spheres(i), 255, 255, 255
	lights(i) = CreateLight(2)
	LightRange lights(i), 8
	PositionEntity lights(i), i * 2000, 0, -4
Next
; And a sphere that none of the lights reach.
dark = CreateSphere(16)
PositionEntity dark, 40000, 0, 0
EntityColor dark, 255, 255, 255

; Every sphere is lit by its own light, also the ones after the eighth.
For i = 0 To 11
	PositionEntity camera, i * 2000, 0, -6
	RenderWorld
	CheckTrue "Sphere " + i + " is lit by its own light (" + R(80, 60) + ")", R(80, 60) > 120
Next
PositionEntity camera, 40000, 0, -6
RenderWorld
Check "A sphere far from every light is dark", R(80, 60), 0, 6

; Ten lights on one sphere: only eight of them count. One light of a dim color gives some brightness, eight
; give eight times that.
For i = 0 To 11
	FreeEntity lights(i)
Next
FreeEntity dark
Dim lamps(10)
For i = 0 To 9
	lamps(i) = CreateLight(2)
	LightRange lamps(i), 5
	LightColor lamps(i), 12, 12, 12
	PositionEntity lamps(i), 0, 0, -5 - i * 0.01
Next
PositionEntity camera, 0, 0, -6
EntityColor spheres(0), 255, 255, 255
PositionEntity spheres(0), 0, 0, 0
For i = 1 To 11
	HideEntity spheres(i)
Next
RenderWorld
For i = 1 To 9
	HideEntity lamps(i)
Next
RenderWorld
one = R(80, 60)
CheckTrue "One dim light is visible (" + one + ")", one > 6
For i = 1 To 7
	ShowEntity lamps(i)
Next
RenderWorld
eight = R(80, 60)
Check "Eight lights are eight times one", eight, one * 8, 12
For i = 8 To 9
	ShowEntity lamps(i)
Next
RenderWorld
Check "The ninth and tenth light add nothing", R(80, 60), eight, 2

; The eight are those that do the most, not only the nearest: a bright light that is further away wins over dim ones.
bright = CreateLight(2)
LightRange bright, 5
LightColor bright, 255, 255, 255
PositionEntity bright, 0, 0, -8
RenderWorld
CheckTrue "A bright light beats dim ones (" + R(80, 60) + ")", R(80, 60) > eight + 100

; A negative light darkens, and counts by its strength: a strong one takes a place from the dim lights.
HideEntity bright
dark_light = CreateLight(2)
LightRange dark_light, 5
LightColor dark_light, -255, -255, -255
PositionEntity dark_light, 0, 0, -8
RenderWorld
CheckTrue "A strong negative light is picked and darkens (" + R(80, 60) + ")", R(80, 60) < eight - 60

; A field of cubes with many lights of all kinds, seen from different places. The test runs with BLITZ_CHECK_LIGHTS, which
; makes the runtime rate the lights of every draw twice (by the cells of the view and by all lights) and stop if the eight
; are not the same.
HideEntity bright
HideEntity dark_light
For i = 0 To 9
	HideEntity lamps(i)
Next
HideEntity spheres(0)
Global seed = 4711
Function Rand01#()
	seed = (seed * 16807) Mod 2147483647
	Return Float(seed) / 2147483647.0
End Function
For i = 1 To 150
	cube = CreateCube()
	ScaleEntity cube, 0.5 + Rand01() * 1.5, 0.5 + Rand01() * 1.5, 0.5 + Rand01() * 1.5
	PositionEntity cube, Rand01() * 120 - 60, 0, Rand01() * 120 - 60
Next
Dim torches(90)
For i = 1 To 90
	torches(i) = CreateLight(2)
	LightRange torches(i), 3 + Rand01() * 9
	scale# = 40 + Rand01() * 215
	If i Mod 5 = 0 Then scale = -scale
	LightColor torches(i), scale, scale * Rand01(), scale * Rand01()
	PositionEntity torches(i), Rand01() * 120 - 60, 1 + Rand01() * 3, Rand01() * 120 - 60
Next
CameraRange camera, 0.5, 300
For view = 0 To 5
	PositionEntity camera, view * 8 - 20, 8 + view * 3, -70 + view * 10
	RotateEntity camera, 15 + view * 3, view * 7 - 15, 0
	RenderWorld
	RenderWorld
Next
; Lights and cubes that move: what was picked before is not used for them.
For view = 0 To 5
	PositionEntity torches(1 + view), view * 9 - 25, 2, view * 9 - 25
	MoveEntity camera, 0, 0, 3
	RenderWorld
Next

Print "blitz3d_many_lights_pixels: done"
