; Streams, using files: ReadByte ReadShort ReadInt ReadFloat ReadString$ ReadLine$ WriteByte WriteShort WriteInt
; WriteFloat WriteString WriteLine Eof ReadAvail.
Include "check.bb"

folder$ = "suite_tmp_streams"
CreateDir folder
name$ = folder + "/data.bin"

; Everything that is written can be read back, in the same order.
file = WriteFile(name)
WriteByte file, 200
WriteByte file, -1
WriteShort file, 65000
WriteShort file, -2
WriteInt file, 123456789
WriteInt file, -42
WriteFloat file, 3.25
WriteFloat file, -0.5
WriteString file, "Hello"
WriteString file, ""
WriteLine file, "first line"
WriteLine file, ""
WriteLine file, "last"
CloseFile file

file = ReadFile(name)
Check "ReadByte", ReadByte(file), 200
Check "ReadByte of -1", ReadByte(file), 255
Check "ReadShort", ReadShort(file), 65000
Check "ReadShort of -2", ReadShort(file), 65534
Check "ReadInt", ReadInt(file), 123456789
Check "ReadInt negative", ReadInt(file), -42
Check "ReadFloat", ReadFloat(file), 3.25
Check "ReadFloat negative", ReadFloat(file), -0.5
CheckS "ReadString$", ReadString$(file), "Hello"
CheckS "ReadString$ empty", ReadString$(file), ""
CheckS "ReadLine$", ReadLine$(file), "first line"
CheckS "ReadLine$ empty", ReadLine$(file), ""
CheckFalse "Eof before the last line", Eof(file)
CheckS "ReadLine$ last", ReadLine$(file), "last"
CheckTrue "Eof", Eof(file)
CloseFile file

; The format is the one of the original: little endian numbers, strings with a length in front, lines end with CR LF.
file = WriteFile(name)
WriteInt file, $04030201
WriteString file, "ab"
WriteLine file, "x"
CloseFile file
Check "size", FileSize(name), 4 + 4 + 2 + 3
file = ReadFile(name)
Check "int is little endian", ReadByte(file), 1
Check "int byte 2", ReadByte(file), 2
Check "int byte 3", ReadByte(file), 3
Check "int byte 4", ReadByte(file), 4
Check "string length", ReadInt(file), 2
Check "string 1", ReadByte(file), 97
Check "string 2", ReadByte(file), 98
Check "line 1", ReadByte(file), 120
Check "line CR", ReadByte(file), 13
Check "line LF", ReadByte(file), 10
CloseFile file

; ReadLine$ handles both kinds of line endings, and a last line without an ending.
file = WriteFile(name)
WriteByte file, Asc("a")
WriteByte file, 10
WriteByte file, Asc("b")
WriteByte file, 13
WriteByte file, 10
WriteByte file, Asc("c")
CloseFile file
file = ReadFile(name)
CheckS "unix line", ReadLine$(file), "a"
CheckS "windows line", ReadLine$(file), "b"
CheckS "line without ending", ReadLine$(file), "c"
CheckTrue "Eof after the last line", Eof(file)
CloseFile file

; ReadAvail is only for streams that wait for data. Files give 0 or what is left.
file = ReadFile(name)
CheckTrue "ReadAvail", ReadAvail(file) >= 0
CloseFile file

DeleteFile name

Done "streams"
