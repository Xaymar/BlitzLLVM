; AutoHDR 3 shows a buffer of more than 8 bits as it is: its precision is kept, and values above 1 are brighter than SDR white up to the
; peak. The other modes show it through the 8 bit picture of the gamma pass, which rounds it and cuts it at 1. BLITZLLVM_TEST_HDR makes the
; runtime run the HDR pass without an HDR display and write what it made (see graphics_autohdr_pixels). Needs a window and a GPU.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_autohdr_deep_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 48

; One channel (0 red, 1 green, 2 blue) of the pixel the HDR pass made at a point.
Function Shown#(x, y, channel)
	f = ReadFile("hdr.tmp")
	If f = 0 Then RuntimeError "Nothing was presented."
	skip = 0
	For line = 1 To 2
		skip = skip + Len(ReadLine$(f)) + 1
	Next
	SeekFile f, skip + ((y * W + x) * 3 + channel) * 4
	Local v# = ReadFloat(f)
	CloseFile f
	Return v
End Function

DeleteFile "hdr.tmp" ; Not one of an earlier run.
SetEnv "BLITZLLVM_TEST_HDR", "hdr.tmp"

AutoHDR 3
AutoHDRWhite 160 ; 2.0 in scRGB
AutoHDRPeak 1000 ; 12.5
Graphics3D W, H, 64, 2
SetBuffer BackBuffer()

; A value between two steps of 8 bits keeps its place: 0.25 is 63.75 of 255, the 8 bit picture would round it to 64.
WritePixel64 10, 10, 0, 0.25, 0.25, 0.25, 1.0
Flip 2
Check "precision is kept", Shown(10, 10, 1), 0.101752, 0.0003

; Above 1 is brighter than SDR white, up to the peak, and no lift is added.
WritePixel64 10, 10, 0, 2.0, 0.5, 2.0, 1.0
Flip 2
Check "above white is brighter", Shown(10, 10, 0), 9.90769, 0.02
Check "the others stay", Shown(10, 10, 1), 0.428, 0.005
WritePixel64 10, 10, 0, 3.0, 0.0, 0.0, 1.0
Flip 2
Check "cut at the peak", Shown(10, 10, 0), 12.5, 0.02

; The other modes go through the 8 bit picture: 1.0 is the most it has.
AutoHDR 1
WritePixel64 10, 10, 0, 2.0, 0.0, 0.0, 1.0
Flip 2
Check "mode 1 stops at white", Shown(10, 10, 0), 2, 0.005

DeleteFile "hdr.tmp"
Done "graphics_autohdr_deep_pixels"
