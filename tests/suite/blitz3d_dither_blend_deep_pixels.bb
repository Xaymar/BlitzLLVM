; Dither 2 only blends in the shader when the target has 8 bits per color. A buffer of 10 bits (Graphics3D depth 30) keeps the
; fixed-function blender, so asking for Dither 2 there must still draw the blend, with no pixel further than a step from the exact value.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_dither_blend_deep_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 48
Graphics3D W, H, 30, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
PositionEntity camera, 0, 2, 0
RotateEntity camera, 90, 0, 0
CameraRange camera, 0.1, 100
CameraClsColor camera, 0, 0, 0
Global ground = CreatePlane()
EntityFX ground, 1
EntityColor ground, 84, 84, 84
EntityBlend ground, 1
EntityAlpha ground, 0.3

; 0.3 of 84 over black is 25.2, which is 101 of 1023. ReadPixel gives the buffer as it is, the red channel in the low 10 bits.
Function Far(level)
	Dither level
	RenderWorld
	Local x, y, c, n = 0
	For y = 0 To H - 1
		For x = 0 To W - 1
			c = ReadPixel(x, y, BackBuffer()) And 1023
			If c < 97 Or c > 105 Then n = n + 1
		Next
	Next
	Return n
End Function

Check "alpha in a 10 bit buffer with Dither 1 is near 101 of 1023", Far(1), 0
Check "alpha in a 10 bit buffer with Dither 2 is near 101 of 1023", Far(2), 0
