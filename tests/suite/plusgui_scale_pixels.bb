; Windows of the computer on a display that scales them (BLITZLLVM_GUI_SCALE forces a scale of 2 here, as a display of a high
; density of pixels has): the window has twice the pixels of the size the program gave, the gadgets are drawn twice as big, and
; the program sees nothing of it: gadget sizes and places, the mouse and the buffer of a canvas stay in its units, and the picture
; of a canvas is enlarged with the window. This needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "plusgui_scale_pixels: skipped, there is no window."
	End
EndIf

Global folder$ = "suite_tmp_scale"
CreateDir folder
SetEnv "BLITZLLVM_TEST_WINDOW_SHOTS", folder
SetEnv "BLITZLLVM_GUI_SCALE", "2"
Graphics 320, 240, 32, 2
SetBuffer BackBuffer()
AutoSuspend False

Const RED = $FF0000, GREEN = $00FF00, BLUE = $0000FF, WHITE = $FFFFFF, BLACK = 0, FACE = $D4D0C8

; The picture of a window as the runtime saved it when the window was drawn last, for Px: it has every pixel of the window.
Global shot = 0
Function Show(win)
	If shot Then FreeImage shot
	shot = LoadImage(folder + "/window_" + QueryObject(win, 1) + ".bmp")
	If shot = 0 Then RuntimeError "The picture of the window was not saved."
End Function

Function Px(x, y)
	Return ReadPixel(x, y, ImageBuffer(shot)) And $FFFFFF
End Function

; Lets the windows tell what happened to them, and draws what changed.
Function Pump()
	For i = 1 To 3
		PeekEvent()
		Delay 20
	Next
End Function

; A window with a button and a canvas, in the units of the program.
win = CreateWindow("Scaled", 20, 20, 400, 300, 0, 0)
button = CreateButton("Press", 10, 10, 80, 24, win)
canvas = CreateCanvas(10, 50, 100, 80, win)
Pump()

; The program's view of the window is what it asked for.
Check "GadgetWidth is in the units of the program", GadgetWidth(win), 400
Check "GadgetHeight is in the units of the program", GadgetHeight(win), 300
Check "GadgetX is in the units of the program", GadgetX(win), 20
Check "ClientWidth is in the units of the program", ClientWidth(win), 400

; The window has twice the pixels.
Show(win)
Check "The picture of the window is twice as wide", ImageWidth(shot), 800
Check "The picture of the window is twice as high", ImageHeight(shot), 600
Check "The face of the button is where the button is, twice as big", Px(2 * 14, 2 * 22), FACE
Check "The light edge of the button is two pixels wide", Px(2 * 10 + 1, 2 * 22), WHITE
Check "The window past the button is its face", Px(2 * 92, 2 * 22), FACE
Check "The canvas is black before it is flipped", Px(2 * 60, 2 * 90), BLACK

; The buffer of a canvas is in the units of the program: 100 by 80, and what is drawn to it is enlarged in the window.
SetBuffer CanvasBuffer(canvas)
Color 255, 0, 0
Rect 0, 0, 100, 80, 1
Color 0, 0, 255
Rect 50, 40, 50, 40, 1
Check "The canvas buffer has the last pixel of its 100 by 80", ReadPixel(99, 79) And $FFFFFF, BLUE
Check "The canvas buffer is drawn in the units of the program", ReadPixel(49, 39) And $FFFFFF, RED
SetBuffer BackBuffer()
FlipCanvas canvas, 1
Show(win)
Check "The red part of the canvas is twice as big", Px(2 * 10 + 99, 2 * 50 + 79), RED
Check "The blue part of the canvas is twice as big", Px(2 * 10 + 100, 2 * 50 + 80), BLUE
Check "The canvas ends twice as far", Px(2 * 10 + 199, 2 * 50 + 159), BLUE
Check "Past the canvas is the window", Px(2 * 10 + 200, 2 * 50 + 160), FACE

; The mouse is in the units of the program: a press at the middle of the button presses the button.
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + win + ",p50:22,m1"
pressed = 0
For i = 1 To 20
	id = PeekEvent()
	If id = 0 Then
		Delay 20
	Else
		id = WaitEvent()
		If id = $401 And EventSource() = button Then pressed = 1
	EndIf
Next
Check "A press at the button in the units of the program presses it", pressed, 1

; WindowScale tells the scale of the display; WindowScaling 0 leaves the scaling to the program (a unit is a pixel) and tells
; the windows with $805, WindowScaling 1 scales again.
Check "WindowScale is the scale of the display", WindowScale(win), 2.0
WindowScaling 0
told = 0
For i = 1 To 20
	id = PeekEvent()
	If id = 0 Then
		Delay 20
	Else
		id = WaitEvent()
		If id = $805 And EventSource() = win Then told = EventData()
	EndIf
Next
Check "WindowScaling 0 is told with $805, the scale of the display in percent", told, 200
Show(win)
Check "WindowScaling 0 leaves the window as many pixels as the program said", ImageWidth(shot), 400
Check "WindowScaling 0 keeps the size in units", GadgetWidth(win), 400
Check "WindowScale still tells the scale of the display", WindowScale(win), 2.0
; The button has the focus after the press, so its focus ring is at 14; the face is inside of it.
Check "A unit is a pixel: the face of the button is at its place", Px(18, 22), FACE
WindowScaling 1
Pump()
Show(win)
Check "WindowScaling 1 scales the window again", ImageWidth(shot), 800

; The shape of a window is set and told in the units of the program.
SetGadgetShape win, 40, 60, 240, 180
Pump()
Check "GadgetWidth after SetGadgetShape", GadgetWidth(win), 240
Check "GadgetHeight after SetGadgetShape", GadgetHeight(win), 180
Check "GadgetX after SetGadgetShape", GadgetX(win), 40
Check "GadgetY after SetGadgetShape", GadgetY(win), 60
Show(win)
Check "The picture follows the size, twice as wide", ImageWidth(shot), 480
Check "The picture follows the size, twice as high", ImageHeight(shot), 360

; The color requester is drawn and answered in the units of the program: it is 340 by 190 in the middle of the window, its OK
; button 76 by 24 at 170 from the right and 34 from the bottom; the window is 400 by 300 again for that.
SetGadgetShape win, 20, 20, 400, 300
ActivateWindow win
Pump()
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + win + ",p238:223,m1"
Check "RequestColor in a scaled window, OK pressed", RequestColor(10, 20, 30), 1
Check "RequestedGreen", RequestedGreen(), 20

FreeGadget win
Done "plusgui_scale_pixels"
