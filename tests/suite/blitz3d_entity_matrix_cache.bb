; The world matrix of an entity is kept until something it is made of changes (its position, rotation, scale, parent, or the
; world matrix of the parent). Every way of changing those has to give the same world values as an entity that was made in that
; state and never asked before. EntityX EntityY EntityZ EntityPitch EntityYaw EntityRoll EntityDistance TFormPoint.
Include "check.bb"

Graphics3D 320, 240, 32, 2

; The world values of a and b are the same.
Function Same(name$, a, b)
	Check name + " X", EntityX(a, True), EntityX(b, True)
	Check name + " Y", EntityY(a, True), EntityY(b, True)
	Check name + " Z", EntityZ(a, True), EntityZ(b, True)
	Check name + " pitch", EntityPitch(a, True), EntityPitch(b, True), 0.001
	Check name + " yaw", EntityYaw(a, True), EntityYaw(b, True), 0.001
	Check name + " roll", EntityRoll(a, True), EntityRoll(b, True), 0.001
	TFormPoint 1, 2, 3, a, 0
	x# = TFormedX() : y# = TFormedY() : z# = TFormedZ()
	TFormPoint 1, 2, 3, b, 0
	Check name + " TFormPoint X", x, TFormedX()
	Check name + " TFormPoint Y", y, TFormedY()
	Check name + " TFormPoint Z", z, TFormedZ()
End Function

; Asks for the world values, so that they are kept.
Function Ask(e)
	Return EntityX(e, True) + EntityPitch(e, True)
End Function

; A grandparent, a parent and a child; the twin chain is made in the end state without being asked before.
gp = CreatePivot()
p = CreatePivot(gp)
c = CreatePivot(p)
PositionEntity gp, 1, 2, 3
PositionEntity p, 4, 0, 0
PositionEntity c, 0, 0, 5
Ask c

PositionEntity c, 0, 1, 5
twin_gp = CreatePivot() : PositionEntity twin_gp, 1, 2, 3
twin_p = CreatePivot(twin_gp) : PositionEntity twin_p, 4, 0, 0
twin_c = CreatePivot(twin_p) : PositionEntity twin_c, 0, 1, 5
Same "PositionEntity", c, twin_c

TurnEntity gp, 0, 30, 0
Ask c
RotateEntity twin_gp, 0, 30, 0
Same "TurnEntity of the grandparent", c, twin_c

ScaleEntity p, 2, 3, 4
ScaleEntity twin_p, 2, 3, 4
Same "ScaleEntity of the parent", c, twin_c

RotateEntity p, 10, 20, 30
RotateEntity twin_p, 10, 20, 30
Same "RotateEntity of the parent", c, twin_c

MoveEntity gp, 0, 0, 7
TranslateEntity twin_gp, -7 * Sin(30), 0, 7 * Cos(30)
Same "MoveEntity of the grandparent", c, twin_c

; MoveEntity goes the way the entity faces now, not the way it faced when it was last moved.
m = CreatePivot()
MoveEntity m, 0, 0, 1
TurnEntity m, 0, 90, 0
MoveEntity m, 0, 0, 1
Check "MoveEntity after a turn X", EntityX(m), -1
Check "MoveEntity after a turn Z", EntityZ(m), 1
RotateEntity m, 0, 0, 0
MoveEntity m, 0, 0, 1
Check "MoveEntity after RotateEntity Z", EntityZ(m), 2

; A new parent, keeping the world values and keeping the local ones.
other = CreatePivot()
PositionEntity other, -5, 0, 0
RotateEntity other, 0, -45, 0
Ask c
wx# = EntityX(c, True) : wy# = EntityY(c, True) : wz# = EntityZ(c, True)
EntityParent c, other, True
Check "EntityParent global keeps X", EntityX(c, True), wx, 0.001
Check "EntityParent global keeps Y", EntityY(c, True), wy, 0.001
Check "EntityParent global keeps Z", EntityZ(c, True), wz, 0.001
EntityParent c, gp, False
Ask c
twin_c2 = CopyEntity(c, twin_gp) ; Has the local position, rotation and scale of c, which EntityParent with True changed.
Same "EntityParent local", c, twin_c2
EntityParent c, 0
Ask c
EntityParent c, p, False
twin_c3 = CopyEntity(c, twin_p)
Same "EntityParent back", c, twin_c3

; EntityDistance after both moved.
a = CreatePivot() : b = CreatePivot()
PositionEntity b, 3, 4, 0
Check "EntityDistance", EntityDistance(a, b), 5
PositionEntity b, 0, 0, 2
Check "EntityDistance after a move", EntityDistance(a, b), 2
PositionEntity a, 0, 0, -1
Check "EntityDistance after the other moved", EntityDistance(a, b), 3

; A freed entity's handle that a new entity gets starts with nothing kept.
q = CreatePivot(p)
PositionEntity q, 9, 9, 9
Ask q
FreeEntity q
r = CreatePivot()
PositionEntity r, 9, 9, 9
Check "New entity after FreeEntity X", EntityX(r, True), 9
Check "New entity after FreeEntity Y", EntityY(r, True), 9
Check "New entity after FreeEntity Z", EntityZ(r, True), 9

; A parent that is freed and replaced: the children go with it, a new entity in the parent's place is not their parent.
pp = CreatePivot()
PositionEntity pp, 100, 0, 0
kid = CreatePivot(pp)
Ask kid
FreeEntity pp
s = CreatePivot()
kid2 = CreatePivot(s)
Check "Child of a new parent", EntityX(kid2, True), 0

; CopyEntity copies where the entity is.
copy = CopyEntity(c, p)
Same "CopyEntity", copy, c

; Animation keys move the entity without the position functions.
mover = CreatePivot()
SetAnimKey mover, 0
PositionEntity mover, 10, 0, 0
SetAnimKey mover, 10
PositionEntity mover, 0, 0, 0
seq = AddAnimSeq(mover, 10)
SetAnimTime mover, 5, seq
Check "Animation at frame 5", EntityX(mover, True), 5, 0.01
SetAnimTime mover, 10, seq
Check "Animation at frame 10", EntityX(mover, True), 10, 0.01

EndGraphics
Done "entity matrix cache"
