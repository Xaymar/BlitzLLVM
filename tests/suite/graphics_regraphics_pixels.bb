; Calling Graphics again changes the resolution: images and textures survive it with the pixels they had, also those that were drawn to,
; and so do the ones made before the first call of Graphics. Needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_regraphics_pixels: skipped, there is no window."
	End
EndIf

; Made before any call of Graphics.
early = CreateImage(8, 8)
SetBuffer ImageBuffer(early)
Color 0, 255, 0
Rect 0, 0, 8, 8, 1

Graphics 96, 64, 32, 2
SetBuffer BackBuffer()
CheckTrue "The image made before Graphics survives", early <> 0
Check "The early image keeps its pixels", ReadPixel(3, 3, ImageBuffer(early)) And $FFFFFF, $00FF00

img = CreateImage(16, 16)
SetBuffer ImageBuffer(img)
Color 255, 0, 0
Rect 0, 0, 16, 16, 1
Color 0, 0, 255
Rect 8, 8, 8, 8, 1
tex = CreateTexture(8, 8)
WritePixel 2, 2, $FF123456, TextureBuffer(tex)
SetBuffer BackBuffer()

Graphics 128, 96, 32, 2
SetBuffer BackBuffer()
Check "The resolution changed", GraphicsWidth(), 128
Check "The resolution changed in height", GraphicsHeight(), 96
Check "Image keeps what was drawn", ReadPixel(2, 2, ImageBuffer(img)) And $FFFFFF, $FF0000
Check "Image keeps what was drawn later", ReadPixel(10, 10, ImageBuffer(img)) And $FFFFFF, $0000FF
Check "Texture keeps what was written", ReadPixel(2, 2, TextureBuffer(tex)) And $FFFFFF, $123456
Check "The early image still has its pixels", ReadPixel(3, 3, ImageBuffer(early)) And $FFFFFF, $00FF00
Check "Image keeps its size", ImageWidth(img), 16

; The image still draws, and the new resolution is the one that is drawn to.
Cls
DrawImage img, 0, 0
Check "The image draws after the change", ReadPixel(2, 2, BackBuffer()) And $FFFFFF, $FF0000
Check "The back buffer has the new size", ReadPixel(120, 90, BackBuffer()) And $FFFFFF, 0

; And once more, smaller.
Graphics 64, 48, 32, 2
Check "A third call", GraphicsWidth(), 64
Check "Image still has its pixels", ReadPixel(10, 10, ImageBuffer(img)) And $FFFFFF, $0000FF

FreeImage img
FreeImage early
FreeTexture tex
Done "graphics_regraphics_pixels"
