; Network, on this computer: DottedIP$ CountHostIPs HostIP CreateTCPServer AcceptTCPStream OpenTCPStream CloseTCPStream
; CloseTCPServer TCPStreamIP TCPStreamPort TCPTimeouts CreateUDPStream CloseUDPStream SendUDPMsg RecvUDPMsg UDPMsgIP
; UDPMsgPort UDPStreamPort.
Include "check.bb"

; Addresses are numbers with the udp_a part in the highest byte.
CheckS "DottedIP$", DottedIP$($7F000001), "127.0.0.1"
CheckS "DottedIP$ zero", DottedIP$(0), "0.0.0.0"
CheckS "DottedIP$ all", DottedIP$($C0A80164), "192.168.1.100"

; The addresses of a computer.
count = CountHostIPs("localhost")
CheckTrue "CountHostIPs", count >= 1
ip = HostIP(1)
CheckTrue "HostIP", ip <> 0
CheckS "HostIP is an address", Left$(DottedIP$(ip), 3), "127"

; TCP: a server, a client that connects, and the stream that the server accepts.
TCPTimeouts 1000, 1000
port = 40731
server = CreateTCPServer(port)
CheckTrue "CreateTCPServer", server <> 0
client = OpenTCPStream("127.0.0.1", port)
CheckTrue "OpenTCPStream", client <> 0
accepted = 0
For i = 1 To 50
	accepted = AcceptTCPStream(server)
	If accepted <> 0 Then Exit
	Delay 20
Next
CheckTrue "AcceptTCPStream", accepted <> 0
Check "TCPStreamPort of the client", TCPStreamPort(client), port
CheckS "TCPStreamIP of the client", DottedIP$(TCPStreamIP(client)), "127.0.0.1"
CheckS "TCPStreamIP of the accepted stream", DottedIP$(TCPStreamIP(accepted)), "127.0.0.1"

; What one side writes, the other side reads.
WriteInt client, 987654
WriteString client, "hello server"
WriteLine client, "a line"
WriteByte client, 7
WriteFloat client, 2.5
waited = 0
While ReadAvail(accepted) < 4 + 4 + 12 + 8 + 1 + 4 And waited < 100
	Delay 10
	waited = waited + 1
Wend
Check "ReadInt over TCP", ReadInt(accepted), 987654
CheckS "ReadString$ over TCP", ReadString$(accepted), "hello server"
CheckS "ReadLine$ over TCP", ReadLine$(accepted), "a line"
Check "ReadByte over TCP", ReadByte(accepted), 7
Check "ReadFloat over TCP", ReadFloat(accepted), 2.5
Check "Nothing is left", ReadAvail(accepted), 0

; And back.
WriteInt accepted, 55
waited = 0
While ReadAvail(client) < 4 And waited < 100
	Delay 10
	waited = waited + 1
Wend
Check "ReadInt the other way", ReadInt(client), 55

; A stream that is closed ends for the other side.
CloseTCPStream client
CloseTCPStream accepted
CloseTCPServer server

; Nothing listens on that port now.
failed = OpenTCPStream("127.0.0.1", port)
Check "OpenTCPStream without a server", failed, 0

; UDP: messages are kept together, and say where they came from.
udp_a = CreateUDPStream(40732)
udp_b = CreateUDPStream(40733)
CheckTrue "CreateUDPStream", udp_a <> 0
Check "UDPStreamPort", UDPStreamPort(udp_a), 40732
Check "UDPStreamPort other", UDPStreamPort(udp_b), 40733
any = CreateUDPStream()
CheckTrue "CreateUDPStream without a port", UDPStreamPort(any) > 0
CloseUDPStream any

Check "RecvUDPMsg without a message", RecvUDPMsg(udp_b), 0
WriteInt udp_a, 4242
WriteString udp_a, "datagram"
SendUDPMsg udp_a, $7F000001, 40733
size = 0
For i = 1 To 50
	size = RecvUDPMsg(udp_b)
	If size <> 0 Then Exit
	Delay 10
Next
CheckTrue "RecvUDPMsg", size > 0
CheckS "UDPMsgIP", DottedIP$(UDPMsgIP(udp_b)), "127.0.0.1"
Check "UDPMsgPort", UDPMsgPort(udp_b), 40732
Check "UDP int", ReadInt(udp_b), 4242
CheckS "UDP string", ReadString$(udp_b), "datagram"

; Replies go back to where the message came from.
WriteInt udp_b, 77
SendUDPMsg udp_b, UDPMsgIP(udp_b), UDPMsgPort(udp_b)
size = 0
For i = 1 To 50
	size = RecvUDPMsg(udp_a)
	If size <> 0 Then Exit
	Delay 10
Next
CheckTrue "UDP reply", size > 0
Check "UDP reply content", ReadInt(udp_a), 77
CloseUDPStream udp_a
CloseUDPStream udp_b

Done "network"
