; A function that gives back an object it deleted gives back Null, and nothing is leaked or read after it was freed.
Type MyType
	Field a
End Type

Global failures = 0

Function Check(name$, ok)
	If Not ok Then
		failures = failures + 1
		Print "FAIL: " + name$
	EndIf
End Function

Function Make.MyType()
	Local a.MyType = New MyType
	Local b.MyType = a
	Delete a
	Return b
End Function

Function Keep.MyType()
	Local a.MyType = New MyType
	a\a = 7
	Return a
End Function

Local c.MyType = Make()
Check("deleted object comes back as Null", c = Null)
Make()
Local k.MyType = Keep()
Check("live object comes back", (k <> Null) And (k\a = 7))
Local i
For i = 1 To 1000
	Make()
Next
If failures = 0 Then Print "ok"
