; Entities: CreatePivot FreeEntity CopyEntity NameEntity EntityName$ EntityParent FindChild PositionEntity MoveEntity
; TranslateEntity RotateEntity TurnEntity ScaleEntity EntityX EntityY EntityZ EntityPitch EntityYaw EntityRoll
; EntityDistance DeltaPitch DeltaYaw PointEntity TFormPoint TFormVector TFormNormal TFormedX TFormedY TFormedZ
; HideEntity ShowEntity EntityOrder EntityAlpha EntityColor EntityShininess EntityBlend EntityFX EntityAutoFade
; EntityTexture PaintEntity.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; New entities are at the origin, facing forward.
pivot = CreatePivot()
CheckTrue "CreatePivot", pivot <> 0
Check "x", EntityX(pivot), 0
Check "y", EntityY(pivot), 0
Check "z", EntityZ(pivot), 0
Check "pitch", EntityPitch(pivot), 0
Check "yaw", EntityYaw(pivot), 0
Check "roll", EntityRoll(pivot), 0

; Positions, local and global.
PositionEntity pivot, 1, 2, 3
Check "PositionEntity x", EntityX(pivot), 1
Check "PositionEntity y", EntityY(pivot), 2
Check "PositionEntity z", EntityZ(pivot), 3
TranslateEntity pivot, 1, 1, 1
Check "TranslateEntity", EntityX(pivot), 2
Check "TranslateEntity y", EntityY(pivot), 3
Check "TranslateEntity z", EntityZ(pivot), 4
MoveEntity pivot, 0, 0, 2
Check "MoveEntity forward", EntityZ(pivot), 6
MoveEntity pivot, 1, 0, 0
Check "MoveEntity right", EntityX(pivot), 3
MoveEntity pivot, 0, -1, 0
Check "MoveEntity down", EntityY(pivot), 2

; Rotating: a positive yaw turns to the left, a positive pitch looks down, and a positive roll tilts to the left.
RotateEntity pivot, 10, 20, 30
Check "RotateEntity pitch", EntityPitch(pivot), 10, 0.001
Check "RotateEntity yaw", EntityYaw(pivot), 20, 0.001
Check "RotateEntity roll", EntityRoll(pivot), 30, 0.001
TurnEntity pivot, 5, 5, 5
Check "TurnEntity pitch", EntityPitch(pivot), 15, 0.01
Check "TurnEntity yaw", EntityYaw(pivot), 25, 0.01
Check "TurnEntity roll", EntityRoll(pivot), 35, 0.01

turner = CreatePivot()
RotateEntity turner, 0, 90, 0
TFormVector 0, 0, 1, turner, 0
Check "Yaw 90 faces left x", TFormedX(), -1, 0.001
Check "Yaw 90 faces left z", TFormedZ(), 0, 0.001
RotateEntity turner, 90, 0, 0
TFormVector 0, 0, 1, turner, 0
Check "Pitch 90 looks down", TFormedY(), -1, 0.001
RotateEntity turner, 0, 0, 90
TFormVector 0, 1, 0, turner, 0
Check "Roll 90 tilts left", TFormedX(), -1, 0.001
RotateEntity turner, 0, 0, 0

; Entities turn around their own axes, so moving goes where they face.
mover = CreatePivot()
RotateEntity mover, 0, 90, 0
MoveEntity mover, 0, 0, 5
Check "MoveEntity follows yaw x", EntityX(mover), -5, 0.001
Check "MoveEntity follows yaw z", EntityZ(mover), 0, 0.001

; Scale changes sizes of what is below and not the entity itself.
scaler = CreatePivot()
ScaleEntity scaler, 2, 3, 4
child = CreatePivot(scaler)
PositionEntity child, 1, 1, 1
Check "Local position under a scale", EntityX(child), 1
Check "Global position under a scale x", EntityX(child, True), 2
Check "Global position under a scale y", EntityY(child, True), 3
Check "Global position under a scale z", EntityZ(child, True), 4

; Parents: moving them moves what is below.
parent = CreatePivot()
PositionEntity parent, 10, 0, 0
kid = CreatePivot(parent)
PositionEntity kid, 1, 2, 3
Check "Child global x", EntityX(kid, True), 11
Check "Child local x", EntityX(kid), 1
PositionEntity kid, 20, 0, 0, True
Check "Global PositionEntity", EntityX(kid, True), 20
Check "Global PositionEntity is local to the parent", EntityX(kid), 10
RotateEntity parent, 0, 90, 0
Check "Child yaw follows its parent", EntityYaw(kid, True), 90, 0.01
Check "Child local yaw is its own", EntityYaw(kid), 0, 0.01
EntityParent kid, 0
Check "EntityParent to nothing keeps the place", EntityX(kid, True), EntityX(kid, True)
EntityParent kid, parent
EntityParent kid, 0, False
Check "EntityParent without keeping the place", EntityX(kid, True), EntityX(kid)

; Names and finding things by them.
root = CreatePivot()
NameEntity root, "Root"
CheckS "EntityName$", EntityName$(root), "Root"
CheckS "EntityName$ without a name", EntityName$(CreatePivot()), ""
arm = CreatePivot(root)
NameEntity arm, "Arm"
hand = CreatePivot(arm)
NameEntity hand, "Hand"
Check "FindChild", FindChild(root, "Arm"), arm
Check "FindChild deeper", FindChild(root, "Hand"), hand
Check "FindChild missing", FindChild(root, "Foot"), 0
Check "FindChild is not about itself", FindChild(root, "Root"), 0

; Distance and angles to others.
a = CreatePivot()
b = CreatePivot()
PositionEntity b, 3, 4, 0
Check "EntityDistance", EntityDistance(a, b), 5, 0.001
Check "EntityDistance is the same both ways", EntityDistance(b, a), 5, 0.001
Check "EntityDistance to itself", EntityDistance(a, a), 0
Check "DeltaYaw to the right", DeltaYaw(a, b), -90, 0.01
Check "DeltaPitch to something above", DeltaPitch(a, b), -53.1301, 0.01
PositionEntity b, 0, 0, 10
Check "DeltaYaw when facing it", DeltaYaw(a, b), 0, 0.001
Check "DeltaPitch when facing it", DeltaPitch(a, b), 0, 0.001
PositionEntity b, 10, 0, 0
PointEntity a, b
Check "PointEntity yaw", EntityYaw(a), -90, 0.01
Check "PointEntity pitch", EntityPitch(a), 0, 0.01
Check "DeltaYaw after pointing", DeltaYaw(a, b), 0, 0.01
PositionEntity b, 0, -10, 0.0001
PointEntity a, b
Check "PointEntity looks down", EntityPitch(a), 90, 0.1

; Points and directions between the spaces of entities.
world = CreatePivot()
place = CreatePivot()
PositionEntity place, 10, 0, 0
TFormPoint 1, 2, 3, place, 0
Check "TFormPoint to world x", TFormedX(), 11
Check "TFormPoint to world y", TFormedY(), 2
Check "TFormPoint to world z", TFormedZ(), 3
TFormPoint 11, 2, 3, 0, place
Check "TFormPoint to local x", TFormedX(), 1
RotateEntity place, 0, 90, 0
TFormPoint 0, 0, 5, place, 0
Check "TFormPoint with a turn x", TFormedX(), 5, 0.001
Check "TFormPoint with a turn z", TFormedZ(), 0, 0.001
TFormVector 0, 0, 1, place, 0
Check "TFormVector ignores the position", TFormedX(), -1, 0.001
TFormVector 0, 0, 1, 0, place
Check "TFormVector the other way", TFormedX(), 1, 0.001
ScaleEntity place, 2, 2, 2
TFormVector 1, 0, 0, place, 0
Check "TFormVector scales", Sqr(TFormedX() * TFormedX() + TFormedY() * TFormedY() + TFormedZ() * TFormedZ()), 2, 0.001
TFormNormal 1, 0, 0, place, 0
Check "TFormNormal keeps the length", Sqr(TFormedX() * TFormedX() + TFormedY() * TFormedY() + TFormedZ() * TFormedZ()), 1, 0.001
TFormPoint 1, 1, 1, place, place
Check "TFormPoint from an entity to the same one", TFormedX(), 1, 0.001
Check "TFormPoint between the same y", TFormedY(), 1, 0.001

; Meshes are what the rest is about.
cube = CreateCube()
HideEntity cube
ShowEntity cube
suite_checks = suite_checks + 2
EntityOrder cube, -1
EntityOrder cube, 0
EntityAlpha cube, 0.5
EntityColor cube, 255, 0, 0
EntityShininess cube, 0.5
EntityBlend cube, 3
EntityBlend cube, 1
EntityFX cube, 1 + 16
EntityAutoFade cube, 10, 20
suite_checks = suite_checks + 9

; Paint
brush = CreateBrush(255, 128, 0)
PaintEntity cube, brush
FreeBrush brush
texture = CreateTexture(4, 4)
EntityTexture cube, texture
EntityTexture cube, texture, 0, 0
FreeTexture texture
suite_checks = suite_checks + 4

; Copies are new entities with the same things, that go on independently.
original = CreateCube()
PositionEntity original, 1, 2, 3
NameEntity original, "Original"
copy = CopyEntity(original)
CheckTrue "CopyEntity", copy <> original
Check "CopyEntity position x", EntityX(copy), 1
Check "CopyEntity position z", EntityZ(copy), 3
CheckS "CopyEntity copies the name", EntityName$(copy), "Original"
PositionEntity copy, 5, 5, 5
Check "Copies are independent", EntityX(original), 1
copyparent = CreatePivot()
PositionEntity copyparent, 100, 0, 0
copy2 = CopyEntity(original, copyparent)
Check "CopyEntity with a parent", EntityX(copy2, True), 101
treeroot = CreatePivot()
treechild = CreatePivot(treeroot)
NameEntity treechild, "Leaf"
treecopy = CopyEntity(treeroot)
CheckTrue "CopyEntity copies what is below", FindChild(treecopy, "Leaf") <> 0
CheckTrue "CopyEntity copies what is below as new entities", FindChild(treecopy, "Leaf") <> treechild

; Freed entities are gone with what is below them.
FreeEntity copy
FreeEntity copy2
FreeEntity treecopy
FreeEntity cube
FreeEntity pivot
suite_checks = suite_checks + 5

EndGraphics
Done "blitz3d_entities"
