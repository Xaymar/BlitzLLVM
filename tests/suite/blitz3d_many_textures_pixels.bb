; More textures than the first pool of texture bindings of the Vulkan renderer holds (8193): every texture needs a binding group,
; and once the first pool is full more pools are added, so any number of textures works. Before, the 8194th texture stopped the
; program with "vkAllocateDescriptorSets (too many textures?) failed". Textures of a pool that was added are freed and made again
; (their room is used again), and each one still shows its own color when it is drawn. Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_many_textures_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global camera = CreateCamera()
PositionEntity camera, 0, 0, -6
CameraClsColor camera, 0, 0, 0
AmbientLight 255, 255, 255

Const COUNT = 10500
Dim tex(COUNT - 1)

; A texture of one color: red, green and blue from the number, so that every texture can be told from its neighbours. Only the
; textures that are checked are drawn on (drawing on ten thousand textures takes minutes with a software renderer).
Function MakeTexture(i)
	t = CreateTexture(4, 4)
	If Not Checked(i) Then Return t
	SetBuffer TextureBuffer(t)
	Color (i * 37) And 255, (i * 91) And 255, 200
	Rect 0, 0, 4, 4, True
	SetBuffer BackBuffer()
	Return t
End Function

; The color that a cube with texture i shows in the middle of the picture.
Function ShowTexture(i)
	q = CreateCube()
	EntityFX q, 1
	EntityTexture q, tex(i)
	RenderWorld
	FreeEntity q
	Return ReadPixel(80, 60, BackBuffer()) And $FFFFFF
End Function

Function Checked(i)
	Select i
	Case 0, 5050, 8100, 8192, 8193, 9500, COUNT - 1
		Return True
	End Select
	Return False
End Function

Function Expected(i)
	Return (((i * 37) And 255) Shl 16) Or (((i * 91) And 255) Shl 8) Or 200
End Function

Function CheckTexture(what$, i)
	c = ShowTexture(i)
	Check what$ + " " + i + ": red", (c Shr 16) And 255, (Expected(i) Shr 16) And 255, 8
	Check what$ + " " + i + ": green", (c Shr 8) And 255, (Expected(i) Shr 8) And 255, 8
	Check what$ + " " + i + ": blue", c And 255, 200, 8
End Function

For i = 0 To COUNT - 1
	tex(i) = MakeTexture(i)
Next
CheckTexture "Texture of the first pool", 0
CheckTexture "Last texture of the first pool", 8192
CheckTexture "First texture past the first pool", 8193
CheckTexture "Texture of a third pool", COUNT - 1

; Free textures of the first and of the added pools, and make them again: the freed room is used again.
For i = 8000 To 9999
	FreeTexture tex(i)
Next
For i = 8000 To 9999
	tex(i) = MakeTexture(i)
Next
CheckTexture "Made again in the first pool", 8100
CheckTexture "Made again in an added pool", 9500

; Many textured cubes in one RenderWorld, as in the microbenchmark render/renderworld-10000-cubes-textured. Cube 5050 is in the
; middle of the picture.
side = 100
Dim cube(COUNT - 1)
For i = 0 To COUNT - 1
	cube(i) = CreateCube()
	c = cube(i)
	EntityFX c, 1
	ScaleEntity c, 0.04, 0.04, 0.04
	PositionEntity c, ((i Mod side) - side / 2) * 0.1, ((i / side) - side / 2) * 0.1, 0
	EntityTexture c, tex(i)
Next
RenderWorld
CheckTrue "Ten thousand textured cubes draw", (ReadPixel(80, 60, BackBuffer()) And 255) > 150

; The cubes go first: a texture that is freed while entities still use it is looked for in all of them on every FreeTexture.
For i = 0 To COUNT - 1
	FreeEntity cube(i)
	FreeTexture tex(i)
Next
Done "blitz3d_many_textures_pixels"
End
