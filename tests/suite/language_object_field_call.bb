; A field is assigned the result of a function of the program: the value is worked out first, so the function can't free the object whose
; field is stored to. The result is the same as before for objects that stay.
Type Child
	Field name$
	Field number
End Type
Type Parent
	Field child.Child
End Type

Global root.Parent = New Parent
Global failures = 0

Function Check(name$, ok)
	If Not ok Then
		failures = failures + 1
		Print "FAIL: " + name$
	EndIf
End Function

Function Text$(n)
	root\child\number = n * 2 ; Changes the same object.
	Return "text" + n
End Function

Function Number(n)
	Return n + 1
End Function

root\child = New Child
root\child\name = Text(5)
root\child\number = Number(root\child\number)
Check("string field", root\child\name = "text5")
Check("number field", root\child\number = 11)

; The object a function creates is stored in the field and kept.
Function Make.Child()
	Local c.Child = New Child
	c\name = "made"
	Return c
End Function
root\child = Make()
Check("object field", root\child\name = "made")

If failures = 0 Then Print "ok"
