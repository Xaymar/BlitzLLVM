; Animated pictures: LoadAnimTexture and LoadAnimImage with no frame size, TextureFrames TextureFrameDelay ImageFrames
; ImageFrameDelay. images/anim.* are four frames of 16 by 8 pixels (red, green, blue, yellow) lasting 50, 100, 10 and 200 ms.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Dim files$(2)
files$(0) = "images/anim.gif"
files$(1) = "images/anim.webp"
files$(2) = "images/anim.avif"

For i = 0 To 2
	name$ = files$(i)
	tex = LoadAnimTexture(name$, 1, 0, 0, 0, 0)
	CheckTrue name$ + " loads as an animated texture", tex <> 0
	Check name$ + " has all frames", TextureFrames(tex), 4
	Check name$ + " texture width is one frame", TextureWidth(tex), 16
	Check name$ + " texture height is one frame", TextureHeight(tex), 8
	If i < 2 Then
		Check name$ + " delay 0", TextureFrameDelay(tex, 0), 50
		Check name$ + " delay 1", TextureFrameDelay(tex, 1), 100
		Check name$ + " delay 3", TextureFrameDelay(tex, 3), 200
	EndIf
	CheckTrue name$ + " delay of a frame is above 0", TextureFrameDelay(tex, 2) > 0
	Check name$ + " has no delay for a missing frame", TextureFrameDelay(tex, 4), 0
	Check name$ + " has no delay for a negative frame", TextureFrameDelay(tex, -1), 0
	FreeTexture tex

	; A range of frames.
	part = LoadAnimTexture(name$, 1, 0, 0, 1, 2)
	Check name$ + " range has two frames", TextureFrames(part), 2
	If i < 2 Then Check name$ + " range starts at frame 1", TextureFrameDelay(part, 0), 100
	FreeTexture part
	Check name$ + " range past the end fails", LoadAnimTexture(name$, 1, 0, 0, 3, 2), 0

	img = LoadAnimImage(name$, 0, 0, 0, 0)
	CheckTrue name$ + " loads as an animated image", img <> 0
	Check name$ + " image has all frames", ImageFrames(img), 4
	Check name$ + " image width is one frame", ImageWidth(img), 16
	Check name$ + " image height is one frame", ImageHeight(img), 8
	If i < 2 Then Check name$ + " image delay 3", ImageFrameDelay(img, 3), 200
	Check name$ + " image has no delay for a missing frame", ImageFrameDelay(img, 4), 0
	FreeImage img
Next

; Plain pictures have one frame and no delay.
plain = LoadTexture("../checker.png")
Check "A plain texture has one frame", TextureFrames(plain), 1
Check "A plain texture has no delay", TextureFrameDelay(plain, 0), 0
FreeTexture plain
plain_image = LoadImage("../checker.png")
Check "A plain image has one frame", ImageFrames(plain_image), 1
Check "A plain image has no delay", ImageFrameDelay(plain_image, 0), 0

; An explicit frame size still means a sheet.
sheet = LoadAnimTexture("../checker.png", 1, 16, 16, 0, 4)
Check "A sheet keeps its frames", TextureFrames(sheet), 4
Check "A sheet has no delay", TextureFrameDelay(sheet, 0), 0

EndGraphics
Done "blitz3d_animated_pictures"
