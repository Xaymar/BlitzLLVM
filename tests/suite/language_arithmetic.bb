; The type of an operation, checked against the original compiler (exprnode.cpp, parser.cpp and stmtnode.cpp of blitz3d):
; mixing Int and Float gives a Float, two Ints give an Int, a String on either side of + makes a String, and a condition
; or the operand of And, Or, Xor, Shl, Shr and Sar is an Int. Everything that becomes an Int is rounded to the nearest
; whole number, and halves go to the even one. The results are compared as text, so that the type shows too.
Include "check.bb"

a = 7
b = 2
f# = 2.5
z = 0
CheckS "7+2.5", Str(a + f), "9.5"
CheckS "2.5+7", Str(f + a), "9.5"
CheckS "7-2.5", Str(a - f), "4.5"
CheckS "2.5-7", Str(f - a), "-4.5"
CheckS "7*2.5", Str(a * f), "17.5"
CheckS "7/2", Str(a / b), "3"
CheckS "7/2.0", Str(a / 2.0), "3.5"
CheckS "7/2.5", Str(a / f), "2.8"
CheckS "7 mod 2.5", Str(a Mod f), "2.0"
CheckS "7.5 mod 2", Str(7.5 Mod b), "1.5"
CheckS "-7 mod 2", Str(-a Mod b), "-1"
CheckS "7 mod -2", Str(a Mod -b), "1"
CheckS "-7/2", Str(-a / b), "-3"
CheckS "2^3", Str(b ^ 3), "8.0"
CheckS "2^-1", Str(b ^ -1), "0.5"
CheckS "2^3^2", Str(b ^ 3 ^ 2), "64.0"
CheckS "-2^2", Str(-b ^ 2), "4.0"
big = 2147483647
CheckS "max+1", Str(big + 1), "-2147483648"
CheckS "min-1", Str((-big - 1) - 1), "2147483647"
CheckS "65536*65536", Str(65536 * 65536 * z + 65536 * 65536), "0"
CheckS "big*2", Str(big * 2), "-2"
i = 7 / 2.0
CheckS "i=7/2.0", Str(i), "4"
i = f
CheckS "i=2.5", Str(i), "2"
i = 3.5
CheckS "i=3.5", Str(i), "4"
i = -f
CheckS "i=-2.5", Str(i), "-2"
i = f + 1
CheckS "i=3.5b", Str(i), "4"
i = 0.5
CheckS "i=0.5", Str(i), "0"
i = 1.5
CheckS "i=1.5", Str(i), "2"
CheckS "1=1.0", Str(1 = 1.0), "1"
CheckS "3<3.5", Str(3 < 3.5), "1"
CheckS "a<>7.0", Str(a <> 7.0), "0"
CheckS "10<9 str", Str("10" < "9"), "1"
CheckS "10<'9'", Str(10 < "9"), "1"
CheckS "'2.0'=2", Str("2.0" = 2), "0"
CheckS "9>=10.5", Str(9 >= 10.5), "0"
CheckFalse "If 0.4", 0.4
CheckFalse "If 0.5", 0.5
CheckTrue "If 0.6", 0.6
CheckTrue "If -0.6", -0.6
g# = 0.4
CheckFalse "If g", g
While g
	RuntimeError "While g: a 0.4 condition was true"
Wend
CheckS "not 0.4", Str(Not 0.4), "0"
CheckS "not 0.0", Str(Not 0.0), "1"
CheckS "not 5", Str(Not 5), "0"
CheckS "6.5 and 3", Str(6.5 And 3), "2"
CheckS "5.5 or 0", Str(5.5 Or 0), "6"
CheckS "'3' or 4", Str("3" Or 4), "7"
CheckS "1 shl 31", Str(1 Shl 31), "-2147483648"
sh = 32
CheckS "1 shl 32", Str(1 Shl sh), "1"
sh = 33
CheckS "1 shl 33", Str(1 Shl sh), "2"
CheckS "-1 shr 28", Str(-1 Shr 28), "15"
sh = 36
CheckS "256 shr 36", Str(256 Shr sh), "16"
CheckS "-16 sar 2", Str(-16 Sar 2), "-4"
CheckS "-16 sar 40", Str(-16 Sar 40), "-1"
CheckS "1+2 shl 3", Str(1 + 2 Shl 3), "17"
CheckS "2*3 shl 1", Str(2 * 3 Shl 1), "12"
CheckS "1 shl 2+1", Str(1 Shl 2 + 1), "5"
CheckS "1 shl 1 = 2", Str(1 Shl 1 = 2), "1"
CheckS "1 or 2 and 2", Str(1 Or 2 And 2), "2"
CheckS "not 1 and 0", Str(Not 1 And 0), "1"
CheckS "6 xor 3 and 1", Str(6 Xor 3 And 1), "1"
CheckS "10-2-3", Str(10 - 2 - 3), "5"
CheckS "100/10/5", Str(100 / 10 / 5), "2"
CheckS "2*3 mod 4", Str(2 * 3 Mod 4), "2"
CheckS "7 mod 4*2", Str(7 Mod 4 * 2), "6"
CheckS "$FFFFFFFF", Str($FFFFFFFF), "-1"
CheckS "$FFFFFFFF>0", Str($FFFFFFFF > 0), "0"
CheckS "$80000000/2", Str($80000000 / 2), "-1073741824"
CheckS "$FFFFFFFF+0.5", Str($FFFFFFFF + 0.5), "-0.5"
CheckS "$1FFFFFFFF", Str($1FFFFFFFF), "-1"
CheckS "%11111111111111111111111111111111", Str(%11111111111111111111111111111111), "-1"
CheckS "~5", Str(~5), "-6"
Const c1 = 7 / 2
Const c2# = 7 / 2
Const c3 = 2.5
Const c4# = 7 / 2.0
Const c5$ = 5
Const c6 = 2 ^ 3
CheckS "const 7/2", Str(c1), "3"
CheckS "const# 7/2", Str(c2), "3.0"
CheckS "const int 2.5", Str(c3), "2"
CheckS "const# 7/2.0", Str(c4), "3.5"
CheckS "const$ 5", c5, "5"
CheckS "const 2^3", Str(c6), "8"
n = 0
For k = 1 To 2.5
	n = n + 1
Next
CheckS "For To 2.5 runs twice", Str(n), "2"
s# = 0
For kf# = 1 To 2
	s = s + kf
Next
CheckS "For with a float", Str(s), "3.0"
si = 0
For k = 1 To 5 Step 2
	si = si + k
Next
CheckS "For Step 2", Str(si), "9"
CheckS "abs -2.5", Str(Abs(-f)), "2.5"
CheckS "sgn -2.5", Str(Sgn(-f)), "-1.0"
CheckS "abs int", Str(Abs(-a)), "7"
CheckS "str concat", "x" + 1 + 2.5, "x12.5"
CheckS "1+2+'3'", Str(1 + 2 + "3"), "33"
CheckS "'3'+1+2", Str("3" + 1 + 2), "312"
CheckS "'2.5'+1", Str("2.5" + 1), "2.51"
r = 0
Select 2.5
	Case 2
		r = 1
	Case 2.5
		r = 2
End Select
CheckS "Select 2.5 keeps the fraction", Str(r), "2"
r = 0
Select 2
	Case 2.4
		r = 1
End Select
CheckS "Select 2 turns Case 2.4 into 2", Str(r), "1"
Dim arr(3)
arr(1.5) = 9
CheckS "Array index 1.5 is 2", Str(arr(2)), "9"
CheckS "pi", Str(Pi), "3.14159"
CheckS "true+1", Str(True + 1), "2"


Done "language_arithmetic"
