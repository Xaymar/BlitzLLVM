; Draw3D2 shapes against the original Blitz3D: Rect3D Oval3D Line3D Plot3D Poly3D with ColorN3D (solid and alpha). Needs a window and a GPU. See draw3d2_common.bb for the metric.
If GetEnv$("BLITZ_HEADLESS") <> "" And GetEnv$("D3D2_CAPTURE") = "" Then
	Print "draw3d2_shapes_pixels: skipped, there is no window."
	End
EndIf
Include "check.bb"
Include "../draw3d2/draw3d2_common.bb"

D3DSetup
Clear3D

; Filled and hollow rectangles (y is up, 0,0 the middle).
ColorN3D 255, 0, 0
Rect3D d3d_white, -140, 100, 60, 40, 1
ColorN3D 0, 255, 0
Rect3D d3d_white, -60, 100, 60, 40, 0, 4
ColorN3D 0, 128, 255, 0.5
Rect3D d3d_white, -20, 80, 60, 40, 1

; Ovals, filled and hollow, round and flat.
ColorN3D 255, 255, 0
Oval3D d3d_white, 90, 70, 30, 30, 1
ColorN3D 255, 0, 255
Oval3D d3d_white, 90, 70, 45, 45, 0, 3
ColorN3D 0, 255, 255
Oval3D d3d_white, -90, 0, 50, 20, 1

; Lines of different widths and directions.
ColorN3D 255, 255, 255
Line3D d3d_white, -150, -20, -30, -20, 2
Line3D d3d_white, -150, -30, -30, -60, 4
Line3D d3d_white, -20, -20, 40, -80, 1
ColorN3D 255, 128, 0
Line3D d3d_white, 0, 0, 0, -100, 6

; Points and a triangle.
ColorN3D 255, 255, 255
Plot3D d3d_white, 60, -20, 1
Plot3D d3d_white, 70, -20, 2
Plot3D d3d_white, 85, -20, 4
ColorN3D 128, 255, 128
Poly3D d3d_white, 80, -40, 150, -40, 110, -100

D3DFinish "draw3d2_shapes"
Done "draw3d2_shapes_pixels"
