; Collisions with meshes that have enough triangles for the physics library to tell which are near the mover (the same result with
; BLITZLLVM_COLLISION_BACKEND=legacy): a mover lands on a field, slides on it, hits a moved, scaled and changed one, and a hidden one is
; not hit: CreateMesh CreateSurface AddVertex AddTriangle EntityType EntityRadius Collisions UpdateWorld CountCollisions CollisionY
; CollisionNY CollisionSurface CollisionTriangle EntityCollided PositionEntity ScaleEntity HideEntity ShowEntity VertexCoords.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; A flat field of 40 by 40 squares at y = 0, x and z from -20 to 20.
Local grid = 40
Global ground = CreateMesh()
Global surf = CreateSurface(ground)
Local x, z, i
For z = 0 To grid
	For x = 0 To grid
		AddVertex surf, x - 20, 0, z - 20
	Next
Next
For z = 0 To grid - 1
	For x = 0 To grid - 1
		i = z * (grid + 1) + x
		AddTriangle surf, i, i + grid + 1, i + 1
		AddTriangle surf, i + 1, i + grid + 1, i + grid + 2
	Next
Next
UpdateNormals ground
EntityType ground, 2

Global ball = CreateSphere(8)
EntityType ball, 1
EntityRadius ball, 1
Collisions 1, 2, 2, 2

Function Drop(height#, ax#, az#)
	PositionEntity ball, ax, height, az
	UpdateWorld
	TranslateEntity ball, 0, -(height + 5), 0
	UpdateWorld
End Function

; The mover lands on the field: its center is a radius above it.
Drop 3, 2.3, 4.7
Check "Landed on the field", EntityY(ball), 1, 0.01
Check "Stayed above the spot", EntityX(ball), 2.3, 0.01
CheckTrue "It collided", CountCollisions(ball) > 0
Check "Pushed up", CollisionNY(ball, 1), 1, 0.01
Check "Of the field", EntityCollided(ball, 2), ground
Check "Of its surface", CollisionSurface(ball, 1), surf
CheckTrue "Of a triangle of it", CollisionTriangle(ball, 1) >= 0 And CollisionTriangle(ball, 1) < grid * grid * 2

; The field moved up.
PositionEntity ground, 0, 6, 0
UpdateWorld
Drop 12, -7.5, -3.2
Check "Landed on the moved field", EntityY(ball), 7, 0.01

; Scaled: a field twice as wide and half as high.
PositionEntity ground, 0, 0, 0
ScaleEntity ground, 2, 0.5, 2
UpdateWorld
Drop 3, 30, 30
Check "Over the scaled field", EntityY(ball), 1, 0.01
CheckTrue "Collided with it", CountCollisions(ball) > 0
Drop 3, 41, 41
Check "Past its end", EntityY(ball), -5, 0.01
ScaleEntity ground, 1, 1, 1

; A hill that was made after it was used: the vertex under the mover is raised.
VertexCoords surf, 20 * (grid + 1) + 20, 0, 4, 0
Drop 8, 0.05, 0.05
CheckTrue "Landed on the hill", EntityY(ball) > 1.2

; Hidden fields are not hit.
HideEntity ground
Drop 3, 2.3, 4.7
Check "Fell through the hidden field", EntityY(ball), -5, 0.01
ShowEntity ground
Drop 3, 2.3, 4.7
Check "Landed on the shown field", EntityY(ball), 1, 0.01

Done "collision large meshes"
