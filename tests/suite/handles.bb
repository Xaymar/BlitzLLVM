; Handle and Object.TypeName: converting objects to integer handles and back, with and without parenthesis.
Include "check.bb"

Type GrdChunk
	Field x
End Type

Type my_Mixed_type
	Field name$
End Type

Function Chunk_Of.GrdChunk(h)
	Return Object.GrdChunk h
End Function

Function Twice(a, b)
	Return a + b
End Function

Local c.GrdChunk = New GrdChunk
c\x = 42
Local h = Handle c
CheckTrue "Handle gives a number", h <> 0

; The reported form: assignment without parenthesis.
Local d.GrdChunk
d = Object.GrdChunk h
CheckTrue "Object.Type h", d = c
c = Object.GrdChunk h
Check "Object.Type h keeps the object", c\x, 42

; With parenthesis, and with a field access on the result.
d = Object.GrdChunk(h)
CheckTrue "Object.Type(h)", d = c
Check "Object.Type(h)\field", Object.GrdChunk(h)\x, 42

; In a declaration, an argument, a return value and a condition.
Local e.GrdChunk = Object.GrdChunk h
CheckTrue "Local = Object.Type h", e = c
CheckTrue "Return Object.Type h", Chunk_Of(h) = c
Check "Argument", Twice(Object.GrdChunk(h)\x, 1), 43
If Object.GrdChunk h = c Then Check "If", 1, 1 Else Check "If", 0, 1

; Handle without parenthesis, and as a part of an expression.
Check "Handle obj", Handle c, h
Check "Handle obj + 1", (Handle c) + 1, h + 1
Check "Round trip", Handle Object.GrdChunk Handle c, h
Local handle = 7
Check "Handle as a variable", handle + 1, 8

; Mixed case and underscores in type names.
Local m.my_Mixed_type = New my_Mixed_type
m\name = "mixed"
Local mh = Handle m
CheckS "Mixed case type", (Object.my_mixed_TYPE mh)\name, "mixed"
Local m2.my_Mixed_type = Object.My_Mixed_Type(mh)
CheckTrue "Underscore type", m2 = m

; Null and invalid handles give Null, and a deleted object no longer has a handle.
CheckTrue "Handle(Null)", Handle(Null) = 0
CheckTrue "Object of 0", (Object.GrdChunk 0) = Null
CheckTrue "Object of unknown handle", (Object.GrdChunk 123456789) = Null
Delete c
CheckTrue "Object of deleted handle", (Object.GrdChunk h) = Null

Done "handles"
