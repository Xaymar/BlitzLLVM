; Sphere maps (texture flag 64) and cube maps (flag 128), which need a window and a GPU, so this is skipped without
; one. A sphere map takes its coordinates from the normal in the view, so the left and right of a ball show different
; halves of the picture. A cube map shows the face that the reflection, the normal or the position points to.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_envmaps_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 10, 20, 30
ball = CreateSphere(24)
EntityFX ball, 1

; A sphere map: red on the left half of the picture and green on the right half.
halves = CreateTexture(4, 4, 1 + 64)
SetBuffer TextureBuffer(halves)
Color 255, 0, 0
Rect 0, 0, 2, 4, True
Color 0, 255, 0
Rect 2, 0, 2, 4, True
SetBuffer BackBuffer()
EntityTexture ball, halves
RenderWorld
Check "A sphere map, left side is red", R(72, 60), 255, 20
Check "A sphere map, left side is not green", G(72, 60), 0, 20
Check "A sphere map, right side is green", G(88, 60), 255, 20
Check "A sphere map, right side is not red", R(88, 60), 0, 20
EntityTexture ball, 0
FreeTexture halves

; A cube map with a color on every face: -X red, +Z green, +X blue, -Z yellow, +Y cyan, -Y magenta.
cube = CreateTexture(16, 16, 1 + 128)
For face = 0 To 5
	SetCubeFace cube, face
	SetBuffer TextureBuffer(cube)
	Select face
		Case 0 : Color 255, 0, 0
		Case 1 : Color 0, 255, 0
		Case 2 : Color 0, 0, 255
		Case 3 : Color 255, 255, 0
		Case 4 : Color 0, 255, 255
		Case 5 : Color 255, 0, 255
	End Select
	Rect 0, 0, 16, 16, True
Next
SetBuffer BackBuffer()
CheckTrue "A cube map has the size of a face", (TextureWidth(cube) = 16) And (TextureHeight(cube) = 16)
EntityTexture ball, cube

; The normal: the middle of the ball faces the camera, which is toward -Z, and its sides face the other ways.
SetCubeMode cube, 2
RenderWorld
Check "Cube normal, middle is -Z (red)", R(80, 60), 255, 6
Check "Cube normal, middle is -Z (green)", G(80, 60), 255, 6
Check "Cube normal, middle is -Z (blue)", B(80, 60), 0, 6
Check "Cube normal, right side is +X", B(95, 60), 255, 6
Check "Cube normal, left side is -X", R(65, 60), 255, 6
Check "Cube normal, left side is -X (green)", G(65, 60), 0, 6
Check "Cube normal, top is +Y", G(80, 45), 255, 6
Check "Cube normal, top is +Y (blue)", B(80, 45), 255, 6
Check "Cube normal, bottom is -Y", R(80, 75), 255, 6
Check "Cube normal, bottom is -Y (blue)", B(80, 75), 255, 6

; The reflection of the view: straight at the camera it comes back to it, so the middle is -Z again.
SetCubeMode cube, 1
RenderWorld
Check "Cube reflection, middle is -Z (red)", R(80, 60), 255, 6
Check "Cube reflection, middle is -Z (blue)", B(80, 60), 0, 6

; A face can be drawn by a camera.
SetCubeFace cube, 3
SetBuffer TextureBuffer(cube)
spy = CreateCamera()
PositionEntity spy, 0, 100, 0
CameraClsColor spy, 255, 128, 0
CameraViewport spy, 0, 0, 16, 16
CameraProjMode camera, 0
RenderWorld
CameraProjMode camera, 1
HideEntity spy
CameraProjMode spy, 0
SetBuffer BackBuffer()
SetCubeMode cube, 2
RenderWorld
Check "A camera can draw a face (red)", R(80, 60), 255, 6
Check "A camera can draw a face (green)", G(80, 60), 128, 8
Check "A camera can draw a face (blue)", B(80, 60), 0, 6

EntityTexture ball, 0
FreeTexture cube

; A cube map is loaded from a picture with the six faces next to each other.
strip = CreateTexture(96, 16)
SetBuffer TextureBuffer(strip)
For face = 0 To 5
	Color face * 40 + 20, 255 - face * 40, 128
	Rect face * 16, 0, 16, 16, True
Next
SetBuffer BackBuffer()
SaveBuffer TextureBuffer(strip), "suite_envmap_strip.bmp"
FreeTexture strip
loaded = LoadTexture("suite_envmap_strip.bmp", 1 + 128)
CheckTrue "A cube map loads from a strip", loaded <> 0
Check "A loaded cube map has the size of a face", TextureWidth(loaded), 16
SetCubeMode loaded, 2
EntityTexture ball, loaded
RenderWorld
Check "Loaded cube, middle is face 3 (red)", R(80, 60), 3 * 40 + 20, 6
Check "Loaded cube, middle is face 3 (green)", G(80, 60), 255 - 3 * 40, 6
Check "Loaded cube, right side is face 2 (red)", R(95, 60), 2 * 40 + 20, 6
EntityTexture ball, 0
FreeTexture loaded
DeleteFile "suite_envmap_strip.bmp"
FreeEntity ball
Print "blitz3d_envmaps_pixels: " + suite_checks + " checks passed."
