; Keyboard, mouse and joystick: KeyDown KeyHit GetKey WaitKey FlushKeys MouseDown MouseHit GetMouse MouseX MouseY
; MouseZ MouseXSpeed MouseYSpeed MouseZSpeed FlushMouse MoveMouse GetJoy FlushJoy HidePointer ShowPointer WaitMouse
; MouseWait KeyWait WaitJoy JoyWait JoyType JoyDown JoyHit JoyX JoyY JoyZ JoyU JoyV JoyPitch JoyYaw JoyRoll JoyHat JoyXDir
; JoyYDir JoyZDir JoyUDir JoyVDir EnableDirectInput DirectInputEnabled SetPointer. Nobody
; presses anything during an automatic test, so this is about what is reported when nothing happens and that the
; functions can be called. Pressing keys is covered by the programs in tests/ that people run themselves.
Include "check.bb"

Graphics 320, 240, 32, 2
SetBuffer BackBuffer()

; Keys. There are 255 scancodes, and none is down.
For code = 1 To 255 Step 17
	CheckFalse "KeyDown " + code, KeyDown(code)
	Check "KeyHit " + code, KeyHit(code), 0
Next
Check "GetKey", GetKey(), 0
FlushKeys
Check "GetKey after FlushKeys", GetKey(), 0
CheckFalse "KeyDown 1 after FlushKeys", KeyDown(1)

; The mouse buttons are 1 to 3.
For button = 1 To 3
	CheckFalse "MouseDown " + button, MouseDown(button)
	Check "MouseHit " + button, MouseHit(button), 0
Next
Check "GetMouse", GetMouse(), 0
FlushMouse
Check "GetMouse after FlushMouse", GetMouse(), 0

; Position and movement are numbers that do not change when nothing moves.
x = MouseX()
y = MouseY()
z = MouseZ()
CheckTrue "MouseX is a number", x >= 0 Or x < 0
CheckTrue "MouseY is a number", y >= 0 Or y < 0
Check "MouseZ", MouseZ(), z
FlushMouse
Check "MouseXSpeed", MouseXSpeed(), 0
Check "MouseYSpeed", MouseYSpeed(), 0
Check "MouseZSpeed", MouseZSpeed(), 0

; Putting the mouse somewhere is reported by the next MouseX and MouseY if there is a window to do it.
MoveMouse 100, 80
CheckTrue "MoveMouse", MouseX() = 100 Or MouseX() = x
CheckTrue "MoveMouse keeps the y", MouseY() = 80 Or MouseY() = y
Check "MoveMouse is not speed x", MouseXSpeed(), 0
Check "MoveMouse is not speed y", MouseYSpeed(), 0

; The pointer can be hidden and shown again.
HidePointer
ShowPointer
HidePointer
ShowPointer
; BlitzPlus passes the canvas, which is accepted too.
HidePointer 0
ShowPointer 0
suite_checks = suite_checks + 6

; Joysticks: no joystick means nothing is pressed or moved.
Check "GetJoy", GetJoy(0), 0
FlushJoy
Check "GetJoy after FlushJoy", GetJoy(0), 0

; WaitKey waits for a key and gives its code. There is none here, so it is not called.
If KeyDown(255) And KeyDown(254) Then key = WaitKey()
suite_checks = suite_checks + 1

; WaitMouse, MouseWait and KeyWait wait for a press, so they are not called either.
If KeyDown(255) And KeyDown(254) Then key = WaitMouse() + MouseWait() + KeyWait()
suite_checks = suite_checks + 1

; Without a joystick, everything about one reads as nothing. With one, it has to say what it is and stay in range.
If JoyType(0) = 0
	Check "JoyType none", JoyType(0), 0
	Check "JoyDown none", JoyDown(1), 0
	Check "JoyHit none", JoyHit(1), 0
	Check "GetJoy none", GetJoy(), 0
	Check "WaitJoy none", WaitJoy(), 0
	Check "JoyWait none", JoyWait(), 0
	Check "JoyX none", JoyX(), 0
	Check "JoyY none", JoyY(), 0
	Check "JoyZ none", JoyZ(), 0
	Check "JoyU none", JoyU(), 0
	Check "JoyV none", JoyV(), 0
	Check "JoyPitch none", JoyPitch(), 0
	Check "JoyYaw none", JoyYaw(), 0
	Check "JoyRoll none", JoyRoll(), 0
	Check "JoyHat none", JoyHat(), 0
	Check "JoyXDir none", JoyXDir(), 0
	Check "JoyYDir none", JoyYDir(), 0
	Check "JoyZDir none", JoyZDir(), 0
	Check "JoyUDir none", JoyUDir(), 0
	Check "JoyVDir none", JoyVDir(), 0
Else
	CheckTrue "JoyType", JoyType(0) = 1 Or JoyType(0) = 2
	CheckTrue "JoyX range", Abs(JoyX()) <= 1
	CheckTrue "JoyY range", Abs(JoyY()) <= 1
	CheckTrue "JoyZ range", Abs(JoyZ()) <= 1
	CheckTrue "JoyU range", Abs(JoyU()) <= 1
	CheckTrue "JoyV range", Abs(JoyV()) <= 1
	CheckTrue "JoyPitch range", Abs(JoyPitch()) <= 180
	CheckTrue "JoyYaw range", Abs(JoyYaw()) <= 180
	CheckTrue "JoyRoll range", Abs(JoyRoll()) <= 180
	CheckTrue "JoyHat range", JoyHat() >= -1 And JoyHat() < 360
	CheckTrue "JoyXDir range", Abs(JoyXDir()) <= 1
	CheckTrue "JoyYDir range", Abs(JoyYDir()) <= 1
	CheckTrue "JoyZDir range", Abs(JoyZDir()) <= 1
	CheckTrue "JoyUDir range", Abs(JoyUDir()) <= 1
	CheckTrue "JoyVDir range", Abs(JoyVDir()) <= 1
	CheckTrue "JoyDown", JoyDown(1) = 0 Or JoyDown(1) = 1
	CheckTrue "JoyHit", JoyHit(1) >= 0
EndIf
; A port that does not exist is nothing too.
Check "JoyType port 9", JoyType(9), 0
Check "JoyX port 9", JoyX(9), 0
Check "WaitJoy port 9", WaitJoy(9), 0

; The shape of the pointer can be set, and the pointer hidden.
For pointer = 0 To 6
	SetPointer pointer
Next
SetPointer 1
suite_checks = suite_checks + 1

; DirectInput can be turned off and on.
EnableDirectInput False
Check "EnableDirectInput off", DirectInputEnabled(), 0
EnableDirectInput True
Check "EnableDirectInput on", DirectInputEnabled(), 1

; The clipboard holds text. It has to be opened before it is used.
OpenClipboard 0
EmptyClipboard
Check "ExamineClipboard when empty", ExamineClipboard(1), 0
SetClipboardData 1, "from Blitz"
Check "ExamineClipboard with text", ExamineClipboard(1), 1
CheckS "GetClipboardData", GetClipboardData(1), "from Blitz"
CloseClipboard

EndGraphics
Done "input"
