; The runtime reads its BLITZLLVM_ variables once, when the program starts: a program that changes one with SetEnv does not change how the
; runtime behaves, GetEnv$ and SetEnv still work on the real environment. This test runs without BLITZLLVM_TEST_LIVE_ENV.
Include "check.bb"

Const GAME$ = "startup game"
Const PORT = 40613

SetEnv "BLITZLLVM_NETGAME_PORT", Str$(PORT)
CheckS "SetEnv is seen by GetEnv$", GetEnv$("BLITZLLVM_NETGAME_PORT"), Str$(PORT)
Check "HostNetGame", HostNetGame(GAME), 2

; The host listens on the port from the start of the program (the default one), not on the one that was set afterwards.
stream = OpenTCPStream("127.0.0.1", PORT)
CheckFalse "The changed port is not listened on", stream <> 0
If stream <> 0 Then CloseTCPStream stream
stream = OpenTCPStream("127.0.0.1", 40500)
CheckTrue "The port from the start is listened on", stream <> 0
If stream <> 0 Then CloseTCPStream stream

Done "network_environment_startup_only"
