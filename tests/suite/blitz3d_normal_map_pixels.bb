; TextureBlend 6 and 7, normal maps in tangent space (a BlitzLLVM extension next to the Dot3 bump maps of mode 4), which needs a window and a
; GPU, so this is skipped without one. A quad faces the camera with U growing to the right and V growing downwards. A directional light that
; shines in from the right lights a normal map that leans to the right more than one that leans left, a flat map (128, 128, 255) lights like
; the surface does, and the same goes for up and down with the green channel (6: green is up in the picture, 7: down). A color texture on the
; second layer multiplies the result.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_normal_map_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 64
Graphics3D W, H, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
PositionEntity camera, 0, 0, -4
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100
AmbientLight 0, 0, 0

Global mesh = CreateMesh()
Global surf = CreateSurface(mesh)
v0 = AddVertex(surf, -3, -3, 0, 0, 1) : v1 = AddVertex(surf, -3, 3, 0, 0, 0) : v2 = AddVertex(surf, 3, 3, 0, 1, 0) : v3 = AddVertex(surf, 3, -3, 0, 1, 1)
VertexNormal surf, v0, 0, 0, -1 : VertexNormal surf, v1, 0, 0, -1 : VertexNormal surf, v2, 0, 0, -1 : VertexNormal surf, v3, 0, 0, -1
AddTriangle surf, v0, v1, v2
AddTriangle surf, v0, v2, v3
EntityColor mesh, 255, 255, 255

Global light = CreateLight(1)

Function MapTexture(r, g, b)
	t = CreateTexture(4, 4, 1 + 4096)
	SetBuffer TextureBuffer(t)
	ClsColor r, g, b
	Cls
	SetBuffer BackBuffer()
	Return t
End Function

Function Pixel()
	Return ReadPixel(W / 2, H / 2, BackBuffer()) And $FFFFFF
End Function

Function Grey()
	Return Pixel() And 255
End Function

; Renders the quad with a normal map of the given blend mode and color, and returns the grey of its middle.
Function Lit(r, g, b, blend)
	t = MapTexture(r, g, b)
	TextureBlend t, blend
	EntityTexture mesh, t
	RenderWorld
	value = Grey()
	EntityTexture mesh, 0
	FreeTexture t
	Return value
End Function

; The surface itself, lit per pixel, to compare the flat map with.
EntityLighting mesh, 1
RotateEntity light, 0, -45, 0
RenderWorld
plain = Grey()

flat = Lit(128, 128, 255, 6)
right = Lit(230, 128, 200, 6)
left  = Lit(26, 128, 200, 6)

; Light that comes from above.
RotateEntity light, 45, 0, 0
plainTop = Lit(128, 128, 255, 6)
up   = Lit(128, 230, 200, 6)
down = Lit(128, 26, 200, 6)
up7   = Lit(128, 230, 200, 7)
down7 = Lit(128, 26, 200, 7)

values$ = "plain " + plain + ", flat " + flat + ", right " + right + ", left " + left + ", plainTop " + plainTop + ", up " + up + ", down " + down + ", up7 " + up7 + ", down7 " + down7
CheckTrue "The surface is lit by the light from the right (" + values$ + ")", plain > 100
Check "A flat normal map lights like the surface (" + values$ + ")", flat, plain, 4
; Light that comes from the right (it shines to the left and into the screen).
CheckTrue "A map that leans to the right is brighter than a flat one (" + values$ + ")", right > flat + 20
CheckTrue "A map that leans to the left is darker than a flat one (" + values$ + ")", left < flat - 20
CheckTrue "With green up, a map that leans up is brighter in light from above (" + values$ + ")", up > plainTop + 20
CheckTrue "With green up, a map that leans down is darker in light from above (" + values$ + ")", down < plainTop - 20
; Mode 7 has the green channel the other way round.
Check "Mode 7 mirrors the green channel (up) (" + values$ + ")", up7, down, 3
Check "Mode 7 mirrors the green channel (down) (" + values$ + ")", down7, up, 3

; The map is no color of its own: a color texture on the next layer multiplies the lit result, here red.
RotateEntity light, 0, -45, 0
map = MapTexture(230, 128, 200)
TextureBlend map, 6
red = MapTexture(255, 0, 0)
EntityTexture mesh, map, 0, 0
EntityTexture mesh, red, 0, 1
RenderWorld
c = Pixel()
CheckTrue "A color texture on the second layer tints the lit surface", ((c Shr 16) And 255) > 100
Check "The blue channel is gone", c And 255, 0, 2
Check "The green channel is gone", (c Shr 8) And 255, 0, 2

Done "blitz3d_normal_map_pixels"
