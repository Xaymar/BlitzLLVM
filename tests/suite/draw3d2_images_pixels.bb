; Draw3D2 images against the original Blitz3D: DrawImage3D (angle, scale, ColorG3D tint and alpha), DrawRect3D, DrawQuad3D, DrawTile3D, MaskImage3D. Needs a window and a GPU. See draw3d2_common.bb for the metric.
If GetEnv$("BLITZLLVM_HEADLESS") <> "" And GetEnv$("D3D2_CAPTURE") = "" Then
	Print "draw3d2_images_pixels: skipped, there is no window."
	End
EndIf
Include "check.bb"
Include "../draw3d2/draw3d2_common.bb"

D3DSetup
Clear3D

; The sprite plain, rotated, scaled, tinted and see-through.
DrawImage3D d3d_sprite, -120, 70
DrawImage3D d3d_sprite, -50, 70, 0, 30
DrawImage3D d3d_sprite, 30, 70, 0, 0, 0.5
DrawImage3D d3d_sprite, 110, 70, 0, 45, 0.75
ColorG3D 255, 80, 80
DrawImage3D d3d_sprite, -120, -10
ColorG3D 255, 255, 255, 0.5
DrawImage3D d3d_sprite, -50, -10
ColorG3D 80, 255, 160, 0.75
DrawImage3D d3d_sprite, 20, -10, 0, 90
ColorG3D

; A part of the sprite, and a free quad.
DrawRect3D d3d_sprite, 100, -10, 0, 0, 32, 32
DrawQuad3D d3d_sprite, -130, -60, -60, -50, -50, -110, -140, -100

; The sprite tiled.
DrawTile3D d3d_sprite, 0, -60, 100, -60, 100, -110, 0, -110, 0.5

D3DFinish "draw3d2_images"
Done "draw3d2_images_pixels"
