; EntityDepthFade: a see-through mesh fades out as it gets close to a solid wall behind it, like a sprite with SpriteDepthFade.
; The wall is black and 10 units from the camera, the panel is a thin white box with an alpha of 0.9, so the red value in the
; middle of the picture is 255 times the alpha that is left of the panel.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_entity_depth_fade_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 64, 64, 32, 2
SetBuffer BackBuffer()
camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100
wall = CreateCube()
ScaleEntity wall, 30, 30, 1
PositionEntity wall, 0, 0, 11 ; The front is at z = 10.
EntityColor wall, 0, 0, 0
EntityFX wall, 1

panel = CreateCube()
ScaleEntity panel, 3, 3, 0.01 ; The front is at z - 0.01.
EntityColor panel, 255, 255, 255
EntityFX panel, 1
EntityAlpha panel, 0.9

Function Centre()
	RenderWorld
	Return ReadPixel(32, 32, BackBuffer()) And 255
End Function

PositionEntity panel, 0, 0, 9.51
Check "Without a depth fade the panel is as it is, close to the wall", Centre(), 230, 4

EntityDepthFade panel, 1
Check "Half the distance to the wall is half the alpha", Centre(), 115, 6
PositionEntity panel, 0, 0, 9.91
Check "Very close to the wall it is almost gone", Centre(), 23, 6
PositionEntity panel, 0, 0, 8.01
Check "Further away than the distance it is not changed", Centre(), 230, 4

EntityDepthFade panel, 4
PositionEntity panel, 0, 0, 8.01
Check "A longer distance fades it more", Centre(), 115, 6

EntityDepthFade panel, 0
Check "0 turns it off", Centre(), 230, 4

; EntityBlend 3 (add) looks at the alpha as well: the white that is added to the black wall is as strong as the alpha.
EntityBlend panel, 3
EntityDepthFade panel, 4
Check "Add blending fades too", Centre(), 115, 6
EntityDepthFade panel, 0
EntityBlend panel, 1

; With an orthographic camera depth is linear, which has to come out the same.
CameraProjMode camera, 2
CameraZoom camera, 0.2
EntityDepthFade panel, 1
PositionEntity panel, 0, 0, 9.51
Check "An orthographic camera fades the same way", Centre(), 115, 6
CameraProjMode camera, 1
CameraZoom camera, 1

; A solid mesh is not changed, as there is nothing it would blend with.
EntityAlpha panel, 1
Check "A solid mesh ignores the depth fade", Centre(), 255, 2
EntityAlpha panel, 0.9

; The copy of an entity has the depth fade of the original.
HideEntity panel
copy = CopyEntity(panel)
ShowEntity copy
PositionEntity copy, 0, 0, 9.51
Check "A copy keeps the depth fade", Centre(), 115, 6

Done "blitz3d_entity_depth_fade_pixels"
End
