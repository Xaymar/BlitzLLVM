; MeshWidth, MeshHeight and MeshDepth follow every change of the vertices: the box of each surface is kept until the surface changes,
; and the size of a mesh is worked out from those boxes.
Include "check.bb"

Graphics3D 320, 240, 32, 2

mesh = CreateCube()
Check "MeshWidth", MeshWidth(mesh), 2
Check "MeshHeight", MeshHeight(mesh), 2
Check "MeshDepth", MeshDepth(mesh), 2
ScaleMesh mesh, 2, 1, 1
Check "MeshWidth after ScaleMesh", MeshWidth(mesh), 4
VertexCoords GetSurface(mesh, 1), 0, 10, 0, 0
Check "MeshWidth after VertexCoords", MeshWidth(mesh), 12
PositionMesh mesh, 0, 5, 0
Check "MeshHeight after PositionMesh", MeshHeight(mesh), 2
RotateMesh mesh, 0, 0, 90
Check "MeshHeight after RotateMesh", MeshHeight(mesh), 12, 0.001
FitMesh mesh, 0, 0, 0, 3, 4, 5
Check "MeshWidth after FitMesh", MeshWidth(mesh), 3, 0.001
Check "MeshHeight after FitMesh", MeshHeight(mesh), 4, 0.001
Check "MeshDepth after FitMesh", MeshDepth(mesh), 5, 0.001

; A second surface, and vertices added to it.
s = CreateSurface(mesh)
AddVertex s, 0, 0, 20
Check "MeshDepth with a vertex of a new surface", MeshDepth(mesh), 20, 0.001
AddVertex s, 0, 0, -20
Check "MeshDepth with another vertex", MeshDepth(mesh), 40, 0.001
ClearSurface s
Check "MeshDepth after ClearSurface", MeshDepth(mesh), 5, 0.001

; AddMesh puts the vertices of one mesh into another.
big = CreateSphere(8)
ScaleMesh big, 10, 10, 10
AddMesh big, mesh
Check "MeshWidth after AddMesh", MeshWidth(mesh), 20, 0.001

Check "MeshWidth of an empty mesh", MeshWidth(CreateMesh()), 0
m2 = CreateMesh()
CreateSurface m2
Check "MeshWidth of a mesh with an empty surface", MeshWidth(m2), 0

EndGraphics
Done "mesh size changes"
