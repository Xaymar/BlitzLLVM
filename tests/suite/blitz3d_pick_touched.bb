; Picking in a scene with many entities, where the picks look only at the entities that were touched since the last pick (and their
; children): a grandchild that a grandparent moves into the line, and entities made past the end of all there ever were, between picks.
; Spheres, which the runtime picks itself (polygons go to the physics library, which keeps its own track of what changed).
; CreateSphere CreatePivot EntityParent PositionEntity EntityPickMode EntityRadius FreeEntity LinePick.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; 300 spheres far above the line, enough for the picks to look only at what is near the line.
Dim filler(300)
For i = 1 To 300
	filler(i) = CreateSphere()
	PositionEntity filler(i), i * 4, 1000, 0
	EntityPickMode filler(i), 1
Next
far = CreateSphere()
PositionEntity far, 40, 0, 0
EntityPickMode far, 1

Function Along()
	Return LinePick(25, 0, 0, 400, 0, 0)
End Function

; A sphere that is the grandchild of a pivot, far above the line.
near = CreateSphere()
EntityPickMode near, 1
top = CreatePivot()
middle = CreatePivot(top)
PositionEntity near, 30, 0, 0
EntityParent near, middle
PositionEntity top, 0, 50, 0
; Every filler touched, which makes the picks look at everything again, and then many picks without a change.
For i = 1 To 300
	PositionEntity filler(i), i * 4, 1000, 1
Next
For i = 1 To 200
	CheckTrue "Before the grandparent moved " + i, Along() = far
Next
; Only the grandparent is touched: the picks have to follow it down to the grandchild, which is now on the line.
PositionEntity top, 0, 0, 0
Check "After the grandparent moved", Along(), near
PositionEntity top, 0, 50, 0
Check "After the grandparent moved away again", Along(), far

; More entities than there ever were, made between picks: the new ones are past the end of what the picks knew.
Dim grown(400)
For i = 1 To 400
	grown(i) = CreatePivot()
	If i Mod 50 = 0 Then Check "Made " + i, Along(), far
Next
FreeEntity grown(400)
grown(400) = CreateSphere()
PositionEntity grown(400), 30, 0, 0
EntityPickMode grown(400), 1
Check "A new sphere past the old end", Along(), grown(400)
extra = CreateSphere()
PositionEntity extra, 28, 0, 0
EntityPickMode extra, 1
Check "Another new sphere past the old end", Along(), extra
FreeEntity extra
FreeEntity grown(400)
Check "The new spheres freed", Along(), far

EndGraphics
Done "blitz3d_pick_touched"
