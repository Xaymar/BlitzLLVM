; Banks: CreateBank FreeBank BankSize ResizeBank CopyBank PeekByte PeekShort PeekInt PeekFloat PokeByte PokeShort
; PokeInt PokeFloat ReadBytes WriteBytes CallDLL.
Include "check.bb"

; A new bank is all zeros.
bank = CreateBank(16)
CheckTrue "CreateBank", bank <> 0
Check "BankSize", BankSize(bank), 16
For i = 0 To 15
	Check "zero " + i, PeekByte(bank, i), 0
Next

; Bytes are 0 to 255.
PokeByte bank, 0, 200
Check "PokeByte", PeekByte(bank, 0), 200
PokeByte bank, 1, 300
Check "PokeByte wraps", PeekByte(bank, 1), 44
PokeByte bank, 2, -1
Check "PokeByte negative", PeekByte(bank, 2), 255

; Shorts are two bytes, the low one first.
PokeShort bank, 4, $1234
Check "PokeShort", PeekShort(bank, 4), $1234
Check "PokeShort low byte", PeekByte(bank, 4), $34
Check "PokeShort high byte", PeekByte(bank, 5), $12
PokeShort bank, 4, -2
Check "PokeShort negative reads as unsigned", PeekShort(bank, 4), 65534

; Ints are four bytes.
PokeInt bank, 8, $01020304
Check "PokeInt", PeekInt(bank, 8), $01020304
Check "PokeInt byte 0", PeekByte(bank, 8), 4
Check "PokeInt byte 3", PeekByte(bank, 11), 1
PokeInt bank, 8, -5
Check "PokeInt negative", PeekInt(bank, 8), -5

; Floats are four bytes as well.
PokeFloat bank, 12, 1.5
Check "PokeFloat", PeekFloat(bank, 12), 1.5
Check "PokeFloat bits", PeekInt(bank, 12), $3FC00000
PokeFloat bank, 12, -0.25
Check "PokeFloat negative", PeekFloat(bank, 12), -0.25

; Bytes of different kinds do not overlap.
PokeInt bank, 0, 0
PokeByte bank, 1, 255
Check "bytes are separate", PeekInt(bank, 0), 65280

; ResizeBank keeps the start and fills the new part with zeros.
PokeInt bank, 0, 12345678
ResizeBank bank, 32
Check "ResizeBank size", BankSize(bank), 32
Check "ResizeBank keeps", PeekInt(bank, 0), 12345678
Check "ResizeBank new part", PeekInt(bank, 28), 0
ResizeBank bank, 4
Check "ResizeBank smaller", BankSize(bank), 4
Check "ResizeBank smaller keeps", PeekInt(bank, 0), 12345678

; CopyBank copies between banks, and inside one bank even if the parts overlap.
source = CreateBank(8)
destination = CreateBank(8)
For i = 0 To 7
	PokeByte source, i, i + 1
Next
CopyBank source, 2, destination, 0, 4
Check "CopyBank first", PeekByte(destination, 0), 3
Check "CopyBank last", PeekByte(destination, 3), 6
Check "CopyBank stops", PeekByte(destination, 4), 0
CopyBank source, 0, source, 2, 6
Check "CopyBank overlap 0", PeekByte(source, 2), 1
Check "CopyBank overlap 5", PeekByte(source, 7), 6
Check "CopyBank overlap start", PeekByte(source, 1), 2

; FreeBank
FreeBank source
FreeBank destination
FreeBank bank
bank2 = CreateBank(1)
CheckTrue "Banks can be created after others are freed", BankSize(bank2) = 1
FreeBank bank2

; Empty banks are fine.
empty = CreateBank(0)
Check "Empty bank", BankSize(empty), 0
ResizeBank empty, 4
Check "Empty bank can grow", BankSize(empty), 4
FreeBank empty

; Banks go to and from files in pieces.
path$ = "suite_banks.tmp"
source = CreateBank(8)
For i = 0 To 7
	PokeByte source, i, 10 + i
Next
file = WriteFile(path)
Check "WriteBytes", WriteBytes(source, file, 2, 5), 5
CloseFile file
Check "WriteBytes size", FileSize(path), 5
target = CreateBank(8)
file = ReadFile(path)
Check "ReadBytes", ReadBytes(target, file, 1, 5), 5
CloseFile file
Check "ReadBytes first", PeekByte(target, 0), 0
Check "ReadBytes second", PeekByte(target, 1), 12
Check "ReadBytes last", PeekByte(target, 5), 16
Check "ReadBytes after", PeekByte(target, 6), 0
; Reading more than there is gives what there is.
file = ReadFile(path)
Check "ReadBytes short", ReadBytes(target, file, 0, 8), 5
CloseFile file
DeleteFile path

; CallDLL calls a function of a library, which gets the banks. One that is not there gives 0. The system library with
; a function that ignores what it gets is used to see that the call goes through.
Check "CallDLL missing library", CallDLL("suite_no_such_library", "Nothing"), 0
If FileType("C:/Windows/System32/kernel32.dll") = 1
	Check "CallDLL missing function", CallDLL("kernel32", "SuiteNoSuchFunction"), 0
	CheckTrue "CallDLL", CallDLL("kernel32", "GetCurrentProcessId") > 0
	CheckTrue "CallDLL with banks", CallDLL("kernel32", "GetCurrentProcessId", source, target) > 0
EndIf

Done "banks"
