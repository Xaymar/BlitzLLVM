; What 2D drawing puts on the screen, which needs a window and a GPU, so this is skipped without one: Plot Line Rect
; Oval Text Cls ClsColor ReadPixel WritePixel ReadPixelFast WritePixelFast CopyPixel CopyPixelFast CopyRect GetColor
; LockBuffer UnlockBuffer DrawImage DrawImageRect DrawBlock DrawBlockRect TileBlock GrabImage SaveBuffer SaveImage
; FrontBuffer Flip Origin Viewport Locate Print Write ImagesCollide ImageRectCollide ImageRectOverlap TileImage CopyImage
; ScaleImage RotateImage LoadBuffer LockedPixels LockedPitch LockedFormat.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_pixels: skipped, there is no window."
	End
EndIf

Graphics 160, 120, 32, 2
SetBuffer BackBuffer()

; The color of a pixel, without the alpha.
Function Px(x, y)
	Return ReadPixel(x, y) And $FFFFFF
End Function

Const RED = $FF0000, GREEN = $00FF00, BLUE = $0000FF, WHITE = $FFFFFF, BLACK = 0, GREY = $404040

; Cls fills everything with the clear color.
ClsColor 64, 64, 64
Cls
Check "Cls top left", Px(0, 0), GREY
Check "Cls middle", Px(80, 60), GREY
Check "Cls bottom right", Px(159, 119), GREY
ClsColor 0, 0, 0
Cls
Check "Cls black", Px(80, 60), BLACK

; Plot is one pixel.
Color 255, 0, 0
Plot 10, 10
Check "Plot", Px(10, 10), RED
Check "Plot is one pixel x", Px(11, 10), BLACK
Check "Plot is one pixel y", Px(10, 11), BLACK
Plot -5, -5
Plot 1000, 1000

; GetColor takes the color of a pixel as the drawing color.
GetColor 10, 10
Check "GetColor red", ColorRed(), 255
Check "GetColor green", ColorGreen(), 0
Check "GetColor blue", ColorBlue(), 0

; Rectangles, filled or only their edge.
Cls
Color 0, 255, 0
Rect 20, 20, 10, 6, True
Check "Rect corner", Px(20, 20), GREEN
Check "Rect inside", Px(25, 23), GREEN
Check "Rect last x", Px(29, 25), GREEN
Check "Rect beyond x", Px(30, 25), BLACK
Check "Rect beyond y", Px(29, 26), BLACK
Check "Rect before", Px(19, 20), BLACK
Cls
Rect 20, 20, 10, 6, False
Check "Rect outline corner", Px(20, 20), GREEN
Check "Rect outline right edge", Px(29, 22), GREEN
Check "Rect outline bottom edge", Px(25, 25), GREEN
Check "Rect outline is hollow", Px(25, 22), BLACK

; Lines include both ends.
Cls
Color 0, 0, 255
Line 40, 10, 60, 10
Check "Line start", Px(40, 10), BLUE
Check "Line middle", Px(50, 10), BLUE
Check "Line end", Px(60, 10), BLUE
Check "Line is thin", Px(50, 11), BLACK
Check "Line past the end", Px(61, 10), BLACK
Line 70, 10, 70, 30
Check "Vertical line", Px(70, 20), BLUE
Line 80, 10, 100, 30
Check "Diagonal start", Px(80, 10), BLUE
Check "Diagonal middle", Px(90, 20), BLUE
Check "Diagonal end", Px(100, 30), BLUE

; Ovals are inside the box they are given.
Cls
Color 255, 255, 255
Oval 20, 50, 40, 30, True
Check "Oval middle", Px(40, 65), WHITE
Check "Oval corner is empty", Px(21, 51), BLACK
Check "Oval outside", Px(10, 65), BLACK
Cls
Oval 20, 50, 40, 30, False
Check "Oval outline top", Px(40, 50), WHITE
Check "Oval outline is hollow", Px(40, 65), BLACK

; Text puts pixels of the drawing color on the buffer, and nowhere else.
Cls
Color 255, 255, 255
Text 10, 10, "Hello"
count = 0
For y = 10 To 10 + StringHeight("Hello")
	For x = 10 To 10 + StringWidth("Hello")
		If Px(x, y) = WHITE Then count = count + 1
	Next
Next
CheckTrue "Text draws pixels (" + count + ")", count > 10
Check "Text stays inside x", Px(10 + StringWidth("Hello") + 4, 10), BLACK
Check "Text stays inside y", Px(12, 10 + StringHeight("Hello") + 4), BLACK

; WritePixel and ReadPixel
Cls
WritePixel 5, 5, $FF8040
Check "WritePixel", Px(5, 5), $FF8040
Check "ReadPixel of an empty one", Px(7, 5), BLACK
Check "ReadPixel outside", ReadPixel(-1, -1), 0

; The fast ones need the buffer to be locked.
LockBuffer BackBuffer()
WritePixelFast 8, 5, $123456
Check "WritePixelFast", ReadPixelFast(8, 5) And $FFFFFF, $123456
Check "ReadPixelFast of what WritePixel did", ReadPixelFast(5, 5) And $FFFFFF, $FF8040
UnlockBuffer BackBuffer()
Check "WritePixelFast stays", Px(8, 5), $123456

; CopyPixel
Cls
WritePixel 1, 1, $ABCDEF
CopyPixel 1, 1, BackBuffer(), 2, 2, BackBuffer()
Check "CopyPixel", Px(2, 2), $ABCDEF
Check "CopyPixel keeps the source", Px(1, 1), $ABCDEF
LockBuffer BackBuffer()
CopyPixelFast 1, 1, BackBuffer(), 3, 3, BackBuffer()
UnlockBuffer BackBuffer()
Check "CopyPixelFast", Px(3, 3), $ABCDEF

; CopyRect copies a part of a buffer, even onto itself.
Cls
Color 255, 0, 0
Rect 0, 0, 4, 4, True
Color 0, 255, 0
Rect 4, 0, 4, 4, True
CopyRect 0, 0, 8, 4, 20, 20, BackBuffer(), BackBuffer()
Check "CopyRect first color", Px(21, 21), RED
Check "CopyRect second color", Px(25, 21), GREEN
Check "CopyRect edge", Px(27, 23), GREEN
Check "CopyRect stops", Px(28, 23), BLACK
CopyRect 0, 0, 8, 4, 2, 0, BackBuffer(), BackBuffer()
Check "CopyRect onto itself", Px(2, 1), RED
Check "CopyRect onto itself, second", Px(8, 1), GREEN
Check "CopyRect keeps the source", Px(0, 0), RED

; Images: a red square on a purple background that is the mask.
image = CreateImage(8, 8)
SetBuffer ImageBuffer(image)
Color 255, 0, 255
Rect 0, 0, 8, 8, True
Color 255, 0, 0
Rect 2, 2, 4, 4, True
SetBuffer BackBuffer()
MaskImage image, 255, 0, 255

Cls
DrawImage image, 40, 40
Check "DrawImage color", Px(43, 43), RED
Check "DrawImage keeps the mask transparent", Px(40, 40), BLACK
Check "DrawImage size", Px(48, 48), BLACK
Cls
Color 255, 255, 255
Rect 0, 0, 160, 120, True
DrawImage image, 40, 40
Check "The mask shows what is behind", Px(40, 40), WHITE
Check "The picture covers it", Px(43, 43), RED

; Handles move the picture.
MidHandle image
Cls
DrawImage image, 40, 40
Check "MidHandle", Px(40, 40), RED
Check "MidHandle top left of the picture", Px(36, 36), BLACK
HandleImage image, 0, 0

; Blocks have no mask.
Cls
DrawBlock image, 60, 60
Check "DrawBlock shows the mask color", Px(60, 60), $FF00FF
Check "DrawBlock color", Px(63, 63), RED

; Only a part of the picture.
Cls
DrawImageRect image, 10, 10, 2, 2, 4, 4
Check "DrawImageRect", Px(10, 10), RED
Check "DrawImageRect size", Px(14, 10), BLACK
Cls
DrawBlockRect image, 10, 10, 0, 0, 4, 4
Check "DrawBlockRect", Px(10, 10), $FF00FF
Check "DrawBlockRect size", Px(14, 10), BLACK

; Tiles cover an area.
tile = CreateImage(4, 4)
SetBuffer ImageBuffer(tile)
Color 0, 255, 0
Rect 0, 0, 4, 4, True
Color 255, 255, 255
Plot 0, 0
SetBuffer BackBuffer()
Cls
TileBlock tile
Check "TileBlock first", Px(0, 0), WHITE
Check "TileBlock repeats x", Px(4, 0), WHITE
Check "TileBlock repeats y", Px(0, 8), WHITE
Check "TileBlock far", Px(156, 116), WHITE
Check "TileBlock between", Px(1, 1), GREEN
Check "TileBlock last", Px(159, 119), GREEN

; GrabImage takes a part of the buffer.
Cls
Color 0, 0, 255
Rect 30, 30, 8, 8, True
grabbed = CreateImage(8, 8)
GrabImage grabbed, 30, 30
Cls
DrawBlock grabbed, 100, 70
Check "GrabImage", Px(103, 73), BLUE
Check "GrabImage size", Px(108, 73), BLACK

; Saving writes a file that can be read again.
folder$ = "suite_tmp_pixels"
CreateDir folder
SaveBuffer BackBuffer(), folder + "/buffer.bmp"
CheckTrue "SaveBuffer", FileType(folder + "/buffer.bmp") = 1
SaveImage grabbed, folder + "/image.bmp"
CheckTrue "SaveImage", FileType(folder + "/image.bmp") = 1
reloaded = LoadImage(folder + "/image.bmp")
CheckTrue "The saved image loads again", reloaded <> 0
Check "The saved image keeps its size", ImageWidth(reloaded), 8
DrawBlock reloaded, 0, 0
Check "The saved image keeps its colors", Px(3, 3), BLUE
FreeImage reloaded
DeleteFile folder + "/buffer.bmp"
DeleteFile folder + "/image.bmp"

; What is drawn to the back buffer is only shown after Flip, and the front buffer can be drawn to directly.
SetBuffer FrontBuffer()
Cls
Color 255, 0, 255
Plot 3, 3
Check "FrontBuffer", Px(3, 3), $FF00FF
SetBuffer BackBuffer()
Flip
Flip

FreeImage image
FreeImage tile
FreeImage grabbed

; Origin moves where 0, 0 is, for everything that is drawn, until the buffer is set again.
SetBuffer BackBuffer()
ClsColor 0, 0, 0
Cls
Color 255, 0, 0
Origin 10, 20
Plot 0, 0
Rect 5, 5, 3, 3
Text 30, 30, "O"
Origin 0, 0
Check "Origin plot", Px(10, 20), RED
Check "Origin plot moved", Px(0, 0), BLACK
Check "Origin rect", Px(16, 26), RED
Check "Origin rect edge", Px(18, 28), BLACK
SetBuffer BackBuffer()
Origin 40, 40
SetBuffer BackBuffer()
Plot 1, 1
Check "SetBuffer resets Origin", Px(1, 1), RED

; Viewport limits drawing to a part of the buffer, Cls included.
ClsColor 0, 0, 255
Cls
Viewport 20, 30, 10, 10
Color 0, 255, 0
Rect 0, 0, 100, 100
Check "Viewport inside", Px(25, 35), GREEN
Check "Viewport corner", Px(20, 30), GREEN
Check "Viewport last pixel", Px(29, 39), GREEN
Check "Viewport left of it", Px(19, 35), BLUE
Check "Viewport right of it", Px(30, 35), BLUE
Check "Viewport above it", Px(25, 29), BLUE
Check "Viewport below it", Px(25, 40), BLUE
ClsColor 255, 255, 0
Cls
Check "Cls inside the viewport", Px(25, 35), $FFFF00
Check "Cls leaves the rest", Px(5, 5), BLUE
Line 0, 0, 159, 119
Check "Viewport lines", Px(5, 5), BLUE
Viewport 0, 0, 160, 120
Color 255, 255, 255
Plot 5, 5
Check "Viewport back to everything", Px(5, 5), WHITE
; A viewport that is larger than the buffer is cut to it, and one outside draws nothing.
Viewport -10, -10, 500, 500
Plot 6, 6
Check "Viewport larger", Px(6, 6), WHITE
Viewport 200, 200, 10, 10
Color 255, 0, 0
Rect 0, 0, 160, 120
Check "Viewport outside", Px(80, 60), BLUE
Viewport 0, 0, 160, 120

; Collisions look at the pixels that are not the mask color: here the lower right quarter of one, the upper left of the other.
SetBuffer BackBuffer()
quarter_a = CreateImage(8, 8)
SetBuffer ImageBuffer(quarter_a)
Color 0, 0, 0
Rect 0, 0, 8, 8
Color 255, 255, 255
Rect 4, 4, 4, 4
quarter_b = CreateImage(8, 8)
SetBuffer ImageBuffer(quarter_b)
Color 0, 0, 0
Rect 0, 0, 8, 8
Color 255, 255, 255
Rect 0, 0, 4, 4
SetBuffer BackBuffer()
Check "ImagesOverlap sees the rectangles", ImagesOverlap(quarter_a, 0, 0, quarter_b, 0, 0), 1
Check "ImagesCollide empty parts", ImagesCollide(quarter_a, 0, 0, 0, quarter_b, 0, 0, 0), 0
Check "ImagesCollide solid parts", ImagesCollide(quarter_a, 0, 0, 0, quarter_b, 4, 4, 0), 1
Check "ImagesCollide one pixel", ImagesCollide(quarter_a, 0, 0, 0, quarter_b, 7, 7, 0), 1
Check "ImagesCollide next to it", ImagesCollide(quarter_a, 0, 0, 0, quarter_b, 8, 8, 0), 0
Check "ImagesCollide other corner", ImagesCollide(quarter_a, 0, 0, 0, quarter_b, 7, 0, 0), 0
Check "ImageRectOverlap sees the rectangle", ImageRectOverlap(quarter_a, 0, 0, 0, 0, 4, 4), 1
Check "ImageRectCollide empty part", ImageRectCollide(quarter_a, 0, 0, 0, 0, 0, 4, 4), 0
Check "ImageRectCollide solid part", ImageRectCollide(quarter_a, 0, 0, 0, 4, 4, 4, 4), 1
Check "ImageRectCollide edge", ImageRectCollide(quarter_a, 0, 0, 0, 7, 7, 1, 1), 1
; Drawing on an image changes what collides.
SetBuffer ImageBuffer(quarter_a)
Color 255, 255, 255
Rect 0, 0, 4, 4
SetBuffer BackBuffer()
Check "ImageRectCollide after drawing", ImageRectCollide(quarter_a, 0, 0, 0, 0, 0, 4, 4), 1
; A different mask color changes it too: now white is the mask and black is solid.
MaskImage quarter_a, 255, 255, 255
Check "ImageRectCollide with another mask", ImageRectCollide(quarter_a, 0, 0, 0, 0, 0, 4, 4), 0
SetBuffer ImageBuffer(quarter_a)
Color 255, 255, 255
Rect 0, 0, 8, 8
Color 0, 0, 0
Rect 2, 2, 2, 2
SetBuffer BackBuffer()
Check "ImageRectCollide black in white", ImageRectCollide(quarter_a, 0, 0, 0, 2, 2, 1, 1), 1
Check "ImageRectCollide white around it", ImageRectCollide(quarter_a, 0, 0, 0, 5, 5, 1, 1), 0

; TileImage leaves out the mask color, TileBlock does not.
ClsColor 0, 0, 255
Cls
TileImage quarter_b, 0, 0
Check "TileImage solid", Px(1, 1), WHITE
Check "TileImage masked", Px(5, 1), BLUE
Check "TileImage next tile", Px(9, 1), WHITE
Check "TileImage last row", Px(1, 113), WHITE
TileBlock quarter_b, 0, 0
Check "TileBlock keeps the mask color", Px(5, 1), BLACK

; Copies, scaled images and rotated images have the pixels of the original.
Color 255, 255, 255
copy = CopyImage(quarter_b)
DrawBlock copy, 40, 40
Check "CopyImage solid", Px(41, 41), WHITE
Check "CopyImage mask", Px(46, 41), BLACK
FreeImage copy
scaled = CopyImage(quarter_b)
ScaleImage scaled, 2, 2
Check "ScaleImage width", ImageWidth(scaled), 16
DrawBlock scaled, 60, 60
Check "ScaleImage solid", Px(62, 62), WHITE
Check "ScaleImage mask", Px(75, 61), BLACK
FreeImage scaled
; Turned around the middle, the quarter at the upper left goes to the upper right: the right of the image goes down,
; so the top of it goes right.
turned = CopyImage(quarter_b)
MidHandle turned
RotateImage turned, 90
Check "RotateImage keeps the size", ImageWidth(turned), 8
DrawBlock turned, 100, 60
Check "RotateImage upper right", Px(100 - 4 + 6, 60 - 4 + 1), WHITE
Check "RotateImage upper left", Px(100 - 4 + 1, 60 - 4 + 1), BLACK
Check "RotateImage lower right", Px(100 - 4 + 6, 60 - 4 + 6), BLACK
FreeImage turned
FreeImage quarter_a
FreeImage quarter_b

; LoadBuffer fills a buffer with a picture from a file, stretched to the size of the buffer: here four colors in four
; pixels, saved and loaded back.
picture = CreateImage(2, 2)
SetBuffer ImageBuffer(picture)
Color 255, 0, 0
Plot 0, 0
Color 0, 255, 0
Plot 1, 0
Color 0, 0, 255
Plot 0, 1
Color 255, 255, 0
Plot 1, 1
SetBuffer BackBuffer()
Check "SaveBuffer for LoadBuffer", SaveBuffer(ImageBuffer(picture), "suite_loadbuffer.bmp"), 1
ClsColor 0, 0, 0
Cls
Check "LoadBuffer", LoadBuffer(BackBuffer(), "suite_loadbuffer.bmp"), 1
Check "LoadBuffer upper left", Px(5, 5), RED
Check "LoadBuffer upper right", Px(150, 5), GREEN
Check "LoadBuffer lower left", Px(5, 110), BLUE
Check "LoadBuffer lower right", Px(150, 110), $FFFF00
target = CreateImage(4, 4)
Check "LoadBuffer into an image", LoadBuffer(ImageBuffer(target), "suite_loadbuffer.bmp"), 1
DrawBlock target, 20, 20
Check "LoadBuffer image upper left", Px(20, 20), RED
Check "LoadBuffer image lower right", Px(23, 23), $FFFF00
FreeImage target
FreeImage picture
DeleteFile "suite_loadbuffer.bmp"

; BlitzPlus gives the pixels of a locked buffer as a bank, with 4 bytes for each pixel, blue first. What is done to the
; bank is in the buffer once it is unlocked.
SetBuffer BackBuffer()
ClsColor 0, 0, 0
Cls
Color 255, 0, 0
Plot 3, 2
LockBuffer BackBuffer()
pixels = LockedPixels(BackBuffer())
CheckTrue "LockedPixels", pixels <> 0
pitch = LockedPitch(BackBuffer())
Check "LockedPitch", pitch, 160 * 4
Check "LockedFormat", LockedFormat(BackBuffer()), 4
Check "LockedPixels size", BankSize(pixels), 160 * 120 * 4
at = 2 * pitch + 3 * 4
Check "LockedPixels blue", PeekByte(pixels, at), 0
Check "LockedPixels green", PeekByte(pixels, at + 1), 0
Check "LockedPixels red", PeekByte(pixels, at + 2), 255
Check "LockedPixels the same bank again", LockedPixels(BackBuffer()), pixels
PokeByte pixels, at + 1, 255
PokeByte pixels, 5 * pitch + 7 * 4, 255
UnlockBuffer BackBuffer()
Check "LockedPixels changes show: yellow", Px(3, 2), $FFFF00
Check "LockedPixels changes show: blue", Px(7, 5), BLUE
Check "LockedPixels leaves the rest", Px(0, 0), BLACK

; Print and Write show their text in the window, on the front buffer, from where Locate put the cursor.
SetBuffer FrontBuffer()
ClsColor 0, 0, 0
Cls
Color 255, 255, 255
Locate 8, 16
Print "XX"
Locate 40, 40
Write "A"
Write "B"
Function Lit(x, y, w, h)
	n = 0
	For yy = y To y + h - 1
		For xx = x To x + w - 1
			If Px(xx, yy) = WHITE Then n = n + 1
		Next
	Next
	Return n
End Function
CheckTrue "Print draws at Locate", Lit(8, 16, 16, 8) > 10
Check "Print leaves the line above", Lit(8, 8, 16, 8), 0
Check "Print leaves the left", Lit(0, 16, 8, 8), 0
Locate 8, 24
Print "Y"
CheckTrue "Print goes on in the next line", Lit(8, 24, 8, 8) > 3
Check "Print goes to the start of the line", Lit(0, 24, 8, 8), 0
Locate 40, 48
Write "AB"
CheckTrue "Write draws at Locate", Lit(40, 48, 16, 8) > 10
Write "C"
CheckTrue "Write goes on after the last", Lit(56, 48, 8, 8) > 3
; Print past the bottom scrolls the window.
Cls
Color 255, 255, 255
Rect 0, 100, 10, 10
Color 255, 255, 255
Locate 0, 200
Print ""
Check "Print scrolls", Px(5, 92), WHITE
Check "Print scroll clears", Px(5, 105), BLACK
SetBuffer BackBuffer()

EndGraphics
Done "graphics_pixels"
