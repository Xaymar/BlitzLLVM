; Many see-through sprites that cover each other come out like they do with the original Blitz3D 1.118: at least 95% of the
; pixels are within 8 (of a pixel next to it) of the picture the original draws (images/transparency_sprites_original.png, made by the original under
; Wine with BLITZ_WRITE_REFERENCE=<file.bmp> set and converted to PNG). The wall and the camera are plain, the water is 400
; sprites from a fixed generator, so the order they are drawn in decides the picture.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_transparency_sprites_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 320, 180, 32, 2
SetBuffer BackBuffer()

; The scene: 400 see-through sprites of three sizes and colors, each at a place that comes from a fixed generator (not Rnd), in
; front of a wall and a floor. Sprites cover each other, so what comes out depends on the order they are drawn in.
Global seed = 12345
Function Nxt#()
	seed = (seed * 75 + 74) Mod 65537
	Return seed / 65537.0
End Function

Function BuildScene()
	camera = CreateCamera()
	CameraClsColor camera, 150, 190, 230
	CameraRange camera, 0.1, 200
	PositionEntity camera, 0, 2, -12
	light = CreateLight()
	RotateEntity light, 50, -30, 0
	AmbientLight 90, 90, 90
	wall = CreateCube()
	ScaleEntity wall, 12, 6, 0.2
	PositionEntity wall, 0, 2, 12
	EntityColor wall, 110, 130, 90
	EntityFX wall, 1
	For i = 0 To 399
		s = CreateSprite()
		kind = i Mod 3
		If kind = 0 Then
			EntityColor s, 40, 90, 150 : EntityAlpha s, 0.35 : ScaleSprite s, 1.6, 1.6
		ElseIf kind = 1 Then
			EntityColor s, 225, 240, 255 : EntityAlpha s, 0.4 : ScaleSprite s, 1.1, 1.1
		Else
			EntityColor s, 245, 250, 255 : EntityAlpha s, 0.25 : ScaleSprite s, 0.8, 0.8
		EndIf
		; One value at a time, as the order the arguments are worked out in is not the same in the two compilers.
		px# = (Nxt() - 0.5) * 14
		py# = Nxt() * 5 - 0.5
		pz# = Nxt() * 16 - 2
		PositionEntity s, px, py, pz
	Next
	Return camera
End Function

camera = BuildScene()
RenderWorld
If GetEnv$("BLITZ_WRITE_REFERENCE") <> "" Then
	SaveBuffer BackBuffer(), GetEnv$("BLITZ_WRITE_REFERENCE")
	End
EndIf

reference = LoadImage("images/transparency_sprites_original.png")
CheckTrue "The picture of the original is there", reference <> 0
same = 0
total = 320 * 180
SetBuffer ImageBuffer(reference)
Dim wanted(319, 179)
For y = 0 To 179
	For x = 0 To 319
		wanted(x, y) = ReadPixel(x, y) And $FFFFFF
	Next
Next
SetBuffer BackBuffer()
; The edges of sprites are about half a pixel apart in the two (Direct3D 7 and Vulkan place pixels differently), so a pixel is the
; same when it is like one of the nine pixels around it in the picture of the original.
For y = 0 To 179
	For x = 0 To 319
		got = ReadPixel(x, y, BackBuffer()) And $FFFFFF
		found = 0
		For ny = y - 1 To y + 1
			For nx = x - 1 To x + 1
				If nx >= 0 And nx < 320 And ny >= 0 And ny < 180 And found = 0 Then
					want = wanted(nx, ny)
					If Abs(((got Shr 16) And 255) - ((want Shr 16) And 255)) <= 8 And Abs(((got Shr 8) And 255) - ((want Shr 8) And 255)) <= 8 And Abs((got And 255) - (want And 255)) <= 8 Then found = 1
				EndIf
			Next
		Next
		same = same + found
	Next
Next
CheckTrue "At least 95% of the pixels are like the original (" + (same * 100 / total) + "%)", same * 100 >= total * 95

End
