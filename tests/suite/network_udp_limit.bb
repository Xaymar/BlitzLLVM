; A UDP stream receives into one buffer of its own: a message that does not fit is dropped, the ones after it still arrive.
Include "check.bb"

UDPTimeouts 500
a = CreateUDPStream(40742)
b = CreateUDPStream(40743)
CheckTrue "CreateUDPStream", a <> 0 And b <> 0

; 20000 bytes are more than a message may have.
WriteString a, String$("x", 20000)
SendUDPMsg a, $7F000001, 40743
Check "A message that is too big is dropped", RecvUDPMsg(b), 0

; 16000 bytes are not.
WriteString a, String$("y", 16000)
SendUDPMsg a, $7F000001, 40743
size = RecvUDPMsg(b)
Check "A message that fits arrives", size, 16004
Check "A message that fits has all of it", Len(ReadString$(b)), 16000

; And the stream goes on after the one that was dropped.
WriteString a, "small"
SendUDPMsg a, $7F000001, 40743
CheckTrue "A small message arrives", RecvUDPMsg(b) > 0
CheckS "A small message has its text", ReadString$(b), "small"

CloseUDPStream a
CloseUDPStream b
Done "network_udp_limit"
