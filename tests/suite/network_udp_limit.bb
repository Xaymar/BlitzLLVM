; A UDP stream receives into one buffer of its own, as big as the most one UDP packet can have.
Include "check.bb"

UDPTimeouts 500
a = CreateUDPStream(40742)
b = CreateUDPStream(40743)
CheckTrue "CreateUDPStream", a <> 0 And b <> 0

; A message of 60000 bytes fits (UDP packets have 64 KiB at most, so none can be too big for the buffer).
WriteString a, String$("y", 60000)
SendUDPMsg a, $7F000001, 40743
size = RecvUDPMsg(b)
Check "A big message arrives", size, 60004
Check "A big message has all of it", Len(ReadString$(b)), 60000

; And the stream goes on after it.
WriteString a, "small"
SendUDPMsg a, $7F000001, 40743
CheckTrue "A small message arrives", RecvUDPMsg(b) > 0
CheckS "A small message has its text", ReadString$(b), "small"

CloseUDPStream a
CloseUDPStream b
Done "network_udp_limit"
