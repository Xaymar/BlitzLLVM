; PhysicsContactSlop GetPhysicsContactSlop PhysicsBaumgarte GetPhysicsBaumgarte PhysicsSpeculativeDistance
; GetPhysicsSpeculativeDistance PhysicsSleepThreshold GetPhysicsSleepThreshold PhysicsWorldSleeping GetPhysicsWorldSleeping
; PhysicsContinuousDefault GetPhysicsContinuousDefault PhysicsDeterministic GetPhysicsDeterministic CreatePhysicsBody
; CreatePhysicsBodyFromEntity GetPhysicsBodyMotion GetPhysicsBodyShape PhysicsBodyMotion GetPhysicsBodyWorld PhysicsBodyWorld
; PhysicsMass GetPhysicsMass PhysicsFriction GetPhysicsFriction PhysicsRestitution GetPhysicsRestitution PhysicsLinearDamping
; GetPhysicsLinearDamping PhysicsAngularDamping GetPhysicsAngularDamping PhysicsGravityScale GetPhysicsGravityScale PhysicsLayer
; GetPhysicsLayer GetPhysicsMaskLow GetPhysicsMaskHigh PhysicsSensor GetPhysicsSensor PhysicsContinuous GetPhysicsContinuous
; PhysicsSleeping PhysicsWake GetPhysicsAwake PhysicsLinearVelocity PhysicsAngularVelocity GetPhysicsLinearVelocityX
; GetPhysicsLinearVelocityY GetPhysicsLinearVelocityZ GetPhysicsAngularVelocityX GetPhysicsAngularVelocityY
; GetPhysicsAngularVelocityZ PhysicsApplyForce PhysicsApplyForceAt PhysicsApplyTorque PhysicsApplyImpulse PhysicsApplyImpulseAt
; PhysicsApplyAngularImpulse.
Include "check.bb"

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Const DT# = 1.0 / 60.0

Function Steps(count, world = 0)
	For i = 1 To count
		PhysicsUpdate DT, world
	Next
End Function

; ---- The world and its settings
Check "gravity y", GetPhysicsGravityY(), -9.81
Check "gravity x", GetPhysicsGravityX(), 0
Check "gravity z", GetPhysicsGravityZ(), 0
Check "rate", GetPhysicsRate(), 60
CheckTrue "fixed steps by default", GetPhysicsMode() = 0
Check "max steps", GetPhysicsMaxSteps(), 8
Check "max delta", GetPhysicsMaxDelta(), 1.0 / 15.0, 0.0001
CheckTrue "balanced by default", GetPhysicsSolver() = 0
Check "velocity iterations", GetPhysicsVelocityIterations(), 10
Check "position iterations", GetPhysicsPositionIterations(), 2
Check "substeps", GetPhysicsSubsteps(), 1
Check "slop", GetPhysicsContactSlop(), 0.02, 0.0001
Check "baumgarte", GetPhysicsBaumgarte(), 0.2, 0.0001
Check "speculative", GetPhysicsSpeculativeDistance(), 0.02, 0.0001
Check "sleep threshold", GetPhysicsSleepThreshold(), 0.03, 0.0001
CheckTrue "world sleeping", GetPhysicsWorldSleeping() = 1
CheckTrue "continuous default", GetPhysicsContinuousDefault() = 0
CheckTrue "deterministic", GetPhysicsDeterministic() = 1

PhysicsSolver 2
CheckTrue "accurate", GetPhysicsSolver() = 2
Check "accurate velocity iterations", GetPhysicsVelocityIterations(), 16
Check "accurate substeps", GetPhysicsSubsteps(), 2
CheckTrue "accurate continuous", GetPhysicsContinuousDefault() = 1
PhysicsSolver 1
Check "fast velocity iterations", GetPhysicsVelocityIterations(), 4
PhysicsSolver 0
PhysicsVelocityIterations 12
CheckTrue "a value by hand is custom", GetPhysicsSolver() = 3
PhysicsSolver 0
PhysicsPositionIterations 3
PhysicsSubsteps 1
PhysicsContactSlop 0.02
PhysicsBaumgarte 0.2
PhysicsSpeculativeDistance 0.02
PhysicsSleepThreshold 0.03
PhysicsWorldSleeping 1
PhysicsContinuousDefault 0
PhysicsDeterministic 1
PhysicsThreads 0
CheckTrue "threads", GetPhysicsThreads() = 0
PhysicsSolver 0
PhysicsRate 60
PhysicsMaxSteps 8
PhysicsMaxDelta 1.0 / 15.0
PhysicsGravity 0, -9.81, 0

; ---- A fall, in frame steps and in fixed steps
PhysicsMode 1
box = CreatePhysicsBody(1, 3, 0.5, 0.5, 0.5)
PositionEntity box, 0, 100, 0
CheckTrue "motion of a body", GetPhysicsBodyMotion(box) = 3
CheckTrue "shape of a body", GetPhysicsBodyShape(box) = 1
CheckTrue "a body is in the default world", GetPhysicsBodyWorld(box) = 0
PhysicsLinearDamping box, 0
PhysicsAngularDamping box, 0
Check "linear damping", GetPhysicsLinearDamping(box), 0
Check "angular damping", GetPhysicsAngularDamping(box), 0
Steps 60
; Semi-implicit Euler: y = y0 - g * dt^2 * n * (n + 1) / 2
Check "frame steps fall", EntityY(box), 100 - 9.81 * DT * DT * 60 * 61 / 2, 0.05
Check "falling speed", GetPhysicsLinearVelocityY(box, True), -9.81, 0.05
FreeEntity box

PhysicsMode 0
box = CreatePhysicsBody(1, 3, 0.5, 0.5, 0.5)
PositionEntity box, 0, 100, 0
PhysicsLinearDamping box, 0
Steps 60
Check "fixed steps fall", EntityY(box), 100 - 9.81 * DT * DT * 60 * 61 / 2, 0.05
; Half a step does nothing, the rest is kept for the next call.
y# = EntityY(box)
PhysicsUpdate DT * 0.5
Check "half a step", EntityY(box), y, 0.00001
PhysicsUpdate DT * 0.5
CheckTrue "the other half", EntityY(box) < y - 0.001
; A long pause is capped at PhysicsMaxSteps steps.
y = EntityY(box)
PhysicsUpdate 10
CheckTrue "a long pause is capped", y - EntityY(box) < 3
FreeEntity box

; ---- Rest, sleep and the floor
floor = CreatePhysicsBody(1, 1, 20, 0.5, 20)
PositionEntity floor, 0, -0.5, 0
ball = CreatePhysicsBody(2, 3, 0.5, 0, 0)
PositionEntity ball, 0, 3, 0
CheckTrue "awake while it falls", GetPhysicsAwake(ball) = 1
Steps 300
Check "ball on the floor", EntityY(ball), 0.5, 0.05
CheckTrue "asleep when it rests", GetPhysicsAwake(ball) = 0
PhysicsWake ball
CheckTrue "woken", GetPhysicsAwake(ball) = 1
FreeEntity ball

; ---- Restitution
PhysicsRestitution floor, 1
Check "restitution", GetPhysicsRestitution(floor), 1
ball = CreatePhysicsBody(2, 3, 0.5, 0, 0)
PositionEntity ball, 0, 5.5, 0
PhysicsRestitution ball, 1
PhysicsLinearDamping ball, 0
top# = 0
bounced = False
For i = 1 To 240
	PhysicsUpdate DT
	If GetPhysicsLinearVelocityY(ball, True) > 0 Then bounced = True
	If bounced And EntityY(ball) > top Then top = EntityY(ball)
Next
CheckTrue "bounces back up", top > 4.2
FreeEntity ball
PhysicsRestitution floor, 0

; ---- Mass, friction and material
crate = CreatePhysicsBody(1, 3, 0.5, 0.5, 0.5)
PositionEntity crate, 5, 0.5, 0
Check "default mass", GetPhysicsMass(crate), 1
PhysicsMass crate, 4
Check "mass", GetPhysicsMass(crate), 4
PhysicsFriction crate, 0.7
Check "friction", GetPhysicsFriction(crate), 0.7, 0.0001
Check "default gravity scale", GetPhysicsGravityScale(crate), 1
PhysicsGravityScale crate, 0
Check "gravity scale", GetPhysicsGravityScale(crate), 0
Steps 60
Check "no gravity, no fall", EntityY(crate), 0.5, 0.01
FreeEntity crate

; ---- Velocities, local and global
PhysicsGravity 0, 0, 0
Check "gravity set", GetPhysicsGravityY(), 0
body = CreatePhysicsBody(1, 3, 0.5, 0.5, 0.5)
PositionEntity body, 0, 10, 0
PhysicsLinearDamping body, 0
PhysicsAngularDamping body, 0
PhysicsLinearVelocity body, 1, 2, 3, True
Check "velocity x", GetPhysicsLinearVelocityX(body, True), 1, 0.0001
Check "velocity y", GetPhysicsLinearVelocityY(body, True), 2, 0.0001
Check "velocity z", GetPhysicsLinearVelocityZ(body, True), 3, 0.0001
Steps 60
Check "moved x", EntityX(body), 1, 0.01
Check "moved y", EntityY(body), 12, 0.01
Check "moved z", EntityZ(body), 3, 0.01

; Local numbers are in the space of the body: forward is where the body faces.
PhysicsLinearVelocity body, 0, 0, 0, True
RotateEntity body, 0, 90, 0
PhysicsUpdate DT
PhysicsLinearVelocity body, 0, 0, 5
Check "local forward in the world x", GetPhysicsLinearVelocityX(body, True), -5, 0.001
Check "local forward in the world z", GetPhysicsLinearVelocityZ(body, True), 0, 0.001
Check "local forward is z", GetPhysicsLinearVelocityZ(body), 5, 0.001
PhysicsLinearVelocity body, 0, 0, 0, True

; Turning is in the direction of TurnEntity: a positive yaw turns left, 90 degrees per second for a second.
RotateEntity body, 0, 0, 0
PhysicsUpdate DT
PhysicsAngularVelocity body, 0, 90, 0, True
Check "turning y back", GetPhysicsAngularVelocityY(body, True), 90, 0.001
Check "turning x", GetPhysicsAngularVelocityX(body, True), 0, 0.001
Check "turning z", GetPhysicsAngularVelocityZ(body, True), 0, 0.001
yaw0# = EntityYaw(body)
Steps 30
CheckTrue "yaw grows with positive yaw velocity", EntityYaw(body) > yaw0 + 40
Check "yaw after half a second", EntityYaw(body) - yaw0, 45, 3
PhysicsAngularVelocity body, 0, 0, 0
FreeEntity body

; ---- Forces and impulses
body = CreatePhysicsBody(1, 3, 0.5, 0.5, 0.5)
PhysicsMass body, 2
PhysicsLinearDamping body, 0
PhysicsAngularDamping body, 0
PhysicsApplyImpulse body, 10, 0, 0, True
Check "impulse", GetPhysicsLinearVelocityX(body, True), 5, 0.001
PhysicsLinearVelocity body, 0, 0, 0, True
For i = 1 To 60
	PhysicsApplyForce body, 4, 0, 0, True
	PhysicsUpdate DT
Next
Check "force over a second", GetPhysicsLinearVelocityX(body, True), 2, 0.03
PhysicsLinearVelocity body, 0, 0, 0, True
For i = 1 To 30
	PhysicsApplyTorque body, 0, 1, 0, True
	PhysicsUpdate DT
Next
CheckTrue "torque turns it left", GetPhysicsAngularVelocityY(body, True) > 1
PhysicsAngularVelocity body, 0, 0, 0, True
PhysicsApplyImpulseAt body, 0, 0, 1, 1, 0, 0
CheckTrue "an impulse at a point turns it", Abs(GetPhysicsAngularVelocityY(body, True)) + Abs(GetPhysicsAngularVelocityX(body, True)) + Abs(GetPhysicsAngularVelocityZ(body, True)) > 0.1
PhysicsAngularVelocity body, 0, 0, 0, True
PhysicsApplyAngularImpulse body, 0, 1, 0, True
CheckTrue "a turning impulse", GetPhysicsAngularVelocityY(body, True) > 0
PhysicsApplyForceAt body, 0, 0, 1, 1, 0, 0
PhysicsUpdate DT
FreeEntity body
PhysicsGravity 0, -9.81, 0

; ---- Layers and masks
FreeEntity floor
floor = CreatePhysicsBody(1, 1, 20, 0.5, 20)
PositionEntity floor, 0, -0.5, 0
PhysicsLayer floor, 2, -1, -1
CheckTrue "layer", GetPhysicsLayer(floor) = 2
ghost = CreatePhysicsBody(2, 3, 0.5, 0, 0)
PositionEntity ghost, 0, 2, 0
PhysicsLayer ghost, 1, ~(1 Shl 2), -1
CheckTrue "mask low", GetPhysicsMaskLow(ghost) = ~(1 Shl 2)
CheckTrue "mask high", GetPhysicsMaskHigh(ghost) = -1
solid = CreatePhysicsBody(2, 3, 0.5, 0, 0)
PositionEntity solid, 5, 2, 0
PhysicsLayer solid, 3
Steps 120
CheckTrue "a ghost falls through", EntityY(ghost) < -3
Check "a solid body lands", EntityY(solid), 0.5, 0.05
FreeEntity ghost
FreeEntity solid

; ---- Sensors and sleeping
PhysicsSleeping floor, False
region = CreatePhysicsBody(1, 1, 5, 1, 5)
PositionEntity region, 0, 6, 0
PhysicsSensor region, True
CheckTrue "sensor", GetPhysicsSensor(region) = 1
falling = CreatePhysicsBody(2, 3, 0.5, 0, 0)
PositionEntity falling, 0, 10, 0
PhysicsContinuous falling, 1
CheckTrue "continuous", GetPhysicsContinuous(falling) = 1
Steps 120
CheckTrue "a sensor does not stop anything", EntityY(falling) < 1
FreeEntity region
FreeEntity falling

; ---- Bodies from entities
rock = CreateCube()
ScaleEntity rock, 1, 2, 1
PositionEntity rock, 0, 10, 0
RotateEntity rock, 0, 30, 0
shell = CreatePhysicsBodyFromEntity(rock, 3, 1)
CheckTrue "a box from a cube", GetPhysicsBodyShape(shell) = 1
Check "the entity is left where it was", EntityY(rock), 10, 0.0001
Check "the body is where the cube is", EntityY(shell), 10, 0.01
EntityParent rock, shell, True
Check "still where it was", EntityY(rock, True), 10, 0.01
Steps 90
CheckTrue "the cube follows its body", EntityY(rock, True) < 9
Check "the cube is on its body", EntityY(rock, True), EntityY(shell, True), 0.01
hull = CreatePhysicsBodyFromEntity(CreateSphere(8), 3, 4)
CheckTrue "a hull", GetPhysicsBodyShape(hull) = 7
PositionEntity hull, 0, 3, 0
Steps 200
Check "a hull rests on the floor", EntityY(hull), 1, 0.2
level = CreateCube()
ScaleEntity level, 3, 0.5, 3
PositionEntity level, 20, 0, 0
slab = CreatePhysicsBodyFromEntity(level, 1)
CheckTrue "a mesh body is static", GetPhysicsBodyMotion(slab) = 1
CheckTrue "a mesh", GetPhysicsBodyShape(slab) = 8
PhysicsBodyMotion slab, 2
CheckTrue "a mesh turns kinematic", GetPhysicsBodyMotion(slab) = 2
FreeEntity shell
FreeEntity hull
FreeEntity slab
FreeEntity level

; ---- Worlds apart from each other
other = CreatePhysicsWorld()
CheckTrue "a world has a number", other > 0
PhysicsGravity 0, -1, 0, other
Check "gravity of the other world", GetPhysicsGravityY(other), -1
Check "gravity of the default world", GetPhysicsGravityY(), -9.81
PhysicsMode 1, other
CheckTrue "mode of the other world", GetPhysicsMode(other) = 1
CheckTrue "mode of the default world", GetPhysicsMode() = 0
PhysicsRate 30, other
Check "rate of the other world", GetPhysicsRate(other), 30
dropped = CreatePhysicsBody(2, 3, 0.5, 0, 0, 0, other)
PositionEntity dropped, 0, 20, 0
CheckTrue "body in the other world", GetPhysicsBodyWorld(dropped) = other
; The floor of the default world is not in the other one: the ball falls through the place of the floor.
PositionEntity dropped, 0, 1, 0
For i = 1 To 120
	PhysicsUpdate DT, other
Next
CheckTrue "other worlds have their own bodies", EntityY(dropped) < -0.5
PhysicsBodyWorld dropped, 0
CheckTrue "moved to the default world", GetPhysicsBodyWorld(dropped) = 0
FreePhysicsWorld other
FreeEntity dropped

; Freeing a world leaves its entities, without a body.
third = CreatePhysicsWorld(100)
kept = CreatePhysicsBody(1, 3, 1, 1, 1, 0, third)
FreePhysicsWorld third
PositionEntity kept, 1, 2, 3
Check "an entity stays after its world", EntityY(kept), 2
FreeEntity kept

FreeEntity floor
Done "blitz3d_physics"
