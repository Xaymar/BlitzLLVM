; Picking in a scene with many entities that change between picks (the picks look at the entities near the line only, and have to
; notice every change): PositionEntity ScaleEntity HideEntity ShowEntity EntityPickMode EntityParent FreeEntity CreateCube ScaleMesh
; EntityBox EntityRadius LinePick EntityPick EntityVisible PickedEntity.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; 80 cubes in a row along x, 4 apart, that can be picked by their polygons.
Dim c(80)
For i = 1 To 80
	c(i) = CreateCube()
	PositionEntity c(i), i * 4, 0, 0
	EntityPickMode c(i), 2
Next

; Far above them, 300 more that no line here comes near: enough entities for the picks to look only at the ones near the line.
Dim filler(300)
For i = 1 To 300
	filler(i) = CreateCube()
	PositionEntity filler(i), i * 4, 1000, 0
	EntityPickMode filler(i), 2
Next

; The first thing along the line, starting at x = 2.
Function Along(x#)
	Return LinePick(x, 0, 0, 400, 0, 0)
End Function

Check "The first cube", Along(0), c(1)
Check "The cube after it", Along(6), c(2)
Check "The same again", Along(0), c(1)

; Hidden and shown.
HideEntity c(1)
Check "A hidden cube is not picked", Along(0), c(2)
ShowEntity c(1)
Check "A shown cube is picked", Along(0), c(1)

; Moved away and back.
PositionEntity c(1), 4, 50, 0
Check "A cube that moved away", Along(0), c(2)
PositionEntity c(1), 4, 0, 0
Check "A cube that moved back", Along(0), c(1)

; Pick modes.
EntityPickMode c(1), 0
Check "A cube that can not be picked", Along(0), c(2)
EntityPickMode c(1), 2
Check "A cube that can be picked again", Along(0), c(1)

; Scale, which also makes a miss into a hit.
Check "A line above the cubes", LinePick(0, 3, 0, 400, 0, 0), 0
ScaleEntity c(2), 1, 5, 1
Check "A cube that got taller", LinePick(0, 3, 0, 400, 0, 0), c(2)
ScaleEntity c(2), 1, 1, 1
Check "A cube that got small again", LinePick(0, 3, 0, 400, 0, 0), 0

; A mesh that changed.
Check "A line beside a cube", LinePick(0, 0, 3, 400, 0, 0), 0
ScaleMesh c(3), 1, 1, 5
Check "A cube whose mesh got deeper", LinePick(0, 0, 3, 400, 0, 0), c(3)
ScaleMesh c(3), 1, 1, 0.2
Check "A cube whose mesh got shallow again", LinePick(0, 0, 3, 400, 0, 0), 0

; A parent that moves.
pivot = CreatePivot()
EntityParent c(4), pivot
Check "A child before its parent moved", Along(14), c(4)
PositionEntity pivot, 0, 50, 0
Check "A child after its parent moved", Along(14), c(5)
HideEntity pivot
PositionEntity pivot, 0, 0, 0
Check "A child of a hidden parent", Along(14), c(5)
ShowEntity pivot
Check "A child of a shown parent", Along(14), c(4)

; Freed and created.
FreeEntity c(4)
Check "A cube that was freed", Along(14), c(5)
extra = CreateCube()
PositionEntity extra, 18, 0, 0
EntityPickMode extra, 2
Check "A cube that was made", Along(14), extra
FreeEntity extra

; Boxes and spheres.
EntityPickMode c(6), 3
EntityBox c(6), -1, -1, -1, 2, 2, 2
Check "A box", Along(20), c(6)
EntityBox c(6), -1, 4, -1, 2, 2, 2
Check "A box that moved up", Along(20), c(7)
EntityPickMode c(6), 1
PositionEntity c(6), 24, 0.5, 0
EntityRadius c(6), 1
Check "A sphere", Along(20), c(6)
EntityRadius c(6), 0.2
Check "A smaller sphere", Along(20), c(7)
EntityPickMode c(6), 2
PositionEntity c(6), 24, 0, 0

; Everything moves between picks (the freed cube is made again).
c(4) = CreateCube()
EntityPickMode c(4), 2
For round = 1 To 50
	For i = 1 To 80
		PositionEntity c(i), i * 4, round * 0.1, 0
	Next
	Check "All moved " + round, LinePick(0, round * 0.1, 0, 400, 0, 0), c(1)
	Check "All moved, visible " + round, EntityVisible(c(1), c(80)), 0
Next

; Many picks without a change.
For round = 1 To 200
	CheckTrue "Many picks " + round, LinePick(0, 5, 0, 400, 0, 0) = c(1)
Next

EndGraphics
Done "blitz3d_pick_changes"
