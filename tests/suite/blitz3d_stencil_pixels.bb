; SetCameraStencil gives a camera a stencil, SetEntityStencil makes entities write and test it, and SetCameraStencilClear says what
; it starts as. It needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_stencil_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Blue(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

Function Green(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0

; The mask is a green cube on the left. Its order draws it before everything else, without depth, so that what comes after is
; drawn over it where the stencil lets it.
mask = CreateCube()
EntityFX mask, 1
EntityColor mask, 0, 255, 0
EntityOrder mask, 1
PositionEntity mask, -3, 0, 10
ScaleEntity mask, 2, 2, 2

; A blue wall over everything.
wall = CreateCube()
EntityFX wall, 1
EntityColor wall, 0, 0, 255
PositionEntity wall, 0, 0, 20
ScaleEntity wall, 30, 30, 1

; Without stencil the entities have none, whatever they ask for.
SetEntityStencil mask, 7, 1, 255, 255, 0, 0, 2
SetEntityStencil wall, 2, 1
Check "A new camera has no stencil", GetCameraStencil(camera), 0, 0
RenderWorld
Check "Without stencil the wall is on the left", Blue(40, 60), 255, 8
Check "Without stencil the wall is on the right", Blue(120, 60), 255, 8

; With stencil the mask marks its pixels with 1, and the wall is only drawn where the stencil is 1.
SetCameraStencil camera, True
Check "GetCameraStencil", GetCameraStencil(camera), 1, 0
RenderWorld
Check "The wall is drawn where the mask marked the stencil", Blue(40, 60), 255, 8
Check "The wall is not drawn where the stencil is 0", Blue(120, 60), 0, 8
Check "Nothing is drawn where the stencil is 0", Green(120, 60), 0, 8

; Not equal: the wall is drawn everywhere but where the mask is, and the mask stays visible there.
SetEntityStencil wall, 5, 1
RenderWorld
Check "Not equal leaves out the marked pixels", Blue(40, 60), 0, 8
Check "The mask shows where the wall was left out", Green(40, 60), 255, 8
Check "Not equal draws where the stencil is 0", Blue(120, 60), 255, 8

; The stencil starts as 1 everywhere: equal to 1 draws the wall everywhere.
SetEntityStencil wall, 2, 1
SetCameraStencilClear camera, True, 1
RenderWorld
Check "A stencil cleared to 1 lets the wall through on the right", Blue(120, 60), 255, 8

; The mask increments, so its pixels become 2, and the wall tests for 2.
SetEntityStencil mask, 7, 0, 255, 255, 0, 0, 3
SetEntityStencil wall, 2, 2
RenderWorld
Check "Increment makes 2 where the mask is", Blue(40, 60), 255, 8
Check "Elsewhere the stencil stays 1", Blue(120, 60), 0, 8

; The read mask: with only bit 1 compared, 2 and 3 are the same.
SetEntityStencil wall, 2, 3, 2
RenderWorld
Check "The read mask leaves out the other bits", Blue(40, 60), 255, 8

; The write mask: the mask writes 255 with only bit 2 kept, which is 4 on a stencil of 1, so it becomes 5.
SetEntityStencil mask, 7, 255, 255, 4, 0, 0, 2
SetEntityStencil wall, 2, 5
RenderWorld
Check "The write mask keeps the bits outside of it", Blue(40, 60), 255, 8

; Without clearing, the stencil of the last frame stays: the mask replaced its pixels with 5 (1 Or 4), and they still are.
SetCameraStencilClear camera, False
SetEntityStencil mask, 7
RenderWorld
Check "A stencil that is not cleared keeps what was drawn", Blue(40, 60), 255, 8

; Clearing again (to 1) takes away the 5 of the frames before.
SetCameraStencilClear camera, True, 1
RenderWorld
Check "A cleared stencil has nothing of the frames before", Blue(40, 60), 0, 8

; Turning the stencil off again: the wall is everywhere.
SetCameraStencil camera, False
RenderWorld
Check "A camera without stencil again ignores it", Blue(120, 60), 255, 8

Done "blitz3d_stencil_pixels"
