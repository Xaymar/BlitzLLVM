; What TrueType fonts put on the screen, which needs a window and a GPU, so this is skipped without one: LoadFont SetFont
; FreeFont Text StringWidth StringHeight FontHeight FontAscent FontDescent. The font in the file has one letter, a solid
; block 500 of 1000 units wide and 800 high that sits on the baseline, and a space.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_fonts_pixels: skipped, there is no window."
	End
EndIf

Graphics 320, 240, 32, 2
SetBuffer BackBuffer()

Function Px(x, y)
	Return ReadPixel(x, y) And $FFFFFF
End Function

font = LoadFont("images/fixture.ttf", 100)
CheckTrue "LoadFont of a file", font <> 0
SetFont font
Check "FontHeight of a file", FontHeight(), 100
Check "FontAscent of a file", FontAscent(font), 80
Check "FontDescent of a file", FontDescent(font), 20
Check "StringWidth of a letter", StringWidth("A"), 70
Check "StringWidth of a space", StringWidth(" "), 50
Check "StringWidth of a text", StringWidth("A A"), 190
Check "StringHeight of a file", StringHeight("A"), 100

Color 255, 255, 255
Cls
Color 255, 0, 0
Text 0, 0, "A"
Check "The letter is drawn", Px(30, 40), $FF0000
Check "The letter is not drawn left of it", Px(5, 40), 0
Check "The letter is not drawn right of it", Px(65, 40), 0
Check "The letter is not drawn under the baseline", Px(30, 90), 0
Check "The letter is drawn up to the top", Px(30, 2), $FF0000
Text 100, 0, "A A"
Check "The second letter is further on", Px(100 + 120 + 30, 40), $FF0000
Check "The space has nothing in it", Px(100 + 70 + 25, 40), 0

; Text that is centered is centered on the width of the font.
Cls
Text 160, 120, "A", True, False
Check "Text centered across", Px(160, 160), $FF0000
Check "Text is not left of its center", Px(160 - 40, 160), 0

; A font that is not found still is a font, which is drawn with the built-in letters in the height that was asked for.
missing = LoadFont("images/missing.ttf", 20)
CheckTrue "LoadFont of a missing file", missing <> 0
SetFont missing
Check "FontHeight of a missing file", FontHeight(), 20
FreeFont missing
SetFont font
FreeFont font
SetFont 0
Check "The built-in font after FreeFont", FontHeight(), 8

Done "graphics_fonts_pixels"
