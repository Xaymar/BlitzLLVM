; CaptureWorld remembers the alpha and the color of an entity as well as where it is, and RenderWorld with a tween draws them
; between that and what they are now. The panel is a fullbright box in front of a black background, so the red value in the
; middle of the picture is 255 times its alpha times its red, and the blue value likewise.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_capture_world_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 64, 64, 32, 2
SetBuffer BackBuffer()
camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100

panel = CreateCube()
ScaleEntity panel, 3, 3, 0.1
PositionEntity panel, 0, 0, 5
EntityFX panel, 1

Function Red()
	Return (ReadPixel(32, 32, BackBuffer()) Shr 16) And 255
End Function

Function Blue()
	Return ReadPixel(32, 32, BackBuffer()) And 255
End Function

; Alpha: it is solid at CaptureWorld and gone afterwards.
EntityColor panel, 255, 0, 0
EntityAlpha panel, 1.0
CaptureWorld
EntityAlpha panel, 0.0

RenderWorld 1.0
Check "A tween of 1 draws the alpha it is now", Red(), 0, 2
RenderWorld 0.0
Check "A tween of 0 draws the alpha of CaptureWorld", Red(), 255, 2
RenderWorld 0.5
Check "A tween of a half draws half of the alpha", Red(), 128, 4
RenderWorld 0.25
Check "A tween of a quarter is three quarters of the old alpha", Red(), 191, 4

; Color: red at CaptureWorld and blue afterwards, both solid.
EntityAlpha panel, 1.0
CaptureWorld
EntityColor panel, 0, 0, 255

RenderWorld 1.0
Check "A tween of 1 draws the color it is now (red)", Red(), 0, 2
Check "A tween of 1 draws the color it is now (blue)", Blue(), 255, 2
RenderWorld 0.0
Check "A tween of 0 draws the color of CaptureWorld (red)", Red(), 255, 2
Check "A tween of 0 draws the color of CaptureWorld (blue)", Blue(), 0, 2
RenderWorld 0.5
Check "A tween of a half is half way between the colors (red)", Red(), 128, 4
Check "A tween of a half is half way between the colors (blue)", Blue(), 128, 4

Done "blitz3d_capture_world_pixels"
End
