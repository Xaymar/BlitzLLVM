; DitherMode 1 dithers the shown picture with a Bayer matrix instead of Interleaved Gradient Noise. A color that a gamma table
; makes 100.3 (a fraction of 0.3 above a step of 8 bits) is shown as 101 where the threshold of the matrix is 0.7 or more, and as
; 100 elsewhere, so every pixel can be compared with a copy of the function in this file. This needs a window and a GPU, so it
; is skipped without one. BLITZLLVM_TEST_PRESENT makes the runtime write what it showed to a file after every present.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_dither_mode_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 48

; The values of the red channel of the picture the runtime wrote.
Dim shown(W * H)
Function ReadShown()
	f = ReadFile("present.tmp")
	If f = 0 Then RuntimeError "Nothing was presented."
	For line = 1 To 3
		ReadLine$(f)
	Next
	For i = 0 To W * H - 1
		shown(i) = ReadByte(f)
		ReadByte(f)
		ReadByte(f)
	Next
	CloseFile f
End Function

; a - b * floor(a / b), which is what mod is in GLSL.
Function FMod#(a#, b#)
	Return a - b * Floor(a / b)
End Function

; The threshold of the Bayer matrix of a pixel, the same as the function that DitherMode follows, with the frame of the picture
; (0 if it does not move): the pattern moves by frame mod levels in x and frame mod (levels / 2) in y, and its thresholds rise.
Function Bayer#(x, y, levels, frame)
	sx# = x + (frame Mod levels)
	half = levels / 2
	If half < 1 Then half = 1
	sy# = y - (frame Mod half)
	value# = 0
	divisor# = 0
	mul# = 1
	For level = levels To 1 Step -1
		mul = mul * 4
		scale# = 2.0 ^ (1 - level)
		bx# = FMod(Floor(sx * scale), 2)
		by# = FMod(Floor(sy * scale), 2)
		x2# = bx * 2
		value = value + (x2 + (3 - x2 - x2) * by) / 3 * mul
		divisor = divisor + mul
	Next
	thresh# = value / divisor
	colors# = 4.0 ^ levels
	; The thresholds are rank / (colors - 1), and the frame moves every pixel to the rank that is frame further, and around.
	rank = Floor(thresh * (colors - 1) + 0.5)
	rank = FMod(rank + (frame Mod Int(colors)), colors)
	Return rank / (colors - 1)
End Function

; How many pixels of the picture differ from what the function says for a fraction of 0.3 above 100.
Function Wrong(levels, frame)
	ReadShown()
	count = 0
	For y = 0 To H - 1
		For x = 0 To W - 1
			expected = 100
			If Bayer(x, y, levels, frame) >= 0.7 Then expected = 101
			If shown(y * W + x) <> expected Then count = count + 1
		Next
	Next
	Return count
End Function

SetEnv "BLITZLLVM_TEST_PRESENT", "present.tmp"
Graphics W, H, 32, 2
SetBuffer BackBuffer()
Color 100, 100, 100
Rect 0, 0, W, H, 1
SetGamma 100, 100, 100, 100.3, 100.3, 100.3
UpdateGamma

; Every picture that is shown moves the pattern, and the window shows one before the program starts, so which picture this is
; has to be found: the one that the pattern of the first Flip is the pattern of.
Dither True
DitherMode 1, 1
Flip 2
base = -1
For frame = 0 To 3
	If base < 0 And Wrong(1, frame) = 0 Then base = frame
Next
CheckTrue "DitherMode 1, 1 is the 2x2 matrix of one of the first pictures", base >= 0
If base < 0 Then base = 0
Flip 2
Check "the matrix of the next picture is moved", Wrong(1, base + 1), 0
frame = base + 2
For levels = 2 To 4
	DitherMode 1, levels
	Flip 2
	Check "DitherMode 1, " + levels + " is the matrix of that level", Wrong(levels, frame), 0
	frame = frame + 1
Next

; A matrix has all of its thresholds once in the pixels it covers, so about 3 of 10 pixels are the step above.
DitherMode 1, 3
Flip 2
frame = frame + 1
ReadShown()
other = 0
For i = 0 To W * H - 1
	If shown(i) = 101 Then other = other + 1
Next
Check "the matrix spreads the fraction", other > (W * H) * 2 / 10 And other < (W * H) * 4 / 10, True

; A level that does not exist is moved to the nearest one, and DitherMode 0 is noise again.
DitherMode 1, 0
Flip 2
Check "level 0 is level 1", Wrong(1, frame), 0
frame = frame + 1
DitherMode 1, 99
Flip 2
; The thresholds of level 8 are closer than the float math of a GPU, so a few pixels may differ.
Check "level 99 is level 8", Wrong(8, frame) < (W * H) / 50, True
frame = frame + 1
DitherMode 0
Flip 2
Check "DitherMode 0 is noise, not the matrix", Wrong(8, frame) > (W * H) / 10, True

; With DitherTemporal off the matrix stays where it is: it is the one of picture 0 in every picture.
DitherTemporal False
DitherMode 1, 3
Flip 2
Check "without DitherTemporal the matrix is the one of the first picture", Wrong(3, 0), 0
Flip 2
Check "without DitherTemporal it stays in the next picture", Wrong(3, 0), 0
DitherTemporal True

Dither False
EndGraphics
DeleteFile "present.tmp"
Done "graphics_dither_mode_pixels"
