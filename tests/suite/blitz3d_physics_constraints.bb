; Constraints between physics bodies. Names: CreatePhysicsFixedConstraint CreatePhysicsPointConstraint CreatePhysicsHingeConstraint
; CreatePhysicsSliderConstraint CreatePhysicsDistanceConstraint CreatePhysicsConeConstraint FreePhysicsConstraint
; PhysicsConstraintLimits PhysicsConstraintMotor PhysicsConstraintSpring PhysicsConstraintBreakForce GetPhysicsConstraintBroken.
Include "check.bb"

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Const DT# = 1.0 / 60.0

Function Steps(count, world = 0)
	For i = 1 To count
		PhysicsUpdate DT, world
	Next
End Function

Function Dist#(entity, x#, y#, z#)
	Return Sqr((EntityX(entity, True) - x) ^ 2 + (EntityY(entity, True) - y) ^ 2 + (EntityZ(entity, True) - z) ^ 2)
End Function

; ---- A ball on a rope of a point constraint swings and keeps its distance
ball = CreatePhysicsBody(2, 3, 0.25, 0, 0)
PositionEntity ball, 2, 0, 0
c = CreatePhysicsPointConstraint(ball, 0, 0, 0, 0)
Steps 50
CheckTrue "it swung down", EntityY(ball) < -1.5
Steps 70
Check "it keeps its distance", Dist(ball, 0, 0, 0), 2, 0.05
FreePhysicsConstraint c
Steps 60
CheckTrue "free of the constraint it falls", EntityY(ball) < -3
FreeEntity ball

; ---- A hinge with limits
box = CreatePhysicsBody(1, 3, 0.25, 0.25, 0.25)
PositionEntity box, 1, 0, 0
c = CreatePhysicsHingeConstraint(box, 0, 0, 0, 0, 0, 0, 1)
PhysicsConstraintLimits c, -30, 30
Steps 180
Check "the hinge keeps z", EntityZ(box), 0, 0.02
Check "the hinge keeps its radius", Dist(box, 0, 0, 0), 1, 0.05
CheckTrue "the hinge stops at its limit", EntityY(box) < -0.3 And EntityY(box) > -0.55
CheckTrue "not broken", GetPhysicsConstraintBroken(c) = 0
FreeEntity box
; The constraint is gone with its body.
Steps 1

; ---- A slider with a motor
slide = CreatePhysicsBody(1, 3, 0.25, 0.25, 0.25)
PhysicsGravityScale slide, 0
c = CreatePhysicsSliderConstraint(slide, 0, 1, 0, 0)
PhysicsConstraintMotor c, 1, 2, 10000
Steps 60
Check "the slider moves at 2 per second", EntityX(slide), 2, 0.2
Check "the slider keeps y", EntityY(slide), 0, 0.02
PhysicsConstraintMotor c, 0, 0, 0
PhysicsConstraintLimits c, -1, 3
PhysicsConstraintSpring c, 5, 1
FreePhysicsConstraint c
FreeEntity slide

; ---- Two bodies welded
floor = CreatePhysicsBody(1, 1, 50, 0.5, 50)
PositionEntity floor, 0, -0.5, 0
a = CreatePhysicsBody(1, 3, 0.25, 0.25, 0.25)
PositionEntity a, 0, 3, 0
b = CreatePhysicsBody(1, 3, 0.25, 0.25, 0.25)
PositionEntity b, 1, 3, 0
c = CreatePhysicsFixedConstraint(a, b)
Steps 240
Check "welded apart", Dist(a, EntityX(b, True), EntityY(b, True), EntityZ(b, True)), 1, 0.05
Check "welded level", EntityY(a), EntityY(b), 0.05
FreeEntity a
FreeEntity b
FreeEntity floor

; ---- A rod (distance constraint)
rod = CreatePhysicsBody(2, 3, 0.25, 0, 0)
PositionEntity rod, 3, 0, 0
c = CreatePhysicsDistanceConstraint(rod, 0, 0, 0, 0, 3, 3)
Steps 120
Check "the rod keeps its length", Dist(rod, 0, 0, 0), 3, 0.05
PhysicsConstraintLimits c, 1, 2
PhysicsConstraintSpring c, 3, 0.5
FreeEntity rod

; ---- A cone
cone = CreatePhysicsBody(2, 3, 0.25, 0, 0)
PositionEntity cone, 0, -1, 0
c = CreatePhysicsConeConstraint(cone, 0, 0, 0, 0, 0, -1, 0, 30)
PhysicsConstraintLimits c, 0, 20
Steps 60
Check "the cone keeps the distance", Dist(cone, 0, 0, 0), 1, 0.05
FreeEntity cone

; ---- A constraint that breaks
weak = CreatePhysicsBody(2, 3, 0.25, 0, 0)
PositionEntity weak, 0, 20, 0
PhysicsMass weak, 10
strong = CreatePhysicsBody(2, 3, 0.25, 0, 0)
PositionEntity strong, 5, 20, 0
PhysicsMass strong, 10
cw = CreatePhysicsPointConstraint(weak, 0, 0, 20, 0)
cs = CreatePhysicsPointConstraint(strong, 0, 5, 20, 0)
PhysicsConstraintBreakForce cw, 5
PhysicsConstraintBreakForce cs, 100000
Steps 90
CheckTrue "the weak one broke", GetPhysicsConstraintBroken(cw) = 1
CheckTrue "the strong one holds", GetPhysicsConstraintBroken(cs) = 0
CheckTrue "the weak ball fell", EntityY(weak) < 15
Check "the strong ball hangs", EntityY(strong), 20, 0.05
FreeEntity weak
FreeEntity strong

; ---- Constraints of other worlds
other = CreatePhysicsWorld()
o1 = CreatePhysicsBody(2, 3, 0.25, 0, 0, 0, other)
o2 = CreatePhysicsBody(2, 3, 0.25, 0, 0, 0, other)
c = CreatePhysicsFixedConstraint(o1, o2)
FreePhysicsWorld other

Done "blitz3d_physics_constraints"
