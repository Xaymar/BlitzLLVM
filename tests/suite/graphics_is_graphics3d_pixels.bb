; Graphics and Graphics3D are the same command: the 3D commands work after Graphics, and either one can be called again
; after the other. It needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_is_graphics3d_pixels: skipped, there is no window."
	End
EndIf

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

Function DrawCube()
	camera = CreateCamera()
	CameraClsColor camera, 0, 0, 0
	PositionEntity camera, 0, 0, -10
	cube = CreateCube()
	EntityFX cube, 1
	EntityColor cube, 255, 0, 0
	RenderWorld
	CheckTrue "A cube is drawn", R(80, 60) > 200
	FreeEntity cube
	FreeEntity camera
End Function

; A 3D scene after Graphics.
Graphics 160, 120, 32, 2
SetBuffer BackBuffer()
Check "Graphics width", GraphicsWidth(), 160, 0
Check "Graphics height", GraphicsHeight(), 120, 0
DrawCube()

; Graphics3D after Graphics, and Graphics after Graphics3D.
Graphics3D 200, 100, 32, 2
SetBuffer BackBuffer()
Check "Graphics3D width", GraphicsWidth(), 200, 0
Check "Graphics3D height", GraphicsHeight(), 100, 0
Graphics 160, 120, 32, 2
SetBuffer BackBuffer()
Check "Graphics again width", GraphicsWidth(), 160, 0
DrawCube()

Done "graphics_is_graphics3d_pixels"
