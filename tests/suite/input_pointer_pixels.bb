; HidePointer, ShowPointer and SetPointer with a window, which needs a window and a GPU, so this is skipped without one.
; BLITZLLVM_TEST_POINTER makes the runtime write, each time it changes the pointer, if SDL shows it and if the change was
; made on the thread that owns the windows. On Windows a change made on another thread is lost: the pointer stayed visible
; in a game that hides it and holds the mouse with MoveMouse. The run with BLITZLLVM_WINDOW_THREAD=1 checks that case.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "input_pointer_pixels: skipped, there is no window."
	End
EndIf

; What the runtime wrote the last time it changed the pointer: "<shown> <on the thread of the windows>".
Function PointerState$(name$)
	f = ReadFile("pointer.tmp")
	If f = 0 Then RuntimeError name + ": the pointer state was not written."
	state$ = ReadLine$(f)
	CloseFile f
	DeleteFile "pointer.tmp"
	Return state
End Function

SetEnv "BLITZLLVM_TEST_POINTER", "pointer.tmp"

Graphics 160, 120, 32, 2
SetBuffer BackBuffer()

HidePointer
CheckS "HidePointer", PointerState$("HidePointer"), "0 1"
ShowPointer
CheckS "ShowPointer", PointerState$("ShowPointer"), "1 1"

; SetPointer 0 hides it as well, another pointer shows it again.
SetPointer 0
CheckS "SetPointer 0", PointerState$("SetPointer 0"), "0 1"
SetPointer 2
CheckS "SetPointer 2", PointerState$("SetPointer 2"), "1 1"
SetPointer 1

; MoveMouse holds the mouse in the middle of the window (as a game looking around does), which is changed on the thread of
; the windows as well. The pointer can still be shown and hidden while it is held.
MoveMouse 80, 60
dx = MouseXSpeed()
HidePointer
CheckS "HidePointer while the mouse is held", PointerState$("HidePointer while the mouse is held"), "0 1"
ShowPointer
CheckS "ShowPointer while the mouse is held", PointerState$("ShowPointer while the mouse is held"), "1 1"
HidePointer
CheckS "HidePointer again while the mouse is held", PointerState$("HidePointer again while the mouse is held"), "0 1"
MoveMouse 80, 60

; A hidden pointer stays hidden over EndGraphics and a new Graphics.
EndGraphics
Graphics 160, 120, 32, 2
CheckS "HidePointer survives Graphics", PointerState$("HidePointer survives Graphics"), "0 1"
ShowPointer
CheckS "ShowPointer after Graphics", PointerState$("ShowPointer after Graphics"), "1 1"

Done "input_pointer_pixels"
