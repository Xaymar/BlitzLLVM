; Calling Graphics or Graphics3D again frees what the program made, like the original: entities, brushes, textures, images and
; fonts are gone, and the old scene is not drawn any more. With keep (the fifth argument) all of it stays. EndGraphics always
; frees it. Needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_reopen_frees_pixels: skipped, there is no window."
	End
EndIf

; Builds a red cube in front of a camera, and an image, a font, a brush and a texture besides.
Function MakeScene()
	cam = CreateCamera()
	CameraClsColor cam, 0, 0, 0
	PositionEntity cam, 0, 0, -4
	cube = CreateCube()
	EntityColor cube, 255, 0, 0
	EntityFX cube, 1
	CreateImage(8, 8)
	LoadFont("Blitz", 12)
	CreateBrush(255, 255, 255)
	CreateTexture(8, 8)
End Function

; The color in the middle of the back buffer after RenderWorld.
Function MiddleColor()
	RenderWorld
	Return ReadPixel(GraphicsWidth() / 2, GraphicsHeight() / 2, BackBuffer()) And $FFFFFF
End Function

Graphics3D 64, 48, 32, 2
SetBuffer BackBuffer()
MakeScene()
Check "The red cube is drawn", MiddleColor(), $FF0000
Check "One image", ActiveObjects() > 0, 1
Check "One texture", ActiveTextures(), 1

; Again: the old scene is gone. A new camera sees nothing.
Graphics3D 64, 48, 32, 2
SetBuffer BackBuffer()
Check "Images, fonts and textures are freed", ActiveObjects(), 0
Check "Textures are freed", ActiveTextures(), 0
cam = CreateCamera()
CameraClsColor cam, 0, 0, 0
PositionEntity cam, 0, 0, -4
Check "The old cube is not drawn", MiddleColor(), 0
FreeEntity cam

; Graphics (the 2D name) does the same.
MakeScene()
Graphics 64, 48, 32, 2
SetBuffer BackBuffer()
Check "Graphics frees too", ActiveObjects(), 0
cam = CreateCamera()
CameraClsColor cam, 0, 0, 0
PositionEntity cam, 0, 0, -4
Check "Graphics frees the scene", MiddleColor(), 0
FreeEntity cam

; With keep, everything stays and is still drawn.
MakeScene()
count = ActiveObjects()
Graphics3D 96, 64, 32, 2, 1
SetBuffer BackBuffer()
Check "keep keeps images, fonts and textures", ActiveObjects(), count
Check "keep keeps textures", ActiveTextures(), 1
Check "keep keeps the scene", MiddleColor(), $FF0000

; EndGraphics frees everything, whatever keep was.
EndGraphics
Check "EndGraphics frees images, fonts and textures", ActiveObjects(), 0
Graphics3D 64, 48, 32, 2, 1
SetBuffer BackBuffer()
cam = CreateCamera()
CameraClsColor cam, 0, 0, 0
PositionEntity cam, 0, 0, -4
Check "EndGraphics frees the scene", MiddleColor(), 0

Done "graphics_reopen_frees_pixels"
