; Default values, Const, For and wrapping.
Function DefB:UByte(x:UByte = 250)
	Return x + 10
End Function
Function DefU:ULong(x:ULong = 18000000000000000000)
	Return x
End Function
Function DefH:Half(x:Half = 0.5)
	Return x * 3
End Function
CheckS "UByte default and wrap", Str(DefB()), "4"
CheckS "ULong default", Str(DefU()), "18000000000000000000"
CheckS "Half default", Str(DefH()), "1.5"
CheckS "UByte argument", Str(DefB(1)), "11"
Const KU:UInt = 4000000000
CheckS "UInt Const", Str(KU), "4000000000"
Local loop:Short, loops = 0
For loop = -2 To 2
	loops = loops + loop
Next
Check "Short For", loops, 0
Local wrap:UByte = 300
CheckS "UByte wraps", Str(wrap), "44"
Local all:ULong = -1
CheckS "ULong from -1", Str(all), "18446744073709551615"


; The short form of the types that have one.
Global gs% = -7
Global gl%% = -9000000000
Global gf# = 1.5
Global gd## = 0.1
Global gt$ = "short"
Function RetS%(a%)
	Return a + 1
End Function
Function RetL%%(a%%)
	Return a * 2
End Function
Function RetF#(a#)
	Return a * 2
End Function
Function RetD##(a##)
	Return a * 2
End Function
Function RetT$(a$)
	Return a + "!"
End Function
Check "short %", RetS(gs), -6
CheckS "short %%", Str(RetL(gl)), "-18000000000"
Check "short #", RetF(gf), 3
CheckS "short ##", Str(RetD(gd)), "0.2"
CheckS "short $", RetT(gt), "short!"

; Custom types
Function MakeBox.Box(tag%)
	Local b.Box = New Box
	b\tag = tag
	Return b
End Function
Function TagOf%(b.Box)
	Return b\tag
End Function
Function Same.Box(b.Box)
	Local l.Box = b
	Return l
End Function
Global gbox.Box = MakeBox(5)
Check "Type return", MakeBox(3)\tag, 3
Check "Type parameter", TagOf(gbox), 5
Check "Type global", gbox\tag, 5
Local lbox.Box = Same(gbox)
Check "Type local", TagOf(lbox), 5
CheckTrue "Type identity", Same(gbox) = gbox
Local nobox.Box = Same(Null)
CheckTrue "Type null", nobox = Null

Done "language_types"

