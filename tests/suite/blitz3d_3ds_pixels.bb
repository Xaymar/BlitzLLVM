; How models from .3ds files look, which needs a window and a GPU, so this is skipped without one: which side of a face is its
; front, the colors, see-through, two-sided and self-lit materials, and a picture that is tiled across a face.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_3ds_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

camera = CreateCamera()
CameraClsColor camera, 10, 20, 30
AmbientLight 0, 0, 0
; A light that shines down on the squares.
light = CreateLight()
TurnEntity light, 90, 0, 0

; Four squares in a row, 2 wide, with the middle of the picture at 80 for 8 pixels to the unit when the camera is 10 above them.
materials = LoadMesh("models/materials.3ds")
CheckTrue "LoadMesh of the materials", materials <> 0
PositionEntity camera, 0, 10, 0
RotateEntity camera, 90, 0, 0
RenderWorld
Check "Red square", R(32, 60), 255, 8
Check "Red square is only red", G(32, 60) + B(32, 60), 0, 8
; Half see-through blue over the color of the background.
Check "Glass red", R(64, 60), 5, 8
Check "Glass green", G(64, 60), 10, 8
Check "Glass blue", B(64, 60), 142, 12
Check "Two-sided square", G(96, 60), 255, 8
Check "Two-sided square is only green", R(96, 60) + B(96, 60), 0, 8
; Self-lit means it is not dark without light.
Check "Lamp red", R(128, 60), 200, 8
Check "Lamp green", G(128, 60), 100, 8
Check "Lamp blue", B(128, 60), 50, 8
Check "Between the squares", R(48, 60), 10, 4

; From below only the faces that are two-sided can be seen: the others are turned away.
PositionEntity camera, 0, -10, 0
RotateEntity camera, -90, 0, 0
RenderWorld
Check "Red square from below is not there", R(32, 60), 10, 4
Check "Glass from below is not there", B(64, 60), 30, 4
Check "Two-sided square from below", G(96, 60), 255, 40
Check "Lamp from below is not there", R(128, 60), 10, 4
FreeEntity materials

; A picture that is tiled twice across: red, blue, red, blue.
picture = LoadMesh("models/textured.3ds")
PositionEntity camera, 0, 3, 0
RotateEntity camera, 90, 0, 0
RenderWorld
Check "First quarter red", R(60, 60), 255, 12
Check "First quarter is only red", B(60, 60), 0, 12
Check "Second quarter blue", B(73, 60), 255, 12
Check "Second quarter is only blue", R(73, 60), 0, 12
Check "Third quarter red", R(87, 60), 255, 12
Check "Fourth quarter blue", B(100, 60), 255, 12
EndGraphics
Done "blitz3d_3ds_pixels"
