; Saving PNG files many times, on a 10 bit buffer too: the compressor's output is freed by the PNG writer, and where the C functions are not
; replaced by the runtime's allocator (Windows, macOS) that free handed the system heap a block it had not allocated, which corrupted the heap.
; Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_save_png_heap_pixels: skipped, there is no window."
	End
EndIf

SeedRnd MilliSecs()
unique$ = "suite_pngheap_" + Rand(1, 1000000000) + "_"

Graphics 160, 120, 30, 2
SetBuffer BackBuffer()

For round = 0 To 15
	Cls
	For y = 0 To 119 Step 2
		Color (y * 2 + round) Mod 256, 255 - y, (y * 7) Mod 256
		Line 0, y, 159, y
	Next
	; A mix of settings: lossless, every compression level, and the default.
	If round Mod 3 = 0 Then
		Check "SaveBuffer lossless " + round, SaveBuffer(BackBuffer(), unique + "p.png", "lossless"), 1
	Else
		Check "SaveBuffer level " + round, SaveBuffer(BackBuffer(), unique + "p.png", "compression=" + (round Mod 10)), 1
	EndIf
	CheckTrue "The file " + round, FileSize(unique + "p.png") > 100
	; Memory is allocated and freed in between, so that a block freed by the wrong heap shows.
	bank = CreateBank(1024 * (round + 1))
	FreeBank bank
Next
DeleteFile unique + "p.png"
Done "graphics_save_png_heap_pixels"
