; SetCameraProjectionMatrix and SetCameraViewMatrix replace the projection and the view of a camera, the Get commands give them back,
; and the Reset commands go back to CameraZoom, CameraRange and the camera entity. It needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_camera_matrices_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Red(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

Function Same(a:FloatMatrix4x4, b:FloatMatrix4x4)
	For c = 0 To 3
		For r = 0 To 3
			If Abs(a[c][r] - b[c][r]) > 0.0001 Then Return False
		Next
	Next
	Return True
End Function

; A standard perspective matrix: looks down +Z, Y up, depth 0 at the near and 1 at the far plane.
Function Perspective:FloatMatrix4x4(zoom#, aspect#, near#, far#)
	Local m:FloatMatrix4x4
	m[0][0] = zoom
	m[1][1] = zoom * aspect
	m[2][2] = far / (far - near)
	m[2][3] = 1
	m[3][2] = -far * near / (far - near)
	Return m
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 1, 100
CameraZoom camera, 2
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0
PositionEntity cube, 0, 0, 10

; What CameraZoom and CameraRange make is given back in the documented convention.
Local p:FloatMatrix4x4 = GetCameraProjectionMatrix(camera)
CheckTrue "GetCameraProjectionMatrix of CameraZoom", Same(p, Perspective(2, 160.0 / 120.0, 1, 100))

RenderWorld
Local reference[159]
For x = 0 To 159
	reference[x] = Red(x, 60)
Next

; The same matrix, set by the program, draws the same picture.
SetCameraProjectionMatrix camera, Perspective(2, 160.0 / 120.0, 1, 100)
CheckTrue "GetCameraProjectionMatrix gives it back", Same(GetCameraProjectionMatrix(camera), Perspective(2, 160.0 / 120.0, 1, 100))
RenderWorld
different = 0
For x = 0 To 159
	If Abs(Red(x, 60) - reference[x]) > 8 Then different = different + 1
Next
Check "The matrix draws what CameraZoom draws", different, 0, 0

; It replaces CameraZoom: a wider view shows the cube smaller.
CameraZoom camera, 8
RenderWorld
width = 0
For x = 0 To 159
	If Red(x, 60) > 128 Then width = width + 1
Next
narrow = 0
For x = 0 To 159
	If reference[x] > 128 Then narrow = narrow + 1
Next
Check "CameraZoom is ignored while a matrix is set", width, narrow, 0
SetCameraProjectionMatrix camera, Perspective(1, 160.0 / 120.0, 1, 100)
RenderWorld
width = 0
For x = 0 To 159
	If Red(x, 60) > 128 Then width = width + 1
Next
CheckTrue "Half the zoom is half as wide (" + width + " of " + narrow + ")", Abs(width * 2 - narrow) <= 4

; A matrix for the left half of the picture (a tile): the left edge of the cube moves to the middle of the screen.
CameraZoom camera, 2
ResetCameraProjectionMatrix camera
CheckTrue "Reset goes back to CameraZoom", Same(GetCameraProjectionMatrix(camera), Perspective(2, 160.0 / 120.0, 1, 100))
Local tile:FloatMatrix4x4 = Perspective(2, 160.0 / 120.0, 1, 100)
tile[0][0] = 4
tile[2][0] = 1 ; Moves the picture right by one half of the screen, scaled by 2: the left half of the view fills the screen.
SetCameraProjectionMatrix camera, tile
RenderWorld
left_edge = -1
For x = 0 To 159
	If (left_edge < 0) And (reference[x] > 128) Then left_edge = x
Next
tile_edge = -1
For x = 0 To 159
	If (tile_edge < 0) And (Red(x, 60) > 128) Then tile_edge = x
Next
CheckTrue "The tile shows the left half twice as big (" + tile_edge + ", " + left_edge + ")", Abs(tile_edge - left_edge * 2) <= 3
ResetCameraProjectionMatrix camera

; The view matrix replaces where the camera entity is: a view from 5 to the right shows the cube on the left.
Local view:FloatMatrix4x3 = GetCameraViewMatrix(camera)
Check "The view of a camera at the origin", view[3][0], 0
Local moved:FloatMatrix4x3 = FloatMatrix4x3(1, 0, 0, 0, 1, 0, 0, 0, 1, -5, 0, 0)
SetCameraViewMatrix camera, moved
Local back:FloatMatrix4x3 = GetCameraViewMatrix(camera)
Check "GetCameraViewMatrix gives it back", back[3][0], -5
RenderWorld
CheckTrue "The cube is not in the middle", Red(80, 60) < 20
PositionEntity camera, 5, 0, 0
ResetCameraViewMatrix camera
RenderWorld
shifted = 0
For x = 0 To 159
	If Red(x, 60) > 128 Then shifted = shifted + 1
Next
CheckTrue "The view of the entity moved the same way", Red(80, 60) < 20 And shifted > 0
Local entity_view:FloatMatrix4x3 = GetCameraViewMatrix(camera)
Check "The view of the entity is its inverse", entity_view[3][0], -5

; A custom projection lets a camera of mode 0 draw with RenderCamera and RenderWorld.
PositionEntity camera, 0, 0, 0
CameraProjMode camera, 0
Cls
RenderWorld
CheckTrue "Mode 0 draws nothing", Red(80, 60) < 20
SetCameraProjectionMatrix camera, Perspective(2, 160.0 / 120.0, 1, 100)
RenderCamera camera
CheckTrue "With a matrix it draws", Red(80, 60) > 200

; CameraProject follows the matrices: the tile matrix puts the middle of the view at the right edge of the screen.
SetCameraProjectionMatrix camera, tile
CameraProject camera, 0, 0, 10
CheckTrue "CameraProject through the matrix (" + ProjectedX() + ")", Abs(ProjectedX() - 160) < 1
SetCameraProjectionMatrix camera, Perspective(2, 160.0 / 120.0, 1, 100)

; CameraPick follows the matrices.
CameraProjMode camera, 1
EntityPickMode cube, 2
Check "CameraPick through the matrix", CameraPick(camera, 80, 60), cube, 0
SetCameraViewMatrix camera, moved
Check "CameraPick from the view of the matrix misses", CameraPick(camera, 80, 60), 0, 0

Done "blitz3d_camera_matrices_pixels"
