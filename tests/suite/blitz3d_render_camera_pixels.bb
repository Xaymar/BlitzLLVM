; RenderCamera draws the world for one camera only, into its own buffer (SetCameraBuffer) or the current one.
; It needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_render_camera_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Red(buffer, x, y)
	Return (ReadPixel(x, y, buffer) Shr 16) And 255
End Function

Function Green(buffer, x, y)
	Return (ReadPixel(x, y, buffer) Shr 8) And 255
End Function

Function Blue(buffer, x, y)
	Return ReadPixel(x, y, buffer) And 255
End Function

cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0

; Two cameras on the left and right half of the screen, with different clear colors.
left_camera = CreateCamera()
CameraViewport left_camera, 0, 0, 80, 120
CameraClsColor left_camera, 0, 0, 255
PositionEntity left_camera, 0, 0, -5
right_camera = CreateCamera()
CameraViewport right_camera, 80, 0, 80, 120
CameraClsColor right_camera, 0, 255, 0
PositionEntity right_camera, 0, 0, -5

ClsColor 0, 0, 0 : Cls
RenderCamera left_camera
CheckTrue "The left camera draws", Blue(BackBuffer(), 2, 2) > 200
CheckTrue "Its cube", Red(BackBuffer(), 40, 60) > 200
CheckTrue "The right camera does not", Green(BackBuffer(), 150, 2) < 20 And Blue(BackBuffer(), 150, 2) < 20
Check "It counts the triangles of one camera", TrisRendered(), 12, 0
RenderCamera right_camera
CheckTrue "Then the right camera", Green(BackBuffer(), 150, 2) > 200
CheckTrue "The left half stays", Blue(BackBuffer(), 2, 2) > 200
Check "The calls of one frame add up", TrisRendered(), 24, 0
Flip
RenderCamera right_camera
Check "A Flip starts the count again", TrisRendered(), 12, 0

; A hidden camera is drawn by RenderCamera, but not by RenderWorld.
Cls
HideEntity right_camera
RenderWorld
CheckTrue "RenderWorld leaves out the hidden camera", Green(BackBuffer(), 150, 2) < 20
RenderCamera right_camera
CheckTrue "RenderCamera draws it", Green(BackBuffer(), 150, 2) > 200
ShowEntity right_camera

; A camera with projection mode 0 draws nothing.
Cls
CameraProjMode left_camera, 0
RenderCamera left_camera
CheckTrue "Projection mode 0 draws nothing", Blue(BackBuffer(), 2, 2) < 20
CameraProjMode left_camera, 1

; Into the buffer of the camera.
target = CreateTexture(64, 64, 1 + 4096)
SetCameraBuffer left_camera, TextureBuffer(target)
CameraViewport left_camera, 0, 0, 64, 64
Cls
RenderCamera left_camera
CheckTrue "Into the camera buffer", Blue(TextureBuffer(target), 1, 1) > 200 And Red(TextureBuffer(target), 32, 32) > 200
CheckTrue "Not into the back buffer", Blue(BackBuffer(), 2, 2) < 20

; The tween is that of RenderWorld: 0 shows what CaptureWorld saw.
SetCameraBuffer left_camera, 0
CameraViewport left_camera, 0, 0, 80, 120
CaptureWorld
PositionEntity cube, 100, 0, 0
Cls
RenderCamera left_camera, 0
CheckTrue "Tween 0 shows the captured cube", Red(BackBuffer(), 40, 60) > 200
RenderCamera left_camera
CheckTrue "Tween 1 shows where it is now", Red(BackBuffer(), 40, 60) < 20

Done "blitz3d_render_camera_pixels"
