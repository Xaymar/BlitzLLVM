; In, Out and InOut: how the values of function parameters travel. In (the default) only goes into the function, Out only comes back
; out of it, and InOut does both. All of them can be read and written inside of the function.
Include "check.bb"

Type Box
	Field n:Int32
	Field s:String
End Type

Global g_Count:Int32 = 5
Dim grid:Int32(3)

Function Plain(a:Int32)
	a = a + 100
End Function

Function Explicit(In a:Int32)
	a = a + 100
End Function

Function Swap(InOut a:Int32, InOut b:Int32)
	Local t:Int32 = a
	a = b
	b = t
End Function

Function Split(value:Int32, Out high:Int32, Out low:Int32)
	; Out starts with the default value, and can be read before it is written.
	CheckTrue "out starts empty", high = 0
	high = value / 256
	low = value Mod 256
End Function

Function Defaulted(Out x:Int32 = 5, InOut y:Int32 = 7)
	; The default of an Out is applied before the body, and the default of an InOut when the argument is left out.
	CheckTrue "out default", x = 5
	x = x + 1
	y = y + 1
End Function

Function OutOnBothPaths(flag:Int32, Out r:Int32)
	If flag Then
		r = 1
	Else
		r = 2
	EndIf
End Function

Function OutInLoop(Out r:Int32)
	Repeat
		r = r + 1
	Until r = 3
End Function

Function ReadBack(Out r:Int32)
	r = 4
	r = r * 2
	If r <> 8 Then RuntimeError "an Out can be read after it was written"
End Function

Function Early(flag:Int32, InOut r:Int32)
	If flag Then Return
	r = 99
End Function

Function Greet(Out text:String, InOut name:String)
	CheckS "string out starts empty", text, ""
	text = "Hello " + name
	name = name + "!"
End Function

Function Fill(Out b.Box, InOut c.Box)
	b = New Box
	b\n = 11
	c\n = c\n + 1
End Function

Function Fraction(Out f:Float32, InOut d:Float64)
	f = 0.5
	d = d * 2
End Function

Function Recurse(n:Int32, InOut total:Int32)
	If n = 0 Then Return
	total = total + n
	Recurse(n - 1, total)
End Function

Function Forward(Out x:Int32)
	; Handing the Out to another function counts as writing it.
	OutOnBothPaths(1, x)
End Function

Function Bump(Out a:Int32, Out b:Int32)
	a = 1
	b = 2
End Function

Function Named(Out in:Int32)
	in = 3
End Function

; In stays In.
Local v1:Int32 = 1
Plain v1
CheckTrue "In by default", v1 = 1
Explicit v1
CheckTrue "In explicit", v1 = 1

; Swap, with globals, locals, array elements and fields.
Local a:Int32 = 1
Local b:Int32 = 2
Swap a, b
CheckTrue "swap locals", (a = 2) And (b = 1)
g_Count = 5
Swap a, g_Count
CheckTrue "swap global", (a = 5) And (g_Count = 2)
grid(0) = 10
grid(1) = 20
Swap grid(0), grid(1)
CheckTrue "swap array", (grid(0) = 20) And (grid(1) = 10)
Local box.Box = New Box
box\n = 7
Swap box\n, a
CheckTrue "swap field", (box\n = 5) And (a = 7)

; Out
Local hi:Int32 = 77
Local lo:Int32 = 77
Split 1000, hi, lo
CheckTrue "split high", hi = 3
CheckTrue "split low", lo = 232

Local x:Int32 = 40
Local y:Int32 = 40
Defaulted x, y
CheckTrue "default out is applied", x = 6
CheckTrue "inout keeps the value of the caller", y = 41
Defaulted
Local z:Int32 = 0
OutOnBothPaths 0, z
CheckTrue "else path", z = 2
OutOnBothPaths 1, z
CheckTrue "then path", z = 1
z = 0
OutInLoop z
CheckTrue "loop", z = 3
ReadBack z
CheckTrue "read back", z = 8
Forward z
CheckTrue "forwarded", z = 1
Bump z, z
CheckTrue "the last copy wins", z = 2
Named z
CheckTrue "in is still a name", z = 3

; InOut
Local r:Int32 = 5
Early 1, r
CheckTrue "returned without writing", r = 5
Early 0, r
CheckTrue "returned after writing", r = 99
Local total:Int32 = 0
Recurse 4, total
CheckTrue "recursion", total = 10

; Strings, objects and reals.
Local text:String = "old"
Local name:String = "Ada"
Greet text, name
CheckS "string out", text, "Hello Ada"
CheckS "string inout", name, "Ada!"
Local made.Box = Null
Local other.Box = New Box
Fill made, other
CheckTrue "object out", (made <> Null) And (made\n = 11)
CheckTrue "object inout", other\n = 1
Local fl:Float32 = 9
Local db:Float64 = 1.25
Fraction fl, db
Check "float out", fl, 0.5
Check "double inout", Float(db), 2.5

; Calls that are expressions.
Function Twice%(InOut n:Int32)
	n = n * 2
	Return n
End Function
Local k:Int32 = 4
Local twice:Int32 = Twice(k)
CheckTrue "call in an expression", (k = 8) And (twice = 8)

Done "language_parameter_modes"
