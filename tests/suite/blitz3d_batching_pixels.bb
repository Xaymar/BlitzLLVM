; Draw calls of the 3D world, which needs a window and a GPU, so this is skipped without one. Stats3D 1000 to 1003 count
; what the draws of what RenderWorld drew cost (calls, pipelines, textures and buffers that were set), which does not
; depend on how fast the computer is: this guards against going back to a call and a change of state for everything.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_batching_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, -10
light = CreateLight()
TurnEntity light, 40, 30, 0

; Copies of one mesh with one texture are one call, and the places they are at still count.
original = CreateCube()
HideEntity original
tex = CreateTexture(4, 4)
SetBuffer TextureBuffer(tex) : ClsColor 255, 255, 255 : Cls : SetBuffer BackBuffer()
Dim copies(99)
For i = 0 To 99
	copies(i) = CopyEntity(original)
	EntityFX copies(i), 1
	EntityTexture copies(i), tex
	ScaleEntity copies(i), 0.1, 0.1, 0.1
	PositionEntity copies(i), (i Mod 10) - 4.5, (i / 10) - 4.5, 0
Next
RenderWorld
CheckTrue "Copies are drawn together (" + Stats3D(1000) + " calls)", Stats3D(1000) <= 1
CheckTrue "One pipeline", Stats3D(1001) <= 1
CheckTrue "One texture", Stats3D(1002) <= 1
CheckTrue "One set of buffers", Stats3D(1003) <= 1
Check "All of them are drawn", TrisRendered(), 1200, 0
found = 0
For y = 0 To 119
	For x = 0 To 159
		If R(x, y) > 100 Then found = found + 1
	Next
Next
CheckTrue "Something is drawn for them (" + found + " pixels)", found > 200

; Different textures are different calls, but the pipeline stays.
tex2 = CreateTexture(4, 4)
SetBuffer TextureBuffer(tex2) : ClsColor 255, 255, 255 : Cls : SetBuffer BackBuffer()
For i = 0 To 99
	If (i Mod 2) = 1 Then EntityTexture copies(i), tex2
Next
RenderWorld
CheckTrue "Two textures are two calls (" + Stats3D(1000) + ")", Stats3D(1000) <= 2
CheckTrue "Two textures are set (" + Stats3D(1002) + ")", Stats3D(1002) <= 2
CheckTrue "Still one pipeline", Stats3D(1001) <= 1

; What is see-through is drawn after what is solid, with the blending pipeline. It keeps its order from far to near,
; so only what is next to each other with the same texture is a call.
For i = 0 To 99
	EntityTexture copies(i), tex
	If i < 50 Then EntityAlpha copies(i), 0.5
Next
RenderWorld
CheckTrue "Solid and see-through (" + Stats3D(1001) + " pipelines)", Stats3D(1001) <= 2
CheckTrue "Solid and see-through are two calls (" + Stats3D(1000) + ")", Stats3D(1000) <= 2

; What is outside of the view is not drawn at all.
For i = 0 To 99
	EntityAlpha copies(i), 1
	PositionEntity copies(i), 500 + i, 0, 0
Next
RenderWorld
Check "Nothing outside of the view is drawn", Stats3D(1000), 0, 0
Check "And no triangles", TrisRendered(), 0, 0
PositionEntity copies(0), 0, 0, 0
RenderWorld
Check "One that comes back", Stats3D(1000), 1, 0

Done "blitz3d_batching_pixels"
