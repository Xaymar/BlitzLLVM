; Which way the nodes of a model turn: the quaternions of a .b3d file, written here, give the same angles and directions
; as in the original, both for the pose of the file and for the frames that are played.
Include "check.bb"

Graphics3D 320, 240, 32, 2

Function WriteTag(file, tag$, size)
	For i = 1 To 4
		WriteByte file, Asc(Mid$(tag, i, 1))
	Next
	WriteInt file, size
End Function

; The head of a node: a name, a position, a scale and a quaternion (w, x, y, z).
Function WriteNode(file, size, name$, x#, y#, z#, w#, qx#, qy#, qz#)
	WriteTag file, "NODE", size
	For i = 1 To Len(name)
		WriteByte file, Asc(Mid$(name, i, 1))
	Next
	WriteByte file, 0
	WriteFloat file, x : WriteFloat file, y : WriteFloat file, z
	WriteFloat file, 1 : WriteFloat file, 1 : WriteFloat file, 1
	WriteFloat file, w : WriteFloat file, qx : WriteFloat file, qy : WriteFloat file, qz
End Function

; A node of 3 letters that is turned, with a node ahead of it by 10: (4 + 40) + (8 + 4 + 40) bytes.
Function WriteArm(file, name$, w#, qx#, qy#, qz#)
	WriteNode file, 96, name, 0, 0, 0, w, qx, qy, qz
	WriteNode file, 44, "tip", 0, 0, 10, 1, 0, 0, 0
End Function

s# = Sin(45)
c# = Cos(45)

; "root" (45 bytes), the length (20), 3 turned nodes (104 each) and one that is played: its keys (52) and the node ahead.
file = WriteFile("suite_animation.b3d")
WriteTag file, "BB3D", 545
WriteInt file, 1
WriteNode file, 533, "root", 0, 0, 0, 1, 0, 0, 0
WriteTag file, "ANIM", 12
WriteInt file, 0 : WriteInt file, 10 : WriteFloat file, 10
; Turning by +90 about y, as Yaw does, which is (cos 45, 0, sin 45, 0); pitch and roll are the other way round.
WriteArm file, "yaw", c, 0, s, 0
WriteArm file, "pit", c, -s, 0, 0
WriteArm file, "rol", c, 0, 0, -s
WriteNode file, 148, "key", 0, 0, 0, 1, 0, 0, 0
WriteTag file, "KEYS", 44
WriteInt file, 4
WriteInt file, 0 : WriteFloat file, 1 : WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
WriteInt file, 10 : WriteFloat file, c : WriteFloat file, 0 : WriteFloat file, s : WriteFloat file, 0
WriteNode file, 44, "tip", 0, 0, 10, 1, 0, 0, 0
CloseFile file

model = LoadAnimMesh("suite_animation.b3d")
CheckTrue "LoadAnimMesh of the fixture", model <> 0
yaw = FindChild(model, "yaw") : pit = FindChild(model, "pit") : rol = FindChild(model, "rol") : key = FindChild(model, "key")
CheckTrue "The nodes are there", yaw <> 0 And pit <> 0 And rol <> 0 And key <> 0

; Yaw turns the front (z) to the left (-x), pitch turns it down (-y), and roll tilts the right (x) up (y).
Check "Yaw angle", EntityYaw(yaw), 90, 0.01
Check "Yaw tip x", EntityX(FindChild(yaw, "tip"), True), -10, 0.01
Check "Yaw tip z", EntityZ(FindChild(yaw, "tip"), True), 0, 0.01
Check "Pitch angle", EntityPitch(pit), 90, 0.01
Check "Pitch tip y", EntityY(FindChild(pit, "tip"), True), -10, 0.01
Check "Roll angle", EntityRoll(rol), 90, 0.01
TFormVector 1, 0, 0, rol, 0
Check "Roll turns the right side up", TFormedY(), 1, 0.01

; Played frames are turned the same way as the pose.
SetAnimTime model, 0
Check "Key at 0", EntityYaw(key), 0, 0.01
SetAnimTime model, 10
Check "Key at 10", EntityYaw(key), 90, 0.01
Check "Key tip x at 10", EntityX(FindChild(key, "tip"), True), -10, 0.01
Check "Key tip z at 10", EntityZ(FindChild(key, "tip"), True), 0, 0.01
SetAnimTime model, 5
Check "Key at 5", EntityYaw(key), 45, 0.1
DeleteFile "suite_animation.b3d"
EndGraphics
Done "blitz3d_animation"
