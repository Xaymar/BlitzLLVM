; Terrain, models and animation, and drawing the world: CreateTerrain ModifyTerrain TerrainHeight TerrainSize TerrainX
; TerrainY TerrainZ TerrainDetail TerrainShading LoadMesh LoadAnimMesh Animate Animating AnimSeq AnimLength AnimTime
; SetAnimTime ExtractAnimSeq AddAnimSeq RenderWorld TrisRendered Wireframe LoadTerrain LoadMD2 AnimateMD2 MD2AnimTime MD2AnimLength MD2Animating SetAnimKey LoadAnimSeq LoaderMatrix LoadBSP BSPLighting BSPAmbientLight.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; Terrain is a square of heights between 0 and 1.
terrain = CreateTerrain(32)
CheckTrue "CreateTerrain", terrain <> 0
Check "TerrainSize", TerrainSize(terrain), 32
Check "A new terrain is flat", TerrainHeight(terrain, 5, 5), 0
ModifyTerrain terrain, 5, 5, 0.75
Check "ModifyTerrain", TerrainHeight(terrain, 5, 5), 0.75, 0.01
Check "ModifyTerrain is for one point", TerrainHeight(terrain, 6, 5), 0
ModifyTerrain terrain, 0, 0, 1
Check "The corner", TerrainHeight(terrain, 0, 0), 1, 0.01
ModifyTerrain terrain, 32, 32, 0.5
Check "The far corner", TerrainHeight(terrain, 32, 32), 0.5, 0.01
ModifyTerrain terrain, 5, 5, 0.25, True
Check "ModifyTerrain in realtime", TerrainHeight(terrain, 5, 5), 0.25, 0.01

; The size of the grid follows the size of the entity, and the height of it.
ScaleEntity terrain, 2, 10, 2
PositionEntity terrain, 100, 5, 50
; TerrainX, TerrainY and TerrainZ say where the terrain is at a place: the point of the surface above or below it.
Check "TerrainX", TerrainX(terrain, 110, 0, 60), 110, 0.01
Check "TerrainZ", TerrainZ(terrain, 110, 0, 60), 60, 0.01
Check "TerrainY is the surface (5 + 0.25 * 10)", TerrainY(terrain, 110, 0, 60), 7.5, 0.01
Check "TerrainY does not care how high the point is", TerrainY(terrain, 110, 500, 60), 7.5, 0.01

; How it is drawn does not change what it is.
TerrainDetail terrain, 200
TerrainDetail terrain, 500, True
TerrainShading terrain, True
TerrainShading terrain, False
Check "TerrainSize after the others", TerrainSize(terrain), 32
FreeEntity terrain

; Models come from files. Without a file there is nothing.
model$ = "../stranded2/mods/Stranded II/gfx/pirate.b3d"
Check "LoadMesh missing", LoadMesh("suite_does_not_exist.b3d"), 0
Check "LoadAnimMesh missing", LoadAnimMesh("suite_does_not_exist.b3d"), 0

; LoadMesh makes one mesh of everything that is in the file.
still = LoadMesh(model)
CheckTrue "LoadMesh", still <> 0
CheckTrue "LoadMesh has surfaces", CountSurfaces(still) >= 1
CheckTrue "LoadMesh has a size", MeshHeight(still) > 10
Check "LoadMesh has nothing to animate", Animating(still), 0
placed = LoadMesh(model, still)
CheckTrue "LoadMesh with a parent", placed <> 0

; LoadAnimMesh keeps the parts of the model, with their names and what moves them.
man = LoadAnimMesh(model)
CheckTrue "LoadAnimMesh", man <> 0 And man <> still
CheckTrue "LoadAnimMesh keeps the parts", FindChild(man, "joint1") <> 0
Check "A model that is not told to play does not", Animating(man), 0
Check "AnimSeq begins with the first", AnimSeq(man), 0
Check "AnimLength", AnimLength(man), 30
Check "AnimTime begins at the start", AnimTime(man), 0

; Playing and stopping.
Animate man, 1, 1
Check "Animate", Animating(man), 1
Animate man, 0
Check "Animate to stop", Animating(man), 0
Animate man, 2, 0.5
Check "Animate back and forth", Animating(man), 1
Animate man, 3, 2
Check "Animate once", Animating(man), 1

; A part of the frames can be a sequence of its own.
sequence = ExtractAnimSeq(man, 5, 15)
Check "ExtractAnimSeq numbers from 1", sequence, 1
Check "ExtractAnimSeq again", ExtractAnimSeq(man, 0, 4), 2
Animate man, 1, 1, sequence
Check "Animate a sequence", AnimSeq(man), sequence
Check "AnimLength of a sequence", AnimLength(man), 10
Check "AnimTime of a sequence", AnimTime(man), 0, 0.5
SetAnimTime man, 4
Check "SetAnimTime", AnimTime(man), 4, 0.01
Animate man, 0
SetAnimTime man, 7, 0
Check "SetAnimTime of the whole", AnimTime(man), 7, 0.01
Check "SetAnimTime goes to that sequence", AnimSeq(man), 0

; A sequence from other frames added to the end.
added = AddAnimSeq(man, 20)
CheckTrue "AddAnimSeq", added >= 3
CheckTrue "AddAnimSeq makes the model longer", AnimLength(man) >= 30

; A level of Quake 3, made here: a quad from 4 vertices with a texture that is next to it, a curved face of 3 by 3 points
; with the same texture, and a quad that is not to be seen. The coordinates of Quake are turned: x is z, y is -x and z
; is y.
Function WriteVertex(file, x#, y#, z#)
	WriteFloat file, x : WriteFloat file, y : WriteFloat file, z
	WriteFloat file, x / 64 : WriteFloat file, y / 64 : WriteFloat file, 0 : WriteFloat file, 0
	WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 1
	WriteByte file, 255 : WriteByte file, 128 : WriteByte file, 0 : WriteByte file, 255
End Function
Function WriteFace(file, texture, kind, vertex, vertices, meshvert, meshverts, size_x, size_y)
	WriteInt file, texture : WriteInt file, -1 : WriteInt file, kind : WriteInt file, vertex : WriteInt file, vertices
	WriteInt file, meshvert : WriteInt file, meshverts : WriteInt file, -1
	For i = 1 To 4
		WriteInt file, 0
	Next
	For i = 1 To 12
		WriteFloat file, 0
	Next
	WriteInt file, size_x : WriteInt file, size_y
End Function
Function WriteTexture(file, name$, flags, contents)
	For i = 1 To 64
		If i <= Len(name) Then WriteByte file, Asc(Mid$(name, i, 1)) Else WriteByte file, 0
	Next
	WriteInt file, flags : WriteInt file, contents
End Function
name$ = "suite_level.bsp"
file = WriteFile(name)
WriteInt file, $50534249
WriteInt file, 46
; The 17 lumps: textures (2 of 72 bytes), vertices (13 of 44 bytes), mesh vertices (6 of 4 bytes), faces (3 of 104 bytes)
For lump = 0 To 16
	If lump = 1 Then WriteInt file, 144 : WriteInt file, 144
	If lump = 10 Then WriteInt file, 288 : WriteInt file, 572
	If lump = 11 Then WriteInt file, 860 : WriteInt file, 24
	If lump = 13 Then WriteInt file, 884 : WriteInt file, 312
	If lump <> 1 And lump <> 10 And lump <> 11 And lump <> 13 Then WriteInt file, 1196 : WriteInt file, 0
Next
WriteTexture file, "../checker", 0, 1
WriteTexture file, "../hidden", $80, 1
WriteVertex file, 0, 0, 0
WriteVertex file, 64, 0, 0
WriteVertex file, 64, 64, 0
WriteVertex file, 0, 64, 0
For y = 0 To 2
	For x = 0 To 2
		WriteVertex file, x * 32, y * 32, 10
	Next
Next
WriteInt file, 0 : WriteInt file, 1 : WriteInt file, 2
WriteInt file, 0 : WriteInt file, 2 : WriteInt file, 3
WriteFace file, 0, 3, 0, 4, 0, 6, 0, 0
WriteFace file, 0, 2, 4, 9, 0, 0, 3, 3
WriteFace file, 1, 3, 0, 4, 0, 6, 0, 0
CloseFile file

level = LoadBSP(name)
CheckTrue "LoadBSP", level <> 0
CheckS "LoadBSP is a BSP", EntityClass$(level), "BSP"
Check "LoadBSP makes a surface for every texture that is drawn", CountSurfaces(level), 1
surf = GetSurface(level, 1)
; The quad has 4 vertices and 2 triangles, the curved face 9 control points cut into 9 by 9 points and 128 triangles.
Check "LoadBSP vertices", CountVertices(surf), 4 + 81
Check "LoadBSP triangles", CountTriangles(surf), 2 + 128
Check "LoadBSP turns the axes: x", VertexX(surf, 1), 0
Check "LoadBSP turns the axes: z", VertexZ(surf, 1), 64
Check "LoadBSP turns the axes: -y to x", VertexX(surf, 2), -64
Check "LoadBSP vertex color", VertexGreen(surf, 0), 128
Check "LoadBSP vertex color blue", VertexBlue(surf, 0), 0
Check "LoadBSP curved face: first control point", VertexY(surf, 4), 10, 0.01
Check "LoadBSP curved face: the last", VertexX(surf, 4 + 80), -64, 0.01
Check "LoadBSP curved face: the middle is a point between", VertexZ(surf, 4 + 40), 32, 0.01
texture = GetBrushTexture(GetSurfaceBrush(surf))
CheckTrue "LoadBSP finds the texture", texture <> 0
Check "LoadBSP texture", TextureWidth(texture), 64
BSPLighting level, False
BSPLighting level, True
BSPAmbientLight level, 128, 64, 255
suite_checks = suite_checks + 1
Check "LoadBSP missing", LoadBSP("suite_does_not_exist.bsp"), 0
junk = WriteFile("suite_junk.bsp")
WriteString junk, "This is not a level."
CloseFile junk
Check "LoadBSP of something else", LoadBSP("suite_junk.bsp"), 0
DeleteFile "suite_junk.bsp"
holder = CreatePivot()
Check "LoadBSP parent", GetParent(LoadBSP(name, 0, holder)), holder
DeleteFile name

; The way models of a file type are turned when they are loaded: models of Blitz3D (.b3d) are not turned by it.
LoaderMatrix "b3d", 1, 0, 0, 0, 1, 0, 0, 0, 1
LoaderMatrix "x", 1, 0, 0, 0, 0, 1, 0, 1, 0
suite_checks = suite_checks + 1

; The animation of another file is added as a sequence, for the parts that have the same names.
loaded = LoadAnimSeq(man, model)
Check "LoadAnimSeq", loaded, added + 1
Check "LoadAnimSeq missing file", LoadAnimSeq(man, "suite_does_not_exist.b3d"), loaded
Check "LoadAnimSeq without an animation", LoadAnimSeq(CreatePivot(), model), -1
Animate man, 1, 1, loaded
Check "LoadAnimSeq has the frames of the file", AnimLength(man), 30
Animate man, 0

; Once plays to the end and then stops, with time passing as UpdateWorld is called.
Animate man, 3, 4, 0
For i = 1 To 100
	Delay 20
	UpdateWorld
	If Animating(man) = 0 Then Exit
Next
Check "Animate once ends", Animating(man), 0
CheckTrue "Animate once stays at the end", AnimTime(man) >= 29

; Looping goes on.
Animate man, 1, 4, 0
For i = 1 To 20
	Delay 20
	UpdateWorld
Next
Check "Animate in a loop goes on", Animating(man), 1
CheckTrue "Animate in a loop stays inside", AnimTime(man) >= 0 And AnimTime(man) <= 30

; A copy plays by itself.
twin = CopyEntity(man)
Check "A copy plays too", Animating(twin), 1
Animate twin, 0
Check "A copy can be stopped", Animating(twin), 0
Check "The original is not stopped", Animating(man), 1

; Things that can not be animated say so.
plain = CreateCube()
Check "A cube is not animated", Animating(plain), 0
Animate plain, 1
Check "Animate does nothing for a cube", Animating(plain), 0

FreeEntity twin
FreeEntity man
FreeEntity placed
FreeEntity still
FreeEntity plain

; Drawing the world, which makes triangles when there is a window to do it.
camera = CreateCamera()
PositionEntity camera, 0, 0, -5
light = CreateLight()
cube = CreateCube()
RenderWorld
Wireframe True
RenderWorld
Wireframe False
RenderWorld 1
If GetEnv$("BLITZ_HEADLESS") = "" Then
	CheckTrue "TrisRendered (" + TrisRendered() + ")", TrisRendered() >= 12
Else
	CheckTrue "TrisRendered", TrisRendered() >= 0
EndIf
suite_checks = suite_checks + 3

; Animation made by hand: the entity is put where it is to be in some frames and remembered with SetAnimKey, and
; AddAnimSeq makes the animation of those keys.
mover = CreatePivot()
SetAnimKey mover, 0
PositionEntity mover, 10, 0, 0
SetAnimKey mover, 10
PositionEntity mover, 0, 0, 0
made = AddAnimSeq(mover, 10)
Check "AddAnimSeq of an entity without animation", made, 0
Check "AnimLength of keys", AnimLength(mover), 10
SetAnimTime mover, 5, made
Check "Position between the keys", EntityX(mover), 5, 0.01
SetAnimTime mover, 10, made
Check "Position at the last key", EntityX(mover), 10, 0.01
SetAnimTime mover, 0, made
Check "Position at the first key", EntityX(mover), 0, 0.01
; The next sequence has keys of its own.
PositionEntity mover, 0, 5, 0
SetAnimKey mover, 0
PositionEntity mover, 0, 15, 0
SetAnimKey mover, 20
second_made = AddAnimSeq(mover, 20)
Check "A second sequence", second_made, 1
SetAnimTime mover, 10, second_made
Check "Second sequence, between the keys", EntityY(mover), 10, 0.01
Check "Second sequence, x", EntityX(mover), 0, 0.01
SetAnimTime mover, 5, made
Check "The first sequence is still there", EntityX(mover), 5, 0.01
; Turns are kept as keys too, and a key can be left out.
turner = CreatePivot()
RotateEntity turner, 0, 0, 0
SetAnimKey turner, 0
RotateEntity turner, 0, 90, 0
SetAnimKey turner, 10
turned_seq = AddAnimSeq(turner, 10)
SetAnimTime turner, 5, turned_seq
Check "Yaw between the keys", EntityYaw(turner), 45, 1
SetAnimTime turner, 10, turned_seq
Check "Yaw at the last key", EntityYaw(turner), 90, 0.5
scaler = CreatePivot()
ScaleEntity scaler, 1, 1, 1
SetAnimKey scaler, 0, False, False, True
ScaleEntity scaler, 3, 3, 3
SetAnimKey scaler, 4, False, False, True
PositionEntity scaler, 7, 7, 7
scaled_seq = AddAnimSeq(scaler, 4)
SetAnimTime scaler, 2, scaled_seq
Check "Scale between the keys", EntityX(scaler) , 7
PositionEntity scaler, 0, 0, 0
SetAnimTime scaler, 4, scaled_seq
Check "Keys that were left out do not move it", EntityX(scaler), 0
; Children are part of the animation of their parent.
parent = CreatePivot()
kid = CreatePivot(parent)
SetAnimKey kid, 0
PositionEntity kid, 0, 0, 8
SetAnimKey kid, 8
PositionEntity kid, 0, 0, 0
tree_seq = AddAnimSeq(parent, 8)
SetAnimTime parent, 4, tree_seq
Check "A child moves with the animation of its parent", EntityZ(kid), 4, 0.01
Animate parent, 3, 8, tree_seq
Check "Animate on keys", Animating(parent), 1
FreeEntity parent

; A terrain from a picture of 4 by 4 pixels, made here as a bitmap: how bright the brightest color of a pixel is, is how
; high that point is, and the bottom of the picture is where the terrain starts.
Dim pixels(3, 3)
pixels(0, 3) = $FFFFFF
pixels(3, 0) = $808080
pixels(1, 2) = $00C864
name$ = "suite_terrain.bmp"
file = WriteFile(name)
WriteByte file, Asc("B") : WriteByte file, Asc("M")
WriteInt file, 54 + 48
WriteInt file, 0
WriteInt file, 54
WriteInt file, 40
WriteInt file, 4
WriteInt file, 4
WriteShort file, 1
WriteShort file, 24
WriteInt file, 0
WriteInt file, 48
WriteInt file, 2835
WriteInt file, 2835
WriteInt file, 0
WriteInt file, 0
For y = 3 To 0 Step -1
	For x = 0 To 3
		WriteByte file, pixels(x, y) And 255
		WriteByte file, (pixels(x, y) Shr 8) And 255
		WriteByte file, (pixels(x, y) Shr 16) And 255
	Next
Next
CloseFile file
terrain = LoadTerrain(name)
CheckTrue "LoadTerrain", terrain <> 0
CheckS "LoadTerrain is a terrain", EntityClass$(terrain), "Terrain"
Check "LoadTerrain size", TerrainSize(terrain), 4
Check "LoadTerrain white", TerrainHeight(terrain, 0, 0), 1, 0.01
Check "LoadTerrain grey, the other corner", TerrainHeight(terrain, 3, 3), 0.502, 0.01
Check "LoadTerrain brightest color", TerrainHeight(terrain, 1, 1), 200.0 / 255.0, 0.01
Check "LoadTerrain black", TerrainHeight(terrain, 2, 2), 0, 0.01
holder = CreatePivot()
child = LoadTerrain(name, holder)
Check "LoadTerrain parent", GetParent(child), holder
DeleteFile name

; A model of Quake 2 with one triangle in two frames, made here. The second frame has twice the size, and is moved.
name$ = "suite_model.md2"
file = WriteFile(name)
WriteInt file, $32504449 ; IDP2
WriteInt file, 8
WriteInt file, 64
WriteInt file, 64
WriteInt file, 52      ; Size of a frame: scale, translation, name and 3 vertices
WriteInt file, 0
WriteInt file, 3
WriteInt file, 3
WriteInt file, 1
WriteInt file, 0
WriteInt file, 2
WriteInt file, 68      ; Skins
WriteInt file, 68      ; Texture coordinates
WriteInt file, 80      ; Triangles
WriteInt file, 92      ; Frames
WriteInt file, 196     ; Commands
WriteInt file, 196     ; End
WriteShort file, 0 : WriteShort file, 0
WriteShort file, 32 : WriteShort file, 0
WriteShort file, 0 : WriteShort file, 32
WriteShort file, 0 : WriteShort file, 1 : WriteShort file, 2
WriteShort file, 0 : WriteShort file, 1 : WriteShort file, 2
For frame = 0 To 1
	scale# = 1
	If frame = 1 Then scale = 2
	WriteFloat file, scale
	WriteFloat file, scale
	WriteFloat file, scale
	If frame = 0
		WriteFloat file, 0
		WriteFloat file, 0
		WriteFloat file, 0
	Else
		WriteFloat file, 1
		WriteFloat file, 2
		WriteFloat file, 3
	EndIf
	For i = 1 To 16
		WriteByte file, 0
	Next
	WriteByte file, 0 : WriteByte file, 0 : WriteByte file, 0 : WriteByte file, 0
	WriteByte file, 0 : WriteByte file, 10 : WriteByte file, 0 : WriteByte file, 0
	WriteByte file, 0 : WriteByte file, 0 : WriteByte file, 10 : WriteByte file, 0
Next
CloseFile file

md2_model = LoadMD2(name)
CheckTrue "LoadMD2", md2_model <> 0
CheckS "LoadMD2 is an MD2", EntityClass$(md2_model), "MD2"
Check "MD2AnimLength", MD2AnimLength(md2_model), 2
Check "LoadMD2 has a surface", CountSurfaces(md2_model), 1
surf = GetSurface(md2_model, 1)
Check "LoadMD2 vertices", CountVertices(surf), 3
Check "LoadMD2 triangles", CountTriangles(surf), 1
; Axes of the file turned into the ones of Blitz: y becomes x, z becomes y and x becomes z.
Check "LoadMD2 first corner", VertexX(surf, 0), 0
Check "LoadMD2 second corner x", VertexX(surf, 1), 10
Check "LoadMD2 third corner y", VertexY(surf, 2), 10
Check "LoadMD2 texture coordinate", VertexU(surf, 1), 0.5
Check "LoadMD2 texture coordinate v", VertexV(surf, 2), 0.5
Check "LoadMD2 normals have a length", Sqr(VertexNX(surf, 0) ^ 2 + VertexNY(surf, 0) ^ 2 + VertexNZ(surf, 0) ^ 2), 1, 0.01
Check "MD2Animating at the start", MD2Animating(md2_model), 0
Check "MD2AnimTime at the start", MD2AnimTime(md2_model), 0
Check "LoadMD2 missing", LoadMD2("suite_does_not_exist.md2"), 0
junk = WriteFile("suite_junk.md2")
WriteString junk, "This is not a md2_model."
CloseFile junk
Check "LoadMD2 of something else", LoadMD2("suite_junk.md2"), 0
DeleteFile "suite_junk.md2"
holder = CreatePivot()
child = LoadMD2(name, holder)
Check "LoadMD2 parent", GetParent(child), holder

; Playing once goes to the last frame and stops there.
copy = CopyEntity(md2_model)
AnimateMD2 md2_model, 3, 1, 0, 1
Check "AnimateMD2 is animating", MD2Animating(md2_model), 1
Check "AnimateMD2 starts at the first frame", MD2AnimTime(md2_model), 0
Check "A copy does not animate along", MD2Animating(copy), 0
Delay 100
UpdateWorld
Check "AnimateMD2 once ends", MD2Animating(md2_model), 0
Check "AnimateMD2 once ends at the last frame", MD2AnimTime(md2_model), 1
Check "The last frame: second corner x", VertexX(surf, 1), 22, 0.01
Check "The last frame: second corner y", VertexY(surf, 1), 3, 0.01
Check "The last frame: second corner z", VertexZ(surf, 1), 1, 0.01
Check "The last frame: third corner y", VertexY(surf, 2), 23, 0.01
Check "The copy stays in the first frame", VertexX(GetSurface(copy, 1), 1), 10

; Looping goes on, and a speed or a length of nothing stops.
AnimateMD2 md2_model, 1, 1, 0, 1
Delay 30
UpdateWorld
Check "AnimateMD2 loop goes on", MD2Animating(md2_model), 1
CheckTrue "AnimateMD2 loop stays within the frames", MD2AnimTime(md2_model) >= 0 And MD2AnimTime(md2_model) < 1
AnimateMD2 md2_model, 1, 0, 0, 1
Check "AnimateMD2 without speed stops", MD2Animating(md2_model), 0
AnimateMD2 md2_model, 1, 1, 1, 1
Check "AnimateMD2 of one frame stops", MD2Animating(md2_model), 0
Check "AnimateMD2 of one frame is that frame", MD2AnimTime(md2_model), 1
AnimateMD2 md2_model, 0
Check "AnimateMD2 mode 0", MD2Animating(md2_model), 0
; Frames outside of the md2_model are cut to it, and a first frame after the last is swapped with it.
AnimateMD2 md2_model, 3, 1, 5, 99
Check "AnimateMD2 cut to the md2_model", MD2AnimTime(md2_model), 1
AnimateMD2 md2_model, 1, 1, 1, 0
Check "AnimateMD2 swapped", MD2Animating(md2_model), 1
Check "AnimateMD2 swapped starts at the first", MD2AnimTime(md2_model), 0
; A transition moves the md2_model to the first frame of what plays next over some frames.
AnimateMD2 md2_model, 3, 1, 0, 1
Delay 100
UpdateWorld
AnimateMD2 md2_model, 3, 1, 0, 1, 10
Delay 100
UpdateWorld
Check "A transition is playing", MD2Animating(md2_model), 1
Delay 100
UpdateWorld
FreeEntity copy
FreeEntity md2_model
DeleteFile name

EndGraphics
Done "blitz3d_world"
