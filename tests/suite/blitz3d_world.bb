; Terrain, models and animation, and drawing the world: CreateTerrain ModifyTerrain TerrainHeight TerrainSize TerrainX
; TerrainY TerrainZ TerrainDetail TerrainShading LoadMesh LoadAnimMesh Animate Animating AnimSeq AnimLength AnimTime
; SetAnimTime ExtractAnimSeq AddAnimSeq RenderWorld TrisRendered Wireframe.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; Terrain is a square of heights between 0 and 1.
terrain = CreateTerrain(32)
CheckTrue "CreateTerrain", terrain <> 0
Check "TerrainSize", TerrainSize(terrain), 32
Check "A new terrain is flat", TerrainHeight(terrain, 5, 5), 0
ModifyTerrain terrain, 5, 5, 0.75
Check "ModifyTerrain", TerrainHeight(terrain, 5, 5), 0.75, 0.01
Check "ModifyTerrain is for one point", TerrainHeight(terrain, 6, 5), 0
ModifyTerrain terrain, 0, 0, 1
Check "The corner", TerrainHeight(terrain, 0, 0), 1, 0.01
ModifyTerrain terrain, 32, 32, 0.5
Check "The far corner", TerrainHeight(terrain, 32, 32), 0.5, 0.01
ModifyTerrain terrain, 5, 5, 0.25, True
Check "ModifyTerrain in realtime", TerrainHeight(terrain, 5, 5), 0.25, 0.01

; The size of the grid follows the size of the entity, and the height of it.
ScaleEntity terrain, 2, 10, 2
PositionEntity terrain, 100, 5, 50
; TerrainX, TerrainY and TerrainZ say where the terrain is at a place: the point of the surface above or below it.
Check "TerrainX", TerrainX(terrain, 110, 0, 60), 110, 0.01
Check "TerrainZ", TerrainZ(terrain, 110, 0, 60), 60, 0.01
Check "TerrainY is the surface (5 + 0.25 * 10)", TerrainY(terrain, 110, 0, 60), 7.5, 0.01
Check "TerrainY does not care how high the point is", TerrainY(terrain, 110, 500, 60), 7.5, 0.01

; How it is drawn does not change what it is.
TerrainDetail terrain, 200
TerrainDetail terrain, 500, True
TerrainShading terrain, True
TerrainShading terrain, False
Check "TerrainSize after the others", TerrainSize(terrain), 32
FreeEntity terrain

; Models come from files. Without a file there is nothing.
model$ = "../stranded2/mods/Stranded II/gfx/pirate.b3d"
Check "LoadMesh missing", LoadMesh("suite_does_not_exist.b3d"), 0
Check "LoadAnimMesh missing", LoadAnimMesh("suite_does_not_exist.b3d"), 0

; LoadMesh makes one mesh of everything that is in the file.
still = LoadMesh(model)
CheckTrue "LoadMesh", still <> 0
CheckTrue "LoadMesh has surfaces", CountSurfaces(still) >= 1
CheckTrue "LoadMesh has a size", MeshHeight(still) > 10
Check "LoadMesh has nothing to animate", Animating(still), 0
placed = LoadMesh(model, still)
CheckTrue "LoadMesh with a parent", placed <> 0

; LoadAnimMesh keeps the parts of the model, with their names and what moves them.
man = LoadAnimMesh(model)
CheckTrue "LoadAnimMesh", man <> 0 And man <> still
CheckTrue "LoadAnimMesh keeps the parts", FindChild(man, "joint1") <> 0
Check "A model that is not told to play does not", Animating(man), 0
Check "AnimSeq begins with the first", AnimSeq(man), 0
Check "AnimLength", AnimLength(man), 30
Check "AnimTime begins at the start", AnimTime(man), 0

; Playing and stopping.
Animate man, 1, 1
Check "Animate", Animating(man), 1
Animate man, 0
Check "Animate to stop", Animating(man), 0
Animate man, 2, 0.5
Check "Animate back and forth", Animating(man), 1
Animate man, 3, 2
Check "Animate once", Animating(man), 1

; A part of the frames can be a sequence of its own.
sequence = ExtractAnimSeq(man, 5, 15)
Check "ExtractAnimSeq numbers from 1", sequence, 1
Check "ExtractAnimSeq again", ExtractAnimSeq(man, 0, 4), 2
Animate man, 1, 1, sequence
Check "Animate a sequence", AnimSeq(man), sequence
Check "AnimLength of a sequence", AnimLength(man), 10
Check "AnimTime of a sequence", AnimTime(man), 0, 0.5
SetAnimTime man, 4
Check "SetAnimTime", AnimTime(man), 4, 0.01
Animate man, 0
SetAnimTime man, 7, 0
Check "SetAnimTime of the whole", AnimTime(man), 7, 0.01
Check "SetAnimTime goes to that sequence", AnimSeq(man), 0

; A sequence from other frames added to the end.
added = AddAnimSeq(man, 20)
CheckTrue "AddAnimSeq", added >= 3
CheckTrue "AddAnimSeq makes the model longer", AnimLength(man) >= 30

; Once plays to the end and then stops, with time passing as UpdateWorld is called.
Animate man, 3, 4, 0
For i = 1 To 100
	Delay 20
	UpdateWorld
	If Animating(man) = 0 Then Exit
Next
Check "Animate once ends", Animating(man), 0
CheckTrue "Animate once stays at the end", AnimTime(man) >= 29

; Looping goes on.
Animate man, 1, 4, 0
For i = 1 To 20
	Delay 20
	UpdateWorld
Next
Check "Animate in a loop goes on", Animating(man), 1
CheckTrue "Animate in a loop stays inside", AnimTime(man) >= 0 And AnimTime(man) <= 30

; A copy plays by itself.
twin = CopyEntity(man)
Check "A copy plays too", Animating(twin), 1
Animate twin, 0
Check "A copy can be stopped", Animating(twin), 0
Check "The original is not stopped", Animating(man), 1

; Things that can not be animated say so.
plain = CreateCube()
Check "A cube is not animated", Animating(plain), 0
Animate plain, 1
Check "Animate does nothing for a cube", Animating(plain), 0

FreeEntity twin
FreeEntity man
FreeEntity placed
FreeEntity still
FreeEntity plain

; Drawing the world, which makes triangles when there is a window to do it.
camera = CreateCamera()
PositionEntity camera, 0, 0, -5
light = CreateLight()
cube = CreateCube()
RenderWorld
Wireframe True
RenderWorld
Wireframe False
RenderWorld 1
If GetEnv$("BLITZ_HEADLESS") = "" Then
	CheckTrue "TrisRendered (" + TrisRendered() + ")", TrisRendered() >= 12
Else
	CheckTrue "TrisRendered", TrisRendered() >= 0
EndIf
suite_checks = suite_checks + 3

EndGraphics
Done "blitz3d_world"
