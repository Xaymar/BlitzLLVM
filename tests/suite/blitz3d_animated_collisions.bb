; Collisions and picks with a model that is moved by bones: the triangles that are tested are the ones that are posed now, not the ones of
; the bind pose.
Include "check.bb"

Graphics3D 320, 240, 32, 2

Function WriteTag(file, tag$, size)
	For i = 1 To 4
		WriteByte file, Asc(Mid$(tag, i, 1))
	Next
	WriteInt file, size
End Function

; The head of a node: a name of one letter, a position, a scale of 1 and no turn. A node ahead of it has the size of what follows.
Function WriteNode(file, size, name$)
	WriteTag file, "NODE", size
	WriteByte file, Asc(name) : WriteByte file, 0
	WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
	WriteFloat file, 1 : WriteFloat file, 1 : WriteFloat file, 1
	WriteFloat file, 1 : WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
End Function

; A row of triangles in the plane z = 0, each 2 wide and facing +z, the first one around x = 0 and the next ones every 2.5 units. All of
; their vertices are pulled by one bone, which is 0 units to the right at frame 0 and 1000 units to the right at frame 10. 80 are made as
; that is more than the number of triangles from which the physics library is asked which are near (picks 32, collisions 64).
; Sizes: vertices 12 + 36 n, triangles 4 + 12 n, mesh 4 + (8 + 12 + 36 n) + (8 + 4 + 12 n), bone 24 n, keys 36, bone node 42 + (8 + 24 n) +
; (8 + 36), the length 12, the mesh node 42 + mesh + (8 + 12) + (8 + bone node).
Function WriteModel(name$, n)
	mesh_size = 36 + 48 * n
	bone_node = 94 + 24 * n
	node_size = 42 + (8 + mesh_size) + 20 + (8 + bone_node)
	file = WriteFile(name)
	WriteTag file, "BB3D", 4 + 8 + node_size
	WriteInt file, 1
	WriteNode file, node_size, "m"
	WriteTag file, "MESH", mesh_size
	WriteInt file, -1
	WriteTag file, "VRTS", 12 + 36 * n
	WriteInt file, 0 : WriteInt file, 0 : WriteInt file, 0
	For i = 0 To n - 1
		x# = i * 2.5
		WriteFloat file, x - 1 : WriteFloat file, -1 : WriteFloat file, 0
		WriteFloat file, x + 1 : WriteFloat file, -1 : WriteFloat file, 0
		WriteFloat file, x : WriteFloat file, 1 : WriteFloat file, 0
	Next
	WriteTag file, "TRIS", 4 + 12 * n
	WriteInt file, -1
	For i = 0 To n - 1
		WriteInt file, i * 3 : WriteInt file, i * 3 + 1 : WriteInt file, i * 3 + 2
	Next
	WriteTag file, "ANIM", 12
	WriteInt file, 0 : WriteInt file, 10 : WriteFloat file, 10
	WriteNode file, bone_node, "b"
	WriteTag file, "BONE", 24 * n
	For i = 0 To n * 3 - 1
		WriteInt file, i : WriteFloat file, 1
	Next
	WriteTag file, "KEYS", 36
	WriteInt file, 1
	WriteInt file, 0 : WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
	WriteInt file, 10 : WriteFloat file, 1000 : WriteFloat file, 0 : WriteFloat file, 0
	CloseFile file
End Function

Const T_PLAYER = 1, T_MODEL = 2

; A model with one triangle, and one with 80, for the test of each way in which the triangles are looked at.
folder$ = "suite_tmp_animated_collisions"
CreateDir folder
For variant = 0 To 1
	n = 1
	If variant = 1 Then n = 80
	name$ = folder + "/row.b3d"
	WriteModel name, n
	model = LoadAnimMesh(name)
	CheckTrue "LoadAnimMesh of the fixture", model <> 0
	EntityType model, T_MODEL
	EntityPickMode model, 2
	Collisions T_PLAYER, T_MODEL, 2, 2
	player = CreatePivot()
	EntityType player, T_PLAYER
	EntityRadius player, 0.5

	For frame = 0 To 10 Step 10
		SetAnimTime model, frame
		here = 0
		gone = 1000
		If frame = 10 Then here = 1000 : gone = 0

		; Picks from the front (+z) see the triangle where it is posed now.
		CheckTrue "Pick where the triangle is at frame " + frame + " with " + n, LinePick(here, 0, 5, 0, 0, -10) = model
		CheckFalse "No pick where the triangle was at frame " + frame + " with " + n, LinePick(gone, 0, 5, 0, 0, -10) <> 0

		; A ball that moves into the triangle is stopped by it, and one that moves into where it was is not.
		PositionEntity player, here, 0, 2
		ResetEntity player
		PositionEntity player, here, 0, 0.2
		UpdateWorld
		Check "Ball stopped by the posed triangle at frame " + frame + " with " + n, CountCollisions(player), 1
		Check "Ball is in front of the posed triangle at frame " + frame + " with " + n, EntityZ(player), 0.5, 0.01

		PositionEntity player, gone, 0, 2
		ResetEntity player
		PositionEntity player, gone, 0, 0.2
		UpdateWorld
		Check "Ball passes where the triangle was at frame " + frame + " with " + n, CountCollisions(player), 0
	Next

	; Back to the first frame, so that nothing is kept from the pose before.
	SetAnimTime model, 0
	CheckTrue "Pick after going back", LinePick(0, 0, 5, 0, 0, -10) = model
	CheckFalse "No pick where it was before going back", LinePick(1000, 0, 5, 0, 0, -10) <> 0

	FreeEntity player
	FreeEntity model
	ClearCollisions
Next

DeleteFile folder + "/row.b3d"
DeleteDir folder
EndGraphics
Done "blitz3d_animated_collisions"
