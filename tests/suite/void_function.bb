; Void functions return no data: they can be called as statements and end with a plain Return.
Global Counter:Int32 = 0

Function Add:Void(amount:Int32)
	If amount < 0 Then Return
	Counter = Counter + amount
End Function

Function Nothing:Void()
End Function

Add(5)
Add -3
Add 2
Nothing()
If Counter <> 7 Then RuntimeError "Void function did not run: " + Counter
