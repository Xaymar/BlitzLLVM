; Collisions with a response other than 1, 2 and 3. The original takes any value: it neither stops nor limits the slide, which the
; samples of Blitz3D rely on (Collisions type, type, 2, 0).
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Const T_PLAYER = 1, T_GROUND = 2

; The ground is a cube that is 20 wide, 2 high and 20 deep, with its top at y = 0.
ground = CreateCube()
ScaleEntity ground, 10, 1, 10
PositionEntity ground, 0, -1, 0
EntityType ground, T_GROUND
EntityPickMode ground, 2

player = CreatePivot()
EntityType player, T_PLAYER
EntityRadius player, 1

For response = 0 To 4 Step 4
	ClearCollisions
	Collisions T_PLAYER, T_GROUND, 2, response
	PositionEntity player, 0, 5, 0
	ResetEntity player
	For i = 1 To 40
		TranslateEntity player, 0, -0.3, 0
		UpdateWorld
	Next
	Check "Response " + response + " lands on the ground", EntityY(player), 1, 0.05
	Check "Response " + response + " reports the collision", EntityCollided(player, T_GROUND), ground
Next
