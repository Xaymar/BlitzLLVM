; Math: Sin Cos Tan ASin ACos ATan ATan2 Sqr Floor Ceil Exp Log Log10 Rnd Rand SeedRnd, plus the operators and the
; conversions that the language has (Abs Sgn Mod Int Float).
Include "check.bb"

; Angles are in degrees.
Check "Sin 0", Sin(0), 0
Check "Sin 30", Sin(30), 0.5, 0.0001
Check "Sin 90", Sin(90), 1
Check "Sin 270", Sin(270), -1
Check "Cos 0", Cos(0), 1
Check "Cos 60", Cos(60), 0.5, 0.0001
Check "Cos 180", Cos(180), -1
Check "Tan 45", Tan(45), 1, 0.0001
Check "Tan 0", Tan(0), 0
Check "ASin 1", ASin(1), 90, 0.001
Check "ASin 0.5", ASin(0.5), 30, 0.001
Check "ACos 1", ACos(1), 0, 0.001
Check "ACos 0", ACos(0), 90, 0.001
Check "ACos -1", ACos(-1), 180, 0.001
Check "ATan 1", ATan(1), 45, 0.001
Check "ATan -1", ATan(-1), -45, 0.001
Check "ATan2 1,1", ATan2(1, 1), 45, 0.001
Check "ATan2 1,0", ATan2(1, 0), 90, 0.001
Check "ATan2 0,-1", ATan2(0, -1), 180, 0.001
Check "ATan2 -1,0", ATan2(-1, 0), -90, 0.001

; Roots, rounding and powers.
Check "Sqr 16", Sqr(16), 4
Check "Sqr 2", Sqr(2), 1.41421356, 0.00001
Check "Sqr 0", Sqr(0), 0
Check "Floor 2.7", Floor(2.7), 2
Check "Floor -2.1", Floor(-2.1), -3
Check "Floor 5", Floor(5), 5
Check "Ceil 2.1", Ceil(2.1), 3
Check "Ceil -2.7", Ceil(-2.7), -2
Check "Ceil 5", Ceil(5), 5
Check "Exp 0", Exp(0), 1
Check "Exp 1", Exp(1), 2.7182818, 0.00001
Check "Log 1", Log(1), 0
Check "Log e", Log(2.7182818), 1, 0.00001
Check "Log10 1000", Log10(1000), 3, 0.00001
Check "Log10 1", Log10(1), 0
Check "Log10 0.01", Log10(0.01), -2, 0.00001

; Abs, Sgn, Mod, Int and Float belong to the language.
Check "Abs -3", Abs(-3), 3
Check "Abs 3.5", Abs(3.5), 3.5
Check "Abs 0", Abs(0), 0
Check "Sgn -7", Sgn(-7), -1
Check "Sgn 0", Sgn(0), 0
Check "Sgn 0.2", Sgn(0.2), 1
Check "Mod 10,3", 10 Mod 3, 1
Check "Mod -10,3", -10 Mod 3, -1
Check "Mod 7.5,2", 7.5 Mod 2, 1.5
; The original rounds to the nearest whole number, and halves go to the even one.
Check "Int 2.5", Int(2.5), 2
Check "Int 3.5", Int(3.5), 4
Check "Int 2.4", Int(2.4), 2
Check "Int -2.5", Int(-2.5), -2
Check "Int -2.6", Int(-2.6), -3
Check "Float 3", Float(3) / 2, 1.5
Check "Power", 2 ^ 10, 1024
Check "Power fraction", 4 ^ 0.5, 2, 0.0001
Check "Shl", 1 Shl 4, 16
Check "Shr", 256 Shr 4, 16
Check "Sar", -16 Sar 2, -4
Check "And", 12 And 10, 8
Check "Or", 12 Or 10, 14
Check "Xor", 12 Xor 10, 6
Check "Not 0", Not 0, 1
Check "Not 5", Not 5, 0
Check "Precedence", 2 + 3 * 4 ^ 2 / 8, 8

; Random numbers: the same seed gives the same numbers, and they stay in range.
SeedRnd 1234
a# = Rnd(0, 1)
b# = Rnd(0, 1)
SeedRnd 1234
Check "SeedRnd repeats a", Rnd(0, 1), a
Check "SeedRnd repeats b", Rnd(0, 1), b
Check "SeedRnd differs", (a <> b), 1
For i = 1 To 500
	r# = Rnd(5)
	If r < 0 Or r >= 5 Then RuntimeError "Rnd(5) out of range: " + r
	r = Rnd(-2, 3)
	If r < -2 Or r >= 3 Then RuntimeError "Rnd(-2,3) out of range: " + r
	n = Rand(10)
	If n < 1 Or n > 10 Then RuntimeError "Rand(10) out of range: " + n
	n = Rand(-3, 3)
	If n < -3 Or n > 3 Then RuntimeError "Rand(-3,3) out of range: " + n
Next
; All values of a small range show up.
Dim seen(5)
For i = 1 To 500
	seen(Rand(1, 5)) = 1
Next
For i = 1 To 5
	CheckTrue "Rand reaches " + i, seen(i)
Next
Check "Rand single value", Rand(7, 7), 7

; RndSeed gives the state that the next number is made from, and seeding with it repeats the numbers.
SeedRnd 77
CheckTrue "RndSeed after SeedRnd", RndSeed() = 77
a = Rand(1, 1000)
CheckTrue "RndSeed moves on", RndSeed() <> 77
state = RndSeed()
b = Rand(1, 1000)
SeedRnd state
Check "RndSeed repeats", Rand(1, 1000), b
SeedRnd 0
CheckTrue "SeedRnd 0 is 1", RndSeed() = 1
; The numbers are the ones that Blitz makes: 0x1234 is the seed a program starts with.
SeedRnd 4660
Check "Blitz Rand", Rand(1, 1000), 356

Done "math"
