; Variables, fields and array elements hold objects: a deleted object is freed when the last one lets go, and the others can tell it is gone.
Type Node
	Field value
	Field link.Node
End Type

Dim slots.Node(3)

Global shared.Node
Global failures = 0

Function Check(name$, ok)
	If Not ok Then
		failures = failures + 1
		Print "FAIL: " + name$
	EndIf
End Function

Function Count()
	Local n.Node, c = 0
	For n = Each Node
		c = c + 1
	Next
	Return c
End Function

; Holders: Count sees only the objects that are not deleted.
Local a.Node = New Node
Local b.Node = a
shared = a
slots(2) = a
a\link = New Node
Check("four holders", Count() = 2)
Delete a
Check("deleted object is not counted", Count() = 1)
Check("holder of a became Null", a = Null)
Check("b is still set", b <> Null)

; Functions hold their parameters and drop their locals.
Function Churn(n.Node)
	Local t.Node = New Node
	t\link = n
	Delete t
	Return 1
End Function
Local keep.Node = New Node
Local i
For i = 1 To 1000
	Churn(keep)
Next
Check("churn leaves one", Count() = 2)

; Dim again lets go of the elements.
Local d.Node = New Node
slots(1) = d
Delete d
Dim slots.Node(3)
Check("slots are empty", slots(1) = Null)

If failures = 0 Then Print "ok"
