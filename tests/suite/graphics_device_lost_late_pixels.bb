; A graphics device that is lost is noticed late: the calls of the program between the loss and the next Flip fail on the device,
; and what they made (textures, images, meshes) is there when the graphics are made again. Needs a window and a GPU. With
; BLITZLLVM_SIMULATE_DEVICE_LOSS_LATE the loss is only noticed after the 3rd Flip.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_device_lost_late_pixels: skipped, there is no window."
	End
EndIf

SetEnv "BLITZLLVM_SIMULATE_DEVICE_LOSS", "3"
SetEnv "BLITZLLVM_SIMULATE_DEVICE_LOSS_LATE", "1"
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Const SIZE = 8

Function Fill(buffer, seed)
	LockBuffer buffer
	For y = 0 To SIZE - 1
		For x = 0 To SIZE - 1
			WritePixelFast x, y, $FF000000 Or (((x * 28 + seed) And 255) Shl 16) Or (((y * 28 + seed * 3) And 255) Shl 8) Or ((x + y) * 9 + 40), buffer
		Next
	Next
	UnlockBuffer buffer
End Function

Function Hash(buffer)
	h = 0
	For y = 0 To SIZE - 1
		For x = 0 To SIZE - 1
			h = (h * 31 + (ReadPixel(x, y, buffer) And $FFFFFF)) And $7FFFFFFF
		Next
	Next
	Return h
End Function

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
Global cube = CreateCube()
EntityFX cube, 1
PositionEntity cube, 0, 0, 3

Flip
Flip
Flip

; The device is lost now, and the program does not know. All of it has to go on without an error.
Global tex = CreateTexture(SIZE, SIZE, 1)
Fill TextureBuffer(tex), 11
Global img = CreateImage(SIZE, SIZE)
Fill ImageBuffer(img), 22
EntityTexture cube, tex
Cls
RenderWorld
DrawBlock img, 3, 4
Color 10, 200, 30
Rect 40, 40, 30, 30, 1
Text 5, 60, "lost"
tri = CreateMesh()
sf = CreateSurface(tri)
AddVertex sf, 0, 0, 0 : AddVertex sf, 1, 0, 0 : AddVertex sf, 0, 1, 0
AddTriangle sf, 0, 1, 2
UpdateNormals tri
RenderWorld
Flip

; The graphics were made again at that Flip.
CheckTrue "GraphicsLost says that the device was lost", GraphicsLost()
CheckFalse "GraphicsLost says it once", GraphicsLost()
Fill TextureBuffer(tex), 11
Local want = Hash(TextureBuffer(tex))
Check "A texture made while the device was lost", Hash(TextureBuffer(tex)), want
Check "An image made while the device was lost", ReadPixel(2, 2, ImageBuffer(img)) And $FF0000, ((2 * 28 + 22) And 255) Shl 16

Cls
EntityTexture cube, tex
RenderWorld
CheckTrue "The cube is drawn", (ReadPixel(70, 50, BackBuffer()) And $FFFFFF) <> 0
Flip
CheckFalse "Nothing was lost since", GraphicsLost()
Done "graphics_device_lost_late_pixels"
