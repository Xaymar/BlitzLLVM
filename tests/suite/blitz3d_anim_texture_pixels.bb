; The frames of an animated texture (LoadAnimTexture, and CreateTexture with frames), which needs a window and a GPU, so this is skipped
; without one. Every frame is a texture of its own like in the original: filtering, wrapping and mip maps stay inside the frame, and frames
; of one texture are still one call.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_anim_texture_pixels: skipped, there is no window."
	End
EndIf

Const W = 128, H = 128
Graphics3D W, H, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
CameraClsColor camera, 40, 40, 40
PositionEntity camera, 0, 0, -1.5

; A square that shows the texture with the coordinates from 0 to u, about 80 pixels wide in the middle of the picture.
Function MakeSquare(u#)
	Local m = CreateMesh()
	Local s = CreateSurface(m)
	AddVertex s, -1, 1, 0, 0, 0 : AddVertex s, 1, 1, 0, u#, 0
	AddVertex s, 1, -1, 0, u#, u# : AddVertex s, -1, -1, 0, 0, u#
	AddTriangle s, 0, 1, 2 : AddTriangle s, 0, 2, 3
	EntityFX m, 1
	Return m
End Function

; The colors that the frames have: red, green, blue, yellow.
Function FrameRed(f)
	If f = 0 Or f = 3 Then Return 255
	Return 0
End Function
Function FrameGreen(f)
	If f = 1 Or f = 3 Then Return 255
	Return 0
End Function
Function FrameBlue(f)
	If f = 2 Then Return 255
	Return 0
End Function

; Whether the pixel is the color of the frame, all the way to the edge of the square (30 to 97 are inside it).
Function FrameIsPure(f)
	Local x, y, c
	For y = 32 To 95 Step 3
		For x = 28 To 99 Step 3
			c = ReadPixel(x, y, BackBuffer()) And $FFFFFF
			If c <> ((FrameRed(f) Shl 16) Or (FrameGreen(f) Shl 8) Or FrameBlue(f)) Then Return False
		Next
	Next
	Return True
End Function

Function Show(m, tex, f)
	EntityTexture m, tex, f
	RenderWorld
End Function

; Frames made by CreateTexture are drawn to one at a time.
frames = CreateTexture(8, 8, 1 + 4096, 4)
For f = 0 To 3
	SetBuffer TextureBuffer(frames, f)
	ClsColor FrameRed(f), FrameGreen(f), FrameBlue(f)
	Cls
Next
SetBuffer BackBuffer()
Check "CreateTexture frame width", TextureWidth(frames), 8
Check "CreateTexture frame height", TextureHeight(frames), 8
Check "CreateTexture frames", TextureFrames(frames), 4

; Reading a frame gives its own color, and nothing leaked into the others.
For f = 0 To 3
	SetBuffer TextureBuffer(frames, f)
	c = ReadPixel(4, 4) And $FFFFFF
	Check "Frame " + f + " color", c, (FrameRed(f) Shl 16) Or (FrameGreen(f) Shl 8) Or FrameBlue(f), 0
Next
SetBuffer BackBuffer()

m = MakeSquare(1)
For f = 0 To 3
	Show m, frames, f
	CheckTrue "Frame " + f + " is only its own color, up to the edges, with linear filtering", FrameIsPure(f)
Next
FreeEntity m

; Where the coordinates go past the frame they wrap around inside it, and do not show a neighbour.
m = MakeSquare(2.5)
For f = 0 To 3
	Show m, frames, f
	CheckTrue "Frame " + f + " wraps inside itself", FrameIsPure(f)
Next
FreeEntity m

; A picture of frames that is loaded behaves the same. It is made here: 2 by 2 cells of 16 pixels.
sheet = CreateTexture(32, 32, 1 + 4096)
SetBuffer TextureBuffer(sheet)
For f = 0 To 3
	Color FrameRed(f), FrameGreen(f), FrameBlue(f)
	Rect (f Mod 2) * 16, (f / 2) * 16, 16, 16, 1
Next
SaveBuffer TextureBuffer(sheet), "anim_texture_sheet.bmp"
SetBuffer BackBuffer()
FreeTexture sheet

loaded = LoadAnimTexture("anim_texture_sheet.bmp", 1 + 8, 16, 16, 0, 4)
CheckTrue "LoadAnimTexture", loaded <> 0
Check "LoadAnimTexture frame width", TextureWidth(loaded), 16
Check "LoadAnimTexture frames", TextureFrames(loaded), 4
m = MakeSquare(1)
For f = 0 To 3
	Show m, loaded, f
	CheckTrue "Loaded frame " + f + " is only its own color, up to the edges", FrameIsPure(f)
Next
FreeEntity m
m = MakeSquare(3)
For f = 0 To 3
	Show m, loaded, f
	CheckTrue "Loaded frame " + f + " wraps inside itself with mip maps", FrameIsPure(f)
Next
FreeEntity m

; A frame that starts later in the picture.
second = LoadAnimTexture("anim_texture_sheet.bmp", 1, 16, 16, 2, 2)
m = MakeSquare(1)
Show m, second, 0
CheckTrue "The first frame is the third cell", FrameIsPure(2)
Show m, second, 1
CheckTrue "The second frame is the fourth cell", FrameIsPure(3)
FreeEntity m

; Frames that are far away, with mip maps, still do not mix: the smaller levels belong to the frame too.
far = LoadAnimTexture("anim_texture_sheet.bmp", 1 + 8, 16, 16, 0, 4)
m = MakeSquare(1)
ScaleEntity m, 0.1, 0.1, 1
For f = 0 To 3
	Show m, far, f
	c = ReadPixel(W / 2, H / 2, BackBuffer()) And $FFFFFF
	Check "Small frame " + f, c, (FrameRed(f) Shl 16) Or (FrameGreen(f) Shl 8) Or FrameBlue(f), 0
Next
FreeEntity m

; Entities that show different frames of one texture are drawn together.
original = CreateCube()
HideEntity original
Dim copies(15)
For i = 0 To 15
	copies(i) = CopyEntity(original)
	EntityFX copies(i), 1
	EntityTexture copies(i), loaded, i Mod 4
	ScaleEntity copies(i), 0.1, 0.1, 0.1
	PositionEntity copies(i), (i Mod 4) - 1.5, (i / 4) - 1.5, 0
Next
RenderWorld
CheckTrue "Frames of one texture are one call (" + Stats3D(1000) + " calls)", Stats3D(1000) <= 1
CheckTrue "One texture is set (" + Stats3D(1002) + ")", Stats3D(1002) <= 1
; Each of them shows its own frame: all four colors are in the picture.
Dim seen(3)
For y = 0 To H - 1
	For x = 0 To W - 1
		c = ReadPixel(x, y, BackBuffer()) And $FFFFFF
		For f = 0 To 3
			If c = ((FrameRed(f) Shl 16) Or (FrameGreen(f) Shl 8) Or FrameBlue(f)) Then seen(f) = seen(f) + 1
		Next
	Next
Next
For f = 0 To 3
	CheckTrue "Frame " + f + " is on the cubes (" + seen(f) + " pixels)", seen(f) > 100
Next

DeleteFile "anim_texture_sheet.bmp"
Print "blitz3d_anim_texture_pixels: " + suite_checks + " checks passed."
End
