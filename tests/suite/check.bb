; What every test of the suite uses. A test stops with an error as soon as something is not what it should be, and
; prints how many things it checked when it is done.
Global suite_checks = 0

; A number: got has to be within tolerance of want.
Function Check(name$, got#, want#, tolerance# = 0.0001)
	suite_checks = suite_checks + 1
	If Abs(got - want) > tolerance Then RuntimeError name + ": got " + got + ", expected " + want
End Function

; A string.
Function CheckS(name$, got$, want$)
	suite_checks = suite_checks + 1
	If got <> want Then RuntimeError name + ": got '" + got + "', expected '" + want + "'"
End Function

; Something that has to be true.
Function CheckTrue(name$, condition)
	suite_checks = suite_checks + 1
	If condition = 0 Then RuntimeError name + ": was false"
End Function

; Something that has to be false.
Function CheckFalse(name$, condition)
	suite_checks = suite_checks + 1
	If condition <> 0 Then RuntimeError name + ": was true"
End Function

; Ends the test.
Function Done(suite$)
	Print suite + ": " + suite_checks + " checks passed."
End Function
