; Dim: the first index changes fastest, and arrays whose rows are a multiple of 1 KiB long (which get padding between the rows)
; keep every element apart from the others, also after Dim is used again.
Include "check.bb"

; A row of 256 integers is 1 KiB long, which is where the padding starts.
Dim wide(255, 63)
For y = 0 To 63
	For x = 0 To 255
		wide(x, y) = x + y * 1000
	Next
Next
bad = 0
For y = 0 To 63
	For x = 0 To 255
		If wide(x, y) <> x + y * 1000 Then bad = bad + 1
	Next
Next
Check "Wide rows keep their values", bad, 0
Check "Wide first element", wide(0, 0), 0
Check "Wide end of the first row", wide(255, 0), 255
Check "Wide start of the second row", wide(0, 1), 1000
Check "Wide last element", wide(255, 63), 255 + 63000

; Three dimensions and a string array with the same row length.
Dim cube(255, 3, 2)
For z = 0 To 2
	For y = 0 To 3
		For x = 0 To 255
			cube(x, y, z) = x + y * 300 + z * 5000
		Next
	Next
Next
bad = 0
For z = 0 To 2
	For y = 0 To 3
		For x = 0 To 255
			If cube(x, y, z) <> x + y * 300 + z * 5000 Then bad = bad + 1
		Next
	Next
Next
Check "Cube keeps its values", bad, 0

Dim names$(127, 3)
For y = 0 To 3
	For x = 0 To 127
		names$(x, y) = "n" + x + "_" + y
	Next
Next
bad = 0
For y = 0 To 3
	For x = 0 To 127
		If names$(x, y) <> "n" + x + "_" + y Then bad = bad + 1
	Next
Next
Check "Strings keep their values", bad, 0

; Dimensioning again starts from zeros, with the same or another size.
Dim wide(255, 63)
Check "Wide is empty after Dim again", wide(255, 63) + wide(0, 1), 0
Dim wide(511, 3)
wide(511, 3) = 7
wide(0, 1) = 9
Check "Another size", wide(511, 3) + wide(0, 1), 16

; Other row lengths are not padded and behave the same.
Dim narrow(99, 99)
For y = 0 To 99
	For x = 0 To 99
		narrow(x, y) = x * y
	Next
Next
Check "Narrow", narrow(99, 99) + narrow(1, 2), 9801 + 2

Done "language_arrays"
