; Scancodes: KeyHit with the codes of the keys that the original has (DirectInput), VKeyHit with the SDL scancodes, and with one
; keyboard. BLITZLLVM_TEST_EVENTS presses kN, which presses and releases the key with code N (256 plus the SDL scancode for
; keys that DirectInput has no code for).
Include "check.bb"

Graphics 160, 120, 32, 2
Local buffer = SetBuffer(BackBuffer())

; Keys that already worked keep their code.
SetEnv "BLITZLLVM_TEST_EVENTS", "k1,k30,k57,k200,k211"
Check "Escape", KeyHit(1), 1
Check "A", KeyHit(30), 1
Check "Space", KeyHit(57), 1
Check "Up", KeyHit(200), 1
Check "Delete", KeyHit(211), 1
Check "A only once", KeyHit(30), 0

; Keys that the original has a code for, but that were left out: F13 to F15, Pause, Print Screen, the Windows keys, the
; menu key, the media keys, Num= and Num, and the international keys.
SetEnv "BLITZLLVM_TEST_EVENTS", "k100,k101,k102,k197,k183,k219,k220,k221,k86,k141,k179,k160,k174,k176,k162,k164,k144,k153,k112,k125"
Dim codes(19)
codes(0)  = 100 : codes(1)  = 101 : codes(2)  = 102 : codes(3)  = 197 : codes(4)  = 183
codes(5)  = 219 : codes(6)  = 220 : codes(7)  = 221 : codes(8)  = 86  : codes(9)  = 141
codes(10) = 179 : codes(11) = 160 : codes(12) = 174 : codes(13) = 176 : codes(14) = 162
codes(15) = 164 : codes(16) = 144 : codes(17) = 153 : codes(18) = 112 : codes(19) = 125
For i = 0 To 19
	Check "DirectInput key " + codes(i), KeyHit(codes(i)), 1
Next

; Keys without a code in the original are reached with VKeyHit and the SDL scancode. F16 is 107, F24 is 115, Help is 117, Undo is
; 122. The injector presses them with 256 plus the SDL scancode.
SetEnv "BLITZLLVM_TEST_EVENTS", "k363,k371,k373,k378"
Check "VKeyHit F16", VKeyHit(107), 1
Check "VKeyHit F24", VKeyHit(115), 1
Check "VKeyHit Help", VKeyHit(117), 1
Check "VKeyHit Undo", VKeyHit(122), 1
Check "VKeyHit F16 only once", VKeyHit(107), 0
Check "VKeyHit nothing pressed", VKeyHit(108), 0
Check "VKeyHit past the last key", VKeyHit(512), 0
Check "VKeyHit 0", VKeyHit(0), 0
CheckFalse "VKeyDown past the last key", VKeyDown(100000)

; The keys with a DirectInput code are the same key for both: F13 is 100 and SDL scancode 104, A is 30 and 4.
SetEnv "BLITZLLVM_TEST_EVENTS", "k100,k30"
Check "VKeyHit F13", VKeyHit(104), 1
Check "KeyHit F13 was taken by VKeyHit", KeyHit(100), 0
Check "VKeyHit A", VKeyHit(4), 1
Check "KeyHit A was taken by VKeyHit", KeyHit(30), 0
SetEnv "BLITZLLVM_TEST_EVENTS", "k100"
Check "KeyHit F13", KeyHit(100), 1

; KeyDown and KeyHit know only the codes of the original.
SetEnv "BLITZLLVM_TEST_EVENTS", "k363,k371"
Check "KeyHit 363", KeyHit(363), 0
Check "KeyHit 256", KeyHit(256), 0
Check "KeyHit 238", KeyHit(238), 0
CheckFalse "KeyDown 363", KeyDown(363)
FlushKeys

; Both work per keyboard as well.
SetEnv "BLITZLLVM_TEST_EVENTS", "+k900,+k901"
Local k0 = KeyboardDeviceCount() - 2
Local k1 = KeyboardDeviceCount() - 1
SetEnv "BLITZLLVM_TEST_EVENTS", "d900,k363,k100"
Check "VKeyHit F16 on the first keyboard", VKeyHit(107, k0), 1
Check "VKeyHit F16 on the second keyboard", VKeyHit(107, k1), 0
Check "KeyHit F13 on the first keyboard", KeyHit(100, k0), 1
