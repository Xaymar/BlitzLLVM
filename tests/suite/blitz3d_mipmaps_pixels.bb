; this is skipped without one: texture flag 8 (mip maps) on LoadTexture and CreateTexture. A cube whose front face is 16, 8
; or 4 pixels wide shows the mip level that is 1, 2 or 4 times smaller than the texture, which has 16 texels. The DDS files
; have a level of their own color for each: red, green, blue, yellow and white, and the colors that are drawn to a texture
; have to reach the levels below as well.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_mipmaps_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
Global cube = CreateCube()
EntityFX cube, 1

; The front face of the cube is 160 / distance pixels wide, as the view is 90 degrees wide and the face is 2 across.
Function Show(texture, distance)
	EntityTexture cube, texture
	PositionEntity cube, 0, 0, distance + 1
	RenderWorld
End Function

; What the level is that shows: red is the first, green the second, blue the third.
Function CheckLevel(name$, texture, distance, red, green, blue)
	Show texture, distance
	Check name + " red", R(80, 60), red, 40
	Check name + " green", G(80, 60), green, 40
	Check name + " blue", B(80, 60), blue, 40
End Function

; Graphics3D starts out with the filter that gives every texture color and mip maps, like the original.
fallback = LoadTexture("images/dxt1_mips.dds")
CheckLevel "Mip maps from the default filter", fallback, 20, 0, 255, 0
FreeTexture fallback
ClearTextureFilters

; Stored levels are used as they are.
mipped = LoadTexture("images/dxt1_mips.dds", 1 + 8 + 4096)
CheckTrue "LoadTexture with mip maps", mipped <> 0
Check "A texture with mip maps keeps its size", TextureWidth(mipped), 16
CheckLevel "Stored level 0", mipped, 10, 255, 0, 0
CheckLevel "Stored level 1", mipped, 20, 0, 255, 0
CheckLevel "Stored level 2", mipped, 40, 0, 0, 255

; Without flag 8 only the first level is used.
flat = LoadTexture("images/dxt1_mips.dds", 1)
CheckLevel "Flag 8 missing, far", flat, 40, 255, 0, 0
CheckLevel "Flag 8 missing, near", flat, 10, 255, 0, 0

; Levels that are smaller than a block, and that are not square.
wide = LoadTexture("images/dxt1_wide_mips.dds", 1 + 8)
CheckTrue "LoadTexture with wide mip maps", wide <> 0
Check "A wide texture keeps its width", TextureWidth(wide), 16
Check "A wide texture keeps its height", TextureHeight(wide), 4
CheckLevel "Wide level 0", wide, 10, 255, 0, 0

; A file that ends in the middle of a level keeps the levels before it, and the last one is used for what is further away.
source = ReadFile("images/dxt1_mips.dds")
folder$ = "suite_tmp_mips"
CreateDir folder
cut = WriteFile(folder + "/cut.dds")
For i = 1 To 128 + 128 + 32 + 4
	WriteByte cut, ReadByte(source)
Next
CloseFile cut
CloseFile source
short = LoadTexture(folder + "/cut.dds", 1 + 8)
CheckTrue "LoadTexture with a cut chain", short <> 0
CheckLevel "Cut chain, level 1", short, 20, 0, 255, 0
CheckLevel "Cut chain, last level far away", short, 40, 0, 255, 0
FreeTexture short
DeleteFile folder + "/cut.dds"
DeleteDir folder

; Textures that the file has no levels for get them made, and so do the ones with colors that were converted.
single = LoadTexture("images/dxt5.dds", 1 + 2 + 8)
CheckTrue "LoadTexture with mip maps made from a single level", single <> 0
Check "A texture made into levels keeps its size", TextureWidth(single), 8
FreeTexture single

; Drawn on: the average of the pixels is what shows from afar. Every other pixel is white, so any level below the first is grey.
checker = CreateTexture(64, 64, 1 + 8 + 4096)
SetBuffer TextureBuffer(checker)
Color 0, 0, 0
Rect 0, 0, 64, 64, True
Color 255, 255, 255
For y = 0 To 63
	For x = 0 To 63
		If ((x + y) Mod 2) = 0 Then Plot x, y
	Next
Next
SetBuffer BackBuffer()
Show checker, 16
Check "Mip maps of a drawn texture, red", R(81, 60), 128, 24
Check "Mip maps of a drawn texture, green", G(81, 60), 128, 24
Check "Mip maps of a drawn texture, blue", B(81, 60), 128, 24

; Drawing again changes the levels as well.
SetBuffer TextureBuffer(checker)
Color 0, 255, 0
Rect 0, 0, 64, 64, True
SetBuffer BackBuffer()
Show checker, 16
Check "Mip maps after drawing again, red", R(81, 60), 0, 24
Check "Mip maps after drawing again, green", G(81, 60), 255, 24
Check "Mip maps after drawing again, blue", B(81, 60), 0, 24

; A texture that is drawn on after it was converted from compressed blocks has levels that are made from what it shows now,
; and not the ones from the file any more.
FreeTexture mipped
mipped = LoadTexture("images/dxt1_mips.dds", 1 + 8 + 4096)
SetBuffer TextureBuffer(mipped)
Color 255, 255, 255
Plot 0, 0
SetBuffer BackBuffer()
Show mipped, 10
Check "A converted texture shows its first level", R(80, 60), 255, 40
Show mipped, 40
Check "A converted texture has made levels, red", R(80, 60), 255, 40
Check "A converted texture has made levels, blue", B(80, 60), 0, 40

; Textures without any flags, or with only clamping, show the first level.
FreeTexture checker
plain = CreateTexture(64, 64, 1 + 4096)
SetBuffer TextureBuffer(plain)
Color 0, 0, 255
Rect 0, 0, 64, 64, True
SetBuffer BackBuffer()
Show plain, 40
Check "Without mip maps, blue", B(80, 60), 255, 24
Check "Without mip maps, red", R(80, 60), 0, 24

EndGraphics
Done "blitz3d_mipmaps_pixels"
