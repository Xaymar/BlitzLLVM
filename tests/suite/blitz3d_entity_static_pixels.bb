; EntityStatic tells the GPU-driven draws (BLITZLLVM_GPU_DRAWS=1) what is static: -1 keeps a mesh out of the table, 0 leaves it to the
; renderer (in after four untouched frames) and 1 puts it in without waiting. TrisRendered does not count the table, so it says which
; meshes the program drew itself (12 triangles for each cube). What is on the screen must never depend on it, also right after a
; static mesh is moved. Needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_entity_static_pixels: skipped, there is no window."
	End
EndIf

SetEnv "BLITZLLVM_GPU_DRAWS", "1"
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, -40
Global light = CreateLight()

Function Cube(x#, y#)
	c = CreateCube()
	EntityFX c, 1
	EntityColor c, 200, 100, 50
	PositionEntity c, x, y, 0
	Return c
End Function

Function Frames(count)
	For k = 1 To count
		RenderWorld
	Next
End Function

Function Lit(x#, y#)
	CameraProject camera, x, y, 0
	Return (ReadPixel(ProjectedX(), ProjectedY(), BackBuffer()) And $FFFFFF) <> 0
End Function

Global a = Cube(-8, 0)
Global b = Cube(0, 0)
Global c = Cube(8, 0)

; Nothing says anything: all of them settle into the table.
Frames 20
Check "Auto cubes are all in the table", TrisRendered(), 0
CheckTrue "Auto cubes are seen", Lit(-8, 0) And Lit(0, 0) And Lit(8, 0)

; Never: only the mesh that was told is drawn by the program, also when it was in the table already.
EntityStatic b, -1
Frames 1
Check "Never takes a mesh out of the table", TrisRendered(), 12
Frames 20
Check "Never stays out of the table", TrisRendered(), 12
CheckTrue "Never is seen", Lit(-8, 0) And Lit(0, 0) And Lit(8, 0)
PositionEntity b, 0, 100, 0
Frames 1
CheckTrue "Never moved away", Lit(0, 0) = 0
PositionEntity b, 0, 0, 0
Frames 1
CheckTrue "Never moved back", Lit(0, 0)

; Auto again: it goes back in after it settled.
EntityStatic b, 0
Frames 20
Check "Auto puts it back in the table", TrisRendered(), 0

; Always: it does not wait to settle. A new Auto cube is drawn by the program for four frames, an Always cube is in the table before that.
d = Cube(-8, 8)
e = Cube(8, 8)
EntityStatic e, 1
Frames 3
Check "Always does not wait, Auto does", TrisRendered(), 12
Frames 20
Check "Both in the table in the end", TrisRendered(), 0

; A mesh that is moved is not static: it is automatic again, and whatever the program does to it shows right away.
PositionEntity e, 8, 100, 0
Frames 1
CheckTrue "Always moved away", Lit(8, 8) = 0
PositionEntity e, 8, 8, 0
Frames 1
CheckTrue "Always moved back", Lit(8, 8)
Check "Moved always mesh waits to settle again", TrisRendered(), 12
Frames 20
Check "Moved always mesh settled", TrisRendered(), 0
For move = 1 To 5
	EntityStatic e, 1
	If move = 1 Then TranslateEntity e, 0, 0, 0
	If move = 2 Then MoveEntity e, 0, 0, 0
	If move = 3 Then TurnEntity e, 0, 0, 0
	If move = 4 Then ScaleEntity e, 1, 1, 1
	If move = 5 Then RotateEntity e, 0, 0, 0
	Frames 1
	Check "Always mesh is automatic after command " + move, TrisRendered(), 12
	Frames 20
Next
EntityStatic e, 1
Frames 20
EntityColor e, 0, 0, 0
Frames 1
CheckTrue "Always colored black", Lit(8, 8) = 0
HideEntity e
Frames 3
CheckTrue "Always hidden", Lit(8, 8) = 0
ShowEntity e
EntityColor e, 200, 100, 50
Frames 3
CheckTrue "Always shown again", Lit(8, 8)
Check "Always is in the table again", TrisRendered(), 0

; A copy has the same setting.
f = CopyEntity(e)
Frames 3
Check "The copy of an Always cube does not wait either", TrisRendered(), 0
FreeEntity f

; Values are only looked at by their sign.
EntityStatic a, -5
Frames 20
Check "Any negative value is Never", TrisRendered(), 12
EntityStatic a, 7
Frames 20
Check "Any positive value is Always", TrisRendered(), 0

Done "blitz3d_entity_static_pixels"
