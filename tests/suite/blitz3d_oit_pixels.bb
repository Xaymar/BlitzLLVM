; GraphicsOrderIndependentTransparency in 3D, which needs a window and a GPU, so this is skipped without one. Two see-through
; squares whose entities sit in the same place (so that sorting them by distance can't tell them apart) are drawn in both orders
; of creation. Sorted by distance, the order they were made in is the order they are blended in and the picture differs; added up
; without an order, both orders give the same picture. Multiply and add are checked against what they have to be.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_oit_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 64
Graphics3D W, H, 32, 2
SetBuffer BackBuffer()
CheckTrue "HWOrderIndependentTransparency is 1 or 0", HWOrderIndependentTransparency() = 1 Or HWOrderIndependentTransparency() = 0

Global camera = CreateCamera()
Local c1, c2, d1, d2, a, b, back
CameraRange camera, 0.1, 100
CameraClsColor camera, 0, 0, 0

; A square across the whole view at the distance z, whose entity is at the origin.
Function Layer(z#, r, g, b, alpha#, blend)
	Local m = CreateMesh()
	Local s = CreateSurface(m)
	AddVertex s, -20, -20, z# : AddVertex s, 20, -20, z# : AddVertex s, 20, 20, z# : AddVertex s, -20, 20, z#
	AddTriangle s, 0, 1, 2 : AddTriangle s, 0, 2, 3
	EntityFX m, 1 + 16 ; Not lit, and both sides.
	EntityColor m, r, g, b
	EntityAlpha m, alpha#
	EntityBlend m, blend
	Return m
End Function

Function Center()
	Return ReadPixel(W / 2, H / 2, BackBuffer())
End Function

Function Red(c) : Return (c Shr 16) And 255 : End Function
Function Green(c) : Return (c Shr 8) And 255 : End Function
Function Blue(c) : Return c And 255 : End Function

; Draws red at 5 and green at 8, made in the order given, and gives the middle pixel.
Function TwoLayers(redFirst)
	Local a, b
	If redFirst Then
		a = Layer(5, 255, 0, 0, 0.5, 1) : b = Layer(8, 0, 255, 0, 0.5, 1)
	Else
		b = Layer(8, 0, 255, 0, 0.5, 1) : a = Layer(5, 255, 0, 0, 0.5, 1)
	EndIf
	RenderWorld
	Local c = Center()
	FreeEntity a : FreeEntity b
	Return c
End Function

GraphicsOrderIndependentTransparency 0
c1 = TwoLayers(True)
c2 = TwoLayers(False)
CheckTrue "sorted by distance the order of creation changes the picture", Red(c1) <> Red(c2) Or Green(c1) <> Green(c2)

If HWOrderIndependentTransparency() Then
	GraphicsOrderIndependentTransparency 1
	c1 = TwoLayers(True)
	c2 = TwoLayers(False)
	Check "red of two layers does not depend on the order", Red(c1), Red(c2), 1
	Check "green of two layers does not depend on the order", Green(c1), Green(c2), 1
	CheckTrue "both layers are in the picture", Red(c1) > 20 And Green(c1) > 20
	; Two layers of 0.5 leave 0.25 of what is behind, so the color is the average of the two weighted by alpha: no black from the background shows more than 25%.
	CheckTrue "the opacity of two layers is three quarters", Red(c1) + Green(c1) > 255 * 3 / 4 * 0.8 And Red(c1) + Green(c1) < 255 * 3 / 4 * 1.2

	; Add: 0.5 of 100 on top of 0.5 of 60 on black is 80, whichever is first.
	a = Layer(5, 100, 100, 100, 0.5, 3) : b = Layer(8, 60, 60, 60, 0.5, 3)
	RenderWorld
	Check "add of two layers", Red(Center()), 80, 2
	FreeEntity a : FreeEntity b

	; Multiply: 200 times 128/255 times 128/255 of what is there (white from an opaque layer behind) is 50.
	back = Layer(12, 200, 200, 200, 1.0, 1)
	a = Layer(5, 128, 128, 128, 1.0, 2) : b = Layer(8, 128, 128, 128, 1.0, 2)
	RenderWorld
	Check "multiply of two layers over an opaque one", Red(Center()), 50, 2
	FreeEntity a : FreeEntity b : FreeEntity back

	; Mixed: the layers by alpha come first, then what is multiplied and then what is added.
	a = Layer(5, 100, 100, 100, 1.0, 3)
	b = Layer(8, 200, 200, 200, 1.0, 1)
	RenderWorld
	Check "added on top of an alpha layer", Red(Center()), 255, 1
	FreeEntity a : FreeEntity b
	GraphicsOrderIndependentTransparency 0
	d1 = TwoLayers(True)
	d2 = TwoLayers(False)
	CheckTrue "turning it off sorts by distance again", Red(d1) <> Red(d2) Or Green(d1) <> Green(d2)
EndIf
Done "blitz3d_oit_pixels"
