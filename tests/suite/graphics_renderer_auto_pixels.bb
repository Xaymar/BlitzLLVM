; Which renderer draws. BLITZLLVM_RENDERER names one, and without it (or with "auto") it is Vulkan, or the next one that the runtime has
; when Vulkan can not start. On Linux the test runs with VK_DRIVER_FILES pointing at nothing (code_compiler/CMakeLists.txt), so that
; Vulkan finds no driver and OpenGL has to draw. Needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_renderer_auto_pixels: skipped, there is no window."
	End
EndIf

wanted$ = Lower$(GetEnv$("BLITZLLVM_RENDERER"))
If wanted = "auto" Then wanted = ""
If wanted = "" Then
	wanted = "vulkan"
	If GetEnv$("VK_DRIVER_FILES") = "/nonexistent" Then wanted = "opengl"
EndIf

; The answer is the same before and after Graphics, and the list of drivers is the one of that renderer.
CheckS "renderer before Graphics", SystemProperty$("renderer"), wanted
CheckTrue "CountGfxDrivers", CountGfxDrivers() >= 1

Graphics 64, 48, 32, 2
SetBuffer BackBuffer()
CheckS "renderer after Graphics", SystemProperty$("renderer"), wanted

; It draws.
ClsColor 0, 0, 0
Cls
Color 255, 0, 0
Rect 0, 0, 10, 10, 1
Check "A red pixel", ReadPixel(3, 3) And $FFFFFF, $FF0000
Check "A black pixel", ReadPixel(30, 30) And $FFFFFF, 0

Done "graphics_renderer_auto_pixels"
