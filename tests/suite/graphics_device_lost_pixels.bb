; A graphics device that is lost is made again: GraphicsLost says so once for each loss, and textures and images have the pixels
; they were given. This needs a window and a GPU, so it is skipped without one. BLITZLLVM_SIMULATE_DEVICE_LOSS loses the device
; at those calls of Flip by making all of it again, which is what the runtime does after a real loss.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_device_lost_pixels: skipped, there is no window."
	End
EndIf

SetEnv "BLITZLLVM_SIMULATE_DEVICE_LOSS", "4,9"
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

CheckFalse "GraphicsLost is 0 before anything was lost", GraphicsLost()

Const SIZE = 8

; A picture of 8 by 8 pixels whose colors say where they are, shifted by 'seed' so that two of them differ.
Function Fill(buffer, seed)
	LockBuffer buffer
	For y = 0 To SIZE - 1
		For x = 0 To SIZE - 1
			WritePixelFast x, y, $FF000000 Or (((x * 28 + seed) And 255) Shl 16) Or (((y * 28 + seed * 3) And 255) Shl 8) Or ((x + y) * 9 + 40), buffer
		Next
	Next
	UnlockBuffer buffer
End Function

; One number for all the pixels of a buffer of 8 by 8.
Function Hash(buffer)
	h = 0
	For y = 0 To SIZE - 1
		For x = 0 To SIZE - 1
			h = (h * 31 + (ReadPixel(x, y, buffer) And $FFFFFF)) And $7FFFFFFF
		Next
	Next
	Return h
End Function

Global tex = CreateTexture(SIZE, SIZE, 1)
Global mipped = CreateTexture(SIZE * 2, SIZE * 2, 1 + 8)
Global img = CreateImage(SIZE, SIZE)
Fill TextureBuffer(tex), 10
Fill TextureBuffer(mipped), 20
Fill ImageBuffer(img), 30

; A texture and an image that were loaded from a file, and one that was freed (its handle is used again).
SaveBuffer TextureBuffer(tex), "suite_tmp_lost.bmp"
Global loaded = LoadTexture("suite_tmp_lost.bmp", 1)
Global loaded_img = LoadImage("suite_tmp_lost.bmp")
gone = CreateTexture(4, 4, 1)
FreeTexture gone

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
Global cube = CreateCube()
EntityFX cube, 1
PositionEntity cube, 0, 0, 3

; What is on screen, in a few places: the cube with the texture (3D) and the image (2D).
Function Scene3D()
	EntityTexture cube, tex
	Cls
	RenderWorld
	Return ReadPixel(70, 50, BackBuffer()) And $FFFFFF
End Function

Function Scene2D()
	Cls
	DrawBlock img, 3, 4
	Return ReadPixel(3 + 2, 4 + 5, BackBuffer()) And $FFFFFF
End Function

Global hash_tex = Hash(TextureBuffer(tex))
Global hash_mipped = Hash(TextureBuffer(mipped))
Global hash_img = Hash(ImageBuffer(img))
Global hash_loaded = Hash(TextureBuffer(loaded))
Global hash_loaded_img = Hash(ImageBuffer(loaded_img))
Global shown3d = Scene3D()
Global shown2d = Scene2D()
CheckTrue "The cube shows the texture", shown3d <> 0
CheckTrue "The image shows", shown2d <> 0
Check "A loaded texture has what was saved", hash_loaded, hash_tex
Check "A loaded image has what was saved", hash_loaded_img, hash_tex

Function CheckAll(what$)
	Check what + ": texture", Hash(TextureBuffer(tex)), hash_tex
	Check what + ": texture with mip maps", Hash(TextureBuffer(mipped)), hash_mipped
	Check what + ": image", Hash(ImageBuffer(img)), hash_img
	Check what + ": loaded texture", Hash(TextureBuffer(loaded)), hash_loaded
	Check what + ": loaded image", Hash(ImageBuffer(loaded_img)), hash_loaded_img
	Check what + ": 3D", Scene3D(), shown3d
	Check what + ": 2D", Scene2D(), shown2d
End Function

; The 4th Flip loses the device.
For i = 1 To 3
	Flip
	CheckFalse "No loss before the 4th Flip", GraphicsLost()
Next
Flip
CheckTrue "GraphicsLost says that the device was lost", GraphicsLost()
CheckFalse "GraphicsLost says it once", GraphicsLost()
CheckAll "After the first loss"

; Things that are made and changed afterwards survive the next loss as well.
Fill TextureBuffer(tex), 55
hash_tex = Hash(TextureBuffer(tex))
shown3d = Scene3D()
extra = CreateTexture(SIZE, SIZE, 1)
Fill TextureBuffer(extra), 77
hash_extra = Hash(TextureBuffer(extra))
For i = 5 To 8
	Flip
	CheckFalse "No loss before the 9th Flip", GraphicsLost()
Next
Flip
CheckTrue "GraphicsLost says that the device was lost again", GraphicsLost()
CheckFalse "GraphicsLost says it once again", GraphicsLost()
CheckAll "After the second loss"
Check "A texture made after the first loss", Hash(TextureBuffer(extra)), hash_extra

; Drawing and showing go on.
For i = 1 To 5
	Cls
	Color 200, 100, 50
	Rect 10, 10, 20, 20, 1
	Flip
Next
Check "2D drawing after the losses", ReadPixel(15, 15, BackBuffer()) And $FFFFFF, $C86432
CheckFalse "Nothing was lost since", GraphicsLost()

FreeTexture extra
DeleteFile "suite_tmp_lost.bmp"
Done "graphics_device_lost_pixels"
