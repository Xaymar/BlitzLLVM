; Single, Float32, Real and Real32 are other names of Float: They work everywhere Float does, and mix with it freely.
Include "check.bb"

Global g_Single:Single = 2.25
Const c_Single:Single = 0.5
Dim a_Single:Single(2)

Function Ret_Single:Single()
	Return 2.25
End Function
Function Echo_Single:Single(p:Single = 1.5)
	Return p
End Function
Function Float_As_Single:Single(p:Float)
	Return p
End Function
Function Single_As_Float:Float(p:Single)
	Return p
End Function
Function Short_Notation#(p:Single)
	Return p
End Function

Type T_Single
	Field f:Single
End Type

Check "Single return", Ret_Single(), 2.25
Check "Single parameter", Echo_Single(3.5), 3.5
Check "Single default", Echo_Single(), 1.5
Check "Single global", g_Single, 2.25
Check "Single const", c_Single, 0.5
a_Single(1) = 7.75
Check "Single array", a_Single(1), 7.75
Local t.T_Single = New T_Single
t\f = 0.1
CheckS "Single field is a Float", Str(t\f), Str(Float(0.1))
Local l:Single = 1 / 3.0
CheckS "Single is 32 bit", Str(l), Str(Float(1 / 3.0))
CheckFalse "Single is not Double", l = Double(1) / 3
Check "Single to Float", Single_As_Float(l), l
Check "Float to Single", Float_As_Single(l), l
Check "Single to short notation", Short_Notation(l), l
Local s#
s = l
CheckTrue "Single equals Float", s = l

Local c:Single = Single("1.5") + Single(2)
Check "Single() converts", c, 3.5
CheckS "Single() is a Float", Str(Single(7) / 2), "3.5"

Local f32:Float32 = 4.5
Local r:Real = 4.5
Local r32:Real32 = 4.5
Local sg:Single = 4.5
CheckTrue "Float32 = Single", f32 = sg
CheckTrue "Real = Single", r = sg
CheckTrue "Real32 = Single", r32 = sg

Done "language_float_aliases"
