; CopyRect and GrabImage with numbers that are far outside of the buffer: the rectangle is clipped to the buffer in 64 bits, as the sum of a
; position and a size is more than 32 bits hold, and a rectangle that is not in the buffer at all is not copied.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_copyrect_limits_pixels: skipped, there is no window."
	End
EndIf

Graphics 64, 64, 32, 2
SetBuffer BackBuffer()
ClsColor 0, 0, 255
Cls
Color 255, 0, 0
Rect 0, 0, 32, 64, 1

big = 2147483647
CopyRect big, 0, 10, 10, 0, 0, BackBuffer(), BackBuffer()
CopyRect 0, big, 10, 10, 0, 0, BackBuffer(), BackBuffer()
CopyRect 0, 0, 10, 10, big, 5, BackBuffer(), BackBuffer()
CopyRect 0, 0, 10, 10, 5, big, BackBuffer(), BackBuffer()
CopyRect 5, 5, big, big, 40, 40, BackBuffer(), BackBuffer()
CopyRect -big, 0, big, 10, 0, 0, BackBuffer(), BackBuffer()
CopyRect 0, 0, big, big, big, big, BackBuffer(), BackBuffer()

image = CreateImage(16, 16)
GrabImage image, big, 0
GrabImage image, 0, big
GrabImage image, -big, -big
FreeImage image

; What was in the buffer is still there, and the part that was inside of it was copied.
LockBuffer BackBuffer()
c = ReadPixel(1, 1) And $FFFFFF
Check "Red stays", c, $FF0000
c = ReadPixel(60, 1) And $FFFFFF
Check "Blue stays", c, $0000FF
UnlockBuffer BackBuffer()

Done "graphics_copyrect_limits_pixels"
