; Picking in meshes with enough polygons for BLITZLLVM_PICK_BACKEND=jolt to take them (the same result with either backend): spheres that
; are picked, hidden, moved, scaled and left out by pick mode: CreateSphere PositionEntity ScaleEntity HideEntity ShowEntity
; EntityPickMode LinePick EntityPick EntityVisible PickedEntity PickedX PickedNX PickedTriangle PickedSurface.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; Two spheres of radius 1 on the x axis, with 32 segments each (about 2000 polygons). The lines are not on the axis, as a line through
; an edge of two polygons can be a miss to one and a hit to the other.
Local a = CreateSphere(32)
PositionEntity a, 10, 0, 0
EntityPickMode a, 2
Local b = CreateSphere(32)
PositionEntity b, 20, 0, 0
EntityPickMode b, 2

Function Along(x#)
	Return LinePick(x, 0.1, 0.07, 40, 0, 0)
End Function

Check "The first sphere", Along(0), a
Check "Its front is at x = 9", PickedX(), 9, 0.05
Check "Its normal faces the line", PickedNX(), -1, 0.05
CheckTrue "A surface was picked", PickedSurface() <> 0
CheckTrue "A triangle was picked", PickedTriangle() >= 0
Check "Starting between them", Along(15), b
Check "Starting behind them", Along(25), 0

; A line that only just passes the sphere.
Check "Passing above", LinePick(0, 1.5, 0.07, 40, 0, 0), 0
Check "Grazing in", LinePick(0, 0.5, 0.07, 40, 0, 0), a

; A radius makes the line thicker.
Check "A thick line passing above", LinePick(0, 1.5, 0.07, 40, 0, 0, 1), a

; Hidden, shown, moved, scaled.
HideEntity a
Check "A hidden sphere", Along(0), b
ShowEntity a
Check "A shown sphere", Along(0), a
PositionEntity a, 10, 5, 0
Check "A moved sphere", Along(0), b
PositionEntity a, 10, 0, 0
ScaleEntity a, 3, 3, 3
Check "A scaled sphere", Along(0), a
Check "Its front is at x = 7", PickedX(), 7, 0.05
ScaleEntity a, 1, 1, 1
Check "A sphere scaled back", Along(0), a
Check "The front after scaling back", PickedX(), 9, 0.05

; Pick modes: 0 is not picked.
EntityPickMode a, 0
Check "Not pickable", Along(0), b
EntityPickMode a, 2
Check "Pickable again", Along(0), a

; EntityPick and EntityVisible.
Check "Nothing between them", EntityVisible(a, b), 1
Local c = CreateSphere(32)
PositionEntity c, 15, 0.1, 0.07
EntityPickMode c, 2, True
CheckFalse "A sphere between them", EntityVisible(a, b)
FreeEntity c
FreeEntity a
Check "The one left", Along(0), b

Done "pick large meshes"
