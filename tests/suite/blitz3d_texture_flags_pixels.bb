; this is skipped without one: LoadTexture flag 2048 (sRGB) and CreateTexture/LoadTexture flag 4096 (render target).
; A file with a grey of 128 is shown fullbright on a cube: the bytes of the file are sRGB, so with flag 2048 the texture
; holds linear values, 55 for this grey, while ReadPixel on the texture still returns the bytes of the file.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_texture_flags_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
Global cube = CreateCube()
EntityFX cube, 1
PositionEntity cube, 0, 0, 3

ClearTextureFilters

Function Show(texture)
	EntityTexture cube, texture
	RenderWorld
End Function

; Render target: drawing to a texture needs flag 4096, reading and writing its pixels does not.
plain = CreateTexture(4, 4, 1)
Global plain_buffer = TextureBuffer(plain)
CheckTrue "A texture without flag 4096 has a buffer", plain_buffer <> 0
LockBuffer plain_buffer
WritePixelFast 1, 1, $FF336699, plain_buffer
Check "WritePixelFast and ReadPixelFast without flag 4096", ReadPixelFast(1, 1, plain_buffer) And $FFFFFF, $336699
UnlockBuffer plain_buffer
Check "ReadPixel without flag 4096", ReadPixel(1, 1, plain_buffer) And $FFFFFF, $336699
WritePixel 2, 2, $FF112233, plain_buffer
Check "WritePixel without flag 4096", ReadPixel(2, 2, plain_buffer) And $FFFFFF, $112233

target = CreateTexture(4, 4, 1 + 4096)
SetBuffer TextureBuffer(target)
ClsColor 200, 100, 50
Cls
SetBuffer BackBuffer()
Check "Drawing to a render target", ReadPixel(1, 1, TextureBuffer(target)) And $FFFFFF, $C86432
Show target
Check "A render target is shown", R(80, 60), 200, 3

; sRGB: the file is made with a grey of 128.
grey = CreateTexture(4, 4, 1 + 4096)
SetBuffer TextureBuffer(grey)
ClsColor 128, 128, 128
Cls
SaveBuffer TextureBuffer(grey), "suite_srgb.bmp"
SetBuffer BackBuffer()

plain = LoadTexture("suite_srgb.bmp", 1)
Show plain
Check "Without flag 2048 the grey is shown as it is", R(80, 60), 128, 3

srgb = LoadTexture("suite_srgb.bmp", 1 + 2048)
CheckTrue "LoadTexture with flag 2048", srgb <> 0
Show srgb
Check "With flag 2048 the grey is linear", R(80, 60), 55, 3
Check "ReadPixel on an sRGB texture returns the bytes of the file", ReadPixel(1, 1, TextureBuffer(srgb)) And $FF, 128

; An sRGB texture that can be drawn to keeps the bytes that are written, which are converted when it is sampled.
both = LoadTexture("suite_srgb.bmp", 1 + 2048 + 4096)
SetBuffer TextureBuffer(both)
ClsColor 255, 255, 255
Cls
Color 188, 188, 188
Rect 0, 0, 4, 4, 1
SetBuffer BackBuffer()
Check "An sRGB render target keeps the bytes", ReadPixel(1, 1, TextureBuffer(both)) And $FF, 188
Show both
Check "An sRGB render target is converted when it is sampled", R(80, 60), 128, 3

; 255 and 0 do not change.
white = CreateTexture(4, 4, 1 + 4096)
SetBuffer TextureBuffer(white)
ClsColor 255, 255, 255
Cls
SaveBuffer TextureBuffer(white), "suite_srgb_white.bmp"
SetBuffer BackBuffer()
whites = LoadTexture("suite_srgb_white.bmp", 1 + 2048)
Show whites
Check "White stays white", R(80, 60), 255, 1

DeleteFile "suite_srgb.bmp"
DeleteFile "suite_srgb_white.bmp"
Done "blitz3d_texture_flags_pixels"
