; What the depth of Graphics3D does, which needs a window and a GPU, so this is skipped without one: 24 (R8G8B8X8), 30
; (R10G10B10A2), 32 (R8G8B8A8) and 64 (R16G16B16A16) all have to draw, read, write and copy the way 32 does, and the
; deeper ones keep what many see-through layers add up to, where 8 bits per channel lose it to rounding.
; GraphicsDepth GraphicsWidth Graphics3D ReadPixel WritePixel Plot Rect CopyRect GrabImage DrawImage TextureBuffer.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_depth_pixels: skipped, there is no window."
	End
EndIf

; The 8 bits of each channel that a pixel has, from ReadPixel64, which is the same for every depth.
Function R(x, y)
	Return Int((ReadPixel64(x, y, BackBuffer()) Shr 40) And 255)
End Function
Function G(x, y)
	Return Int((ReadPixel64(x, y, BackBuffer()) Shr 24) And 255)
End Function
Function B(x, y)
	Return Int((ReadPixel64(x, y, BackBuffer()) Shr 8) And 255)
End Function

; The Int that WritePixel takes for a color with 8 bits for each channel: A2R10G10B10 for 30 bits, ARGB otherwise.
Function Native(depth, r, g, b)
	If depth = 30 Then Return (3 Shl 30) Or ((r * 1023 / 255) Shl 20) Or ((g * 1023 / 255) Shl 10) Or (b * 1023 / 255)
	Return $FF000000 Or (r Shl 16) Or (g Shl 8) Or b
End Function

; Draws one depth through everything that touches the buffer.
Function TryDepth(depth, deep)
	Local name$ = "Depth " + depth + ": "
	Graphics3D 64, 64, depth, 2
	SetBuffer BackBuffer()
	Check name + "GraphicsDepth", GraphicsDepth(), depth

	; 2D drawing and reading it back, which has to give what was drawn.
	ClsColor 12, 200, 99
	Cls
	Check name + "Cls red", R(5, 5), 12, 1
	Check name + "Cls green", G(5, 5), 200, 1
	Check name + "Cls blue", B(5, 5), 99, 1
	Color 255, 128, 0
	Rect 10, 10, 20, 20, True
	Check name + "Rect red", R(15, 15), 255, 1
	Check name + "Rect green", G(15, 15), 128, 1
	Check name + "Rect blue", B(15, 15), 0, 1
	WritePixel 40, 40, Native(depth, $40, $80, $C0)
	Check name + "WritePixel red", R(40, 40), $40, 1
	Check name + "WritePixel green", G(40, 40), $80, 1
	Check name + "WritePixel blue", B(40, 40), $C0, 1

	; Copies to an image and back, and to the buffer of a texture and back, which are RGBA8 whatever the depth is.
	img = CreateImage(20, 20)
	GrabImage img, 10, 10
	Cls
	DrawBlock img, 30, 30
	Check name + "GrabImage red", R(35, 35), 255, 1
	Check name + "GrabImage green", G(35, 35), 128, 1
	tex = CreateTexture(32, 32, 4096)
	SetBuffer TextureBuffer(tex)
	ClsColor 10, 20, 30
	Cls
	Color 200, 100, 50
	Rect 0, 0, 16, 16, True
	SetBuffer BackBuffer()
	CopyRect 0, 0, 16, 16, 0, 0, TextureBuffer(tex), BackBuffer()
	Check name + "Texture to buffer red", R(8, 8), 200, 1
	Check name + "Texture to buffer green", G(8, 8), 100, 1
	Check name + "Texture to buffer blue", B(8, 8), 50, 1
	CopyRect 0, 0, 16, 16, 0, 0, BackBuffer(), TextureBuffer(tex)
	FreeImage img
	FreeTexture tex

	; What ReadPixel and WritePixel have is what the buffer stores: A2R10G10B10 for 30 bits, and ARGB with 8 bits each otherwise.
	; ReadPixel64 and WritePixel64 have 16 bits for each of A, R, G and B from the top, whatever the buffer is.
	Local word = (3 Shl 30) Or (1000 Shl 20) Or (500 Shl 10) Or 123 ; red 1000, green 500, blue 123
	Local wide:Long = (Long($FFFF) Shl 48) Or (Long($9ABC) Shl 32) Or (Long($5678) Shl 16) Or Long($1234)
	Local narrow:Long = (Long($FFFF) Shl 48) Or (Long($8080) Shl 32) Or (Long($4040) Shl 16) Or Long($2020)
	Local none:Long = 0
	If depth = 30
		WritePixel 50, 50, word
		CheckTrue name + "30 bits keep the word", ReadPixel(50, 50) = word
		Check name + "30 bits in 64, red", Int((ReadPixel64(50, 50) Shr 32) And $FFFF), 64062
		LockBuffer BackBuffer()
		CheckTrue name + "Locked word", ReadPixelFast(50, 50) = word
		Check name + "LockedFormat", LockedFormat(), 5
		Check name + "LockedPitch", LockedPitch(), 64 * 4
		WritePixelFast 51, 50, word
		CopyPixelFast 51, 50, BackBuffer(), 52, 50, BackBuffer()
		CheckTrue name + "CopyPixelFast", ReadPixelFast(52, 50) = word
		UnlockBuffer BackBuffer()
		CheckTrue name + "Unlocked word", ReadPixel(52, 50) = word
	ElseIf depth = 64
		WritePixel64 50, 50, wide
		CheckTrue name + "64 bits keep all of it", ReadPixel64(50, 50) = wide
		CheckTrue name + "ReadPixel has the top 8 bits", (ReadPixel(50, 50) And $FFFFFF) = $9A5612 Or (ReadPixel(50, 50) And $FFFFFF) = $9B5712
		LockBuffer BackBuffer()
		CheckTrue name + "Locked 64 bits", ReadPixelFast64(50, 50) = wide
		Check name + "LockedFormat", LockedFormat(), 6
		Check name + "LockedPitch", LockedPitch(), 64 * 8
		WritePixelFast64 51, 50, wide
		CopyPixelFast 51, 50, BackBuffer(), 52, 50, BackBuffer()
		CheckTrue name + "CopyPixelFast keeps all of it", ReadPixelFast64(52, 50) = wide
		UnlockBuffer BackBuffer()
		CheckTrue name + "Unlocked 64 bits", ReadPixel64(52, 50) = wide
	Else
		WritePixel64 50, 50, narrow
		CheckTrue name + "8 bits in 64", (ReadPixel64(50, 50) And $FFFFFFFFFFFF) = (narrow And $FFFFFFFFFFFF)
		CheckTrue name + "8 bits ReadPixel", (ReadPixel(50, 50) And $FFFFFF) = $804020
		LockBuffer BackBuffer()
		Check name + "LockedFormat", LockedFormat(), 4
		UnlockBuffer BackBuffer()
	EndIf
	; What is shown on the screen is RGBA8 whatever the depth is, with or without Dither.
	Dither True
	Flip
	Dither False
	Flip

	; 3D: a cube in the middle with its own color.
	camera = CreateCamera()
	PositionEntity camera, 0, 0, -5
	CameraClsColor camera, 10, 20, 30
	cube = CreateCube()
	EntityFX cube, 1
	EntityColor cube, 255, 0, 0
	RenderWorld
	Check name + "Cube red", R(32, 32), 255, 1
	Check name + "Clear color blue", B(2, 2), 30, 1
	FreeEntity cube

	; 100 layers that add 0.5 of one step of 8 bits each: 8 bits lose them or double them, deeper ones keep them.
	For i = 1 To 100
		layer = CreateCube()
		EntityFX layer, 1
		EntityColor layer, 255, 255, 255
		EntityBlend layer, 3
		EntityAlpha layer, 0.002
	Next
	CameraClsColor camera, 0, 0, 0
	RenderWorld
	got = R(32, 32)
	DebugLog name + "100 layers of half a step give " + got
	If deep Then Check name + "Layers", got, 51, 3 Else CheckTrue name + "Layers are lost or doubled", (got < 3) Or (got > 97)
	FreeEntity camera
	ClearWorld
End Function

; With 8 bits per channel a layer that adds half a step rounds to a whole one or to none; 100 of them end at 0 or 100.
; Deeper ones end at 51.
TryDepth 32, False
TryDepth 24, False
TryDepth 30, True
TryDepth 64, True

; Not a depth that exists: the program goes on with 32, and the closest the device has is used.
Graphics3D 64, 64, 17, 2
Check "Depth 17 is 32", GraphicsDepth(), 32
Graphics3D 64, 64, 0, 2
Check "Depth 0 is 32", GraphicsDepth(), 32
Graphics3D 64, 64, 16, 2
Check "Depth 16 is 32", GraphicsDepth(), 32
Done "graphics_depth_pixels"
