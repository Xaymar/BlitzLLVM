; Small textures that are loaded from files are merged into shared images by the runtime (TextureAtlas), which needs a
; window and a GPU, so this is skipped without one. The same scene is drawn with the merge off and on: it has to look exactly the
; same, while the draws that textures break shrink to one call. What needs a picture of its own gets it back.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_texture_atlas_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
ClearTextureFilters

Const COUNT = 8

; Eight pictures of 24 pixels with something different in every corner, so that a wrong rectangle or a leak shows.
Local i, tex, y
For i = 0 To COUNT - 1
	tex = CreateTexture(24, 24, 1 + 4096)
	SetBuffer TextureBuffer(tex)
	For y = 0 To 23
		Color i * 30 + 10, y * 10, 255 - y * 10
		Rect 0, y, 24, 1, 1
	Next
	Color 255, 255, 255 : Plot 0, 0
	Color 0, 0, 0 : Plot 23, 0
	Color 255, 0, 255 : Plot 0, 23
	Color 0, 255, 0 : Plot 23, 23
	Color 255, 255, 0 : Line 4, 4, 19, 19
	SaveBuffer TextureBuffer(tex), "suite_texture_atlas" + i + ".bmp"
	SetBuffer BackBuffer()
	FreeTexture tex
Next

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, -9
Global original = CreateCube()
HideEntity original
Dim cubes(COUNT - 1)
Dim textures(COUNT - 1)
Global flags = 1 + 16 + 32

Function Build()
	For i = 0 To COUNT - 1
		textures(i) = LoadTexture("suite_texture_atlas" + i + ".bmp", flags)
		cubes(i) = CopyEntity(original)
		EntityFX cubes(i), 1
		ScaleEntity cubes(i), 0.9, 0.9, 0.9
		PositionEntity cubes(i), (i Mod 4) * 2.2 - 3.3, (i / 4) * 2.2 - 1.1, 0
		EntityTexture cubes(i), textures(i)
	Next
End Function

Function Clean()
	For i = 0 To COUNT - 1
		FreeEntity cubes(i)
		FreeTexture textures(i)
	Next
End Function


Dim plain(160 * 120 - 1)
Function Store()
	For y = 0 To 119
		For x = 0 To 159
			plain(y * 160 + x) = ReadPixel(x, y, BackBuffer()) And $FFFFFF
		Next
	Next
End Function

; Pixels that differ by more than a few steps in a channel: the shader mixes texels itself, the sampler of a GPU rounds its
; weights, so a merged texture is exact only up to that.
Function Differences()
	Local n = 0, a, b, d
	For y = 0 To 119
		For x = 0 To 159
			a = ReadPixel(x, y, BackBuffer()) And $FFFFFF
			b = plain(y * 160 + x)
			d = Abs((a And 255) - (b And 255))
			d = Max(d, Abs(((a Shr 8) And 255) - ((b Shr 8) And 255)))
			d = Max(d, Abs(((a Shr 16) And 255) - ((b Shr 16) And 255)))
			If d > 3 Then n = n + 1
		Next
	Next
	Return n
End Function

; Without the merge: one call for each texture.
TextureAtlas False
Build()
RenderWorld
plain_calls = Stats3D(1000)
Store()
Check "Without the merge every texture is a call", plain_calls, COUNT, 0
Clean()

; With it: the same picture in one call.
TextureAtlas True
Build()
RenderWorld
Check "Merged textures are one call", Stats3D(1000), 1, 0
Check "Merged textures are one texture", Stats3D(1002), 1, 0
Check "Nothing looks different", Differences(), 0, 0
CheckTrue "TextureWidth is the size of the picture", TextureWidth(textures(3)) = 24 And TextureHeight(textures(3)) = 24

; Pixels of a merged texture are its own again.
pixel = ReadPixel(0, 0, TextureBuffer(textures(2))) And $FFFFFF
Check "The corner of the picture", pixel, $FFFFFF, 0
RenderWorld
Check "A texture with its own picture is another call", Stats3D(1000), 2, 0
Check "And it looks the same", Differences(), 0, 0

; Scaled and rotated textures stay merged: the coordinates are changed before the view is read.
ScaleTexture textures(5), 1, 1
RotateTexture textures(6), 0
RenderWorld
Check "Scaled and rotated textures are still one call", Stats3D(1000), 2, 0
Check "Still the same picture", Differences(), 0, 0
Clean()

; Repeating and mip mapped textures are merged as well (blitz3d_texture_view_pixels.bb has how they look).
flags = 1
Build()
RenderWorld
Check "Repeating textures are merged", Stats3D(1000), 1, 0
Clean()
flags = 1 + 8
Build()
RenderWorld
Check "Mip mapped textures are merged", Stats3D(1000), 1, 0
Clean()

For i = 0 To COUNT - 1
	DeleteFile "suite_texture_atlas" + i + ".bmp"
Next

Done "blitz3d_texture_atlas_pixels"
