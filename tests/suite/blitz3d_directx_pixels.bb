; How a model from a .x file looks, which needs a window and a GPU, so this is skipped without one: the color of the material,
; which side of a triangle is its front, and that the frame of the model puts it where it is.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_directx_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

camera = CreateCamera()
CameraClsColor camera, 10, 20, 30
AmbientLight 255, 255, 255

; The square is at x 0 to 2, y 1 to 3 and z 3. Its triangles are clockwise when seen from the other side of z, where the
; camera is, which is why it is turned around. The red triangle has the corners (0, 1), (2, 1) and (2, 3).
mesh = LoadMesh("models/x_text.x")
CheckTrue "LoadMesh of the square", mesh <> 0
PositionEntity camera, 1, 2, 10
RotateEntity camera, 0, 180, 0
RenderWorld
CameraProject camera, 1.5, 1.5, 3
Check "Red triangle red", R(ProjectedX(), ProjectedY()), 255, 8
Check "Red triangle is only red", G(ProjectedX(), ProjectedY()) + B(ProjectedX(), ProjectedY()), 0, 8
CameraProject camera, 5, 5, 3
Check "Background", R(ProjectedX(), ProjectedY()), 10, 4

; The other side of the triangle is not drawn.
PositionEntity camera, 1, 2, -4
RotateEntity camera, 0, 0, 0
RenderWorld
CameraProject camera, 1.5, 1.5, 3
Check "Not from behind", R(ProjectedX(), ProjectedY()), 10, 4
EndGraphics
Done "blitz3d_directx_pixels"
