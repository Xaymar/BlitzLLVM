; Files and folders: FileType FileSize CreateDir CurrentDir$ ChangeDir ReadDir NextFile$ CloseDir CopyFile DeleteFile
; OpenFile ReadFile WriteFile CloseFile FilePos SeekFile DeleteDir MoreFiles.
Include "check.bb"

folder$ = "suite_tmp_files"
CreateDir folder
Check "CreateDir", FileType(folder), 2
CreateDir folder
Check "CreateDir twice", FileType(folder), 2
Check "FileType missing", FileType("suite_does_not_exist"), 0

; WriteFile makes a new file, or empties an old one.
name$ = folder + "/one.txt"
file = WriteFile(name)
CheckTrue "WriteFile", file <> 0
WriteString file, "hello"
CloseFile file
Check "FileType file", FileType(name), 1
Check "FileSize", FileSize(name), 9
file = WriteFile(name)
CloseFile file
Check "WriteFile empties", FileSize(name), 0

; ReadFile only opens what exists.
Check "ReadFile missing", ReadFile(folder + "/missing.txt"), 0
file = WriteFile(name)
For i = 1 To 10
	WriteByte file, i
Next
CloseFile file
file = ReadFile(name)
CheckTrue "ReadFile", file <> 0
Check "FilePos at the start", FilePos(file), 0
Check "ReadByte", ReadByte(file), 1
Check "FilePos moves", FilePos(file), 1
CheckFalse "Eof before the end", Eof(file)

; SeekFile moves around.
SeekFile file, 5
Check "SeekFile", FilePos(file), 5
Check "ReadByte after seek", ReadByte(file), 6
SeekFile file, 9
Check "ReadByte last", ReadByte(file), 10
CheckTrue "Eof at the end", Eof(file)
SeekFile file, 0
CheckFalse "Eof after going back", Eof(file)
CloseFile file

; OpenFile reads and writes the same file without emptying it.
file = OpenFile(name)
CheckTrue "OpenFile", file <> 0
Check "OpenFile keeps the content", ReadByte(file), 1
SeekFile file, 2
WriteByte file, 99
SeekFile file, 0
Check "OpenFile first", ReadByte(file), 1
Check "OpenFile second", ReadByte(file), 2
Check "OpenFile changed", ReadByte(file), 99
Check "OpenFile after", ReadByte(file), 4
CloseFile file
Check "OpenFile keeps the size", FileSize(name), 10
Check "OpenFile missing", OpenFile(folder + "/missing.txt"), 0

; CopyFile and DeleteFile
copy$ = folder + "/two.txt"
CopyFile name, copy
Check "CopyFile type", FileType(copy), 1
Check "CopyFile size", FileSize(copy), 10
file = ReadFile(copy)
SeekFile file, 2
Check "CopyFile content", ReadByte(file), 99
CloseFile file
DeleteFile copy
Check "DeleteFile", FileType(copy), 0
Check "DeleteFile keeps the other", FileType(name), 1

; Folders can be listed. "." and ".." are part of that.
file = WriteFile(folder + "/a.txt")
CloseFile file
file = WriteFile(folder + "/b.txt")
CloseFile file
CreateDir folder + "/inner"
directory = ReadDir(folder)
CheckTrue "ReadDir", directory <> 0
foundA = 0
foundB = 0
foundInner = 0
count = 0
Repeat
	entry$ = NextFile$(directory)
	If entry = "" Then Exit
	count = count + 1
	If entry = "a.txt" Then foundA = 1
	If entry = "b.txt" Then foundB = 1
	If entry = "inner" Then foundInner = 1
Forever
CloseDir directory
CheckTrue "NextFile$ finds a.txt", foundA
CheckTrue "NextFile$ finds b.txt", foundB
CheckTrue "NextFile$ finds inner", foundInner
CheckTrue "NextFile$ finds one.txt and the others", count >= 4
Check "ReadDir missing", ReadDir("suite_does_not_exist"), 0

; MoreFiles says whether NextFile$ has another name, without taking it.
directory = ReadDir(folder)
total = 0
Repeat
	total = total + 1
	If MoreFiles(directory) = 0 Then Exit
	CheckTrue "MoreFiles again does not take the name", MoreFiles(directory)
	entry$ = NextFile$(directory)
	CheckTrue "NextFile$ gives the name that MoreFiles saw", entry <> ""
Forever
Check "MoreFiles at the end", MoreFiles(directory), 0
CheckS "NextFile$ at the end", NextFile$(directory), ""
CloseDir directory
Check "MoreFiles and NextFile$ see the same names", total - 1, count
directory = ReadDir(folder)
Check "MoreFiles does not change the first name", MoreFiles(directory), 1
names = 0
While MoreFiles(directory)
	entry$ = NextFile$(directory)
	names = names + 1
Wend
Check "MoreFiles with While", names, count
CloseDir directory

; ChangeDir goes into a folder and CurrentDir$ says where that is.
start$ = CurrentDir$()
CheckTrue "CurrentDir$", Len(start) > 0
ChangeDir folder
Check "ChangeDir", FileType("one.txt"), 1
CheckTrue "CurrentDir$ changed", CurrentDir$() <> start
ChangeDir start
Check "ChangeDir back", FileType(folder), 2
CheckS "CurrentDir$ restored", CurrentDir$(), start

; Clean up what can be cleaned.
DeleteFile folder + "/one.txt"
DeleteFile folder + "/a.txt"
DeleteFile folder + "/b.txt"
Check "Cleaned up", FileType(folder + "/one.txt"), 0

; DeleteDir removes an empty folder, and leaves one that has files in it.
inner$ = folder + "/inner"
CreateDir inner
Check "inner exists", FileType(inner), 2
DeleteDir inner
Check "DeleteDir", FileType(inner), 0
DeleteDir "suite_does_not_exist"
Check "DeleteDir missing", FileType("suite_does_not_exist"), 0

Done "files"
