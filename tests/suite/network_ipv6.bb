; Network over IPv6 and IPv4 on this computer: GetTCPStreamAddress$ CountHostAddresses GetHostAddress$ GetUDPStreamAddress$
; GetUDPMsgAddress$ SendUDPMsgTo. The parts that need IPv6 are skipped if this computer has none (the loopback address ::1 can not be used).
Include "check.bb"

TCPTimeouts 1000, 1000
UDPTimeouts 1000

; IPv4 keeps working through the same commands, and the text address matches the number.
port = 40741
server = CreateTCPServer(port)
CheckTrue "CreateTCPServer", server <> 0
client = OpenTCPStream("127.0.0.1", port)
CheckTrue "OpenTCPStream over IPv4", client <> 0
CheckS "GetTCPStreamAddress$ of an IPv4 client", GetTCPStreamAddress$(client), "127.0.0.1"
accepted = 0
For i = 1 To 50
	accepted = AcceptTCPStream(server)
	If accepted <> 0 Then Exit
	Delay 20
Next
CheckTrue "AcceptTCPStream over IPv4", accepted <> 0
CheckS "GetTCPStreamAddress$ of an accepted IPv4 stream", GetTCPStreamAddress$(accepted), "127.0.0.1"
CheckS "TCPStreamIP of an accepted IPv4 stream", DottedIP$(TCPStreamIP(accepted)), "127.0.0.1"
CloseTCPStream client
CloseTCPStream accepted

; IPv6, if there is any.
client = OpenTCPStream("::1", port)
If client = 0 Then
	Print "network_ipv6: no IPv6 here, TCP over ::1 skipped."
Else
	CheckS "GetTCPStreamAddress$ of an IPv6 client", GetTCPStreamAddress$(client), "::1"
	accepted = 0
	For i = 1 To 50
		accepted = AcceptTCPStream(server)
		If accepted <> 0 Then Exit
		Delay 20
	Next
	CheckTrue "AcceptTCPStream over IPv6", accepted <> 0
	CheckS "GetTCPStreamAddress$ of an accepted IPv6 stream", GetTCPStreamAddress$(accepted), "::1"
	Check "TCPStreamIP of an IPv6 peer has no number", TCPStreamIP(accepted), 0
	WriteInt client, 4711
	waited = 0
	While ReadAvail(accepted) < 4 And waited < 100
		Delay 10
		waited = waited + 1
	Wend
	Check "ReadInt over IPv6", ReadInt(accepted), 4711
	CloseTCPStream accepted
	CloseTCPStream client

	; Brackets around the address are allowed.
	client = OpenTCPStream("[::1]", port)
	CheckTrue "OpenTCPStream with brackets", client <> 0
	If client <> 0 Then CloseTCPStream client
EndIf
CloseTCPServer server

; UDP.
a = CreateUDPStream(40742)
b = CreateUDPStream(40743)
CheckTrue "CreateUDPStream", a <> 0 And b <> 0
WriteInt b, 1234
SendUDPMsgTo b, "127.0.0.1", 40742
CheckTrue "RecvUDPMsg over IPv4 with SendUDPMsgTo", RecvUDPMsg(a) <> 0
Check "ReadInt", ReadInt(a), 1234
CheckS "GetUDPMsgAddress$ of an IPv4 sender", GetUDPMsgAddress$(a), "127.0.0.1"
Check "UDPMsgIP of an IPv4 sender", UDPMsgIP(a), $7F000001
Check "UDPMsgPort", UDPMsgPort(a), 40743

WriteInt b, 5678
SendUDPMsgTo b, "::1", 40742
If RecvUDPMsg(a) = 0 Then
	Print "network_ipv6: no IPv6 here, UDP over ::1 skipped."
Else
	Check "ReadInt over IPv6", ReadInt(a), 5678
	CheckS "GetUDPMsgAddress$ of an IPv6 sender", GetUDPMsgAddress$(a), "::1"
	Check "UDPMsgIP of an IPv6 sender has no number", UDPMsgIP(a), 0
	Check "UDPMsgPort over IPv6", UDPMsgPort(a), 40743
EndIf
CheckTrue "GetUDPStreamAddress$", Len(GetUDPStreamAddress$(a)) > 0
CloseUDPStream a
CloseUDPStream b

; The addresses of a host.
CheckTrue "CountHostAddresses of this computer", CountHostAddresses("") >= 1
CheckTrue "GetHostAddress$ 1", Len(GetHostAddress$(1)) > 0
CheckS "GetHostAddress$ past the last one", GetHostAddress$(CountHostAddresses("") + 1), ""
CheckS "GetHostAddress$ 0", GetHostAddress$(0), ""
Check "CountHostAddresses of an IPv4 address", CountHostAddresses("127.0.0.1"), 1
CheckS "GetHostAddress$ of an IPv4 address", GetHostAddress$(1), "127.0.0.1"
Check "CountHostAddresses of a host that is not there", CountHostAddresses("host.invalid"), 0
If CountHostAddresses("::1") = 1 Then CheckS "GetHostAddress$ of ::1", GetHostAddress$(1), "::1"
; CountHostIPs and HostIP are not changed by it.
Check "CountHostIPs of an IPv4 address", CountHostIPs("127.0.0.1"), 1
Check "HostIP of an IPv4 address", HostIP(1), $7F000001
Check "CountHostIPs of ::1 has no IPv4 address", CountHostIPs("::1"), 0

Done "network_ipv6"
