;==================================================================================================================================
; J: 50 calls in one frame, many frames: each call draws one quad of a grid of 10 x 5, nothing is cleared after the first.
;==================================================================================================================================
Dim cell(50)
For i = 0 To 49
	cell(i) = Quad(10 + (i Mod 3), 0.3, 0, 0, 0)
	PositionEntity cell(i), -9.0 + (i Mod 10) * 2.0, -4.0 + (i / 10) * 2.0, 10 + (i Mod 3)
	HideEntity cell(i)
Next
Global stress_tris = 0
Const FRAMES = 20
For frame = 0 To FRAMES - 1
	CameraClsMode cam, 1, 1
	CameraClsColor cam, 0, 0, 0
	For i = 0 To 49
		; Alternating the shown cell makes every call draw something different, and the color of the frame makes the ones of
		; the frame before obvious if they are drawn again.
		EntityColor cell(i), (i * 5 + frame * 37) Mod 256, 255 - ((i * 5 + frame * 11) Mod 256), (i * 3 + frame * 23) Mod 256
		ShowEntity cell(i)
		RenderWorld
		HideEntity cell(i)
		CameraClsMode cam, 0, 0
		stress_tris = stress_tris + TrisRendered()
		If TrisRendered() <> 2 Then RuntimeError "TrisRendered of a call with one quad is " + TrisRendered()
	Next
	; The cells are 2 units apart, 10 + (i Mod 3) away, so 80 / z pixels per unit.
	If frame = 0 Or frame = FRAMES - 1 Then
		Shot "j" + frame
		For i = 0 To 49
			z# = 10 + (i Mod 3)
			x = 80 + Int((-9.0 + (i Mod 10) * 2.0) * 80.0 / z)
			y = 60 - Int((-4.0 + (i / 10) * 2.0) * 80.0 / z)
			Px "J_frame" + frame + "_cell" + i, x, y, (i * 5 + frame * 37) Mod 256, 255 - ((i * 5 + frame * 11) Mod 256), (i * 3 + frame * 23) Mod 256
		Next
	EndIf
	Flip False
Next
For i = 0 To 49
	FreeEntity cell(i)
Next

;==================================================================================================================================
; K: 150 calls in one frame, more than the scenes that the renderer holds before it has to draw some (64): the picture and the
; depth go on over that, and the cells are drawn in the order of the calls, so a later one lies over an earlier one where
; they overlap.
;==================================================================================================================================
Dim wide(150)
For i = 0 To 149
	wide(i) = Quad(10, 0.5, 0, 0, 0)
	PositionEntity wide(i), -8.4 + (i Mod 15) * 1.2, -6.3 + (i / 15) * 1.4, 10
	HideEntity wide(i)
Next
For frame = 0 To 4
	CameraClsMode cam, 1, 1
	CameraClsColor cam, 0, 0, 0
	For i = 0 To 149
		EntityColor wide(i), (i * 7 + frame * 41) Mod 256, 255 - ((i * 3 + frame * 17) Mod 256), (i * 11 + frame * 29) Mod 256
		ShowEntity wide(i)
		RenderWorld
		HideEntity wide(i)
		CameraClsMode cam, 0, 0
	Next
	If frame = 4 Then
		Shot "k"
		For i = 0 To 149
			x = 80 + Int((-8.4 + (i Mod 15) * 1.2) * 8.0)
			y = 60 - Int((-6.3 + (i / 15) * 1.4) * 8.0)
			Px "K_cell" + i, x, y, (i * 7 + frame * 41) Mod 256, 255 - ((i * 3 + frame * 17) Mod 256), (i * 11 + frame * 29) Mod 256
		Next
	EndIf
	Flip False
Next
For i = 0 To 149
	FreeEntity wide(i)
Next

;==================================================================================================================================
; L: everything of a call is made new and freed again right after it, 30 times in a frame and for 20 frames: a mesh, a surface and a
; texture that only lived for one call are not to be read by the frame that is still being drawn.
;==================================================================================================================================
Dim texel(30)
For frame = 0 To 19
	CameraClsMode cam, 1, 1
	CameraClsColor cam, 0, 0, 0
	For i = 0 To 29
		tex = CreateTexture(8, 8, 1 + 4096)
		SetBuffer TextureBuffer(tex)
		Color (i * 8 + frame * 13) Mod 256, 255 - ((i * 5 + frame * 7) Mod 256), (i * 3 + frame * 19) Mod 256
		Rect 0, 0, 8, 8
		SetBuffer BackBuffer()
		q = Quad(10, 0.5, 255, 255, 255)
		s = GetSurface(q, 1)
		VertexTexCoords s, 0, 0, 1
		VertexTexCoords s, 1, 0, 0
		VertexTexCoords s, 2, 1, 0
		VertexTexCoords s, 3, 1, 1
		EntityTexture q, tex
		PositionEntity q, -8.4 + (i Mod 10) * 1.8, -4.0 + (i / 10) * 3.0, 10
		RenderWorld
		FreeEntity q
		FreeTexture tex
		CameraClsMode cam, 0, 0
	Next
	If frame = 0 Or frame = 19 Then
		Shot "l" + frame
		For i = 0 To 29
			x = 80 + Int((-8.4 + (i Mod 10) * 1.8) * 8.0)
			y = 60 - Int((-4.0 + (i / 10) * 3.0) * 8.0)
			Px "L_frame" + frame + "_cell" + i, x, y, (i * 8 + frame * 13) Mod 256, 255 - ((i * 5 + frame * 7) Mod 256), (i * 3 + frame * 19) Mod 256
		Next
	EndIf
	Flip False
Next
CameraClsMode cam, 1, 1
Note "J_triangles_over_all_calls", stress_tris, 2000

If record Then
	CloseFile out
	Print "blitz3d_multi_render_original_pixels: recorded."
Else
	Done "blitz3d_multi_render_original_pixels"
EndIf

