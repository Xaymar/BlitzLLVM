;==================================================================================================================================
; H: the parts of a particle buffer.
;==================================================================================================================================
Const PARTICLES = 1500
Dim part_x#(PARTICLES), part_y#(PARTICLES), part_z#(PARTICLES), order(PARTICLES)
Dim part_r(PARTICLES), part_g(PARTICLES), part_b(PARTICLES)
Global seed = 12345

; A generator that is the same everywhere. The original does not call the arguments left to right, so each call is alone.
Function Rand#()
	seed = (seed * 1103515245 + 12345) And $7FFFFFFF
	Return ((seed Shr 8) And $FFFF) / 65536.0
End Function

For i = 0 To PARTICLES - 1
	x# = Rand()
	part_x(i) = (x - 0.5) * 24
	y# = Rand()
	part_y(i) = (y - 0.5) * 16
	z# = Rand()
	part_z(i) = 8 + z * 12
	r# = Rand()
	part_r(i) = 60 + Int(r * 195)
	g# = Rand()
	part_g(i) = 60 + Int(g * 195)
	b# = Rand()
	part_b(i) = 60 + Int(b * 195)
	order(i) = i
Next

; Sorted from far to near, a gap sort.
gap = PARTICLES
swapped = True
While gap > 1 Or swapped
	gap = (gap * 10) / 13
	If gap < 1 Then gap = 1
	swapped = False
	For i = 0 To PARTICLES - 1 - gap
		If part_z(order(i)) < part_z(order(i + gap)) Then
			t = order(i)
			order(i) = order(i + gap)
			order(i + gap) = t
			swapped = True
		EndIf
	Next
Wend

; The particles first to last of the range as quads of one surface, which is how the original had to keep them.
Function BuildParticles(from, upto, shift#)
	m = CreateMesh()
	s = CreateSurface(m)
	For n = from To upto
		i = order(n)
		h# = 0.9
		x# = part_x(i) + shift
		y# = part_y(i)
		z# = part_z(i)
		v = AddVertex(s, x - h, y - h, z)
		AddVertex s, x - h, y + h, z
		AddVertex s, x + h, y + h, z
		AddVertex s, x + h, y - h, z
		VertexColor s, v, part_r(i), part_g(i), part_b(i)
		VertexColor s, v + 1, part_r(i), part_g(i), part_b(i)
		VertexColor s, v + 2, part_r(i), part_g(i), part_b(i)
		VertexColor s, v + 3, part_r(i), part_g(i), part_b(i)
		AddTriangle s, v, v + 1, v + 2
		AddTriangle s, v, v + 2, v + 3
	Next
	EntityFX m, 3
	EntityAlpha m, 0.5
	Return m
End Function

; Checks a grid of 8 x 6 points against the numbers of the data, red * 65536 + green * 256 + blue.
Function ParticleGrid(name$, set)
	If set = 0 Then Restore particles_single Else Restore particles_rewritten
	line$ = ""
	For gy = 0 To 5
		For gx = 0 To 7
			x = 10 + gx * 20
			y = 10 + gy * 20
			c = ReadPixel(x, y, BackBuffer()) And $FFFFFF
			If record Then
				line$ = line$ + c + ","
			Else
				Read want
				Check name$ + " red at " + x + "," + y, (c Shr 16) And 255, (want Shr 16) And 255, TOLERANCE
				Check name$ + " green at " + x + "," + y, (c Shr 8) And 255, (want Shr 8) And 255, TOLERANCE
				Check name$ + " blue at " + x + "," + y, c And 255, want And 255, TOLERANCE
			EndIf
		Next
	Next
	If record Then WriteLine out, "Data " + name$ + " " + line$
End Function

; One surface of all the particles in one RenderWorld.
Begin 10, 10, 30
whole = BuildParticles(0, PARTICLES - 1, 0)
RenderWorld
Shot "h1"
Note "H_single_buffer_triangles", TrisRendered(), 3000
ParticleGrid "H_single_buffer", 0
FreeEntity whole

; The same particles in three surfaces, far to near, over three calls that clear nothing.
Begin 10, 10, 30
part1 = BuildParticles(0, 499, 0)
part2 = BuildParticles(500, 999, 0)
part3 = BuildParticles(1000, PARTICLES - 1, 0)
HideEntity part2
HideEntity part3
RenderWorld
HideEntity part1
ShowEntity part2
Keep()
RenderWorld
HideEntity part2
ShowEntity part3
RenderWorld
Shot "h2"
ParticleGrid "H_three_calls", 0
FreeEntity part1
FreeEntity part2
FreeEntity part3

; The one buffer rewritten between three calls: the particles move to the right by 4 for each of the calls, and nothing is
; cleared, so what was drawn before has to stay where it was drawn.
Begin 10, 10, 30
whole = BuildParticles(0, PARTICLES - 1, 0)
s = GetSurface(whole, 1)
Keep()
For call = 0 To 2
	shift# = call * 4.0
	For n = 0 To PARTICLES - 1
		i = order(n)
		h# = 0.9
		x# = part_x(i) + shift
		y# = part_y(i)
		z# = part_z(i)
		v = n * 4
		VertexCoords s, v, x - h, y - h, z
		VertexCoords s, v + 1, x - h, y + h, z
		VertexCoords s, v + 2, x + h, y + h, z
		VertexCoords s, v + 3, x + h, y - h, z
	Next
	RenderWorld
	If call = 0 Then Keep()
Next
Shot "h3"
ParticleGrid "H_buffer_rewritten", 1
FreeEntity whole

