; DitherTemporal in 3D, which needs a window and a GPU, so this is skipped without one. The noise of Dither moves with every
; picture that is shown, unless DitherTemporal turns that off: then a gradient is the same pattern in every picture.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_dither_temporal_pixels: skipped, there is no window."
	End
EndIf

Const W = 128, H = 96
Graphics3D W, H, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
PositionEntity camera, 0, 2, -3
RotateEntity camera, 25, 0, 0
CameraClsColor camera, 0, 0, 0
CameraFogMode camera, 1
CameraFogRange camera, 1, 40
CameraFogColor camera, 200, 60, 20
CameraRange camera, 0.1, 100

Global ground = CreatePlane()
EntityFX ground, 1
EntityColor ground, 40, 40, 40

Dim picture(3, H * W)

; Renders and keeps what the picture is, then shows it, which moves the noise on to the next picture.
Function Take(n)
	Local x, y
	RenderWorld
	For y = 0 To H - 1
		For x = 0 To W - 1
			picture(n, y * W + x) = ReadPixel(x, y, BackBuffer()) And $FFFFFF
		Next
	Next
	Flip 2
End Function

Function Differing(a, b)
	Local i, n = 0
	For i = 0 To H * W - 1
		If picture(a, i) <> picture(b, i) Then n = n + 1
	Next
	Return n
End Function

Dither 1

; On by default: the next picture has other noise.
DitherTemporal True
Take 0
Take 1
CheckTrue "The noise moves with DitherTemporal on", Differing(0, 1) > 10

; Off: the same pattern again and again.
DitherTemporal False
Take 0
Take 1
Take 2
Check "The noise stays with DitherTemporal off (1, 2)", Differing(0, 1), 0
Check "The noise stays with DitherTemporal off (2, 3)", Differing(1, 2), 0

; The noise is still there, it just does not move.
Dither 0
Take 3
CheckTrue "Dither still adds noise with DitherTemporal off", Differing(2, 3) > 10

; On again.
Dither 1
DitherTemporal True
Take 0
Take 1
CheckTrue "The noise moves again with DitherTemporal back on", Differing(0, 1) > 10
Done "blitz3d_dither_temporal_pixels"
