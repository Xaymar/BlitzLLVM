; A .b3d whose triangles name brushes that the file does not have: the model has to load (the triangles are painted by no brush), and the
; program must not read from beyond the brushes.
Include "check.bb"

Graphics3D 320, 240, 32, 2

Function WriteTag(file, tag$, size)
	For i = 1 To 4
		WriteByte file, Asc(Mid$(tag, i, 1))
	Next
	WriteInt file, size
End Function

Function WriteVertex(file, x#, y#, z#)
	WriteFloat file, x : WriteFloat file, y : WriteFloat file, z
End Function

; Two groups of triangles, one with the brush 7 and one with the brush 9, and no brushes at all. The vertices are 4 + 3 * 12 + 12 = 48 bytes,
; a group 8 + 16 = 24, the mesh 4 + (8 + 48) + 2 * 24 = 108 and the node 42 + (8 + 108) = 158.
folder$ = "suite_tmp_b3d_brush_range"
CreateDir folder
name$ = folder + "/brushes.b3d"
file = WriteFile(name)
WriteTag file, "BB3D", 4 + 8 + 158
WriteInt file, 1
WriteTag file, "NODE", 158
WriteByte file, Asc("m") : WriteByte file, 0
WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
WriteFloat file, 1 : WriteFloat file, 1 : WriteFloat file, 1
WriteFloat file, 1 : WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
WriteTag file, "MESH", 108
WriteInt file, -1
WriteTag file, "VRTS", 48
WriteInt file, 0 : WriteInt file, 0 : WriteInt file, 0
WriteVertex file, 0, 0, 0
WriteVertex file, 1, 0, 0
WriteVertex file, 0, 1, 0
WriteTag file, "TRIS", 16
WriteInt file, 7
WriteInt file, 0 : WriteInt file, 1 : WriteInt file, 2
WriteTag file, "TRIS", 16
WriteInt file, 9
WriteInt file, 0 : WriteInt file, 2 : WriteInt file, 1
CloseFile file

mesh = LoadMesh(name)
CheckTrue "A mesh with brushes that are not there loads", mesh <> 0
If mesh <> 0 Then FreeEntity mesh
DeleteFile name
DeleteDir folder
Done "blitz3d_b3d_brush_range"
