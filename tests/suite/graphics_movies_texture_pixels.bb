; GetMovieTexture, which needs a window and a GPU, so this is skipped without one: a movie on a quad in a 3D scene. The movies in movies/ are
; red for a second, then green, then blue (see graphics_movies.bb), and the texture follows them while the world is rendered.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_movies_texture_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Near(name$, red, green, blue)
	p = ReadPixel(80, 60, BackBuffer()) And $FFFFFF
	pr = (p Shr 16) And 255
	pg = (p Shr 8) And 255
	pb = p And 255
	If Abs(pr - red) > 40 Or Abs(pg - green) > 40 Or Abs(pb - blue) > 40 Then RuntimeError name + ": got " + pr + "," + pg + "," + pb + ", expected " + red + "," + green + "," + blue
	suite_checks = suite_checks + 1
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, -3

; A quad that fills the middle of the view and shows the whole texture.
quad = CreateMesh()
s = CreateSurface(quad)
AddVertex s, -1, -1, 0, 0, 1
AddVertex s, -1, 1, 0, 0, 0
AddVertex s, 1, 1, 0, 1, 0
AddVertex s, 1, -1, 0, 1, 1
AddTriangle s, 0, 1, 2
AddTriangle s, 0, 2, 3
EntityFX quad, 1

Dim files$(2)
files(0) = "movies/colors.mpg"
files(1) = "movies/colors.avi"
files(2) = "movies/colors.mp4"

For i = 0 To 2
	movie = OpenMovie(files(i))
	texture = GetMovieTexture(movie)
	CheckTrue "GetMovieTexture of " + files(i), texture <> 0
	Check "The texture is as wide as " + files(i), TextureWidth(texture), MovieWidth(movie)
	Check "The texture is as high as " + files(i), TextureHeight(texture), MovieHeight(movie)
	Check "GetMovieTexture is the same texture every time for " + files(i), GetMovieTexture(movie), texture
	EntityTexture quad, texture

	started = MilliSecs()
	While MoviePlaying(movie)
		RenderWorld
		t = MilliSecs() - started
		If t > 400 And t < 700 Then Near files(i) + " red on the quad", 255, 0, 0 : seen_red = 1
		If t > 1400 And t < 1700 Then Near files(i) + " green on the quad", 0, 255, 0 : seen_green = 1
		If t > 2400 And t < 2700 Then Near files(i) + " blue on the quad", 0, 0, 255 : seen_blue = 1
		Flip 2
		Delay 10
		If t > 6000 Then RuntimeError files(i) + " did not end"
	Wend
	CheckTrue files(i) + ": red was seen on the quad", seen_red
	CheckTrue files(i) + ": green was seen on the quad", seen_green
	CheckTrue files(i) + ": blue was seen on the quad", seen_blue
	seen_red = 0
	seen_green = 0
	seen_blue = 0
	EntityTexture quad, 0
	CloseMovie movie
Next

If GetEnv$("BLITZLLVM_TEST_DEBUG") = "" Then Check "GetMovieTexture of no movie", GetMovieTexture(0), 0

Print "graphics_movies_texture_pixels: " + suite_checks + " checks passed."
