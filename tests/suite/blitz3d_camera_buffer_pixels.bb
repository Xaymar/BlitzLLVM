; SetCameraBuffer makes a camera always draw into its own buffer, whatever SetBuffer says, and GetCameraBuffer gives it back.
; It needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_camera_buffer_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Red(buffer, x, y)
	Return (ReadPixel(x, y, buffer) Shr 16) And 255
End Function

Function Green(buffer, x, y)
	Return (ReadPixel(x, y, buffer) Shr 8) And 255
End Function

Function Blue(buffer, x, y)
	Return ReadPixel(x, y, buffer) And 255
End Function

target = CreateTexture(64, 64, 1 + 4096)
tb = TextureBuffer(target)

; The main camera draws a red cube on blue into the back buffer.
main = CreateCamera()
CameraClsColor main, 0, 0, 255
PositionEntity main, 0, 0, -5
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0

; The second camera draws the same cube on green, always into the texture.
other = CreateCamera()
CameraClsColor other, 0, 255, 0
PositionEntity other, 0, 0, -5
Check "A new camera draws into the buffer of SetBuffer", GetCameraBuffer(other), 0, 0
SetCameraBuffer other, tb
CheckTrue "GetCameraBuffer gives the buffer", GetCameraBuffer(other) = tb

RenderWorld
; The camera with the buffer did not draw into the back buffer, the main camera did.
CheckTrue "The back buffer has the cube of the main camera", Red(BackBuffer(), 80, 60) > 200
CheckTrue "And its clear color around it", Blue(BackBuffer(), 2, 2) > 200
CheckTrue "Not the clear color of the other camera", Green(BackBuffer(), 2, 2) < 20
; The texture has the picture of the other camera, its viewport is the whole texture.
CheckTrue "The texture has the cube", Red(tb, 32, 32) > 200
CheckTrue "And the clear color of the other camera", Green(tb, 1, 1) > 200

; The viewport is in the buffer of the camera.
CameraViewport other, 0, 0, 32, 64
CameraClsColor other, 255, 255, 0
RenderWorld
CheckTrue "Left of the viewport is drawn", Red(tb, 1, 1) > 200 And Green(tb, 1, 1) > 200
CheckTrue "Right of it is left alone", Red(tb, 62, 1) < 20 And Green(tb, 62, 1) > 200
CameraViewport other, 0, 0, 64, 64

; RenderWorld into a texture with SetBuffer still sends the other camera to its own buffer.
other_target = CreateTexture(64, 64, 1 + 4096)
SetBuffer TextureBuffer(other_target)
ClsColor 0, 0, 0 : Cls
CameraClsColor other, 0, 255, 0
RenderWorld
SetBuffer BackBuffer()
CheckTrue "SetBuffer does not move a camera with a buffer", Green(TextureBuffer(other_target), 1, 1) < 20
CheckTrue "The main camera follows SetBuffer", Blue(TextureBuffer(other_target), 1, 1) > 200
CheckTrue "The other camera still draws into its texture", Green(tb, 1, 1) > 200

; 0 sends the camera back to the buffer of SetBuffer, where it draws after the main camera (same order, made later).
SetCameraBuffer other, 0
Check "0 is no buffer of its own", GetCameraBuffer(other), 0, 0
RenderWorld
CheckTrue "It draws into the back buffer again", Green(BackBuffer(), 2, 2) > 200

; A freed texture is not drawn to any more: the camera goes back to the buffer of SetBuffer.
SetCameraBuffer other, tb
FreeTexture target
Check "A freed texture is no buffer", GetCameraBuffer(other), 0, 0
RenderWorld
CheckTrue "The camera draws into the back buffer", Green(BackBuffer(), 2, 2) > 200

; The back buffer can be the buffer of a camera while SetBuffer is a texture.
SetCameraBuffer other, BackBuffer()
CameraClsColor other, 255, 0, 255
SetBuffer TextureBuffer(other_target)
RenderWorld
SetBuffer BackBuffer()
CheckTrue "BackBuffer() as the camera buffer", Red(BackBuffer(), 2, 2) > 200 And Blue(BackBuffer(), 2, 2) > 200

Done "blitz3d_camera_buffer_pixels"
