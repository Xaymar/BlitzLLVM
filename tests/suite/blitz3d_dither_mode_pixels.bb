; DitherMode 1 in 3D drawing: a flat surface that ambient light makes 100.39 (200 times 128 of 255) gets the Bayer matrix before
; it is rounded to 8 bits, so it is 101 where the threshold of the matrix is 0.61 or more, and 100 elsewhere. Every pixel is
; compared with a copy of the function in this file. This needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_dither_mode_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 48

Graphics3D W, H, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
PositionEntity camera, 0, 0, -1
CameraClsColor camera, 0, 0, 0
; A wall that fills the view, lit by nothing but ambient light.
Global wall = CreateCube()
ScaleEntity wall, 10, 10, 1
PositionEntity wall, 0, 0, 2
EntityColor wall, 200, 200, 200
AmbientLight 128, 128, 128

; a - b * floor(a / b), which is what mod is in GLSL.
Function FMod#(a#, b#)
	Return a - b * Floor(a / b)
End Function

; The threshold of the Bayer matrix of a pixel, the same as the function that DitherMode follows, with the frame of the picture
; (0 if it does not move): the pattern moves by frame mod levels in x and frame mod (levels / 2) in y, and its ranks of thresholds rotate by the frame.
Function Bayer#(x, y, levels, frame)
	sx# = x + (frame Mod levels)
	half = levels / 2
	If half < 1 Then half = 1
	sy# = y - (frame Mod half)
	value# = 0
	divisor# = 0
	mul# = 1
	For level = levels To 1 Step -1
		mul = mul * 4
		scale# = 2.0 ^ (1 - level)
		bx# = FMod(Floor(sx * scale), 2)
		by# = FMod(Floor(sy * scale), 2)
		x2# = bx * 2
		value = value + (x2 + (3 - x2 - x2) * by) / 3 * mul
		divisor = divisor + mul
	Next
	thresh# = value / divisor
	colors# = 4.0 ^ levels
	; The thresholds are rank / (colors - 1), and the frame moves every pixel to the rank that is frame further, and around.
	rank = Floor(thresh * (colors - 1) + 0.5)
	rank = FMod(rank + (frame Mod Int(colors)), colors)
	Return rank / (colors - 1)
End Function

; How many pixels of the picture differ from what the function says.
Function Wrong(levels, frame)
	count = 0
	For y = 0 To H - 1
		For x = 0 To W - 1
			expected = 100
			If Bayer(x, y, levels, frame) >= 0.608 Then expected = 101
			If (ReadPixel(x, y, BackBuffer()) And 255) <> expected Then count = count + 1
		Next
	Next
	Return count
End Function

; Without Dither the surface is rounded to 100 everywhere.
Dither False
RenderWorld
Check "without Dither the surface is 100", ReadPixel(10, 10, BackBuffer()) And 255, 100

; Every picture that is shown moves the pattern, and the window shows one before the program starts, so which picture this is
; has to be found.
Dither True
DitherMode 1, 1
RenderWorld
base = -1
For frame = 0 To 3
	If base < 0 And Wrong(1, frame) = 0 Then base = frame
Next
CheckTrue "DitherMode 1, 1 is the 2x2 matrix of one of the first pictures", base >= 0
If base < 0 Then base = 0
frame = base
; (Not level 4: its thresholds of 1/255 come out on the exact tie of the rounding here.)
For levels = 2 To 5
	If levels <> 4 Then
		Flip 2
		frame = frame + 1
		DitherMode 1, levels
		RenderWorld
		Check "DitherMode 1, " + levels + " is the matrix of that level", Wrong(levels, frame), 0
	EndIf
Next

Flip 2
frame = frame + 1
DitherMode 0
RenderWorld
Check "DitherMode 0 is noise, not the matrix", Wrong(4, frame) > (W * H) / 10, True

; With DitherTemporal off the matrix stays where it is: it is the one of picture 0 in every picture.
DitherTemporal False
DitherMode 1, 3
RenderWorld
Check "without DitherTemporal the matrix is the one of the first picture", Wrong(3, 0), 0
Flip 2
RenderWorld
Check "without DitherTemporal it stays in the next picture", Wrong(3, 0), 0
DitherTemporal True

Dither False
EndGraphics
Done "blitz3d_dither_mode_pixels"
