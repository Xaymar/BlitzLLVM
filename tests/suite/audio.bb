; Sound: LoadSound Load3DSound FreeSound LoopSound SoundPitch SoundVolume SoundPan PlaySound StopChannel PauseChannel
; ResumeChannel ChannelPitch ChannelVolume ChannelPan ChannelPlaying PlayMusic PlayCDTrack. Without a sound device (like in the automatic
; tests) nothing plays, so the parts that need one are skipped when PlaySound has no channel to give.
Include "check.bb"
Include "<audio.bb>"

; A short sound is made here, a 440 Hz tone of a tenth of a second as a WAV file.
folder$ = "suite_tmp_audio"
CreateDir folder
name$ = folder + "/tone.wav"
rate = 22050
samples = rate / 10
file = WriteFile(name)
WriteByte file, Asc("R") : WriteByte file, Asc("I") : WriteByte file, Asc("F") : WriteByte file, Asc("F")
WriteInt file, 36 + samples * 2
WriteByte file, Asc("W") : WriteByte file, Asc("A") : WriteByte file, Asc("V") : WriteByte file, Asc("E")
WriteByte file, Asc("f") : WriteByte file, Asc("m") : WriteByte file, Asc("t") : WriteByte file, Asc(" ")
WriteInt file, 16
WriteShort file, 1
WriteShort file, 1
WriteInt file, rate
WriteInt file, rate * 2
WriteShort file, 2
WriteShort file, 16
WriteByte file, Asc("d") : WriteByte file, Asc("a") : WriteByte file, Asc("t") : WriteByte file, Asc("a")
WriteInt file, samples * 2
For i = 0 To samples - 1
	WriteShort file, Sin(Float(i) * 360.0 * 440.0 / rate) * 8000
Next
CloseFile file

; Loading
sound = LoadSound(name)
CheckTrue "LoadSound", sound <> 0
Check "LoadSound missing", LoadSound(folder + "/missing.wav"), 0
sound3d = Load3DSound(name)
CheckTrue "Load3DSound", sound3d <> 0
Check "Load3DSound missing", Load3DSound(folder + "/missing.wav"), 0
CheckTrue "Sounds are different", sound <> sound3d

; What can be set for a sound.
LoopSound sound
SoundPitch sound, 44100
SoundPitch sound, 11025
SoundVolume sound, 0.5
SoundVolume sound, 0
SoundVolume sound, 1
SoundPan sound, -1
SoundPan sound, 0
SoundPan sound, 1
suite_checks = suite_checks + 7

; The 0 of a sound that failed to load does nothing, in every build. PlaySound gives no channel for it.
bad = LoadSound(folder + "/missing.wav")
LoopSound bad
SoundPitch bad, 44100
SoundVolume bad, 0.5
SoundPan bad, 0.5
Check "PlaySound without a sound", PlaySound(bad), 0
FreeSound bad
suite_checks = suite_checks + 1

; Playing gives a channel, 0 if there is no sound device.
channel = PlaySound(sound)
If channel <> 0 Then
	CheckTrue "ChannelPlaying", ChannelPlaying(channel)
	ChannelVolume channel, 0.25
	ChannelPan channel, 0.5
	ChannelPitch channel, 22050
	PauseChannel channel
	CheckTrue "A paused channel", ChannelPlaying(channel) = 0 Or ChannelPlaying(channel) = 1
	ResumeChannel channel
	StopChannel channel
	CheckFalse "A stopped channel", ChannelPlaying(channel)
	suite_checks = suite_checks + 4
Else
	; Without a device, the functions still accept channels that do not exist.
	CheckFalse "ChannelPlaying without a channel", ChannelPlaying(0)
	ChannelVolume 0, 1
	ChannelPan 0, 0
	ChannelPitch 0, 22050
	PauseChannel 0
	ResumeChannel 0
	StopChannel 0
	suite_checks = suite_checks + 6
EndIf

; Music plays like a sound, from any file. A file that is not there gives no channel, and neither does a CD that is not there.
Check "PlayMusic missing", PlayMusic(folder + "/missing.wav"), 0
music = PlayMusic(name)
If music <> 0
	CheckTrue "PlayMusic plays", ChannelPlaying(music)
	StopChannel music
	CheckFalse "PlayMusic stops", ChannelPlaying(music)
Else
	suite_checks = suite_checks + 1
EndIf
; BlitzPlus gives flags: 1 loops, 2 starts paused.
music = PlayMusic(name, 1)
If music <> 0
	Delay 300
	CheckTrue "PlayMusic loops", ChannelPlaying(music)
	StopChannel music
Else
	suite_checks = suite_checks + 1
EndIf
music = PlayMusic(name, 2)
If music <> 0
	Delay 300
	CheckTrue "PlayMusic paused does not play on", ChannelPlaying(music)
	ResumeChannel music
	Delay 300
	CheckFalse "PlayMusic resumed ends", ChannelPlaying(music)
Else
	suite_checks = suite_checks + 1
EndIf
Check "PlayMusic missing flags", PlayMusic(folder + "/missing.wav", 3), 0
Check "PlayCDTrack", PlayCDTrack(1), 0
Check "PlayCDTrack mode", PlayCDTrack(1, 2), 0

; The curve of volume by distance: 0 new, 1 legacy, 2 soloud. A program picks the default for the channels that start after it, and
; can change a channel that is playing. Without a sound device there is no channel, so only the default can be checked then.
Check "GetFalloff starts", GetFalloff(), 0
SetFalloff 1
Check "SetFalloff legacy", GetFalloff(), 1
SetFalloff 2
Check "SetFalloff soloud", GetFalloff(), 2
channel = PlaySound(sound)
If channel <> 0
	Check "A channel starts with the default", GetChannelFalloff(channel), 2
	SetChannelFalloff channel, 1
	Check "SetChannelFalloff", GetChannelFalloff(channel), 1
	Check "SetChannelFalloff leaves the default", GetFalloff(), 2
	StopChannel channel
Else
	suite_checks = suite_checks + 3
EndIf
Check "GetChannelFalloff without a channel", GetChannelFalloff(0), 2
SetChannelFalloff 0, 1
SetFalloff 0
Check "SetFalloff new", GetFalloff(), 0

; The listener settings (BlitzLLVM): they change at once, or fade over the given time, and work without a sound device or a
; listener entity. CreateListener sets them again to what it is given.
Check "GetListenerRolloff starts", GetListenerRolloff(), 1
Check "GetListenerDoppler starts", GetListenerDoppler(), 1
Check "GetListenerDistance starts", GetListenerDistance(), 1
Check "GetListenerRadius starts", GetListenerRadius(), 0
Check "GetSpeedOfSound starts", GetSpeedOfSound(), 340
ListenerRolloff 2
Check "ListenerRolloff", GetListenerRolloff(), 2
ListenerDoppler 0.5
Check "ListenerDoppler", GetListenerDoppler(), 0.5
ListenerDistance 0.25
Check "ListenerDistance", GetListenerDistance(), 0.25
ListenerRadius 3
Check "ListenerRadius", GetListenerRadius(), 3
SpeedOfSound 1500
Check "SpeedOfSound", GetSpeedOfSound(), 1500
; A fade starts from where the value is and ends at the new one.
ListenerDoppler 1.5, 400
fading# = GetListenerDoppler()
CheckTrue "ListenerDoppler fades", fading >= 0.5 And fading < 1.5
SpeedOfSound 340, 400
Delay 600
Check "ListenerDoppler faded", GetListenerDoppler(), 1.5
Check "SpeedOfSound faded", GetSpeedOfSound(), 340
; A new value during a fade starts from the value it has reached.
ListenerRadius 0, 10000
ListenerRadius 1
Check "ListenerRadius stops a fade", GetListenerRadius(), 1
ListenerRolloff 1 : ListenerDoppler 1 : ListenerDistance 1 : ListenerRadius 0

; ListenerFalloff sets the default curve and the one of every channel that plays.
ListenerFalloff 1
Check "ListenerFalloff", GetFalloff(), 1
channel = PlaySound(sound)
If channel <> 0
	SetChannelFalloff channel, 2
	ListenerFalloff 0
	Check "ListenerFalloff changes playing channels", GetChannelFalloff(channel), 0
	StopChannel channel
Else
	ListenerFalloff 0
	suite_checks = suite_checks + 1
EndIf
Check "ListenerFalloff back", GetFalloff(), 0

; ChannelDoppler and ChannelRadius are per channel. A channel that does not exist gives the defaults.
channel = PlaySound(sound)
If channel <> 0
	Check "ChannelDoppler starts", GetChannelDoppler(channel), 1
	ChannelDoppler channel, 0
	Check "ChannelDoppler", GetChannelDoppler(channel), 0
	Check "ChannelRadius starts", GetChannelRadius(channel), 0
	ChannelRadius channel, 2.5
	Check "ChannelRadius", GetChannelRadius(channel), 2.5
	StopChannel channel
Else
	suite_checks = suite_checks + 4
EndIf
ChannelDoppler 0, 0
ChannelRadius 0, 1
Check "GetChannelDoppler without a channel", GetChannelDoppler(0), 1
Check "GetChannelRadius without a channel", GetChannelRadius(0), 0

; Buses (BlitzLLVM). Bus 0 is the master bus, which everything plays on until it is moved. Buses feed other buses, and work without a
; sound device too: only what plays on them is silent then.
Check "GetAudioBusVolume of master", GetAudioBusVolume(0), 1
world = CreateAudioBus()
CheckTrue "CreateAudioBus", world > 0
cave = CreateAudioBus(world)
CheckTrue "CreateAudioBus with a parent", cave > 0 And cave <> world
Check "GetAudioBusParent", GetAudioBusParent(cave), world
Check "GetAudioBusParent of a new bus", GetAudioBusParent(world), 0
Check "GetAudioBusVolume of a new bus", GetAudioBusVolume(cave), 1
AudioBusVolume cave, 0.5
Check "AudioBusVolume", GetAudioBusVolume(cave), 0.5
AudioBusVolume cave, 2
Check "AudioBusVolume above 1", GetAudioBusVolume(cave), 2
AudioBusVolume world, 0, 400
fading# = GetAudioBusVolume(world)
CheckTrue "AudioBusVolume fades", fading > 0 And fading <= 1
Delay 600
Check "AudioBusVolume faded", GetAudioBusVolume(world), 0
AudioBusVolume world, 1
other = CreateAudioBus()
AudioBusParent cave, other
Check "AudioBusParent", GetAudioBusParent(cave), other
AudioBusParent cave, world
; A bus that is freed gives its children to its parent.
FreeAudioBus world
Check "FreeAudioBus moves the children", GetAudioBusParent(cave), 0
FreeAudioBus 0
again = CreateAudioBus()
CheckTrue "CreateAudioBus reuses a freed handle", again > 0

SoundBus sound, cave
MusicBus cave
channel = PlaySound(sound)
If channel <> 0
	Check "SoundBus", GetChannelBus(channel), cave
	ChannelBus channel, other
	Check "ChannelBus", GetChannelBus(channel), other
	PauseAudioBus other
	CheckTrue "PauseAudioBus keeps the channel", ChannelPlaying(channel)
	ResumeAudioBus other
	StopAudioBus other
	CheckFalse "StopAudioBus", ChannelPlaying(channel)
Else
	suite_checks = suite_checks + 4
EndIf
music = PlayMusic(name)
If music <> 0
	Check "MusicBus", GetChannelBus(music), cave
	StopChannel music
Else
	suite_checks = suite_checks + 1
EndIf
; A channel paused on its own stays paused when its bus resumes.
channel = PlaySound(sound)
If channel <> 0
	PauseChannel channel
	PauseAudioBus cave
	ResumeAudioBus cave
	Delay 300
	CheckTrue "A paused channel stays paused", ChannelPlaying(channel)
	StopChannel channel
Else
	suite_checks = suite_checks + 1
EndIf
ChannelBus 0, cave
Check "GetChannelBus without a channel", GetChannelBus(0), 0
SoundBus 0, cave
FreeAudioBus cave
FreeAudioBus other
FreeAudioBus again
MusicBus 0
SoundBus sound, 0

; Audio scenes (BlitzLLVM) hold bus volumes and listener settings, and set only what they hold when applied.
world = CreateAudioBus()
music = CreateAudioBus()
paused = CreateAudioScene()
CheckTrue "CreateAudioScene", paused > 0
AudioSceneVolume paused, world, 0.25
AudioSceneListener paused, BB_LISTENER_DOPPLER, 0
AudioBusVolume music, 0.75
ApplyAudioScene paused
Check "ApplyAudioScene sets a bus", GetAudioBusVolume(world), 0.25
Check "ApplyAudioScene sets the listener", GetListenerDoppler(), 0
Check "ApplyAudioScene leaves the rest", GetAudioBusVolume(music), 0.75
; Capture and apply gives back every value.
normal = CreateAudioScene()
AudioBusVolume world, 1
ListenerDoppler 1
SpeedOfSound 500
CaptureAudioScene normal
ApplyAudioScene paused
SpeedOfSound 340
ApplyAudioScene normal, 300
fading# = GetAudioBusVolume(world)
CheckTrue "ApplyAudioScene fades", fading >= 0.25 And fading < 1
Delay 500
Check "CaptureAudioScene bus", GetAudioBusVolume(world), 1
Check "CaptureAudioScene master", GetAudioBusVolume(BB_MASTER_BUS), 1
Check "CaptureAudioScene other bus", GetAudioBusVolume(music), 0.75
Check "CaptureAudioScene listener", GetListenerDoppler(), 1
Check "CaptureAudioScene speed of sound", GetSpeedOfSound(), 500
SpeedOfSound 340
; Blending: 0 is the first scene, 1 the second, a value only one holds is mixed with its default.
BlendAudioScene paused, normal, 0
Check "BlendAudioScene 0", GetAudioBusVolume(world), 0.25
BlendAudioScene paused, normal, 1
Check "BlendAudioScene 1", GetAudioBusVolume(world), 1
BlendAudioScene paused, normal, 0.5
Check "BlendAudioScene half", GetAudioBusVolume(world), 0.625
other = CreateAudioScene()
AudioSceneVolume other, music, 0.5
BlendAudioScene paused, other, 0.5
Check "BlendAudioScene with the default of a bus", GetAudioBusVolume(world), 0.625
Check "BlendAudioScene with the default of the other", GetAudioBusVolume(music), 0.75
Check "BlendAudioScene with the default of the listener", GetListenerDoppler(), 0.5
; Copy, clear, and a freed bus drops out of every scene.
copy = CopyAudioScene(paused)
ClearAudioScene copy, world
AudioBusVolume world, 1
ApplyAudioScene copy
Check "ClearAudioScene one bus", GetAudioBusVolume(world), 1
Check "CopyAudioScene keeps the rest", GetListenerDoppler(), 0
ClearAudioScene copy
ListenerDoppler 1
ApplyAudioScene copy
Check "ClearAudioScene everything", GetListenerDoppler(), 1
FreeAudioBus world
again = CreateAudioBus()
ApplyAudioScene paused
Check "A freed bus drops out of scenes", GetAudioBusVolume(again), 1
ListenerDoppler 1
FreeAudioScene paused
FreeAudioScene normal
FreeAudioScene other
FreeAudioScene copy
FreeAudioScene 0
FreeAudioBus again
FreeAudioBus music

; Effects (BlitzLLVM) sit in the chain of a bus. Their parameters start at the defaults of their type and can be set and faded.
world = CreateAudioBus()
lowpass = AddAudioEffect(world, BB_EFFECT_LOWPASS)
CheckTrue "AddAudioEffect", lowpass <> 0
Check "AddAudioEffect frequency", GetAudioEffectParam(lowpass, BB_EFFECTPARAM_FREQUENCY), 20000
Check "AddAudioEffect mix", GetAudioEffectParam(lowpass, BB_EFFECTPARAM_MIX), 1
echo = AddAudioEffect(world, BB_EFFECT_ECHO, 0)
Check "AddAudioEffect echo delay", GetAudioEffectParam(echo, BB_EFFECTPARAM_DELAY), 0.3
Check "AddAudioEffect echo mix", GetAudioEffectParam(echo, BB_EFFECTPARAM_MIX), 0.5
reverb = AddAudioEffect(BB_MASTER_BUS, BB_EFFECT_REVERB)
CheckTrue "AddAudioEffect handles", lowpass <> echo And echo <> reverb And lowpass <> world
Check "AddAudioEffect reverb mix", GetAudioEffectParam(reverb, BB_EFFECTPARAM_MIX), 0.3
Check "AddAudioEffect reverb width", GetAudioEffectParam(reverb, BB_EFFECTPARAM_WIDTH), 1
AudioEffectParam lowpass, BB_EFFECTPARAM_FREQUENCY, 800
Check "AudioEffectParam", GetAudioEffectParam(lowpass, BB_EFFECTPARAM_FREQUENCY), 800
AudioEffectParam lowpass, BB_EFFECTPARAM_FREQUENCY, 20000, 300
fading# = GetAudioEffectParam(lowpass, BB_EFFECTPARAM_FREQUENCY)
CheckTrue "AudioEffectParam fades", fading >= 800 And fading < 20000
Delay 400
Check "AudioEffectParam faded", GetAudioEffectParam(lowpass, BB_EFFECTPARAM_FREQUENCY), 20000
AudioEffectBypass echo, True
AudioEffectBypass echo, False
; Every type, with the parameters it has.
For kind = BB_EFFECT_LOWPASS To BB_EFFECT_LOFI
	effect = AddAudioEffect(world, kind)
	CheckTrue "AddAudioEffect type " + kind, effect <> 0
	FreeAudioEffect effect
Next
compressor = AddAudioEffect(world, BB_EFFECT_COMPRESSOR)
Check "Compressor threshold", GetAudioEffectParam(compressor, BB_EFFECTPARAM_THRESHOLD), -12
Check "Compressor ratio", GetAudioEffectParam(compressor, BB_EFFECTPARAM_RATIO), 4
Check "Compressor attack", GetAudioEffectParam(compressor, BB_EFFECTPARAM_ATTACK), 0.01
Check "Compressor release", GetAudioEffectParam(compressor, BB_EFFECTPARAM_RELEASE), 0.2
limiter = AddAudioEffect(world, BB_EFFECT_LIMITER)
Check "Limiter ceiling", GetAudioEffectParam(limiter, BB_EFFECTPARAM_CEILING), -0.3
lofi = AddAudioEffect(world, BB_EFFECT_LOFI)
Check "Lo-fi rate", GetAudioEffectParam(lofi, BB_EFFECTPARAM_RATE), 8000
Check "Lo-fi bits", GetAudioEffectParam(lofi, BB_EFFECTPARAM_BITS), 8
FreeAudioEffect compressor
FreeAudioEffect limiter
FreeAudioEffect lofi
; Scenes hold parameters and the bypass of bus effects.
under = CreateAudioScene()
AudioSceneParam under, lowpass, BB_EFFECTPARAM_FREQUENCY, 500
AudioSceneBypass under, echo, True
ApplyAudioScene under
Check "AudioSceneParam", GetAudioEffectParam(lowpass, BB_EFFECTPARAM_FREQUENCY), 500
Check "ApplyAudioScene leaves other parameters", GetAudioEffectParam(lowpass, BB_EFFECTPARAM_RESONANCE), 0.707107
captured = CreateAudioScene()
AudioEffectParam lowpass, BB_EFFECTPARAM_FREQUENCY, 1000
CaptureAudioScene captured
AudioEffectParam lowpass, BB_EFFECTPARAM_FREQUENCY, 3000
AudioEffectParam echo, BB_EFFECTPARAM_FEEDBACK, 0.8
ApplyAudioScene captured
Check "CaptureAudioScene effect parameter", GetAudioEffectParam(lowpass, BB_EFFECTPARAM_FREQUENCY), 1000
Check "CaptureAudioScene other effect", GetAudioEffectParam(echo, BB_EFFECTPARAM_FEEDBACK), 0.4
empty = CreateAudioScene()
BlendAudioScene under, empty, 0.5
Check "BlendAudioScene with the default of an effect", GetAudioEffectParam(lowpass, BB_EFFECTPARAM_FREQUENCY), 10250
ClearAudioScene under, lowpass
AudioEffectParam lowpass, BB_EFFECTPARAM_FREQUENCY, 2000
ApplyAudioScene under
Check "ClearAudioScene one effect", GetAudioEffectParam(lowpass, BB_EFFECTPARAM_FREQUENCY), 2000
FreeAudioEffect lowpass
again = AddAudioEffect(world, BB_EFFECT_LOWPASS)
ApplyAudioScene captured
Check "A freed effect drops out of scenes", GetAudioEffectParam(again, BB_EFFECTPARAM_FREQUENCY), 20000
FreeAudioScene under
FreeAudioScene captured
FreeAudioScene empty
FreeAudioEffect reverb
FreeAudioEffect 0
FreeAudioBus world

FreeSound sound
FreeSound sound3d
DeleteFile name
Done "audio"
