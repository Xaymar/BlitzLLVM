; Sound: LoadSound Load3DSound FreeSound LoopSound SoundPitch SoundVolume SoundPan PlaySound StopChannel PauseChannel
; ResumeChannel ChannelPitch ChannelVolume ChannelPan ChannelPlaying. Without a sound device (like in the automatic
; tests) nothing plays, so the parts that need one are skipped when PlaySound has no channel to give.
Include "check.bb"

; A short sound is made here, a 440 Hz tone of a tenth of a second as a WAV file.
folder$ = "suite_tmp_audio"
CreateDir folder
name$ = folder + "/tone.wav"
rate = 22050
samples = rate / 10
file = WriteFile(name)
WriteByte file, Asc("R") : WriteByte file, Asc("I") : WriteByte file, Asc("F") : WriteByte file, Asc("F")
WriteInt file, 36 + samples * 2
WriteByte file, Asc("W") : WriteByte file, Asc("A") : WriteByte file, Asc("V") : WriteByte file, Asc("E")
WriteByte file, Asc("f") : WriteByte file, Asc("m") : WriteByte file, Asc("t") : WriteByte file, Asc(" ")
WriteInt file, 16
WriteShort file, 1
WriteShort file, 1
WriteInt file, rate
WriteInt file, rate * 2
WriteShort file, 2
WriteShort file, 16
WriteByte file, Asc("d") : WriteByte file, Asc("a") : WriteByte file, Asc("t") : WriteByte file, Asc("a")
WriteInt file, samples * 2
For i = 0 To samples - 1
	WriteShort file, Sin(Float(i) * 360.0 * 440.0 / rate) * 8000
Next
CloseFile file

; Loading
sound = LoadSound(name)
CheckTrue "LoadSound", sound <> 0
Check "LoadSound missing", LoadSound(folder + "/missing.wav"), 0
sound3d = Load3DSound(name)
CheckTrue "Load3DSound", sound3d <> 0
Check "Load3DSound missing", Load3DSound(folder + "/missing.wav"), 0
CheckTrue "Sounds are different", sound <> sound3d

; What can be set for a sound.
LoopSound sound
SoundPitch sound, 44100
SoundPitch sound, 11025
SoundVolume sound, 0.5
SoundVolume sound, 0
SoundVolume sound, 1
SoundPan sound, -1
SoundPan sound, 0
SoundPan sound, 1
suite_checks = suite_checks + 7

; Playing gives a channel, 0 if there is no sound device.
channel = PlaySound(sound)
If channel <> 0 Then
	CheckTrue "ChannelPlaying", ChannelPlaying(channel)
	ChannelVolume channel, 0.25
	ChannelPan channel, 0.5
	ChannelPitch channel, 22050
	PauseChannel channel
	CheckTrue "A paused channel", ChannelPlaying(channel) = 0 Or ChannelPlaying(channel) = 1
	ResumeChannel channel
	StopChannel channel
	CheckFalse "A stopped channel", ChannelPlaying(channel)
	suite_checks = suite_checks + 4
Else
	; Without a device, the functions still accept channels that do not exist.
	CheckFalse "ChannelPlaying without a channel", ChannelPlaying(0)
	ChannelVolume 0, 1
	ChannelPan 0, 0
	ChannelPitch 0, 22050
	PauseChannel 0
	ResumeChannel 0
	StopChannel 0
	suite_checks = suite_checks + 6
EndIf

FreeSound sound
FreeSound sound3d
DeleteFile name
Done "audio"
