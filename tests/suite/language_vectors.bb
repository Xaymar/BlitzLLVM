; Vectors and matrices as values: FloatVector3, IntVector4, DoubleMatrix2x2 by name, construction, copies, elements, components,
; operators, parameters, results and fields.
Include "check.bb"

; A size behind a long type still counts up to the highest index, as in the original: Float[3] is an array of 4.
Local old:Float[3]
old[3] = 5
Check "array behind a long type", old[3], 5
Local a:FloatVector3 = FloatVector3(1, 2, 3)
Local b:FloatVector3 = FloatVector3(4, 5, 6)
Check "x", a\x, 1
Check "y", a\y, 2
Check "z", a\z, 3
Check "index", b[2], 6
Check "same type by name and by size", (a + b)\y, 7
Check "r g b are x y z", a\g, 2

; Construction: numbers, a smaller vector and a number, one number for everything, another type.
Local c:FloatVector4 = FloatVector4(a, 9)
Check "vector and number", c\w, 9
Check "vector and number keeps the vector", c\z, 3
Local d:FloatVector3 = FloatVector3(7)
Check "one number for all", d\z, 7
Local e:DoubleVector3 = DoubleVector3(a)
Check "other type", e\y, 2
Local f:IntVector2 = IntVector2(3.4, 7)
Check "real to integer rounds", f\x, 3
Local zero:FloatVector3 = FloatVector3()
Check "empty is zero", zero\x + zero\y + zero\z, 0

; A copy is a copy.
Local g:FloatVector3 = a
g\x = 100
Check "copy leaves the original", a\x, 1
Check "copy has the change", g\x, 100
g = g
Check "assigning to itself", g\x, 100
a[0] = 11
Check "element assignment", a\x, 11
a\y = 12
Check "component assignment", a[1], 12
a = FloatVector3(1, 2, 3)

; Operators work on every number, and on vectors of the same size.
Local s:FloatVector3 = a + b
Check "add", s\x, 5
Check "add z", s\z, 9
s = b - a
Check "subtract", s\y, 3
s = a * b
Check "multiply is per number", s\z, 18
s = b / a
Check "divide", s\y, 2.5
s = a * 2
Check "vector times number", s\z, 6
s = 2 * a
Check "number times vector", s\z, 6
s = a + 1
Check "vector plus number", s\x, 2
s = 10 - a
Check "number minus vector", s\z, 7
s = -a
Check "negate", s\y, -2
CheckTrue "equal", a = FloatVector3(1, 2, 3)
CheckFalse "not equal is false for the same", a <> FloatVector3(1, 2, 3)
CheckTrue "not equal", a <> b
CheckFalse "equal is false for others", a = b

; Integers follow the rules of single numbers.
Local i:IntVector4 = IntVector4(1, 2, 3, 4)
Local j:IntVector4 = i * 2 + i
Check "integer vector", j\w, 12
Local bytes:UByteVector4 = UByteVector4(250, 251, 252, 253)
Local wrapped:UByteVector4 = bytes + UByteVector4(10, 10, 10, 10)
Check "wraps on assignment like a single number", wrapped\x, 4
Local halves:HalfVector2 = HalfVector2(0.5, 1.5)
Local fh:HalfVector2 = halves + halves
Check "half", fh\y, 3

; Matrices are columns of vectors.
Local m:FloatMatrix3x2
m[0][0] = 1
m[0][1] = 2
m[1][0] = 3
m[1][1] = 4
m[2][0] = 5
m[2][1] = 6
Local col:FloatVector2 = m[1]
Check "column of a matrix", col\y, 4
Local n:FloatMatrix3x2 = FloatMatrix3x2(1, 2, 3, 4, 5, 6)
CheckTrue "numbers fill the columns", m = n
Local o:FloatMatrix3x2 = FloatMatrix3x2(FloatVector2(1, 2), FloatVector2(3, 4), FloatVector2(5, 6))
CheckTrue "columns fill the matrix", m = o
Local p:FloatMatrix3x2 = m + n
Check "matrix plus matrix", p[2][1], 12

; Multiplication of matrices and of a matrix with a vector: columns times rows.
Local x:FloatMatrix2x2 = FloatMatrix2x2(1, 2, 3, 4)
Local y:FloatMatrix2x2 = FloatMatrix2x2(5, 6, 7, 8)
Local xy:FloatMatrix2x2 = x * y
; Columns: x = [1 2] [3 4], y = [5 6] [7 8]: first column of the result = 5 * [1 2] + 6 * [3 4]
Check "matrix product 00", xy[0][0], 23
Check "matrix product 01", xy[0][1], 34
Check "matrix product 10", xy[1][0], 31
Check "matrix product 11", xy[1][1], 46
Local v2:FloatVector2 = x * FloatVector2(1, 1)
Check "matrix times vector", v2\x, 4
Check "matrix times vector y", v2\y, 6
Local m23:FloatVector2 = m * FloatVector3(1, 0, 1)
Check "non square times vector", m23\x, 6
Check "non square times vector y", m23\y, 8
Local wide:FloatMatrix3x3 = FloatMatrix3x3(1, 0, 0, 0, 1, 0, 0, 0, 1)
Local tall:FloatMatrix3x2 = m * wide
CheckTrue "identity", tall = m

; Parameters are copies, results are values.
Function Double3Of:FloatVector3(v:FloatVector3)
	v\x = v\x * 2
	v\y = v\y * 2
	v\z = v\z * 2
	Return v
End Function

Function Length2:Float(v:FloatVector3)
	Return Sqr(v\x * v\x + v\y * v\y + v\z * v\z)
End Function

Function Cross:FloatVector3(a:FloatVector3, b:FloatVector3)
	Return FloatVector3(a\y * b\z - a\z * b\y, a\z * b\x - a\x * b\z, a\x * b\y - a\y * b\x)
End Function

Local doubled:FloatVector3 = Double3Of(a)
Check "result", doubled\z, 6
Check "the argument is not changed", a\z, 3
Check "number from a vector", Length2(FloatVector3(2, 3, 6)), 7
Local cr:FloatVector3 = Cross(FloatVector3(1, 0, 0), FloatVector3(0, 1, 0))
Check "result of a function", cr\z, 1
Check "component of a result", Cross(FloatVector3(1, 0, 0), FloatVector3(0, 1, 0))\z, 1
Check "result inside of an expression", (Double3Of(a) + a)\x, 3

; Fields and globals.
Type Body
	Field position:FloatVector3
	Field rotation:FloatMatrix3x3
End Type

Global origin:FloatVector3 = FloatVector3(1, 1, 1)
Local bd.Body = New Body
bd\position = FloatVector3(1, 2, 3)
bd\position\y = 20
bd\rotation[1][1] = 7
Check "field", bd\position\y, 20
Check "field matrix", bd\rotation[1][1], 7
Local q:FloatVector3 = bd\position + origin
Check "field and global", q\z, 4

Function Shift:Void(by:FloatVector3)
	origin = origin + by
End Function

Shift FloatVector3(1, 2, 3)
Check "global in a function", origin\z, 4

; Larger than what is unrolled.
Local big:FloatVector40
Local big2:FloatVector40
Local k
For k = 0 To 39
	big[k] = k
	big2[k] = 2
Next
Local bigsum:FloatVector40 = big + big2 * 3
Check "loop 0", bigsum[0], 6
Check "loop 39", bigsum[39], 45
CheckTrue "loop equality", big + big2 = big2 + big
CheckFalse "loop inequality", big = big2
Local grid:FloatMatrix8x8
For k = 0 To 7
	grid[k][k] = 1
Next
Local grid2:FloatMatrix8x8 = grid * grid
Check "square matrix of 8", grid2[3][3], 1
Check "square matrix of 8 off diagonal", grid2[3][4], 0
Local bigfill:FloatVector100 = FloatVector100(5)
Check "fill of 100", bigfill[99], 5


; Number types that have a size in their name.
Local small:Int8Vector3 = Int8Vector3(100, 100, 100)
Local small2:Int8Vector3 = small + small
Check "Int8Vector3 wraps", small2\x, -56
Local f32:Float32Vector2 = Float32Vector2(1, 2)
Check "Float32Vector2", f32\y, 2
Local u16:UInt16Matrix2x2 = UInt16Matrix2x2(1, 2, 3, 4)
Check "UInt16Matrix2x2", u16[1][1], 4

; Less bits with more bits give more bits, the same bits stay the same bits.
Local i16:Int16Vector2 = Int16Vector2(100, 100)
Local s8:Int8Vector2 = Int8Vector2(100, 100)
Local wider:Int16Vector2 = i16 + s8
Check "Int16 + Int8 is an Int16", wider\x, 200
Local keep8:Int8Vector2 = Int8Vector2(100, 100)
Local sum8:Int8Vector2 = keep8 * keep8
Check "Int8 * Int8 stays Int8", sum8\x, 16
Local sh:HalfVector2 = HalfVector2(60000, 1)
Local sh2:HalfVector2 = sh + sh
Check "Half + Half stays Half", sh2\x > 65504, 1
Local big10:DoubleVector2 = DoubleVector2(Double(10000000000), 0)
Local fd:DoubleVector2 = FloatVector2(1, 1) + big10
Check "Float + Double is Double", fd\x - Double(10000000000), 1
Local mi:Int8Matrix2x2 = Int8Matrix2x2(100, 0, 0, 100)
Local mp:Int8Matrix2x2 = mi * mi
Check "Int8 matrix product stays Int8", mp[0][0], 16

Done "language_vectors"
