; this is skipped without one: CreateSampler FreeSampler SamplerFilterMin SamplerFilterMag SamplerFilterMip
; SamplerAnisotropy SamplerAddressModeU SamplerAddressModeV SetSamplerAddressModeW SetSamplerLodBias
; SetSamplerLodMin SetSamplerLodMax SetSamplerBorderColor SetTextureSampler.
; A texture of two texels, red and blue, is shown on a cube face that is 80 pixels wide, scaled so that its
; coordinates go from 0 to 2: the sampler decides what is seen past the first repeat, and between the texels. The DDS
; file has a level of its own color for each level (red, green, blue) for the lod settings.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_samplers_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
Global cube = CreateCube()
EntityFX cube, 1

; The front face of the cube is 160 / distance pixels wide, as the view is 90 degrees wide and the face is 2 across.
Function Show(texture, distance)
	EntityTexture cube, texture
	PositionEntity cube, 0, 0, distance + 1
	RenderWorld
End Function

ClearTextureFilters

; Two texels, red and blue.
Function MakeStrip(flags)
	t = CreateTexture(2, 1, flags + 4096)
	SetBuffer TextureBuffer(t)
	WritePixel 0, 0, $FFFF0000
	WritePixel 1, 0, $FF0000FF
	SetBuffer BackBuffer()
	Return t
End Function

; Without a sampler the texture repeats and blends its texels.
strip = MakeStrip(1)
ScaleTexture strip, 0.5, 1
Show strip, 2
Check "Default repeat, red", R(90, 60), 255, 40
Check "Default repeat, blue", B(110, 60), 255, 40
Check "Default linear magnification", B(65, 60), 191, 40

; Filters: nearest keeps the texels apart, linear blends them.
sampler = CreateSampler()
CheckTrue "CreateSampler", sampler <> 0
SamplerFilterMin sampler, 0
SamplerFilterMag sampler, 0
SetTextureSampler strip, sampler
Show strip, 2
Check "Nearest keeps blue pure", B(65, 60), 255, 40
Check "Nearest keeps red out", R(65, 60), 0, 40
SamplerFilterMag sampler, 1
Show strip, 2
Check "Linear mixes blue", B(65, 60), 191, 40
Check "Linear mixes red", R(65, 60), 64, 40
SamplerFilterMag sampler, 0

; Address modes: 0 repeat, 1 mirror, 2 clamp, 3 border. x = 90 has u = 1.25, x = 110 has u = 1.75, x = 65 is between the texels.
SamplerAddressModeU sampler, 0
Show strip, 2
Check "Repeat at 1.25", R(90, 60), 255, 40
Check "Repeat at 1.75", B(110, 60), 255, 40
SamplerAddressModeU sampler, 1
Show strip, 2
Check "Mirror at 1.25", B(90, 60), 255, 40
Check "Mirror at 1.75", R(110, 60), 255, 40
SamplerAddressModeU sampler, 2
Show strip, 2
Check "Clamp at 1.25", B(90, 60), 255, 40
Check "Clamp at 1.75", B(110, 60), 255, 40
SamplerAddressModeU sampler, 3
Show strip, 2
Check "Border at 1.25 is black, red", R(90, 60), 0, 40
Check "Border at 1.25 is black, blue", B(90, 60), 0, 40
Check "Border keeps u below 1", R(50, 60), 255, 40
SetSamplerBorderColor sampler, 1, 1, 1, 1
Show strip, 2
Check "White border, red", R(90, 60), 255, 40
Check "White border, green", G(90, 60), 255, 40
Check "White border, blue", B(90, 60), 255, 40
SetSamplerBorderColor sampler, 0, 0, 0, 1

; V and W are accepted, V decides what is above and below.
SamplerAddressModeV sampler, 2
SetSamplerAddressModeW sampler, 2
SamplerAddressModeV sampler, 0
SetSamplerAddressModeW sampler, 0
SamplerAddressModeU sampler, 0
Show strip, 2
Check "V and W do not change the middle", R(90, 60), 255, 40

; Taking the sampler away goes back to what the flags say.
SamplerFilterMag sampler, 0
SetTextureSampler strip, 0
Show strip, 2
Check "SetTextureSampler 0 goes back to linear", B(65, 60), 191, 40

; A sampler that is freed lets go of its textures.
SetTextureSampler strip, sampler
FreeSampler sampler
Show strip, 2
Check "FreeSampler goes back to linear", B(65, 60), 191, 40

; Levels: dxt1_mips.dds is red, green, blue from the biggest level.
mipped = LoadTexture("images/dxt1_mips.dds", 1 + 8)
levels = CreateSampler()
SetTextureSampler mipped, levels
Show mipped, 10
Check "Level 0 at 10", R(80, 60), 255, 40
SetSamplerLodMin levels, 1
Show mipped, 10
Check "LodMin 1 skips red", G(80, 60), 255, 40
SetSamplerLodMin levels, 0
SetSamplerLodMax levels, 0
Show mipped, 40
Check "LodMax 0 stays on red", R(80, 60), 255, 40
SetSamplerLodMax levels, 1000
SetSamplerLodBias levels, 1
Show mipped, 10
Check "LodBias 1 uses level 1", G(80, 60), 255, 40
SetSamplerLodBias levels, 0
Show mipped, 20
Check "Level 1 at 20", G(80, 60), 255, 40
SamplerFilterMip levels, 0
SamplerFilterMin levels, 0
Show mipped, 20
Check "Nearest mip level 1", G(80, 60), 255, 40
SamplerFilterMip levels, 1
SamplerFilterMin levels, 1

; Anisotropy is a quality setting that is not seen on a face that looks straight at the camera.
SamplerAnisotropy levels, 8
Show mipped, 20
Check "Anisotropy keeps level 1", G(80, 60), 255, 40
SamplerAnisotropy levels, 0
FreeSampler levels

Done "blitz3d_samplers_pixels"
