; Building a surface of 256 by 256 vertices on whole number positions (a grid) takes a moment and not seconds: AddVertex AddTriangle
; UpdateNormals. UpdateNormals found the vertices at the same position with a hash table whose hash only differed in the high bits for
; whole numbers, so where the table picks the bucket by the low bits (MSVC) all vertices of the grid were in one bucket.
Include "check.bb"

Graphics3D 320, 240, 32, 2

Const SubDiv = 256
Local Plane = CreateMesh()
Local PlaneSurf = CreateSurface(Plane)
Local X, Y
Local VertXY[SubDiv * SubDiv]

Local Start = MilliSecs()
For Y = 0 To SubDiv - 1
	For X = 0 To SubDiv - 1
		VertXY[Y * SubDiv + X] = AddVertex(PlaneSurf, X - (SubDiv / 2.), 0., Y - (SubDiv / 2.), X, Y)
	Next
Next
For Y = 1 To SubDiv - 1
	For X = 1 To SubDiv - 1
		AddTriangle(PlaneSurf, VertXY[((Y - 1) * SubDiv) + (X - 1)], VertXY[((Y) * SubDiv) + (X - 1)], VertXY[((Y - 1) * SubDiv) + (X)])
		AddTriangle(PlaneSurf, VertXY[((Y - 1) * SubDiv) + (X)], VertXY[((Y) * SubDiv) + (X - 1)], VertXY[((Y) * SubDiv) + (X)])
	Next
Next
UpdateNormals Plane
Local Elapsed = MilliSecs() - Start

Check "All vertices were added", CountVertices(PlaneSurf), SubDiv * SubDiv
Check "All triangles were added", CountTriangles(PlaneSurf), (SubDiv - 1) * (SubDiv - 1) * 2
; A flat grid has normals that all point the same way.
Check "Normal x of a vertex in the middle", Abs(VertexNX(PlaneSurf, 128 * SubDiv + 128)), 0, 0.001
Check "Normal y of a vertex in the middle", Abs(VertexNY(PlaneSurf, 128 * SubDiv + 128)), 1, 0.001
Check "Normal y of the corner", Abs(VertexNY(PlaneSurf, 0)), 1, 0.001
Check "Normal y of the last vertex", Abs(VertexNY(PlaneSurf, SubDiv * SubDiv - 1)), 1, 0.001
; The original does this in a few milliseconds, the bound is for slow machines and debug builds.
CheckTrue "Building takes less than 3 seconds", Elapsed < 3000

Done "blitz3d_large_mesh_build"
