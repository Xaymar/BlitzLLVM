; this is skipped without one: PNG files of 16 bits per channel (images/gradient16.png) are read with all of their bits, and are
; kept as 10 bits per channel when the texture has no partial alpha. A gray ramp that rises by a bit more than a third of a step of
; 8 bits per texel is shown at a quarter of its size with mip maps, which for 10 bits are made on the CPU from the 16 bits. The
; pictures also have to keep their colors and their mask, and still show after their pixels were read.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_texture_formats_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 16, 8, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, -1
Global quad = CreateMesh()
s = CreateSurface(quad)
AddVertex s, -1, -1, 0, 0, 1
AddVertex s, -1, 1, 0, 0, 0
AddVertex s, 1, 1, 0, 1, 0
AddVertex s, 1, -1, 0, 1, 1
AddTriangle s, 0, 1, 2
AddTriangle s, 0, 2, 3
EntityFX quad, 1

ClearTextureFilters

; How far the row is from the exact average, at worst: pixel x shows the four texels 4 * x to 4 * x + 3 of the ramp, which rise
; by 100 out of 65535 each. The picture is not more exact on every driver (llvmpipe filters 10 bits with less precision than 8),
; so this only asks for a pixel of tolerance, like the picture that was rounded to 8 bits is held to.
Function RampError#(texture)
	EntityTexture quad, texture
	RenderWorld
	worst# = 0
	For x = 1 To 14
		want# = (4.0 * x + 1.5) * 100.0 / 257.0
		got = ReadPixel(x, 4, BackBuffer()) And 255
		If Abs(got - want) > worst Then worst = Abs(got - want)
	Next
	Return worst
End Function

wide = LoadTexture("images/gradient16.png", 1 + 8)
narrow = LoadTexture("images/gradient8.png", 1 + 8)
Check "The 16 bit ramp is as wide as the file", TextureWidth(wide), 64
Check "The 8 bit ramp is as wide as the file", TextureWidth(narrow), 64

error10# = RampError(wide)
error8# = RampError(narrow)
CheckTrue "The 8 bit ramp follows the exact average within a pixel and a half (" + error8 + ")", error8 < 1.5
CheckTrue "The 16 bit ramp follows the exact average within a pixel and a half (" + error10 + ")", error10 < 1.5

; Reading it gives the colors of the file, and turns it into pixels of 8 bits without changing what it shows.
Check "The ramp is gray in the texture buffer", ReadPixel(50, 1, TextureBuffer(wide)) And $FFFFFF, 19 * $010101, 0
Check "The alpha of a texture without alpha is 255", (ReadPixel(50, 1, TextureBuffer(wide)) Shr 24) And 255, 255
error10b# = RampError(wide)
CheckTrue "The ramp still shows after the texture was read", error10b < 1.5

; Mask: black is not there, and the colors are the ones of the file.
masked = LoadTexture("images/mask16.png", 1 + 2 + 4)
buf = TextureBuffer(masked)
Check "Black is see-through with a mask", (ReadPixel(0, 0, buf) Shr 24) And 255, 0
Check "Colors are solid with a mask", (ReadPixel(1, 0, buf) Shr 24) And 255, 255
Check "Almost black is solid with a mask", (ReadPixel(2, 0, buf) Shr 24) And 255, 255
Check "Red of a 16 bit color", (ReadPixel(1, 0, buf) Shr 16) And 255, 233.5, 1
Check "Green of a 16 bit color", (ReadPixel(1, 0, buf) Shr 8) And 255, 155.5, 1
Check "Blue of a 16 bit color", ReadPixel(1, 0, buf) And 255, 77.5, 1
Check "White stays white", ReadPixel(3, 0, buf) And $FFFFFF, $FFFFFF, 0

; With alpha it keeps the 8 bits of alpha, so this is the plain path.
plain = LoadTexture("images/mask16.png", 1 + 2)
Check "Colors of a texture with alpha", (ReadPixel(1, 0, TextureBuffer(plain)) Shr 16) And 255, 233.5, 1

Print "blitz3d_texture_formats_pixels: " + suite_checks + " checks passed."
