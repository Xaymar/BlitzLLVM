; TextureBlend 0 and 4 on the layers of an entity. Direct3D 7 gets the stages of Blitz3D without the layers that have no texture or a
; TextureBlend of 0, so the layers after them move up (and one of them can become the base stage), and Dot3 on a stage after the base
; is the dot product of the texture and what the stages before it made. Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_texture_blend_layers_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global camera = CreateCamera()
PositionEntity camera, 0, 0, -3
CameraClsColor camera, 0, 0, 0
Global quad = CreateMesh()
s = CreateSurface(quad)
v = AddVertex(s, -4, 4, 0, 0, 0)  : VertexNormal s, v, 0, 0, -1
v = AddVertex(s, 4, 4, 0, 1, 0)   : VertexNormal s, v, 0, 0, -1
v = AddVertex(s, 4, -4, 0, 1, 1)  : VertexNormal s, v, 0, 0, -1
v = AddVertex(s, -4, -4, 0, 0, 1) : VertexNormal s, v, 0, 0, -1
AddTriangle s, 0, 1, 2
AddTriangle s, 0, 2, 3
EntityFX quad, 1 ; Full bright: the lit color is the color of the entity.

Function Flat(r, g, b)
	Local t = CreateTexture(4, 4, 1 + 4096)
	SetBuffer TextureBuffer(t)
	Color r, g, b
	Rect 0, 0, 4, 4, 1
	SetBuffer BackBuffer()
	Return t
End Function

Global a = Flat(200, 100, 50)
Global b = Flat(180, 90, 140)
Global c = Flat(60, 120, 30)

Function Center()
	RenderWorld
	Return ReadPixel(80, 60, BackBuffer()) And $FFFFFF
End Function

Function Channel(p, shift)
	Return (p Shr shift) And 255
End Function

Function CheckPixel(name$, p, r, g, b, tolerance)
	Check name + " red", Float(Channel(p, 16)), Float(r), Float(tolerance)
	Check name + " green", Float(Channel(p, 8)), Float(g), Float(tolerance)
	Check name + " blue", Float(Channel(p, 0)), Float(b), Float(tolerance)
End Function

; A layer with TextureBlend 0 is left out, and the layer after it takes its place.
TextureBlend a, 2
TextureBlend b, 0
TextureBlend c, 3
EntityTexture quad, a, 0, 0
EntityTexture quad, b, 0, 1
EntityTexture quad, c, 0, 2
skipped = Center()
EntityTexture quad, a, 0, 0
EntityTexture quad, 0, 0, 1
EntityTexture quad, 0, 0, 2
EntityTexture quad, c, 0, 1
without = Center()
CheckPixel "blend 0 layer is left out", skipped, Channel(without, 16), Channel(without, 8), Channel(without, 0), 2
; And it is not the same as when the layer in the middle counted.
TextureBlend b, 2
EntityTexture quad, 0, 0, 1
EntityTexture quad, b, 0, 1
EntityTexture quad, c, 0, 2
counted = Center()
CheckTrue "blend 2 layer counts", Abs(Channel(counted, 16) - Channel(without, 16)) > 8

; The base layer being empty or TextureBlend 0 makes the next one the first stage, which blends with the color of the entity.
TextureBlend c, 3
EntityTexture quad, 0, 0, 0
EntityTexture quad, 0, 0, 1
EntityTexture quad, 0, 0, 2
EntityTexture quad, c, 0, 0
EntityColor quad, 100, 100, 100
base = Center()
EntityTexture quad, 0, 0, 0
EntityTexture quad, c, 0, 1
shifted = Center()
CheckPixel "empty base layer", shifted, Channel(base, 16), Channel(base, 8), Channel(base, 0), 2
TextureBlend a, 0
EntityTexture quad, a, 0, 0
shifted = Center()
CheckPixel "blend 0 base layer", shifted, Channel(base, 16), Channel(base, 8), Channel(base, 0), 2

; Dot3 on the second layer: 4 * dot(texture - 0.5, before - 0.5) in every channel. Where the GPU cannot read the target while it
; draws to it, the layer multiplies instead, which is also accepted here.
EntityColor quad, 255, 255, 255
TextureBlend a, 2
TextureBlend b, 4
EntityTexture quad, a, 0, 0
EntityTexture quad, b, 0, 1
EntityTexture quad, 0, 0, 2
dotted = Center()
d# = 4.0 * ((180 / 255.0 - 0.5) * (200 / 255.0 - 0.5) + (90 / 255.0 - 0.5) * (100 / 255.0 - 0.5) + (140 / 255.0 - 0.5) * (50 / 255.0 - 0.5))
If d < 0.0 Then d = 0.0
If d > 1.0 Then d = 1.0
level = Int(d * 255.0 + 0.5)
If Abs(Channel(dotted, 16) - level) <= 3 Then
	CheckPixel "dot3 second layer", dotted, level, level, level, 3
Else
	multiplied = 200 * 180 / 255.0
	CheckPixel "dot3 falls back to multiply", dotted, Int(multiplied + 0.5), Int(100 * 90 / 255.0 + 0.5), Int(50 * 140 / 255.0 + 0.5), 3
	Print "blitz3d_texture_blend_layers_pixels: Dot3 on a later layer multiplied, this GPU cannot read the target."
EndIf

Done "blitz3d_texture_blend_layers_pixels"
