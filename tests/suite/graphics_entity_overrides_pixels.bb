; EntityColor, EntityAlpha and EntityFX on a mesh whose surfaces have a brush of their own, with ;#pragma entity-overrides:
; what the program sets on the entity replaces the brush (docs/Modern-Mode.md). Without the pragma they are combined like in
; the original, see graphics_entity_combine_pixels. Needs a window and a GPU, so this is skipped without one.
;#pragma entity-overrides
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_entity_overrides_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0

; A square from -1 to 1, with blue vertex colors and a red brush that is half see-through and fullbright.
mesh = CreateMesh()
surface = CreateSurface(mesh)
AddVertex surface, -1, 1, 0
AddVertex surface, 1, 1, 0
AddVertex surface, 1, -1, 0
AddVertex surface, -1, -1, 0
For v = 0 To 3
	VertexColor surface, v, 0, 0, 255
Next
AddTriangle surface, 0, 1, 2
AddTriangle surface, 0, 2, 3
brush = CreateBrush(255, 0, 0)
BrushAlpha brush, 0.5
BrushFX brush, 1 + 16
PaintMesh mesh, brush
PositionEntity mesh, 0, 0, 3

RenderWorld
Check "The brush alone: half of its red", R(80, 60), 128, 8
Check "The brush alone: no green", G(80, 60), 0, 8

; The color of the entity replaces the red of the brush, its alpha the half of the brush.
EntityColor mesh, 0, 255, 0
EntityAlpha mesh, 1
EntityFX mesh, 1
RenderWorld
Check "EntityColor replaces the brush (red)", R(80, 60), 0, 8
Check "EntityColor replaces the brush (green)", G(80, 60), 255, 8
Check "EntityColor replaces the brush (blue)", B(80, 60), 0, 8

; EntityFX replaces the FX of the brush: without 16 the back is not drawn.
TurnEntity mesh, 0, 180, 0
RenderWorld
Check "EntityFX without 16: the back is culled", G(80, 60), 0, 8
TurnEntity mesh, 0, 180, 0

; PaintEntity counts as setting all of them.
white = CreateBrush(255, 255, 255)
BrushFX white, 1 + 2
PaintEntity mesh, white
RenderWorld
Check "PaintEntity replaces the brush: the vertex colors (blue)", B(80, 60), 255, 8
Check "PaintEntity replaces the brush: no red", R(80, 60), 0, 8

EndGraphics
Done "graphics_entity_overrides_pixels"
