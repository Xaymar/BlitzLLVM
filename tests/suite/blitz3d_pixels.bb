; What 3D puts on the screen, which needs a window and a GPU, so this is skipped without one. It looks at the pixel in
; the middle of the picture after RenderWorld, for what the commands that change the look of things do: EntityColor
; EntityAlpha EntityBlend EntityFX EntityOrder EntityTexture PaintEntity HideEntity ShowEntity CameraClsColor
; CameraClsMode CameraFogMode CameraFogColor CameraFogRange CameraViewport CameraRange CameraZoom AmbientLight
; LightColor Wireframe CopyEntity CreateSprite ScaleSprite EntityAutoFade CaptureWorld HandleSprite FreeTexture BrushFX
; CreateTexture TextureBuffer TextureFilter.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

; The red, green and blue of a pixel, one at a time.
Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 10, 20, 30
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0

; Show draws, hide does not.
RenderWorld
Check "Cube red", R(80, 60), 255, 3
Check "Cube green", G(80, 60), 0, 3
Check "Clear color red", R(2, 2), 10, 3
Check "Clear color green", G(2, 2), 20, 3
Check "Clear color blue", B(2, 2), 30, 3
HideEntity cube
RenderWorld
Check "HideEntity", R(80, 60), 10, 3
ShowEntity cube
RenderWorld
Check "ShowEntity", R(80, 60), 255, 3

; CameraClsMode: without clearing, the old picture stays.
CameraClsMode camera, False, True
HideEntity cube
RenderWorld
Check "Without clearing the color stays", R(80, 60), 255, 3
CameraClsMode camera, True, True
RenderWorld
Check "Clearing again", R(80, 60), 10, 3
ShowEntity cube

; Colors
EntityColor cube, 0, 255, 0
RenderWorld
Check "EntityColor", G(80, 60), 255, 3
Check "EntityColor red", R(80, 60), 0, 3

; Alpha: half of the color and half of what is behind it.
EntityColor cube, 200, 200, 200
EntityAlpha cube, 0.5
RenderWorld
Check "EntityAlpha", R(80, 60), (200 + 10) / 2, 6
EntityAlpha cube, 0
RenderWorld
Check "EntityAlpha 0 shows nothing", R(80, 60), 10, 3
EntityAlpha cube, 1

; Adding makes it brighter, multiplying darker.
EntityColor cube, 100, 100, 100
EntityBlend cube, 3
RenderWorld
Check "EntityBlend add", R(80, 60), 100 + 10, 8
EntityBlend cube, 2
RenderWorld
CheckTrue "EntityBlend multiply (" + R(80, 60) + ")", R(80, 60) < 10
EntityBlend cube, 1

; Light makes things that are not fullbright. A cube lit from the front is brighter than one lit from the side.
EntityFX cube, 0
EntityColor cube, 255, 255, 255
AmbientLight 0, 0, 0
light = CreateLight()
RotateEntity light, 0, 0, 0
LightColor light, 255, 255, 255
RenderWorld
facing = R(80, 60)
RotateEntity light, 0, 90, 0
RenderWorld
sideways = R(80, 60)
CheckTrue "A light changes the brightness (" + facing + " against " + sideways + ")", facing <> sideways
AmbientLight 255, 255, 255
LightColor light, 0, 0, 0
RenderWorld
CheckTrue "AmbientLight lights everything (" + R(80, 60) + ")", R(80, 60) > 100
AmbientLight 0, 0, 0
RenderWorld
CheckTrue "Without any light it is dark (" + R(80, 60) + ")", R(80, 60) < 40
FreeEntity light
EntityFX cube, 1
EntityColor cube, 255, 0, 0

; Fog turns what is far into the fog color.
CameraFogMode camera, 1
CameraFogColor camera, 0, 0, 255
CameraFogRange camera, 1, 6
RenderWorld
CheckTrue "Fog adds blue (" + B(80, 60) + ")", B(80, 60) > 60
CheckTrue "Fog takes away red (" + R(80, 60) + ")", R(80, 60) < 250
CameraFogMode camera, 0
RenderWorld
Check "Without fog", B(80, 60), 0, 3

; Orders: what is in front is drawn over, whatever the distance.
back = CreateCube()
EntityFX back, 1
EntityColor back, 0, 0, 255
PositionEntity back, 0, 0, -3
RenderWorld
Check "A nearer cube covers", B(80, 60), 255, 3
EntityOrder back, 1
RenderWorld
Check "EntityOrder puts it behind", R(80, 60), 255, 3
EntityOrder back, 0
FreeEntity back

; Textures and painting
texture = CreateTexture(2, 2)
SetBuffer TextureBuffer(texture)
Color 0, 255, 0
Rect 0, 0, 2, 2, True
SetBuffer BackBuffer()
EntityColor cube, 255, 255, 255
EntityTexture cube, texture
RenderWorld
Check "EntityTexture", G(80, 60), 255, 6
Check "EntityTexture red", R(80, 60), 0, 6
EntityTexture cube, 0
; A brush replaces everything about how the entity looks, so it says that it is fullbright too.
brush = CreateBrush(0, 0, 255)
BrushFX brush, 1
PaintEntity cube, brush
RenderWorld
CheckTrue "PaintEntity (" + B(80, 60) + ")", B(80, 60) > 200
FreeBrush brush

; More layers of textures change what is there: twice the multiplication of the first texture and the second.
base_tex = CreateTexture(2, 2)
SetBuffer TextureBuffer(base_tex)
Color 100, 100, 100
Rect 0, 0, 2, 2, True
SetBuffer BackBuffer()
detail_tex = CreateTexture(2, 2)
SetBuffer TextureBuffer(detail_tex)
Color 128, 128, 128
Rect 0, 0, 2, 2, True
SetBuffer BackBuffer()
TextureBlend detail_tex, 5
layered = CreateCube()
EntityFX layered, 1
EntityTexture layered, base_tex
RenderWorld
Check "One layer", R(80, 60), 100, 6
EntityTexture layered, detail_tex, 0, 1
RenderWorld
Check "A second layer, multiplied twice", R(80, 60), 100 * 128 * 2 / 255, 8
TextureBlend detail_tex, 2
RenderWorld
Check "A second layer, multiplied", R(80, 60), 100 * 128 / 255, 8
FreeEntity layered
FreeTexture base_tex
FreeTexture detail_tex
HideEntity cube

; Copies and sprites show.
FreeEntity cube
sprite = CreateSprite()
EntityFX sprite, 1
EntityColor sprite, 255, 255, 0
ScaleSprite sprite, 1, 1
RenderWorld
Check "Sprite red", R(80, 60), 255, 6
Check "Sprite green", G(80, 60), 255, 6
ScaleSprite sprite, 0.3, 0.3
RenderWorld
Check "A small sprite", R(80, 60), 255, 6
Check "A small sprite leaves the edge", R(60, 60), 10, 3
FreeEntity sprite

; A model can have a solid surface and a see-through one, like a tree has a trunk and leaves. What is solid still hides
; what is behind it, even if the see-through part of the same model is drawn later.
mixed = CreateMesh()
solid = CreateSurface(mixed)
v0 = AddVertex(solid, -2, -2, 0) : v1 = AddVertex(solid, -2, 2, 0) : v2 = AddVertex(solid, 2, 2, 0) : v3 = AddVertex(solid, 2, -2, 0)
AddTriangle solid, v0, v1, v2
AddTriangle solid, v0, v2, v3
glass = CreateSurface(mixed)
g0 = AddVertex(glass, -2, -2, 2) : g1 = AddVertex(glass, -2, 2, 2) : g2 = AddVertex(glass, 2, 2, 2) : g3 = AddVertex(glass, 2, -2, 2)
AddTriangle glass, g0, g1, g2
AddTriangle glass, g0, g2, g3
solid_brush = CreateBrush(0, 0, 255)
BrushFX solid_brush, 1
PaintSurface solid, solid_brush
glass_brush = CreateBrush(255, 0, 0)
BrushFX glass_brush, 1
BrushAlpha glass_brush, 0.5
PaintSurface glass, glass_brush
EntityFX mixed, 1 + 16
RenderWorld
Check "A solid surface hides what is behind it: blue", B(80, 60), 255, 3
Check "A solid surface hides what is behind it: red", R(80, 60), 0, 3
FreeEntity mixed
FreeBrush solid_brush
FreeBrush glass_brush

; A part of the buffer
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0
ClsColor 0, 0, 0
Cls
CameraViewport camera, 0, 0, 80, 60
RenderWorld
Check "CameraViewport inside", R(40, 30), 255, 3
Check "CameraViewport outside is not drawn", R(120, 90), 0, 3
Check "CameraViewport outside is not cleared", B(120, 90), 0, 3
CameraViewport camera, 0, 0, 160, 120

; Range and zoom
CameraClsColor camera, 10, 20, 30
CameraRange camera, 1, 2
RenderWorld
Check "A cube beyond the range is not drawn", R(80, 60), 10, 3
CameraRange camera, 1, 1000
CameraZoom camera, 8
RenderWorld
Check "Zooming in fills the view", R(10, 10), 255, 3
CameraZoom camera, 1

; Only the edges
Wireframe True
RenderWorld
CheckTrue "Wireframe leaves the middle empty of faces", R(80, 60) = 10 Or R(80, 60) = 255
Wireframe False

; CaptureWorld remembers where things are, and RenderWorld with a tween draws them between there and where they are.
HideEntity cube
mover = CreateCube()
EntityFX mover, 1
EntityColor mover, 255, 0, 0
CaptureWorld
PositionEntity mover, 2, 0, 0
RenderWorld 1
Check "Tween 1 is where it is", R(112, 60), 255, 3
Check "Tween 1 leaves where it was", R(70, 60), 10, 3
RenderWorld 0
Check "Tween 0 is where it was", R(70, 60), 255, 3
Check "Tween 0 leaves where it is", R(112, 60), 10, 3
RenderWorld 0.5
Check "Tween half way", R(88, 60), 255, 3
Check "Tween half way leaves the left", R(70, 60), 10, 3
Check "Tween half way leaves the right", R(126, 60), 10, 3
RenderWorld
Check "RenderWorld without a tween is where it is", R(112, 60), 255, 3
FreeEntity mover

; HandleSprite moves where a sprite hangs from: the middle of it is 0, 0, and 1 is half of the sprite.
held = CreateSprite()
EntityFX held, 1
EntityColor held, 255, 255, 0
ScaleSprite held, 1, 1
RenderWorld
Check "A sprite is held in the middle", R(88, 60), 255, 6
Check "A sprite is held in the middle, left", R(72, 60), 255, 6
HandleSprite held, 1, 0
RenderWorld
Check "A sprite held at the right edge hangs to the left", R(56, 60), 255, 6
Check "A sprite held at the right edge leaves the right", R(88, 60), 10, 3
HandleSprite held, -1, 0
RenderWorld
Check "A sprite held at the left edge hangs to the right", R(104, 60), 255, 6
Check "A sprite held at the left edge leaves the left", R(72, 60), 10, 3
FreeEntity held

FreeEntity cube

; A quad that faces the camera, which covers the pixels from 48 to 112 across and 28 to 92 down. The pixels at 55, 35 and
; at 75, 45 are inside its first triangle.
Function Quad()
	quad = CreateMesh()
	quad_surface = CreateSurface(quad)
	v0 = AddVertex(quad_surface, -2, -2, 0) : v1 = AddVertex(quad_surface, -2, 2, 0) : v2 = AddVertex(quad_surface, 2, 2, 0) : v3 = AddVertex(quad_surface, 2, -2, 0)
	AddTriangle quad_surface, v0, v1, v2
	AddTriangle quad_surface, v0, v2, v3
	Return quad
End Function

; A texture that is freed while something is drawn with it, still draws.
CameraClsColor camera, 10, 20, 30
kept_cube = CreateCube()
EntityFX kept_cube, 1
kept_texture = CreateTexture(2, 2)
SetBuffer TextureBuffer(kept_texture)
Color 0, 255, 0
Rect 0, 0, 2, 2, True
SetBuffer BackBuffer()
EntityTexture kept_cube, kept_texture
kept_brush = CreateBrush()
BrushFX kept_brush, 1
BrushTexture kept_brush, kept_texture
kept_other = CreateCube()
PositionEntity kept_other, 0, 0, 0
HideEntity kept_other
FreeTexture kept_texture
RenderWorld
Check "A freed texture still draws on an entity: green", G(80, 60), 255, 6
Check "A freed texture still draws on an entity: red", R(80, 60), 0, 6
PaintEntity kept_other, kept_brush
HideEntity kept_cube
ShowEntity kept_other
RenderWorld
Check "A freed texture still draws with a brush: green", G(80, 60), 255, 6
Check "A freed texture still draws with a brush: red", R(80, 60), 0, 6
FreeEntity kept_cube
FreeEntity kept_other
FreeBrush kept_brush

; The colors of vertices count only with the vertex color flag.
colored = Quad()
colored_surface = GetSurface(colored, 1)
For i = 0 To 3
	VertexColor colored_surface, i, 255, 0, 0
Next
EntityFX colored, 1 + 16
EntityColor colored, 0, 0, 255
RenderWorld
Check "Without the flag the color of the vertices is not used: red", R(80, 60), 0, 6
Check "Without the flag the color of the vertices is not used: blue", B(80, 60), 255, 6
EntityFX colored, 1 + 2 + 16
EntityColor colored, 255, 255, 255
RenderWorld
Check "With the flag the color of the vertices is used: red", R(80, 60), 255, 6
Check "With the flag the color of the vertices is used: blue", B(80, 60), 0, 6
; A brush says it too.
EntityFX colored, 0
vertex_brush = CreateBrush()
BrushFX vertex_brush, 1 + 16
PaintMesh colored, vertex_brush
RenderWorld
Check "A brush without the flag: red", R(80, 60), 255, 6
Check "A brush without the flag does not use the vertices", G(80, 60), 255, 6
BrushFX vertex_brush, 1 + 2 + 16
PaintMesh colored, vertex_brush
RenderWorld
Check "A brush with the flag uses the vertices", G(80, 60), 0, 6
FreeBrush vertex_brush
FreeEntity colored

; Flat shading gives a triangle the shade of its first vertex, where smooth shading goes from one corner to the others.
shaded = Quad()
shaded_surface = GetSurface(shaded, 1)
VertexNormal shaded_surface, 0, 0, 0, -1
VertexNormal shaded_surface, 1, 0.8, 0, -0.6
VertexNormal shaded_surface, 2, -0.8, 0, -0.6
VertexNormal shaded_surface, 3, 0, 0, -1
AmbientLight 0, 0, 0
light = CreateLight()
LightColor light, 255, 255, 255
EntityFX shaded, 16
RenderWorld
smooth_near = R(55, 35)
smooth_far = R(75, 45)
CheckTrue "Smooth shading changes across a triangle (" + smooth_near + " and " + smooth_far + ")", Abs(smooth_near - smooth_far) > 8
EntityFX shaded, 4 + 16
RenderWorld
Check "Flat shading is the same across a triangle", R(75, 45), R(55, 35), 2
CheckTrue "Flat shading is lit (" + R(55, 35) + ")", R(55, 35) > 100
FreeEntity light
FreeEntity shaded
AmbientLight 255, 255, 255

; Fog does not touch what has no fog.
fogged = CreateCube()
EntityFX fogged, 1
EntityColor fogged, 255, 0, 0
CameraFogMode camera, 1
CameraFogColor camera, 0, 0, 255
CameraFogRange camera, 1, 6
RenderWorld
CheckTrue "Fog is on (" + B(80, 60) + ")", B(80, 60) > 60
EntityFX fogged, 1 + 8
RenderWorld
Check "Without fog: red", R(80, 60), 255, 3
Check "Without fog: blue", B(80, 60), 0, 3
vertex_brush = CreateBrush(255, 0, 0)
BrushFX vertex_brush, 1
PaintEntity fogged, vertex_brush
RenderWorld
CheckTrue "A brush without the no fog flag is fogged (" + B(80, 60) + ")", B(80, 60) > 60
BrushFX vertex_brush, 1 + 8
PaintEntity fogged, vertex_brush
RenderWorld
Check "A brush with the no fog flag: blue", B(80, 60), 0, 3
FreeBrush vertex_brush
CameraFogMode camera, 0
FreeEntity fogged

; The frames of a texture are drawn on separately and used separately.
frame_texture = CreateTexture(2, 2, 1, 2)
SetBuffer TextureBuffer(frame_texture, 0)
Color 255, 0, 0
Rect 0, 0, 2, 2, True
SetBuffer TextureBuffer(frame_texture, 1)
Color 0, 0, 255
Rect 0, 0, 2, 2, True
SetBuffer BackBuffer()
framed = CreateCube()
EntityFX framed, 1
EntityTexture framed, frame_texture, 0
RenderWorld
Check "The first frame of a texture: red", R(80, 60), 255, 6
Check "The first frame of a texture: blue", B(80, 60), 0, 6
EntityTexture framed, frame_texture, 1
RenderWorld
Check "The second frame of a texture: red", R(80, 60), 0, 6
Check "The second frame of a texture: blue", B(80, 60), 255, 6
FreeEntity framed
FreeTexture frame_texture

; Textures get color from the default filter, which is back after Graphics3D even if the filters were cleared. A picture
; without alpha that is asked for with only alpha is white where it is not see-through, unless the filter adds color.
file = WriteFile("suite_filter.bmp")
WriteByte file, 66 : WriteByte file, 77
WriteInt file, 70
WriteInt file, 0
WriteInt file, 54
WriteInt file, 40
WriteInt file, 2 : WriteInt file, 2
WriteShort file, 1 : WriteShort file, 24
WriteInt file, 0
WriteInt file, 16
WriteInt file, 2835 : WriteInt file, 2835
WriteInt file, 0 : WriteInt file, 0
For row = 1 To 2
	For column = 1 To 2
		WriteByte file, 0 : WriteByte file, 0 : WriteByte file, 255
	Next
	WriteShort file, 0
Next
CloseFile file

CameraClsColor camera, 0, 0, 0
Function FilterGreen()
	cube = CreateCube()
	EntityFX cube, 1
	texture = LoadTexture("suite_filter.bmp", 2)
	EntityTexture cube, texture
	RenderWorld
	green = G(80, 60)
	FreeEntity cube
	FreeTexture texture
	Return green
End Function
Check "The default filter keeps the color", FilterGreen(), 0, 6
ClearTextureFilters
CheckTrue "Without a filter the picture is white (" + FilterGreen() + ")", FilterGreen() > 40
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Check "Graphics3D brings the default filter back", FilterGreen(), 0, 6
DeleteFile "suite_filter.bmp"

EndGraphics
Done "blitz3d_pixels"
