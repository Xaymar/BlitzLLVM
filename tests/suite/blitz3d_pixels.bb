; What 3D puts on the screen, which needs a window and a GPU, so this is skipped without one. It looks at the pixel in
; the middle of the picture after RenderWorld, for what the commands that change the look of things do: EntityColor
; EntityAlpha EntityBlend EntityFX EntityOrder EntityTexture PaintEntity HideEntity ShowEntity CameraClsColor
; CameraClsMode CameraFogMode CameraFogColor CameraFogRange CameraViewport CameraRange CameraZoom AmbientLight
; LightColor Wireframe CopyEntity CreateSprite ScaleSprite EntityAutoFade.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

; The red, green and blue of a pixel, one at a time.
Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 10, 20, 30
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0

; Show draws, hide does not.
RenderWorld
Check "Cube red", R(80, 60), 255, 3
Check "Cube green", G(80, 60), 0, 3
Check "Clear color red", R(2, 2), 10, 3
Check "Clear color green", G(2, 2), 20, 3
Check "Clear color blue", B(2, 2), 30, 3
HideEntity cube
RenderWorld
Check "HideEntity", R(80, 60), 10, 3
ShowEntity cube
RenderWorld
Check "ShowEntity", R(80, 60), 255, 3

; CameraClsMode: without clearing, the old picture stays.
CameraClsMode camera, False, True
HideEntity cube
RenderWorld
Check "Without clearing the color stays", R(80, 60), 255, 3
CameraClsMode camera, True, True
RenderWorld
Check "Clearing again", R(80, 60), 10, 3
ShowEntity cube

; Colors
EntityColor cube, 0, 255, 0
RenderWorld
Check "EntityColor", G(80, 60), 255, 3
Check "EntityColor red", R(80, 60), 0, 3

; Alpha: half of the color and half of what is behind it.
EntityColor cube, 200, 200, 200
EntityAlpha cube, 0.5
RenderWorld
Check "EntityAlpha", R(80, 60), (200 + 10) / 2, 6
EntityAlpha cube, 0
RenderWorld
Check "EntityAlpha 0 shows nothing", R(80, 60), 10, 3
EntityAlpha cube, 1

; Adding makes it brighter, multiplying darker.
EntityColor cube, 100, 100, 100
EntityBlend cube, 3
RenderWorld
Check "EntityBlend add", R(80, 60), 100 + 10, 8
EntityBlend cube, 2
RenderWorld
CheckTrue "EntityBlend multiply (" + R(80, 60) + ")", R(80, 60) < 10
EntityBlend cube, 1

; Light makes things that are not fullbright. A cube lit from the front is brighter than one lit from the side.
EntityFX cube, 0
EntityColor cube, 255, 255, 255
AmbientLight 0, 0, 0
light = CreateLight()
RotateEntity light, 0, 0, 0
LightColor light, 255, 255, 255
RenderWorld
facing = R(80, 60)
RotateEntity light, 0, 90, 0
RenderWorld
sideways = R(80, 60)
CheckTrue "A light changes the brightness (" + facing + " against " + sideways + ")", facing <> sideways
AmbientLight 255, 255, 255
LightColor light, 0, 0, 0
RenderWorld
CheckTrue "AmbientLight lights everything (" + R(80, 60) + ")", R(80, 60) > 100
AmbientLight 0, 0, 0
RenderWorld
CheckTrue "Without any light it is dark (" + R(80, 60) + ")", R(80, 60) < 40
FreeEntity light
EntityFX cube, 1
EntityColor cube, 255, 0, 0

; Fog turns what is far into the fog color.
CameraFogMode camera, 1
CameraFogColor camera, 0, 0, 255
CameraFogRange camera, 1, 6
RenderWorld
CheckTrue "Fog adds blue (" + B(80, 60) + ")", B(80, 60) > 60
CheckTrue "Fog takes away red (" + R(80, 60) + ")", R(80, 60) < 250
CameraFogMode camera, 0
RenderWorld
Check "Without fog", B(80, 60), 0, 3

; Orders: what is in front is drawn over, whatever the distance.
back = CreateCube()
EntityFX back, 1
EntityColor back, 0, 0, 255
PositionEntity back, 0, 0, -3
RenderWorld
Check "A nearer cube covers", B(80, 60), 255, 3
EntityOrder back, 1
RenderWorld
Check "EntityOrder puts it behind", R(80, 60), 255, 3
EntityOrder back, 0
FreeEntity back

; Textures and painting
texture = CreateTexture(2, 2)
SetBuffer TextureBuffer(texture)
Color 0, 255, 0
Rect 0, 0, 2, 2, True
SetBuffer BackBuffer()
EntityColor cube, 255, 255, 255
EntityTexture cube, texture
RenderWorld
Check "EntityTexture", G(80, 60), 255, 6
Check "EntityTexture red", R(80, 60), 0, 6
EntityTexture cube, 0
; A brush replaces everything about how the entity looks, so it says that it is fullbright too.
brush = CreateBrush(0, 0, 255)
BrushFX brush, 1
PaintEntity cube, brush
RenderWorld
CheckTrue "PaintEntity (" + B(80, 60) + ")", B(80, 60) > 200
FreeBrush brush

; Copies and sprites show.
FreeEntity cube
sprite = CreateSprite()
EntityFX sprite, 1
EntityColor sprite, 255, 255, 0
ScaleSprite sprite, 1, 1
RenderWorld
Check "Sprite red", R(80, 60), 255, 6
Check "Sprite green", G(80, 60), 255, 6
ScaleSprite sprite, 0.3, 0.3
RenderWorld
Check "A small sprite", R(80, 60), 255, 6
Check "A small sprite leaves the edge", R(60, 60), 10, 3
FreeEntity sprite

; A model can have a solid surface and a see-through one, like a tree has a trunk and leaves. What is solid still hides
; what is behind it, even if the see-through part of the same model is drawn later.
mixed = CreateMesh()
solid = CreateSurface(mixed)
v0 = AddVertex(solid, -2, -2, 0) : v1 = AddVertex(solid, -2, 2, 0) : v2 = AddVertex(solid, 2, 2, 0) : v3 = AddVertex(solid, 2, -2, 0)
AddTriangle solid, v0, v1, v2
AddTriangle solid, v0, v2, v3
glass = CreateSurface(mixed)
g0 = AddVertex(glass, -2, -2, 2) : g1 = AddVertex(glass, -2, 2, 2) : g2 = AddVertex(glass, 2, 2, 2) : g3 = AddVertex(glass, 2, -2, 2)
AddTriangle glass, g0, g1, g2
AddTriangle glass, g0, g2, g3
solid_brush = CreateBrush(0, 0, 255)
BrushFX solid_brush, 1
PaintSurface solid, solid_brush
glass_brush = CreateBrush(255, 0, 0)
BrushFX glass_brush, 1
BrushAlpha glass_brush, 0.5
PaintSurface glass, glass_brush
EntityFX mixed, 1 + 16
RenderWorld
Check "A solid surface hides what is behind it: blue", B(80, 60), 255, 3
Check "A solid surface hides what is behind it: red", R(80, 60), 0, 3
FreeEntity mixed
FreeBrush solid_brush
FreeBrush glass_brush

; A part of the buffer
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0
ClsColor 0, 0, 0
Cls
CameraViewport camera, 0, 0, 80, 60
RenderWorld
Check "CameraViewport inside", R(40, 30), 255, 3
Check "CameraViewport outside is not drawn", R(120, 90), 0, 3
Check "CameraViewport outside is not cleared", B(120, 90), 0, 3
CameraViewport camera, 0, 0, 160, 120

; Range and zoom
CameraClsColor camera, 10, 20, 30
CameraRange camera, 1, 2
RenderWorld
Check "A cube beyond the range is not drawn", R(80, 60), 10, 3
CameraRange camera, 1, 1000
CameraZoom camera, 8
RenderWorld
Check "Zooming in fills the view", R(10, 10), 255, 3
CameraZoom camera, 1

; Only the edges
Wireframe True
RenderWorld
CheckTrue "Wireframe leaves the middle empty of faces", R(80, 60) = 10 Or R(80, 60) = 255
Wireframe False

FreeEntity cube
EndGraphics
Done "blitz3d_pixels"
