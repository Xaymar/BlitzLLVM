; The depths below 24 of Graphics3D, which need a window and a GPU, so this is skipped without one: 16 (R5G6B5), 15 (A1R5G5B5), 12
; (R4G4B4A4) keep as many bits per channel as their name says, and 8 shows and reads the nearest color of a palette of 256 colors, which
; GraphicsPallet sets from a picture of 16 by 16 pixels.
; GraphicsDepth GraphicsPallet Graphics3D ReadPixel WritePixel Cls Rect CopyRect Dither SaveBuffer.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_depth_low_pixels: skipped, there is no window."
	End
EndIf

Function Red(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function Green(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function Blue(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

; The value that a channel of that many bits shows for the 8 bit number, as 8 bits again: the nearest of 2^bits values.
Function Snap(value, bits)
	Local top = (1 Shl bits) - 1
	Return ((value * top + 127) / 255) * 255 / top
End Function

; What one depth draws, reads and writes: bits per channel are red, green and blue, and the colors are within a step of what was asked.
Function TryDepth(depth, rbits, gbits, bbits)
	Local name$ = "Depth " + depth + ": "
	Graphics3D 64, 64, depth, 2
	SetBuffer BackBuffer()
	Check name + "GraphicsDepth", GraphicsDepth(), depth
	Local tr = 255 / ((1 Shl rbits) - 1), tg = 255 / ((1 Shl gbits) - 1), tb = 255 / ((1 Shl bbits) - 1)

	ClsColor 12, 200, 99
	Cls
	Check name + "Cls red", Red(5, 5), Snap(12, rbits), 1
	Check name + "Cls green", Green(5, 5), Snap(200, gbits), 1
	Check name + "Cls blue", Blue(5, 5), Snap(99, bbits), 1
	Check name + "Cls is within a step, red", Red(5, 5), 12, tr
	Check name + "Cls is within a step, green", Green(5, 5), 200, tg
	Check name + "Cls is within a step, blue", Blue(5, 5), 99, tb

	; Colors with all bits on or off are exact, and the alpha of ReadPixel is 255 whatever the buffer stores.
	Color 255, 0, 255
	Rect 10, 10, 20, 20, True
	Check name + "Rect red", Red(15, 15), 255, 0
	Check name + "Rect green", Green(15, 15), 0, 0
	Check name + "Rect blue", Blue(15, 15), 255, 0
	If depth <> 12 And depth <> 15 Then Check name + "Alpha", (ReadPixel(15, 15) Shr 24) And 255, 255, 0

	; WritePixel and ReadPixel give the nearest value the buffer can hold.
	WritePixel 40, 40, $FF000000 Or ($40 Shl 16) Or ($80 Shl 8) Or $C0
	Check name + "WritePixel red", Red(40, 40), Snap($40, rbits), 1
	Check name + "WritePixel green", Green(40, 40), Snap($80, gbits), 1
	Check name + "WritePixel blue", Blue(40, 40), Snap($C0, bbits), 1
	LockBuffer BackBuffer()
	Check name + "Locked red", (ReadPixelFast(40, 40) Shr 16) And 255, Snap($40, rbits), 1
	Check name + "LockedFormat", LockedFormat(), 4
	UnlockBuffer BackBuffer()

	; A copy to the buffer of a texture and back goes through RGBA8 and keeps what the buffer had.
	tex = CreateTexture(32, 32, 4096)
	CopyRect 10, 10, 16, 16, 0, 0, BackBuffer(), TextureBuffer(tex)
	CopyRect 0, 0, 16, 16, 30, 30, TextureBuffer(tex), BackBuffer()
	Check name + "CopyRect red", Red(35, 35), 255, 0
	Check name + "CopyRect blue", Blue(35, 35), 255, 0
	FreeTexture tex

	; 3D: a cube in the middle with its own color, also with Dither on, which makes noise of a step of this depth around the color of a
	; lit surface, and leaves colors that the buffer shows exactly.
	camera = CreateCamera()
	PositionEntity camera, 0, 0, -5
	CameraClsColor camera, 10, 20, 30
	cube = CreateCube()
	EntityFX cube, 1
	EntityColor cube, 255, 0, 0
	RenderWorld
	Check name + "Cube red", Red(32, 32), 255, 0
	Check name + "Cube green", Green(32, 32), 0, 0
	Dither True
	RenderWorld
	Check name + "Dithered cube red", Red(32, 32), 255, 0
	Check name + "Dithered cube green", Green(32, 32), 0, 0
	EntityColor cube, 128, 128, 128
	; A gray of 128 is between two steps in every depth, so Dither shows both neighbours in a pattern, and nothing else.
	Local seen_low = 0, seen_high = 0, x, y, v
	For frame = 1 To 8
		RenderWorld
		Flip 2 ; The noise moves with every picture that is shown.
		For y = 28 To 36 Step 2
			For x = 28 To 36 Step 2
				v = Red(x, y)
				If v < 128 Then seen_low = seen_low + 1
				If v > 128 Then seen_high = seen_high + 1
				CheckTrue name + "Dither stays near 128", Abs(v - 128) <= (tr + 1)
			Next
		Next
	Next
	CheckTrue name + "Dither makes both neighbours", seen_low > 0 And seen_high > 0
	Dither False
	FreeEntity cube
	FreeEntity camera
	ClearWorld
End Function

TryDepth 16, 5, 6, 5
TryDepth 15, 5, 5, 5
TryDepth 12, 4, 4, 4

; Depth 8: the default palette has all colors of 3 bits red, 3 bits green and 2 bits blue, in the order of the bits RRRGGGBB.
Graphics3D 64, 64, 8, 2
SetBuffer BackBuffer()
Check "Depth 8: GraphicsDepth", GraphicsDepth(), 8
ClsColor 12, 200, 99
Cls
Check "Depth 8: red goes to 0", Red(5, 5), 0, 0
Check "Depth 8: green goes to 182", Green(5, 5), 182, 0
Check "Depth 8: blue goes to 85", Blue(5, 5), 85, 0
Color 255, 255, 255
Rect 10, 10, 8, 8, True
Check "Depth 8: white is in the palette", Red(12, 12), 255, 0
Check "Depth 8: white blue", Blue(12, 12), 255, 0
WritePixel 40, 40, $FF000000 Or (230 Shl 16) Or (10 Shl 8) Or 190
Check "Depth 8: WritePixel red", Red(40, 40), 219, 0
Check "Depth 8: WritePixel green", Green(40, 40), 0, 0
Check "Depth 8: WritePixel blue", Blue(40, 40), 170, 0

; The shown picture has only colors of the palette, with and without Dither.
Dither False
Flip 2
Dither True
Flip 2
Dither False

; A palette from a picture: the pixel at x,y is the color y * 16 + x. Here a ramp of red.
Graphics 16, 16, 32, 2
SetBuffer BackBuffer()
For i = 0 To 255
	Color i, 0, 0
	Plot i Mod 16, i / 16
Next
SaveBuffer BackBuffer(), "suite_palette_ramp.bmp"
Graphics3D 64, 64, 8, 2
SetBuffer BackBuffer()
GraphicsPallet "suite_palette_ramp.bmp"
ClsColor 200, 100, 50
Cls
Check "Palette: red", Red(5, 5), 200, 0
Check "Palette: green", Green(5, 5), 0, 0
Check "Palette: blue", Blue(5, 5), 0, 0
ClsColor 250, 250, 250
Cls
Check "Palette: the nearest red to a bright gray", Red(5, 5), 250, 0

; A 3D scene is drawn in full color and shown with the palette.
camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 0, 0, 0
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 100, 40, 40
RenderWorld
Check "Palette: 3D", Red(32, 32), 100, 0
Check "Palette: 3D keeps no green", Green(32, 32), 0, 0
ClearWorld

; An empty name brings the default back.
GraphicsPallet ""
ClsColor 12, 200, 99
Cls
Check "Default again: green", Green(5, 5), 182, 0
DeleteFile "suite_palette_ramp.bmp"
Done "graphics_depth_low_pixels"
