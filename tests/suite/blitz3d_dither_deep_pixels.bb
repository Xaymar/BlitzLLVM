; Dither is for the last step, the one that turns what was made into 8 bits. A buffer of 10 bits (Graphics3D depth 30) is not
; that step: what the shader makes (lighting, textures, fog) has to land in it as it is, with no noise of 8 bits added, so
; a fog gradient is the same with Dither 1 as without. ReadPixel gives the buffer as it is, the red channel in the low 10 bits.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_dither_deep_pixels: skipped, there is no window."
	End
EndIf

Const W = 128, H = 96
Graphics3D W, H, 30, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
PositionEntity camera, 0, 2, -3
RotateEntity camera, 25, 0, 0
CameraClsColor camera, 0, 0, 0
CameraFogMode camera, 1
CameraFogRange camera, 1, 40
CameraFogColor camera, 200, 60, 20
CameraRange camera, 0.1, 100

Global ground = CreatePlane()
EntityFX ground, 1
EntityColor ground, 40, 40, 40

Dim off(H), plain(H)

Function Column(level)
	Dither level
	RenderWorld
	For y = 0 To H - 1
		off(y) = ReadPixel(W / 2, y, BackBuffer())
	Next
End Function

Function Differing(level)
	Local y, n = 0
	Column 0
	For y = 0 To H - 1 : plain(y) = off(y) : Next
	Column level
	For y = 0 To H - 1
		If plain(y) <> off(y) Then n = n + 1
	Next
	Return n
End Function

Check "Dither 1 adds no noise to a buffer of 10 bits", Differing(1), 0
Check "Dither 2 adds no noise to a buffer of 10 bits", Differing(2), 0
Done "blitz3d_dither_deep_pixels"
