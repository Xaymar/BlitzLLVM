; Alpha and mask of a CreateTexture texture that the program draws on. Alpha that is written with WritePixel is used as it
; is (the original does the same, see /mnt/project-files/texture-alpha), and 2D drawing leaves a texture opaque. Black that is
; drawn on a masked texture is cut out: the original only masks pictures it loads, we do it on purpose.
; Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_texture_alpha_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global camera = CreateCamera()
PositionEntity camera, 0, 0, -6
CameraClsColor camera, 0, 0, 200
CameraRange camera, 0.1, 100
AmbientLight 255, 255, 255

; A quad in front of the camera that shows the texture, at x = 0.
Function Show(tex)
	q = CreateCube()
	ScaleEntity q, 1, 1, 0.01
	EntityFX q, 1
	EntityTexture q, tex
	RenderWorld
	FreeEntity q
End Function

Function Blue(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function
Function Red(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

; Flag 3 and flag 2: white with alpha 255 on the left to 0 on the right.
For flags = 2 To 3
	tex = CreateTexture(64, 16, flags + 4096)
	SetBuffer TextureBuffer(tex)
	For x = 0 To 63
		For y = 0 To 15
			WritePixel x, y, ((255 - x * 4) Shl 24) Or $FFFFFF
		Next
	Next
	SetBuffer BackBuffer()
	Show tex
	Check "Alpha flag " + flags + ": opaque side is white", Red(69, 60), 255, 40
	Check "Alpha flag " + flags + ": transparent side shows the background", Blue(91, 60), 200, 40
	Check "Alpha flag " + flags + ": the middle is mixed", Red(80, 60), 128, 60
	FreeTexture tex
Next

; 2D drawing leaves the texture opaque, also black.
tex = CreateTexture(16, 16, 3 + 4096)
SetBuffer TextureBuffer(tex)
Color 0, 0, 0
Rect 0, 0, 16, 16, True
SetBuffer BackBuffer()
Show tex
Check "Drawn black with alpha is opaque: red", Red(80, 60), 0, 4
Check "Drawn black with alpha is opaque: blue", Blue(80, 60), 0, 4
FreeTexture tex

; Masked: drawn black is cut out, drawn color stays.
tex = CreateTexture(16, 16, 4 + 4096)
SetBuffer TextureBuffer(tex)
Color 0, 0, 0
Rect 0, 0, 16, 16, True
Color 255, 0, 0
Rect 8, 0, 8, 16, True
SetBuffer BackBuffer()
Show tex
Check "Masked: drawn black is cut out", Blue(70, 60), 200, 4
Check "Masked: drawn color stays", Red(90, 60), 255, 4
FreeTexture tex

End
