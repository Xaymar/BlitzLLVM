; Writing DDS files with SaveBuffer, SaveImage and SaveTexture, which needs a GPU: the formats and mip maps picked in the settings,
; the header of the file, and that the files load again (the loader reads DDS, so this is a round trip).
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_save_dds_pixels: skipped, there is no window."
	End
EndIf

SeedRnd MilliSecs()
unique$ = "suite_dds_" + Rand(1, 1000000000) + "_"

Const W = 40, H = 24

; A picture with a gradient, flat shapes and sharp edges.
Global img = CreateImage(W, H)
SetBuffer ImageBuffer(img)
For y = 0 To H - 1
	Color y * 10, 255 - y * 10, 60
	Line 0, y, W - 1, y
Next
Color 255, 255, 0
Rect 4, 3, 14, 10, 1
Color 0, 0, 255
Oval 20, 6, 16, 16, 1

Function FileBank(name$)
	size = FileSize(name)
	bank = CreateBank(size)
	f = ReadFile(name)
	If f <> 0 Then
		ReadBytes bank, f, 0, size
		CloseFile f
	EndIf
	Return bank
End Function

; A 32 bit number of the header of a DDS file.
Function Header(name$, offset)
	bank = FileBank(name)
	value = PeekInt(bank, offset)
	FreeBank bank
	Return value
End Function

; The average difference of a color channel between the picture and the one in the file.
Function Error#(name$)
	copy = LoadImage(name)
	If copy = 0 Then Return 1000
	total# = 0
	count = 0
	For y = 0 To H - 1
		For x = 0 To W - 1
			a = ReadPixel(x, y, ImageBuffer(copy))
			b = ReadPixel(x, y, ImageBuffer(img))
			total = total + Abs(((a Shr 16) And 255) - ((b Shr 16) And 255)) + Abs(((a Shr 8) And 255) - ((b Shr 8) And 255)) + Abs((a And 255) - (b And 255))
			count = count + 3
		Next
	Next
	FreeImage copy
	Return total / count
End Function

Check "SaveImage as DDS", SaveImage(img, unique + "default.dds"), 1
Check "The magic of a DDS file", Header(unique + "default.dds", 0), $20534444
Check "The header size", Header(unique + "default.dds", 4), 124
Check "The height", Header(unique + "default.dds", 12), H
Check "The width", Header(unique + "default.dds", 16), W
Check "The default is RGBA8: 128 bytes of header and the pixels", FileSize(unique + "default.dds"), 128 + W * H * 4
Check "The default has no loss", Error(unique + "default.dds"), 0

; The uncompressed formats.
Check "bgra8", SaveImage(img, unique + "bgra.dds", 0, "format=bgra8"), 1
Check "bgra8 size", FileSize(unique + "bgra.dds"), 128 + W * H * 4
Check "bgra8 has no loss", Error(unique + "bgra.dds"), 0
Check "bgr8", SaveImage(img, unique + "bgr.dds", 0, "format=bgr8"), 1
Check "bgr8 size", FileSize(unique + "bgr.dds"), 128 + W * H * 3
Check "bgr8 has no loss", Error(unique + "bgr.dds"), 0
Check "rgb565", SaveImage(img, unique + "565.dds", 0, "format=rgb565"), 1
Check "rgb565 size", FileSize(unique + "565.dds"), 128 + W * H * 2
Check "rgb565 loses at most a little", Error(unique + "565.dds"), 2, 2
Check "r8", SaveImage(img, unique + "r8.dds", 0, "format=r8"), 1
Check "r8 size", FileSize(unique + "r8.dds"), 128 + W * H
Check "rg8", SaveImage(img, unique + "rg8.dds", 0, "format=rg8"), 1
Check "rg8 has the DX10 header", FileSize(unique + "rg8.dds"), 148 + W * H * 2

; The block formats: the sizes are exact, and the picture comes back close.
Check "bc1", SaveImage(img, unique + "bc1.dds", 0, "format=bc1"), 1
Check "bc1 size", FileSize(unique + "bc1.dds"), 128 + (W / 4) * (H / 4) * 8
Check "bc1 picture", Error(unique + "bc1.dds"), 6, 6
Check "bc2", SaveImage(img, unique + "bc2.dds", 0, "format=bc2"), 1
Check "bc2 size", FileSize(unique + "bc2.dds"), 128 + (W / 4) * (H / 4) * 16
Check "bc2 picture", Error(unique + "bc2.dds"), 6, 6
Check "bc3", SaveImage(img, unique + "bc3.dds", 0, "format=BC3"), 1
Check "bc3 size", FileSize(unique + "bc3.dds"), 128 + (W / 4) * (H / 4) * 16
Check "bc3 picture", Error(unique + "bc3.dds"), 6, 6
Check "bc4", SaveImage(img, unique + "bc4.dds", 0, "format=bc4"), 1
Check "bc4 size", FileSize(unique + "bc4.dds"), 128 + (W / 4) * (H / 4) * 8
Check "bc5", SaveImage(img, unique + "bc5.dds", 0, "format=bc5"), 1
Check "bc5 size", FileSize(unique + "bc5.dds"), 128 + (W / 4) * (H / 4) * 16
Check "bc7", SaveImage(img, unique + "bc7.dds", 0, "format=bc7"), 1
Check "bc7 size with the DX10 header", FileSize(unique + "bc7.dds"), 148 + (W / 4) * (H / 4) * 16
Check "bc7 picture", Error(unique + "bc7.dds"), 6, 6
Check "dxt5 is bc3", Header(unique + "bc3.dds", 84), Asc("D") + Asc("X") * 256 + Asc("T") * 65536 + Asc("5") * 16777216

; A size that is not a multiple of 4 is padded to whole blocks.
small = CreateImage(5, 3)
Check "A 5x3 bc1", SaveImage(small, unique + "small.dds", 0, "format=bc1"), 1
Check "A 5x3 bc1 size", FileSize(unique + "small.dds"), 128 + 2 * 1 * 8

; Mip maps: a chain down to 1x1, or as many as asked.
Check "mipmaps", SaveImage(img, unique + "mips.dds", 0, "mipmaps=1"), 1
Check "mip count of 40x24", Header(unique + "mips.dds", 28), 6
; 40x24 + 20x12 + 10x6 + 5x3 + 2x1 + 1x1 pixels of 4 bytes.
Check "mip chain size", FileSize(unique + "mips.dds"), 128 + (960 + 240 + 60 + 15 + 2 + 1) * 4
Check "levels=3", SaveImage(img, unique + "l3.dds", 0, "levels=3"), 1
Check "levels=3 count", Header(unique + "l3.dds", 28), 3
Check "levels=3 size", FileSize(unique + "l3.dds"), 128 + (960 + 240 + 60) * 4
Check "levels above the possible ones", SaveImage(img, unique + "l99.dds", 0, "levels=99"), 1
Check "levels above the possible ones are cut", Header(unique + "l99.dds", 28), 6
Check "No mip maps by default", Header(unique + "default.dds", 28), 0
Check "bc1 mip chain", SaveImage(img, unique + "bc1m.dds", 0, "format=bc1, mipmaps"), 1
; The levels 40x24, 20x12, 10x6, 5x3, 2x1 and 1x1 are 10x6, 5x3, 3x2, 2x1, 1x1 and 1x1 blocks.
Check "bc1 mip chain size", FileSize(unique + "bc1m.dds"), 128 + (10 * 6 + 5 * 3 + 3 * 2 + 2 * 1 + 1 + 1) * 8
Check "The first level of the chain loads", Error(unique + "mips.dds"), 0
Check "A bc1 chain loads", Error(unique + "bc1m.dds"), 6, 6

; sRGB gives a DX10 header with the sRGB format (28 -> 29).
Check "srgb", SaveImage(img, unique + "srgb.dds", 0, "srgb=1"), 1
Check "srgb has the DX10 header", FileSize(unique + "srgb.dds"), 148 + W * H * 4
Check "srgb format", Header(unique + "srgb.dds", 128), 29
Check "srgb bc1 format", Header(unique + "bc1.dds", 84), Asc("D") + Asc("X") * 256 + Asc("T") * 65536 + Asc("1") * 16777216
SaveImage img, unique + "srgb1.dds", 0, "srgb, format=bc1"
Check "srgb bc1 DX10 format", Header(unique + "srgb1.dds", 128), 72
Check "srgb picture loads", Error(unique + "srgb.dds"), 0

; Bad settings are reported and ignored: the file is still written as the default.
Check "Unknown format", SaveImage(img, unique + "bad.dds", 0, "format=nothing"), 1
Check "Unknown format falls back to RGBA8", FileSize(unique + "bad.dds"), 128 + W * H * 4

; SaveBuffer and SaveTexture.
Check "SaveBuffer as DDS", SaveBuffer(ImageBuffer(img), unique + "buffer.dds", "format=bc3"), 1
Check "SaveBuffer bc3 size", FileSize(unique + "buffer.dds"), 128 + (W / 4) * (H / 4) * 16
tex = CreateTexture(W, H)
CopyRect 0, 0, W, H, 0, 0, ImageBuffer(img), TextureBuffer(tex)
Check "SaveTexture as DDS", SaveTexture(tex, unique + "texture.dds", 0, "format=bgra8,mipmaps=1"), 1
Check "SaveTexture mip count", Header(unique + "texture.dds", 28), 6
CheckTrue "SaveTexture loads as a texture", LoadTexture(unique + "texture.dds") <> 0
CheckTrue "A bc7 file loads as a texture", LoadTexture(unique + "bc7.dds") <> 0

FreeImage img
FreeImage small
FreeTexture tex
dir = ReadDir(".")
Repeat
	file$ = NextFile$(dir)
	If file = "" Then Exit
	If Left(file, Len(unique)) = unique Then DeleteFile file
Forever
CloseDir dir

Done "graphics_save_dds_pixels"
