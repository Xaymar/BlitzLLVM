; A Field can have a default value (Field x% = 5). The original Blitz3D accepts it, but never runs it, so New still sets the field to 0,
; 0.0, "" or Null. BlitzLLVM does the same (and warns with field-default-ignored).
Type Thing
	Field count% = 5
	Field speed# = 2.5, name$ = "named"
	Field plain%, other.Thing = Null
	Field list[3], after% = 1 + 2 * 3
End Type

Global failures = 0

Function Check(name$, ok)
	If Not ok Then
		failures = failures + 1
		Print "FAIL: " + name$
	EndIf
End Function

Local t.Thing = New Thing
Check("int field", t\count = 0)
Check("float field", t\speed = 0.0)
Check("string field", t\name = "")
Check("plain field", t\plain = 0)
Check("object field", t\other = Null)
Check("field after array", t\after = 0)
t\count = 7
Check("assigned", t\count = 7)

If failures = 0 Then Print "ok"
