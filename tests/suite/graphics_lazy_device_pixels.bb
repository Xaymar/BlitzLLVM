; The graphics device can be made before there is a window of Graphics, picked with a hidden window, so that programs that
; open their own windows first need no window of Graphics. BLITZLLVM_TEST_LAZY_DEVICE makes Graphics do that: make the device,
; show a color in a window of its own, close it, and then open the window of Graphics on that device and write what happened.
; This needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_lazy_device_pixels: skipped, there is no window."
	End
EndIf

SetEnv "BLITZLLVM_TEST_LAZY_DEVICE", "lazy_device.tmp"
Graphics 320, 240, 32, 2
AutoSuspend False ; Other windows of tests that run at the same time must not stop this one.

f = ReadFile("lazy_device.tmp")
If f = 0 Then RuntimeError "The result was not written."
made = Int(ReadLine$(f))
opened = Int(ReadLine$(f))
shown = Int(ReadLine$(f))
kept = Int(ReadLine$(f))
CloseFile f
DeleteFile "lazy_device.tmp"

Check "Device made without a window", made, 1
Check "Window of its own opened on it", opened, 1
Check "Color shown in it", shown, 1
Check "Graphics kept the device", kept, 1

; The window of Graphics draws and shows with the device from before it.
Cls
Color 255, 0, 0
Rect 10, 10, 20, 20
Check "Drawn with the device", ReadPixel(15, 15) And $FFFFFF, $FF0000
Flip
CheckTrue "Graphics is there", GraphicsWidth() = 320

; Graphics with another depth makes the device again, for that depth: the one from before the window is not kept, and the window draws all the same.
SetEnv "BLITZLLVM_TEST_LAZY_DEVICE", "lazy_device2.tmp"
Graphics 320, 240, 64, 2
AutoSuspend False
f = ReadFile("lazy_device2.tmp")
If f = 0 Then RuntimeError "The second result was not written."
made = Int(ReadLine$(f))
opened = Int(ReadLine$(f))
shown = Int(ReadLine$(f))
kept = Int(ReadLine$(f))
CloseFile f
DeleteFile "lazy_device2.tmp"
Check "Device made again without a window", made, 1
Check "Color shown in a window of its own again", shown, 1
If GraphicsDepth() = 64 Then
	Check "A device for a depth of 32 is not kept for 64", kept, 0
Else
	Check "The device is kept where 64 is not to be had", kept, 1
EndIf
Cls
Color 0, 255, 0
Rect 10, 10, 20, 20
Check "Drawn after the depth changed", ReadPixel(15, 15) And $FFFFFF, $00FF00
