; SetSpriteSoftEdge: a see-through sprite fades out as it gets close to a solid wall behind it. The wall is black and 10 units
; from the camera, the sprites are white with an alpha of 0.9 and look at the camera, so the red value in the middle of the picture
; is 255 times the alpha that is left of the sprite.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_sprite_soft_edge_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 64, 64, 32, 2
SetBuffer BackBuffer()
camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100
wall = CreateCube()
ScaleEntity wall, 30, 30, 1
PositionEntity wall, 0, 0, 11 ; The front is at z = 10.
EntityColor wall, 0, 0, 0
EntityFX wall, 1

sprite = CreateSprite()
ScaleSprite sprite, 3, 3
EntityColor sprite, 255, 255, 255
EntityAlpha sprite, 0.9

Function Centre()
	RenderWorld
	Return ReadPixel(32, 32, BackBuffer()) And 255
End Function

PositionEntity sprite, 0, 0, 9.5
Check "Without a soft edge the sprite is as it is, close to the wall", Centre(), 230, 4

SetSpriteSoftEdge sprite, 1
Check "Half the distance to the wall is half the alpha", Centre(), 115, 6
PositionEntity sprite, 0, 0, 9.9
Check "Very close to the wall it is almost gone", Centre(), 23, 6
PositionEntity sprite, 0, 0, 8
Check "Further away than the distance it is not changed", Centre(), 230, 4
PositionEntity sprite, 0, 0, 9
Check "Exactly the distance away it is not changed either", Centre(), 230, 4

SetSpriteSoftEdge sprite, 4
PositionEntity sprite, 0, 0, 8
Check "A longer distance fades it more", Centre(), 115, 6

SetSpriteSoftEdge sprite, 0
Check "0 turns it off", Centre(), 230, 4

; With an orthographic camera depth is linear, which has to come out the same.
CameraProjMode camera, 2
CameraZoom camera, 0.2
SetSpriteSoftEdge sprite, 1
PositionEntity sprite, 0, 0, 9.5
Check "An orthographic camera fades the same way", Centre(), 115, 6

Done "blitz3d_sprite_soft_edge_pixels"
End
