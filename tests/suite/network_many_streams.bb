; Connections keep working while the program has more than 1024 files and streams open. The number of a stream is the number of a
; file descriptor, and waiting for data with select() writes outside of the stack when that number is 1024 or higher.
Include "check.bb"

; Use up the low numbers of file descriptors, as a server that serves a lot of clients does.
Dim files(1199)
used = 0
For i = 0 To 1199
	files(i) = ReadFile("check.bb")
	If files(i) = 0 Then Exit
	used = used + 1
Next

TCPTimeouts 1000, 1000
port = 40732
server = CreateTCPServer(port)
CheckTrue "CreateTCPServer", server <> 0
client = OpenTCPStream("127.0.0.1", port)
CheckTrue "OpenTCPStream", client <> 0
accepted = 0
For i = 1 To 50
	accepted = AcceptTCPStream(server)
	If accepted <> 0 Then Exit
	Delay 20
Next
CheckTrue "AcceptTCPStream", accepted <> 0

WriteInt client, 4711
Check "ReadInt", ReadInt(accepted), 4711
Check "Nothing to accept", AcceptTCPStream(server), 0

CloseTCPStream client
CloseTCPStream accepted
CloseTCPServer server
For i = 0 To used - 1
	CloseFile files(i)
Next
Done "network_many_streams"
