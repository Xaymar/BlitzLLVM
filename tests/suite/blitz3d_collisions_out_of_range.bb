; Collisions with a type outside 0 to 999 or a method outside 1 to 3. The original takes them without an error: such a rule
; never matches anything, and does not change the rules that do.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Const T_PLAYER = 1, T_GROUND = 2

ground = CreateCube()
ScaleEntity ground, 10, 1, 10
PositionEntity ground, 0, -1, 0
EntityType ground, T_GROUND
EntityPickMode ground, 2

player = CreatePivot()
EntityType player, T_PLAYER
EntityRadius player, 1

; None of these may stop the program.
Collisions 5000, T_GROUND, 2, 2
Collisions T_PLAYER, 5000, 2, 2
Collisions -1, T_GROUND, 2, 2
Collisions T_PLAYER, T_GROUND, 9, 2
Collisions T_PLAYER, T_GROUND, 0, 2
Check "Accepted without a runtime error", 1, 1, 0

PositionEntity player, 0, 5, 0
ResetEntity player
For i = 1 To 40
	TranslateEntity player, 0, -0.3, 0
	UpdateWorld
Next
Check "A bad method never hits", EntityCollided(player, T_GROUND), 0

; A good rule for another pair still works next to the bad ones.
ClearCollisions
Collisions 5000, T_GROUND, 2, 2
Collisions T_PLAYER, T_GROUND, 2, 2
PositionEntity player, 0, 5, 0
ResetEntity player
For i = 1 To 40
	TranslateEntity player, 0, -0.3, 0
	UpdateWorld
Next
Check "A good rule works next to a bad one", EntityCollided(player, T_GROUND), ground
