; this is skipped without one: the depth buffer is reversed (1 at the near plane, 0 at the far plane) and a float, so the
; precision is even over the whole range of the camera. Two surfaces that are 0.05 apart, 900 away from a camera with the
; range 0.1 to 1000, fail to sort with the usual depth buffer (it can only tell about 0.5 apart there) and must not here.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_depth_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 1000

; A flat quad facing the camera, half a unit across per unit of distance so that it fills the middle of the view.
Function Quad(distance#, red, green, blue)
	m = CreateMesh()
	s = CreateSurface(m)
	AddVertex s, -1, -1, 0
	AddVertex s, -1, 1, 0
	AddVertex s, 1, 1, 0
	AddVertex s, 1, -1, 0
	AddTriangle s, 0, 1, 2
	AddTriangle s, 0, 2, 3
	ScaleEntity m, distance, distance, 1
	EntityColor m, red, green, blue
	EntityFX m, 1
	PositionEntity m, 0, 0, distance
	Return m
End Function

; The red quad is the nearer one, whichever is made first.
red = Quad(900, 255, 0, 0)
green = Quad(900.05, 0, 255, 0)
RenderWorld
CheckTrue "The near surface wins at a distance", R(80, 60) > 200 And G(80, 60) < 50
PositionEntity red, 0, 0, 900.05
PositionEntity green, 0, 0, 900
RenderWorld
CheckTrue "The near surface wins when swapped", G(80, 60) > 200 And R(80, 60) < 50
FreeEntity red
FreeEntity green

; The same close to the camera, and with the near and far planes in a different place.
CameraRange camera, 1, 100
red = Quad(10, 255, 0, 0)
green = Quad(10.01, 0, 255, 0)
RenderWorld
CheckTrue "The near surface wins close up", R(80, 60) > 200 And G(80, 60) < 50
FreeEntity red
FreeEntity green

; Things nearer than the near plane and further than the far plane are not drawn.
red = Quad(0.5, 255, 0, 0)
green = Quad(150, 0, 255, 0)
RenderWorld
Check "Nothing before the near plane", R(80, 60), 0, 10
Check "Nothing behind the far plane", G(80, 60), 0, 10
FreeEntity red
FreeEntity green

; Orthographic cameras keep their order as well.
CameraProjMode camera, 2
CameraRange camera, 1, 100
CameraZoom camera, 0.02
red = Quad(10, 255, 0, 0)
green = Quad(10.01, 0, 255, 0)
RenderWorld
CheckTrue "Orthographic order", R(80, 60) > 200 And G(80, 60) < 50
CameraProjMode camera, 1
FreeEntity red
FreeEntity green

; Entities with an order ignore the depth, and the depth is cleared by CameraClsMode like before.
red = Quad(10, 255, 0, 0)
green = Quad(5, 0, 255, 0)
EntityOrder green, 1
RenderWorld
CheckTrue "EntityOrder draws behind", R(80, 60) > 200 And G(80, 60) < 50
EntityOrder green, -1
RenderWorld
CheckTrue "EntityOrder draws in front", G(80, 60) > 200 And R(80, 60) < 50
EntityOrder green, 0
FreeEntity red
FreeEntity green

; The distance that CameraProject returns is still the one in front of the camera.
CameraRange camera, 0.1, 1000
CameraProject camera, 0, 0, 300
Check "ProjectedZ", ProjectedZ(), 300, 0.01

Print "blitz3d_depth_pixels: " + suite_checks + " checks passed."
