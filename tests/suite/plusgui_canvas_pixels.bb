; Canvases in windows of the computer: FlipCanvas shows the window of the canvas right away (with vwait once the window has shown
; it), Flip has nothing to do with canvases, the buffer of a canvas keeps its handle and follows the size of the canvas, and the
; GUI redraw leaves the program's buffer and color alone. The requesters for colors are drawn in the active window and answered
; by presses in it. This needs a window and a GPU, so it is skipped without one. Test events: @N sends what follows to the window
; of gadget N, pX:Y puts the mouse there, mN presses a button, kN presses a key.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "plusgui_canvas_pixels: skipped, there is no window."
	End
EndIf

Global folder$ = "suite_tmp_canvas"
CreateDir folder
SetEnv "BLITZLLVM_TEST_WINDOW_SHOTS", folder
Graphics 320, 240, 32, 2
SetBuffer BackBuffer()
AutoSuspend False

Const RED = $FF0000, GREEN = $00FF00, BLUE = $0000FF, WHITE = $FFFFFF, BLACK = 0

; The picture of a window as the runtime saved it when the window was drawn last, for Px.
Global shot = 0
Function Show(win)
	If shot Then FreeImage shot
	shot = LoadImage(folder + "/window_" + QueryObject(win, 1) + ".bmp")
	If shot = 0 Then RuntimeError "The picture of the window was not saved."
End Function

Function Px(x, y)
	Return ReadPixel(x, y, ImageBuffer(shot)) And $FFFFFF
End Function

; Lets the windows tell what happened to them, and draws what changed.
Function Pump()
	For i = 1 To 3
		PeekEvent()
		Delay 20
	Next
End Function

; Two windows with a canvas each, next to each other on the desktop.
a = CreateWindow("A", 20, 20, 400, 300, 0, 0)
ca = CreateCanvas(10, 10, 100, 80, a)
b = CreateWindow("B", 440, 20, 200, 150, 0, 0)
cb = CreateCanvas(10, 10, 100, 80, b)
CheckTrue "Two windows of the computer", QueryObject(a, 1) <> QueryObject(b, 1)
Pump()

; The buffer of a canvas is the same every time it is asked for.
cab = CanvasBuffer(ca)
CheckTrue "CanvasBuffer", cab <> 0
Check "CanvasBuffer keeps its handle", CanvasBuffer(ca), cab

; What is drawn to a canvas is seen when the canvas is flipped, and in its window only.
SetBuffer CanvasBuffer(ca)
Color 255, 0, 0
Rect 0, 0, 100, 80, 1
SetBuffer CanvasBuffer(cb)
Color 0, 0, 255
Rect 0, 0, 100, 80, 1
SetBuffer BackBuffer()
Pump()
Show(a)
Check "A canvas shows nothing before it is flipped", Px(60, 50), BLACK
FlipCanvas ca, 1
Show(a)
Check "FlipCanvas with vwait shows the canvas at once", Px(60, 50), RED
Show(b)
Check "The other canvas is not flipped with it", Px(60, 50), BLACK
FlipCanvas cb, 0
Show(b)
Check "FlipCanvas without vwait shows the canvas at once", Px(60, 50), BLUE
Show(a)
Check "The first canvas keeps what it showed", Px(60, 50), RED

; Drawing the window of a canvas leaves the program's buffer, color and origin as they were.
SetBuffer CanvasBuffer(ca)
Color 0, 255, 0
Origin 5, 7
FlipCanvas ca
Check "FlipCanvas keeps the buffer", GraphicsBuffer(), cab
Check "FlipCanvas keeps the color", ColorGreen(), 255
Check "FlipCanvas keeps the color's red", ColorRed(), 0
Origin 0, 0

; Flip shows the window of Graphics and has nothing to do with canvases: what was drawn to one stays unseen until FlipCanvas.
Rect 0, 0, 100, 80, 1
SetBuffer BackBuffer()
For i = 1 To 3
	Flip 0
Next
Pump()
Show(a)
Check "Flip does not show what was drawn to a canvas", Px(60, 50), RED
FlipCanvas ca
Show(a)
Check "FlipCanvas shows it", Px(60, 50), GREEN

; A canvas that changed size gets a buffer of the new size, and draws all of it.
SetGadgetShape ca, 10, 10, 150, 100
SetBuffer CanvasBuffer(ca)
ClsColor 255, 255, 255
Cls
SetBuffer BackBuffer()
FlipCanvas ca
Show(a)
Check "A canvas that changed size is drawn at its new size", Px(10 + 140, 10 + 90), WHITE
Check "What is below a canvas that grew is gone", Px(10 + 140, 10 + 10), WHITE

; The color requester is drawn in the active window, and a press on its OK button in that window answers it: the requester is
; 340 by 190 in the middle of the 400 by 300 window, its OK button 76 by 24 at 170 from the right and 34 from the bottom.
ActivateWindow a
Pump()
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + a + ",p238:223,m1"
Check "RequestColor in a window of the computer, OK pressed", RequestColor(10, 20, 30), 1
Check "RequestedRed", RequestedRed(), 10
Check "RequestedBlue", RequestedBlue(), 30
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + a + ",k1"
Check "RequestColor cancelled with Escape", RequestColor(1, 2, 3), 0
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + b + ",p238:223,m1,@" + a + ",k1"
Check "A press in another window does not answer the requester", RequestColor(1, 2, 3), 0

FreeGadget a
FreeGadget b
Done "plusgui_canvas_pixels"
