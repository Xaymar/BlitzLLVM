; A negative light makes things darker than the ambient light, even darker than black. An 8 bit target can't hold that and shows black, but the
; half precision floats of depth 64 keep it, and so does a render target made of them once it is read back with ReadPixel64.
; Graphics3D AmbientLight CreateLight LightColor EntityFX ReadPixel64 GraphicsDepth.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_negative_light_pixels: skipped, there is no window."
	End
EndIf

; Depth 32 (8 bits) shows black, and depth 64 keeps what the lights add up to: the ambient light 0.5 and the light -1.0 give -0.5 for white.
Function TryDepth(depth)
	Local name$ = "Depth " + depth + ": "
	Local r:Float16, g:Float16, b:Float16, a:Float16
	Graphics3D 64, 64, depth, 2
	SetBuffer BackBuffer()
	Check name + "GraphicsDepth", GraphicsDepth(), depth
	AmbientLight 128, 128, 128
	camera = CreateCamera()
	PositionEntity camera, 0, 0, -5
	CameraClsColor camera, 0, 0, 0
	light = CreateLight(1)
	LightColor light, -255, -255, -255
	cube = CreateCube()
	EntityColor cube, 255, 255, 255
	RenderWorld
	ReadPixel64 32, 32, BackBuffer(), r, g, b, a
	If depth = 64
		Check name + "red is negative", Float(r), -0.5, 0.02
		Check name + "green is negative", Float(g), -0.5, 0.02
		Check name + "blue is negative", Float(b), -0.5, 0.02
		Check name + "alpha", Float(a), 1.0, 0.001
	Else
		Check name + "red is black", Float(r), 0.0, 0.001
		Check name + "blue is black", Float(b), 0.0, 0.001
	EndIf

	; A light that is not enough to get below black is the same as before, and a light that is brighter than white keeps being brighter.
	LightColor light, 0, 0, 0
	AmbientLight 255, 255, 255
	RenderWorld
	ReadPixel64 32, 32, BackBuffer(), r, g, b, a
	Check name + "white", Float(r), 1.0, 0.01
	LightColor light, 255, 255, 255
	RenderWorld
	ReadPixel64 32, 32, BackBuffer(), r, g, b, a
	If depth = 64 Then Check name + "brighter than white", Float(r), 2.0, 0.02 Else Check name + "white is the most", Float(r), 1.0, 0.01
	ClearWorld
End Function

TryDepth 32
TryDepth 64
Done "blitz3d_negative_light_pixels"
