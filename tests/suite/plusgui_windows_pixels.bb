; The windows of the BlitzPlus GUI are windows of the computer, and the mouse and the keys in one go to the gadgets of that
; window, at the place of the window on the desktop. Two windows lie over each other on the desktop, so a press at one place is
; in one window or the other by the window it is made in, never by what is on top. The mouse of the computer, which other
; programs move at the same time, is not looked at: canvases tell where they were pressed. This needs a window and a GPU, so it
; is skipped without one. Test events: @N sends what follows to the window of gadget N, pX:Y puts the mouse there.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "plusgui_windows_pixels: skipped, there is no window."
	End
EndIf

Graphics 320, 240, 32, 2
AutoSuspend False

; Waits until nothing comes any more, and tells how many actions a gadget had. The last press of a mouse button in a canvas is kept.
Global hit_source = 0, hit_x = 0, hit_y = 0
Function Actions(gadget)
	count = 0
	quiet = 0
	While quiet < 6
		e = WaitEvent(50)
		If e = 0 Then
			quiet = quiet + 1
		Else
			quiet = 0
			If (e = $401) And (EventSource() = gadget) Then count = count + 1
			If e = $201 Then
				hit_source = EventSource()
				hit_x = EventX()
				hit_y = EventY()
			EndIf
		EndIf
	Wend
	Return count
End Function

; Each window has a button at the top and a canvas below it; B lies over the lower part of A on the desktop.
a = CreateWindow("A", 20, 20, 200, 150, 0, 0)
ba = CreateButton("A", 10, 10, 80, 24, a)
ca = CreateCanvas(0, 50, 200, 100, a)
b = CreateWindow("B", 60, 60, 200, 150, 0, 0)
bb = CreateButton("B", 10, 10, 80, 24, b)
cb = CreateCanvas(0, 50, 200, 100, b)
CheckTrue "Two windows are two windows of the computer", QueryObject(a, 1) <> QueryObject(b, 1)
Actions(0)

; A press in B is in B, where A would be as well on the desktop.
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + bb + ",p20:20,m1"
Check "A press in a window presses its button", Actions(bb), 1
Check "The button of the other window is not pressed", Actions(ba), 0
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + cb + ",p100:100,m1"
Actions(0)
Check "A press in a window is in its canvas", hit_source, cb
Check "EventX of a press in a canvas", hit_x, 100
Check "EventY of a press in a canvas", hit_y, 100 - 50

; The same presses in A.
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + ba + ",p20:20,m1"
Check "A press in the other window presses that one's button", Actions(ba), 1
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + ca + ",p140:140,m1"
Actions(0)
Check "A press in the other window is in its canvas", hit_source, ca
Check "EventX of a press in the other canvas", hit_x, 140
Check "EventY of a press in the other canvas", hit_y, 140 - 50

; Typing goes to the window that the keys are pressed in: a text field there is given the focus by a press and then the keys.
tf = CreateTextField(100, 10, 90, 24, b)
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + tf + ",p150:22,m1,tabc"
Actions(0)
CheckS "Keys in a window go to its text field", TextFieldText(tf), "abc"
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + ba + ",p150:22,m1,txyz"
Actions(0)
CheckS "Keys in another window do not", TextFieldText(tf), "abc"

; The window of Graphics has none of the gadgets: a press there is the program's alone.
hit_source = 0
SetEnv "BLITZLLVM_TEST_EVENTS", "@0,p20:20,m1"
Check "A press in the window of Graphics presses no button", Actions(ba) + Actions(bb), 0
Check "A press in the window of Graphics is in no canvas", hit_source, 0

; A window told to move and size is where it was told, and its gadgets go with it (the canvas keeps to the left edge; one with
; no edge set is centered when the window changes size).
SetGadgetLayout cb, 1, 0, 1, 0
SetGadgetShape b, 100, 90, 180, 120
Actions(0)
Check "GadgetX after SetGadgetShape", GadgetX(b), 100
Check "GadgetWidth after SetGadgetShape", GadgetWidth(b), 180
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + bb + ",p20:20,m1"
Check "A press in a window that moved presses its button", Actions(bb), 1
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + cb + ",p30:60,m1"
Actions(0)
Check "A press in a window that moved is in its canvas", hit_source, cb
Check "EventX in a window that moved", hit_x, 30
Check "EventY in a window that moved", hit_y, 60 - 50

FreeGadget a
FreeGadget b
Done "plusgui_windows_pixels"
