; Loading on other threads: AsyncLoading TextureReady ImageReady, and that LoadTexture and LoadImage give the same textures
; and images, the same 0 for what is no picture, and that the file can go right after loading.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; The files this test makes have a name of their own, because the release and debug runs of it can be at the same time.
SeedRnd MilliSecs()
unique$ = "suite_async_" + Rand(1, 1000000000)
copy_name$ = unique$ + ".png"
junk_name$ = unique$ + ".junk.png"

; Blocking loads, to compare with.
AsyncLoading False
blocking = LoadTexture("../checker.png", 1 + 8)
blocking_image = LoadImage("../checker.png")

AsyncLoading True
async = LoadTexture("../checker.png", 1 + 8)
CheckTrue "Async LoadTexture gives a texture", async <> 0
CheckTrue "Async LoadTexture gives another handle", async <> blocking
Check "Async LoadTexture missing", LoadTexture("suite_does_not_exist.png"), 0
Check "TextureWidth of an async texture", TextureWidth(async), 64
Check "TextureHeight of an async texture", TextureHeight(async), 64
Check "An async texture is ready once it was used", TextureReady(async), 1
Check "TextureReady of what is no texture", TextureReady(0), 0

; The pixels are the ones of the blocking load.
same = True
For y = 0 To 63 Step 5
	For x = 0 To 63 Step 5
		If ReadPixel(x, y, TextureBuffer(async)) <> ReadPixel(x, y, TextureBuffer(blocking)) Then same = False
	Next
Next
CheckTrue "Async and blocking textures have the same pixels", same

; The file is read when LoadTexture is called, so it can be gone at once.
CopyFile "../checker.png", copy_name$
moved = LoadTexture(copy_name$)
DeleteFile copy_name$
CheckTrue "A texture of a deleted file", moved <> 0
Check "The width of a texture of a deleted file", TextureWidth(moved), 64

; A file that is no picture gives 0 at once, as it does without threads.
f = WriteFile(junk_name$)
WriteLine f, "this is no picture"
CloseFile f
Check "Async LoadTexture of a file that is no picture", LoadTexture(junk_name$), 0
Check "Async LoadImage of a file that is no picture", LoadImage(junk_name$), 0
DeleteFile junk_name$

; Freeing a texture that is still loading is fine.
for_free = LoadTexture("../checker.png")
FreeTexture for_free
suite_checks = suite_checks + 1

; Entities draw with a texture that was loaded this way.
cam = CreateCamera()
PositionEntity cam, 0, 0, -3
cube = CreateCube()
late = LoadTexture("../checker.png")
EntityTexture cube, late
RenderWorld
Flip
Check "A texture is ready once it was drawn", TextureReady(late), 1

; Images.
image = LoadImage("../checker.png")
CheckTrue "Async LoadImage", image <> 0
Check "ImageWidth of an async image", ImageWidth(image), 64
Check "ImageHeight of an async image", ImageHeight(image), 64
Check "ImageReady", ImageReady(image), 1
Check "ImageReady of what is no image", ImageReady(0), 0
other = LoadImage("../checker.png")
SetBuffer ImageBuffer(other)
a = ReadPixel(10, 10)
SetBuffer ImageBuffer(blocking_image)
b = ReadPixel(10, 10)
SetBuffer BackBuffer()
Check "Async and blocking images have the same pixels", a, b

; TextureReady gets to 1 without anything asking for the texture.
wait = LoadTexture("../checker.png")
start = MilliSecs()
While TextureReady(wait) = 0 And MilliSecs() - start < 5000
	Delay 1
Wend
Check "TextureReady turns 1 by itself", TextureReady(wait), 1

AsyncLoading False
Done "blitz3d_async_load_pixels"
