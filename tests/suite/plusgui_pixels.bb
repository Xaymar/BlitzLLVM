; What the BlitzPlus GUI puts on the screen, which needs a window and a GPU, so this is skipped without one: Desktop
; CreateWindow CreatePanel SetPanelColor SetPanelImage CreateLabel CreateButton CreateProgBar UpdateProgBar CreateSlider
; CreateCanvas CanvasBuffer FlipCanvas CreateToolBar SetToolBarTips EnableToolBarItem DisableToolBarItem LoadIconStrip
; FreeIconStrip SetGadgetIconStrip HideGadget ShowGadget MinimizeWindow RestoreWindow SetStatusText CreateListBox
; AddGadgetItem SelectGadgetItem DesktopBuffer ClientWidth ClientHeight GadgetWidth GadgetHeight QueryObject.
; Every window is a window of the computer, so what it shows is looked at through the pictures that the runtime saves of them
; with BLITZLLVM_TEST_WINDOW_SHOTS (one file per window, as it was drawn last); the window of Graphics shows only the desktop.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "plusgui_pixels: skipped, there is no window."
	End
EndIf

Global folder$ = "suite_tmp_gui"
CreateDir folder
SetEnv "BLITZLLVM_TEST_WINDOW_SHOTS", folder
Graphics 320, 240, 32, 2
SetBuffer BackBuffer()
AutoSuspend False ; Other windows of tests that run at the same time must not stop this one.

Const DESKTOP = $3A6EA5, RED = $FF0000, GREEN = $00FF00, BLUE = $0000FF, WHITE = $FFFFFF, BLACK = 0

; What the GUI drew is shown when the program asks for events. The picture of a window is then in its file, which is loaded for
; Px: the positions are those in the window, whose frame and title are the computer's and not in the picture.
Global shot = 0
Function Show(win = 0)
	PeekEvent()
	If shot Then FreeImage shot
	shot = 0
	If win Then
		shot = LoadImage(folder + "/window_" + QueryObject(win, 1) + ".bmp")
		If shot = 0 Then RuntimeError "The picture of the window was not saved."
	EndIf
End Function

Function Px(x, y)
	If shot = 0 Then RuntimeError "Px: no window was shown."
	Return ReadPixel(x, y, ImageBuffer(shot)) And $FFFFFF
End Function

; A pixel of the window of Graphics, which has the desktop.
Function Dx(x, y)
	Return ReadPixel(x, y, BackBuffer()) And $FFFFFF
End Function

; Icons are in a file: squares next to each other, the first pixel is the color that is not drawn, and an icon that is
; all of that color is the space between buttons.
strip = CreateImage(48, 16)
SetBuffer ImageBuffer(strip)
Color 255, 0, 255
Rect 0, 0, 48, 16, 1
Color 255, 0, 0
Rect 4, 4, 8, 8, 1
Color 0, 255, 0
Rect 36, 4, 8, 8, 1
SetBuffer BackBuffer()
SaveImage strip, folder + "/strip.bmp"
FreeImage strip

; The desktop is what is behind the windows, in the window of Graphics.
Desktop()
Show()
Check "The desktop is drawn", Dx(300, 220), DESKTOP

; A window without a frame has a panel in it that has a color. The window is one of the computer, so its picture is its client area.
win = CreateWindow("W", 40, 30, 200, 150, 0, 0)
CheckTrue "A window is a window of the computer", QueryObject(win, 1) <> 0
Check "A window has no frame of its own", ClientWidth(win), 200
Check "A window has no title of its own", ClientHeight(win), 150
pn = CreatePanel(0, 0, 100, 60, win)
SetPanelColor pn, 255, 0, 0
Show(win)
Check "A window is drawn into its picture", Px(20, 20), RED
Check "The panel is only as big as it is", Px(150, 120), $D4D0C8
Check "The desktop is not drawn on by the window", Dx(60, 50), DESKTOP
SetPanelColor pn, 0, 0, 255
Show(win)
Check "SetPanelColor", Px(20, 20), BLUE
HideGadget pn
Show(win)
Check "HideGadget", Px(20, 20), $D4D0C8
ShowGadget pn
Show(win)
Check "ShowGadget", Px(20, 20), BLUE

; Moving a window moves it on the screen, and what is in it stays where it is in the window.
SetGadgetShape win, 100, 80, 200, 150
Show(win)
Check "A window that moved keeps what is in it", Px(20, 20), BLUE
Check "GadgetX of a window that moved", GadgetX(win), 100
Check "GadgetY of a window that moved", GadgetY(win), 80
SetGadgetShape win, 40, 30, 200, 150

; Progress bars are filled as far as they are.
pb = CreateProgBar(10, 100, 100, 16, win)
UpdateProgBar pb, 0.5
Show(win)
Check "The filled part of a progress bar", Px(10 + 20, 100 + 8), $0A246A
Check "The rest of a progress bar", Px(10 + 80, 100 + 8), $D4D0C8
HideGadget pb

; A canvas shows what was drawn to its buffer when it is flipped.
cv = CreateCanvas(0, 0, 60, 40, win)
SetBuffer CanvasBuffer(cv)
Color 0, 255, 0
Rect 0, 0, 60, 40, 1
SetBuffer BackBuffer()
Show(win)
Check "A canvas shows nothing before it is flipped", Px(20, 20), BLACK
FlipCanvas cv
Show(win)
Check "FlipCanvas", Px(20, 20), GREEN
HideGadget cv

; Toolbars have buttons from a file of icons, and the gap between them is not a button.
tb = CreateToolBar(folder + "/strip.bmp", 0, 100, 100, 24, win)
SetToolBarTips tb, "Red,Green"
Show(win)
; The icon starts 6 pixels into the toolbar, and its square is 4 pixels in.
Check "ToolBar icon", Px(6 + 8, 100 + 12), RED
Check "ToolBar icon background is not drawn", Px(6 + 1, 100 + 5), $D4D0C8
; A disabled button is dimmed: some of its rows are the color of the bar.
DisableToolBarItem tb, 0
Show(win)
dimmed = 0
For y = 100 + 4 To 100 + 4 + 15
	If Px(6 + 8, y) <> RED Then dimmed = dimmed + 1
Next
CheckTrue "DisableToolBarItem", dimmed >= 4
EnableToolBarItem tb, 0
Show(win)
Check "EnableToolBarItem", Px(6 + 8, 100 + 12), RED
; The tip of a button shows below it once the mouse has rested on it for a moment, and goes with the mouse. The mouse is put
; into the window (@ names the window of a gadget, p where in it). Other programs that run at the same time move the one mouse
; of the X server, which the window hears of as well, so the mouse is put there again if nothing happened for a while, and a
; slow machine gets plenty of time.
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + tb + ",p" + (6 + 8) + ":" + (100 + 12)
tip_seen = False
started = MilliSecs()
moved = started
While (MilliSecs() - started < 20000) And (tip_seen = False)
	Delay 50
	Show(win)
	If Px(5, 129) = $FFFFE1 Then tip_seen = True
	If (tip_seen = False) And (MilliSecs() - moved >= 2000) Then
		SetEnv "BLITZLLVM_TEST_EVENTS", "@" + tb + ",p" + (6 + 8) + ":" + (100 + 12)
		moved = MilliSecs()
	EndIf
Wend
CheckTrue "SetToolBarTips shows a tip", tip_seen
SetEnv "BLITZLLVM_TEST_EVENTS", "@" + tb + ",p5:5"
started = MilliSecs()
moved = started
While (MilliSecs() - started < 20000) And tip_seen
	Delay 50
	Show(win)
	If Px(5, 129) <> $FFFFE1 Then tip_seen = False
	If tip_seen And (MilliSecs() - moved >= 2000) Then
		SetEnv "BLITZLLVM_TEST_EVENTS", "@" + tb + ",p5:5"
		moved = MilliSecs()
	EndIf
Wend
CheckFalse "The tip goes when the mouse leaves", tip_seen
HideGadget tb

; Icon strips are in lists, in front of the items.
ic = LoadIconStrip(folder + "/strip.bmp")
CheckTrue "LoadIconStrip", ic <> 0
Check "LoadIconStrip missing", LoadIconStrip(folder + "/missing.bmp"), 0
lb = CreateListBox(0, 0, 100, 60, win)
SetGadgetIconStrip lb, ic
AddGadgetItem lb, "A", 0, 0
Show(win)
Check "List box icon", Px(2 + 2 + 8, 2 + 1 + 8), RED
FreeIconStrip ic
Show(win)
HideGadget lb

; Minimizing and restoring are the computer's, which may do nothing without a window manager; the window keeps what is in it.
MinimizeWindow win
Show()
RestoreWindow win
Show(win)
Check "RestoreWindow", Px(150, 120), $D4D0C8

; A window that was freed is closed: its picture is not saved again.
number = QueryObject(win, 1)
FreeGadget win
DeleteFile folder + "/window_" + number + ".bmp"
Show()
Check "A window that was freed is gone", FileType(folder + "/window_" + number + ".bmp"), 0

; Nothing can be drawn on the desktop: it is not the screen of the computer, and the windows are not changed by it.
SetBuffer DesktopBuffer()
Color 255, 0, 255
Rect 4, 4, 20, 20, 1
Oval 0, 0, 50, 50, 1
SetBuffer BackBuffer()
Delay 50
Show()
Check "Drawing on the desktop shows nothing", Dx(10, 10), DESKTOP
Check "The rest of the desktop is as it was", Dx(100, 10), DESKTOP
cover = CreateWindow("Cover", 0, 0, 60, 60, 0, 0)
Show(cover)
Check "A window is drawn, not the desktop", Px(10, 10), $D4D0C8
Check "The desktop is not changed by a window", Dx(10, 10), DESKTOP
FreeGadget cover

; The desktop is the screen, which is bigger than the window of the program.
CheckTrue "The desktop is as big as the screen", ClientWidth(Desktop()) > GraphicsWidth()
CheckTrue "The desktop is as high as the screen", ClientHeight(Desktop()) > GraphicsHeight()
Check "GadgetWidth of the desktop", GadgetWidth(Desktop()), ClientWidth(Desktop())
Check "GadgetHeight of the desktop", GadgetHeight(Desktop()), ClientHeight(Desktop())

; The system has a handle for every window, the same for every gadget in it, and the desktop is the window of Graphics.
qwin = CreateWindow("Query", 0, 0, 100, 60, 0, 0)
qbtn = CreateButton("B", 0, 0, 40, 20, qwin)
CheckTrue "QueryObject of a window", QueryObject(qwin, 1) <> 0
Check "QueryObject of the client of a window", QueryObject(qwin, 2), QueryObject(qwin, 1)
Check "QueryObject of a gadget in a window", QueryObject(qbtn, 1), QueryObject(qwin, 1)
CheckTrue "QueryObject of the desktop", QueryObject(Desktop(), 1) <> 0
CheckTrue "QueryObject of the desktop is not the window", QueryObject(Desktop(), 1) <> QueryObject(qwin, 1)
Check "QueryObject of a font query", QueryObject(qwin, 3), 0
Check "QueryObject of a query that is not known", QueryObject(qwin, 99), 0
FreeGadget qwin
Check "QueryObject of a gadget that was freed", QueryObject(qwin, 1), 0

; Windows with a title have the title of the computer, so the whole of the window is the client area, for tool windows too.
tool = CreateWindow("Tool", 40, 30, 200, 150, 0, 1 + 16)
Show(tool)
Check "A tool window has the title of the computer", Px(100, 10), $D4D0C8
Check "A tool window is all client area", ClientHeight(tool), 150
FreeGadget tool
normal = CreateWindow("Normal", 40, 30, 200, 150, 0, 1 + 2)
Show(normal)
Check "A window has the title of the computer", Px(100, 10), $D4D0C8
Check "A window is all client area", ClientHeight(normal), 150
FreeGadget normal
client = CreateWindow("Client", 0, 0, 120, 80, 0, 32)
Check "A window with a client size has it", ClientWidth(client), 120
FreeGadget client

; A menu bar is there when the window is made for one, even with no menus in it.
bar = CreateWindow("Bar", 40, 30, 200, 150, 0, 4)
Show(bar)
Check "The line under an empty menu bar", Px(60, 22 - 2), $808080
Check "The empty menu bar", Px(60, 10), $D4D0C8
Check "Under the menu bar", Px(60, 22 + 5), $D4D0C8
Check "The menu bar is above the client area", ClientHeight(bar), 150 - 22
FreeGadget bar
plain = CreateWindow("Plain", 40, 30, 200, 150, 0, 0)
Show(plain)
Check "A window without a menu bar has no line", Px(60, 22 - 2), $D4D0C8
FreeGadget plain

; A text area that does not wrap gets a bar along the bottom once a line does not fit, and a short text has none.
barwin = CreateWindow("Bars", 40, 30, 200, 150, 0, 0)
ta = CreateTextArea(10, 10, 100, 60, barwin)
SetTextAreaText ta, "short"
Show(barwin)
Check "A short text has no bar along the bottom", Px(10 + 10, 10 + 60 - 10), WHITE
SetTextAreaText ta, "a line that is much too long to fit in this text area"
Show(barwin)
Check "A long line shows the arrow of the bar along the bottom", Px(10 + 2 + 3, 10 + 60 - 2 - 3), $D4D0C8
Check "The text area above the bar is still white", Px(10 + 40, 10 + 10), WHITE
FreeGadget barwin

; Text in gadgets is drawn with the font of the gadget, in the widths of that font. The font here has a block for the letter A that
; is 10 pixels wide at this size, with 2 pixels before it.
fontwin = CreateWindow("Fonts", 40, 30, 200, 150, 0, 0)
fixture = LoadFont("images/fixture.ttf", 20)
lbl = CreateLabel("A", 10, 10, 100, 30, fontwin)
SetGadgetFont lbl, fixture
Show(fontwin)
Check "A label is drawn in its font", Px(10 + 3 + 2 + 5, 10 + 3 + 8), BLACK
Check "A label is not drawn left of its letter", Px(10 + 3 + 1, 10 + 3 + 8), $D4D0C8
Check "A label is not drawn right of its letter", Px(10 + 3 + 2 + 11, 10 + 3 + 8), $D4D0C8
FreeGadget fontwin
FreeFont fixture

Done "plusgui_pixels"
