; What the BlitzPlus GUI puts on the screen, which needs a window and a GPU, so this is skipped without one: Desktop
; CreateWindow CreatePanel SetPanelColor SetPanelImage CreateLabel CreateButton CreateProgBar UpdateProgBar CreateSlider
; CreateCanvas CanvasBuffer FlipCanvas CreateToolBar SetToolBarTips EnableToolBarItem DisableToolBarItem LoadIconStrip
; FreeIconStrip SetGadgetIconStrip HideGadget ShowGadget MinimizeWindow RestoreWindow SetStatusText CreateListBox
; AddGadgetItem SelectGadgetItem DesktopBuffer.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "plusgui_pixels: skipped, there is no window."
	End
EndIf

Graphics 320, 240, 32, 2
SetBuffer BackBuffer()

Const DESKTOP = $3A6EA5, RED = $FF0000, GREEN = $00FF00, BLUE = $0000FF, WHITE = $FFFFFF, BLACK = 0

; What the GUI drew is in the back buffer when the program has asked for events.
Function Show()
	PeekEvent()
End Function

Function Px(x, y)
	Return ReadPixel(x, y, BackBuffer()) And $FFFFFF
End Function

; Icons are in a file: squares next to each other, the first pixel is the color that is not drawn, and an icon that is
; all of that color is the space between buttons.
folder$ = "suite_tmp_gui"
CreateDir folder
strip = CreateImage(48, 16)
SetBuffer ImageBuffer(strip)
Color 255, 0, 255
Rect 0, 0, 48, 16, 1
Color 255, 0, 0
Rect 4, 4, 8, 8, 1
Color 0, 255, 0
Rect 36, 4, 8, 8, 1
SetBuffer BackBuffer()
SaveImage strip, folder + "/strip.bmp"
FreeImage strip

; The desktop is what is behind the windows.
Desktop()
Show()
Check "The desktop is drawn", Px(300, 220), DESKTOP

; A window without a frame has a panel in it that has a color.
win = CreateWindow("W", 40, 30, 200, 150, 0, 0)
pn = CreatePanel(0, 0, 100, 60, win)
SetPanelColor pn, 255, 0, 0
Show()
Check "A window is drawn over the desktop", Px(60, 50), RED
Check "The panel is only as big as it is", Px(150, 150), $D4D0C8
Check "Outside of the window is the desktop", Px(10, 10), DESKTOP
SetPanelColor pn, 0, 0, 255
Show()
Check "SetPanelColor", Px(60, 50), BLUE
HideGadget pn
Show()
Check "HideGadget", Px(60, 50), $D4D0C8
ShowGadget pn
Show()
Check "ShowGadget", Px(60, 50), BLUE

; Moving a window moves what is drawn.
SetGadgetShape win, 100, 80, 200, 150
Show()
Check "A window that moved is not where it was", Px(60, 50), DESKTOP
Check "A window that moved is where it is now", Px(120, 100), BLUE
SetGadgetShape win, 40, 30, 200, 150

; Progress bars are filled as far as they are.
pb = CreateProgBar(10, 100, 100, 16, win)
UpdateProgBar pb, 0.5
Show()
Check "The filled part of a progress bar", Px(41 + 10 + 20, 31 + 100 + 8), $0A246A
Check "The rest of a progress bar", Px(41 + 10 + 80, 31 + 100 + 8), $D4D0C8
HideGadget pb

; A canvas shows what was drawn to its buffer when it is flipped.
cv = CreateCanvas(0, 0, 60, 40, win)
SetBuffer CanvasBuffer(cv)
Color 0, 255, 0
Rect 0, 0, 60, 40, 1
SetBuffer BackBuffer()
Show()
Check "A canvas shows nothing before it is flipped", Px(60, 50), BLACK
FlipCanvas cv
Show()
Check "FlipCanvas", Px(60, 50), GREEN
HideGadget cv

; Toolbars have buttons from a file of icons, and the gap between them is not a button.
tb = CreateToolBar(folder + "/strip.bmp", 0, 100, 100, 24, win)
SetToolBarTips tb, "Red,Green"
Show()
; The icon starts 6 pixels into the toolbar, and its square is 4 pixels in.
Check "ToolBar icon", Px(41 + 6 + 8, 31 + 100 + 12), RED
Check "ToolBar icon background is not drawn", Px(41 + 6 + 1, 31 + 100 + 5), $D4D0C8
; A disabled button is dimmed: some of its rows are the color of the bar.
DisableToolBarItem tb, 0
Show()
dimmed = 0
For y = 100 + 4 To 100 + 4 + 15
	If Px(41 + 6 + 8, 31 + y) <> RED Then dimmed = dimmed + 1
Next
CheckTrue "DisableToolBarItem", dimmed >= 4
EnableToolBarItem tb, 0
Show()
Check "EnableToolBarItem", Px(41 + 6 + 8, 31 + 100 + 12), RED
HideGadget tb

; Icon strips are in lists, in front of the items.
ic = LoadIconStrip(folder + "/strip.bmp")
CheckTrue "LoadIconStrip", ic <> 0
Check "LoadIconStrip missing", LoadIconStrip(folder + "/missing.bmp"), 0
lb = CreateListBox(0, 0, 100, 60, win)
SetGadgetIconStrip lb, ic
AddGadgetItem lb, "A", 0, 0
Show()
Check "List box icon", Px(41 + 2 + 2 + 8, 31 + 2 + 1 + 8), RED
FreeIconStrip ic
Show()
HideGadget lb

; A minimized window is a bar at the bottom of the desktop.
MinimizeWindow win
Show()
Check "A minimized window is gone from where it was", Px(60, 50), DESKTOP
CheckTrue "A minimized window is at the bottom", Px(10, 240 - 12) <> DESKTOP
RestoreWindow win
Show()
Check "RestoreWindow", Px(150, 150), $D4D0C8

FreeGadget win
Show()
Check "A window that was freed is gone", Px(60, 50), DESKTOP

DesktopBufferCheck = DesktopBuffer()
CheckTrue "DesktopBuffer", DesktopBufferCheck <> 0

Done "plusgui_pixels"
