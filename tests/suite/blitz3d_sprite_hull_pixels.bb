; A sprite with a round texture is drawn with the shape that the texture is visible in (an octagon, 6 triangles) and not with the
; whole square (2 triangles), and looks the same: no pixel is more than 2 levels different from the square. A texture that
; fills the square, one that was drawn to, and one with a visible pixel in every corner keep the square.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_sprite_hull_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 160, 32, 2
SetBuffer BackBuffer()

; Soft round puff, see-through at the edge. Drawn with LockBuffer, which is when the hull is made.
Function MakePuff()
	t = CreateTexture(32, 32, 3)
	LockBuffer TextureBuffer(t)
	For y = 0 To 31
		For x = 0 To 31
			dx# = (x - 15.5) / 15.5
			dy# = (y - 15.5) / 15.5
			a# = 1 - Sqr(dx * dx + dy * dy)
			If a < 0 Then a = 0
			WritePixelFast x, y, (Int(a * 255) Shl 24) Or $FFFFFF, TextureBuffer(t)
		Next
	Next
	UnlockBuffer TextureBuffer(t)
	Return t
End Function

camera = CreateCamera()
CameraClsColor camera, 20, 40, 80
sprite = CreateSprite()
PositionEntity sprite, 0, 0, 3
EntityBlend sprite, 1
ScaleSprite sprite, 1.4, 1.4
EntityColor sprite, 255, 200, 120

puff = MakePuff()
EntityTexture sprite, puff
RenderWorld
CheckS "A round texture is drawn as an octagon", "" + TrisRendered(), "6"

; The picture of the square: one more visible pixel in each corner, which is as good as invisible, takes the hull away.
Dim hulled(159, 159)
LockBuffer BackBuffer()
For y = 0 To 159
	For x = 0 To 159
		hulled(x, y) = ReadPixelFast(x, y, BackBuffer()) And $FFFFFF
	Next
Next
UnlockBuffer BackBuffer()

LockBuffer TextureBuffer(puff)
For corner = 0 To 3
	WritePixelFast (corner And 1) * 31, (corner Shr 1) * 31, (1 Shl 24) Or $FFFFFF, TextureBuffer(puff)
Next
UnlockBuffer TextureBuffer(puff)
RenderWorld
CheckS "A texture with a pixel in each corner is drawn as a square", "" + TrisRendered(), "2"

worst = 0
differing = 0
LockBuffer BackBuffer()
For y = 0 To 159
	For x = 0 To 159
		got = ReadPixelFast(x, y, BackBuffer()) And $FFFFFF
		want = hulled(x, y)
		d = Abs(((got Shr 16) And 255) - ((want Shr 16) And 255))
		d2 = Abs(((got Shr 8) And 255) - ((want Shr 8) And 255))
		d3 = Abs((got And 255) - (want And 255))
		If d2 > d Then d = d2
		If d3 > d Then d = d3
		If d > worst Then worst = d
		If d > 0 Then differing = differing + 1
	Next
Next
UnlockBuffer BackBuffer()
CheckTrue "The octagon looks like the square (largest difference " + worst + " of 255, " + differing + " pixels differ)", worst <= 2

; Drawing to the texture takes the hull away until the next UnlockBuffer, and a texture without alpha never has one.
puff2 = MakePuff()
EntityTexture sprite, puff2
RenderWorld
CheckS "A new round texture has the octagon again", "" + TrisRendered(), "6"
SetBuffer TextureBuffer(puff2)
Color 255, 255, 255
Rect 0, 0, 4, 4
SetBuffer BackBuffer()
RenderWorld
CheckS "A texture that was drawn to has the square", "" + TrisRendered(), "2"

solid = CreateTexture(8, 8, 1)
EntityTexture sprite, solid
RenderWorld
CheckS "A texture without alpha has the square", "" + TrisRendered(), "2"

; A texture from a file gets its hull when it is loaded, on the loader thread too.
loaded = LoadTexture("images/sprite_hull_puff.png", 3)
EntityTexture sprite, loaded
RenderWorld
CheckS "A round texture from a file has the octagon", "" + TrisRendered(), "6"
AsyncLoading 1
loaded2 = LoadTexture("images/sprite_hull_puff.png", 3)
While TextureReady(loaded2) = 0
	Delay 1
Wend
EntityTexture sprite, loaded2
RenderWorld
CheckS "A round texture from a file on a loader thread has the octagon", "" + TrisRendered(), "6"

Done "blitz3d_sprite_hull_pixels"
End
