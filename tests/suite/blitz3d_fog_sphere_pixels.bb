; CameraFogMode 2: fog by the distance to the camera instead of the depth along its view axis. A white wall that is
; 10 units ahead is lit by nothing and fogged to black from 5 to 15 units. With mode 1 every pixel of it has the same
; depth and so the same color. With mode 2 it gets darker towards the edges of the picture, where it is further away
; from the camera, by the amount a CPU calculation says.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_fog_sphere_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 64, 64, 32, 2
SetBuffer BackBuffer()
Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100
CameraFogColor camera, 0, 0, 0
CameraFogRange camera, 5, 15

wall = CreateCube()
ScaleEntity wall, 40, 40, 0.5
PositionEntity wall, 0, 0, 10.5 ; The front is at z = 10.
EntityColor wall, 255, 255, 255
EntityFX wall, 1

; What the red value of a point of the wall is, from a distance with the fog in between 5 and 15.
Function Expected#(distance#)
	Local amount# = (distance - 5) / 10
	If amount < 0 Then amount = 0
	If amount > 1 Then amount = 1
	Return 255 * (1 - amount)
End Function

Function RedAt(x#, y#)
	CameraProject camera, x, y, 10
	Return ReadPixel(ProjectedX(), ProjectedY(), BackBuffer()) And 255
End Function

Function Distance#(x#, y#)
	Return Sqr(x * x + y * y + 100)
End Function

; Without fog nothing changes.
CameraFogMode camera, 0
RenderWorld
Check "No fog in the middle", RedAt(0, 0), 255, 3
Check "No fog at the edge", RedAt(9, 0), 255, 3

; Mode 1 is the depth, which is the same all over the wall.
CameraFogMode camera, 1
RenderWorld
Check "Planar fog in the middle", RedAt(0, 0), Expected(10), 4
Check "Planar fog at the edge", RedAt(9, 0), Expected(10), 4
Check "Planar fog in the corner", RedAt(9, 9), Expected(10), 4

; Mode 2 is the distance to the camera.
CameraFogMode camera, 2
RenderWorld
Check "Spherical fog in the middle", RedAt(0, 0), Expected(Distance(0, 0)), 4
Check "Spherical fog at the edge", RedAt(9, 0), Expected(Distance(9, 0)), 4
Check "Spherical fog at the edge, above", RedAt(0, 9), Expected(Distance(0, 9)), 4
Check "Spherical fog in the corner", RedAt(9, 9), Expected(Distance(9, 9)), 4
CheckTrue "The edge is further away than the middle", RedAt(9, 0) < RedAt(0, 0) - 40

; Anything else that is not 0 is linear like mode 1.
CameraFogMode camera, 3
RenderWorld
Check "Other modes are linear", RedAt(9, 0), Expected(10), 4

; Turning the camera does not change the distance of what is straight ahead of it.
TurnEntity camera, 0, 20, 0
RenderWorld
CameraProject camera, 0, 0, 10
Check "The distance does not depend on where the camera looks", ReadPixel(ProjectedX(), ProjectedY(), BackBuffer()) And 255, Expected(10), 255
Done "blitz3d_fog_sphere_pixels"
