; Fullscreen of Graphics and Graphics3D (mode 1) is a window without a border over the display. The buffer keeps its
; aspect ratio in it and the rest is black. This needs a window and a GPU, so it is skipped without one.
; BLITZLLVM_TEST_WINDOW_FLAGS makes the runtime write the SDL window flags to a file, BLITZLLVM_TEST_LAYOUT the size of the
; window, where the buffer is shown in it, and the buffer coordinates of the window corners and center.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_fullscreen_pixels: skipped, there is no window."
	End
EndIf

Const BORDERLESS = $10

Function Flags()
	f = ReadFile("fullscreen_flags.tmp")
	If f = 0 Then RuntimeError "The window flags were not written."
	r = Int(ReadLine$(f))
	CloseFile f
	DeleteFile "fullscreen_flags.tmp"
	Return r
End Function

; Checks the layout the last Graphics or Graphics3D wrote for a buffer of the given size.
Function CheckLayout(name$, bw, bh)
	f = ReadFile("fullscreen_layout.tmp")
	If f = 0 Then RuntimeError "The layout was not written."
	ww = Int(ReadLine$(f)) : wh = Int(ReadLine$(f))
	ax = Int(ReadLine$(f)) : ay = Int(ReadLine$(f)) : aw = Int(ReadLine$(f)) : ah = Int(ReadLine$(f))
	x0 = Int(ReadLine$(f)) : y0 = Int(ReadLine$(f))
	xc = Int(ReadLine$(f)) : yc = Int(ReadLine$(f))
	x1 = Int(ReadLine$(f)) : y1 = Int(ReadLine$(f))
	CloseFile f
	DeleteFile "fullscreen_layout.tmp"

	; The aspect ratio is kept (to a pixel), the buffer is inside the window and centered, and one side touches it.
	CheckTrue name$ + " keeps the aspect ratio", Abs(aw * bh - ah * bw) <= Max(bw, bh)
	CheckTrue name$ + " is inside the window", (ax >= 0) And (ay >= 0) And (ax + aw <= ww) And (ay + ah <= wh)
	CheckTrue name$ + " is centered", (Abs(ax - (ww - ax - aw)) <= 1) And (Abs(ay - (wh - ay - ah)) <= 1)
	CheckTrue name$ + " fills one side", ((aw = ww) Or (ah = wh))
	; The corners of the window are the corners of the buffer, the center is the center.
	Check name$ + " top left x", x0, 0
	Check name$ + " top left y", y0, 0
	Check name$ + " center x", xc, bw / 2
	Check name$ + " center y", yc, bh / 2
	Check name$ + " bottom right x", x1, bw - 1
	Check name$ + " bottom right y", y1, bh - 1
End Function

SetEnv "BLITZLLVM_TEST_WINDOW_FLAGS", "fullscreen_flags.tmp"
SetEnv "BLITZLLVM_TEST_LAYOUT", "fullscreen_layout.tmp"

; Fullscreen is borderless and fullscreen, and the program sees the size it asked for.
Graphics 640, 480, 32, 1
AutoSuspend False ; Other windows of tests that run at the same time must not stop this one.
fl = Flags()
CheckTrue "Graphics mode 1 is a window", fl And BORDERLESS
CheckTrue "Graphics mode 1 is borderless", fl And BORDERLESS
Check "Graphics mode 1 width", GraphicsWidth(), 640
Check "Graphics mode 1 height", GraphicsHeight(), 480
CheckLayout "Graphics 640x480", 640, 480

; What is drawn is in the buffer at the size that was asked for.
SetBuffer BackBuffer()
ClsColor 0, 0, 0
Cls
Color 255, 0, 0
Rect 0, 0, 640, 480, 1
Check "Graphics mode 1 draws", ReadPixel(639, 479) And $FFFFFF, $FF0000
Flip 2

; Another aspect ratio.
Graphics 320, 400, 32, 1
AutoSuspend False ; Other windows of tests that run at the same time must not stop this one.
CheckLayout "Graphics 320x400", 320, 400

; Graphics3D takes the same mode.
Graphics3D 800, 600, 32, 1
AutoSuspend False ; Other windows of tests that run at the same time must not stop this one.
fl = Flags()
CheckTrue "Graphics3D mode 1 is borderless", fl And BORDERLESS
CheckLayout "Graphics3D 800x600", 800, 600
SetBuffer BackBuffer()
camera = CreateCamera()
CameraClsColor camera, 0, 0, 255
RenderWorld
Check "Graphics3D mode 1 renders", ReadPixel(400, 300) And $FFFFFF, $0000FF

; A window shows all of the buffer and has a border.
Graphics 640, 480, 32, 2
fl = Flags()
CheckFalse "mode 2 has a border", fl And BORDERLESS
f = ReadFile("fullscreen_layout.tmp")
ww = Int(ReadLine$(f)) : wh = Int(ReadLine$(f)) : ax = Int(ReadLine$(f)) : ay = Int(ReadLine$(f)) : aw = Int(ReadLine$(f)) : ah = Int(ReadLine$(f))
CloseFile f
DeleteFile "fullscreen_layout.tmp"
CheckTrue "mode 2 shows all of the buffer", (ax = 0) And (ay = 0) And (aw = ww) And (ah = wh)

Done "graphics_fullscreen_pixels"
