; Images, textures and buffers in a program that never calls Graphics, which still needs a GPU: they get drawn to, read and saved
; the way they do with a window, so a tool that generates pictures needs no window.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_save_nowindow_pixels: skipped, there is no window."
	End
EndIf

SeedRnd MilliSecs()
unique$ = "suite_nowin_" + Rand(1, 1000000000) + "_"

; An image drawn to by the pixel commands and by the drawing commands.
img = CreateImage(16, 8)
CheckTrue "CreateImage works without Graphics", img <> 0
SetBuffer ImageBuffer(img)
Color 0, 0, 0
Rect 0, 0, 16, 8, 1
Color 255, 0, 0
Rect 0, 0, 8, 8, 1
WritePixel 12, 4, $FF1020FF, ImageBuffer(img)
Check "The drawn color is read", ReadPixel(2, 2, ImageBuffer(img)) And $FFFFFF, $FF0000
Check "The written pixel is read", ReadPixel(12, 4, ImageBuffer(img)) And $FFFFFF, $1020FF

CheckTrue "SaveImage works without Graphics", SaveImage(img, unique + "image.bmp")
CheckTrue "SaveImage made the file", FileSize(unique + "image.bmp") > 0
CheckTrue "SaveBuffer works without Graphics", SaveBuffer(ImageBuffer(img), unique + "buffer.png")
CheckTrue "SaveBuffer made the file", FileSize(unique + "buffer.png") > 0

back = LoadImage(unique + "image.bmp")
CheckTrue "The saved file loads", back <> 0
Check "The width is kept", ImageWidth(back), 16
Check "The saved drawn color", ReadPixel(2, 2, ImageBuffer(back)) And $FFFFFF, $FF0000
Check "The saved written pixel", ReadPixel(12, 4, ImageBuffer(back)) And $FFFFFF, $1020FF

; A texture.
tex = CreateTexture(8, 8)
CheckTrue "CreateTexture works without Graphics", tex <> 0
WritePixel 3, 3, $FF00FF00, TextureBuffer(tex)
CheckTrue "SaveTexture works without Graphics", SaveTexture(tex, unique + "texture.bmp")
CheckTrue "SaveTexture made the file", FileSize(unique + "texture.bmp") > 0

FreeImage img
FreeImage back
FreeTexture tex
dir = ReadDir(".")
Repeat
	file$ = NextFile$(dir)
	If file = "" Then Exit
	If Left(file, Len(unique)) = unique Then DeleteFile file
Forever
CloseDir dir

Done "graphics_save_nowindow_pixels"
