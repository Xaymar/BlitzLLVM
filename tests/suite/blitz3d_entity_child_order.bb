; The children of an entity are numbered in the order they became children, also after some were freed (and their handles used again),
; moved to another parent or copied, and many children are looked up without searching the whole world.
Include "check.bb"

Graphics3D 320, 240, 32, 2

parent = CreatePivot()
a = CreatePivot(parent)
b = CreatePivot(parent)
c = CreatePivot(parent)
Check "First", GetChild(parent, 1), a
Check "Second", GetChild(parent, 2), b
Check "Third", GetChild(parent, 3), c

; The middle one is freed, and its handle is used again for the new last child.
FreeEntity b
d = CreatePivot(parent)
Check "After a free, count", CountChildren(parent), 3
Check "After a free, first", GetChild(parent, 1), a
Check "After a free, second", GetChild(parent, 2), c
Check "After a free, the new one is last", GetChild(parent, 3), d

; A child that is moved away and back is the last child.
other = CreatePivot()
EntityParent a, other
Check "Moved away, count", CountChildren(parent), 2
Check "Moved away, first", GetChild(parent, 1), c
EntityParent a, parent
Check "Moved back, it is last", GetChild(parent, 3), a
Check "Moved back, count", CountChildren(parent), 3
Check "The other one has none", CountChildren(other), 0

; A copy keeps the order.
copy = CopyEntity(parent)
Check "Copy, count", CountChildren(copy), 3
Check "Copy, first is a copy of the first", EntityName$(GetChild(copy, 1)), EntityName$(GetChild(parent, 1))

; FindChild goes through the children, and the children go with a freed parent.
NameEntity d, "needle"
Check "FindChild", FindChild(parent, "needle"), d
FreeEntity parent
Check "The copy is not freed with the original", CountChildren(copy), 3

; 20000 children are found one by one without every lookup reading every entity (this used to take a minute).
big = CreatePivot()
For i = 1 To 20000
	CreatePivot big
Next
start = MilliSecs()
total = 0
For i = 1 To 20000
	If GetChild(big, i) <> 0 Then total = total + 1
Next
Check "All children are there", total, 20000
CheckTrue "Looking up 20000 children is quick", MilliSecs() - start < 5000
Done "blitz3d_entity_child_order"
