; AntiAlias, which needs a window and a GPU, so this is skipped without one. A white triangle on black has an edge that
; is a straight line, so how much of each pixel it covers is known. AntiAlias 1 (SMAA) has to bring the edge pixels
; close to that, 2 (SMAA T2x) too, 0 has to leave the picture as it is without it, and 2D drawing is never smoothed.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_antialias_pixels: skipped, there is no window."
	End
EndIf

Const SIZE = 128
Graphics3D SIZE, SIZE, 32, 2
SetBuffer BackBuffer()

Dim shot(SIZE * SIZE - 1)
Dim kept(SIZE * SIZE - 1)
Global ex1#, ey1#, ex2#, ey2#   ; The edge, in the world at a distance of 10 from the camera.

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0

; The triangle that has the line from (x1, y1) to (x2, y2) as one of its sides and is above it.
Function MakeTriangle(x1#, y1#, x2#, y2#)
	ex1 = x1 : ey1 = y1 : ex2 = x2 : ey2 = y2
	m = CreateMesh()
	s = CreateSurface(m)
	a = AddVertex(s, x1 - (x2 - x1) * 3, y1 - (y2 - y1) * 3, 10)
	b = AddVertex(s, x2 + (x2 - x1) * 3, y2 + (y2 - y1) * 3, 10)
	c = AddVertex(s, 0, 60, 10)
	AddTriangle s, a, c, b
	EntityFX m, 1 + 16   ; Fullbright, both sides.
	Return m
End Function

; How much of the pixel is above the edge: 8 by 8 samples. The projection puts the pixel (x, y) from x to x + 1 with
; its center at x + 0.5, and the picture of Direct3D 7 half a pixel to the right and down of that.
Function Coverage#(px, py)
	hit = 0
	For j = 0 To 7
		For i = 0 To 7
			cx# = px + (i + 0.5) / 8.0
			cy# = py + (j + 0.5) / 8.0
			wx# = (((cx - 0.5) / SIZE) - 0.5) * 2 * 10
			wy# = -(((cy - 0.5) / SIZE) - 0.5) * 2 * 10
			If (ex2 - ex1) * (wy - ey1) - (ey2 - ey1) * (wx - ex1) > 0 Then hit = hit + 1
		Next
	Next
	Return hit / 64.0
End Function

Function Grab()
	For y = 0 To SIZE - 1
		For x = 0 To SIZE - 1
			shot(y * SIZE + x) = ReadPixel(x, y, BackBuffer()) And $FFFFFF
		Next
	Next
End Function

Function Red(p)
	Return (p Shr 16) And 255
End Function

Function Draw()
	RenderWorld
End Function

; The mean difference from the coverage over the pixels that the edge goes through, and how many there are.
Global edge_pixels, worst#, untouched
Function EdgeError#()
	total# = 0 : edge_pixels = 0 : worst = 0 : untouched = 1
	For y = 0 To SIZE - 1
		For x = 0 To SIZE - 1
			c# = Coverage(x, y)
			v# = Red(shot(y * SIZE + x)) / 255.0
			If c > 0.0 And c < 1.0 Then
				e# = Abs(v - c)
				total = total + e
				If e > worst Then worst = e
				edge_pixels = edge_pixels + 1
			Else
				; Away from the edge there is nothing to smooth: a pixel with no coverage or all of it stays 0 or 255, a little further out at least.
				If (c = 0.0 And v > 0.02) Or (c = 1.0 And v < 0.98) Then
					If Abs(Coverage(x - 2, y)) = c And Abs(Coverage(x + 2, y)) = c And Abs(Coverage(x, y - 2)) = c And Abs(Coverage(x, y + 2)) = c Then untouched = 0
				EndIf
			EndIf
		Next
	Next
	Return total / edge_pixels
End Function

; Without AntiAlias the edge is aliased: every pixel is 0 or 255.
Local off_error#, one_error#, two_error#, same, k, i, x, y, p, bad, tex
tri = MakeTriangle(-12, -2.7, 12, 3.9)
AntiAlias 0
Draw()
Grab()
For i = 0 To SIZE * SIZE - 1
	kept(i) = shot(i)
Next
off_error# = EdgeError()
CheckTrue "The edge is seen", edge_pixels > 100
Print "AntiAlias 0: mean error " + off_error + " over " + edge_pixels + " pixels, worst " + worst

; 1: SMAA.
AntiAlias 1
Draw()
Grab()
one_error# = EdgeError()
Print "AntiAlias 1: mean error " + one_error + ", worst " + worst
CheckTrue "AntiAlias 1 is much closer to the coverage than the aliased edge (" + one_error + " against " + off_error + ")", one_error < off_error * 0.5
CheckTrue "AntiAlias 1 is close to the coverage (" + one_error + ")", one_error < 0.08
CheckTrue "AntiAlias 1 stays near the edge", untouched = 1

; 2: SMAA T2x, which takes a few pictures to have the one before.
AntiAlias 2
For k = 1 To 4
	Draw()
Next
Grab()
two_error# = EdgeError()
Print "AntiAlias 2: mean error " + two_error + ", worst " + worst
CheckTrue "AntiAlias 2 is much closer to the coverage than the aliased edge (" + two_error + " against " + off_error + ")", two_error < off_error * 0.5
CheckTrue "AntiAlias 2 is close to the coverage (" + two_error + ")", two_error < 0.1

; Off again: the same picture as before, to the last bit.
AntiAlias 0
Draw()
Grab()
same = 1
For i = 0 To SIZE * SIZE - 1
	If shot(i) <> kept(i) Then same = 0
Next
CheckTrue "AntiAlias 0 gives the picture it gave before", same

; A texture is not the BackBuffer, so 2 is 1 there: the same as 1, however many times it is drawn.
tex = CreateTexture(SIZE, SIZE, 1 + 256 + 4096)
AntiAlias 1
SetBuffer TextureBuffer(tex)
Draw()
For y = 0 To SIZE - 1
	For x = 0 To SIZE - 1
		kept(y * SIZE + x) = ReadPixel(x, y, TextureBuffer(tex)) And $FFFFFF
	Next
Next
AntiAlias 2
For k = 1 To 3
	Draw()
Next
same = 1
For y = 0 To SIZE - 1
	For x = 0 To SIZE - 1
		If (ReadPixel(x, y, TextureBuffer(tex)) And $FFFFFF) <> kept(y * SIZE + x) Then same = 0
	Next
Next
SetBuffer BackBuffer()
CheckTrue "AntiAlias 2 on a texture is AntiAlias 1", same
FreeTexture tex
FreeEntity tri

; 2D drawing is not smoothed, before RenderWorld or after it: a white line stays white and black.
AntiAlias 1
CameraClsMode camera, False, True
Color 255, 255, 255
Cls
Line 4, 4, 60, 40
tri = MakeTriangle(-4, -10, 12, -2)
Draw()
Line 10, 100, 70, 62
Grab()
bad = 0
For y = 0 To SIZE - 1
	For x = 0 To 70
		p = Red(shot(y * SIZE + x))
		If p <> 0 And p <> 255 And y < 48 Then bad = bad + 1
		If p <> 0 And p <> 255 And y > 60 And x < 75 And Coverage(x, y) = 0 Then bad = bad + 1
	Next
Next
Check "2D drawing keeps its pixels", Float(bad), 0.0, 0.0
Done "blitz3d_antialias_pixels"
