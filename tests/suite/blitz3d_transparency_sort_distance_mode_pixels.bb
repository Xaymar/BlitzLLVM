; TransparencySortDistanceMode, which needs a window and a GPU, so this is skipped without one. Two big see-through sprites overlap at the
; right of the picture. The blue one is in front (nearer along the view axis) but its center is far to the side, so by the distance
; in space it is the farther one. The original orders by the distance in space and draws it first, so the red one covers it; along
; the view axis the blue one is on top.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_transparency_sort_distance_mode_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 64
Graphics3D W, H, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100

Global far_one = CreateSprite()
PositionEntity far_one, 0, 0, 10
ScaleSprite far_one, 30, 30
EntityColor far_one, 255, 0, 0
EntityAlpha far_one, 0.5

Global near_one = CreateSprite()
PositionEntity near_one, 30, 0, 9
ScaleSprite near_one, 30, 30
EntityColor near_one, 0, 0, 255
EntityAlpha near_one, 0.5

Function Look(name$)
	RenderWorld
	Local pixel = ReadPixel(W * 3 / 4, H / 2, BackBuffer()) And $FFFFFF
	Local red = (pixel Shr 16) And 255
	Local blue = pixel And 255
	Return red - blue
End Function

; By default the distance in space decides, as in the original: the red sprite is drawn last.
CheckTrue "default: red on top", Look("default") > 20

TransparencySortDistanceMode 1
CheckTrue "view axis: blue on top", Look("view") < -20

TransparencySortDistanceMode 0
CheckTrue "back to the default: red on top", Look("off") > 20

Print "blitz3d_transparency_sort_distance_mode_pixels: " + suite_checks + " checks passed."
