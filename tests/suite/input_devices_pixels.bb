; Which devices there are: MouseDeviceCount MouseDeviceName MouseDeviceConnected KeyboardDeviceCount KeyboardDeviceName
; KeyboardDeviceConnected JoyDeviceCount JoyDeviceName JoyDeviceConnected. Plugging devices in and out is done with the
; +mID -mID +kID -kID +j -j items of BLITZLLVM_TEST_EVENTS, where +j attaches a joystick that isn't real.
Include "check.bb"

Graphics 160, 120, 32, 2
SetBuffer BackBuffer()

; There is always at least one mouse and one keyboard, and the first is connected and has a name.
Local mice = MouseDeviceCount()
Local keyboards = KeyboardDeviceCount()
CheckTrue "MouseDeviceCount is at least 1", mice >= 1
CheckTrue "KeyboardDeviceCount is at least 1", keyboards >= 1
CheckTrue "MouseDeviceConnected 0", MouseDeviceConnected(0)
CheckTrue "KeyboardDeviceConnected 0", KeyboardDeviceConnected(0)
CheckTrue "MouseDeviceName 0", Len(MouseDeviceName(0)) > 0
CheckTrue "KeyboardDeviceName 0", Len(KeyboardDeviceName(0)) > 0

; Devices that do not exist are not connected and have no name.
CheckFalse "MouseDeviceConnected -1", MouseDeviceConnected(-1)
CheckFalse "MouseDeviceConnected past the end", MouseDeviceConnected(1000)
CheckS "MouseDeviceName past the end", MouseDeviceName(1000), ""
CheckFalse "KeyboardDeviceConnected -1", KeyboardDeviceConnected(-1)
CheckFalse "KeyboardDeviceConnected past the end", KeyboardDeviceConnected(1000)
CheckS "KeyboardDeviceName past the end", KeyboardDeviceName(1000), ""
CheckFalse "JoyDeviceConnected -1", JoyDeviceConnected(-1)
CheckFalse "JoyDeviceConnected past the end", JoyDeviceConnected(1000)
CheckS "JoyDeviceName past the end", JoyDeviceName(1000), ""

; A mouse that is plugged in gets the next number, and keeps it when it is removed and plugged in again.
SetEnv "BLITZLLVM_TEST_EVENTS", "+m900"
Local m = FindMouse("Mouse 900")
CheckTrue "Plugged in mouse is found", m >= 0
CheckTrue "Plugged in mouse is connected", MouseDeviceConnected(m)
SetEnv "BLITZLLVM_TEST_EVENTS", "-m900"
CheckFalse "Removed mouse is not connected", MouseDeviceConnected(m)
CheckS "Removed mouse keeps its name", MouseDeviceName(m), "Mouse 900"
Local counted = MouseDeviceCount()
SetEnv "BLITZLLVM_TEST_EVENTS", "+m900"
CheckTrue "Mouse plugged in again is connected", MouseDeviceConnected(m)
CheckTrue "Mouse plugged in again keeps its number", FindMouse("Mouse 900") = m
CheckTrue "Mouse plugged in again adds no device", MouseDeviceCount() = counted
SetEnv "BLITZLLVM_TEST_EVENTS", "+m901"
CheckTrue "Another mouse gets a number of its own", MouseDeviceCount() = counted + 1

; The same for keyboards.
SetEnv "BLITZLLVM_TEST_EVENTS", "+k900"
Local k = FindKeyboard("Keyboard 900")
CheckTrue "Plugged in keyboard is found", k >= 0
CheckTrue "Plugged in keyboard is connected", KeyboardDeviceConnected(k)
SetEnv "BLITZLLVM_TEST_EVENTS", "-k900"
CheckFalse "Removed keyboard is not connected", KeyboardDeviceConnected(k)
CheckTrue "Removed keyboard stays counted", KeyboardDeviceCount() > k

; Joysticks: a virtual one is plugged in, takes a port, and leaves it not connected when removed.
Local joys = JoyDeviceCount()
SetEnv "BLITZLLVM_TEST_EVENTS", "+j"
CheckTrue "Plugged in joystick adds a port", JoyDeviceCount() = joys + 1
CheckTrue "Plugged in joystick is connected", JoyDeviceConnected(joys)
CheckS "Plugged in joystick has a name", JoyDeviceName(joys), "Virtual joystick"
Check "Plugged in joystick is a gamepad", JoyType(joys), 1
SetEnv "BLITZLLVM_TEST_EVENTS", "-j"
CheckFalse "Removed joystick is not connected", JoyDeviceConnected(joys)
Check "Removed joystick has no type", JoyType(joys), 0
CheckTrue "Removed joystick stays counted", JoyDeviceCount() = joys + 1
CheckS "Removed joystick keeps its name", JoyDeviceName(joys), "Virtual joystick"

Done "input_devices_pixels"

Function FindMouse(name$)
	Local i
	For i = 0 To MouseDeviceCount() - 1
		If MouseDeviceName(i) = name Then Return i
	Next
	Return -1
End Function

Function FindKeyboard(name$)
	Local i
	For i = 0 To KeyboardDeviceCount() - 1
		If KeyboardDeviceName(i) = name Then Return i
	Next
	Return -1
End Function
