; Pointer: the native pointer of the platform, written `Name*` or `Name:Pointer`. It is made from a whole number with Pointer,
; turned back with Int, Long, ULong and the like, compared with = <> < > <= >= and Null, and is a type for variables, arrays,
; parameters, results and fields. It does not take part in calculations, and a `*` that is followed by an operand is a multiplication.
Include "check.bb"

Type Holder
	Field address*
	Field other:Pointer
End Type

Function Same*(value*)
	Return value
End Function

Function Advance:Pointer(value:Pointer)
	Return Pointer(Long(value) + 8)
End Function

; Both notations are the same type, and a pointer starts as Null.
Local a*
Local b:Pointer
CheckTrue "short is Null", a = Null
CheckTrue "long is Null", b = Null
CheckFalse "Null is not set", a <> Null
CheckTrue "equal", a = b
Local truth = 0
If a Then truth = 1
CheckS "Null is false", Str(truth), "0"

; From and to whole numbers.
Local c* = Pointer(4096)
CheckS "Long", Str(Long(c)), "4096"
CheckS "Int", Str(Int(c)), "4096"
CheckS "ULong", Str(ULong(c)), "4096"
CheckS "Str", Str(c), "4096"
CheckS "UInt", Str(UInt(Pointer(3000000000))), "3000000000"
CheckS "Byte wraps", Str(Byte(Pointer(300))), "44"
CheckS "SatByte stops", Str(SatByte(Pointer(300))), "127"
If c Then truth = 1
CheckS "Address is true", Str(truth), "1"
If Pointer(0) Then truth = 2
CheckS "Zero is false", Str(truth), "1"
CheckTrue "Pointer of Null", Pointer(Null) = Null
CheckS "Pointer of a Long", Str(Long(Pointer(Long(4096)))), "4096"

; Comparisons use the address, without a sign.
Local d* = Pointer(8192)
CheckTrue "<>", c <> d
CheckTrue "<", c < d
CheckTrue "<=", c <= d
CheckTrue ">", d > c
CheckTrue ">=", d >= c
CheckFalse "= differs", c = d
CheckTrue "= same", c = Pointer(4096)
CheckTrue "Not Null", Not (c = Null)

; Variables of other kinds.
Dim list*(3)
list(2) = c
CheckS "Dim", Str(Long(list(2))), "4096"
CheckTrue "Dim Null", list(1) = Null
Local holder.Holder = New Holder
holder\address = c
holder\other = d
CheckS "Field", Str(Long(holder\address)), "4096"
CheckS "Field long", Str(Long(holder\other)), "8192"
CheckTrue "Field Null", Null = (New Holder)\address
Global global_pointer* = d
CheckS "Global", Str(Long(global_pointer)), "8192"
CheckS "Parameter and result", Str(Long(Same(c))), "4096"
CheckS "Long notation", Str(Long(Advance(c))), "4104"
CheckTrue "Null result", Same(Null) = Null

; A pointer can be as large as the platform has.
Local big* = Pointer(ULong(-1))
Local bits = 32
If Long(Pointer(4294967296)) <> 0 Then bits = 64
If bits = 64 Then
	CheckS "Largest", Str(ULong(big)), "18446744073709551615"
	CheckTrue "Largest is above", big > d
Else
	CheckS "Largest 32", Str(ULong(big)), "4294967295"
EndIf

; Multiplications are not pointers, whatever is next to the star.
Local x = 6, y = 7
CheckS "x*y", Str(x*y), "42"
CheckS "x* y", Str(x* y), "42"
CheckS "x *y", Str(x *y), "42"
CheckS "x*-y", Str(x*-y), "-42"
CheckS "x*(y)", Str((x)*(y)), "42"
CheckS "x*5", Str(x*5), "30"
CheckS "x*$10", Str(x*$10), "96"
CheckS "x*y*2", Str(x*y*2), "84"
CheckS "Min*", Str(Min(x*y, 5)), "5"
CheckS "Int*", Str(Int(x*0.5)), "3"
Done "pointer"
