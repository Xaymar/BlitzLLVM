; A Const is known everywhere in the program, no matter where it is declared, like in the original where all Consts are known
; before the first statement is compiled.
Include "check.bb"

; Used above its declaration, in the main program and in a function called from there.
Check "Const used before its declaration", EARLY, 42
CheckS "String Const used before its declaration", EARLY_NAME, "early"
Check "Float Const used before its declaration", EARLY_HALF, 0.5
Check "Const used in a function before its declaration", ReadEarly(), 42

; A Const made from another Const that is declared later.
Check "Const made from a later Const", DOUBLE_LATER, 84
Check "Const chain in any order", CHAIN_A, 13

; A Global made from a Const that comes later gets its value.
Global sized = EARLY + 1
Check "Global made from a later Const", sized, 43

; An array whose size is a later Const.
Global table[TABLE_SIZE]
table[TABLE_SIZE - 1] = 7
Check "Array sized by a later Const", table[TABLE_SIZE - 1], 7

Function ReadEarly()
	Return EARLY
End Function

Const DOUBLE_LATER = EARLY * 2
Const CHAIN_A = CHAIN_B + 1, CHAIN_B = CHAIN_C * 2, CHAIN_C = 6
Const EARLY = 42, EARLY_NAME$ = "early", EARLY_HALF# = 0.5
Const TABLE_SIZE = 4

Done "language_const_order"
