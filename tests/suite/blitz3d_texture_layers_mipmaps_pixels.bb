; Texture layers that have mipmaps and were drawn to with the drawing commands: the layers after the first need their smaller levels as
; much as the first texture does. The quad repeats the textures many times, so that the smaller levels are sampled. Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_texture_layers_mipmaps_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()
Global camera = CreateCamera()
PositionEntity camera, 0, 0, -3
CameraClsColor camera, 0, 0, 0
Global quad = CreateMesh()
s = CreateSurface(quad)
v = AddVertex(s, -4, 4, 0, 0, 0)    : VertexNormal s, v, 0, 0, -1
v = AddVertex(s, 4, 4, 0, 32, 0)    : VertexNormal s, v, 0, 0, -1
v = AddVertex(s, 4, -4, 0, 32, 32)  : VertexNormal s, v, 0, 0, -1
v = AddVertex(s, -4, -4, 0, 0, 32)  : VertexNormal s, v, 0, 0, -1
AddTriangle s, 0, 1, 2
AddTriangle s, 0, 2, 3
EntityFX quad, 1 ; Full bright: the lit color is the color of the entity.

Function Flat(r, g, b)
	Local t = CreateTexture(32, 32, 1 + 8 + 4096)
	SetBuffer TextureBuffer(t)
	Color r, g, b
	Rect 0, 0, 32, 32, 1
	SetBuffer BackBuffer()
	Return t
End Function

Function Center()
	RenderWorld
	Return ReadPixel(80, 60, BackBuffer()) And $FFFFFF
End Function

Function CheckPixel(name$, p, r, g, b, tolerance)
	Check name + " red", Float((p Shr 16) And 255), Float(r), Float(tolerance)
	Check name + " green", Float((p Shr 8) And 255), Float(g), Float(tolerance)
	Check name + " blue", Float(p And 255), Float(b), Float(tolerance)
End Function

Global a = Flat(200, 100, 50)
Global b = Flat(180, 90, 140)
Global c = Flat(60, 120, 30)
TextureBlend a, 2
TextureBlend b, 2
TextureBlend c, 2

EntityTexture quad, a, 0, 0
CheckPixel "one mipmapped texture", Center(), 200, 100, 50, 2

EntityTexture quad, b, 0, 1
CheckPixel "mipmapped layer", Center(), 200 * 180 / 255, 100 * 90 / 255, 50 * 140 / 255, 2

EntityTexture quad, c, 0, 2
CheckPixel "two mipmapped layers", Center(), 200 * 180 / 255 * 60 / 255, 100 * 90 / 255 * 120 / 255, 50 * 140 / 255 * 30 / 255, 2

; Drawn to again after it was used: the smaller levels have to follow.
SetBuffer TextureBuffer(b)
Color 255, 255, 255
Rect 0, 0, 32, 32, 1
SetBuffer BackBuffer()
CheckPixel "mipmapped layer drawn to again", Center(), 200 * 60 / 255, 100 * 120 / 255, 50 * 30 / 255, 2

Done "blitz3d_texture_layers_mipmaps_pixels"
