; Strings that are made, kept, handed over and given away again: the memory of a string is managed by the compiler, and
; this checks that what a program sees is what it would see if strings were never freed.
Include "check.bb"

Type Holder
	Field text$
	Field list$[3]
	Field number
End Type

Global kept$ = "global"
Dim words$(4)

; A function gets a copy: changing it does not change what the caller has.
Function Shout$(text$)
	text = Upper$(text) + "!"
	Return text
End Function
original$ = "hello"
CheckS "Shout$", Shout$(original), "HELLO!"
CheckS "The caller keeps its string", original, "hello"

; What is returned can be a local, a parameter, a field, a global or a constant.
Function FromLocal$()
	Local t$ = "lo" + "cal"
	Return t
End Function
Function FromGlobal$()
	Return kept
End Function
Function FromConstant$()
	Return "constant"
End Function
CheckS "Return a local", FromLocal$(), "local"
CheckS "Return a global", FromGlobal$(), "global"
CheckS "Return a constant", FromConstant$(), "constant"
kept = "changed"
CheckS "Return a global after it changed", FromGlobal$(), "changed"

; Many strings in one expression, and strings that are used after others were made.
a$ = "a"
b$ = "b"
c$ = a + b + FromLocal$() + Left$(Upper$(kept), 3) + Str(12) + Str(1.5)
CheckS "A long expression", c, "ablocalCHA121.5"
d$ = c
c = "other"
CheckS "A copy is a copy", d, "ablocalCHA121.5"
a = a + a
a = a + a
CheckS "Appending to itself", a, "aaaa"
a = a
CheckS "Assigning itself", a, "aaaa"
a = Left$(a, 2)
CheckS "Assigning a part of itself", a, "aa"

; A recursive function keeps its own strings.
Function Echo$(text$, n)
	If n <= 0 Then Return ""
	Return text + Echo$(text, n - 1)
End Function
CheckS "Recursion", Echo$("ab", 4), "abababab"

; Objects hold their strings, and free them when they are deleted.
h.Holder = New Holder
h\text = "field " + "text"
h\list[0] = "zero"
h\list[3] = "three"
h\number = 7
CheckS "Field", h\text, "field text"
CheckS "Array in a field", h\list[3], "three"
h\text = h\text + "!"
CheckS "Changed field", h\text, "field text!"
copy$ = h\text
Delete h
CheckS "What was copied stays", copy, "field text!"
Delete Each Holder

; Arrays
words(0) = "zero"
words(4) = words(0) + "four"
CheckS "Dim of strings", words(4), "zerofour"
words(4) = words(4) + "!"
CheckS "Dim element changes", words(4), "zerofour!"
Dim words$(2)
CheckS "Dim again makes it empty", words(1), ""

; Strings in loops and conditions.
total = 0
For i = 1 To 2000
	t$ = "x" + i
	If Len(t + "y") > 3 Then total = total + 1
	If Left$(t, 1) = "x" And Right$(t, 1) <> "q" Then total = total + 1
Next
Check "Strings in a loop", total, 1991 + 2000
text$ = ""
While Len(text) < 50
	text = text + Str(Len(text))
Wend
CheckTrue "A string that grows", Len(text) >= 50

; Select on strings, and Data.
Select Upper$(Left$("hello", 2))
	Case "HE" : r$ = "found" + "!"
	Default : r$ = "none"
End Select
CheckS "Select on a made string", r, "found!"
Restore names
Read first_name$, second_name$
CheckS "Read", first_name + "/" + second_name, "one/two"
.names
Data "one", "two"

Done "language_strings"
