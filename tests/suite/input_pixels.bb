; Keyboard and mouse input that arrives in a window, which needs a window and a GPU, so this is skipped without one:
; KeyHit MouseHit GetKey Input. Nobody presses anything during an automatic test, so the runtime is told to do it with the
; BLITZ_TEST_EVENTS environment variable: kN presses key N (a scancode), mN presses mouse button N, wN turns the wheel
; and tTEXT types TEXT, all separated by commas.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "input_pixels: skipped, there is no window."
	End
EndIf

Graphics 160, 120, 32, 2
SetBuffer BackBuffer()

; KeyHit is how often the key was pressed since it was asked for last, not just whether it was.
FlushKeys
SetEnv "BLITZ_TEST_EVENTS", "k1,k1,k1,k30"
Check "KeyHit counts presses", KeyHit(1), 3
Check "KeyHit starts over", KeyHit(1), 0
Check "KeyHit of another key", KeyHit(30), 1
Check "KeyHit of a key that was not pressed", KeyHit(31), 0
CheckFalse "KeyDown after the release", KeyDown(1)
SetEnv "BLITZ_TEST_EVENTS", "k57,k57"
FlushKeys
Check "FlushKeys forgets presses", KeyHit(57), 0

; MouseHit is how often the button was pressed since it was asked for last.
FlushMouse
SetEnv "BLITZ_TEST_EVENTS", "m1,m1,m1,m1,m2"
Check "MouseHit counts presses", MouseHit(1), 4
Check "MouseHit starts over", MouseHit(1), 0
Check "MouseHit of another button", MouseHit(2), 1
Check "MouseHit of a button that was not pressed", MouseHit(3), 0
SetEnv "BLITZ_TEST_EVENTS", "m3,m3"
FlushMouse
Check "FlushMouse forgets presses", MouseHit(3), 0

; The codes that GetKey gives for the keys that type nothing are the original's: Home 1, End 2, Delete 4, Up 28, Down 29,
; Right 30 and Left 31.
FlushKeys
SetEnv "BLITZ_TEST_EVENTS", "k199,k207,k211,k200,k208,k205,k203,k28,k14,k1"
Check "GetKey Home", GetKey(), 1
Check "GetKey End", GetKey(), 2
Check "GetKey Delete", GetKey(), 4
Check "GetKey Up", GetKey(), 28
Check "GetKey Down", GetKey(), 29
Check "GetKey Right", GetKey(), 30
Check "GetKey Left", GetKey(), 31
Check "GetKey Return", GetKey(), 13
Check "GetKey Backspace", GetKey(), 8
Check "GetKey Escape", GetKey(), 27
Check "GetKey is empty again", GetKey(), 0

; Input shows the prompt and what is typed in the window, and the line goes on below.
Function Lit(x, y, w, h)
	n = 0
	For yy = y To y + h - 1
		For xx = x To x + w - 1
			If (ReadPixel(xx, yy) And $FFFFFF) = $FFFFFF Then n = n + 1
		Next
	Next
	Return n
End Function

SetBuffer FrontBuffer()
ClsColor 0, 0, 0
Cls
Color 255, 255, 255
Locate 0, 8
FlushKeys
SetEnv "BLITZ_TEST_EVENTS", "tabc,k28"
line$ = Input$(">")
CheckS "Input returns what was typed", line$, "abc"
CheckTrue "Input draws the prompt in the window", Lit(0, 8, 8, 8) > 3
CheckTrue "Input draws the text in the window", Lit(8, 8, 24, 8) > 10
Check "Input leaves the line above", Lit(0, 0, 160, 8), 0
Check "Input goes to the next line", Lit(0, 16, 160, 8), 0
Print "Z"
CheckTrue "Print goes on below the input", Lit(0, 16, 8, 8) > 3

; The cursor keys, Home, End, Backspace, Delete and Escape edit the line.
SetEnv "BLITZ_TEST_EVENTS", "tabcd,k203,k203,tX,k14,k211,k28"
CheckS "Input edits in the middle", Input$(""), "abd"
SetEnv "BLITZ_TEST_EVENTS", "tbcd,k199,ta,k207,te,k205,k28"
CheckS "Input Home and End", Input$(""), "abcde"
SetEnv "BLITZ_TEST_EVENTS", "ttypo,k1,tword,k28"
CheckS "Input Escape clears the line", Input$(""), "word"
SetEnv "BLITZ_TEST_EVENTS", "k28"
CheckS "Input of nothing", Input$("Name? "), ""

; Input scrolls the window like Print when the line is at the bottom.
ClsColor 0, 0, 0
Cls
Locate 0, 112
SetEnv "BLITZ_TEST_EVENTS", "tX,k28"
CheckS "Input at the bottom", Input$(""), "X"
Print "Y"
CheckTrue "Input at the bottom keeps its line", Lit(0, 104, 8, 8) > 3
SetBuffer BackBuffer()

EndGraphics
Done "input_pixels"
