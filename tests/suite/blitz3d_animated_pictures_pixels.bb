; Animated pictures on the graphics card: the frames of images/anim.gif (red, green, blue, yellow, 16 by 8) come out as the
; right frames of an image and of a texture.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_animated_pictures_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Rgb(x, y)
	Return ReadPixel(x, y, BackBuffer()) And $FFFFFF
End Function

Dim want(3)
want(0) = $FF0000
want(1) = $00FF00
want(2) = $0000FF
want(3) = $FFFF00

img = LoadAnimImage("images/anim.gif", 0, 0, 0, 0)
For f = 0 To 3
	Cls
	DrawImage img, 10, 10, f
	Check "Frame " + f + " of the image", Rgb(14, 14), want(f)
	Check "Frame " + f + " of the image, last pixel", Rgb(25, 17), want(f)
Next

Local camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
Local cube = CreateCube()
EntityFX cube, 1
PositionEntity cube, 0, 0, 3
ClearTextureFilters
tex = LoadAnimTexture("images/anim.gif", 1, 0, 0, 0, 0)
For f = 0 To 3
	EntityTexture cube, tex, f
	RenderWorld
	Check "Frame " + f + " of the texture", Rgb(80, 60), want(f)
Next

EndGraphics
Done "blitz3d_animated_pictures_pixels"
