; A surface with more than 65535 vertices, which needs a window and a GPU, so this is skipped without one. The original
; Blitz3D has 16 bit indices and crashes in RenderWorld on this. Here a grid of 300 by 260 vertices (78000) is built with
; AddVertex and AddTriangle, the vertices from number 65536 on are blue and the ones before are red, so a picture of it
; shows if the vertices after the 16 bit boundary are drawn too.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_bigmesh_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function RGB_(x, y)
	Return ReadPixel(x, y, BackBuffer()) And $FFFFFF
End Function

Const COLS = 300
Const ROWS = 260

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, -3.2

mesh = CreateMesh()
surface = CreateSurface(mesh)
For y = 0 To ROWS - 1
	For x = 0 To COLS - 1
		index = AddVertex(surface, (x / (COLS - 1.0) - 0.5) * 4.0, 1.5 - (y / (ROWS - 1.0)) * 3.0, 0, 0, 0)
		If index < 65536 Then VertexColor surface, index, 255, 0, 0 Else VertexColor surface, index, 0, 0, 255
	Next
Next
For y = 0 To ROWS - 2
	For x = 0 To COLS - 2
		a = y * COLS + x
		AddTriangle surface, a, a + 1, a + COLS
		AddTriangle surface, a + 1, a + COLS + 1, a + COLS
	Next
Next
EntityFX mesh, 1 + 2
EntityColor mesh, 255, 255, 255

Check "Vertices are counted", CountVertices(surface), COLS * ROWS, 0
Check "Triangles are counted", CountTriangles(surface), (COLS - 1) * (ROWS - 1) * 2, 0
CheckTrue "More vertices than a 16 bit index holds", CountVertices(surface) > 65535
Check "The last vertex keeps its position", VertexY(surface, COLS * ROWS - 1), -1.5, 0.0001

RenderWorld
Check "All triangles are drawn", TrisRendered(), (COLS - 1) * (ROWS - 1) * 2, 0

red = 0
blue = 0
For y = 0 To 119
	For x = 0 To 159
		c = RGB_(x, y)
		If (c Shr 16) > 200 And (c And 255) < 60 Then red = red + 1
		If (c And 255) > 200 And (c Shr 16) < 60 Then blue = blue + 1
	Next
Next
CheckTrue "The first vertices are drawn (" + red + " pixels)", red > 1000
CheckTrue "The vertices after 65535 are drawn (" + blue + " pixels)", blue > 1000

; Row 218 is the last one that is only red, so the top of the picture is red and the bottom is blue.
c = RGB_(80, 28)
CheckTrue "Top of the grid is red", (c Shr 16) > 200 And (c And 255) < 60
c = RGB_(80, 92)
CheckTrue "Bottom of the grid is blue", (c And 255) > 200 And (c Shr 16) < 60

; Triangles that only use vertices beyond the boundary.
tail = CreateMesh()
ts = CreateSurface(tail)
For i = 0 To 65599
	AddVertex ts, 100, 100, 100, 0, 0
Next
v0 = AddVertex(ts, -1, -1, 0, 0, 0)
v1 = AddVertex(ts, 1, -1, 0, 0, 0)
v2 = AddVertex(ts, 0, 1, 0, 0, 0)
CheckTrue "Vertices of the triangle are beyond 65535", v0 > 65535
For i = v0 To v2
	VertexColor ts, i, 0, 255, 0
Next
AddTriangle ts, v0, v2, v1
EntityFX tail, 1 + 2
HideEntity mesh
RenderWorld
Check "The one triangle is drawn", TrisRendered(), 1, 0
c = RGB_(80, 70)
CheckTrue "Triangle from the far vertices is green", ((c Shr 8) And 255) > 200 And (c And 255) < 60

Done "blitz3d_bigmesh_pixels"
