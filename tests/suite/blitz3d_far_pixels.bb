; Meshes far away from the origin, which needs a window and a GPU, so this is skipped without one. Vertices are 32-bit
; floats, and a model far from the origin has to look the same as it does at the origin: the shape of the cube, the
; light on it, and the edge of a mesh whose vertices are all far away.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_far_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

; The columns and rows of the first and last pixel that are lit.
Global left, right, top, bottom
Function Extent()
	left = 9999 : right = -1 : top = 9999 : bottom = -1
	For y = 0 To 119
		For x = 0 To 159
			If R(x, y) > 128 Then
				If x < left Then left = x
				If x > right Then right = x
				If y < top Then top = y
				If y > bottom Then bottom = y
			EndIf
		Next
	Next
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0

; A small turned cube. The vertices are around the middle of the cube, so they are small numbers in the mesh.
cube = CreateCube()
EntityFX cube, 1
ScaleEntity cube, 0.3, 0.3, 0.3
TurnEntity cube, 10, 20, 30

PositionEntity cube, 0, 0, 0
PositionEntity camera, 0, 0, -4
RenderWorld
Extent()
ref_left = left : ref_right = right : ref_top = top : ref_bottom = bottom
CheckTrue "The cube is on the screen", right > left

For k = 1 To 3
	far# = 7777.7
	If k = 2 Then far# = 77777.7
	If k = 3 Then far# = 777777.7
	PositionEntity cube, far#, 0, 0
	PositionEntity camera, far#, 0, -4
	RenderWorld
	Extent()
	Check "Cube left " + far#, left, ref_left, 0
	Check "Cube right " + far#, right, ref_right, 0
	Check "Cube top " + far#, top, ref_top, 0
	Check "Cube bottom " + far#, bottom, ref_bottom, 0
Next
FreeEntity cube

; A mesh whose vertices are far away itself: a quad of 1 by 1 at the far end of the world, with the camera in front.
Function FarQuad(x#, y#, z#)
	m = CreateMesh()
	s = CreateSurface(m)
	a = AddVertex(s, x# - 0.5, y# - 0.5, z#)
	b = AddVertex(s, x# - 0.5, y# + 0.5, z#)
	c = AddVertex(s, x# + 0.5, y# + 0.5, z#)
	d = AddVertex(s, x# + 0.5, y# - 0.5, z#)
	AddTriangle s, a, b, c
	AddTriangle s, a, c, d
	EntityFX m, 1
	Return m
End Function

quad = FarQuad(0, 0, 0)
PositionEntity camera, 0, 0, -2
RenderWorld
Extent()
ref_left = left : ref_right = right : ref_top = top : ref_bottom = bottom
FreeEntity quad
quad = FarQuad(65536.0, 32768.0, 0)
PositionEntity camera, 65536.0, 32768.0, -2
RenderWorld
Extent()
Check "Far quad left", left, ref_left, 0
Check "Far quad right", right, ref_right, 0
Check "Far quad top", top, ref_top, 0
Check "Far quad bottom", bottom, ref_bottom, 0
FreeEntity quad

; Light: a ball and a light next to it, far from the origin, is lit the same as at the origin.
ball = CreateSphere(16)
ScaleEntity ball, 0.5, 0.5, 0.5
light = CreateLight(2)
LightRange light, 10
AmbientLight 0, 0, 0
PositionEntity ball, 0, 0, 0
PositionEntity light, -1, 1, -2
PositionEntity camera, 0, 0, -4
RenderWorld
near_left = R(70, 60) : near_right = R(90, 60)
CheckTrue "The ball is lit", near_left + near_right > 20
PositionEntity ball, 777777.7, 0, 0
PositionEntity light, 777777.7 - 1, 1, -2
PositionEntity camera, 777777.7, 0, -4
RenderWorld
Check "Light on the left far away", R(70, 60), near_left, 3
Check "Light on the right far away", R(90, 60), near_right, 3

Done "blitz3d_far_pixels"
