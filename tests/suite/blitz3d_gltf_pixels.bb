; How models from glTF files look, which needs a window and a GPU, so this is skipped without one: the front of a face (which stays the
; front when x is mirrored), colors, see-through, two-sided and unlit materials, and the picture inside a .glb file.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_gltf_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

camera = CreateCamera()
CameraClsColor camera, 10, 20, 30
AmbientLight 0, 0, 0
; The fronts of glTF look to +z, so the light shines to -z, and the camera is in front of them and looks back.
light = CreateLight()
RotateEntity light, 0, 180, 0

; Four squares in a row, 2 apart, which are 8 pixels to the unit at 10 away. Seen from the front, the first (red) is on the left.
row = LoadMesh("models/gltf_materials.glb")
CheckTrue "LoadMesh of the materials", row <> 0
Check "Four surfaces, one for each material", CountSurfaces(row), 4
PositionEntity camera, 0, 0, 10
RotateEntity camera, 0, 180, 0
RenderWorld
Check "Red square", R(56, 60), 255, 8
Check "Red square is only red", G(56, 60) + B(56, 60), 0, 8
; Half see-through blue over the color of the background.
Check "Glass red", R(72, 60), 5, 8
Check "Glass green", G(72, 60), 10, 8
Check "Glass blue", B(72, 60), 142, 12
Check "Two-sided square", G(88, 60), 255, 8
Check "Two-sided square is only green", R(88, 60) + B(88, 60), 0, 8
; Unlit means it is not dark without light, and the light does not change it.
Check "Lamp red", R(104, 60), 255, 8
Check "Lamp green", G(104, 60), 128, 8
Check "Lamp blue", B(104, 60), 0, 8
Check "Between the squares", R(64, 60), 10, 4

; From behind only the faces that are two-sided can be seen: the others are turned away.
PositionEntity camera, 0, 0, -10
RotateEntity camera, 0, 0, 0
RenderWorld
Check "Red square from behind is not there", R(104, 60), 10, 4
Check "Glass from behind is not there", B(88, 60), 30, 4
Check "Two-sided square from behind", G(72, 60), 255, 40
EndGraphics
Done "blitz3d_gltf_pixels"
