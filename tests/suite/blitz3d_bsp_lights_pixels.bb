; The light entities of a Quake 3 level become point lights that are children of the level: LoadBSP BSPLighting. Needs a
; window and a GPU, so this is skipped without one. The level is made here: one wall and an entities lump with two lights.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_bsp_lights_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

; The coordinates of Quake are turned: x is z, y is -x and z is y. The wall is at x = 100 and faces back to the camera.
Function WriteVertex(file, y#, z#)
	WriteFloat file, 100 : WriteFloat file, y : WriteFloat file, z
	WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
	WriteFloat file, -1 : WriteFloat file, 0 : WriteFloat file, 0
	WriteByte file, 100 : WriteByte file, 100 : WriteByte file, 100 : WriteByte file, 255
End Function

Function WriteLevel(name$, entities$)
	; A tessellated wall, so that the light of a vertex can be seen in the middle: 9 by 9 vertices.
	count = 81
	length = Len(entities) + 1
	vertices = 144 + length
	meshverts = vertices + count * 44
	faces = meshverts + 8 * 8 * 6 * 4
	file = WriteFile(name)
	WriteInt file, $50534249
	WriteInt file, 46
	For lump = 0 To 16
		If lump = 0 Then WriteInt file, 144 : WriteInt file, length
		If lump = 10 Then WriteInt file, vertices : WriteInt file, count * 44
		If lump = 11 Then WriteInt file, meshverts : WriteInt file, 8 * 8 * 6 * 4
		If lump = 13 Then WriteInt file, faces : WriteInt file, 104
		If lump <> 0 And lump <> 10 And lump <> 11 And lump <> 13 Then WriteInt file, faces + 104 : WriteInt file, 0
	Next
	For i = 1 To Len(entities)
		WriteByte file, Asc(Mid(entities, i, 1))
	Next
	WriteByte file, 0
	For y = 0 To 8
		For z = 0 To 8
			WriteVertex file, -80 + y * 20, -80 + z * 20
		Next
	Next
	For y = 0 To 7
		For z = 0 To 7
			a = y * 9 + z
			WriteInt file, a : WriteInt file, a + 9 : WriteInt file, a + 10
			WriteInt file, a : WriteInt file, a + 10 : WriteInt file, a + 1
		Next
	Next
	WriteInt file, -1 : WriteInt file, -1 : WriteInt file, 3 : WriteInt file, 0 : WriteInt file, count
	WriteInt file, 0 : WriteInt file, 8 * 8 * 6 : WriteInt file, -1
	For i = 1 To 4
		WriteInt file, 0
	Next
	For i = 1 To 12
		WriteFloat file, 0
	Next
	WriteInt file, 0 : WriteInt file, 0
	CloseFile file
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 90
AmbientLight 0, 0, 0

; One light 40 units in front of the wall's middle, in red, and one that is not a light.
entities$ = Chr(34) + "classname" + Chr(34) + " " + Chr(34) + "worldspawn" + Chr(34) + Chr(10)
entities$ = "{" + Chr(10) + entities + "}" + Chr(10)
entities$ = entities + "{" + Chr(10) + Chr(34) + "classname" + Chr(34) + " " + Chr(34) + "light" + Chr(34) + Chr(10)
entities$ = entities + Chr(34) + "origin" + Chr(34) + " " + Chr(34) + "60 0 0" + Chr(34) + Chr(10)
entities$ = entities + Chr(34) + "light" + Chr(34) + " " + Chr(34) + "40" + Chr(34) + Chr(10)
entities$ = entities + Chr(34) + "_color" + Chr(34) + " " + Chr(34) + "1 0.5 0" + Chr(34) + Chr(10) + "}" + Chr(10)
entities$ = entities + "{" + Chr(10) + Chr(34) + "classname" + Chr(34) + " " + Chr(34) + "info_player_deathmatch" + Chr(34) + Chr(10)
entities$ = entities + Chr(34) + "origin" + Chr(34) + " " + Chr(34) + "0 0 0" + Chr(34) + Chr(10) + "}" + Chr(10)

WriteLevel "suite_bsp_lights.bsp", entities
level = LoadBSP("suite_bsp_lights.bsp")
CheckTrue "LoadBSP of a level with lights", level <> 0
Check "Only the light entity became a light", CountChildren(level), 1
light = GetChild(level, 1)
CheckS "The light is a light", EntityClass$(light), "Light"
; Quake's 60, 0, 0 is 0, 0, 60 here.
Check "The light is where the map says, x", EntityX(light), 0, 0.01
Check "The light is where the map says, z", EntityZ(light), 60, 0.01

; Lightmaps are used (the default), so the level is drawn as it is and the light does not light it a second time.
RenderWorld
Check "The level is not lit by its lights with lightmaps on, red", R(80, 60), 100, 2
Check "The level is not lit by its lights with lightmaps on, blue", B(80, 60), 100, 2

; Vertex lighting: the lights of the map light the level, in the color of the map.
BSPLighting level, False
RenderWorld
CheckTrue "Lit by the light of the map, red", R(80, 60) > 40
CheckTrue "The light is orange: green is half of red", Abs(G(80, 60) - R(80, 60) / 2) < 6
Check "The light is orange: no blue", B(80, 60), 0, 2
CheckTrue "Farther from the light is darker", R(80, 60) > R(20, 60)

; The light is an ordinary entity: moving it away darkens the level, and hiding it turns it off.
near = R(80, 60)
PositionEntity light, 0, 0, -400
RenderWorld
CheckTrue "A moved light changes the level", R(80, 60) < near
PositionEntity light, 0, 0, 60
HideEntity light
RenderWorld
Check "A hidden light does not light the level", R(80, 60), 0, 2
ShowEntity light
BSPLighting level, True
RenderWorld
Check "Lightmaps on again", R(80, 60), 100, 2

FreeEntity level
DeleteFile "suite_bsp_lights.bsp"

Done "blitz3d_bsp_lights_pixels"
