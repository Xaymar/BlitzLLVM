; What movies put on the screen, which needs a window and a GPU, so this is skipped without one: DrawMovie. The movies in movies/ are
; red for a second, then green, then blue (see graphics_movies.bb).
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_movies_pixels: skipped, there is no window."
	End
EndIf

Graphics 320, 240, 32, 2
SetBuffer BackBuffer()

; The color at a pixel, which is not exact for movies: they are compressed and their colors are not RGB.
Function Near(name$, x, y, r, g, b)
	p = ReadPixel(x, y) And $FFFFFF
	pr = (p Shr 16) And 255
	pg = (p Shr 8) And 255
	pb = p And 255
	If Abs(pr - r) > 40 Or Abs(pg - g) > 40 Or Abs(pb - b) > 40 Then RuntimeError name + ": got " + pr + "," + pg + "," + pb + ", expected " + r + "," + g + "," + b
	suite_checks = suite_checks + 1
End Function

Dim files$(2)
files(0) = "movies/colors.mpg"
files(1) = "movies/colors.avi"
files(2) = "movies/colors.mp4"

For i = 0 To 2
	movie = OpenMovie(files(i))
	CheckTrue "OpenMovie of " + files(i), movie <> 0

	; Drawn at its size in the corner, and stretched in the middle.
	started = 0
	While MoviePlaying(movie)
		Color 40, 40, 40
		Cls
		DrawMovie movie, 0, 0
		DrawMovie movie, 100, 50, 128, 96
		If started = 0 Then started = MilliSecs()
		t = MilliSecs() - started

		; The middle of each second, with the movie on screen and stretched.
		If t > 400 And t < 700 Then
			Near files(i) + " red", 32, 24, 255, 0, 0
			Near files(i) + " red stretched", 164, 98, 255, 0, 0
			Near files(i) + " stretched is bigger", 220, 140, 255, 0, 0
			seen_red = 1
		EndIf
		If t > 1400 And t < 1700 Then
			Near files(i) + " green", 32, 24, 0, 255, 0
			Near files(i) + " green stretched", 164, 98, 0, 255, 0
			seen_green = 1
		EndIf
		If t > 2400 And t < 2700 Then
			Near files(i) + " blue", 32, 24, 0, 0, 255
			Near files(i) + " blue stretched", 164, 98, 0, 0, 255
			seen_blue = 1
		EndIf
		; Outside of the drawn movie nothing changed.
		Near files(i) + " outside", 90, 10, 40, 40, 40
		Flip 2
		Delay 10
		If t > 6000 Then RuntimeError files(i) + " did not end"
	Wend
	; The sound of a file that stores it later than the pictures must not keep the movie playing after its 3 seconds.
	CheckTrue files(i) + ": ends after about 3 seconds", t < 3600
	CheckTrue files(i) + ": red was seen", seen_red
	CheckTrue files(i) + ": green was seen", seen_green
	CheckTrue files(i) + ": blue was seen", seen_blue
	seen_red = 0
	seen_green = 0
	seen_blue = 0
	CloseMovie movie
Next

; SeekMovie shows the picture of the position it was given, not the pictures before it.
Dim seeks#(2)
seeks(0) = 2.0 : seeks(1) = 1.0 : seeks(2) = 0.2
For i = 0 To 2
	movie = OpenMovie(files(i))
	For j = 0 To 2
		SeekMovie movie, seeks(j)
		PauseMovie movie
		Delay 50
		Color 40, 40, 40
		Cls
		DrawMovie movie, 0, 0
		If j = 0 Then Near files(i) + " seeked to blue", 32, 24, 0, 0, 255
		If j = 1 Then Near files(i) + " seeked to green", 32, 24, 0, 255, 0
		If j = 2 Then Near files(i) + " seeked to red", 32, 24, 255, 0, 0
		PlayMovie movie
	Next
	CloseMovie movie
Next

Print "graphics_movies_pixels: " + suite_checks + " checks passed."
