; The keys of a frame are found in whatever order the frames are asked for: forward, backward, jumping, on a key and between two keys.
Include "check.bb"

Graphics3D 320, 240, 32, 2

Function WriteTag(file, tag$, size)
	For i = 1 To 4
		WriteByte file, Asc(Mid$(tag, i, 1))
	Next
	WriteInt file, size
End Function

Function WriteNodeHead(file, size, name$)
	WriteTag file, "NODE", size
	WriteByte file, Asc(name) : WriteByte file, 0
	WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
	WriteFloat file, 1 : WriteFloat file, 1 : WriteFloat file, 1
	WriteFloat file, 1 : WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0
End Function

; The position x of the key k is k * k, at the frame 10 * k, for k from 0 to 10 (a node of 42 bytes, ANIM 8 + 12, a node with 11 keys of 16
; bytes behind the flags: 42 + 8 + 4 + 176 = 230).
folder$ = "suite_tmp_anim_keys"
CreateDir folder
name$ = folder + "/keys.b3d"
file = WriteFile(name)
WriteTag file, "BB3D", 4 + 8 + 42 + 20 + 8 + 230
WriteInt file, 1
WriteNodeHead file, 42 + 20 + 8 + 230, "r"
WriteTag file, "ANIM", 12
WriteInt file, 0 : WriteInt file, 100 : WriteFloat file, 60
WriteNodeHead file, 230, "c"
WriteTag file, "KEYS", 180
WriteInt file, 1
For k = 0 To 10
	WriteInt file, 10 * k
	WriteFloat file, k * k : WriteFloat file, 0 : WriteFloat file, 0
Next
CloseFile file

model = LoadAnimMesh(name)
CheckTrue "LoadAnimMesh of the keys", model <> 0
child = GetChild(model, 1)
CheckTrue "The node with the keys", child <> 0

; The x where the keys say it is at a frame.
Function Expected#(frame#)
	k = Floor(frame / 10)
	If k >= 10 Then Return 100.0
	Return k * k + ((k + 1) * (k + 1) - k * k) * (frame - 10 * k) / 10.0
End Function

; Forward, one frame at a time.
For f = 0 To 100 Step 3
	SetAnimTime model, f
	Check "Forward " + f, EntityX(child), Expected(f)
Next
; Backward.
For f = 100 To 0 Step -7
	SetAnimTime model, f
	Check "Backward " + f, EntityX(child), Expected(f)
Next
; Jumping around, and on the keys.
Dim jump(11)
jump(0) = 95 : jump(1) = 5 : jump(2) = 50 : jump(3) = 49 : jump(4) = 51 : jump(5) = 10 : jump(6) = 20
jump(7) = 0 : jump(8) = 100 : jump(9) = 33 : jump(10) = 34 : jump(11) = 12
For i = 0 To 11
	SetAnimTime model, jump(i)
	Check "Jump to " + jump(i), EntityX(child), Expected(jump(i))
Next

FreeEntity model
DeleteFile name
DeleteDir folder
Done "blitz3d_anim_keys"
