; ProfileEnable ProfileFPS ProfileSample: they work in programs made with --profile (and -d), and do nothing in the others,
; so a program can keep them either way. What they print is checked by the profile-* tests of the command line.
Include "check.bb"

ProfileEnable 1
ProfileFPS 0
ProfileFPS 1
ProfileEnable 0
ProfileFPS 0
ProfileEnable 2
ProfileEnable 0
ProfileEnable 1
CheckTrue "the commands of profiling can be called in any order", True

; The results can be taken into the program. Without --profile (or -d) there is nothing to take, with it nothing happens until a frame is flipped.
ProfileOutput ""
ProfileCapture 1
CheckTrue "ProfileText$ is a string", Len(ProfileText$()) >= 0
ProfileCapture 0
ProfileFrames 1
ProfileFrames 0
ProfileSlow 5
ProfileSlow 0
CheckTrue "the frame count is not negative", ProfileFrameCount() >= 0
CheckTrue "a frame that is not kept is 0", ProfileFrameValue(100000, 0) = 0
CheckTrue "a frame number that is not kept is 0", ProfileFrameNumber(-1) = 0
CheckTrue "there is a name for every item", ProfileItemName$(0) <> "" And ProfileItemName$(ProfileItemCount() - 1) <> ""
CheckTrue "no name for an item that does not exist", ProfileItemName$(ProfileItemCount()) = ""

; Sampling starts and stops, also twice in a row and without having started.
ProfileSample ""
file$ = SystemProperty$("tempdir") + "blitzllvm_profile_sample.bin"
ProfileSample file
Delay 50
ProfileSample file
ProfileSample ""
ProfileSample ""
DeleteFile file
DeleteFile file + ".stacks"
DeleteFile file + ".txt"
CheckTrue "ProfileSample starts and stops", True

; The program goes on as before.
start = MilliSecs()
Delay 20
CheckTrue "the program runs on", MilliSecs() - start >= 15
