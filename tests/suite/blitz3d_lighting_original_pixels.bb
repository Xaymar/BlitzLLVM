; Lighting against what the original Blitz3D 1.118 draws: the expected pixels were read from the original (Direct3D 7 through
; Wine) with tests/lighting_compare/probe.bb and terrain.bb, and every one has to be within 8 levels (3%). It covers the
; attenuation of point and spot lights (range / distance, not clamped), EntityShininess and UpdateNormals on irregular terrain.
; Skipped without a window.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_lighting_original_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

Const TOLERANCE = 8

Function CheckPixel(name$, x, y, wr, wg, wb)
	Check name$ + " red at " + x + "," + y, R(x, y), wr, TOLERANCE
	Check name$ + " green at " + x + "," + y, G(x, y), wg, TOLERANCE
	Check name$ + " blue at " + x + "," + y, B(x, y), wb, TOLERANCE
End Function

; Grey values of a row of the quad at x = 34, 52, 70, 88, 106 and 124 (y = 60).
Function CheckRow(name$, a, b, c, d, e, f)
	CheckPixel name$, 34, 60, a, a, a
	CheckPixel name$, 52, 60, b, b, b
	CheckPixel name$, 70, 60, c, c, c
	CheckPixel name$, 88, 60, d, d, d
	CheckPixel name$, 106, 60, e, e, e
	CheckPixel name$, 124, 60, f, f, f
End Function

camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100

; 16 x 16 quads, 6 wide, facing the camera.
quad = CreateMesh()
s = CreateSurface(quad)
For iy = 0 To 16
For ix = 0 To 16
	v = AddVertex(s, -3 + ix * 6.0 / 16, 3 - iy * 6.0 / 16, 0)
	VertexNormal s, v, 0, 0, -1
Next
Next
For iy = 0 To 15
For ix = 0 To 15
	a = iy * 17 + ix
	AddTriangle s, a, a + 1, a + 17
	AddTriangle s, a + 1, a + 18, a + 17
Next
Next

AmbientLight 0, 0, 0
EntityColor quad, 100, 100, 100
light = CreateLight(2)
PositionEntity light, 0, 0, -3

; The factor is range / distance: 10 / 3 at the middle is above one, and 5 / 3 is not.
LightRange light, 10
RenderWorld
CheckRow "Point light, range 10", 174, 245, 255, 255, 250, 181
LightRange light, 5
RenderWorld
CheckRow "Point light, range 5", 87, 124, 159, 162, 129, 91
LightRange light, 1000
RenderWorld
CheckRow "Point light, range 1000", 255, 255, 255, 255, 255, 255
PositionEntity light, 0, 0, -0.5
LightRange light, 10
RenderWorld
CheckRow "Point light close by", 59, 155, 255, 255, 178, 65

; Spot lights are attenuated as well, and the highlight of a point light is as bright as that makes it.
FreeEntity light
light = CreateLight(3)
PositionEntity light, 0, 0, -3
LightRange light, 20
EntityColor quad, 150, 150, 150
LightConeAngles light, 45, 45
RenderWorld
CheckPixel "Spot light 45 45", 70, 60, 255, 255, 255
CheckPixel "Spot light 45 45 outside", 34, 60, 0, 0, 0

FreeEntity light
light = CreateLight(2)
PositionEntity light, 1, 1, -3
LightRange light, 20
EntityColor quad, 60, 60, 60
EntityShininess quad, 0.5
RenderWorld
CheckRow "Shininess 0.5", 144, 205, 255, 255, 255, 255
EntityShininess quad, 0.1
RenderWorld
CheckRow "Shininess 0.1", 147, 222, 255, 255, 255, 255
EntityShininess quad, 0

; A negative light subtracts, and that is not capped at what a light of that range would give.
FreeEntity light
light = CreateLight()
RotateEntity light, 30, 20, 0
l2 = CreateLight(2)
PositionEntity l2, -1, 0, -2
LightRange l2, 8
LightColor l2, 0, 200, 255
EntityColor quad, 120, 120, 120
AmbientLight 30, 30, 30
RenderWorld
CheckPixel "Two lights", 88, 60, 112, 255, 255
CheckPixel "Two lights at the side", 124, 60, 112, 195, 218
LightColor l2, -255, -255, -255
RenderWorld
CheckPixel "Negative light", 52, 60, 0, 0, 0

; Terrain with vertex colors, like the waterfall benchmark: the normals come from UpdateNormals, which adds the unit normals
; of all triangles at a position.
FreeEntity quad
FreeEntity light
FreeEntity l2
Function Height#(x#, z#)
	Return 1.5 * Sin(x * 9) * Cos(z * 7) + 0.4 * x
End Function
m = CreateMesh()
s = CreateSurface(m)
For iz = 0 To 24
	For ix = 0 To 24
		x# = ix - 12
		z# = iz - 12
		AddVertex s, x, Height(x, z), z
		VertexColor s, iz * 25 + ix, 55 + ix * 6, 115 + iz * 3, 45 + (ix + iz) * 2
	Next
Next
For iz = 0 To 23
	For ix = 0 To 23
		a = iz * 25 + ix
		AddTriangle s, a, a + 25, a + 1
		AddTriangle s, a + 1, a + 25, a + 26
	Next
Next
UpdateNormals m
EntityFX m, 2
CameraClsColor camera, 150, 185, 225
PositionEntity camera, 0, 14, -16
RotateEntity camera, 40, 0, 0
light = CreateLight()
RotateEntity light, 50, -30, 0
AmbientLight 90, 90, 90
RenderWorld
CheckPixel "Terrain", 60, 50, 99, 232, 125
CheckPixel "Terrain", 90, 50, 167, 186, 122
CheckPixel "Terrain", 120, 50, 213, 175, 128
CheckPixel "Terrain", 60, 70, 108, 180, 97
CheckPixel "Terrain", 90, 70, 167, 165, 106
CheckPixel "Terrain", 120, 70, 209, 163, 116
CheckPixel "Terrain", 60, 90, 114, 149, 80
CheckPixel "Terrain", 90, 90, 165, 150, 95
CheckPixel "Terrain", 120, 90, 203, 152, 107
CheckPixel "Terrain", 30, 110, 70, 132, 57
CheckPixel "Terrain", 60, 110, 120, 134, 73
CheckPixel "Terrain", 90, 110, 163, 139, 87

Done "blitz3d_lighting_original_pixels"
