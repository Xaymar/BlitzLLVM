; Type suffixes on a use of a name: a Local, Global, parameter or function that was declared without a type is an Int, and
; Int%, Float# and Str$ accept the suffix of their own type. Like in the original, a later use never gives a type to a name that
; was declared without one, see reject/suffix_*.bb for what is refused.
Include "check.bb"

Global shared
shared% = 4
Global text$
text$ = "global"

Function Log__Label$(level)
	If level = 0 Then Return "INFO"
	Return "WARN"
End Function

Function Format$(level, msg$)
	Local ln$
	ln$ = "[" + Right$("00000000" + Str$(MilliSecs()), 8) + "] " + Log__Label$(level) + " " + msg$
	Return ln
End Function

Function Twice(value)
	Return value% * 2
End Function

; An untyped Float parameter would be an Int, so the 1.9 is cut off.
Function Cut(value)
	Return value
End Function

Local line$ = Format(1, "hello")
CheckS "line end", Right$(line, 10), "WARN hello"
CheckS "line start", Left$(line, 1), "["
CheckS "line bracket", Mid$(line, 10, 2), "] "

Check "function", Twice%(3), 6
Check "parameter", Cut(1.9), 2
Check "global", shared, 4
CheckS "typed global", text, "global"

Local number
number = 1.5
Check "untyped local is an Int", number, 2
Local real#
real# = 1.5
Check "float local", real, 1.5

CheckS "Str$", Str$(12) + Str$ 3, "123"
Check "Int%", Int%(2.4), 2
Check "Float#", Float#(3) / 2, 1.5

Done "language_suffixes"
