; Type suffixes on a use of a name: a Local, Global, parameter or function that was declared without a type is given the
; type of the suffix, and Int%, Float# and Str$ accept the suffix of their own type.
Include "check.bb"

Global shared
shared$ = "global"

Function Log__Label$(level)
	If level = 0 Then Return "INFO"
	Return "WARN"
End Function

; The line of the logger this was found with.
Function Format$(level, msg)
	Local ln
	ln$ = "[" + Right$("00000000" + Str$(MilliSecs()), 8) + "] " + Log__Label$(level) + " " + msg$
	Return ln
End Function

Function Late$(value)
	Return value$ + "!"
End Function

Function Later(value)
	Return value$
End Function

; The suffix of the use comes before the declaration of the function.
CheckS "call before the declaration", Later$("text"), "text"

Local line$ = Format(1, "hello")
CheckS "line end", Right$(line, 10), "WARN hello"
CheckS "line start", Left$(line, 1), "["
CheckS "line bracket", Mid$(line, 10, 2), "] "

CheckS "parameter", Late("a"), "a!"
CheckS "global", shared, "global"

Local name
name$ = "propagated"
CheckS "local", name, "propagated"
Local number
number# = 1.5
Check "float local", number, 1.5

CheckS "Str$", Str$(12) + Str$ 3, "123"
Check "Int%", Int%(2.4), 2
Check "Float#", Float#(3) / 2, 1.5

Done "language_suffixes"
