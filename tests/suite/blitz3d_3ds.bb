; Loading .3ds models of 3D Studio with LoadMesh and LoadAnimMesh: meshes, smoothing groups, materials, hierarchies, keys, lights
; and cameras. models/ has the models, which tools/generate_3ds_fixtures.py writes. 3D Studio has z up and is right-handed, so
; its y becomes z and its z becomes y here.
Include "check.bb"

Graphics3D 320, 240, 32, 2

; A mesh with a square: its vertices are as the file says, with y and z swapped, and every face looks up.
quad = LoadMesh("models/quad.3ds")
CheckTrue "LoadMesh of a .3ds", quad <> 0
Check "The square has a surface", CountSurfaces(quad), 1
s = GetSurface(quad, 1)
Check "Square vertices", CountVertices(s), 4
Check "Square triangles", CountTriangles(s), 2
Check "Corner 0 x", VertexX(s, 0), -1
Check "Corner 0 y", VertexY(s, 0), 0
Check "Corner 0 z", VertexZ(s, 0), -1
Check "Corner 1 x", VertexX(s, 1), 1
Check "Corner 1 z", VertexZ(s, 1), 1
Check "Corner 2 z", VertexZ(s, 2), -1
Check "Normal y", VertexNY(s, 0), 1, 0.001
Check "Normal x", VertexNX(s, 0), 0, 0.001
; The pictures of 3D Studio start at the bottom, those of Blitz3D at the top.
Check "Corner 0 u", VertexU(s, 0), 0
Check "Corner 0 v", VertexV(s, 0), 1
Check "Corner 1 u", VertexU(s, 1), 1
Check "Corner 1 v", VertexV(s, 1), 0
; The corners of a face go around the other way, so the vertices come in the order 0, 2, 1 of the file for the first face.
Check "Triangle 0 first", TriangleVertex(s, 0, 0), 0
Check "Triangle 0 second", TriangleVertex(s, 0, 1), 1
Check "Triangle 0 third", TriangleVertex(s, 0, 2), 2
Check "Triangle 1 second", TriangleVertex(s, 1, 1), 3
Check "Triangle 1 third", TriangleVertex(s, 1, 2), 1
Check "Square is 2 wide", MeshWidth(quad), 2
Check "Square is flat", MeshHeight(quad), 0
Check "Square is 2 deep", MeshDepth(quad), 2

; LoadAnimMesh of a model without keys has a node for each object below a pivot.
whole = LoadAnimMesh("models/quad.3ds")
CheckTrue "LoadAnimMesh of a .3ds", whole <> 0
Check "A pivot with the square", CountChildren(whole), 1
CheckS "The square keeps its name", EntityName(GetChild(whole, 1)), "quad"
Check "Not animated", AnimLength(whole), -1

; The picture of the material is found next to the file, and tiled as the material says.
tex = LoadMesh("models/textured.3ds")
CheckTrue "LoadMesh with a picture", tex <> 0
s = GetSurface(tex, 1)
brush = GetSurfaceBrush(s)
CheckTrue "The material has a picture", GetBrushTexture(brush) <> 0
Check "The picture is 8 wide", TextureWidth(GetBrushTexture(brush)), 8
Check "Tiled twice across", VertexU(s, 1), 2
Check "Tiled once up", VertexV(s, 1), 0

; Faces in one smoothing group share their vertices and have one normal there; faces in different groups do not. Both folds have the
; same material, so LoadMesh puts them into one surface (as the original does for parts with the same brush): the vertices of "smooth"
; come first, then those of "hard".
folds = LoadMesh("models/smooth.3ds")
Check "Two folds, one surface for the material", CountSurfaces(folds), 1
both = GetSurface(folds, 1)
Check "Smooth and hard vertices", CountVertices(both), 10
; The edge between the folds is along z at the origin. The ground is flat and the other fold leans towards x (3D Studio's z is up).
found = 0
For i = 0 To 3
	If Abs(VertexX(both, i)) < 0.001 And Abs(VertexZ(both, i)) < 0.001 Then
		found = found + 1
		Check "Smooth normal x", VertexNX(both, i), 0.447, 0.01
		Check "Smooth normal y", VertexNY(both, i), 0.894, 0.01
	EndIf
Next
Check "One vertex at the edge when smooth", found, 1
ground = 0 : leaning = 0
For i = 4 To 9
	If Abs(VertexX(both, i)) < 0.001 And Abs(VertexZ(both, i)) < 0.001 Then
		If Abs(VertexNX(both, i)) < 0.01 Then
			ground = ground + 1
			Check "Ground normal y", VertexNY(both, i), 1, 0.01
		Else
			leaning = leaning + 1
			Check "Leaning normal x", VertexNX(both, i), 0.707, 0.01
			Check "Leaning normal y", VertexNY(both, i), 0.707, 0.01
		EndIf
	EndIf
Next
Check "Two vertices at the edge when hard", ground + leaning, 2
Check "A ground one", ground, 1

; Keys: nodes are pivots and meshes below the model, in the order that the file makes them.
model = LoadAnimMesh("models/anim.3ds")
CheckTrue "LoadAnimMesh with keys", model <> 0
Check "Plays 20 frames", AnimLength(model), 20
arm = FindChild(model, "arm") : tip = FindChild(model, "tip") : holder = FindChild(model, "holder") : grow = FindChild(model, "grow")
CheckTrue "The nodes are there", arm <> 0 And tip <> 0 And holder <> 0 And grow <> 0
CheckS "The tip is in the arm", EntityName(GetParent(tip)), "arm"
CheckS "The dummy has the name of its instance", EntityClass(holder), "Pivot"
CheckS "The grower is in the dummy", EntityName(GetParent(grow)), "holder"

; At the start: the arm is at x = 2 with its corner at its own origin, and the node below hangs 5 along x.
SetAnimTime model, 0
Check "Arm x at 0", EntityX(arm, True), 2, 0.001
Check "Arm yaw at 0", EntityYaw(arm), 0, 0.01
Check "Tip x at 0", EntityX(tip, True), 7, 0.001
Check "Dummy y", EntityY(holder, True), 4, 0.001
Check "Grower z", EntityZ(grow, True), 10, 0.001
TFormVector 1, 0, 0, grow, 0
Check "Grower scale at 0", TFormedX(), 1, 0.001
s = GetSurface(arm, 1)
Check "Arm corner is at the origin of the arm", VertexX(s, 0), 0, 0.001
Check "Arm corner 1", VertexX(s, 2), 1, 0.001
Check "Arm corner 2 is ahead", VertexZ(s, 1), 1, 0.001
s = GetSurface(tip, 1)
Check "Tip corner is at its origin", VertexX(s, 0), 0, 0.001

; A turn about up in 3D Studio is a yaw, which turns the front to the left; the arm moves 4 along y, which is z.
SetAnimTime model, 10
Check "Arm z at 10", EntityZ(arm, True), 4, 0.001
Check "Arm yaw at 10", EntityYaw(arm), 90, 0.01
Check "Tip x at 10", EntityX(tip, True), 2, 0.001
Check "Tip z at 10", EntityZ(tip, True), 9, 0.001
TFormVector 1, 0, 0, grow, 0
Check "Grower scale at 10", TFormedX(), 2, 0.001
; Every key turns on top of the one before it, so the second 90 makes 180.
SetAnimTime model, 20
Check "Tip x at 20", EntityX(tip, True), -3, 0.001
Check "Tip z at 20", EntityZ(tip, True), 4, 0.001
SetAnimTime model, 5
Check "Arm yaw at 5", EntityYaw(arm), 45, 0.1
Check "Arm z at 5", EntityZ(arm, True), 2, 0.001

; LoadMesh makes one mesh of it, as it is at the start.
flat = LoadMesh("models/anim.3ds")
Check "One mesh has one surface for the brush that every node has", CountSurfaces(flat), 1
Check "As the file has it, x", EntityX(flat), 0
Check "Reaches the tip", MeshWidth(flat), 8, 0.01

; Lights and cameras: lights are lights, and a camera is a pivot that looks at its target.
extras = LoadAnimMesh("models/extras.3ds")
CheckTrue "LoadAnimMesh with lights", extras <> 0
omni = FindChild(extras, "omni") : lamp = FindChild(extras, "lamp") : mover = FindChild(extras, "mover") : view = FindChild(extras, "view")
CheckTrue "The extras are there", omni <> 0 And lamp <> 0 And mover <> 0 And view <> 0
CheckS "A light", EntityClass(omni), "Light"
Check "At x", EntityX(omni, True), 1
Check "At y (3D Studio z)", EntityY(omni, True), 3
Check "At z (3D Studio y)", EntityZ(omni, True), 2
CheckS "A camera is a pivot", EntityClass(view), "Pivot"
Check "The camera looks at the middle", EntityYaw(view), 0, 0.1
Check "The camera is behind", EntityZ(view, True), -10
; Looking along x turns the front to the right, which is a yaw of -90.
Check "The spot light looks along x", EntityYaw(lamp, True), -90, 0.1
; The ghost is hidden, so a mesh of it all leaves it out.
CheckTrue "The hidden mesh is there", FindChild(extras, "ghost") <> 0
Check "A hidden mesh is left out", CountSurfaces(LoadMesh("models/extras.3ds")), 0
; The target moves from x to y (z in Blitz3D), so the light that looks at it turns from -90 to 0.
SetAnimTime extras, 0
Check "Looks along x at 0", EntityYaw(mover, True), -90, 0.1
SetAnimTime extras, 10
Check "Looks along z at 10", EntityYaw(mover, True), 0, 0.1
SetAnimTime extras, 5
Check "Between at 5", EntityYaw(mover, True), -45, 0.1

; Not a model, and not there.
CheckFalse "A file that is not there", LoadMesh("models/missing.3ds") <> 0
file = WriteFile("suite_broken.3ds")
WriteShort file, $4D4D : WriteInt file, 200 : WriteShort file, $3D3D : WriteInt file, 5000
CloseFile file
CheckFalse "A file that ends too early", LoadMesh("suite_broken.3ds") <> 0
DeleteFile "suite_broken.3ds"
EndGraphics
Done "blitz3d_3ds"
