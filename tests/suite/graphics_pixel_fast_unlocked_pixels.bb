; ReadPixelFast, WritePixelFast, CopyPixelFast and their 64 bit twins on a buffer that is not locked, which needs a window and a GPU so this
; is skipped without one. A build without -d does nothing (a read gives 0), and a debug build stops with an error (tests/suite/fail/pixel_fast_*).
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_pixel_fast_unlocked_pixels: skipped, there is no window."
	End
EndIf

; The debug build is the one that stops, and the programs in fail/ look at that.
If GetEnv$("BLITZLLVM_TEST_DEBUG") <> "" Then End

Graphics 64, 48, 32, 2
SetBuffer BackBuffer()
ClsColor 0, 0, 0
Cls
WritePixel 3, 3, $123456

Check "ReadPixelFast unlocked", ReadPixelFast(3, 3), 0
Check "ReadPixelFast64 unlocked", ReadPixelFast64(3, 3, 0), 0
WritePixelFast 4, 4, $FFFFFF
WritePixelFast64 5, 5, 0, 1.0, 1.0, 1.0, 1.0
CopyPixelFast 3, 3, BackBuffer(), 6, 6, BackBuffer()
Check "WritePixelFast unlocked", ReadPixel(4, 4) And $FFFFFF, 0
Check "WritePixelFast64 unlocked", ReadPixel(5, 5) And $FFFFFF, 0
Check "CopyPixelFast unlocked", ReadPixel(6, 6) And $FFFFFF, 0
Check "The pixel stays", ReadPixel(3, 3) And $FFFFFF, $123456

; Locked, they work as before.
LockBuffer BackBuffer()
Check "ReadPixelFast locked", ReadPixelFast(3, 3) And $FFFFFF, $123456
UnlockBuffer BackBuffer()
