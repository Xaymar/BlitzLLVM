; How a model of Quake 2 looks while it plays: the vertices are written straight from the frames, also while changing from one animation to the next.
Include "check.bb"

Graphics3D 320, 240, 32, 2

; A model of Quake 2 with one triangle in two frames, made here. The second frame has twice the size, and is moved.
name$ = "suite_model.md2"
file = WriteFile(name)
WriteInt file, $32504449 ; IDP2
WriteInt file, 8
WriteInt file, 64
WriteInt file, 64
WriteInt file, 52      ; Size of a frame: scale, translation, name and 3 vertices
WriteInt file, 0
WriteInt file, 3
WriteInt file, 3
WriteInt file, 1
WriteInt file, 0
WriteInt file, 2
WriteInt file, 68      ; Skins
WriteInt file, 68      ; Texture coordinates
WriteInt file, 80      ; Triangles
WriteInt file, 92      ; Frames
WriteInt file, 196     ; Commands
WriteInt file, 196     ; End
WriteShort file, 0 : WriteShort file, 0
WriteShort file, 32 : WriteShort file, 0
WriteShort file, 0 : WriteShort file, 32
WriteShort file, 0 : WriteShort file, 1 : WriteShort file, 2
WriteShort file, 0 : WriteShort file, 1 : WriteShort file, 2
For frame = 0 To 1
	scale# = 1
	If frame = 1 Then scale = 2
	WriteFloat file, scale
	WriteFloat file, scale
	WriteFloat file, scale
	If frame = 0
		WriteFloat file, 0
		WriteFloat file, 0
		WriteFloat file, 0
	Else
		WriteFloat file, 1
		WriteFloat file, 2
		WriteFloat file, 3
	EndIf
	For i = 1 To 16
		WriteByte file, 0
	Next
	WriteByte file, 0 : WriteByte file, 0 : WriteByte file, 0 : WriteByte file, 0
	WriteByte file, 0 : WriteByte file, 10 : WriteByte file, 0 : WriteByte file, 0
	WriteByte file, 0 : WriteByte file, 0 : WriteByte file, 10 : WriteByte file, 0
Next
CloseFile file

md2_model = LoadMD2(name)
CheckTrue "LoadMD2", md2_model <> 0
surf = GetSurface(md2_model, 1)
Check "The first frame: second corner x", VertexX(surf, 1), 10

; Playing once ends in the last frame.
AnimateMD2 md2_model, 3, 1, 0, 1
Delay 100
UpdateWorld
Check "The last frame: second corner x", VertexX(surf, 1), 22, 0.01
Check "The last frame: second corner y", VertexY(surf, 1), 3, 0.01
Check "The last frame: third corner y", VertexY(surf, 2), 23, 0.01
Check "The last frame: normals have a length", Sqr(VertexNX(surf, 1) ^ 2 + VertexNY(surf, 1) ^ 2 + VertexNZ(surf, 1) ^ 2), 1, 0.01

; A transition of 10 steps from the last frame to the first one: every step is a tenth of the way.
AnimateMD2 md2_model, 3, 1, 0, 0, 10
UpdateWorld
Check "A tenth of the way", VertexX(surf, 1), 20.8, 0.05
UpdateWorld
Check "Two tenths of the way", VertexX(surf, 1), 19.6, 0.05

FreeEntity md2_model
DeleteFile name
Done "md2_pose"
