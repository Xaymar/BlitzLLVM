; Broken files: a string that says it is much longer than the file does not make the program ask for that much memory
; or read what is not there, and a model that is not a model is not one. ReadString$ ReadLine$ LoadMesh.
Graphics3D 64, 64, 32, 2
Include "check.bb"

folder$ = "suite_tmp_limits"
CreateDir folder
name$ = folder + "/broken.bin"

; A string of two billion bytes in a file of a few.
file = WriteFile(name)
WriteInt file, $7FFFFFFF
WriteByte file, Asc("a")
WriteByte file, Asc("b")
CloseFile file
file = ReadFile(name)
text$ = ReadString$(file)
CheckS "A length that is too long gives what is there", text, "ab"
CheckTrue "That is the end", Eof(file)
CloseFile file

; A negative length is nothing.
file = WriteFile(name)
WriteInt file, -5
WriteByte file, Asc("x")
CloseFile file
file = ReadFile(name)
CheckS "A negative length is an empty string", ReadString$(file), ""
CloseFile file

; A model that is only text, and a folder, are not models.
file = WriteFile(name)
WriteLine file, "this is not a model"
CloseFile file
Check "LoadMesh of a file that is not a model", LoadMesh(name), 0
Check "LoadAnimMesh of a file that is not a model", LoadAnimMesh(name), 0
Check "LoadMesh of a folder", LoadMesh(folder), 0

DeleteFile name
Done "streams_limits"
