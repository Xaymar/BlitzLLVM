; Textures and brushes: CreateTexture LoadTexture FreeTexture TextureWidth TextureHeight TextureBlend TextureFilter
; ScaleTexture PositionTexture RotateTexture SetCubeFace TextureBuffer ActiveTextures CreateBrush BrushColor BrushAlpha
; BrushShininess BrushBlend BrushFX BrushTexture GetBrushTexture FreeBrush LoadAnimTexture TextureName TextureCoords
; SetCubeMode ClearTextureFilters LoadBrush GetEntityBrush FindSurface.
Include "check.bb"

Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

; Textures made empty, with the size they were given.
texture = CreateTexture(64, 32)
CheckTrue "CreateTexture", texture <> 0
Check "TextureWidth", TextureWidth(texture), 64
Check "TextureHeight", TextureHeight(texture), 32
other = CreateTexture(16, 16, 1 + 2, 1)
CheckTrue "CreateTexture with flags", other <> 0 And other <> texture
Check "TextureWidth of the other", TextureWidth(other), 16

; Textures from files, which are a picture of 64 by 64 here.
loaded = LoadTexture("../checker.png")
CheckTrue "LoadTexture", loaded <> 0
Check "LoadTexture width", TextureWidth(loaded), 64
Check "LoadTexture height", TextureHeight(loaded), 64
Check "LoadTexture missing", LoadTexture("suite_does_not_exist.png"), 0
flagged = LoadTexture("../checker.png", 1 + 4 + 16 + 32)
CheckTrue "LoadTexture with flags", flagged <> 0
Check "LoadTexture with flags keeps the size", TextureWidth(flagged), 64

; How a texture is used is changed on the texture.
ScaleTexture texture, 2, 2
PositionTexture texture, 0.5, 0.25
RotateTexture texture, 45
TextureBlend texture, 2
TextureBlend texture, 1
TextureFilter "", 1
TextureFilter "", 8
Check "ScaleTexture does not change the size", TextureWidth(texture), 64
suite_checks = suite_checks + 6

; Drawing on a texture goes through its buffer.
buffer = TextureBuffer(texture)
CheckTrue "TextureBuffer", buffer <> 0
CheckTrue "TextureBuffer of another texture is another buffer", TextureBuffer(other) <> buffer
Check "TextureBuffer stays", TextureBuffer(texture), buffer
SetCubeFace texture, 0
SetCubeFace texture, 3
suite_checks = suite_checks + 2

; The textures that are used.
used = ActiveTextures()
CheckTrue "ActiveTextures", used >= 0
FreeTexture other
FreeTexture flagged
FreeTexture loaded
FreeTexture texture
suite_checks = suite_checks + 4

; Brushes are the way that looks are given to what it has no entity for.
brush = CreateBrush()
CheckTrue "CreateBrush", brush <> 0
other = CreateBrush(10, 20, 30)
CheckTrue "CreateBrush with a color", other <> 0 And other <> brush
BrushColor brush, 1, 2, 3
BrushAlpha brush, 0.5
BrushShininess brush, 0.75
BrushBlend brush, 3
BrushFX brush, 1 + 16
suite_checks = suite_checks + 5

; A brush keeps the textures that were put on it, by number.
tex_a = CreateTexture(8, 8)
tex_b = CreateTexture(8, 8)
Check "A brush has no texture to begin with", GetBrushTexture(brush), 0
BrushTexture brush, tex_a
CheckTrue "BrushTexture", GetBrushTexture(brush) <> 0
Check "GetBrushTexture gives the same texture", GetBrushTexture(brush), tex_a
BrushTexture brush, tex_b, 0, 1
Check "BrushTexture on the tex_b layer", GetBrushTexture(brush, 1), tex_b
Check "BrushTexture keeps the tex_a layer", GetBrushTexture(brush, 0), tex_a
Check "The other brush is not changed", GetBrushTexture(other), 0

; Brushes on meshes
cube = CreateCube()
PaintMesh cube, brush
surfaceBrush = GetSurfaceBrush(GetSurface(cube, 1))
CheckTrue "A painted mesh has a brush", surfaceBrush <> 0
Check "The brush of a surface has the texture", GetBrushTexture(surfaceBrush), tex_a
FreeBrush surfaceBrush
FreeEntity cube

; A brush that has how an entity looks, which finds the surface that is painted with it.
looks = CreateCube()
EntityTexture looks, tex_a
EntityColor looks, 255, 0, 0
from_entity = GetEntityBrush(looks)
CheckTrue "GetEntityBrush", from_entity <> 0
Check "GetEntityBrush texture", GetBrushTexture(from_entity, 0), tex_a
twin = CreateCube()
PaintMesh twin, from_entity
Check "FindSurface", FindSurface(twin, from_entity), GetSurface(twin, 1)
Check "FindSurface another brush", FindSurface(twin, other), 0
plain = CreateCube()
plain_brush = CreateBrush()
Check "FindSurface of an unpainted mesh", FindSurface(plain, plain_brush), GetSurface(plain, 1)
Check "FindSurface of another brush on it", FindSurface(plain, from_entity), 0
FreeBrush from_entity
FreeBrush plain_brush
FreeEntity looks
FreeEntity twin
FreeEntity plain

; A brush from a file.
from_file = LoadBrush("../checker.png")
CheckTrue "LoadBrush", from_file <> 0
file_texture = GetBrushTexture(from_file)
CheckTrue "LoadBrush has a texture", file_texture <> 0
Check "LoadBrush texture width", TextureWidth(file_texture), 64
Check "LoadBrush missing", LoadBrush("suite_does_not_exist.png"), 0
scaled_brush = LoadBrush("../checker.png", 1, 2, 2)
CheckTrue "LoadBrush scaled", scaled_brush <> 0
FreeBrush from_file
FreeBrush scaled_brush

; Textures with frames are a sheet of cells, and say where they came from.
frames = LoadAnimTexture("../checker.png", 1, 32, 32, 0, 4)
CheckTrue "LoadAnimTexture", frames <> 0
Check "LoadAnimTexture width is a frame", TextureWidth(frames), 32
Check "LoadAnimTexture height is a frame", TextureHeight(frames), 32
CheckS "TextureName", TextureName$(frames), "../checker.png"
CheckS "TextureName of a made texture", TextureName$(tex_a), ""
Check "LoadAnimTexture missing", LoadAnimTexture("suite_does_not_exist.png", 1, 32, 32, 0, 4), 0
frame_cube = CreateCube()
EntityTexture frame_cube, frames, 3
Check "GetBrushTexture keeps the texture of a frame", GetBrushTexture(GetEntityBrush(frame_cube)), frames
FreeEntity frame_cube
FreeTexture frames

; Settings for textures that have no effect to look at here.
TextureCoords tex_a, 1
TextureCoords tex_a, 0
SetCubeMode tex_a, 1
TextureFilter "suite_filter_a", 4
ClearTextureFilters
suite_checks = suite_checks + 1

FreeBrush other
FreeBrush brush
FreeTexture tex_a
FreeTexture tex_b

EndGraphics
Done "blitz3d_textures"
