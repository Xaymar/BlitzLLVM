; The lightmaps of a Quake 3 level, which needs a window and a GPU, so this is skipped without one: LoadBSP BSPLighting
; BSPLightmapColor BSPAmbientLight. The level is made here: two quads with a lightmap each and one without.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_lightmaps_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Px(x, y)
	Return ReadPixel(x, y, BackBuffer()) And $FFFFFF
End Function
Function R(x, y)
	Return (Px(x, y) Shr 16) And 255
End Function
Function G(x, y)
	Return (Px(x, y) Shr 8) And 255
End Function
Function B(x, y)
	Return Px(x, y) And 255
End Function

; The coordinates of Quake are turned: x is z, y is -x and z is y.
Function WriteVertex(file, x#, y#, z#, r, g, b)
	WriteFloat file, x : WriteFloat file, y : WriteFloat file, z
	WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 0.5 : WriteFloat file, 0.5
	WriteFloat file, 0 : WriteFloat file, 0 : WriteFloat file, 1
	WriteByte file, r : WriteByte file, g : WriteByte file, b : WriteByte file, 255
End Function
; A quad with a lightmap, facing the camera: y goes from low to high, z from low to high.
Function WriteQuad(file, y0, y1, z0, z1, r, g, b)
	WriteVertex file, 100, y0, z0, r, g, b
	WriteVertex file, 100, y1, z0, r, g, b
	WriteVertex file, 100, y1, z1, r, g, b
	WriteVertex file, 100, y0, z1, r, g, b
End Function
Function WriteFace(file, vertex, lightmap)
	WriteInt file, -1 : WriteInt file, -1 : WriteInt file, 3 : WriteInt file, vertex : WriteInt file, 4
	WriteInt file, vertex / 4 * 6 : WriteInt file, 6 : WriteInt file, lightmap
	For i = 1 To 4
		WriteInt file, 0
	Next
	For i = 1 To 12
		WriteFloat file, 0
	Next
	WriteInt file, 0 : WriteInt file, 0
End Function

; Header 144 bytes, 12 vertices of 44, 18 mesh vertices of 4, 3 faces of 104 and 2 lightmaps of 128 by 128 pixels.
Function WriteLevel(name$)
	file = WriteFile(name)
	WriteInt file, $50534249
	WriteInt file, 46
	For lump = 0 To 16
		If lump = 10 Then WriteInt file, 144 : WriteInt file, 528
		If lump = 11 Then WriteInt file, 672 : WriteInt file, 72
		If lump = 13 Then WriteInt file, 744 : WriteInt file, 312
		If lump = 14 Then WriteInt file, 1056 : WriteInt file, 98304
		If lump <> 10 And lump <> 11 And lump <> 13 And lump <> 14 Then WriteInt file, 1056 : WriteInt file, 0
	Next
	; Quad 0 is on the right with the dark lightmap, quad 1 on the left with the light one, quad 2 has none.
	WriteQuad file, -90, -10, -30, 30, 255, 0, 0
	WriteQuad file, 10, 90, -30, 30, 255, 0, 0
	WriteQuad file, -40, 40, -70, -40, 0, 255, 0
	For i = 0 To 2
		WriteInt file, 0 : WriteInt file, 1 : WriteInt file, 2
		WriteInt file, 0 : WriteInt file, 2 : WriteInt file, 3
	Next
	WriteFace file, 0, 0
	WriteFace file, 4, 1
	WriteFace file, 8, -1
	; The lightmaps are 64 and 128 of 255 everywhere, the pixels are 3 bytes: red, green and blue.
	For i = 1 To 128 * 128 * 3
		WriteByte file, 64
	Next
	For i = 1 To 128 * 128 * 3
		WriteByte file, 128
	Next
	CloseFile file
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 90

WriteLevel "suite_lightmaps.bsp"
level = LoadBSP("suite_lightmaps.bsp")
EntityFX level, 1 + 16
CheckTrue "LoadBSP of a level with lightmaps", level <> 0
Check "A surface for each lightmap", CountSurfaces(level), 3
RenderWorld
; The quad on the right is at 120, 60: the lightmap is multiplied once, as in the original, so 64 stays 64.
Check "The dark lightmap", R(120, 60), 64, 4
Check "The dark lightmap is gray", B(120, 60), 64, 4
; The one on the left is 128.
Check "The light lightmap", R(40, 60), 128, 4
Check "The light lightmap is gray", G(40, 60), 128, 4
; A face with no lightmap has the colors of its vertices.
Check "A face without a lightmap", G(80, 104), 255, 2
Check "A face without a lightmap, red", R(80, 104), 0, 2
Check "The background is the color of the camera", B(80, 10), 90, 2

; Without lightmaps the colors of the vertices are what is seen.
BSPLighting level, False
RenderWorld
Check "BSPLighting off, the dark one", R(120, 60), 255, 2
Check "BSPLighting off, the dark one is red", G(120, 60), 0, 2
BSPLighting level, True
RenderWorld
Check "BSPLighting on again", R(120, 60), 64, 4

; BSPLightmapColor multiplies the level: half of 64 is 32, and the face without a lightmap is halved too.
BSPLightmapColor level, 128, 128, 128
RenderWorld
Check "BSPLightmapColor halves the dark lightmap", R(120, 60), 32, 4
Check "BSPLightmapColor halves the light lightmap", R(40, 60), 64, 4
Check "BSPLightmapColor halves the vertex colors", G(80, 104), 128, 4
BSPLightmapColor level, 255, 0, 0
RenderWorld
Check "BSPLightmapColor tints, red is kept", R(40, 60), 128, 4
Check "BSPLightmapColor tints, green is gone", G(40, 60), 0, 2
BSPLightmapColor level, 255, 255, 255
RenderWorld
Check "BSPLightmapColor 255 changes nothing", R(120, 60), 64, 4

; BSPAmbientLight is added to the light: the dark lightmap (64) gets 100 more, the light one (128) too, and a
; face with vertex colors gets it on top of its colors. A new level has none, which the checks above show.
BSPAmbientLight level, 100, 50, 0
RenderWorld
Check "BSPAmbientLight is added to the dark lightmap", R(120, 60), 164, 4
Check "BSPAmbientLight is added per color", G(120, 60), 114, 4
Check "BSPAmbientLight adds nothing in blue", B(120, 60), 64, 4
Check "BSPAmbientLight is added to the light lightmap", R(40, 60), 228, 4
Check "BSPAmbientLight is added to vertex colors, red", R(80, 104), 100, 4
Check "BSPAmbientLight is added to vertex colors, green", G(80, 104), 255, 2
BSPLighting level, False
RenderWorld
Check "BSPAmbientLight with vertex lighting", G(120, 60), 50, 4
Check "BSPAmbientLight with vertex lighting, red", R(120, 60), 255, 2
BSPLighting level, True
; Added after the multiplication: half of 64 plus 100.
BSPLightmapColor level, 128, 128, 128
RenderWorld
Check "BSPAmbientLight is not multiplied by BSPLightmapColor", R(120, 60), 132, 4
BSPLightmapColor level, 255, 255, 255
BSPAmbientLight level, 0, 0, 0
RenderWorld
Check "BSPAmbientLight 0 changes nothing", R(120, 60), 64, 4
Check "BSPAmbientLight 0 changes nothing, blue", B(120, 60), 64, 4
FreeEntity level

; The gamma of LoadBSP lifts the lightmaps, each value is raised to 1 - gamma as in the original: 64 with a gamma of 0.5 is 128, and 1 makes everything 255.
level = LoadBSP("suite_lightmaps.bsp", 0.5)
EntityFX level, 1 + 16
RenderWorld
Check "LoadBSP gamma", R(120, 60), 128, 3
Check "LoadBSP gamma, the light lightmap", R(40, 60), 180, 3
FreeEntity level
DeleteFile "suite_lightmaps.bsp"

Done "blitz3d_lightmaps_pixels"
