; SetCameraClipPlane cuts away what is behind a plane in the world, SetCameraClipPlaneEnabled turns a plane on and off, and the Get
; commands give both back. It needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_camera_clip_planes_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Red(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

; How many red pixels the middle row has left and right of the middle.
Global left_red, right_red
Function CountRow()
	left_red = 0
	right_red = 0
	For x = 0 To 79
		If Red(x, 60) > 128 Then left_red = left_red + 1
	Next
	For x = 80 To 159
		If Red(x, 60) > 128 Then right_red = right_red + 1
	Next
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 1, 100
CameraZoom camera, 2
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0
PositionEntity cube, 0, 0, 10

RenderWorld
CountRow
CheckTrue "Without a clip plane both halves of the cube are drawn", (left_red > 10) And (right_red > 10)
full_left = left_red
full_right = right_red

; A plane that is set but not enabled does nothing.
SetCameraClipPlane camera, 0, 1, 0, 0, 0
Check "A new clip plane is off", GetCameraClipPlaneEnabled(camera, 0), 0, 0
RenderWorld
CountRow
Check "A plane that is off cuts nothing (left)", left_red, full_left, 0
Check "A plane that is off cuts nothing (right)", right_red, full_right, 0

; x >= 0 is kept: the left half of the cube goes away.
SetCameraClipPlaneEnabled camera, 0, True
Check "GetCameraClipPlaneEnabled", GetCameraClipPlaneEnabled(camera, 0), 1, 0
RenderWorld
CountRow
Check "The plane cuts away the left half", left_red, 0, 0
Check "The plane keeps the right half", right_red, full_right, 1

Local plane:FloatVector4 = GetCameraClipPlane(camera, 0)
CheckTrue "GetCameraClipPlane gives the plane back", (plane[0] = 1) And (plane[1] = 0) And (plane[2] = 0) And (plane[3] = 0)

; A second plane, -x >= 0, cuts away the other half: everything is gone.
SetCameraClipPlane camera, 5, -1, 0, 0, 0
SetCameraClipPlaneEnabled camera, 5, True
RenderWorld
CountRow
Check "Two planes cut away both halves", left_red + right_red, 0, 0

; Turning both off brings the cube back.
SetCameraClipPlaneEnabled camera, 0, False
SetCameraClipPlaneEnabled camera, 5, False
RenderWorld
CountRow
Check "Planes that are off again cut nothing", left_red + right_red, full_left + full_right, 0

; The plane stays in the world when everything is far from the origin: x >= 100000 cuts the left half of a cube at x = 100000.
PositionEntity camera, 100000, 0, 0
PositionEntity cube, 100000, 0, 10
SetCameraClipPlane camera, 0, 1, 0, 0, -100000
SetCameraClipPlaneEnabled camera, 0, True
RenderWorld
CountRow
Check "Far from the origin the plane cuts away the left half", left_red, 0, 0
Check "Far from the origin the plane keeps the right half", right_red, full_right, 1

Done "blitz3d_camera_clip_planes_pixels"
