; Names of files and folders do not care about case, and paths can use backslashes, as on Windows: the programs of Blitz3D and BlitzPlus
; ask for Media\Hero.BMP and have it in media/hero.bmp. FileType FileSize ReadFile OpenFile WriteFile LoadMesh.
Include "check.bb"

Graphics3D 64, 64, 32, 2

folder$ = "suite_tmp_case"
CreateDir folder
CreateDir folder + "/Inner"
name$ = folder + "/Inner/Data.Txt"
file = WriteFile(name)
WriteLine file, "case"
CloseFile file

Check "FileType in another case", FileType("SUITE_TMP_CASE/inner/DATA.TXT"), 1
Check "FileType of a folder in another case", FileType("Suite_Tmp_Case/INNER"), 2
Check "FileType with backslashes", FileType("suite_tmp_case\inner\data.txt"), 1
Check "FileType with backslashes and another case", FileType("Suite_Tmp_Case\Inner\DATA.txt"), 1
Check "FileSize in another case", FileSize("suite_tmp_case/INNER/data.TXT"), 6
file = ReadFile("SUITE_TMP_CASE\INNER\DATA.TXT")
CheckTrue "ReadFile in another case", file <> 0
CheckS "The file that was found", ReadLine(file), "case"
CloseFile file
Check "FileType of what is not there in any case", FileType("suite_tmp_case/inner/other.txt"), 0
Check "ReadFile of what is not there in any case", ReadFile("suite_tmp_case/INNER/other.txt"), 0

; Writing to a name that exists in another case writes that file, instead of making a second one.
file = WriteFile("SUITE_TMP_CASE/inner/data.txt")
WriteLine file, "again!"
CloseFile file
Check "WriteFile finds the file", FileSize(name), 8

; Models, in another case and with backslashes.
mesh = LoadMesh("MODELS\QUAD.3DS")
CheckTrue "LoadMesh in another case", mesh <> 0
Check "LoadMesh of what is not there in any case", LoadMesh("models/nothing.3ds"), 0

DeleteFile name
DeleteDir folder + "/Inner"
DeleteDir folder
