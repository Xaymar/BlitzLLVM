; The image formats that are built into the runtime, which have to load without any library next to the program:
; LoadImage with WebP, AVIF, JPEG XL and TIFF files. images/ has one of each, 16, 24 and 32 pixels wide and 8 high.
; TGA files (plain and run length encoded, 8 by 4) are read too, with LoadImage and LoadTexture, and are told apart by their extension.
Include "check.bb"

Graphics 160, 120, 32, 2
SetBuffer BackBuffer()

webp = LoadImage("images/pixels.webp")
CheckTrue "LoadImage WebP", webp <> 0
Check "WebP width", ImageWidth(webp), 16
Check "WebP height", ImageHeight(webp), 8

avif = LoadImage("images/pixels.avif")
CheckTrue "LoadImage AVIF", avif <> 0
Check "AVIF width", ImageWidth(avif), 24
Check "AVIF height", ImageHeight(avif), 8

jxl = LoadImage("images/pixels.jxl")
CheckTrue "LoadImage JPEG XL", jxl <> 0
Check "JPEG XL width", ImageWidth(jxl), 32
Check "JPEG XL height", ImageHeight(jxl), 8

For n = 1 To 2
	If n = 1 Then file$ = "images/pixels.tga" Else file$ = "images/pixels_rle.tga"
	tga = LoadImage(file)
	CheckTrue "LoadImage " + file, tga <> 0
	Check file + " width", ImageWidth(tga), 8
	Check file + " height", ImageHeight(tga), 4
	FreeImage tga
	tex = LoadTexture(file)
	CheckTrue "LoadTexture " + file, tex <> 0
	Check file + " texture width", TextureWidth(tex), 8
	FreeTexture tex
Next

For n = 1 To 2
	If n = 1 Then file$ = "images/pixels.tif" Else file$ = "images/pixels_packbits.tif"
	tif = LoadImage(file)
	CheckTrue "LoadImage " + file, tif <> 0
	Check file + " width", ImageWidth(tif), 8
	Check file + " height", ImageHeight(tif), 4
	FreeImage tif
Next

Check "LoadImage missing WebP", LoadImage("images/missing.webp"), 0

FreeImage webp
FreeImage avif
FreeImage jxl
EndGraphics
Done "graphics_formats"
