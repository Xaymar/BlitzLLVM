; See-through sprites that do not cover each other are drawn together even if their textures alternate, and the ones that do
; cover each other keep the order of their distance. Needs a window and a GPU, so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_transparency_batching_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function Chan(x, y, shift)
	Return (ReadPixel(x, y, BackBuffer()) Shr shift) And 255
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, 0

red = CreateTexture(4, 4, 1 + 4096)
SetBuffer TextureBuffer(red) : ClsColor 255, 0, 0 : Cls : SetBuffer BackBuffer()
green = CreateTexture(4, 4, 1 + 4096)
SetBuffer TextureBuffer(green) : ClsColor 0, 255, 0 : Cls : SetBuffer BackBuffer()

; A row of sprites next to each other, of two textures in turn, at distances that make them alternate in the sort too.
; Copies of one sprite share its mesh, which is what lets them be one call.
template = CreateSprite()
HideEntity template
Dim row(15)
For i = 0 To 15
	row(i) = CopyEntity(template)
	If (i Mod 2) = 0 Then EntityTexture row(i), red Else EntityTexture row(i), green
	EntityAlpha row(i), 0.5
	ScaleSprite row(i), 0.4, 0.4
	PositionEntity row(i), (i Mod 8) * 1.6 - 5.6, (i / 8) * 2.0 - 1.0, 8 + i * 0.01
Next
RenderWorld
CheckTrue "Sprites that do not cover each other are drawn together (" + Stats3D(1000) + " calls)", Stats3D(1000) <= 4
CheckTrue "Sprites are drawn", TrisRendered() >= 32

; Three that cover each other, red far, green in the middle, red nearest: batching the reds would put the green over both.
For i = 0 To 15
	HideEntity row(i)
Next
far = CopyEntity(template) : ShowEntity far : EntityTexture far, red : EntityAlpha far, 0.5 : ScaleSprite far, 2, 2 : PositionEntity far, 0, 0, 12
mid = CopyEntity(template) : ShowEntity mid : EntityTexture mid, green : EntityAlpha mid, 0.5 : ScaleSprite mid, 2, 2 : PositionEntity mid, 0, 0, 10
nearest = CopyEntity(template) : ShowEntity nearest : EntityTexture nearest, red : EntityAlpha nearest, 0.5 : ScaleSprite nearest, 2, 2 : PositionEntity nearest, 0, 0, 8
RenderWorld
CheckTrue "Sprites that cover each other stay in order (" + Stats3D(1000) + " calls)", Stats3D(1000) = 3
; Red over green over red over black: about 159 red and 63 green. In the wrong order it is 79 red and 127 green.
Check "Near sprite shows its red", Float(Chan(80, 60, 16)), 159, 12
Check "Middle sprite shows its green", Float(Chan(80, 60, 8)), 63, 12

Done "blitz3d_transparency_batching_pixels"
