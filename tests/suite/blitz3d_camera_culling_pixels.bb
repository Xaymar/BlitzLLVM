; CameraCulling turns the frustum culling of a camera on and off, and CameraCullingSource lets a camera use the culling of another.
; Culled meshes are not drawn at all, which TrisRendered shows (it counts what was given to the GPU). It needs a window and a GPU,
; so this is skipped without one.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_camera_culling_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
PositionEntity camera, 0, 0, -10
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0

; A mesh in view is drawn.
RenderWorld
Check "A cube in view is drawn", TrisRendered(), 12, 0
CheckTrue "It shows", R(80, 60) > 200

; One far off to the side is not given to the GPU, which is what culling is.
PositionEntity cube, 100, 0, 0
RenderWorld
Check "A cube out of view is culled", TrisRendered(), 0, 0

; Without culling it is given to the GPU, and still nobody sees it.
CameraCulling camera, 0
RenderWorld
Check "Without culling it is drawn", TrisRendered(), 12, 0
CheckTrue "It is not seen anyway", R(80, 60) < 20
CameraCulling camera, 1
RenderWorld
Check "Frustum culling again", TrisRendered(), 0, 0

; Bit 2 asks for the GPU to cull the faces of big meshes, and leaves the culling of meshes alone.
CameraCulling camera, 2
RenderWorld
Check "Only GPU culling does not cull meshes", TrisRendered(), 12, 0
CameraCulling camera, 3
RenderWorld
Check "Both", TrisRendered(), 0, 0
CameraCulling camera, 1

; The culling of another camera: this one looks at the origin, the other at the cube. The other does not draw (projection mode 0), which
; does not stop it from being the one that decides.
other = CreateCamera()
CameraProjMode other, 0
PositionEntity other, 100, 0, -10
CameraCullingSource camera, other
RenderWorld
Check "The cube is in view of the other camera", TrisRendered(), 12, 0
CheckTrue "It is still not seen", R(80, 60) < 20

; And the other way around: what this camera sees is culled by what the other sees, and it does not cull by itself on top of that.
PositionEntity cube, 0, 0, 0
RenderWorld
Check "The cube is not in view of the other camera", TrisRendered(), 0, 0
CheckTrue "It is not drawn though this camera looks at it", R(80, 60) < 20

; The other camera's setting counts: without culling there, everything is drawn.
CameraCulling other, 0
PositionEntity cube, 100, 0, 0
RenderWorld
Check "The culling of the other camera is off", TrisRendered(), 12, 0
CameraCulling other, 1

; A camera that follows another follows where it is now.
PositionEntity other, 0, 0, -10
PositionEntity cube, 0, 0, 0
RenderWorld
Check "It follows the other camera", TrisRendered(), 12, 0
CheckTrue "Seen", R(80, 60) > 200

; 0 makes the camera cull for itself again.
PositionEntity cube, 100, 0, 0
CameraCullingSource camera, 0
RenderWorld
Check "Own culling again", TrisRendered(), 0, 0

; Loops and itself do not hang or crash, they cull as the camera would by itself.
CameraCullingSource camera, other
CameraCullingSource other, camera
PositionEntity cube, 0, 0, 0
RenderWorld
CheckTrue "A loop of cameras draws what is in view", R(80, 60) > 200
CameraCullingSource camera, camera
CameraCullingSource other, 0
RenderWorld
CheckTrue "A camera can not be its own source", R(80, 60) > 200

; A camera that is freed leaves the one that used it alone.
CameraCullingSource camera, other
FreeEntity other
RenderWorld
CheckTrue "A freed source is the same as none", R(80, 60) > 200

Done "blitz3d_camera_culling_pixels"
