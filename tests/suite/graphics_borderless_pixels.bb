; Window mode 4 of Graphics and Graphics3D, a window without a border, which needs a window and a GPU, so this is
; skipped without one. BLITZ_TEST_WINDOW_FLAGS makes the runtime write the SDL window flags to a file.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_borderless_pixels: skipped, there is no window."
	End
EndIf

Const BORDERLESS = $10, RESIZABLE = $20

; The flags of the window the last Graphics or Graphics3D opened.
Function WindowFlags()
	f = ReadFile("window_flags.tmp")
	If f = 0 Then RuntimeError "The window flags were not written."
	flags = Int(ReadLine$(f))
	CloseFile f
	DeleteFile "window_flags.tmp"
	Return flags
End Function

SetEnv "BLITZ_TEST_WINDOW_FLAGS", "window_flags.tmp"

; A window with a border has neither flag.
Graphics 160, 120, 32, 2
flags = WindowFlags()
CheckFalse "mode 2 has a border", flags And BORDERLESS

; Mode 4 has no border, is not resizable and has the size that was asked for.
Graphics 160, 120, 32, 4
flags = WindowFlags()
CheckTrue "Graphics mode 4 is borderless", flags And BORDERLESS
CheckFalse "Graphics mode 4 is not resizable", flags And RESIZABLE
Check "Graphics mode 4 width", GraphicsWidth(), 160
Check "Graphics mode 4 height", GraphicsHeight(), 120

; Drawing works as in a window.
SetBuffer BackBuffer()
ClsColor 0, 0, 0
Cls
Color 255, 0, 0
Rect 0, 0, 160, 120, 1
Check "Graphics mode 4 draws", ReadPixel(80, 60) And $FFFFFF, $FF0000

; The depth is not used.
Graphics 160, 120, 0, 4
CheckTrue "Graphics mode 4 with depth 0", WindowFlags() And BORDERLESS

; Mode 3 is still resizable and does not lose its border.
Graphics 160, 120, 32, 3
flags = WindowFlags()
CheckTrue "mode 3 is resizable", flags And RESIZABLE
CheckFalse "mode 3 has a border", flags And BORDERLESS

; Graphics3D takes the same mode.
Graphics3D 160, 120, 32, 4
flags = WindowFlags()
CheckTrue "Graphics3D mode 4 is borderless", flags And BORDERLESS
CheckFalse "Graphics3D mode 4 is not resizable", flags And RESIZABLE
Check "Graphics3D mode 4 width", GraphicsWidth(), 160
SetBuffer BackBuffer()
camera = CreateCamera()
CameraClsColor camera, 0, 0, 255
RenderWorld
Check "Graphics3D mode 4 renders", ReadPixel(80, 60) And $FFFFFF, $0000FF

Graphics3D 160, 120, 0, 2
CheckFalse "Graphics3D mode 2 has a border", WindowFlags() And BORDERLESS

Done "graphics_borderless_pixels"
