; Multiplayer games: StartNetGame HostNetGame JoinNetGame StopNetGame CreateNetPlayer DeleteNetPlayer NetPlayerName$
; NetPlayerLocal SendNetMsg RecvNetMsg NetMsgType NetMsgFrom NetMsgTo NetMsgData$. A game needs two programs, so this
; one starts itself a second time (the environment says which program that is) and plays with it: the one that was
; started with "client" joins, the other one hosts.
Include "check.bb"

Const GAME$ = "suite game"
Const TIMEOUT = 10000

; Waits for the next message of a kind, and gives whether it came. Other kinds of messages are in the way.
Function Wait(kind)
	start = MilliSecs()
	While MilliSecs() - start < TIMEOUT
		If RecvNetMsg()
			If NetMsgType() = kind Then Return True
		Else
			Delay 5
		EndIf
	Wend
	Return False
End Function

; The program that joins.
If Instr(CommandLine$(), "client") > 0
	Check "A game with another name can't be joined", JoinNetGame("some other game", "127.0.0.1"), 0
	Check "JoinNetGame", JoinNetGame(GAME, "127.0.0.1"), 1
	CheckTrue "The player of the host is told about", Wait(100)
	host_player = NetMsgFrom()
	CheckS "Name of the player of the host", NetPlayerName$(host_player), "host player"
	Check "The player of the host is not ours", NetPlayerLocal(host_player), 0
	me = CreateNetPlayer("client player")
	CheckTrue "CreateNetPlayer on the client", me <> 0
	Check "The player of the client is ours", NetPlayerLocal(me), 1
	CheckTrue "A message to this player", Wait(5)
	CheckS "Message data", NetMsgData$(), "hello client"
	Check "Message from", NetMsgFrom(), host_player
	Check "Message to", NetMsgTo(), me
	Check "SendNetMsg to one player", SendNetMsg(6, "hello host", me, host_player), 1
	CheckTrue "A message to all", Wait(7)
	CheckS "Message to all data", NetMsgData$(), "to all"
	Check "Message to all, to", NetMsgTo(), 0
	Check "SendNetMsg to all", SendNetMsg(8, "got it", me), 1
	; The host answers with a message that has a lot in it, which arrives as one.
	CheckTrue "A long message", Wait(9)
	Check "A long message has all of it", Len(NetMsgData$()), 5000
	DeleteNetPlayer me
	StopNetGame
	End
EndIf

; Without the program there is nobody to play with, so what can be told is told.
CheckS "NetPlayerName$ of nobody", NetPlayerName$(0), "<all>"
CheckS "NetPlayerName$ of an unknown player", NetPlayerName$(12345), "<unknown>"
Check "NetPlayerLocal of an unknown player", NetPlayerLocal(12345), 0
Check "JoinNetGame without a game", JoinNetGame(GAME, "127.0.0.1"), 0

program$ = GetEnv$("BLITZLLVM_TEST_PROGRAM")
If program = ""
	Print "multiplayer: the other program is not known, so there was nobody to play with."
	suite_checks = suite_checks + 1
	Done "multiplayer"
	End
EndIf

SetEnv "BLITZLLVM_NETGAME_PORT", "40611"
Check "HostNetGame", HostNetGame(GAME), 2
host_player = CreateNetPlayer("host player")
CheckTrue "CreateNetPlayer", host_player <> 0
CheckS "NetPlayerName$", NetPlayerName$(host_player), "host player"
Check "NetPlayerLocal", NetPlayerLocal(host_player), 1
Check "SendNetMsg from a player that is not ours", SendNetMsg(1, "no", 12345, 0), 0

CheckTrue "Starting the other program", CreateProcess(Chr$(34) + program + Chr$(34) + " client")
CheckTrue "The player of the client is told about", Wait(100)
client_player = NetMsgFrom()
CheckS "Name of the player of the client", NetPlayerName$(client_player), "client player"
Check "The player of the client is not ours", NetPlayerLocal(client_player), 0

Check "SendNetMsg to one player", SendNetMsg(5, "hello client", host_player, client_player), 1
CheckTrue "The answer of the client", Wait(6)
CheckS "The answer", NetMsgData$(), "hello host"
Check "The answer is from the client", NetMsgFrom(), client_player
Check "The answer is for the host", NetMsgTo(), host_player
Check "The answer is of the kind", NetMsgType(), 6

Check "SendNetMsg to all", SendNetMsg(7, "to all", host_player, 0, False), 1
CheckTrue "The answer to all", Wait(8)
CheckS "The answer to all, data", NetMsgData$(), "got it"
Check "The answer to all, to", NetMsgTo(), 0

long$ = String$("x", 5000)
Check "SendNetMsg with a lot", SendNetMsg(9, long, host_player, client_player), 1

; The player of the client goes away.
CheckTrue "A player goes", Wait(101)
Check "The player that went", NetMsgFrom(), client_player
CheckS "A player that went is unknown", NetPlayerName$(client_player), "<unknown>"

DeleteNetPlayer host_player
CheckS "DeleteNetPlayer", NetPlayerName$(host_player), "<unknown>"
StopNetGame
StopNetGame
suite_checks = suite_checks + 1

; Nobody answers the question where to play without a window.
If GetEnv$("BLITZLLVM_HEADLESS") <> ""
	Check "StartNetGame without anybody to answer", StartNetGame(), 0
Else
	suite_checks = suite_checks + 1
EndIf

Done "multiplayer"
