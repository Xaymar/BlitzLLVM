; CopyEntity does what the original Blitz3D 1.118 does. Every expected value here was written by the original compiler.
Include "check.bb"

Graphics3D 320, 240, 32, 2

; The original has no copy of a camera, a light or a terrain: what it makes of them is a pivot with the same name, place and
; collision type. Everything else keeps its class.
cam = CreateCamera()
NameEntity cam, "cam"
PositionEntity cam, 1, 2, 3
EntityType cam, 3
copy = CopyEntity(cam)
CheckS "A camera is copied as", EntityClass$(copy), "Pivot"
CheckS "The copy of a camera keeps the name", EntityName$(copy), "cam"
Check "The copy of a camera keeps the place", EntityY(copy), 2
Check "The copy of a camera keeps the type", GetEntityType(copy), 3

lit = CreateLight()
CheckS "A light is copied as", EntityClass$(CopyEntity(lit)), "Pivot"
CheckS "A terrain is copied as", EntityClass$(CopyEntity(CreateTerrain(32))), "Pivot"
CheckS "A cube is copied as", EntityClass$(CopyEntity(CreateCube())), "Mesh"
CheckS "A sprite is copied as", EntityClass$(CopyEntity(CreateSprite())), "Sprite"
CheckS "A plane is copied as", EntityClass$(CopyEntity(CreatePlane())), "Plane"
CheckS "A mirror is copied as", EntityClass$(CopyEntity(CreateMirror())), "Mirror"
CheckS "A pivot is copied as", EntityClass$(CopyEntity(CreatePivot())), "Pivot"

; The children are numbered in the order they became children, not by the handles that were free when they were made.
root = CreatePivot()
a = CreateCube(root) : NameEntity a, "A"
b = CreateSprite(root) : NameEntity b, "B"
c = CreatePivot(root) : NameEntity c, "C"
FreeEntity b
d = CreateCube(root) : NameEntity d, "D"
g = CreatePivot(d) : NameEntity g, "G"
CheckS "Child 1", EntityName$(GetChild(root, 1)), "A"
CheckS "Child 2", EntityName$(GetChild(root, 2)), "C"
CheckS "Child 3", EntityName$(GetChild(root, 3)), "D"
rc = CopyEntity(root)
CheckS "Copied child 1", EntityName$(GetChild(rc, 1)), "A"
CheckS "Copied child 2", EntityName$(GetChild(rc, 2)), "C"
CheckS "Copied child 3", EntityName$(GetChild(rc, 3)), "D"
CheckS "Grandchild of the copy", EntityName$(GetChild(GetChild(rc, 3), 1)), "G"

; A child that moves to another parent comes last there.
EntityParent a, d
CheckS "The grandchild order after EntityParent 1", EntityName$(GetChild(d, 1)), "G"
CheckS "The grandchild order after EntityParent 2", EntityName$(GetChild(d, 2)), "A"

; The parent of the copy is the one that was asked for, not the one of the original, and the place stays as it is in the parent.
par = CreatePivot()
PositionEntity par, 10, 0, 0
ch = CreateCube(par)
PositionEntity ch, 1, 0, 0
c1 = CopyEntity(ch)
Check "No parent for a copy of a child", GetParent(c1), 0
Check "The place of the copy of a child", EntityX(c1), 1
Check "The parent of a copy", GetParent(CopyEntity(ch, par)), par
Check "A copy can be a child of its original", GetParent(CopyEntity(ch, ch)), ch
Check "The original has a child now", CountChildren(ch), 1

EndGraphics
Done "blitz3d_copyentity_original"
