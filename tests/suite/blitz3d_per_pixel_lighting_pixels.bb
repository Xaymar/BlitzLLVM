; PerPixelLighting, which needs a window and a GPU, so this is skipped without one. A point light close to the middle of a
; quad that is only four vertices big: lit per vertex the middle is as dark as the corners blend, lit per pixel it is bright.
; A directional light is the same either way, flat shaded entities keep the lighting of their first vertex, and turning the
; setting off again gives the first picture back.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "blitz3d_per_pixel_lighting_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 64
Graphics3D W, H, 32, 2
SetBuffer BackBuffer()

Global camera = CreateCamera()
PositionEntity camera, 0, 0, -4
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100
AmbientLight 0, 0, 0

; A single quad of two triangles, 6 by 6 units, facing the camera.
Global mesh = CreateMesh()
Global surf = CreateSurface(mesh)
v0 = AddVertex(surf, -3, -3, 0) : v1 = AddVertex(surf, -3, 3, 0) : v2 = AddVertex(surf, 3, 3, 0) : v3 = AddVertex(surf, 3, -3, 0)
VertexNormal surf, v0, 0, 0, -1 : VertexNormal surf, v1, 0, 0, -1 : VertexNormal surf, v2, 0, 0, -1 : VertexNormal surf, v3, 0, 0, -1
AddTriangle surf, v0, v1, v2
AddTriangle surf, v0, v2, v3
EntityColor mesh, 255, 255, 255

Global light = CreateLight(2)
PositionEntity light, 0, 0, -1
LightRange light, 2

Function Grey(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

Function Render()
	RenderWorld
End Function

PerPixelLighting 0
Render
vertexMid = Grey(W / 2, H / 2)
cornerBefore = Grey(W / 2 - 22, H / 2 - 22)

PerPixelLighting 1
Render
pixelMid = Grey(W / 2, H / 2)
CheckTrue "A point light in the middle of a quad lights the middle per pixel", pixelMid > vertexMid + 80
CheckTrue "It is bright there (the light is 1 unit from the surface)", pixelMid > 200

; The point light falls off with the distance, so the pixel is darker the farther it is from the light, which only holds per pixel.
CheckTrue "Per pixel the light fades towards the edges", Grey(W / 2 + 20, H / 2) < pixelMid

PerPixelLighting 0
Render
Check "Turning it off gives the first picture back", Grey(W / 2, H / 2), vertexMid, 0
Check "Turning it off gives the first picture back (corner)", Grey(W / 2 - 22, H / 2 - 22), cornerBefore, 0

; A directional light gives the same pixels either way, within the rounding of the interpolation.
FreeEntity light
light = CreateLight(1)
RotateEntity light, 20, 30, 0
LightColor light, 200, 180, 160
PerPixelLighting 0
Render
vertexLit = ReadPixel(W / 2, H / 2, BackBuffer()) And $FFFFFF
vertexLit2 = ReadPixel(W / 2 + 15, H / 2 - 10, BackBuffer()) And $FFFFFF
PerPixelLighting 1
Render
pixelLit = ReadPixel(W / 2, H / 2, BackBuffer()) And $FFFFFF
pixelLit2 = ReadPixel(W / 2 + 15, H / 2 - 10, BackBuffer()) And $FFFFFF
For shift = 0 To 16 Step 8
	Check "A directional light is the same (middle)", (pixelLit Shr shift) And 255, (vertexLit Shr shift) And 255, 2
	Check "A directional light is the same (off centre)", (pixelLit2 Shr shift) And 255, (vertexLit2 Shr shift) And 255, 2
Next

; Flat shading keeps the lighting of the first vertex, so the setting changes nothing for it.
FreeEntity light
light = CreateLight(2)
PositionEntity light, 0, 0, -1
LightRange light, 2
EntityFX mesh, 4
PerPixelLighting 0
Render
flatOff = Grey(W / 2, H / 2)
PerPixelLighting 1
Render
Check "Flat shaded entities are lit by their first vertex", Grey(W / 2, H / 2), flatOff, 0

Done "blitz3d_per_pixel_lighting_pixels"
