; A texture that was loaded from a file reads the file again when the graphics device is lost, instead of the program keeping a copy of
; it: a texture that was written to has what was written, one whose file is gone is magenta, and more losses than two are fine when
; the cooldown (BLITZLLVM_DEVICE_LOSS_COOLDOWN_MS) is over between them. This needs a window and a GPU, so it is skipped without one.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_device_lost_files_pixels: skipped, there is no window."
	End
EndIf

SetEnv "BLITZLLVM_SIMULATE_DEVICE_LOSS", "3,6,9,12"
SetEnv "BLITZLLVM_DEVICE_LOSS_COOLDOWN_MS", "0"
Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Const SIZE = 8

Function Fill(buffer, seed)
	LockBuffer buffer
	For y = 0 To SIZE - 1
		For x = 0 To SIZE - 1
			WritePixelFast x, y, $FF000000 Or (((x * 28 + seed) And 255) Shl 16) Or (((y * 28 + seed * 3) And 255) Shl 8) Or ((x + y) * 9 + 40), buffer
		Next
	Next
	UnlockBuffer buffer
End Function

Function Hash(buffer)
	h = 0
	For y = 0 To SIZE - 1
		For x = 0 To SIZE - 1
			h = (h * 31 + (ReadPixel(x, y, buffer) And $FFFFFF)) And $7FFFFFFF
		Next
	Next
	Return h
End Function

Function LoseDevice()
	; Flip until GraphicsLost says that the device was lost.
	For i = 1 To 3
		Flip
		If GraphicsLost() Then Return True
	Next
	Return False
End Function

Global source = CreateTexture(SIZE, SIZE, 1)
Fill TextureBuffer(source), 10
Global hash_source = Hash(TextureBuffer(source))
SaveBuffer TextureBuffer(source), "suite_tmp_lost_a.bmp"
SaveBuffer TextureBuffer(source), "suite_tmp_lost_b.bmp"

Global kept = LoadTexture("suite_tmp_lost_a.bmp", 1)
Global gone = LoadTexture("suite_tmp_lost_b.bmp", 1)
Check "The loaded texture has the file", Hash(TextureBuffer(kept)), hash_source

; 1st loss: the file is read again.
Flip
Flip
CheckTrue "1st loss", LoseDevice()
Check "Read again from the file", Hash(TextureBuffer(kept)), hash_source

; Written to, the texture has what was written (and no longer what the file has).
Fill TextureBuffer(kept), 77
Global hash_written = Hash(TextureBuffer(kept))
CheckTrue "The write changed the texture", hash_written <> hash_source
CheckTrue "2nd loss", LoseDevice()
Check "Written texture after the 2nd loss", Hash(TextureBuffer(kept)), hash_written
Check "The other one is read again as well", Hash(TextureBuffer(gone)), hash_source

; The file is gone: the texture is magenta and the program goes on.
DeleteFile "suite_tmp_lost_b.bmp"
CheckTrue "3rd loss", LoseDevice()
Check "A texture whose file is gone is magenta", ReadPixel(3, 3, TextureBuffer(gone)) And $FFFFFF, $FF00FF
Check "Written texture after the 3rd loss", Hash(TextureBuffer(kept)), hash_written

; Past the cooldown a 4th loss is fine as well.
CheckTrue "4th loss", LoseDevice()
Check "Written texture after the 4th loss", Hash(TextureBuffer(kept)), hash_written

DeleteFile "suite_tmp_lost_a.bmp"
Done "graphics_device_lost_files_pixels"
