; What the window shows is 8 bits, and the picture of a deeper buffer (Graphics depth 64) turns into 8 bits there. That is where
; Dither belongs: a value in between two steps is spread over its two neighbors, and without Dither it is rounded. This needs a
; window and a GPU, so it is skipped without one. BLITZLLVM_TEST_PRESENT makes the runtime write what it showed to a file.
Include "check.bb"

If GetEnv$("BLITZLLVM_HEADLESS") <> "" Then
	Print "graphics_dither_deep_present_pixels: skipped, there is no window."
	End
EndIf

Const W = 64, H = 48

; How many pixels of the picture that was shown are value + 1, with all the others value (anything else stops the test).
Function CountShown(value)
	f = ReadFile("present.tmp")
	If f = 0 Then RuntimeError "Nothing was presented."
	For line = 1 To 3
		ReadLine$(f)
	Next
	same = 0
	other = 0
	For i = 1 To W * H
		r = ReadByte(f)
		ReadByte(f)
		ReadByte(f)
		If r = value Then same = same + 1
		If r = value + 1 Then other = other + 1
	Next
	CloseFile f
	If same + other <> W * H Then RuntimeError "A value of the picture is not one of the two neighbors: " + same + " + " + other
	Return other
End Function

Function Fill(gray#)
	For y = 0 To H - 1
		For x = 0 To W - 1
			WritePixel64 x, y, 0, gray, gray, gray, 1.0
		Next
	Next
End Function

SetEnv "BLITZLLVM_TEST_PRESENT", "present.tmp"
Graphics W, H, 64, 2
SetBuffer BackBuffer()

; 100.5 of 255 is in the middle between 100 and 101.
Fill 100.5 / 255.0
Dither False
Flip 2
Check "without Dither the middle is rounded to one neighbor", CountShown(100) = 0 Or CountShown(100) = W * H, True

Dither True
Flip 2
other = CountShown(100)
Check "with Dither the middle is spread over both neighbors", other > (W * H) / 4 And other < (W * H) * 3 / 4, True

; A quarter above 100 is a quarter of the pixels at 101.
Fill 100.25 / 255.0
Flip 2
other = CountShown(100)
Check "a quarter step is a quarter of the pixels", other > (W * H) / 8 And other < (W * H) * 3 / 8, True

; The ends of the range stay: black is not lifted and white is not dimmed.
Fill 0.0
Flip 2
Check "black stays", CountShown(0), 0
Fill 1.0
Flip 2
Check "white stays", CountShown(254), W * H
Dither False
EndGraphics
DeleteFile "present.tmp"
Done "graphics_dither_deep_present_pixels"
