; Strings carry their length, so Chr$(0) is a character like any other: the original keeps it in its strings as well.
Include "check.bb"

nul$ = Chr$(0)
Check "Chr$(0) length", Len(nul), 1
Check "Chr$(0) is 0", Asc(nul), 0

; Joining keeps everything on both sides of the NUL.
a$ = "ab" + nul + "cd"
Check "Len concat", Len(a), 5
CheckS "Left$", Left$(a, 3), "ab" + nul
CheckS "Right$", Right$(a, 3), nul + "cd"
CheckS "Mid$ over NUL", Mid$(a, 2, 3), "b" + nul + "c"
Check "Asc at NUL", Asc(Mid$(a, 3, 1)), 0

; Comparing looks at everything, not at the first NUL.
CheckTrue "equal", a = "ab" + Chr$(0) + "cd"
CheckTrue "differ after NUL", a <> "ab" + Chr$(0) + "ce"
CheckTrue "less after NUL", a < "ab" + Chr$(0) + "ce"
CheckTrue "NUL string is not empty", nul <> ""
CheckTrue "prefix is less", "ab" < a
CheckTrue "NUL sorts before others", "ab" + nul < "ab" + Chr$(1)

; Searching and replacing work across NUL.
Check "Instr NUL", Instr(a, nul), 3
Check "Instr after NUL", Instr(a, "cd"), 4
Check "Instr NUL start", Instr(a, nul, 4), 0
CheckS "Replace$ NUL", Replace$(a, nul, "-"), "ab-cd"
CheckS "Replace$ with NUL", Replace$("ab-cd", "-", nul), a
Check "Len Replace$", Len(Replace$(a, "cd", "")), 3

; Case changes, trimming and padding keep the NUL.
Check "Upper$", Len(Upper$(a)), 5
CheckS "Upper$ text", Mid$(Upper$(a), 4, 2), "CD"
Check "Lower$", Len(Lower$(Upper$(a))), 5
Check "LSet$", Len(LSet$(a, 8)), 8
CheckS "LSet$ text", Left$(LSet$(a, 8), 5), a
CheckS "RSet$ text", Right$(RSet$(a, 8), 5), a
Check "String$", Len(String$(nul, 4)), 4
Check "String$ ab", Len(String$("a" + nul, 3)), 6

; Variables, arrays and fields hold the whole string.
Dim list$(2)
list(1) = a
Check "Dim", Len(list(1)), 5
Type Holder
	Field text$
End Type
h.Holder = New Holder
h\text = a
Check "Field", Len(h\text), 5
h\text = h\text + a
Check "Field concat", Len(h\text), 10

; Functions take and give them.
Function Twice$(s$)
	Return s + s
End Function
Check "Function", Len(Twice(a)), 10

; Files keep them as well.
name$ = "suite_tmp_strings_nul.bin"
file = WriteFile(name)
WriteString file, a
WriteLine file, a
WriteString file, nul
CloseFile file
Check "file size", FileSize(name), 4 + 5 + 5 + 2 + 4 + 1
file = ReadFile(name)
CheckS "ReadString", ReadString$(file), a
CheckS "ReadLine", ReadLine$(file), a
CheckS "ReadString NUL", ReadString$(file), nul
CloseFile file
DeleteFile name

; Str and Hex stay as they were.
CheckS "Str", Str(12) + nul, "12" + nul

Done "strings_nul"
