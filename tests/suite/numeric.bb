; Numbers of the sized types: Byte UByte Short UShort UInt Long ULong Half Double (convert between them), SatByte SatUByte
; SatShort SatUShort SatInt SatUInt SatLong SatULong (convert and stop at the largest number), PopCount LeadingZeros
; TrailingZeros RotL RotR ByteSwap (bits), and Abs Sgn Sqr Sin Cos Tan ASin ACos ATan ATan2 Floor Ceil Exp Log Log10 for
; the types that are not Int and Float.
Include "check.bb"

; Integers wrap around, which keeps the lowest bits.
CheckS "Byte 127", Str(Byte(127)), "127"
CheckS "Byte 128", Str(Byte(128)), "-128"
CheckS "Byte 300", Str(Byte(300)), "44"
CheckS "Byte -1", Str(Byte(-1)), "-1"
CheckS "UByte 255", Str(UByte(255)), "255"
CheckS "UByte 256", Str(UByte(256)), "0"
CheckS "UByte -1", Str(UByte(-1)), "255"
CheckS "Short 40000", Str(Short(40000)), "-25536"
CheckS "UShort -1", Str(UShort(-1)), "65535"
CheckS "UShort 65536", Str(UShort(65536)), "0"
CheckS "UInt -1", Str(UInt(-1)), "4294967295"
CheckS "Int of UInt", Str(Int(UInt(-1))), "-1"
CheckS "Long of Int", Str(Long(-5)), "-5"
CheckS "Long of UInt", Str(Long(UInt(-1))), "4294967295"
CheckS "ULong -1", Str(ULong(-1)), "18446744073709551615"
CheckS "Long of ULong", Str(Long(ULong(-1))), "-1"
CheckS "Long big", Str(Long(5000000000i64)), "5000000000"
CheckS "Int of Long", Str(Int(Long(4294967297i64))), "1"

; Reals are rounded to the nearest whole number, halves to the even one. What does not fit stops at the largest number.
CheckS "Byte 2.5", Str(Byte(2.5)), "2"
CheckS "Byte 3.5", Str(Byte(3.5)), "4"
CheckS "Byte -2.6", Str(Byte(-2.6)), "-3"
CheckS "Byte 1000.0", Str(Byte(1000.0)), "127"
CheckS "Byte -1000.0", Str(Byte(-1000.0)), "-128"
CheckS "UByte -3.0", Str(UByte(-3.0)), "0"
CheckS "UByte 300.0", Str(UByte(300.0)), "255"
CheckS "Short 1e5", Str(Short(100000.0)), "32767"
CheckS "UInt 5e9", Str(UInt(5000000000.0)), "4294967295"
CheckS "Int 1e10", Str(Int(10000000000.0)), "2147483647"
CheckS "Int -1e10", Str(Int(-10000000000.0)), "-2147483648"
CheckS "Long 1e19", Str(Long(10000000000000000000.0)), "9223372036854775807"
CheckS "ULong 1e20", Str(ULong(100000000000000000000.0)), "18446744073709551615"
CheckS "ULong 3e9", Str(ULong(3000000000.0)), "3000000000"
d:Double = 0.0
CheckS "Int NaN", Str(Int(d / d)), "0"

; Strings are read as numbers.
CheckS "Byte string", Str(Byte("200")), "-56"
CheckS "Long string", Str(Long("9000000000")), "9000000000"
CheckS "UInt string", Str(UInt("12")), "12"

; The Sat versions stop at the smallest and largest number of the type.
CheckS "SatByte 100", Str(SatByte(100)), "100"
CheckS "SatByte 200", Str(SatByte(200)), "127"
CheckS "SatByte -200", Str(SatByte(-200)), "-128"
CheckS "SatUByte 300", Str(SatUByte(300)), "255"
CheckS "SatUByte -5", Str(SatUByte(-5)), "0"
CheckS "SatShort 70000", Str(SatShort(70000)), "32767"
CheckS "SatShort -70000", Str(SatShort(-70000)), "-32768"
CheckS "SatUShort 70000", Str(SatUShort(70000)), "65535"
CheckS "SatUShort -1", Str(SatUShort(-1)), "0"
CheckS "SatInt big", Str(SatInt(Long(5000000000i64))), "2147483647"
CheckS "SatInt small", Str(SatInt(Long(-5000000000i64))), "-2147483648"
CheckS "SatInt fits", Str(SatInt(Long(-7))), "-7"
CheckS "SatUInt -1", Str(SatUInt(-1)), "0"
CheckS "SatUInt big", Str(SatUInt(Long(5000000000i64))), "4294967295"
CheckS "SatLong of ULong", Str(SatLong(ULong(-1))), "9223372036854775807"
CheckS "SatLong fits", Str(SatLong(ULong(7))), "7"
CheckS "SatULong -1", Str(SatULong(-1)), "0"
CheckS "SatULong of Long", Str(SatULong(Long(9000000000))), "9000000000"
CheckS "SatByte real", Str(SatByte(500.5)), "127"
CheckS "SatInt string", Str(SatInt("99999999999")), "2147483647"

; Reals.
h:Half = Half(1.5)
Check "Half", h * 2, 3
CheckS "Half to string", Str(Half(2)), "2.0"
Check "Half big", Half(60000.0), 60000, 32
x:Double = Double(1) / 3
Check "Double", x * 3, 1, 0.000000000001
Check "Double of Long", Double(Long(5000000000i64)), 5000000000.0, 1
CheckS "Double of string", Str(Double("2.5")), "2.5"

; The result keeps its type, so it widens the way that type does.
a:UByte = UByte(250)
CheckS "UByte add", Str(a + 10), "260"
b:Byte = Byte(-6)
CheckS "Byte add", Str(b + 1), "-5"
c:UInt = UInt(4000000000)
CheckS "UInt add", Str(c + 1), "4000000001"
big:ULong = ULong(-1)
CheckS "ULong shr", Str(big Shr 60), "15"

; Abs and Sgn do not see an unsigned number as negative.
CheckS "Abs UInt", Str(Abs(UInt(-1))), "4294967295"
CheckS "Abs ULong", Str(Abs(ULong(-1))), "18446744073709551615"
CheckS "Abs UByte", Str(Abs(UByte(200))), "200"
CheckS "Sgn UInt", Str(Sgn(UInt(-1))), "1"
CheckS "Sgn UInt 0", Str(Sgn(UInt(0))), "0"
CheckS "Sgn ULong", Str(Sgn(ULong(-1))), "1"
CheckS "Abs Byte", Str(Abs(Byte(-100))), "100"
CheckS "Sgn Short", Str(Sgn(Short(-9))), "-1"
CheckS "Abs Long", Str(Abs(Long(-5000000000i64))), "5000000000"
CheckS "Sgn Long", Str(Sgn(Long(-5000000000i64))), "-1"
CheckS "Min ULong", Str(Min(ULong(-1), ULong(5))), "5"
CheckS "Max ULong", Str(Max(ULong(-1), ULong(5))), "18446744073709551615"
CheckS "Max UInt", Str(Max(UInt(-1), UInt(5))), "4294967295"

; Bits keep the width of the number: the Byte -1 has 8 bits set and the Int -1 has 32.
CheckS "PopCount Byte", Str(PopCount(Byte(-1))), "8"
CheckS "PopCount Int", Str(PopCount(-1)), "32"
CheckS "PopCount ULong", Str(PopCount(ULong(-1))), "64"
CheckS "PopCount 0", Str(PopCount(0)), "0"
CheckS "PopCount 255", Str(PopCount(255)), "8"
CheckS "LeadingZeros 1", Str(LeadingZeros(1)), "31"
CheckS "LeadingZeros UByte", Str(LeadingZeros(UByte(1))), "7"
CheckS "LeadingZeros Long", Str(LeadingZeros(Long(1))), "63"
CheckS "LeadingZeros 0", Str(LeadingZeros(0)), "32"
CheckS "LeadingZeros -1", Str(LeadingZeros(-1)), "0"
CheckS "TrailingZeros 8", Str(TrailingZeros(8)), "3"
CheckS "TrailingZeros Short", Str(TrailingZeros(Short(0))), "16"
CheckS "TrailingZeros ULong", Str(TrailingZeros(ULong(1) Shl 40)), "40"
CheckS "RotL UByte", Str(RotL(UByte($81), 1)), "3"
CheckS "RotR UByte", Str(RotR(UByte($81), 1)), "192"
CheckS "RotL Int", Str(RotL($80000001, 4)), "24"
CheckS "RotR Int", Str(RotR(1, 1)), "-2147483648"
CheckS "RotL 32", Str(RotL(5, 32)), "5"
CheckS "RotL negative", Str(RotL(1, -1)), "-2147483648"
CheckS "RotL ULong", Str(RotL(ULong(1) Shl 63, 1)), "1"
CheckS "ByteSwap Short", Str(ByteSwap(UShort($1234))), "13330"
CheckS "ByteSwap Int", Hex(ByteSwap($12345678)), "78563412"
CheckS "ByteSwap UByte", Str(ByteSwap(UByte(7))), "7"
CheckS "ByteSwap ULong", Str(ByteSwap(ULong(1))), "72057594037927936"
CheckS "PopCount real", Str(PopCount(3.0)), "2"

; Doubles keep their precision where a Float would not.
r:Double = Double(2)
Check "Sqr Double", Sqr(r) * Sqr(r), 2, 0.000000000000001
Check "Sqr Float", Sqr(2) * Sqr(2), 2, 0.0001
CheckTrue "Sqr Float is a float", Abs(Double(Sqr(2)) - Sqr(r)) > 0.0000000001
Check "Sin Double", Sin(Double(30)), 0.5, 0.000000000000001
Check "Cos Double", Cos(Double(60)), 0.5, 0.000000000000001
Check "Tan Double", Tan(Double(45)), 1, 0.000000000000001
Check "ASin Double", ASin(Double(1)), 90, 0.000000000000001
Check "ACos Double", ACos(Double(0)), 90, 0.000000000000001
Check "ATan Double", ATan(Double(1)), 45, 0.000000000000001
Check "ATan2 Double", ATan2(Double(1), 1), 45, 0.000000000000001
Check "ATan2 Double second", ATan2(1, Double(-1)), 135, 0.000000000000001
Check "Floor Double", Floor(Double(-2.5)), -3
Check "Ceil Double", Ceil(Double(-2.5)), -2
Check "Exp Double", Exp(Double(1)), 2.718281828459045, 0.000000000000001
Check "Log Double", Log(Double(10)), 2.302585092994046, 0.000000000000001
Check "Log10 Double", Log10(Double(1000)), 3, 0.000000000000001
p:Double = Double(1) / 3
CheckTrue "Double is kept", Floor(p * 3000000000.0) = 1000000000.0
Check "Double stays", Floor(Double(5000000000.5)), 5000000000.0, 1

Done "numeric"

; Literal suffixes name the exact type of a number.
CheckS "i8 max", Str(127i8), "127"
CheckS "i8 min", Str(-128i8), "-128"
CheckS "ui8 max", Str(255ui8), "255"
CheckS "i16 min", Str(-32768i16), "-32768"
CheckS "ui16 max", Str(65535ui16), "65535"
CheckS "i32 min", Str(-2147483648i32), "-2147483648"
CheckS "ui32 max", Str(4294967295ui32), "4294967295"
CheckS "i64 min", Str(-9223372036854775808i64), "-9223372036854775808"
CheckS "i64 big", Str(5000000000i64), "5000000000"
CheckS "ui64 max", Str(18446744073709551615ui64), "18446744073709551615"
CheckS "upper case", Str(200UI8), "200"
CheckS "hex bit pattern i8", Str(0xFFi8), "-1"
CheckS "hex bit pattern ui8", Str(0xFFui8), "255"
CheckS "hex bit pattern i16", Str(0xFFFFi16), "-1"
CheckS "hex f is a digit", Str(0xFFf), "4095"
CheckS "hex d is a digit", Str(0x1Dd), "477"
CheckS "binary i8", Str(0b11111111i8), "-1"
CheckS "binary ui8", Str(0b11111111ui8), "255"
CheckS "u still works", Str(5u), "5"
CheckS "hex u still works", Str(0xFFFFFFFFu), "4294967295"
CheckS "hex 32 bits is an Int", Str(0xFFFFFFFF), "-1"
; Sums of the sized types are Int, so the type is seen from what wraps.
CheckS "ui8 wraps when stored", Str(UByte(250ui8 + 10)), "4"
Local sized_b:Byte = 100i8
Local sized_ub:UByte = 200ui8
Local sized_s:Short = -300i16
Local sized_l:Long = 1i64 Shl 40
CheckS "stored Byte", Str(sized_b), "100"
CheckS "stored UByte", Str(sized_ub), "200"
CheckS "stored Short", Str(sized_s), "-300"
CheckS "stored Long", Str(sized_l), "1099511627776"
Check "1f is a Float", 1f / 3, 0.3333333, 0.000001
Check "fp32", 1.5fp32, 1.5
Check "1d is a Double", Double(1d) / 3d, 0.3333333333333333, 0.0000000000001
Check "fp64", 0.1fp64 * 3, 0.3
Check "h", 1.5h * 2, 3.0
Check "fp16", 2fp16 + 1, 3.0
Check "h rounds", Double(0.1h), 0.0999755859375, 0.0000000001
Check "h max", Double(65504h), 65504.0
Check "neg real", -2.5d, -2.5
Check "d keeps precision", Double(0.1d), 0.1, 0.0000000000000001
Check "binary f", 0b101f, 5.0
Check "binary d", Double(0b11d), 3.0
Check "binary h", Double(0b100h), 4.0
Check "binary fp64", Double(0b1000fp64), 8.0
