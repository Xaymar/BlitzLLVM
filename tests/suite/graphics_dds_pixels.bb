; this is skipped without one: LoadImage DrawBlock ReadPixel and LoadTexture TextureBuffer with DDS files. Each file has a red
; left half and a blue right half, and the ones with alpha are see-through on the right half.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "graphics_dds_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

Function CheckColor(name$, color, red, green, blue)
	Check name + " red", (color Shr 16) And 255, red, 4
	Check name + " green", (color Shr 8) And 255, green, 4
	Check name + " blue", color And 255, blue, 4
End Function

; Compressed pictures may be off by a bit. A picture with alpha is drawn over green, which shows through its right half.
Function CheckHalves(name$, file$, alpha)
	ClsColor 0, 255, 0
	Cls
	image = LoadImage(file)
	CheckTrue name + " loads", image <> 0
	If alpha Then DrawImage image, 0, 0 Else DrawBlock image, 0, 0
	CheckColor name + " left", ReadPixel(2, 2) And $FFFFFF, 255, 0, 0
	If alpha Then CheckColor name + " right", ReadPixel(6, 2) And $FFFFFF, 0, 255, 0 Else CheckColor name + " right", ReadPixel(6, 2) And $FFFFFF, 0, 0, 255
	FreeImage image
	texture = LoadTexture(file)
	CheckTrue name + " loads as a texture", texture <> 0
	SetBuffer TextureBuffer(texture)
	CheckColor name + " texture left", ReadPixel(2, 2) And $FFFFFF, 255, 0, 0
	If Not alpha Then CheckColor name + " texture right", ReadPixel(6, 2) And $FFFFFF, 0, 0, 255
	SetBuffer BackBuffer()
	FreeTexture texture
End Function

CheckHalves "DXT1", "images/dxt1.dds", 0
CheckHalves "DXT3", "images/dxt3.dds", 1
CheckHalves "DXT5", "images/dxt5.dds", 1
CheckHalves "BC7", "images/bc7.dds", 1
CheckHalves "BGRA", "images/bgra.dds", 1
CheckHalves "RGB 24 bit", "images/rgb24.dds", 0
CheckHalves "RGB 565", "images/rgb565.dds", 0

; BC4 has one channel, which is shown as grey: white on the left and black on the right.
ClsColor 0, 0, 0
Cls
grey = LoadImage("images/bc4.dds")
DrawBlock grey, 0, 0
CheckColor "BC4 left", ReadPixel(2, 2) And $FFFFFF, 255, 255, 255
CheckColor "BC4 right", ReadPixel(6, 2) And $FFFFFF, 0, 0, 0
FreeImage grey

; Compressed pictures are kept as they are on the GPU, and become ordinary ones when they are drawn to, so everything that
; changes pixels has to keep the rest of the picture.
ClsColor 0, 0, 0
Cls
texture = LoadTexture("images/dxt1.dds")
SetBuffer TextureBuffer(texture)
Color 0, 255, 0
Plot 6, 2
CheckColor "DXT1 texture drawn to, the plot", ReadPixel(6, 2) And $FFFFFF, 0, 255, 0
CheckColor "DXT1 texture drawn to, the rest", ReadPixel(2, 2) And $FFFFFF, 255, 0, 0
CheckColor "DXT1 texture drawn to, the other half", ReadPixel(5, 2) And $FFFFFF, 0, 0, 255
SetBuffer BackBuffer()
FreeTexture texture

texture = LoadTexture("images/dxt5.dds", 1 + 2)
SetBuffer TextureBuffer(texture)
CheckColor "DXT5 texture read", ReadPixel(2, 2) And $FFFFFF, 255, 0, 0
Check "DXT5 texture alpha on the left", (ReadPixel(2, 2) Shr 24) And 255, 255
Check "DXT5 texture alpha on the right", (ReadPixel(6, 2) Shr 24) And 255, 0
SetBuffer BackBuffer()
FreeTexture texture

image = LoadImage("images/dxt1.dds")
SetBuffer ImageBuffer(image)
Color 0, 255, 0
Plot 1, 1
SetBuffer BackBuffer()
Cls
DrawBlock image, 0, 0
CheckColor "DXT1 image drawn to, the plot", ReadPixel(1, 1) And $FFFFFF, 0, 255, 0
CheckColor "DXT1 image drawn to, the rest", ReadPixel(6, 2) And $FFFFFF, 0, 0, 255
FreeImage image

image = LoadImage("images/dxt1.dds")
copied = CopyImage(image)
Cls
DrawBlock copied, 0, 0
CheckColor "CopyImage of a DXT1 image", ReadPixel(6, 2) And $FFFFFF, 0, 0, 255
FreeImage copied

ClsColor 0, 255, 0
Cls
GrabImage image, 0, 0
SetBuffer ImageBuffer(image)
CheckColor "GrabImage into a DXT1 image", ReadPixel(2, 2) And $FFFFFF, 0, 255, 0
SetBuffer BackBuffer()
FreeImage image

EndGraphics
Done "graphics_dds_pixels"
