; Movies, without a window: OpenMovie CloseMovie MovieWidth MovieHeight MoviePlaying. The three files in movies/ are the same
; movie of 3 seconds, 64 x 48 pixels, 25 pictures a second and a tone of 440 Hz, as MPEG-1 + MP2, MPEG-4 + PCM in an AVI and
; H.264 + AAC in MP4. Made with ffmpeg: red, green and blue for a second each (color=c=0xff0000:s=64x48:r=25:d=1 and so on, joined with
; concat) and sine=f=440:d=3:r=8000. The picture on the screen is in graphics_movies_pixels.bb.
Include "check.bb"

; Without the libraries of FFmpeg next to the program there are no movies at all, which is the same as a movie that can't be played.
; blitzcc copies them there for programs that use OpenMovie, so here they are.
Dim files$(2)
files(0) = "movies/colors.mpg"
files(1) = "movies/colors.avi"
files(2) = "movies/colors.mp4"

For i = 0 To 2
	movie = OpenMovie(files(i))
	CheckTrue "OpenMovie of " + files(i), movie <> 0
	Check "MovieWidth of " + files(i), MovieWidth(movie), 64
	Check "MovieHeight of " + files(i), MovieHeight(movie), 48
	Check "MoviePlaying at the start of " + files(i), MoviePlaying(movie), 1

	; It plays by itself at its normal speed, and is over after 3 seconds.
	started = MilliSecs()
	While MoviePlaying(movie) And (MilliSecs() - started < 8000)
		Delay 20
	Wend
	elapsed = MilliSecs() - started
	Check "MoviePlaying ends after 3 s for " + files(i) + " (" + elapsed + " ms)", elapsed, 3000, 700
	Check "MoviePlaying stays 0 for " + files(i), MoviePlaying(movie), 0

	CloseMovie movie
	Check "MoviePlaying after CloseMovie of " + files(i), MoviePlaying(movie), 0
	Check "MovieWidth after CloseMovie of " + files(i), MovieWidth(movie), 0
Next

; PauseMovie holds the clock, and PlayMovie lets it go on: a movie that is paused before it was used does not start, and one that is
; paused later stays where it is. The 3 seconds only run while it plays.
For i = 0 To 2
	movie = OpenMovie(files(i))
	PauseMovie movie
	Delay 1500
	Check "MoviePlaying while paused before the start of " + files(i), MoviePlaying(movie), 1
	PlayMovie movie
	started = MilliSecs()
	Delay 1000
	PauseMovie movie
	Delay 1500
	Check "MoviePlaying while paused in the middle of " + files(i), MoviePlaying(movie), 1
	PauseMovie movie
	PlayMovie movie
	PlayMovie movie
	While MoviePlaying(movie) And (MilliSecs() - started < 12000)
		Delay 20
	Wend
	elapsed = MilliSecs() - started
	Check "A movie plays for 3 s of the time that it is not paused for " + files(i) + " (" + elapsed + " ms)", elapsed, 4500, 900
	CloseMovie movie
Next
PauseMovie 0
PlayMovie 0

; Handles can be used again.
a = OpenMovie("movies/colors.mpg")
b = OpenMovie("movies/colors.mp4")
CheckTrue "Two movies at once", (a <> 0) And (b <> 0) And (a <> b)
CloseMovie a
c = OpenMovie("movies/colors.avi")
CheckTrue "A handle that was closed is used again", c = a
CloseMovie b
CloseMovie c

; What can't be played.
Check "OpenMovie of a file that does not exist", OpenMovie("movies/does_not_exist.mpg"), 0
Check "OpenMovie of a file that is not a movie", OpenMovie("check.bb"), 0
Check "OpenMovie of nothing", OpenMovie(""), 0
Check "MovieWidth of no movie", MovieWidth(0), 0
Check "MoviePlaying of no movie", MoviePlaying(0), 0
CloseMovie 0
DrawMovie 0, 0, 0

Print "graphics_movies: " + suite_checks + " checks passed."
