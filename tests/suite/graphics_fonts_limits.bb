; LoadFont with font files that are not what they say: a letter that is much bigger than the font, which would not fit in the picture that
; the letters are drawn into, and files that end before the tables that they list. Such a file is not used, and must
; not make the program write or read outside of its memory. images/huge_glyph.ttf comes from tools/generate_font_limits_fixture.py.
Include "check.bb"

Graphics 320, 240, 32, 2

; The letter A is 1000 pixels wide for each pixel of height, so 64000 wide at this height, and is left out. The font works otherwise.
font = LoadFont("images/huge_glyph.ttf", 64)
CheckTrue "LoadFont with a huge glyph", font <> 0
SetFont font
Check "FontHeight", FontHeight(), 64
Text 10, 10, "AAAA AAAA"
Flip
FreeFont font

; The same file with the end cut off: the tables are not all there.
size = FileSize("images/huge_glyph.ttf")
CheckTrue "Fixture", size > 200
bank = CreateBank(size)
file = ReadFile("images/huge_glyph.ttf")
ReadBytes bank, file, 0, size
CloseFile file
file = WriteFile("suite_tmp_cut.ttf")
WriteBytes bank, file, 0, size / 2
CloseFile file
font = LoadFont("suite_tmp_cut.ttf", 16)
CheckTrue "LoadFont of a font that is cut off", font <> 0
SetFont font
Text 10, 10, "ABC"
SetFont 0
FreeFont font

; A file that is smaller than the start of a font.
file = WriteFile("suite_tmp_cut.ttf")
WriteByte file, 0
CloseFile file
font = LoadFont("suite_tmp_cut.ttf", 16)
CheckTrue "LoadFont of a file with one byte", font <> 0
SetFont font
Text 10, 10, "ABC"
SetFont 0
FreeFont font
DeleteFile "suite_tmp_cut.ttf"
FreeBank bank

Done "graphics_fonts_limits"
