; How 3D is lit and projected, which needs a window and a GPU, so this is skipped without one: EntityShininess (the
; highlight of lights), spot lights, negative lights, the effects of EntityFX (vertex colors, flat shading, no fog and
; vertex alpha), orthographic cameras and the plane that has no end.
Include "check.bb"

If GetEnv$("BLITZ_HEADLESS") <> "" Then
	Print "blitz3d_lighting_pixels: skipped, there is no window."
	End
EndIf

Graphics3D 160, 120, 32, 2
SetBuffer BackBuffer()

; The red, green and blue of a pixel, one at a time.
Function R(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 16) And 255
End Function
Function G(x, y)
	Return (ReadPixel(x, y, BackBuffer()) Shr 8) And 255
End Function
Function B(x, y)
	Return ReadPixel(x, y, BackBuffer()) And 255
End Function

camera = CreateCamera()
PositionEntity camera, 0, 0, -5
CameraClsColor camera, 10, 20, 30

; The brightest of the four pixels around the middle of the picture, as the corner is on the edge between them and
; the triangles that meet there decide which of the four is the closest to it.
Function Peak()
	m = R(79, 59)
	If R(80, 59) > m Then m = R(80, 59)
	If R(79, 60) > m Then m = R(79, 60)
	If R(80, 60) > m Then m = R(80, 60)
	Return m
End Function

; A light that shines the way the camera looks, on a sphere that has a corner in the middle of the picture.
AmbientLight 0, 0, 0
light = CreateLight()
sphere = CreateSphere(32)
EntityColor sphere, 30, 30, 30

RenderWorld
Check "Lit sphere without a highlight", R(80, 60), 30, 6

; The highlight is white, and as strong as the shininess says.
EntityShininess sphere, 1
RenderWorld
CheckTrue "EntityShininess 1 (" + Peak() + ")", Peak() > 230
Check "The highlight is white", B(80, 60), R(80, 60), 4
EntityShininess sphere, 0.2
RenderWorld
Check "EntityShininess 0.2", Peak(), 30 + 0.2 * 255, 16
; It is only where the light is reflected towards the camera: the side of the sphere has none.
EntityShininess sphere, 1
RenderWorld
CheckTrue "No highlight at the side (" + R(110, 60) + ")", R(110, 60) < 150
EntityShininess sphere, 0

; A highlight needs a light, so fullbright things do not have one.
EntityShininess sphere, 1
EntityFX sphere, 1
RenderWorld
Check "Fullbright has no highlight", R(80, 60), 30, 4
EntityFX sphere, 0
EntityShininess sphere, 0

; Lights can have negative colors, which make things darker.
EntityColor sphere, 255, 255, 255
AmbientLight 200, 200, 200
LightColor light, 0, 0, 0
RenderWorld
Check "Ambient light only", R(80, 60), 200, 8
LightColor light, -150, -150, -150
RenderWorld
Check "A light with a negative color", R(80, 60), 50, 8
LightColor light, 255, 255, 255
FreeEntity sphere
AmbientLight 0, 0, 0

; EntityFX 2 uses the colors of the vertices instead of the color of the entity.
cube = CreateCube()
EntityFX cube, 1
surface = GetSurface(cube, 1)
For i = 0 To CountVertices(surface) - 1
	VertexColor surface, i, 255, 0, 0, 1
Next
RenderWorld
Check "Vertex colors are ignored at first", G(80, 60), 255, 3
EntityFX cube, 1 + 2
RenderWorld
Check "EntityFX 2 shows the vertex color", R(80, 60), 255, 3
Check "EntityFX 2 replaces the white", G(80, 60), 0, 3

; EntityFX 32 also uses the alpha of the vertices.
For i = 0 To CountVertices(surface) - 1
	VertexColor surface, i, 255, 0, 0, 0.5
Next
RenderWorld
Check "Without EntityFX 32 the alpha is ignored", R(80, 60), 255, 3
EntityFX cube, 1 + 2 + 32
RenderWorld
Check "EntityFX 32 blends", R(80, 60), (255 + 10) / 2, 8
Check "EntityFX 32 blends with what is behind", G(80, 60), 20 / 2, 6
FreeEntity cube

; EntityFX 8 takes away the fog.
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0
CameraFogMode camera, 1
CameraFogColor camera, 0, 0, 255
CameraFogRange camera, 1, 6
RenderWorld
CheckTrue "Fog adds blue (" + B(80, 60) + ")", B(80, 60) > 60
EntityFX cube, 1 + 8
RenderWorld
Check "EntityFX 8 has no blue", B(80, 60), 0, 3
Check "EntityFX 8 keeps the red", R(80, 60), 255, 3
CameraFogMode camera, 0
FreeEntity cube

; EntityFX 4 gives a triangle the color of its first corner. This one has the light on the corner at the bottom left
; and none on the other two, so without it the right side of the triangle is dark.
tri = CreateMesh()
face = CreateSurface(tri)
v0 = AddVertex(face, -1, -1, 0)
v1 = AddVertex(face, 1, -1, 0)
v2 = AddVertex(face, 0, 1, 0)
VertexNormal face, v0, 0, 0, -1
VertexNormal face, v1, 0, 0, 1
VertexNormal face, v2, 0, 0, 1
AddTriangle face, v0, v2, v1
AmbientLight 0, 0, 0
RenderWorld
CheckTrue "The corner with the light is lit (" + R(68, 74) + ")", R(68, 74) > 150
CheckTrue "Shading is smooth at first (" + R(90, 72) + ")", R(90, 72) < 100
EntityFX tri, 4
RenderWorld
CheckTrue "Flat shading (" + R(90, 72) + ")", R(90, 72) > 150
FreeEntity tri

; An orthographic camera shows things as big far away as near.
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0
CameraRange camera, 1, 200
CameraZoom camera, 0.25
CameraProjMode camera, 2
RenderWorld
Check "Orthographic cube", R(70, 60), 255, 3
Check "Orthographic cube width", R(50, 60), 10, 3
Check "Orthographic cube height", R(80, 45), 255, 3
Check "Orthographic cube above", R(80, 30), 10, 3
PositionEntity cube, 0, 0, 100
RenderWorld
Check "The same size far away", R(70, 60), 255, 3
Check "The same size far away, outside", R(50, 60), 10, 3
CameraProjMode camera, 1
CameraZoom camera, 1
RenderWorld
Check "Perspective makes it small", R(70, 60), 10, 3
CameraRange camera, 1, 1000
FreeEntity cube

; Spot lights only shine inside of their cone, and the plane is lit where the light is: from above it is made of
; squares, so that the lights of a vertex can be told apart.
PositionEntity camera, 0, 10, 0
RotateEntity camera, 90, 0, 0
FreeEntity light
plane = CreatePlane(20)
EntityColor plane, 255, 255, 255
light = CreateLight(2)
PositionEntity light, 0, 3, 0
LightRange light, 100
RenderWorld
CheckTrue "A plane is lit by a point light (" + R(80, 60) + ")", R(80, 60) > 100
CheckTrue "A plane is lit by a point light, further away (" + R(112, 60) + ")", R(112, 60) > 40
FreeEntity light
light = CreateLight(3)
PositionEntity light, 0, 3, 0
RotateEntity light, 90, 0, 0
LightRange light, 100
LightConeAngles light, 10, 30
RenderWorld
CheckTrue "A spot light lights the middle (" + R(80, 60) + ")", R(80, 60) > 100
Check "A spot light does not light outside of the cone", R(112, 60), 0, 3
Check "A spot light does not light outside of the cone, far", R(80, 20), 0, 3
FreeEntity light
FreeEntity plane
CameraClsColor camera, 10, 20, 30

; A plane without a light covers what is below the horizon, and nothing is drawn from under it.
plane = CreatePlane(4)
EntityFX plane, 1
EntityColor plane, 0, 255, 0
PositionEntity camera, 0, 2, 0
RotateEntity camera, 0, 0, 0
RenderWorld
Check "The plane is below the horizon", G(80, 100), 255, 3
Check "The sky is above the plane", G(80, 10), 20, 3
PositionEntity camera, 0, -2, 0
RenderWorld
Check "A plane can not be seen from below", G(80, 100), 20, 3
FreeEntity plane

; A masked texture (flag 4) has no black, also when the picture is drawn by the program.
PositionEntity camera, 0, 0, -5
RotateEntity camera, 0, 0, 0
masked = CreateTexture(4, 4, 1 + 4)
SetBuffer TextureBuffer(masked)
Color 0, 0, 0
Rect 0, 0, 4, 4, True
Color 0, 255, 0
Rect 2, 0, 2, 4, True
SetBuffer BackBuffer()
cube = CreateCube()
EntityFX cube, 1
EntityTexture cube, masked
RenderWorld
Check "The black part of a masked texture is not there", R(70, 60), 10, 3
Check "The black part of a masked texture shows what is behind", B(70, 60), 30, 3
Check "The rest of a masked texture", G(90, 60), 255, 3
FreeEntity cube
FreeTexture masked

; Textures that ask for the second set of coordinates (flag 65536) use it instead of the first.
Function HalvesTexture(flags)
	texture = CreateTexture(4, 4, flags)
	SetBuffer TextureBuffer(texture)
	Color 0, 0, 0
	Rect 0, 0, 4, 4, True
	Color 0, 255, 0
	Rect 2, 0, 2, 4, True
	SetBuffer BackBuffer()
	Return texture
End Function
quad = CreateMesh()
face = CreateSurface(quad)
For i = 0 To 3
	AddVertex face, -1 + (i Mod 2) * 2, -1 + (i / 2) * 2, 0
	VertexTexCoords face, i, 0.25, 0.5, 1, 0
	VertexTexCoords face, i, 0.75, 0.5, 1, 1
Next
AddTriangle face, 0, 3, 1
AddTriangle face, 0, 2, 3
EntityFX quad, 1
plain = HalvesTexture(1)
second = HalvesTexture(1 + 65536)
EntityTexture quad, plain
RenderWorld
Check "The first set of coordinates", G(80, 60), 0, 3
EntityTexture quad, second
RenderWorld
Check "The second set of coordinates", G(80, 60), 255, 3
TextureCoords second, 0
RenderWorld
Check "TextureCoords 0 goes back to the first set", G(80, 60), 0, 3
TextureCoords plain, 1
EntityTexture quad, plain
RenderWorld
Check "TextureCoords 1 switches to the second set", G(80, 60), 255, 3
FreeEntity quad
FreeTexture plain
FreeTexture second

; A mirror shows the world again as seen from the other side of its ground, below it when the thing is above.
PositionEntity camera, 0, 0, -10
cube = CreateCube()
EntityFX cube, 1
EntityColor cube, 255, 0, 0
RenderWorld
Check "The cube", R(80, 60), 255, 3
Check "There is nothing below the cube without a mirror", R(80, 84), 10, 3
mirror = CreateMirror()
PositionEntity mirror, 0, -1.5, 0
RenderWorld
Check "The cube is still where it was", R(80, 60), 255, 3
Check "The mirror shows the cube again below", R(80, 84), 255, 3
Check "The mirror does not show it above", R(80, 36), 10, 3
HideEntity mirror
RenderWorld
Check "A hidden mirror shows nothing", R(80, 84), 10, 3
FreeEntity mirror
FreeEntity cube

; What a mirror shows has its triangles the right way around, so one that can only be seen from the front still is.
tri = CreateMesh()
face = CreateSurface(tri)
v0 = AddVertex(face, -1, -1, 0)
v1 = AddVertex(face, 1, -1, 0)
v2 = AddVertex(face, 0, 1, 0)
AddTriangle face, v0, v2, v1
EntityFX tri, 1
EntityColor tri, 255, 0, 0
RenderWorld
Check "A triangle that faces the camera", R(80, 60), 255, 3
Check "Nothing is below it", R(80, 80), 10, 3
mirror = CreateMirror()
PositionEntity mirror, 0, -1.5, 0
RenderWorld
Check "The mirror shows the triangle from the front", R(80, 80), 255, 3
FreeEntity mirror
FreeEntity tri

EndGraphics
Done "blitz3d_lighting_pixels"
