; Brushes, terrains and wireframes. Needs to be run from this directory. Runs for a few seconds, or until Escape.
Graphics3D 640, 480, 32, 2
AppTitle "BlitzLLVM Terrain Test"
SetBuffer BackBuffer()

; A terrain: two hills on a flat ground, 64 cells wide, and 6 units high.
Local ground = CreateTerrain(64)
ScaleEntity ground, 1, 6, 1
EntityColor ground, 90, 170, 70
PositionEntity ground, -32, 0, 0
For z = 0 To 64
	For x = 0 To 64
		Local d1# = Sqr((x - 20) ^ 2 + (z - 30) ^ 2)
		Local d2# = Sqr((x - 46) ^ 2 + (z - 40) ^ 2)
		Local h# = 0
		If d1 < 14 Then h = 1 - d1 / 14
		If d2 < 10 And (1 - d2 / 10) > h Then h = 1 - d2 / 10
		ModifyTerrain ground, x, z, h
	Next
Next
Check "terrain size", TerrainSize(ground), 64
Check "terrain height", TerrainHeight(ground, 20, 30), 1
Check "flat ground", TerrainHeight(ground, 0, 0), 0
Check "terrain Y on the hill", TerrainY(ground, -12, 0, 30), 6
Check "terrain Y on the ground", TerrainY(ground, -32, 0, 0), 0
Check "terrain Y between", TerrainY(ground, -12 - 0.5, 0, 30), 6 * (1 - 0.5 / 14) * 0.5 + 3, 0.5

; Brushes, for different looks of the surfaces of one mesh.
Local red = CreateBrush(255, 40, 40)
Local glass = CreateBrush(80, 160, 255)
BrushAlpha glass, 0.5
Local texture = LoadTexture("checker.png")
Local checks = CreateBrush()
BrushTexture checks, texture

Local thing = CreateMesh()
Local a = CreateSurface(thing, red)
AddVertex a, -1, 0, 0, 0, 0 : AddVertex a, 1, 0, 0, 1, 0 : AddVertex a, 0, 2, 0, 0.5, 1
AddTriangle a, 0, 1, 2
Local b = CreateSurface(thing, checks)
AddVertex b, 1.2, 0, 0, 0, 0 : AddVertex b, 3.2, 0, 0, 1, 0 : AddVertex b, 2.2, 2, 0, 0.5, 1
AddTriangle b, 0, 1, 2
Local c = CreateSurface(thing)
AddVertex c, 3.4, 0, 0, 0, 0 : AddVertex c, 5.4, 0, 0, 1, 0 : AddVertex c, 4.4, 2, 0, 0.5, 1
AddTriangle c, 0, 1, 2
PaintSurface c, glass
UpdateNormals thing
EntityFX thing, 16
PositionEntity thing, -3, 8, 12
Check "brush texture", GetBrushTexture(checks), texture

Local camera = CreateCamera()
PositionEntity camera, 0, 14, -22
RotateEntity camera, 22, 0, 0
CameraClsColor camera, 90, 130, 180
Local light = CreateLight()
RotateEntity light, 50, -30, 0
AmbientLight 60, 60, 60

Local count = 0
While count < 400
	If count = 200 Then WireFrame True
	RenderWorld
	Color 255, 255, 255
	Text 10, 10, "Terrain and brushes " + count
	Flip
	count = count + 1
	If KeyHit(1) Then Exit
Wend
Print "All terrain and brush checks passed."

Function Check(name$, got#, want#, tolerance# = 0.01)
	If Abs(got - want) > tolerance Then RuntimeError name + ": got " + got + ", expected " + want
End Function
