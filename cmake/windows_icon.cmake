# Gives an executable the icon of BlitzLLVM on Windows (and does nothing elsewhere).
#
#   blitz_windows_icon(<target>)
#
# The resource file is generated for each target with the absolute path of the icon, because resource compilers (windres, llvm-rc) read the
# icon relative to their own working directory and not to the resource file.
function(blitz_windows_icon TARGET)
	if(NOT WIN32)
		return()
	endif()
	set(BLITZ_WINDOWS_ICON "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../media/windows/blitzllvm.ico")
	cmake_path(NORMAL_PATH BLITZ_WINDOWS_ICON)
	configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../media/windows/blitzllvm.rc.in" "${CMAKE_CURRENT_BINARY_DIR}/${TARGET}_icon.rc" @ONLY)
	target_sources(${TARGET} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/${TARGET}_icon.rc")
	set_property(TARGET ${TARGET} APPEND PROPERTY LINK_DEPENDS "${BLITZ_WINDOWS_ICON}")
endfunction()
