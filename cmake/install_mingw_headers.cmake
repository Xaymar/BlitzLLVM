# Installs the headers of llvm-mingw that blitzcc needs, and no others. Run by the install step (install(CODE)) of the compiler.
#
# blitzcc compiles the C sources of the runtime (runtime/inline) together with the program, which includes the C headers of MinGW-w64 and
# the headers of the compiler itself. The compiler is asked which files these sources include (-M), and those are the files that are copied,
# with their path relative to the root of llvm-mingw, into the sysroot of the package. llvm-mingw has more than 100 MB of headers (all of Windows, COM,
# MSHTML, ...), of which the runtime uses a few MB.
#
# Variables: COMPILER (clang of llvm-mingw), ROOT (llvm-mingw), DESTINATION (the sysroot of the package), SOURCE_DIRECTORY and SOURCES
# (the C files and where they are).
if(NOT COMPILER OR NOT ROOT OR NOT DESTINATION OR NOT SOURCES)
	message(FATAL_ERROR "install_mingw_headers.cmake needs COMPILER, ROOT, DESTINATION, SOURCE_DIRECTORY and SOURCES")
endif()
file(REAL_PATH "${ROOT}" _ROOT)
execute_process(
	COMMAND "${COMPILER}" -M -D__STDC_WANT_LIB_EXT1__=1 "-I${SOURCE_DIRECTORY}" ${SOURCES}
	OUTPUT_VARIABLE _DEPENDENCIES
	ERROR_VARIABLE _ERRORS
	RESULT_VARIABLE _RESULT
)
if(NOT _RESULT EQUAL 0)
	message(FATAL_ERROR "Listing the headers of the runtime failed (${_RESULT}): ${_ERRORS}")
endif()
# Makefile syntax: "target: file file \<newline> file". Paths have no spaces (the toolchain is in a path that has none).
string(REPLACE "\\\n" " " _DEPENDENCIES "${_DEPENDENCIES}")
string(REGEX REPLACE "[^ \n]*\\.o:" "" _DEPENDENCIES "${_DEPENDENCIES}")
string(STRIP "${_DEPENDENCIES}" _DEPENDENCIES)
string(REGEX REPLACE "[ \n\r\t]+" ";" _DEPENDENCIES "${_DEPENDENCIES}")
list(FILTER _DEPENDENCIES EXCLUDE REGEX "^$")
list(REMOVE_DUPLICATES _DEPENDENCIES)
set(_COUNT 0)
foreach(_FILE IN LISTS _DEPENDENCIES)
	if(_FILE STREQUAL "")
		continue()
	endif()
	file(REAL_PATH "${_FILE}" _FILE)
	file(RELATIVE_PATH _RELATIVE "${_ROOT}" "${_FILE}")
	if(_RELATIVE MATCHES "^\\.\\.")
		continue() # The sources of the runtime themselves.
	endif()
	get_filename_component(_DIRECTORY "${_RELATIVE}" DIRECTORY)
	file(INSTALL "${_FILE}" DESTINATION "${DESTINATION}/${_DIRECTORY}")
	math(EXPR _COUNT "${_COUNT} + 1")
endforeach()
if(_COUNT LESS 20)
	message(FATAL_ERROR "Only ${_COUNT} headers of llvm-mingw were found for the runtime, something is wrong with: ${_DEPENDENCIES}")
endif()
message(STATUS "Installed ${_COUNT} headers of llvm-mingw")
