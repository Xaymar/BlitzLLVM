; Normal map demo for PR #479: a stone-coloured wall with round bumps, lit from the left, the right and from above, and once without the map.
; Needs BlitzLLVM (TextureBlend 6). Writes shot_none.bmp, shot_left.bmp, shot_right.bmp, shot_top.bmp next to the program, then ends.
Graphics3D 640, 480, 32, 2
SetBuffer BackBuffer()

camera = CreateCamera()
PositionEntity camera, 0, 0, -6
CameraClsColor camera, 20, 24, 32
AmbientLight 30, 30, 30

; The normal map (OpenGL format, green up): domes of radius 24 in cells of 64, flat in between.
nmap = CreateTexture(256, 256, 1 + 4096)
SetBuffer TextureBuffer(nmap)
LockBuffer TextureBuffer(nmap)
For y = 0 To 255
	For x = 0 To 255
		dx# = (x Mod 64) - 32 + 0.5
		dy# = (y Mod 64) - 32 + 0.5
		d# = Sqr(dx * dx + dy * dy)
		nx# = 0 : ny# = 0 : nz# = 1
		If d < 24 Then
			nz = Sqr(24 * 24 - d * d) / 24
			nx = dx / 24
			ny = -dy / 24 ; image down is -green in this format
			l# = Sqr(nx * nx + ny * ny + nz * nz)
			nx = nx / l : ny = ny / l : nz = nz / l
		EndIf
		WritePixelFast x, y, (255 Shl 24) Or (Int((nx * 0.5 + 0.5) * 255) Shl 16) Or (Int((ny * 0.5 + 0.5) * 255) Shl 8) Or Int((nz * 0.5 + 0.5) * 255), TextureBuffer(nmap)
	Next
Next
UnlockBuffer TextureBuffer(nmap)
SetBuffer BackBuffer()
TextureBlend nmap, 6

; The colour: a warm stone grey.
stone = CreateTexture(4, 4, 1 + 4096)
SetBuffer TextureBuffer(stone)
ClsColor 190, 170, 140
Cls
SetBuffer BackBuffer()

wall = CreateMesh()
s = CreateSurface(wall)
a = AddVertex(s, -3, -3, 0, 0, 1) : b = AddVertex(s, -3, 3, 0, 0, 0) : c = AddVertex(s, 3, 3, 0, 1, 0) : d2 = AddVertex(s, 3, -3, 0, 1, 1)
For v = a To d2
	VertexNormal s, v, 0, 0, -1
Next
AddTriangle s, a, b, c
AddTriangle s, a, c, d2

light = CreateLight(1)

; Without the map: the stone, lit per pixel the same way.
EntityLighting wall, 1
EntityTexture wall, stone
RotateEntity light, 0, 50, 0
RenderWorld
Flip
SaveBuffer BackBuffer(), "shot_none.bmp"

; With the map on the first layer and the stone on the second.
EntityTexture wall, nmap, 0, 0
EntityTexture wall, stone, 0, 1
RotateEntity light, 0, 50, 0
RenderWorld
Flip
SaveBuffer BackBuffer(), "shot_right.bmp"
RotateEntity light, 0, -50, 0
RenderWorld
Flip
SaveBuffer BackBuffer(), "shot_left.bmp"
RotateEntity light, 50, 0, 0
RenderWorld
Flip
SaveBuffer BackBuffer(), "shot_top.bmp"
End
