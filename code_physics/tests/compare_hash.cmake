# Runs the pile of sim_test with one, two and all threads: where everything ends up must be the same bit for bit.
set(_HASHES "")
foreach(_THREADS IN ITEMS 1 2 8)
	execute_process(COMMAND "${TEST}" --threads ${_THREADS} --hash OUTPUT_VARIABLE _OUT RESULT_VARIABLE _RESULT)
	if(NOT _RESULT EQUAL 0)
		message(FATAL_ERROR "sim_test --threads ${_THREADS} failed (${_RESULT})")
	endif()
	string(STRIP "${_OUT}" _OUT)
	message(STATUS "threads ${_THREADS}: ${_OUT}")
	list(APPEND _HASHES "${_OUT}")
endforeach()
list(REMOVE_DUPLICATES _HASHES)
list(LENGTH _HASHES _COUNT)
if(NOT _COUNT EQUAL 1)
	message(FATAL_ERROR "The simulation gives different results for different numbers of threads: ${_HASHES}")
endif()
