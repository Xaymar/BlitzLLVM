	foreach(_VARIABLE IN ITEMS _SDL3_LIBRARY _SDL3_IMAGE_LIBRARY _SDL3_MIXER_LIBRARY)
		if(NOT EXISTS "${${_VARIABLE}}")
			string(REPLACE "-static.lib" ".lib" _PLAIN "${${_VARIABLE}}")
