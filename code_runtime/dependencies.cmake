################################################################################
# System libraries
#
# Linux packages should not ship copies of libraries that the distribution has (and keeps updated), so each dependency can come from the
# system instead of from its submodule: AUTO uses the system's when it is new enough (Linux only) and builds the submodule otherwise,
# ON fails when the system has no usable copy, and OFF always builds the submodule. Windows and macOS always build the submodules.
#
#   BLITZ_SYSTEM_SDL3          SDL3, linked to programs as a shared library
#   BLITZ_SYSTEM_SDL3_IMAGE    SDL3_image (needs the system's SDL3, as two copies of SDL in a program do not work)
#   BLITZ_SYSTEM_SDL3_MIXER    SDL3_mixer (needs the system's SDL3 as well)
#   BLITZ_SYSTEM_IMAGE_CODECS  libavif (with dav1d), libjxl, libtiff and libwebp, which a bundled SDL3_image loads when the program opens such a file
#   BLITZ_SYSTEM_AUDIO_CODECS  opusfile (with libopus and libogg), which a bundled SDL3_mixer loads when the program plays such a file
#   BLITZ_SYSTEM_FFMPEG        FFmpeg, which the runtime loads when the program opens a movie. Only when it is LGPL and has the decoders.
#
# The libraries that programs link to are named in runtime/system-libraries.txt, which blitzcc passes to the linker. The packages that
# provide them are registered for the dependencies of the packages (BLITZ_DEB_DEPENDS and BLITZ_DEB_RECOMMENDS, see the end of CMakeLists.txt).
################################################################################
find_package(PkgConfig QUIET)
set(BLITZ_SDL3_MINIMUM_VERSION 3.4.0 CACHE STRING "The oldest SDL3 that the runtime builds with and works on")
set(BLITZ_SDL3_IMAGE_MINIMUM_VERSION 3.4.0 CACHE STRING "The oldest SDL3_image that the runtime builds with and works on")
set(BLITZ_SDL3_MIXER_MINIMUM_VERSION 3.2.0 CACHE STRING "The oldest SDL3_mixer that the runtime builds with and works on")
foreach(_OPTION IN ITEMS SDL3 SDL3_IMAGE SDL3_MIXER IMAGE_CODECS AUDIO_CODECS FFMPEG)
	set(BLITZ_SYSTEM_${_OPTION} AUTO CACHE STRING "Use the system's ${_OPTION} instead of building it (AUTO, ON or OFF)")
	set_property(CACHE BLITZ_SYSTEM_${_OPTION} PROPERTY STRINGS AUTO ON OFF)
endforeach()
set_property(GLOBAL PROPERTY BLITZ_DEB_DEPENDS "")
set_property(GLOBAL PROPERTY BLITZ_DEB_RECOMMENDS "")
set_property(GLOBAL PROPERTY BLITZ_SYSTEM_INCLUDES "")
set_property(GLOBAL PROPERTY BLITZ_SYSTEM_LINK_FLAGS "")
set(_SYSTEM_LIBRARIES "") # What programs link to, one flag per entry.

# Decides whether a dependency comes from the system, with the pkg-config modules it needs (like 'sdl3 >= 3.4.0'). Sets <RESULT> in the caller.
function(blitz_system_library RESULT OPTION)
	set(${RESULT} OFF PARENT_SCOPE)
	set(_MODE "${BLITZ_SYSTEM_${OPTION}}")
	if(_MODE STREQUAL "OFF")
		return()
	endif()
	if(_MODE STREQUAL "AUTO" AND NOT (UNIX AND NOT APPLE))
		return()
	endif()
	set(_PROBLEM "")
	if(NOT PKG_CONFIG_FOUND)
		set(_PROBLEM "pkg-config was not found")
	endif()
	if(NOT _PROBLEM)
		foreach(_MODULE IN LISTS ARGN)
			execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --exists "${_MODULE}" RESULT_VARIABLE _RESULT)
			if(NOT _RESULT EQUAL 0)
				set(_PROBLEM "pkg-config has no '${_MODULE}'")
				break()
			endif()
		endforeach()
	endif()
	if(_PROBLEM)
		if(_MODE STREQUAL "ON")
			message(FATAL_ERROR "BLITZ_SYSTEM_${OPTION} is ON, but ${_PROBLEM}. Install the development package, or set it to AUTO to build the bundled copy.")
		endif()
		message(STATUS "No system ${OPTION} (${_PROBLEM}), building the bundled copy")
		return()
	endif()
	set(${RESULT} ON PARENT_SCOPE)
endfunction()

# Tells the packages that the system library of a pkg-config module is needed. LINKED is for libraries that programs are linked to,
# LOADED for those that the runtime loads when it needs them (a program without them only loses that format). The name of the
# package that has the library, and the version of it that the build machine has, is what Debian wants (the .deb is the only package that
# takes its libraries from the build machine, the others are built on their own distributions).
# The name that programs open the library with is returned in SONAME_RESULT.
function(blitz_register_system_library KIND MODULE LIBRARY SONAME_RESULT)
	execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --variable=libdir "${MODULE}" OUTPUT_VARIABLE _LIBDIR OUTPUT_STRIP_TRAILING_WHITESPACE)
	set(_LINK "${_LIBDIR}/lib${LIBRARY}.so")
	if(NOT EXISTS "${_LINK}")
		message(FATAL_ERROR "The system library '${_LINK}' of '${MODULE}' is missing.")
	endif()
	# The development package links 'libfoo.so' to the library by the name that programs load it with (the soname, 'libfoo.so.1').
	# The runtime package has that name as a link to the library, next to the version it was built as (libfoo.so.1 -> libfoo.so.1.2.3), and
	# the development package may link 'libfoo.so' to either, so the shortest link to the library that has a version is the soname.
	file(REAL_PATH "${_LINK}" _REAL)
	set(_SONAME "lib${LIBRARY}.so")
	file(GLOB _CANDIDATES "${_LIBDIR}/lib${LIBRARY}.so.*")
	set(_SONAME_LENGTH 1000)
	foreach(_CANDIDATE IN LISTS _CANDIDATES)
		file(REAL_PATH "${_CANDIDATE}" _CANDIDATE_REAL)
		cmake_path(GET _CANDIDATE FILENAME _CANDIDATE_NAME)
		string(LENGTH "${_CANDIDATE_NAME}" _CANDIDATE_LENGTH)
		if(_CANDIDATE_REAL STREQUAL _REAL AND _CANDIDATE_LENGTH LESS _SONAME_LENGTH)
			set(_SONAME "${_CANDIDATE_NAME}")
			set(_SONAME_LENGTH ${_CANDIDATE_LENGTH})
		endif()
	endforeach()
	# A library outside of the places that the linker and the loader look in (a prefix of its own) has to be pointed to.
	if(KIND STREQUAL "LINKED" AND NOT _LIBDIR MATCHES "^/(usr|lib)")
		set_property(GLOBAL APPEND PROPERTY BLITZ_SYSTEM_LINK_FLAGS "-L${_LIBDIR}" "-Wl,-rpath,${_LIBDIR}")
	endif()
	# Where the headers are, unless that is where the compiler looks anyway.
	execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --cflags-only-I "${MODULE}" OUTPUT_VARIABLE _INCLUDES OUTPUT_STRIP_TRAILING_WHITESPACE)
	separate_arguments(_INCLUDES)
	foreach(_INCLUDE IN LISTS _INCLUDES)
		string(REGEX REPLACE "^-I" "" _INCLUDE "${_INCLUDE}")
		set_property(GLOBAL APPEND PROPERTY BLITZ_SYSTEM_INCLUDES "${_INCLUDE}")
	endforeach()
	set(${SONAME_RESULT} "${_SONAME}" PARENT_SCOPE)

	find_program(BLITZ_DPKG_QUERY dpkg-query)
	if(BLITZ_DPKG_QUERY)
		execute_process(COMMAND "${BLITZ_DPKG_QUERY}" -S "${_REAL}" OUTPUT_VARIABLE _OWNER RESULT_VARIABLE _RESULT ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
		if(_RESULT EQUAL 0)
			string(REGEX REPLACE ":.*$" "" _PACKAGE "${_OWNER}")
			execute_process(COMMAND "${BLITZ_DPKG_QUERY}" -W -f=\${source:Upstream-Version} "${_PACKAGE}" OUTPUT_VARIABLE _VERSION OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
			if(_VERSION)
				set(_PACKAGE "${_PACKAGE} (>= ${_VERSION})")
			endif()
			if(KIND STREQUAL "LINKED")
				set_property(GLOBAL APPEND PROPERTY BLITZ_DEB_DEPENDS "${_PACKAGE}")
			else()
				set_property(GLOBAL APPEND PROPERTY BLITZ_DEB_RECOMMENDS "${_PACKAGE}")
			endif()
		else()
			message(WARNING "${_REAL} does not belong to a Debian package, so the .deb will not depend on it.")
		endif()
	endif()
endfunction()

# Builds a submodule from third_party/. A macro, so that the <NAME>_INSTALL_PATH variables reach the caller.
# The checked out commit is passed to the configure step as an unused definition, as ExternalContent only rebuilds when its
# arguments change, which makes a submodule update rebuild the dependency.
macro(blitz_dependency NAME DIRECTORY)
	execute_process(
		COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}/third_party/${DIRECTORY}" rev-parse HEAD
		OUTPUT_VARIABLE _DEPENDENCY_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE
	)
	set(_DEPENDENCY_ARGUMENTS ${ARGN})
	list(FIND _DEPENDENCY_ARGUMENTS CONFIGURE_ARGS _DEPENDENCY_INDEX)
	math(EXPR _DEPENDENCY_INDEX "${_DEPENDENCY_INDEX} + 1")
	list(INSERT _DEPENDENCY_ARGUMENTS ${_DEPENDENCY_INDEX} "-DBLITZLLVM_SOURCE_REVISION=${_DEPENDENCY_REVISION}")
	ExternalContent(
		NAME ${NAME}
		SKIP_DOWNLOAD
		SOURCE_PATH "${PROJECT_SOURCE_DIR}/third_party/${DIRECTORY}"
		${_DEPENDENCY_ARGUMENTS}
	)
endmacro()

# Shared libraries that are shipped look for the ones they depend on in their own directory.
if(APPLE)
	set(_SHARED_RPATH "@loader_path")
else()
	set(_SHARED_RPATH "\$ORIGIN")
endif()
# Shipped shared libraries carry no symbol tables (the linker of Windows keeps them in .pdb files, which are not shipped).
if(APPLE)
	set(_SHARED_STRIP "-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-x")
elseif(NOT MSVC AND NOT WIN32)
	set(_SHARED_STRIP "-DCMAKE_SHARED_LINKER_FLAGS=-s")
else()
	set(_SHARED_STRIP "")
endif()

# Fedora and openSUSE install to lib64 by default, but the paths below, and the runtime layout, look in lib.
set(_DEPENDENCY_ARGS -G "${CMAKE_GENERATOR}" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib)
if(CMAKE_GENERATOR_PLATFORM)
	list(APPEND _DEPENDENCY_ARGS -A "${CMAKE_GENERATOR_PLATFORM}")
endif()
if(CMAKE_GENERATOR_TOOLSET)
	list(APPEND _DEPENDENCY_ARGS -T "${CMAKE_GENERATOR_TOOLSET}")
endif()
# clang for Windows (the GNU-style driver, targeting the MSVC ABI): the dependencies use the same compiler, target, linker and tools.
set(_WINDOWS_CLANG OFF)
if(WIN32 AND NOT MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
	set(_WINDOWS_CLANG ON)
	foreach(_VARIABLE IN ITEMS CMAKE_C_COMPILER_TARGET CMAKE_CXX_COMPILER_TARGET CMAKE_LINKER_TYPE CMAKE_RC_COMPILER CMAKE_MT)
		if(${_VARIABLE})
			list(APPEND _DEPENDENCY_ARGS "-D${_VARIABLE}=${${_VARIABLE}}")
		endif()
	endforeach()
endif()
if(CMAKE_TOOLCHAIN_FILE)
	list(APPEND _DEPENDENCY_ARGS "-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}")
endif()
# macOS programs for Intel and Apple silicon come from universal libraries: with more than one architecture every dependency is built for
# all of them (FFmpeg has its own configure script, see below). dav1d is built without assembly then, as its assembly is for one architecture.
set(_UNIVERSAL OFF)
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
	list(APPEND _DEPENDENCY_ARGS "-DCMAKE_OSX_ARCHITECTURES=${CMAKE_OSX_ARCHITECTURES}")
	list(LENGTH CMAKE_OSX_ARCHITECTURES _OSX_ARCHITECTURE_COUNT)
	if(_OSX_ARCHITECTURE_COUNT GREATER 1)
		set(_UNIVERSAL ON)
	endif()
endif()
if(CMAKE_PREFIX_PATH)
	# Where the system's libraries are, when that is not a default place.
	list(APPEND _DEPENDENCY_ARGS "-DCMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH}")
endif()
# A section per function and variable lets the linker of blitzcc drop everything a program does not use (--gc-sections, see main.cpp).
# MSVC puts functions in their own sections already (/Gy), and Mach-O drops unused symbols without help.
if(NOT MSVC AND NOT APPLE)
	set(_CXX_EXTRA "")
	if(_WINDOWS_CLANG)
		# Same reason as below: clang uses the STL of Visual Studio there.
		set(_CXX_EXTRA " -D_USE_STD_VECTOR_ALGORITHMS=0 -D_USE_STD_VECTOR_FLOATING_ALGORITHMS=0")
	endif()
	list(APPEND _DEPENDENCY_ARGS "-DCMAKE_C_FLAGS=-ffunction-sections -fdata-sections" "-DCMAKE_CXX_FLAGS=-ffunction-sections -fdata-sections${_CXX_EXTRA}")
endif()
# The vectorized algorithms of the MSVC STL (std::rotate, std::min_element, ...) call helpers (__std_rotate, __std_min_element_1u, ...)
# that only exist in the msvcprt.lib of newer toolsets. Programs are linked by blitzcc against the msvcprt.lib of whichever Visual
# Studio the user has, so libraries must not need them or the link fails ("undefined symbol: __std_rotate") on an older toolset.
if(MSVC)
	# These are CMake's defaults for MSVC plus the definitions: CMAKE_CXX_FLAGS_INIT would only apply to a build directory that is
	# configured for the first time, and the ones restored from the cache are not.
	list(APPEND _DEPENDENCY_ARGS "-DCMAKE_CXX_FLAGS=/DWIN32 /D_WINDOWS /EHsc /GR /D_USE_STD_VECTOR_ALGORITHMS=0 /D_USE_STD_VECTOR_FLOATING_ALGORITHMS=0")
endif()
if(NOT CMAKE_GENERATOR MATCHES "Visual Studio")
	list(APPEND _DEPENDENCY_ARGS "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}" "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}")
endif()

# FFmpeg plays the movies (OpenMovie and the other movie commands). It is built as shared libraries and with the LGPL parts only
# (no --enable-gpl and no --enable-nonfree), so the library that programs load can be replaced by the user, which is what the LGPL asks
# of programs that use it. The runtime does not link to them: it loads them when a movie is opened (see movie.cpp), so programs
# that don't play movies don't need them, and a program whose libraries are missing just gets 0 from OpenMovie. Only the demuxers and
# decoders listed here are built, and for size (--enable-small), which keeps the libraries at about 6 MiB.
#
# FFmpeg does not build with CMake: it has a configure script and Makefiles that need a Unix shell, and a compiler that is GCC or Clang.
# On Linux and macOS that is the system's. On Windows that is MSYS2 (https://www.msys2.org, the CLANG64 environment with clang, make, nasm and
# diffutils), found through the environment variable BLITZLLVM_MSYS2 or in C:/msys64. The libraries are built there, once, at configure
# time, and what programs load from them is only the C interface of the DLLs, which any compiler's programs can use.
if(NOT EXISTS "${PROJECT_SOURCE_DIR}/third_party/FFmpeg/configure")
	message(FATAL_ERROR "The submodule 'third_party/FFmpeg' is missing, run 'git submodule update --init' first.")
endif()
set(_FFMPEG_SOURCE "${PROJECT_SOURCE_DIR}/third_party/FFmpeg")
set(_FFMPEG_ROOT "${CMAKE_BINARY_DIR}/ExternalContentFiles")
set(FFMPEG_INSTALL_PATH "${_FFMPEG_ROOT}/FFmpeg.dst")
set(_FFMPEG_BUILD "${_FFMPEG_ROOT}/FFmpeg.bld")
set(_FFMPEG_ARGS
	--enable-shared --disable-static --disable-programs --disable-doc --disable-debug --disable-autodetect --disable-everything
	--disable-avdevice --disable-avfilter --disable-network --enable-small --disable-iamf --disable-bsfs --disable-faan --disable-pixelutils --disable-lsp
	--enable-swscale --disable-swresample --enable-pic
	--enable-protocol=file
	--enable-demuxer=avi,mov,matroska,mpegps,mpegts,asf,ogg,flv,mp3,wav,mpegvideo,m4v
	--enable-parser=h264,hevc,mpeg4video,mpegvideo,vp8,vp9,aac,aac_latm,ac3,mpegaudio,vorbis,flac,mjpeg
	--enable-decoder=mpeg1video,mpeg2video,mpeg4,msmpeg4v1,msmpeg4v2,msmpeg4v3,h264,hevc,vp8,vp9,theora,wmv1,wmv2,wmv3,mjpeg
	--enable-decoder=aac,mp3,mp3float,mp2,mp2float,ac3,vorbis,wmav1,wmav2,flac,pcm_s16le,pcm_u8,pcm_s16be,adpcm_ms,adpcm_ima_wav
)
if(APPLE)
	# The libraries find each other next to themselves, wherever the program that loads them is.
	list(APPEND _FFMPEG_ARGS --install-name-dir=@loader_path)
endif()
if(WIN32)
	# Windows uses the clang of MSYS2 (CLANG64, CLANGARM64 on ARM64), which needs no libgcc.
	if(CMAKE_GENERATOR_PLATFORM)
		set(_WINDOWS_ARCHITECTURE "${CMAKE_GENERATOR_PLATFORM}")
	else()
		set(_WINDOWS_ARCHITECTURE "${CMAKE_SYSTEM_PROCESSOR}")
	endif()
	if(_WINDOWS_ARCHITECTURE MATCHES "^([aA][rR][mM]64|[aA][aA][rR][cC][hH]64)$")
		set(_MSYS2_ENVIRONMENT CLANGARM64)
		set(_MSYS2_COMPILER_ARGS --arch=aarch64 --cc=clang)
		set(_FFMPEG_LIBGCC "")
	else()
		set(_MSYS2_ENVIRONMENT CLANG64)
		set(_MSYS2_COMPILER_ARGS --cc=clang)
		set(_FFMPEG_LIBGCC "")
	endif()
	# The threads of Windows and a C runtime inside the DLLs keep MSYS2's runtime DLLs out of the files that are shipped.
	# clock_gettime comes from MSYS2's libwinpthread-1.dll (clock_gettime64 is missing from older copies on PATH), so link it statically.
	list(APPEND _FFMPEG_ARGS --enable-w32threads ${_FFMPEG_LIBGCC} --extra-libs=-l:libwinpthread.a)
endif()

# The system's FFmpeg is only used when it is LGPL (the builds of Debian and Ubuntu have GPL parts, which makes every program that loads them
# GPL) and has the demuxers and decoders above, which is checked by building and running ffmpeg_check.c against it.
blitz_system_library(_SYSTEM_FFMPEG FFMPEG libavutil libswscale libavcodec libavformat)
if(_SYSTEM_FFMPEG)
	set(_DEMUXERS "")
	set(_DECODERS "")
	foreach(_ARGUMENT IN LISTS _FFMPEG_ARGS)
		if(_ARGUMENT MATCHES "^--enable-demuxer=(.*)$")
			set(_DEMUXERS "${CMAKE_MATCH_1}")
		elseif(_ARGUMENT MATCHES "^--enable-decoder=(.*)$")
			list(APPEND _DECODERS "${CMAKE_MATCH_1}")
		endif()
	endforeach()
	string(REPLACE ";" "," _DECODERS "${_DECODERS}")
	execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --cflags --libs libavutil libavcodec libavformat OUTPUT_VARIABLE _FLAGS OUTPUT_STRIP_TRAILING_WHITESPACE)
	separate_arguments(_FLAGS)
	set(_FLAGS_COMPILE ${_FLAGS})
	list(FILTER _FLAGS_COMPILE INCLUDE REGEX "^-I")
	set(_FLAGS_LINK ${_FLAGS})
	list(FILTER _FLAGS_LINK EXCLUDE REGEX "^-I")
	try_run(_FFMPEG_RUN _FFMPEG_COMPILE
		SOURCES "${CMAKE_CURRENT_LIST_DIR}/ffmpeg_check.c"
		COMPILE_DEFINITIONS ${_FLAGS_COMPILE} "-DDEMUXERS=\"${_DEMUXERS}\"" "-DDECODERS=\"${_DECODERS}\""
		LINK_LIBRARIES ${_FLAGS_LINK}
		COMPILE_OUTPUT_VARIABLE _FFMPEG_COMPILE_OUTPUT RUN_OUTPUT_VARIABLE _FFMPEG_OUTPUT
	)
	string(STRIP "${_FFMPEG_OUTPUT}" _FFMPEG_OUTPUT)
	string(REPLACE "\n" ", " _FFMPEG_OUTPUT "${_FFMPEG_OUTPUT}")
	if(NOT _FFMPEG_COMPILE)
		set(_FFMPEG_PROBLEM "its headers and libraries do not build a program")
	elseif(NOT _FFMPEG_RUN EQUAL 0)
		set(_FFMPEG_PROBLEM "it is ${_FFMPEG_OUTPUT}")
	endif()
	if(_FFMPEG_PROBLEM)
		if(BLITZ_SYSTEM_FFMPEG STREQUAL "ON")
			message(FATAL_ERROR "BLITZ_SYSTEM_FFMPEG is ON, but the system's FFmpeg can not be used: ${_FFMPEG_PROBLEM}.")
		endif()
		message(STATUS "The system's FFmpeg can not be used (${_FFMPEG_PROBLEM}), building the bundled copy")
		set(_SYSTEM_FFMPEG OFF)
	endif()
endif()

# How many compiler processes the dependencies may use at once in total: the build of FFmpeg and the build of the other dependencies run at the
# same time (see blitz_start_ffmpeg), and share them. Every build tool is limited to its share, so the machine is not given more than it has.
cmake_host_system_information(RESULT _CORES QUERY NUMBER_OF_LOGICAL_CORES)
set(BLITZLLVM_DEPENDENCY_JOBS "${_CORES}" CACHE STRING "How many compiler processes the build of the dependencies (SDL3, SDL_image, SDL_mixer, FFmpeg) uses at once, in total")
if(NOT BLITZLLVM_DEPENDENCY_JOBS MATCHES "^[1-9][0-9]*$")
	message(FATAL_ERROR "BLITZLLVM_DEPENDENCY_JOBS has to be a number of at least 1, not '${BLITZLLVM_DEPENDENCY_JOBS}'.")
endif()
set(_DEPENDENCY_JOBS ${BLITZLLVM_DEPENDENCY_JOBS}) # What the CMake dependencies get: all of them, or what is left when FFmpeg is built.
set(_FFMPEG_LOG "${_FFMPEG_ROOT}/FFmpeg.log")
set(_FFMPEG_RESULT "${_FFMPEG_ROOT}/FFmpeg.result")
set(_FFMPEG_PENDING OFF)

# Starts building FFmpeg, if it needs to be built, and does not wait for it: the build of FFmpeg does not depend on any other dependency, so it
# runs as a process of its own (build_ffmpeg.cmake) while the other dependencies are built, and blitz_wait_ffmpeg waits for it where its
# libraries are needed. The two share the jobs: FFmpeg gets half (make), the rest is what the other builds use (_DEPENDENCY_JOBS).
function(blitz_start_ffmpeg)
	execute_process(
		COMMAND "${GIT_EXECUTABLE}" -C "${_FFMPEG_SOURCE}" rev-parse HEAD
		OUTPUT_VARIABLE _REVISION OUTPUT_STRIP_TRAILING_WHITESPACE
	)
	string(SHA256 _STAMP_TEXT "${_REVISION} ${_FFMPEG_ARGS} ${CMAKE_C_COMPILER} ${CMAKE_OSX_ARCHITECTURES}")
	set(_STAMP "${_FFMPEG_ROOT}/FFmpeg.stamp")
	if(EXISTS "${_STAMP}" AND EXISTS "${FFMPEG_INSTALL_PATH}/include/libavformat/avformat.h")
		file(READ "${_STAMP}" _STAMPED)
		if(_STAMPED STREQUAL _STAMP_TEXT)
			return()
		endif()
	endif()

	if(WIN32)
		set(_MSYS2 "$ENV{BLITZLLVM_MSYS2}")
		if(NOT _MSYS2)
			set(_MSYS2 "C:/msys64")
		endif()
		file(TO_CMAKE_PATH "${_MSYS2}" _MSYS2)
		if(NOT EXISTS "${_MSYS2}/usr/bin/bash.exe")
			message(FATAL_ERROR "FFmpeg is built with MSYS2, which was not found in '${_MSYS2}'. Install it from https://www.msys2.org (and clang, make, nasm and diffutils in its CLANG64 environment, or clang for ARM64 in CLANGARM64), or set the environment variable BLITZLLVM_MSYS2 to where it is.")
		endif()
		set(_WINDOWS ON)
	else()
		set(_WINDOWS OFF)
		set(_MSYS2 "")
	endif()

	math(EXPR _FFMPEG_JOBS "${BLITZLLVM_DEPENDENCY_JOBS} / 2")
	if(_FFMPEG_JOBS LESS 1)
		set(_FFMPEG_JOBS 1)
	endif()
	math(EXPR _OTHER_JOBS "${BLITZLLVM_DEPENDENCY_JOBS} - ${_FFMPEG_JOBS}")
	if(_OTHER_JOBS LESS 1)
		set(_OTHER_JOBS 1)
	endif()
	set(_DEPENDENCY_JOBS ${_OTHER_JOBS} PARENT_SCOPE)

	message(STATUS "Building FFmpeg (shared, LGPL) in ${_FFMPEG_BUILD} with ${_FFMPEG_JOBS} jobs, next to the other dependencies (output in ${_FFMPEG_LOG})")
	file(REMOVE_RECURSE "${_FFMPEG_BUILD}" "${FFMPEG_INSTALL_PATH}")
	file(MAKE_DIRECTORY "${_FFMPEG_BUILD}")
	file(REMOVE "${_FFMPEG_RESULT}" "${_STAMP}" "${_FFMPEG_LOG}")

	# Everything the build needs, as a file, as the process that does it has none of the variables of this one.
	set(_SETTINGS "${_FFMPEG_ROOT}/FFmpeg.settings.cmake")
	file(WRITE "${_SETTINGS}"
		"set(FFMPEG_SOURCE [==[${_FFMPEG_SOURCE}]==])\n"
		"set(FFMPEG_BUILD [==[${_FFMPEG_BUILD}]==])\n"
		"set(FFMPEG_INSTALL [==[${FFMPEG_INSTALL_PATH}]==])\n"
		"set(FFMPEG_ROOT [==[${_FFMPEG_ROOT}]==])\n"
		"set(FFMPEG_ARGS [==[${_FFMPEG_ARGS}]==])\n"
		"set(FFMPEG_JOBS ${_FFMPEG_JOBS})\n"
		"set(FFMPEG_RESULT [==[${_FFMPEG_RESULT}]==])\n"
		"set(FFMPEG_STAMP [==[${_STAMP}]==])\n"
		"set(FFMPEG_STAMP_TEXT [==[${_STAMP_TEXT}]==])\n"
		"set(FFMPEG_C_COMPILER [==[${CMAKE_C_COMPILER}]==])\n"
		"set(FFMPEG_OSX_ARCHITECTURES [==[${CMAKE_OSX_ARCHITECTURES}]==])\n"
		"set(FFMPEG_HOST_PROCESSOR [==[${CMAKE_HOST_SYSTEM_PROCESSOR}]==])\n"
		"set(FFMPEG_UNIVERSAL ${_UNIVERSAL})\n"
		"set(FFMPEG_WINDOWS ${_WINDOWS})\n"
		"set(FFMPEG_MSYS2 [==[${_MSYS2}]==])\n"
		"set(FFMPEG_MSYS2_ENVIRONMENT [==[${_MSYS2_ENVIRONMENT}]==])\n"
		"set(FFMPEG_MSYS2_COMPILER_ARGS [==[${_MSYS2_COMPILER_ARGS}]==])\n"
	)

	# Start the process and leave it running. Its output goes to a file, so that nothing connects it to this process, which would wait for it.
	if(WIN32)
		set(_LAUNCHER "${_FFMPEG_ROOT}/FFmpeg.start.cmd")
		file(TO_NATIVE_PATH "${CMAKE_COMMAND}" _CMAKE_NATIVE)
		file(TO_NATIVE_PATH "${CMAKE_CURRENT_LIST_DIR}/build_ffmpeg.cmake" _SCRIPT_NATIVE)
		file(TO_NATIVE_PATH "${_SETTINGS}" _SETTINGS_NATIVE)
		file(TO_NATIVE_PATH "${_FFMPEG_LOG}" _LOG_NATIVE)
		file(WRITE "${_LAUNCHER}" "@echo off\r\nstart \"\" /b \"${_CMAKE_NATIVE}\" \"-DFFMPEG_SETTINGS=${_SETTINGS_NATIVE}\" -P \"${_SCRIPT_NATIVE}\" > \"${_LOG_NATIVE}\" 2>&1\r\n")
		file(TO_NATIVE_PATH "${_LAUNCHER}" _LAUNCHER_NATIVE)
		execute_process(COMMAND cmd /c "${_LAUNCHER_NATIVE}" OUTPUT_FILE "${_FFMPEG_LOG}.start" ERROR_FILE "${_FFMPEG_LOG}.start" RESULT_VARIABLE _RESULT)
	else()
		execute_process(
			COMMAND sh -c "\"$@\" > \"$0\" 2>&1 < /dev/null &" "${_FFMPEG_LOG}"
				"${CMAKE_COMMAND}" "-DFFMPEG_SETTINGS=${_SETTINGS}" -P "${CMAKE_CURRENT_LIST_DIR}/build_ffmpeg.cmake"
			OUTPUT_FILE "${_FFMPEG_LOG}.start" ERROR_FILE "${_FFMPEG_LOG}.start" RESULT_VARIABLE _RESULT
		)
	endif()
	if(NOT _RESULT EQUAL 0)
		message(FATAL_ERROR "Starting the build of FFmpeg failed (${_RESULT}).")
	endif()
	set(_FFMPEG_PENDING ON PARENT_SCOPE)
endfunction()

# Waits until the build that blitz_start_ffmpeg started is done. Nothing to wait for when FFmpeg did not need to be built.
function(blitz_wait_ffmpeg)
	if(NOT _FFMPEG_PENDING)
		return()
	endif()
	set(_WAITED 0)
	while(NOT EXISTS "${_FFMPEG_RESULT}")
		if(_WAITED GREATER 10800)
			message(FATAL_ERROR "Building FFmpeg took more than 3 hours, or its process died without a result. Its output is in ${_FFMPEG_LOG}")
		endif()
		execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
		math(EXPR _WAITED "${_WAITED} + 2")
		math(EXPR _REPORT "${_WAITED} % 120")
		if(_REPORT EQUAL 0)
			message(STATUS "Still waiting for FFmpeg to be built (${_WAITED} s)")
		endif()
	endwhile()
	file(READ "${_FFMPEG_RESULT}" _RESULT)
	string(STRIP "${_RESULT}" _RESULT)
	if(NOT _RESULT STREQUAL "0")
		file(STRINGS "${_FFMPEG_LOG}" _LINES)
		list(LENGTH _LINES _COUNT)
		if(_COUNT GREATER 80)
			math(EXPR _FIRST "${_COUNT} - 80")
			list(SUBLIST _LINES ${_FIRST} 80 _LINES)
		endif()
		list(JOIN _LINES "\n" _TEXT)
		message(STATUS "The end of the output of FFmpeg's build (all of it is in ${_FFMPEG_LOG}):\n${_TEXT}")
		message(FATAL_ERROR "Building FFmpeg failed (see above). It needs make, a C compiler and, on x86, NASM; on Windows it is built in MSYS2.")
	endif()
	message(STATUS "FFmpeg was built (output in ${_FFMPEG_LOG})")
endfunction()

# The libraries of FFmpeg are not needed until a program is linked, so its build starts first and runs while SDL3, SDL_image and SDL_mixer
# are built, which is what the rest of the file does.
if(NOT _SYSTEM_FFMPEG)
	blitz_start_ffmpeg()
endif()

# The build tools of the dependencies get their share of the jobs from the environment, not from the arguments of the build, as the arguments
# are remembered by ExternalContent and a different number would build everything again. Visual Studio builds a project with all of its files
# at once (/MP) instead of the files one after the other, one project after the other (a build of SDL3 is a single project).
set(_ENV_BUILD_PARALLEL_LEVEL "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}")
set(_ENV_CL "$ENV{CL}")
if(MSVC AND CMAKE_GENERATOR MATCHES "Visual Studio")
	set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} 1)
	set(ENV{CL} "${_ENV_CL} /MP${_DEPENDENCY_JOBS}")
else()
	set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} ${_DEPENDENCY_JOBS})
endif()

# Vulkan headers. The Vulkan loader itself is never linked: SDL loads it at runtime.
blitz_dependency(VulkanHeaders Vulkan-Headers
	CONFIGURE_ARGS ${_DEPENDENCY_ARGS} -DBUILD_TESTS=OFF
	BUILD_ARGS --config Release
	INSTALL_ARGS --config Release
)

# SDL3, statically linked so that the programs we produce are a single file.
#
# The runtime draws with Vulkan directly and never creates an SDL_Renderer, so on Windows the Direct3D and OpenGL render drivers
# (and OpenGL itself, which only they and OpenGL windows need) are left out. SDL has no option for the DirectSound audio driver
# (WASAPI is used instead) or the Direct3D 12 GPU driver (the runtime does not use SDL_GPU either), so the header checks that
# enable them are answered in advance.
set(_SDL3_ARGS -DSDL_STATIC=ON -DSDL_SHARED=OFF -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF -DSDL_INSTALL_DOCS=OFF)
if(WIN32)
	list(APPEND _SDL3_ARGS
		-DSDL_RENDER_D3D=OFF -DSDL_RENDER_D3D11=OFF -DSDL_RENDER_D3D12=OFF -DSDL_OPENGL=OFF -DSDL_OPENGLES=OFF
		-DHAVE_DSOUND_H=0 -DHAVE_DXGI1_6_H=0
	)
endif()
blitz_system_library(_SYSTEM_SDL3 SDL3 "sdl3 >= ${BLITZ_SDL3_MINIMUM_VERSION}")
if(_SYSTEM_SDL3)
	message(STATUS "Using the system's SDL3")
	blitz_register_system_library(LINKED sdl3 SDL3 _SONAME)
	list(APPEND _SYSTEM_LIBRARIES "-l:${_SONAME}")
	set(_SDL3_CONFIG_ARGS "") # SDL_image and SDL_mixer find the system's SDL3 themselves.
else()
	blitz_dependency(SDL3 SDL
		CONFIGURE_ARGS ${_DEPENDENCY_ARGS} ${_SDL3_ARGS}
		BUILD_ARGS --config Release
		INSTALL_ARGS --config Release
	)

	# Where SDL3Config.cmake ends up depends on the platform (cmake/, lib/cmake/SDL3, lib64/...), so look for it.
	file(GLOB_RECURSE _SDL3_CONFIG "${SDL3_INSTALL_PATH}/SDL3Config.cmake")
	list(GET _SDL3_CONFIG 0 _SDL3_CONFIG)
	cmake_path(GET _SDL3_CONFIG PARENT_PATH _SDL3_CONFIG_DIR)
	set(_SDL3_CONFIG_ARGS "-DSDL3_DIR=${_SDL3_CONFIG_DIR}")
endif()

# SDL_image and SDL_mixer link to the SDL3 of the program, so they can only be the system's when SDL3 is.
foreach(_PART IN ITEMS IMAGE MIXER)
	if(NOT _SYSTEM_SDL3 AND BLITZ_SYSTEM_SDL3_${_PART} STREQUAL "ON")
		message(FATAL_ERROR "BLITZ_SYSTEM_SDL3_${_PART} is ON, but SDL3 is not the system's (BLITZ_SYSTEM_SDL3), and a program can not have two copies of SDL.")
	endif()
endforeach()
set(_SYSTEM_SDL3_IMAGE OFF)
set(_SYSTEM_SDL3_MIXER OFF)
if(_SYSTEM_SDL3)
	blitz_system_library(_SYSTEM_SDL3_IMAGE SDL3_IMAGE "sdl3-image >= ${BLITZ_SDL3_IMAGE_MINIMUM_VERSION}")
	blitz_system_library(_SYSTEM_SDL3_MIXER SDL3_MIXER "sdl3-mixer >= ${BLITZ_SDL3_MIXER_MINIMUM_VERSION}")
endif()

# SDL_image builds the libraries for AVIF, JPEG XL and WebP itself when it is told to use its vendored copies, which are submodules
# of its repository. A clone does not fetch them, and fetching all of them (with everything they in turn depend on, some of which is
# hosted by Google and not on GitHub) is slow, so only the ones that are used are fetched.
#
# SDL_image also always builds the AV1 encoder (aom) when it builds libavif, which is only needed to save AVIF files and makes up
# half of every program, so it is turned off by changing the lines of its CMakeLists.txt that turn it on.
#
# The source is the third_party/SDL_image submodule, which this changes in place (its git status is ignored through .gitmodules).
# A stamp next to the build directory records the revision that was prepared, so that a restored dependency cache skips this.
function(blitz_fetch_image_codecs TEMP_PATH SOURCE_PATH BINARY_PATH INSTALL_PATH)
	execute_process(
		COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_PATH}" rev-parse HEAD
		OUTPUT_VARIABLE _REVISION OUTPUT_STRIP_TRAILING_WHITESPACE
	)
	set(_STAMP "${BINARY_PATH}.codecs")
	if(EXISTS "${_STAMP}")
		file(READ "${_STAMP}" _STAMPED)
		# The stamp is restored with the dependency cache, but the fetched codecs and the changes to CMakeLists.txt are in the
		# source checkout, which is a new one in CI. Without them the next configure fails, and ExternalContent goes on with the
		# build files it still has, so a change of the compiler flags would silently not apply.
		file(READ "${SOURCE_PATH}/CMakeLists.txt" _PATCHED)
		if(_STAMPED STREQUAL _REVISION AND EXISTS "${SOURCE_PATH}/external/libjxl/third_party/highway/CMakeLists.txt"
			AND EXISTS "${SOURCE_PATH}/external/libavif/CMakeLists.txt" AND EXISTS "${SOURCE_PATH}/external/dav1d/CMakeLists.txt"
			AND EXISTS "${SOURCE_PATH}/external/libwebp/CMakeLists.txt" AND EXISTS "${SOURCE_PATH}/external/libtiff/CMakeLists.txt" AND _PATCHED MATCHES "set\\(SDLIMAGE_AOM OFF\\)")
			return()
		endif()
	endif()
	execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_PATH}" checkout -- CMakeLists.txt)

	foreach(_STEP IN ITEMS
		"${SOURCE_PATH}|external/libwebp external/libavif external/dav1d external/libjxl external/libtiff"
		# libjxl is built without skcms, which makes it use lcms2 instead.
		"${SOURCE_PATH}/external/libjxl|third_party/brotli third_party/highway third_party/lcms"
	)
		string(REPLACE "|" ";" _STEP "${_STEP}")
		list(GET _STEP 0 _DIRECTORY)
		list(GET _STEP 1 _MODULES)
		separate_arguments(_MODULES)
		execute_process(
			COMMAND "${GIT_EXECUTABLE}" submodule update --init --depth 1 ${_MODULES}
			WORKING_DIRECTORY "${_DIRECTORY}"
			RESULT_VARIABLE _RESULT
		)
		if(NOT _RESULT EQUAL 0)
			message(FATAL_ERROR "Fetching the image codecs in '${_DIRECTORY}' failed.")
		endif()
	endforeach()

	set(_FILE "${SOURCE_PATH}/CMakeLists.txt")
	file(READ "${_FILE}" _CONTENT)
	foreach(_CHANGE IN ITEMS
		"set(SDLIMAGE_AOM ON)|set(SDLIMAGE_AOM OFF)"
		"set(SDLIMAGE_AOM_VENDORED ON)|set(SDLIMAGE_AOM_VENDORED OFF)"
		"set(AVIF_CODEC_AOM \"SYSTEM\" CACHE|set(AVIF_CODEC_AOM OFF CACHE"
		"set(AVIF_CODEC_AOM_ENCODE ON CACHE|set(AVIF_CODEC_AOM_ENCODE OFF CACHE"
	)
		string(REPLACE "|" ";" _CHANGE "${_CHANGE}")
		list(GET _CHANGE 0 _FROM)
		list(GET _CHANGE 1 _TO)
		string(FIND "${_CONTENT}" "${_FROM}" _AT)
		if(NOT _AT EQUAL -1)
			string(REPLACE "${_FROM}" "${_TO}" _CONTENT "${_CONTENT}")
			file(WRITE "${_FILE}" "${_CONTENT}")
		endif()
		string(FIND "${_CONTENT}" "${_TO}" _AT)
		if(_AT EQUAL -1)
			message(FATAL_ERROR "SDL_image changed, '${_FROM}' is no longer in its CMakeLists.txt.")
		endif()
	endforeach()
	file(WRITE "${_STAMP}" "${_REVISION}")
endfunction()

# ExternalContent only redoes a stage when its arguments change, so a dependency that was installed by an older version of this file
# keeps the install tree it had, even when that lacks files that are shipped now (the licenses of the codecs). Before building
# one, throw away what ExternalContent remembers of it when a required file is missing, which makes it configure, build and install again.
# Afterwards, a file that is still missing is an error, as the license notices have to be shipped with every program.
function(blitz_check_licenses NAME STAGE)
	set(_INSTALL "${CMAKE_BINARY_DIR}/ExternalContentFiles/${NAME}.dst")
	set(_MISSING "")
	foreach(_FILE IN LISTS ARGN)
		if(NOT EXISTS "${_INSTALL}/share/licenses/${_FILE}")
			list(APPEND _MISSING "${_FILE}")
		endif()
	endforeach()
	if(NOT _MISSING)
		return()
	endif()
	if(STAGE STREQUAL "BEFORE")
		if(EXISTS "${_INSTALL}")
			message(STATUS "${NAME} was installed without '${_MISSING}', building it again.")
			file(GLOB _STAMPS "${CMAKE_BINARY_DIR}/ExternalContentFiles/${NAME}.tmp/*.sha3")
			file(REMOVE ${_STAMPS})
			file(REMOVE_RECURSE "${_INSTALL}")
		endif()
	else()
		message(FATAL_ERROR "${NAME} did not install the licenses '${_MISSING}'. Delete the directory '${CMAKE_BINARY_DIR}/ExternalContentFiles' and configure again.")
	endif()
endfunction()

# dav1d (which decodes AVIF) has assembly for x86 that needs NASM, which is not installed on most Windows machines. Without it dav1d is
# built from C only, which works the same but decodes AV1 more slowly. Release builds (CI) have NASM, and set BLITZLLVM_REQUIRE_NASM so
# that they cannot silently lose it. Install it with 'winget install nasm' (or 'apt install nasm', 'brew install nasm').
option(BLITZLLVM_REQUIRE_NASM "Fail instead of building dav1d without assembly when NASM is missing on x86" OFF)
blitz_system_library(_SYSTEM_IMAGE_CODECS IMAGE_CODECS libavif libjxl libtiff-4 libwebp libwebpdemux libwebpmux)
set(_SDL3_IMAGE_ASM_ARGS "")
if(NOT (_SYSTEM_IMAGE_CODECS OR _SYSTEM_SDL3_IMAGE))
	if(CMAKE_GENERATOR_PLATFORM)
		set(_ASM_ARCHITECTURE "${CMAKE_GENERATOR_PLATFORM}")
	else()
		set(_ASM_ARCHITECTURE "${CMAKE_SYSTEM_PROCESSOR}")
	endif()
	if(_UNIVERSAL)
		list(APPEND _SDL3_IMAGE_ASM_ARGS -DDAV1D_ASM=OFF)
	elseif(_ASM_ARCHITECTURE MATCHES "^([xX]86|[xX]64|Win32|AMD64|amd64|x86_64|i[3-6]86)$")
		if(BLITZLLVM_NASM AND NOT EXISTS "${BLITZLLVM_NASM}")
			unset(BLITZLLVM_NASM CACHE) # Uninstalled since it was found.
		endif()
		find_program(BLITZLLVM_NASM nasm
			HINTS "$ENV{LOCALAPPDATA}/bin/NASM" "$ENV{ProgramFiles}/NASM" "$ENV{ProgramW6432}/NASM" "$ENV{LOCALAPPDATA}/NASM"
			DOC "NASM, which builds the x86 assembly of dav1d"
		)
		if(BLITZLLVM_NASM)
			message(STATUS "Building dav1d with assembly using NASM: ${BLITZLLVM_NASM}")
			list(APPEND _SDL3_IMAGE_ASM_ARGS "-DCMAKE_ASM_NASM_COMPILER=${BLITZLLVM_NASM}")
		elseif(BLITZLLVM_REQUIRE_NASM)
			message(FATAL_ERROR "NASM was not found, but BLITZLLVM_REQUIRE_NASM is set. Install it ('winget install nasm' on Windows) or set BLITZLLVM_NASM to its path.")
		else()
			message(WARNING "NASM was not found, so dav1d is built without assembly and decodes AVIF images more slowly. Install it ('winget install nasm' on Windows) and configure again to avoid that.")
			list(APPEND _SDL3_IMAGE_ASM_ARGS -DDAV1D_ASM=OFF)
		endif()
	endif()
endif()

# Loads the image files for textures. PNG and JPEG are handled by the built in stb_image, AVIF (libavif with dav1d to decode), JPEG XL (libjxl), TIFF (libtiff) and WebP (libwebp) by the vendored libraries,
# which are built as shared libraries that SDL_image loads when the first file of that format is opened. Programs that don't load images
# don't need them, and the ones that do get them copied next to them by blitzcc (see main.cpp), which keeps the programs small and means
# that an update of a codec doesn't change every program. The libraries find each other next to themselves.
# With the system's codecs (BLITZ_SYSTEM_IMAGE_CODECS) SDL_image only has their headers and loads the libraries from the system instead.
set(_SDL3_IMAGE_LICENSES SDL3_image/LICENSE.txt SDL3_image/optional/LICENSE.dav1d.txt SDL3_image/optional/LICENSE.avif.txt
	SDL3_image/optional/LICENSE.jxl.txt SDL3_image/optional/LICENSE.webp.txt)
# macOS reads TIFF files with ImageIO, so no libtiff is built there and there is no license for it.
if(NOT APPLE)
	list(APPEND _SDL3_IMAGE_LICENSES SDL3_image/optional/LICENSE.tiff.txt)
endif()
set(_SDL3_IMAGE_BUILD_ARGS -DBUILD_SHARED_LIBS=OFF -DSDLIMAGE_VENDORED=ON -DSDLIMAGE_DEPS_SHARED=ON
	-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON "-DCMAKE_INSTALL_RPATH=${_SHARED_RPATH}" ${_SHARED_STRIP})
set(_SDL3_IMAGE_PATCH PATCH_FUNCTION blitz_fetch_image_codecs)
if(_SYSTEM_IMAGE_CODECS)
	set(_SDL3_IMAGE_LICENSES SDL3_image/LICENSE.txt)
	set(_SDL3_IMAGE_BUILD_ARGS -DBUILD_SHARED_LIBS=OFF -DSDLIMAGE_VENDORED=OFF -DSDLIMAGE_DEPS_SHARED=ON)
	set(_SDL3_IMAGE_PATCH "")
endif()
if(_SYSTEM_SDL3_IMAGE)
	message(STATUS "Using the system's SDL3_image")
	blitz_register_system_library(LINKED sdl3-image SDL3_image _SONAME)
	list(APPEND _SYSTEM_LIBRARIES "-l:${_SONAME}")
else()
	if(_SYSTEM_IMAGE_CODECS)
		message(STATUS "Using the system's libavif, libjxl, libtiff and libwebp")
		blitz_register_system_library(LOADED libavif avif _IGNORED)
		blitz_register_system_library(LOADED libjxl jxl _IGNORED)
		blitz_register_system_library(LOADED libtiff-4 tiff _IGNORED)
		blitz_register_system_library(LOADED libwebp webp _IGNORED)
		blitz_register_system_library(LOADED libwebpdemux webpdemux _IGNORED)
		blitz_register_system_library(LOADED libwebpmux webpmux _IGNORED)
		# Whether SDL_image loads a codec or links it is remembered by its build directory from the first time it was configured, and does
		# not follow DEPS_SHARED later. A build directory from before (a cache of an older build) that linked the codecs would make every
		# program need them at link time, so it is thrown away.
		set(_CACHE "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_image.bin/CMakeCache.txt")
		if(EXISTS "${_CACHE}")
			file(STRINGS "${_CACHE}" _LINKED REGEX "^SDLIMAGE_(AVIF|JXL|TIF|WEBP)_SHARED:BOOL=OFF$")
			if(_LINKED)
				message(STATUS "SDL3_image was configured to link its codecs, building it again.")
				file(GLOB _STAMPS "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_image.tmp/*.sha3")
				file(REMOVE ${_STAMPS})
				file(REMOVE_RECURSE "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_image.dst" "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_image.bin")
			endif()
		endif()
	else()
		# An install of SDL_image from before its codecs were shared libraries has them as static libraries, which would be linked into programs.
		# Build it again from scratch, ExternalContent would not notice that and would build the old configuration.
		# The dav1d.lib of Windows is also the import library of dav1d.dll, which a build with shared codecs installs, so it only means a static
		# build when there is no dav1d.dll (otherwise every configure built SDL_image again).
		set(_IMAGE_DST "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_image.dst")
		if(EXISTS "${_IMAGE_DST}/lib/libdav1d.a" OR (EXISTS "${_IMAGE_DST}/lib/dav1d.lib" AND NOT EXISTS "${_IMAGE_DST}/bin/dav1d.dll"))
			message(STATUS "SDL3_image was installed with static codecs, building it again.")
			file(GLOB _STAMPS "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_image.tmp/*.sha3")
			file(REMOVE ${_STAMPS})
			file(REMOVE_RECURSE "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_image.dst" "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_image.bin")
			# The stamp of the fetched codec sources goes too, as a restored cache has the stamp but not the submodules in the source tree.
			file(REMOVE "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_image.bin.codecs")
		endif()
	endif()
	blitz_check_licenses(SDL3_image BEFORE ${_SDL3_IMAGE_LICENSES})
	blitz_dependency(SDL3_image SDL_image
		${_SDL3_IMAGE_PATCH}
		CONFIGURE_ARGS ${_DEPENDENCY_ARGS} ${_SDL3_CONFIG_ARGS}
			${_SDL3_IMAGE_BUILD_ARGS} -DSDLIMAGE_STRICT=OFF
			-DSDLIMAGE_SAMPLES=OFF -DSDLIMAGE_TESTS=OFF -DSDLIMAGE_INSTALL=ON
			-DSDLIMAGE_PNG_LIBPNG=OFF -DSDLIMAGE_TIF=ON -DSDLIMAGE_AVIF=ON -DSDLIMAGE_AVIF_SAVE=OFF -DSDLIMAGE_JXL=ON -DSDLIMAGE_WEBP=ON
			${_SDL3_IMAGE_ASM_ARGS}
		BUILD_ARGS --config Release
		INSTALL_ARGS --config Release
	)
	blitz_check_licenses(SDL3_image AFTER ${_SDL3_IMAGE_LICENSES})
endif()

# SDL_mixer builds libopus, opusfile and libogg itself when it is told to use its vendored copies, which are submodules of its
# repository that a clone does not fetch. They are built as shared libraries, like the codecs of SDL_image. Only those three are fetched, as no other decoder that needs a library is used. A stamp
# next to the build directory records the revision that was prepared, so that a restored dependency cache skips this.
function(blitz_fetch_audio_codecs TEMP_PATH SOURCE_PATH BINARY_PATH INSTALL_PATH)
	execute_process(
		COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_PATH}" rev-parse HEAD
		OUTPUT_VARIABLE _REVISION OUTPUT_STRIP_TRAILING_WHITESPACE
	)
	set(_STAMP "${BINARY_PATH}.codecs")
	if(EXISTS "${_STAMP}")
		file(READ "${_STAMP}" _STAMPED)
		# The fetched codecs are in the source checkout, which is a new one in CI when only the dependency cache is restored.
		if(_STAMPED STREQUAL _REVISION AND EXISTS "${SOURCE_PATH}/external/opus/CMakeLists.txt"
			AND EXISTS "${SOURCE_PATH}/external/ogg/CMakeLists.txt" AND EXISTS "${SOURCE_PATH}/external/opusfile/CMakeLists.txt")
			return()
		endif()
	endif()
	execute_process(
		COMMAND "${GIT_EXECUTABLE}" submodule update --init --depth 1 external/ogg external/opus external/opusfile
		WORKING_DIRECTORY "${SOURCE_PATH}"
		RESULT_VARIABLE _RESULT
	)
	if(NOT _RESULT EQUAL 0)
		message(FATAL_ERROR "Fetching the audio codecs in '${SOURCE_PATH}' failed.")
	endif()
	file(WRITE "${_STAMP}" "${_REVISION}")
endfunction()

# Plays the sounds. Decoders for WAV, MP3 (dr_mp3), OGG Vorbis (stb_vorbis) and FLAC (dr_flac) are built in. Opus (libopus and
# opusfile, which play .opus files and Opus in .ogg files, and libogg) is a set of shared libraries that SDL_mixer loads when a program
# opens such a file, the vendored ones that are shipped and copied next to programs by blitzcc, or the system's (BLITZ_SYSTEM_AUDIO_CODECS).
# Like the codecs of SDL_image that keeps the programs small and means that an update of the runtime doesn't change them.
blitz_system_library(_SYSTEM_AUDIO_CODECS AUDIO_CODECS opusfile)
set(_SDL3_MIXER_LICENSES SDL3_mixer/LICENSE.txt SDL3_mixer/optional/LICENSE.opus.txt SDL3_mixer/optional/LICENSE.opusfile.txt
	SDL3_mixer/optional/LICENSE.ogg-vorbis.txt)
set(_SDL3_MIXER_BUILD_ARGS -DSDLMIXER_VENDORED=ON -DSDLMIXER_DEPS_SHARED=ON
	-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON "-DCMAKE_INSTALL_RPATH=${_SHARED_RPATH}" ${_SHARED_STRIP})
set(_SDL3_MIXER_PATCH PATCH_FUNCTION blitz_fetch_audio_codecs)
if(_SYSTEM_AUDIO_CODECS)
	set(_SDL3_MIXER_LICENSES SDL3_mixer/LICENSE.txt)
	set(_SDL3_MIXER_BUILD_ARGS -DSDLMIXER_VENDORED=OFF -DSDLMIXER_DEPS_SHARED=ON)
	set(_SDL3_MIXER_PATCH "")
endif()
if(_SYSTEM_SDL3_MIXER)
	message(STATUS "Using the system's SDL3_mixer")
	blitz_register_system_library(LINKED sdl3-mixer SDL3_mixer _SONAME)
	list(APPEND _SYSTEM_LIBRARIES "-l:${_SONAME}")
else()
	# As with dav1d.lib above, opus.lib is also the import library of the opus.dll of a shared build.
	set(_MIXER_DST "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_mixer.dst")
	file(GLOB _MIXER_OPUS_DLL "${_MIXER_DST}/bin/*opus*.dll")
	if(EXISTS "${_MIXER_DST}/lib/libopus.a" OR (EXISTS "${_MIXER_DST}/lib/opus.lib" AND NOT _MIXER_OPUS_DLL))
		# An install of SDL_mixer from before Opus was a shared library has it as a static library, which would be linked into programs (also
		# with the system's Opus, as the copy that was built then links the vendored one).
		# Build it again from scratch, ExternalContent would not notice that and would build the old configuration.
		message(STATUS "SDL3_mixer was installed with static Opus, building it again.")
		file(GLOB _STAMPS "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_mixer.tmp/*.sha3")
		file(REMOVE ${_STAMPS})
		file(REMOVE_RECURSE "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_mixer.dst" "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_mixer.bin")
		file(REMOVE "${CMAKE_BINARY_DIR}/ExternalContentFiles/SDL3_mixer.bin.codecs")
	endif()
	if(_SYSTEM_AUDIO_CODECS)
		message(STATUS "Using the system's opusfile")
		blitz_register_system_library(LOADED opusfile opusfile _IGNORED)
	endif()
	blitz_check_licenses(SDL3_mixer BEFORE ${_SDL3_MIXER_LICENSES})
	blitz_dependency(SDL3_mixer SDL_mixer
		${_SDL3_MIXER_PATCH}
		CONFIGURE_ARGS ${_DEPENDENCY_ARGS} ${_SDL3_CONFIG_ARGS}
			-DBUILD_SHARED_LIBS=OFF ${_SDL3_MIXER_BUILD_ARGS} -DSDLMIXER_STRICT=OFF
			-DSDLMIXER_SAMPLES=OFF -DSDLMIXER_TESTS=OFF -DSDLMIXER_INSTALL=ON
			-DSDLMIXER_OPUS=ON -DSDLMIXER_GME=OFF -DSDLMIXER_MIDI=OFF -DSDLMIXER_MOD=OFF -DSDLMIXER_WAVPACK=OFF -DSDLMIXER_MP3_MPG123=OFF
			-DSDLMIXER_FLAC_LIBFLAC=OFF -DSDLMIXER_VORBIS_VORBISFILE=OFF -DSDLMIXER_VORBIS_STB=ON
		BUILD_ARGS --config Release
		INSTALL_ARGS --config Release
	)
	blitz_check_licenses(SDL3_mixer AFTER ${_SDL3_MIXER_LICENSES})
endif()

# Movies with Opus sound are decoded with the libopus that SDL_mixer built, whose headers it does not install. They are copied next to
# the other includes of SDL_mixer (which a restored dependency cache keeps), fetching the submodule first if the clone doesn't have it.
# The runtime only has the headers: it loads the library when a movie has Opus sound (see movie.cpp), the one next to the program or the
# system's with BLITZ_SYSTEM_AUDIO_CODECS.
set(_OPUS_HEADERS "${SDL3_mixer_INSTALL_PATH}/include/opus")
if(_SYSTEM_AUDIO_CODECS OR _SYSTEM_SDL3_MIXER)
	execute_process(COMMAND "${PKG_CONFIG_EXECUTABLE}" --exists opus RESULT_VARIABLE _RESULT)
	if(NOT _RESULT EQUAL 0)
		message(FATAL_ERROR "The runtime plays the Opus sound of movies with libopus, but pkg-config has no 'opus'. Install its development package.")
	endif()
	blitz_register_system_library(LOADED opus opus _IGNORED)
	set(_OPUS_HEADERS "")
elseif(NOT EXISTS "${_OPUS_HEADERS}/opus_multistream.h")
	set(_OPUS_SOURCE "${PROJECT_SOURCE_DIR}/third_party/SDL_mixer/external/opus")
	if(NOT EXISTS "${_OPUS_SOURCE}/include/opus_multistream.h")
		execute_process(
			COMMAND "${GIT_EXECUTABLE}" submodule update --init --depth 1 external/opus
			WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}/third_party/SDL_mixer"
			RESULT_VARIABLE _RESULT
		)
		if(NOT _RESULT EQUAL 0)
			message(FATAL_ERROR "Fetching the headers of libopus failed.")
		endif()
	endif()
	file(GLOB _OPUS_HEADER_FILES "${_OPUS_SOURCE}/include/*.h")
	file(COPY ${_OPUS_HEADER_FILES} DESTINATION "${_OPUS_HEADERS}")
endif()

# The dependencies that CMake builds are done, the environment is the one of the rest of the configuration again.
set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} "${_ENV_BUILD_PARALLEL_LEVEL}")
set(ENV{CL} "${_ENV_CL}")
if(NOT _ENV_BUILD_PARALLEL_LEVEL)
	unset(ENV{CMAKE_BUILD_PARALLEL_LEVEL})
endif()
if(NOT _ENV_CL)
	unset(ENV{CL})
endif()

if(_SYSTEM_FFMPEG)
	message(STATUS "Using the system's FFmpeg")
	foreach(_LIBRARY IN ITEMS avutil:avutil swscale:swscale avcodec:avcodec avformat:avformat)
		string(REPLACE ":" ";" _LIBRARY "${_LIBRARY}")
		list(GET _LIBRARY 0 _MODULE)
		list(GET _LIBRARY 1 _NAME)
		blitz_register_system_library(LOADED lib${_MODULE} ${_NAME} _IGNORED)
	endforeach()
	set(_FFMPEG_LIBRARIES "")
	set(FFMPEG_INSTALL_PATH "")
else()
	blitz_wait_ffmpeg()

	# The shared libraries by the name that programs open them with: libavcodec.so.61, libavcodec.61.dylib and avcodec-61.dll.
	if(WIN32)
		file(GLOB _FFMPEG_LIBRARIES "${FFMPEG_INSTALL_PATH}/bin/*.dll")
	elseif(APPLE)
		file(GLOB _FFMPEG_LIBRARIES "${FFMPEG_INSTALL_PATH}/lib/lib*.dylib")
		list(FILTER _FFMPEG_LIBRARIES INCLUDE REGEX "/lib[a-z]+\\.[0-9]+\\.dylib$")
	else()
		file(GLOB _FFMPEG_LIBRARIES "${FFMPEG_INSTALL_PATH}/lib/lib*.so.*")
		list(FILTER _FFMPEG_LIBRARIES INCLUDE REGEX "\\.so\\.[0-9]+$")
	endif()
	# FFmpeg installs the version of each library and a link to it under the shorter name, and installing a link copies the link and not
	# the file. So the files are copied under the short name, and those are what is installed and shipped.
	set(_FFMPEG_STAGE "${FFMPEG_INSTALL_PATH}/runtime")
	file(MAKE_DIRECTORY "${_FFMPEG_STAGE}")
	set(_FFMPEG_FILES "")
	foreach(_LIBRARY IN LISTS _FFMPEG_LIBRARIES)
		cmake_path(GET _LIBRARY FILENAME _NAME)
		file(REAL_PATH "${_LIBRARY}" _REAL)
		file(COPY_FILE "${_REAL}" "${_FFMPEG_STAGE}/${_NAME}" ONLY_IF_DIFFERENT)
		list(APPEND _FFMPEG_FILES "${_FFMPEG_STAGE}/${_NAME}")
	endforeach()
	set(_FFMPEG_LIBRARIES ${_FFMPEG_FILES})
	list(LENGTH _FFMPEG_LIBRARIES _FFMPEG_COUNT)
	if(NOT _FFMPEG_COUNT EQUAL 4)
		message(FATAL_ERROR "FFmpeg should have built 4 libraries (avutil, swscale, avcodec and avformat), but built: ${_FFMPEG_LIBRARIES}")
	endif()
	# The licenses of FFmpeg go with its libraries: its own notice, and the LGPL that lets the user replace them.
	file(MAKE_DIRECTORY "${FFMPEG_INSTALL_PATH}/share/licenses/FFmpeg")
	file(COPY "${_FFMPEG_SOURCE}/COPYING.LGPLv2.1" "${_FFMPEG_SOURCE}/LICENSE.md" DESTINATION "${FFMPEG_INSTALL_PATH}/share/licenses/FFmpeg")
endif()

# The codecs of SDL_image (libavif, dav1d, libjxl, brotli, highway, libtiff and libwebp) and of SDL_mixer (libopus, opusfile and libogg) are shared
# libraries: they are shipped with the runtime and copied next to the programs that load images or sounds. On Windows they are DLLs in
# bin/ (their import libraries in lib/ are not needed, as the SDL libraries load them by name), elsewhere they are in lib/ with their
# version in the file name.
# SDL_image opens them by name (libavif-16.dll, libavif.so.16, libavif.16.dylib), which is what the link libavif.so and libavif.dylib point at.
# Installing a link copies the link and not the file, so the files are copied under that name, and those are what is shipped.
function(blitz_stage_shared_libraries INSTALL_PATH RESULT)
	set(_STAGE "${INSTALL_PATH}/runtime")
	file(MAKE_DIRECTORY "${_STAGE}")
	set(_STAGED "")
	if(WIN32)
		file(GLOB _SHARED "${INSTALL_PATH}/bin/*.dll")
		foreach(_LIBRARY IN LISTS _SHARED)
			cmake_path(GET _LIBRARY FILENAME _NAME)
			file(COPY_FILE "${_LIBRARY}" "${_STAGE}/${_NAME}" ONLY_IF_DIFFERENT)
			list(APPEND _STAGED "${_STAGE}/${_NAME}")
		endforeach()
	else()
		if(APPLE)
			file(GLOB _SHARED "${INSTALL_PATH}/lib/lib*.dylib")
		else()
			file(GLOB _SHARED "${INSTALL_PATH}/lib/lib*.so")
		endif()
		foreach(_LIBRARY IN LISTS _SHARED)
			if(NOT IS_SYMLINK "${_LIBRARY}")
				continue()
			endif()
			file(READ_SYMLINK "${_LIBRARY}" _NAME)
			cmake_path(GET _NAME FILENAME _NAME)
			file(REAL_PATH "${_LIBRARY}" _REAL)
			file(COPY_FILE "${_REAL}" "${_STAGE}/${_NAME}" ONLY_IF_DIFFERENT)
			list(APPEND _STAGED "${_STAGE}/${_NAME}")
		endforeach()
	endif()
	set(${RESULT} "${_STAGED}" PARENT_SCOPE)
endfunction()

