# Builds FFmpeg, as a process of its own so that it runs next to the build of the other dependencies (see dependencies.cmake, blitz_start_ffmpeg).
# Run as: cmake -DFFMPEG_SETTINGS=<file> -P build_ffmpeg.cmake
# The settings file is written by dependencies.cmake and sets everything that is used below. When this is done, the file FFMPEG_RESULT
# holds 0 if FFmpeg was built and installed, and anything else if it was not. The stamp is only written after a successful build.
if(NOT FFMPEG_SETTINGS OR NOT EXISTS "${FFMPEG_SETTINGS}")
	message(FATAL_ERROR "FFMPEG_SETTINGS has to be the settings file written by dependencies.cmake.")
endif()
include("${FFMPEG_SETTINGS}")

function(blitz_ffmpeg_done CODE)
	if(CODE EQUAL 0)
		file(WRITE "${FFMPEG_STAMP}" "${FFMPEG_STAMP_TEXT}")
	endif()
	file(WRITE "${FFMPEG_RESULT}" "${CODE}")
	if(NOT CODE EQUAL 0)
		message(STATUS "Building FFmpeg failed (exit code ${CODE}).")
	endif()
endfunction()

if(FFMPEG_WINDOWS)
	# Paths of Windows (C:/a/b) are /c/a/b in MSYS2.
	foreach(_VARIABLE IN ITEMS FFMPEG_SOURCE FFMPEG_BUILD FFMPEG_INSTALL)
		string(REGEX REPLACE "^([A-Za-z]):" "/\\1" ${_VARIABLE}_UNIX "${${_VARIABLE}}")
	endforeach()
	string(REPLACE ";" " " _CONFIGURE_ARGS "${FFMPEG_ARGS}")
	string(REPLACE ";" " " _MSYS2_COMPILER_ARGS "${FFMPEG_MSYS2_COMPILER_ARGS}")
	set(_SCRIPT "${FFMPEG_ROOT}/FFmpeg.sh")
	file(WRITE "${_SCRIPT}" "set -e\ncd '${FFMPEG_BUILD_UNIX}'\n'${FFMPEG_SOURCE_UNIX}/configure' --prefix='${FFMPEG_INSTALL_UNIX}' --target-os=mingw32 ${_MSYS2_COMPILER_ARGS} ${_CONFIGURE_ARGS}\nmake -j${FFMPEG_JOBS}\nmake install\n")
	string(REGEX REPLACE "^([A-Za-z]):" "/\\1" _SCRIPT_UNIX "${_SCRIPT}")
	execute_process(
		COMMAND "${CMAKE_COMMAND}" -E env MSYSTEM=${FFMPEG_MSYS2_ENVIRONMENT} CHERE_INVOKING=1 "${FFMPEG_MSYS2}/usr/bin/bash.exe" -lc "bash '${_SCRIPT_UNIX}'"
		RESULT_VARIABLE _RESULT
	)
elseif(FFMPEG_UNIVERSAL)
	# configure builds for one architecture, so each gets its own build and prefix, and lipo joins the libraries. The headers are the
	# same for all of them. An architecture other than this computer's is cross-compiled, with clang -arch.
	set(_RESULT 0)
	set(_FIRST "")
	foreach(_ARCH IN LISTS FFMPEG_OSX_ARCHITECTURES)
		set(_ARCH_BUILD "${FFMPEG_BUILD}.${_ARCH}")
		set(_ARCH_PREFIX "${FFMPEG_INSTALL}.${_ARCH}")
		file(REMOVE_RECURSE "${_ARCH_BUILD}" "${_ARCH_PREFIX}")
		file(MAKE_DIRECTORY "${_ARCH_BUILD}")
		set(_ARCH_ARGS "--arch=${_ARCH}" "--cc=${FFMPEG_C_COMPILER} -arch ${_ARCH}")
		if(NOT _ARCH STREQUAL FFMPEG_HOST_PROCESSOR)
			list(APPEND _ARCH_ARGS --enable-cross-compile --target-os=darwin)
		endif()
		execute_process(
			COMMAND "${FFMPEG_SOURCE}/configure" "--prefix=${_ARCH_PREFIX}" ${_ARCH_ARGS} ${FFMPEG_ARGS}
			WORKING_DIRECTORY "${_ARCH_BUILD}" RESULT_VARIABLE _RESULT
		)
		if(_RESULT EQUAL 0)
			execute_process(COMMAND make "-j${FFMPEG_JOBS}" WORKING_DIRECTORY "${_ARCH_BUILD}" RESULT_VARIABLE _RESULT)
		endif()
		if(_RESULT EQUAL 0)
			execute_process(COMMAND make install WORKING_DIRECTORY "${_ARCH_BUILD}" RESULT_VARIABLE _RESULT)
		endif()
		if(NOT _RESULT EQUAL 0)
			break()
		endif()
		if(NOT _FIRST)
			set(_FIRST "${_ARCH_PREFIX}")
		endif()
	endforeach()
	if(_RESULT EQUAL 0)
		file(COPY "${_FIRST}/" DESTINATION "${FFMPEG_INSTALL}")
		file(GLOB _DYLIBS RELATIVE "${_FIRST}/lib" "${_FIRST}/lib/lib*.dylib")
		foreach(_DYLIB IN LISTS _DYLIBS)
			if(IS_SYMLINK "${_FIRST}/lib/${_DYLIB}")
				continue()
			endif()
			set(_SLICES "")
			foreach(_ARCH IN LISTS FFMPEG_OSX_ARCHITECTURES)
				list(APPEND _SLICES "${FFMPEG_INSTALL}.${_ARCH}/lib/${_DYLIB}")
			endforeach()
			execute_process(COMMAND lipo -create ${_SLICES} -output "${FFMPEG_INSTALL}/lib/${_DYLIB}" RESULT_VARIABLE _RESULT)
			if(NOT _RESULT EQUAL 0)
				break()
			endif()
		endforeach()
	endif()
else()
	execute_process(
		COMMAND "${FFMPEG_SOURCE}/configure" "--prefix=${FFMPEG_INSTALL}" "--cc=${FFMPEG_C_COMPILER}" ${FFMPEG_ARGS}
		WORKING_DIRECTORY "${FFMPEG_BUILD}" RESULT_VARIABLE _RESULT
	)
	if(_RESULT EQUAL 0)
		execute_process(COMMAND make "-j${FFMPEG_JOBS}" WORKING_DIRECTORY "${FFMPEG_BUILD}" RESULT_VARIABLE _RESULT)
	endif()
	if(_RESULT EQUAL 0)
		execute_process(COMMAND make install WORKING_DIRECTORY "${FFMPEG_BUILD}" RESULT_VARIABLE _RESULT)
	endif()
endif()
if(NOT _RESULT MATCHES "^[0-9]+$")
	set(_RESULT 1) # execute_process reports a command that could not be started as text.
endif()
blitz_ffmpeg_done(${_RESULT})
