; Tutorial 4.01: Explosions
;
; An explosion is several simple effects at the same time:
;
;   - a flash of light,
;   - a ball of fire that grows and cools from yellow to red and then turns into grey smoke,
;   - sparks that fly out and fall,
;   - a ring of dust, the shock wave, that races along the ground,
;   - pieces of debris that bounce,
;   - and a camera that shakes.
;
; Each part on its own is just a sprite or a small mesh that changes a little every frame. Tutorial 3.08 showed the
; basics of sprites and particles; this one builds on it.
;
; New things here:
;   Particles that change as they age: colour, size, and the blend mode (fire adds light, smoke covers it).
;   A flat ring mesh that grows and fades away, for the shock wave.
;   A point light (CreateLight 2) whose colour is turned up for a moment and then down again: the flash.
;   Camera shake that dies away by itself.
;
; Controls: Space or a click makes an explosion, A turns the automatic explosions on and off, Left / Right turn the
; camera.

Include "<keys.bb>"
Include "<mouse.bb>"
Include "<graphics.bb>"
Include "<texture.bb>"
Include "<entity.bb>"

Graphics3D 640, 480, 0, BB_GRAPHICS_WINDOWED
AppTitle "Tutorial 4.01: Explosions"
SetBuffer BackBuffer()
SeedRnd MilliSecs()

Const KIND_FIRE = 0, KIND_SMOKE = 1, KIND_SPARK = 2

; The camera sits on a pivot, so turning the pivot swings it around the middle. A second pivot between the two
; carries the shake, so shaking never disturbs where the camera really is.
Global cameraPivot = CreatePivot()
Global shakePivot = CreatePivot(cameraPivot)
Global camera = CreateCamera(shakePivot)
PositionEntity camera, 0, 7, -18.0
RotateEntity camera, 20, 0, 0
CameraClsColor camera, 25, 28, 40
CameraFogMode camera, 1
CameraFogRange camera, 20, 60
CameraFogColor camera, 25, 28, 40

Local sun = CreateLight()
RotateEntity sun, 50, 30, 0
AmbientLight 60, 60, 70

; The flash: a point light that is dark until something explodes.
Global flash = CreateLight(BB_LIGHT_POINT)
LightRange flash, 12
LightColor flash, 0, 0, 0
Global flashPower#

Local ground = CreatePlane(16)
EntityColor ground, 70, 75, 60

; Some crates to light up and throw around.
Local i, crate
For i = 1 To 14
	crate = CreateCube()
	ScaleEntity crate, 0.6, 0.6, 0.6
	PositionEntity crate, Rnd(-9, 9), 0.6, Rnd(-6, 9)
	TurnEntity crate, 0, Rnd(360), 0
	EntityColor crate, 140, 105, 60
Next

; --- Textures --------------------------------------------------------------------------------------------------------
; A soft round glow for fire and sparks, as in tutorial 3.08, and a lumpy one for smoke: the same, but every pixel is
; made a little darker at random, so the smoke looks uneven.
Global glowTexture = MakeBlobTexture(0)
Global smokeTexture = MakeBlobTexture(0.5)

; --- Templates -------------------------------------------------------------------------------------------------------
; Every particle is a copy of one of these. Copies share the texture, so they are cheap.
Global fireTemplate = CreateSprite()
EntityTexture fireTemplate, glowTexture
EntityBlend fireTemplate, BB_BLEND_ADD ; Adds its light to what is behind it.
EntityFX fireTemplate, BB_FX_FULLBRIGHT + BB_FX_NO_FOG ; Full bright, and fog does not dim it.
HideEntity fireTemplate

Global smokeTemplate = CreateSprite()
EntityTexture smokeTemplate, smokeTexture
EntityBlend smokeTemplate, BB_BLEND_ALPHA ; Normal blending: smoke hides what is behind it.
EntityFX smokeTemplate, BB_FX_FULLBRIGHT
HideEntity smokeTemplate

; The shock wave: a flat ring, 1 unit across on the outside and 0.8 on the inside, made of 32 pieces.
Global ringTemplate = CreateMesh()
Local surface = CreateSurface(ringTemplate), angle#
For i = 0 To 32
	angle = i * 360.0 / 32
	AddVertex surface, Cos(angle), 0, Sin(angle)
	AddVertex surface, Cos(angle) * 0.8, 0, Sin(angle) * 0.8
	If i > 0
		AddTriangle surface, i * 2 - 2, i * 2, i * 2 - 1
		AddTriangle surface, i * 2 - 1, i * 2, i * 2 + 1
	EndIf
Next
EntityColor ringTemplate, 200, 180, 140
EntityFX ringTemplate, BB_FX_FULLBRIGHT + BB_FX_TWO_SIDED ; Full bright, and both sides are drawn.
HideEntity ringTemplate

; --- The parts of an explosion ---------------------------------------------------------------------------------------
Type Puff
	Field entity, kind
	Field vx#, vy#, vz#
	Field age#                     ; Goes from 0 to 1 over the puff's life.
	Field ageStep#                 ; How much age it gains per frame.
	Field size#
End Type

Type Ring
	Field entity
	Field age#
End Type

Type Debris
	Field entity
	Field vx#, vy#, vz#
	Field spinX#, spinY#
	Field life#
End Type

Global shake#
Local autoExplode = True, autoTimer = 30, x#, z#

While Not KeyHit(BB_KEY_ESCAPE)
	TurnEntity cameraPivot, 0, (KeyDown(BB_KEY_LEFT) - KeyDown(BB_KEY_RIGHT)) * 1.0, 0
	If KeyHit(BB_KEY_A) Then autoExplode = Not autoExplode

	If KeyHit(BB_KEY_SPACE) Or MouseHit(BB_MOUSE_LEFT)
		Explode(Rnd(-7, 7), Rnd(-4, 7))
	EndIf
	If autoExplode
		autoTimer = autoTimer - 1
		If autoTimer <= 0
			Explode(Rnd(-7, 7), Rnd(-4, 7))
			autoTimer = Rand(70, 140)
		EndIf
	EndIf

	UpdatePuffs()
	UpdateRings()
	UpdateDebris()

	; The flash fades quickly: each frame keeps 85% of the light of the frame before.
	flashPower = flashPower * 0.85
	LightColor flash, 255 * flashPower, 190 * flashPower, 90 * flashPower

	; Shake: move the shake pivot by a random amount that gets smaller every frame.
	shake = shake * 0.9
	PositionEntity shakePivot, Rnd(-1, 1) * shake * 0.4, Rnd(-1, 1) * shake * 0.4, 0

	RenderWorld
	Color 255, 255, 255
	Text 10, 10, "Space or a click: explosion. A: automatic explosions (" + OnOff$(autoExplode) + ")."
	Text 10, 30, "Left / Right turn the camera. Particles: " + CountPuffs()
	Flip
Wend
End

Function Explode(x#, z#)
	Local i, angle#, speed#

	; Flash and shake.
	PositionEntity flash, x, 1.5, z
	flashPower = 1
	shake = 1

	; The fire ball: puffs that start close together and drift out a little.
	For i = 1 To 30
		AddPuff(KIND_FIRE, x + Rnd(-0.4, 0.4), Rnd(0.3, 1.2), z + Rnd(-0.4, 0.4), Rnd(-0.08, 0.08), Rnd(0.02, 0.1), Rnd(-0.08, 0.08), Rnd(0.6, 1.1), Rnd(0.02, 0.035))
	Next

	; Sparks: small and fast, in every direction but mostly up.
	For i = 1 To 70
		angle = Rnd(360)
		speed = Rnd(0.1, 0.35)
		AddPuff(KIND_SPARK, x, 0.8, z, Cos(angle) * speed, Rnd(0.1, 0.45), Sin(angle) * speed, 0.12, Rnd(0.008, 0.02))
	Next

	; The shock wave.
	Local r.Ring = New Ring
	r\entity = CopyEntity(ringTemplate)
	ShowEntity r\entity
	PositionEntity r\entity, x, 0.05, z

	; Debris: small cubes thrown up and out.
	Local d.Debris
	For i = 1 To 10
		d = New Debris
		d\entity = CreateCube()
		ScaleEntity d\entity, Rnd(0.08, 0.2), Rnd(0.08, 0.2), Rnd(0.08, 0.2)
		EntityColor d\entity, 110, 80, 45
		PositionEntity d\entity, x, 0.5, z
		angle = Rnd(360)
		speed = Rnd(0.05, 0.2)
		d\vx = Cos(angle) * speed
		d\vz = Sin(angle) * speed
		d\vy = Rnd(0.2, 0.45)
		d\spinX = Rnd(-15, 15)
		d\spinY = Rnd(-15, 15)
		d\life = 4
	Next
End Function

Function AddPuff(kind, x#, y#, z#, vx#, vy#, vz#, size#, ageStep#)
	Local p.Puff = New Puff
	p\kind = kind
	If kind = KIND_SMOKE Then p\entity = CopyEntity(smokeTemplate) Else p\entity = CopyEntity(fireTemplate)
	ShowEntity p\entity ; The templates are hidden, the copies must not be.
	PositionEntity p\entity, x, y, z
	p\vx = vx
	p\vy = vy
	p\vz = vz
	p\size = size
	p\ageStep = ageStep
	If kind = KIND_SMOKE Then EntityColor p\entity, 70, 68, 66
	If kind = KIND_SPARK Then EntityColor p\entity, 255, 220, 120
End Function

Function UpdatePuffs()
	Local p.Puff, t#, s#
	For p = Each Puff
		p\age = p\age + p\ageStep
		t = p\age
		Select p\kind
			Case KIND_FIRE
				; Hot air rises, and the air slows the puff down.
				p\vx = p\vx * 0.92
				p\vz = p\vz * 0.92
				p\vy = p\vy * 0.92 + 0.004
				; The colour cools: white-yellow, then orange, then a dark red.
				If t < 0.3
					EntityColor p\entity, 255, Mix(240, 150, t / 0.3), Mix(170, 40, t / 0.3)
				Else
					EntityColor p\entity, Mix(255, 120, (t - 0.3) / 0.7), Mix(150, 30, (t - 0.3) / 0.7), Mix(40, 10, (t - 0.3) / 0.7)
				EndIf
				s = p\size * (0.6 + t * 2.5)
				; When the fire has cooled, it carries on as smoke.
				If t >= 1
					AddPuff(KIND_SMOKE, EntityX(p\entity), EntityY(p\entity), EntityZ(p\entity), p\vx, 0.02, p\vz, s, Rnd(0.004, 0.007))
				EndIf
			Case KIND_SMOKE
				; Smoke rises slowly, spreads out and thins away.
				p\vy = p\vy * 0.99
				s = p\size * (1 + t * 1.5)
				EntityAlpha p\entity, 0.7 * (1 - t)
			Case KIND_SPARK
				p\vy = p\vy - 0.012 ; Gravity.
				If EntityY(p\entity) < 0.1 And p\vy < 0
					p\vy = -p\vy * 0.4 ; Bounce, losing most of the speed.
				EndIf
				s = p\size * (1 - t * 0.5)
				EntityAlpha p\entity, 1 - t
		End Select

		If t >= 1
			FreeEntity p\entity
			Delete p
		Else
			TranslateEntity p\entity, p\vx, p\vy, p\vz
			ScaleSprite p\entity, s, s
		EndIf
	Next
End Function

Function UpdateRings()
	Local r.Ring, scale#
	For r = Each Ring
		r\age = r\age + 0.03
		If r\age >= 1
			FreeEntity r\entity
			Delete r
		Else
			; Fast at first, then slower: the square root of the age grows quickly and then levels off.
			scale = 9 * Sqr(r\age)
			ScaleEntity r\entity, scale, 1, scale
			EntityAlpha r\entity, 0.8 * (1 - r\age)
		EndIf
	Next
End Function

Function UpdateDebris()
	Local d.Debris
	For d = Each Debris
		d\vy = d\vy - 0.015
		TranslateEntity d\entity, d\vx, d\vy, d\vz
		TurnEntity d\entity, d\spinX, d\spinY, 0
		If EntityY(d\entity) < 0.1 And d\vy < 0
			; On the ground: bounce a little, slide and slow down.
			PositionEntity d\entity, EntityX(d\entity), 0.1, EntityZ(d\entity)
			d\vy = -d\vy * 0.3
			d\vx = d\vx * 0.7
			d\vz = d\vz * 0.7
			d\spinX = d\spinX * 0.6
			d\spinY = d\spinY * 0.6
		EndIf
		d\life = d\life - 1.0 / 60
		If d\life < 1 Then EntityAlpha d\entity, d\life ; Fade out in the last second.
		If d\life <= 0
			FreeEntity d\entity
			Delete d
		EndIf
	Next
End Function

; Goes from a to b while t goes from 0 to 1.
Function Mix#(a#, b#, t#)
	Return a + (b - a) * t
End Function

Function CountPuffs()
	Local p.Puff, count
	For p = Each Puff
		count = count + 1
	Next
	Return count
End Function

Function OnOff$(value)
	If value Then Return "on"
	Return "off"
End Function

; A white texture with a soft round edge. lumpy from 0 to 1 darkens random pixels, for smoke.
Function MakeBlobTexture(lumpy#)
	Local texture = CreateTexture(32, 32, BB_TEXTURE_COLOR + BB_TEXTURE_ALPHA), x, y, distance#, alpha#
	LockBuffer TextureBuffer(texture)
	For y = 0 To 31
		For x = 0 To 31
			distance = Sqr((x - 15.5) * (x - 15.5) + (y - 15.5) * (y - 15.5)) / 16
			alpha = 0
			If distance < 1 Then alpha = (1 - distance) * (1 - distance) * (1 - Rnd(lumpy))
			WritePixelFast x, y, (Int(alpha * 255) Shl 24) Or $FFFFFF, TextureBuffer(texture)
		Next
	Next
	UnlockBuffer TextureBuffer(texture)
	Return texture
End Function
