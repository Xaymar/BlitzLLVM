; Tutorial 4.05: Depth of Field
;
; A camera lens is only sharp at one distance; things far behind it look soft. Before shaders, games faked this by
; cutting the world into slices by distance and drawing the far slice at a low resolution:
;
;   1. Set the camera's range (CameraRange) so it only sees what is beyond the sharp distance, and draw that into a
;      small texture. Stretched over the screen later, the small picture looks blurred.
;   2. Put that texture on a sprite that fills the screen, standing just at the sharp distance.
;   3. Set the camera's range back to see only what is nearer, and draw the world. The near slice is sharp, and the
;      sprite behind it shows the blurred far slice.
;
; It is not as smooth as a real depth of field made with a shader, and objects that cross the sharp distance show a
; seam. But it is cheap and simple, and it found its way into well-known games of its time. More slices at different
; resolutions would make the change from sharp to soft gentler.
;
; New things here:
;   CameraRange to draw only the part of the world between two distances.
;   Drawing the same world twice per frame with different settings, through one camera.
;   A sprite that stands at an exact distance in front of the camera and fills the view there.
;
; Controls: Up / Down move the sharp distance, 1 to 3 choose how soft the far part is, D turns the effect on and off,
; Left / Right turn the camera.

Include "<keys.bb>"
Include "<graphics.bb>"
Include "<texture.bb>"
Include "<entity.bb>"

Graphics3D 640, 480, 0, BB_GRAPHICS_WINDOWED
AppTitle "Tutorial 4.05: Depth of Field"
SetBuffer BackBuffer()

Const NEAR_PLANE# = 0.5, FAR_PLANE# = 150.0

Local cameraPivot = CreatePivot()
Global camera = CreateCamera(cameraPivot)
PositionEntity camera, 0, 2, -4.0
RotateEntity camera, 8, 0, 0
CameraClsColor camera, 170, 190, 215
CameraRange camera, NEAR_PLANE, FAR_PLANE

Local light = CreateLight()
RotateEntity light, 45, 30, 0
AmbientLight 90, 90, 100

; --- The scene: a long checkered floor with rows of shapes going into the distance ----------------------------------
Local checker = CreateTexture(64, 64)
SetBuffer TextureBuffer(checker)
Local x, y
For y = 0 To 1
	For x = 0 To 1
		If (x + y) Mod 2 = 0 Then Color 230, 230, 220 Else Color 60, 70, 90
		Rect x * 32, y * 32, 32, 32, 1
	Next
Next
SetBuffer BackBuffer()
ScaleTexture checker, 4, 4

Local ground = CreatePlane()
EntityTexture ground, checker

Local i, shape
For i = 0 To 13
	If i Mod 2 = 0 Then shape = CreateSphere(16) Else shape = CreateCube()
	PositionEntity shape, -2.5 + (i Mod 2) * 5, 1, i * 4.0 + 2
	EntityColor shape, Float(120 + i * 9), Float(200 - i * 10), Float(90 + (i Mod 3) * 60)
	shape = CreateCylinder(12)
	ScaleEntity shape, 0.3, 2.5, 0.3
	PositionEntity shape, 2.5 - (i Mod 2) * 5, 2.5, i * 4.0 + 4
	EntityColor shape, 200, 190, 170
Next

; --- The far slice ---------------------------------------------------------------------------------------------------
Dim farTexture(2), farWidth(2), farHeight(2)
farWidth(0) = 320 : farHeight(0) = 240
farWidth(1) = 160 : farHeight(1) = 120
farWidth(2) = 80 : farHeight(2) = 60
For i = 0 To 2
	farTexture(i) = CreateTexture(farWidth(i), farHeight(i), BB_TEXTURE_COLOR + BB_TEXTURE_CLAMP_U + BB_TEXTURE_CLAMP_V + BB_TEXTURE_VRAM + BB_TEXTURE_RENDER_TARGET)
Next

; The backdrop: a sprite on the camera that shows the far slice. Where it stands is set every frame, because it
; must stand at the sharp distance, and its size must fill the view there.
Global backdrop = CreateSprite(camera)
EntityFX backdrop, BB_FX_FULLBRIGHT + BB_FX_NO_FOG

Local sharpDistance# = 10, softness = 1, effectOn = True, d#

While Not KeyHit(BB_KEY_ESCAPE)
	TurnEntity cameraPivot, 0, (KeyDown(BB_KEY_LEFT) - KeyDown(BB_KEY_RIGHT)) * 0.8, 0
	If KeyDown(BB_KEY_UP) Then sharpDistance = sharpDistance * 1.02
	If KeyDown(BB_KEY_DOWN) Then sharpDistance = sharpDistance / 1.02
	If sharpDistance < 3 Then sharpDistance = 3
	If sharpDistance > 50 Then sharpDistance = 50
	If KeyHit(BB_KEY_D) Then effectOn = Not effectOn
	For i = 0 To 2
		If KeyHit(BB_KEY_1 + i) Then softness = i
	Next

	If effectOn
		; Step 1: only what lies beyond the sharp distance, into the small texture. The backdrop must not be in it.
		HideEntity backdrop
		CameraRange camera, sharpDistance, FAR_PLANE
		CameraViewport camera, 0, 0, farWidth(softness), farHeight(softness)
		SetBuffer TextureBuffer(farTexture(softness))
		RenderWorld
		SetBuffer BackBuffer()
		CameraViewport camera, 0, 0, GraphicsWidth(), GraphicsHeight()

		; Step 2: the backdrop, just in front of the sharp distance so the camera's range does not cut it away. With
		; a zoom of 1 the view is as wide to each side as it is far away, and 480 / 640 of that up and down.
		d = sharpDistance * 0.99
		ShowEntity backdrop
		EntityTexture backdrop, farTexture(softness)
		PositionEntity backdrop, 0, 0, d
		ScaleSprite backdrop, d, d * 0.75

		; Step 3: only the near slice, drawn sharp in front of the backdrop.
		CameraRange camera, NEAR_PLANE, sharpDistance
	Else
		HideEntity backdrop
		CameraRange camera, NEAR_PLANE, FAR_PLANE
	EndIf
	RenderWorld

	Color 0, 0, 0
	Text 10, 10, "Up / Down: sharp up to " + Int(sharpDistance) + " units. 1 to 3: far part drawn at " + farWidth(softness) + " x " + farHeight(softness) + "."
	Text 10, 30, "D: depth of field " + OnOff$(effectOn) + ". Left / Right turn the camera."
	Flip
Wend
End

Function OnOff$(value)
	If value Then Return "on"
	Return "off"
End Function
