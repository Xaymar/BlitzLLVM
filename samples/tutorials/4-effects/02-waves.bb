; Tutorial 4.02: Waves
;
; Water here is a flat grid of triangles whose corners move up and down every frame. A few sine waves that run in
; different directions, added together, give a calm swell. A ring that spreads out from a point gives the ripple
; of a stone dropped into the water. After moving the corners, UpdateNormals works out which way each part of the
; surface now faces, so the light shades the waves.
;
; New things here:
;   A grid mesh made with AddVertex and AddTriangle (see tutorial 3.03), changed every frame with VertexCoords.
;   UpdateNormals, so the lighting follows the moving surface.
;   One height function used twice: for the water and for the buoys, so the buoys ride on the waves.
;   EntityShininess for a glossy highlight.
;   Picking an invisible flat helper mesh to find where the mouse points on the water.
;
; Controls: click the water to drop a stone, Up / Down change the wind (how high the swell is), Left / Right turn the
; camera.

Graphics3D 640, 480, 0, 2
AppTitle "Tutorial 4.02: Waves"
SetBuffer BackBuffer()
SeedRnd MilliSecs()

Const GRID = 64       ; Corners along each side of the water.
Const SIZE# = 40.0    ; Width of the water in units.

Local cameraPivot = CreatePivot()
Global camera = CreateCamera(cameraPivot)
PositionEntity camera, 0, 5, -14.0
RotateEntity camera, 18, 0, 0
CameraClsColor camera, 150, 190, 220
CameraFogMode camera, 1
CameraFogRange camera, 10, 24
CameraFogColor camera, 150, 190, 220

Local sun = CreateLight()
RotateEntity sun, 20, -60, 0
AmbientLight 35, 45, 60

; --- The water mesh --------------------------------------------------------------------------------------------------
; GRID x GRID corners, two triangles for every square between them. The corners' x and z never change, so they are
; kept in arrays; only the height is worked out again every frame.
Global water = CreateMesh()
Global waterSurface = CreateSurface(water)
Dim cornerX#(GRID * GRID - 1), cornerZ#(GRID * GRID - 1)
Local x, z, i
For z = 0 To GRID - 1
	For x = 0 To GRID - 1
		i = z * GRID + x
		cornerX(i) = (Float(x) / (GRID - 1) - 0.5) * SIZE
		cornerZ(i) = (Float(z) / (GRID - 1) - 0.5) * SIZE
		AddVertex waterSurface, cornerX(i), 0, cornerZ(i)
	Next
Next
For z = 0 To GRID - 2
	For x = 0 To GRID - 2
		i = z * GRID + x
		AddTriangle waterSurface, i, i + GRID, i + 1
		AddTriangle waterSurface, i + 1, i + GRID, i + GRID + 1
	Next
Next
EntityColor water, 30, 95, 140
EntityShininess water, 0.9

; A flat, invisible copy of the water for picking. Picking the moving mesh would also work, but the flat one is
; simpler: the stone lands where the mouse points on the calm surface.
Local pickPlane = CreateCube()
ScaleEntity pickPlane, SIZE / 2, 0.01, SIZE / 2
EntityAlpha pickPlane, 0
EntityPickMode pickPlane, 2

; --- Buoys -----------------------------------------------------------------------------------------------------------
Type Buoy
	Field entity
	Field x#, z#
End Type

Local b.Buoy, top
For i = 1 To 5
	b = New Buoy
	b\x = Rnd(-8, 8)
	b\z = Rnd(-6, 8)
	b\entity = CreateCylinder(12)
	ScaleEntity b\entity, 0.3, 0.5, 0.3
	EntityColor b\entity, 230, 60, 40
	top = CreateSphere(8, b\entity)
	PositionEntity top, 0, 1.2, 0
	ScaleEntity top, 0.7, 0.4, 0.7
	EntityColor top, 240, 240, 240
Next

; --- Ripples ---------------------------------------------------------------------------------------------------------
Type Ripple
	Field x#, z#
	Field age#   ; Seconds since the stone landed.
End Type

Global time#, wind# = 0.35

Local r.Ripple, h#, ahead#, slope#, ripples
While Not KeyHit(1)
	time = time + 1.0 / 60
	TurnEntity cameraPivot, 0, (KeyDown(203) - KeyDown(205)) * 1.0, 0
	If KeyDown(200) Then wind = wind + 0.005
	If KeyDown(208) Then wind = wind - 0.005
	If wind < 0 Then wind = 0
	If wind > 1 Then wind = 1

	; A click on the water drops a stone where the mouse points.
	If MouseHit(1)
		If CameraPick(camera, Float(MouseX()), Float(MouseY())) = pickPlane
			r = New Ripple
			r\x = PickedX()
			r\z = PickedZ()
		EndIf
	EndIf
	ripples = 0
	For r = Each Ripple
		r\age = r\age + 1.0 / 60
		If r\age > 6 Then Delete r Else ripples = ripples + 1
	Next

	; Move every corner to the height of the water at its place, then let UpdateNormals fix the lighting.
	For i = 0 To GRID * GRID - 1
		VertexCoords waterSurface, i, cornerX(i), WaterHeight(cornerX(i), cornerZ(i)), cornerZ(i)
	Next
	UpdateNormals water

	; The buoys sit at the height of the water and lean with its slope: compare the height a little to the front
	; and to the side of the buoy with the height under it.
	For b = Each Buoy
		h = WaterHeight(b\x, b\z)
		ahead = WaterHeight(b\x, b\z + 0.5)
		slope = WaterHeight(b\x + 0.5, b\z)
		PositionEntity b\entity, b\x, h, b\z
		RotateEntity b\entity, ATan2(ahead - h, 0.5) * -1, 0, ATan2(slope - h, 0.5)
	Next

	RenderWorld
	Color 20, 40, 60
	Text 10, 10, "Click the water to drop a stone. Up / Down: wind " + Int(wind * 100) + "%."
	Text 10, 30, "Left / Right turn the camera. Ripples: " + ripples
	Flip
Wend
End

; The height of the water at (x, z). Everything moving on the water asks this function, so it all agrees.
Function WaterHeight#(x#, z#)
	; The swell: three sine waves with different lengths, speeds and directions. Sin works in degrees in Blitz,
	; so x * 25 means one full wave every 360 / 25 = 14.4 units.
	Local h# = Sin(x * 25 + time * 60) * 0.5
	h = h + Sin(z * 35 + x * 10 + time * 90) * 0.3
	h = h + Sin((x - z) * 50 + time * 140) * 0.12
	h = h * wind

	; Ripples: a ring that moves out at 4 units a second. Only the water the ring has already reached moves, and the
	; ripple gets weaker with time and with distance.
	Local r.Ripple, dx#, dz#, distance#, front#
	For r = Each Ripple
		dx = x - r\x
		dz = z - r\z
		distance = Sqr(dx * dx + dz * dz)
		front = r\age * 4
		If distance < front
			h = h + Sin((distance - front) * 120) * 0.9 * (1 - r\age / 6) / (1 + distance * 0.3)
		EndIf
	Next
	Return h
End Function
