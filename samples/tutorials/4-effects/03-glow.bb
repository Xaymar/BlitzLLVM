; Tutorial 4.03: Glow
;
; Bright lights in a photo bleed into the dark around them. Games copy this with a "glow" or "bloom" effect, and it
; is made from things the earlier tutorials already showed:
;
;   1. Draw the world into a small texture, with everything that should not glow turned black.
;   2. Draw the world normally.
;   3. Lay the small texture over the whole screen, adding its light (EntityBlend 3). Because the texture is small,
;      it is stretched, and stretching blurs it: the bright parts spread out around their edges.
;
; Laying it over a few times, each copy moved a little, softens the blur further.
;
; Real bloom blurs the picture with a shader, which looks smoother and costs less. This version needs nothing but
; render to texture, which is why it makes a good first step.
;
; New things here:
;   RenderWorld into a texture: CreateTexture with the flag BB_TEXTURE_RENDER_TARGET, SetBuffer TextureBuffer,
;   and a camera viewport the size of the texture.
;   A full-screen sprite in front of the camera to lay a texture over the picture.
;   EntityOrder, so the overlay is drawn after everything else and ignores the depth buffer.
;   Changing how a whole scene looks for one RenderWorld and changing it back.
;
; Controls: G turns the glow on and off, Up / Down change how strong it is, 1 to 3 choose the size of the glow
; texture, Left / Right turn the camera.

Include "<keys.bb>"
Include "<graphics.bb>"
Include "<texture.bb>"
Include "<entity.bb>"

Graphics3D 640, 480, 0, BB_GRAPHICS_WINDOWED
AppTitle "Tutorial 4.03: Glow"
SetBuffer BackBuffer()

Const OVERLAY_DISTANCE# = 1.5 ; How far in front of the camera the overlay sprites float.

Local cameraPivot = CreatePivot()
Global camera = CreateCamera(cameraPivot)
PositionEntity camera, 0, 4, -13.0
RotateEntity camera, 12, 0, 0
CameraClsColor camera, 10, 12, 22

Local light = CreateLight()
RotateEntity light, 50, 30, 0
AmbientLight 50, 50, 70

; --- The scene -------------------------------------------------------------------------------------------------------
; Two kinds of things: dark ones that are lit normally, and bright ones that glow. The dark ones are kept in a list,
; so the glow pass can turn them black and back.
Type Dark
	Field entity
	Field red, green, blue
End Type

Local ground = CreatePlane()
AddDark(ground, 40, 42, 55)

Local i, pillar
For i = 0 To 7
	pillar = CreateCube()
	ScaleEntity pillar, 0.5, 2.5, 0.5
	PositionEntity pillar, Cos(Float(i * 45)) * 6, 2.5, Sin(Float(i * 45)) * 6
	AddDark(pillar, 120, 120, 130)
Next

; The glowing things: full-bright (EntityFX BB_FX_FULLBRIGHT), so the light in the scene does not change their colour.
Dim orb(5)
For i = 0 To 5
	orb(i) = CreateSphere(12)
	ScaleEntity orb(i), 0.5, 0.5, 0.5
	EntityFX orb(i), BB_FX_FULLBRIGHT
Next
EntityColor orb(0), 255, 60, 60
EntityColor orb(1), 60, 255, 90
EntityColor orb(2), 80, 120, 255
EntityColor orb(3), 255, 220, 60
EntityColor orb(4), 255, 80, 255
EntityColor orb(5), 60, 230, 255

; A ring of neon light on the ground.
Local neon = CreateMesh(), surface = CreateSurface(neon), angle#
For i = 0 To 64
	angle = i * 360.0 / 64
	AddVertex surface, Cos(angle) * 3.2, 0.02, Sin(angle) * 3.2
	AddVertex surface, Cos(angle) * 3.0, 0.02, Sin(angle) * 3.0
	If i > 0
		AddTriangle surface, i * 2 - 2, i * 2 - 1, i * 2
		AddTriangle surface, i * 2 - 1, i * 2 + 1, i * 2
	EndIf
Next
EntityColor neon, 255, 140, 40
EntityFX neon, BB_FX_FULLBRIGHT + BB_FX_TWO_SIDED

; --- The glow textures -----------------------------------------------------------------------------------------------
; Flag 4096 makes a texture that RenderWorld can draw into. 16 and 32 stop the edges from wrapping around when the
; texture is stretched. Three sizes: the smaller, the wider and softer the glow.
Dim glowTexture(2), glowWidth(2), glowHeight(2)
glowWidth(0) = 320 : glowHeight(0) = 240
glowWidth(1) = 160 : glowHeight(1) = 120
glowWidth(2) = 80 : glowHeight(2) = 60
For i = 0 To 2
	glowTexture(i) = CreateTexture(glowWidth(i), glowHeight(i), BB_TEXTURE_COLOR + BB_TEXTURE_CLAMP_U + BB_TEXTURE_CLAMP_V + BB_TEXTURE_VRAM + BB_TEXTURE_RENDER_TARGET)
Next

; --- The overlay -----------------------------------------------------------------------------------------------------
; Sprites stuck to the camera, just big enough to cover the screen. With the camera's normal zoom of 1, the screen
; is OVERLAY_DISTANCE wide to each side at that distance, and three quarters of that up and down (480 / 640).
; Each copy is moved a little to one side, which blurs the glow more.
Const OVERLAYS = 4
Dim overlay(OVERLAYS - 1)
Local offsetX#, offsetY#
For i = 0 To OVERLAYS - 1
	overlay(i) = CreateSprite(camera)
	offsetX = Cos(Float(i * 90 + 45)) * 0.02 * OVERLAY_DISTANCE
	offsetY = Sin(Float(i * 90 + 45)) * 0.02 * OVERLAY_DISTANCE
	PositionEntity overlay(i), offsetX, offsetY, OVERLAY_DISTANCE
	ScaleSprite overlay(i), OVERLAY_DISTANCE, OVERLAY_DISTANCE * 0.75
	EntityBlend overlay(i), BB_BLEND_ADD                 ; Add its light.
	EntityFX overlay(i), BB_FX_FULLBRIGHT + BB_FX_NO_FOG ; Full bright, no fog.
	EntityOrder overlay(i), -1                           ; Drawn after everything else, in front of it all.
Next

Local glowOn = True, strength# = 0.6, size = 1, t#
UseGlowTexture(size)

While Not KeyHit(BB_KEY_ESCAPE)
	TurnEntity cameraPivot, 0, (KeyDown(BB_KEY_LEFT) - KeyDown(BB_KEY_RIGHT)) * 1.0, 0
	If KeyHit(BB_KEY_G) Then glowOn = Not glowOn
	If KeyDown(BB_KEY_UP) Then strength = strength + 0.01
	If KeyDown(BB_KEY_DOWN) Then strength = strength - 0.01
	If strength < 0.1 Then strength = 0.1
	If strength > 1 Then strength = 1
	For i = 0 To 2
		If KeyHit(BB_KEY_1 + i)
			size = i
			UseGlowTexture(size)
		EndIf
	Next

	; The orbs circle and bob between the pillars.
	t = MilliSecs() / 1000.0
	For i = 0 To 5
		PositionEntity orb(i), Cos(t * 40 + i * 60) * 4.5, 1.2 + Sin(t * 90 + i * 50) * 0.6, Sin(t * 40 + i * 60) * 4.5
	Next

	If glowOn
		; Step 1: the glow pass. Turn the dark things black, clear to black, hide the overlays, and draw into the
		; small texture. The camera viewport must match the texture.
		SetDarkBlack(True)
		CameraClsColor camera, 0, 0, 0
		For i = 0 To OVERLAYS - 1
			HideEntity overlay(i)
		Next
		CameraViewport camera, 0, 0, glowWidth(size), glowHeight(size)
		SetBuffer TextureBuffer(glowTexture(size))
		RenderWorld

		; Put everything back the way it was.
		SetBuffer BackBuffer()
		CameraViewport camera, 0, 0, GraphicsWidth(), GraphicsHeight()
		CameraClsColor camera, 10, 12, 22
		SetDarkBlack(False)
		For i = 0 To OVERLAYS - 1
			ShowEntity overlay(i)
			EntityAlpha overlay(i), strength
		Next
	Else
		For i = 0 To OVERLAYS - 1
			HideEntity overlay(i)
		Next
	EndIf

	; Step 2 and 3: the normal picture, with the overlays on top.
	RenderWorld

	Color 255, 255, 255
	Text 10, 10, "G: glow " + OnOff$(glowOn) + ". Up / Down: strength " + Int(strength * 100) + "%."
	Text 10, 30, "1 to 3: glow texture " + glowWidth(size) + " x " + glowHeight(size) + ". Left / Right turn the camera."
	Flip
Wend
End

Function AddDark(entity, red, green, blue)
	Local d.Dark = New Dark
	d\entity = entity
	d\red = red
	d\green = green
	d\blue = blue
	EntityColor entity, Float(red), Float(green), Float(blue)
End Function

; Black and full-bright makes a thing pure black, whatever the lights do. It still hides the glowing things behind
; it, which is what we want: a pillar in front of an orb blocks its glow too.
Function SetDarkBlack(black)
	Local d.Dark
	For d = Each Dark
		If black
			EntityColor d\entity, 0, 0, 0
			EntityFX d\entity, BB_FX_FULLBRIGHT
		Else
			EntityColor d\entity, Float(d\red), Float(d\green), Float(d\blue)
			EntityFX d\entity, 0
		EndIf
	Next
End Function

Function UseGlowTexture(size)
	Local i
	For i = 0 To OVERLAYS - 1
		EntityTexture overlay(i), glowTexture(size)
	Next
End Function

Function OnOff$(value)
	If value Then Return "on"
	Return "off"
End Function
