; Tutorial 4.04: Rays of Light
;
; When the sun shines through trees, dust in the air catches the light and you see beams fanning out from the sun,
; often called god rays. The trick here is the same as the glow of tutorial 4.03, with one change:
;
;   1. Draw the world into a small texture: the sun bright, everything else black. Trees in front of the sun cut
;      holes into its light.
;   2. Draw the world normally.
;   3. Lay that texture over the screen many times, each copy a little bigger than the one before, all grown out
;      from the point where the sun is on the screen. Each copy adds a fainter layer of light.
;
; The growing copies smear the sun's light outwards along lines that start at the sun, and the gaps between the trees
; become beams. CameraProject tells where on the screen the sun is.
;
; New things here:
;   CameraProject and ProjectedX / ProjectedY to find a 3D point on the screen.
;   EntityInView to switch the rays off when the sun is not on the screen.
;   Scaling sprites around a point other than their middle: move them by the right amount at the same time.
;
; Controls: R turns the rays on and off, Up / Down change how strong they are, Left / Right turn the camera, Space
; stops and starts the swaying of the camera.

Include "<keys.bb>"
Include "<graphics.bb>"
Include "<texture.bb>"
Include "<entity.bb>"

Graphics3D 640, 480, 0, BB_GRAPHICS_WINDOWED
AppTitle "Tutorial 4.04: Rays of Light"
SetBuffer BackBuffer()
SeedRnd 7 ; Always the same forest.

Const OVERLAY_DISTANCE# = 1.5
Const RAY_LAYERS = 16
Const RAY_W = 160, RAY_H = 120

Local cameraPivot = CreatePivot()
Global camera = CreateCamera(cameraPivot)
PositionEntity camera, 0, 2.5, 0
RotateEntity camera, -12, 0, 0
CameraClsColor camera, 80, 75, 105
CameraFogMode camera, 1
CameraFogRange camera, 10, 70
CameraFogColor camera, 80, 75, 105

Local light = CreateLight()
RotateEntity light, 20, 0, 0
LightColor light, 255, 220, 170
AmbientLight 60, 70, 90

; --- The scene -------------------------------------------------------------------------------------------------------
Type Dark
	Field entity
	Field red, green, blue
End Type

Local ground = CreatePlane()
AddDark(ground, 60, 80, 50)

; Trees: a trunk and a round crown, scattered in front of the sun.
Local i, trunk, crown, x#, z#
For i = 1 To 40
	x = Rnd(-25, 25)
	z = Rnd(8, 45)
	trunk = CreateCylinder(8)
	ScaleEntity trunk, 0.25, 3, 0.25
	PositionEntity trunk, x, 3, z
	AddDark(trunk, 90, 70, 50)
	crown = CreateSphere(8)
	ScaleEntity crown, Rnd(1.2, 2.2), Rnd(1.2, 1.8), Rnd(1.2, 2.2)
	PositionEntity crown, x, Rnd(5.5, 7), z
	AddDark(crown, 50, 90, 45)
Next

; The sun: a big glowing sprite far away, low over the trees.
Local glow = CreateTexture(64, 64, BB_TEXTURE_COLOR + BB_TEXTURE_ALPHA), px, py, distance#, alpha#
LockBuffer TextureBuffer(glow)
For py = 0 To 63
	For px = 0 To 63
		distance = Sqr((px - 31.5) * (px - 31.5) + (py - 31.5) * (py - 31.5)) / 32
		alpha = 0
		If distance < 1 Then alpha = (1 - distance) ^ 1.5
		WritePixelFast px, py, (Int(alpha * 255) Shl 24) Or $FFFFFF, TextureBuffer(glow)
	Next
Next
UnlockBuffer TextureBuffer(glow)

Global sun = CreateSprite()
EntityTexture sun, glow
ScaleSprite sun, 16, 16
PositionEntity sun, 0, 16, 80
EntityColor sun, 255, 235, 190
EntityFX sun, BB_FX_FULLBRIGHT + BB_FX_NO_FOG ; Full bright and no fog, so the sun is never dimmed.
EntityBlend sun, BB_BLEND_ADD

; --- Ray texture and overlays ----------------------------------------------------------------------------------------
Global rayTexture = CreateTexture(RAY_W, RAY_H, BB_TEXTURE_COLOR + BB_TEXTURE_CLAMP_U + BB_TEXTURE_CLAMP_V + BB_TEXTURE_VRAM + BB_TEXTURE_RENDER_TARGET)
Dim overlay(RAY_LAYERS - 1)
For i = 0 To RAY_LAYERS - 1
	overlay(i) = CreateSprite(camera)
	EntityTexture overlay(i), rayTexture
	EntityBlend overlay(i), BB_BLEND_ADD
	EntityFX overlay(i), BB_FX_FULLBRIGHT + BB_FX_NO_FOG
	EntityOrder overlay(i), -1
Next

Local raysOn = True, strength# = 0.7, sway = True, swayTime#
Local sunX#, sunY#, scale#, visible

While Not KeyHit(BB_KEY_ESCAPE)
	If KeyHit(BB_KEY_R) Then raysOn = Not raysOn
	If KeyHit(BB_KEY_SPACE) Then sway = Not sway
	If KeyDown(BB_KEY_UP) Then strength = strength + 0.01
	If KeyDown(BB_KEY_DOWN) Then strength = strength - 0.01
	If strength < 0.1 Then strength = 0.1
	If strength > 1 Then strength = 1
	If sway Then swayTime = swayTime + 1.0 / 60
	RotateEntity cameraPivot, 0, Sin(swayTime * 15) * 25, 0
	TurnEntity camera, 0, (KeyDown(BB_KEY_LEFT) - KeyDown(BB_KEY_RIGHT)) * 1.0, 0

	visible = raysOn And EntityInView(sun, camera)
	If visible
		; Step 1: the sun alone, everything else black, into the small texture.
		SetDarkBlack(True)
		CameraClsColor camera, 0, 0, 0
		CameraFogMode camera, 0
		For i = 0 To RAY_LAYERS - 1
			HideEntity overlay(i)
		Next
		CameraViewport camera, 0, 0, RAY_W, RAY_H
		SetBuffer TextureBuffer(rayTexture)
		RenderWorld
		SetBuffer BackBuffer()
		CameraViewport camera, 0, 0, GraphicsWidth(), GraphicsHeight()
		CameraFogMode camera, 1
		CameraClsColor camera, 80, 75, 105
		SetDarkBlack(False)

		; Where is the sun on the screen? CameraProject answers in pixels. Turn that into a place on the overlay's
		; plane, which reaches from -OVERLAY_DISTANCE to +OVERLAY_DISTANCE across, and 0.75 of that up and down.
		CameraProject camera, EntityX(sun, True), EntityY(sun, True), EntityZ(sun, True)
		sunX = (ProjectedX() / (GraphicsWidth() / 2) - 1) * OVERLAY_DISTANCE
		sunY = (1 - ProjectedY() / (GraphicsHeight() / 2)) * OVERLAY_DISTANCE * 0.75

		; Step 3: the layers. A sprite scaled by "scale" around its middle moves the sun's spot away from the sun;
		; moving the sprite by sun * (1 - scale) brings it back, so every layer grows out from the sun.
		For i = 0 To RAY_LAYERS - 1
			scale = 1 + i * 0.07
			ShowEntity overlay(i)
			PositionEntity overlay(i), sunX * (1 - scale), sunY * (1 - scale), OVERLAY_DISTANCE
			ScaleSprite overlay(i), OVERLAY_DISTANCE * scale, OVERLAY_DISTANCE * 0.75 * scale
			EntityAlpha overlay(i), strength * (1 - Float(i) / RAY_LAYERS) * 0.5 ; The bigger, the fainter.
		Next
	Else
		For i = 0 To RAY_LAYERS - 1
			HideEntity overlay(i)
		Next
	EndIf

	; Step 2, with the layers on top.
	RenderWorld

	Color 255, 255, 255
	Text 10, 10, "R: rays " + OnOff$(raysOn) + ". Up / Down: strength " + Int(strength * 100) + "%."
	Text 10, 30, "Left / Right turn the camera, Space: swaying " + OnOff$(sway) + "."
	If raysOn And (Not visible) Then Text 10, 50, "The sun is not on the screen, so there are no rays."
	Flip
Wend
End

Function AddDark(entity, red, green, blue)
	Local d.Dark = New Dark
	d\entity = entity
	d\red = red
	d\green = green
	d\blue = blue
	EntityColor entity, Float(red), Float(green), Float(blue)
End Function

Function SetDarkBlack(black)
	Local d.Dark
	For d = Each Dark
		If black
			EntityColor d\entity, 0, 0, 0
			EntityFX d\entity, BB_FX_FULLBRIGHT
		Else
			EntityColor d\entity, Float(d\red), Float(d\green), Float(d\blue)
			EntityFX d\entity, 0
		EndIf
	Next
End Function

Function OnOff$(value)
	If value Then Return "on"
	Return "off"
End Function
