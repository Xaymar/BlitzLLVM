; Tutorial 1.09: Maths and Randomness
;
; Games use a handful of maths functions all the time: distances, angles, rounding and random numbers.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Graphics 800, 600, 0, 2 ; A bigger window, so that everything printed fits.

; --- Rounding and signs -------------------------------------------------------------------------------------------
Print "Abs(-7)       = " + Abs(-7)       ; Drops the minus sign.
Print "Sgn(-7)       = " + Sgn(-7)       ; -1, 0 or 1, depending on the sign.
Print "Floor(2.7)    = " + Floor(2.7)    ; Rounds down.
Print "Ceil(2.1)     = " + Ceil(2.1)     ; Rounds up.
Print "Int(2.7)      = " + Int(2.7)      ; Rounds to the nearest whole number.
Print "Sqr(16)       = " + Sqr(16)       ; Square root.
Print "Smaller(3, 9) = " + Smaller(3, 9) ; There is no Min or Max built in, but they are short functions.

; --- Distances ------------------------------------------------------------------------------------------------
; The distance between two points comes from Pythagoras: the square root of dx^2 + dy^2.
Local x1# = 1, y1# = 2
Local x2# = 4, y2# = 6
Print
Print "The distance from (1, 2) to (4, 6) is " + Distance(x1, y1, x2, y2)

; --- Angles ----------------------------------------------------------------------------------------------------
; Blitz measures angles in degrees: a full circle is 360. Sin and Cos turn an angle into a direction, which is
; how you move something "forward" at an angle.
Print
Local angle, dx#, dy#
For angle = 0 To 270 Step 90
	dx = Cos(Float(angle)) ; Float() because Cos takes a float and angle is an integer.
	dy = Sin(Float(angle))
	Print "Angle " + RSet$(angle, 3) + ": move x by " + RSet$(Int(dx), 2) + " and y by " + RSet$(Int(dy), 2)
Next

; ATan2 goes the other way: from a direction back to its angle. This is how a turret aims at a target.
Print "Aiming from (0, 0) at (5, 5) needs an angle of " + ATan2(5, 5) + " degrees."

; --- Random numbers --------------------------------------------------------------------------------------------
; Rand(low, high) gives a random whole number from low to high, both included. Rnd(low, high) gives a random float.
; SeedRnd picks where the random sequence starts. The same seed always gives the same numbers, which is handy for
; testing and for levels that must look the same every time. MilliSecs() gives a different seed every run.
Print
Local i
SeedRnd 1234
Write "With seed 1234:   "
For i = 1 To 8
	Write Rand(1, 6) + " "
Next
Print

SeedRnd 1234
Write "Seed 1234 again:  "
For i = 1 To 8
	Write Rand(1, 6) + " "
Next
Print

SeedRnd MilliSecs()
Write "Seeded by time:   "
For i = 1 To 8
	Write Rand(1, 6) + " "
Next
Print

; A random float, for example a random speed.
Print "A random speed between 0.5 and 2.0: " + Rnd(0.5, 2.0)

; Picking something with a chance: here 1 in 4.
Local hits = 0
For i = 1 To 1000
	If Rand(1, 4) = 1 Then hits = hits + 1
Next
Print "A 1-in-4 chance came up " + hits + " times out of 1000."

; --- Integer tricks ------------------------------------------------------------------------------------------------
; Mod wraps a value around, which keeps a counter inside a range.
Print
Write "Wrapping 0 to 11 into 0 to 3: "
For i = 0 To 11
	Write (i Mod 4) + " "
Next
Print

; Shl and Shr shift the bits of a number, which multiplies or divides by powers of two. And, Or and Xor work on
; the bits too, so one integer can store several on/off flags.
Const FLAG_FAST = 1, FLAG_SHIELD = 2, FLAG_INVISIBLE = 4
Local flags = FLAG_FAST Or FLAG_INVISIBLE
Print "1 Shl 4 = " + (1 Shl 4) + ", 64 Shr 2 = " + (64 Shr 2)
Print "Fast: " + ((flags And FLAG_FAST) <> 0) + ", shield: " + ((flags And FLAG_SHIELD) <> 0) + ", invisible: " + ((flags And FLAG_INVISIBLE) <> 0)

Print
Print "Press any key to quit."
WaitKey
End

Function Smaller(a, b)
	If a < b Then Return a Else Return b
End Function

Function Distance#(x1#, y1#, x2#, y2#)
	Return Sqr((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1))
End Function
