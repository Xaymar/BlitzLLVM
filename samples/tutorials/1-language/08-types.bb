; Tutorial 1.08: Types
;
; A Type groups several values that belong together into one thing, like the position, speed and health of an
; enemy. Every "New" makes another object of that Type, and Blitz keeps all objects of a Type in a list, so you
; can make and remove as many as the game needs.

Include "<graphics.bb>"

Graphics 800, 600, 0, BB_GRAPHICS_WINDOWED ; A bigger window, so that everything printed fits.

; A Type lists its Fields. Fields use the same suffixes as variables.
Type Monster
	Field name$
	Field health
	Field x#, y#
End Type

; New makes a new object and adds it to the end of the Type's list. The variable after the dot holds it.
; The ".Monster" suffix says which Type the variable holds, just like # says a variable holds a float.
Local m.Monster = New Monster
m\name$ = "Goblin"   ; A backslash reaches a field of the object.
m\health = 30
m\x = 4 : m\y = 2    ; A colon puts two statements on one line.

; Using a function to make objects keeps the setup in one place.
SpawnMonster("Troll", 80, 10, 5)
SpawnMonster("Bat", 10, 1, 9)
SpawnMonster("Slime", 20, 7, 7)

Print "The monsters:"
ListMonsters()

; --- Changing every object -------------------------------------------------------------------------------------
; For ... Each visits every object of a Type, from the first to the last.
Print
Print "A fireball hits everything for 25 damage!"
For m.Monster = Each Monster
	m\health = m\health - 25
Next

; Delete removes an object. Deleting the object you are standing on inside For ... Each is fine: the loop already
; knows which one comes next.
For m.Monster = Each Monster
	If m\health <= 0
		Print "  The " + m\name$ + " is defeated."
		Delete m
	EndIf
Next

Print
Print "Still standing:"
ListMonsters()

; --- Objects in functions ---------------------------------------------------------------------------------------
; Functions can take and return objects. Null means "no object".
Local nearest.Monster = NearestMonster(0, 0)
If nearest <> Null
	Print
	Print "The monster nearest to (0, 0) is the " + nearest\name$ + "."
EndIf

; --- Moving through the list ------------------------------------------------------------------------------------
; First and Last give the ends of the list, After and Before the neighbours of an object.
Print
Local head.Monster = First Monster
Local tail.Monster = Last Monster
Print "First in the list: " + head\name$
Print "Last in the list:  " + tail\name$
Local second.Monster = After head
Print "Second in the list: " + second\name$

; Insert moves an object to another place in the list.
Insert head After tail
Print "After moving the first one to the end:"
ListMonsters()

; --- Types inside Types -----------------------------------------------------------------------------------------
; A field can hold an object of another Type, and a Type can hold a fixed-size array (tutorial 1.06).
Type Party
	Field leader.Monster
	Field loot[3]
End Type

Local p.Party = New Party
p\leader = First Monster
p\loot[0] = 100 : p\loot[1] = 50 : p\loot[2] = 5
Print
Print "The party is led by the " + p\leader\name$ + " and carries " + (p\loot[0] + p\loot[1] + p\loot[2]) + " gold."

; Delete Each removes every object of a Type at once.
Delete Each Monster
Local count = 0
For m.Monster = Each Monster
	count = count + 1
Next
Print "After Delete Each there are " + count + " monsters left."

Print
Print "Press any key to quit."
WaitKey
End

Function SpawnMonster.Monster(name$, health, x#, y#)
	Local m.Monster = New Monster
	m\name$ = name$
	m\health = health
	m\x = x
	m\y = y
	Return m
End Function

Function ListMonsters()
	Local m.Monster
	For m.Monster = Each Monster
		Print "  " + LSet$(m\name$, 8) + " health " + RSet$(m\health, 3) + " at " + Int(m\x) + ", " + Int(m\y)
	Next
End Function

Function NearestMonster.Monster(x#, y#)
	Local best.Monster = Null
	Local bestDistance# = 0
	Local m.Monster
	For m.Monster = Each Monster
		Local distance# = Sqr((m\x - x) ^ 2 + (m\y - y) ^ 2)
		If best = Null Or distance < bestDistance
			best = m
			bestDistance = distance
		EndIf
	Next
	Return best
End Function
