; Tutorial 1.05: Functions
;
; A function is a named piece of code you can run from anywhere, as often as you like. Functions keep programs
; short (write it once, use it many times) and easy to read (a good name says what the code does).

Graphics 800, 600, 0, 2 ; A bigger window, so that everything printed fits.

; Functions can be written anywhere in the file, even after the code that calls them. These tutorials put them at
; the bottom, after End, so the program itself comes first.

Greet("Alex")
Greet("Sam")

; A function that returns a value is used like a value.
Print "3 squared is " + Square(3)
Print "The bigger of 12 and 7 is " + Bigger(12, 7)

; The suffix after the function name is the kind of value it returns: # for float, $ for text, none for integer.
Print "The average of 2 and 3 is " + Average#(2, 3)
Print Shout$("this is loud")

; Parameters can have default values. Leave them out and the default is used.
Print Repeated$("ab")       ; Uses the default count of 3.
Print Repeated$("ab", 5)

; --- Scope: Local and Global -----------------------------------------------------------------------------------
; Variables made inside a function are Local: they exist only while that function runs, and every call gets fresh
; ones. Variables made with Global at the top level can be read and changed from every function.
Global totalCalls = 0

CountCall()
CountCall()
CountCall()
Print "CountCall was called " + totalCalls + " times."

; A top-level variable that is not Global is NOT visible inside functions. A function can have its own variable
; with the same name, which is a different one that starts at 0.
Local secret = 99
Print "Outside, secret is " + secret + ". Inside a function it is " + ReadSecret() + "."

; --- Recursion --------------------------------------------------------------------------------------------------
; A function may call itself. Each call works on a smaller problem until it reaches one it can answer directly.
Print "5! (5 * 4 * 3 * 2 * 1) is " + Factorial(5)
Print "The 15th Fibonacci number is " + Fibonacci(15)

Print
Print "Press any key to quit."
WaitKey
End

; A function without a return value. It does a job and that is all.
Function Greet(name$)
	Print "Hello, " + name$ + "!"
End Function

; Return gives a value back to the caller and leaves the function.
Function Square(n)
	Return n * n
End Function

Function Bigger(a, b)
	If a > b Then Return a
	Return b
End Function

; The parameters are integers, but the function returns a float, so the result keeps its fraction.
Function Average#(a, b)
	Return (a + b) / 2.0
End Function

Function Shout$(text$)
	Return Upper(text$) + "!"
End Function

Function Repeated$(text$, count = 3)
	Local result$ = ""
	Local i
	For i = 1 To count
		result$ = result$ + text$
	Next
	Return result$
End Function

Function CountCall()
	totalCalls = totalCalls + 1
End Function

Function ReadSecret()
	Local secret ; This "secret" is a new local variable, not the one at the top level.
	Return secret
End Function

Function Factorial(n)
	If n <= 1 Then Return 1
	Return n * Factorial(n - 1)
End Function

Function Fibonacci(n)
	If n < 2 Then Return n
	Return Fibonacci(n - 1) + Fibonacci(n - 2)
End Function
