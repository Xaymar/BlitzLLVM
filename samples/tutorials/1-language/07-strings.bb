; Tutorial 1.07: Working with Text
;
; Strings hold text. Blitz has many functions to look inside text, cut it up and build new text from pieces.
; Positions in a string start at 1 for the first character.

Graphics 800, 600, 0, 2 ; A bigger window, so that everything printed fits.

Local sentence$ = "The quick brown fox jumps over the lazy dog"
Print sentence$
Print "It is " + Len(sentence$) + " characters long."

; --- Cutting text -----------------------------------------------------------------------------------------------
Print
Print "Left 9:      " + Left$(sentence$, 9)     ; The first 9 characters.
Print "Right 8:     " + Right$(sentence$, 8)    ; The last 8 characters.
Print "Mid 11, 5:   " + Mid$(sentence$, 11, 5)  ; 5 characters starting at position 11.

; --- Searching ----------------------------------------------------------------------------------------------------
; Instr gives the position where one piece of text is found, or 0 if it is not there.
Print
Print "'fox' is at position " + Instr(sentence$, "fox")
Print "'cat' is at position " + Instr(sentence$, "cat")

; An optional third value says where to start looking, which lets you find every match.
Write "'o' is found at:"
Local p = Instr(sentence$, "o")
While p > 0
	Write " " + p
	p = Instr(sentence$, "o", p + 1)
Wend
Print

; --- Changing text --------------------------------------------------------------------------------------------
Print
Print Upper$(sentence$)
Print Lower$("SHHH, NOT SO LOUD")
Print Replace$(sentence$, "dog", "cat")
Print "[" + Trim$("   spaces around   ") + "]"  ; Trim removes spaces at both ends.

; String$ repeats text, LSet and RSet pad it to a width (on the right or the left).
Print String$("=-", 10)
Print "[" + LSet$("left", 10) + "]"
Print "[" + RSet$("right", 10) + "]"

; --- Characters and codes ---------------------------------------------------------------------------------------
; Every character has a number. Asc gives the number, Chr gives the character back.
Print
Print "The code for 'A' is " + Asc("A") + ", and code 98 is '" + Chr$(98) + "'."

; Walking through text one character at a time, here to count the vowels.
Local vowels = 0
Local i, c$
For i = 1 To Len(sentence$)
	c$ = Lower$(Mid$(sentence$, i, 1))
	If Instr("aeiou", c$) Then vowels = vowels + 1
Next
Print "The sentence has " + vowels + " vowels."

; Building text backwards from its characters.
Local reversed$ = ""
For i = Len(sentence$) To 1 Step -1
	reversed$ = reversed$ + Mid$(sentence$, i, 1)
Next
Print reversed$

; --- Numbers as text -------------------------------------------------------------------------------------------
Print
Print "255 in hexadecimal is " + Hex$(255) + ", and 5 in binary is " + Bin$(5)
Print "Text to number: " + (Int("40") + 2)
Print "A float from text: " + (Float("1.5") * 2)

; --- Splitting --------------------------------------------------------------------------------------------------
; There is no built-in split, but Instr and Mid make one quickly. This prints every word on its own line.
Print
Local rest$ = sentence$ + " "
Local wordNumber = 0
Local space
While Len(rest$) > 0
	space = Instr(rest$, " ")
	wordNumber = wordNumber + 1
	Print "Word " + wordNumber + ": " + Left$(rest$, space - 1)
	rest$ = Mid$(rest$, space + 1)
Wend

Print
Print "Press any key to quit."
WaitKey
End
