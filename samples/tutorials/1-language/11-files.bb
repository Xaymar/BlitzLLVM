; Tutorial 1.11: Files
;
; Files keep data after the program ends: save games, settings and high score tables. This tutorial writes a
; small save file, reads it back and then deletes it again.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Graphics 800, 600, 0, 2 ; A bigger window, so that everything printed fits.

; SystemProperty$("tempdir") gives a folder where programs may put files they do not need for long. Real games
; usually save next to the program or in the user's documents instead.
Local path$ = SystemProperty$("tempdir")
If path$ <> "" And Right$(path$, 1) <> "\" And Right$(path$, 1) <> "/" Then path$ = path$ + "/"
path$ = path$ + "tutorial-save.dat"

; --- Writing ---------------------------------------------------------------------------------------------------
; WriteFile creates the file (or empties it if it exists) and gives back a handle, a number that stands for the
; open file. It gives 0 if the file could not be made.
Local file = WriteFile(path$)
If file = 0
	Print "Could not create " + path$
	WaitKey
	End
EndIf

; Each Write command stores one value in the file. WriteLine stores text that a person could read, WriteInt and
; WriteFloat store exact numbers in 4 bytes each, and WriteString stores text with its length in front.
WriteLine file, "Tutorial save file"
WriteString file, "Alex"
WriteInt file, 7        ; Level
WriteInt file, 12450    ; Score
WriteFloat file, 73.5   ; Health
WriteByte file, 3       ; Lives, a small number from 0 to 255

; Always close a file when you are done with it, so everything really reaches the disk.
CloseFile file
Print "Saved to " + path$
Print "The file is " + FileSize(path$) + " bytes long."

; --- Reading ------------------------------------------------------------------------------------------------------
; Read everything back in the same order it was written. The file does not remember what kind each value was, so
; reading in a different order gives nonsense.
file = ReadFile(path$)
Local header$ = ReadLine$(file)
Local name$ = ReadString$(file)
Local level = ReadInt(file)
Local score = ReadInt(file)
Local health# = ReadFloat(file)
Local lives = ReadByte(file)
CloseFile file

Print
Print "Loaded '" + header$ + "':"
Print "  " + name$ + " is on level " + level + " with " + score + " points, " + health + " health and " + lives + " lives."

; --- Text files line by line ------------------------------------------------------------------------------------
; Eof tells you when there is nothing left to read, so you can read files of any length.
file = WriteFile(path$)
WriteLine file, "First line"
WriteLine file, "Second line"
WriteLine file, "Third line"
CloseFile file

Print
file = ReadFile(path$)
Local lineNumber = 0
While Not Eof(file)
	lineNumber = lineNumber + 1
	Print "  Line " + lineNumber + ": " + ReadLine$(file)
Wend
CloseFile file

; --- Checking and cleaning up -----------------------------------------------------------------------------------
; FileType gives 0 if nothing is there, 1 for a file and 2 for a folder.
Print
Print "FileType before deleting: " + FileType(path$)
DeleteFile path$
Print "FileType after deleting:  " + FileType(path$)

Print
Print "Press any key to quit."
WaitKey
End
