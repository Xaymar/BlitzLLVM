; Tutorial 1.04: Loops
;
; A loop runs the same code many times. Blitz has three kinds, and every game has at least one: the main loop that
; runs once per frame until the player quits.

Graphics 800, 600, 0, 2 ; A bigger window, so that everything printed fits.

; --- For ... Next --------------------------------------------------------------------------------------------------
; For counts from a start value to an end value. Both ends are included.
; The counter of a For loop is a normal variable, so it is declared like any other.
Local i
Write "Counting up:   "
For i = 1 To 5
	Write i + " "
Next
Print

; Step changes how far each round counts. It can be negative to count down.
Write "Counting down: "
For i = 10 To 0 Step -2
	Write i + " "
Next
Print

; Loops can be nested. The inner loop runs completely for every round of the outer loop.
Print
Print "Times table:"
Local row, column ; One Local can declare several variables.
Local rowText$
For row = 1 To 5
	rowText$ = ""
	For column = 1 To 5
		; RSet pads text on the left to a fixed width, so the columns line up (tutorial 1.07).
		rowText$ = rowText$ + RSet(row * column, 4)
	Next
	Print rowText$
Next

; --- While ... Wend ---------------------------------------------------------------------------------------------
; While checks its condition first, and runs as long as it is true. If the condition is false from the start, the
; code inside never runs.
Print
Local money = 100
Local years = 0
While money < 200
	money = money + money / 10 ; 10% interest, rounded down.
	years = years + 1
Wend
Print "With 10% interest, 100 coins become " + money + " after " + years + " years."

; --- Repeat ... Until ---------------------------------------------------------------------------------------------
; Repeat checks its condition at the end, so the code inside always runs at least once.
SeedRnd MilliSecs()
Local rolls = 0, roll
Repeat
	roll = Rand(1, 6)
	rolls = rolls + 1
Until roll = 6
Print "It took " + rolls + " rolls to get a six."

; --- Exit and Forever -----------------------------------------------------------------------------------------------
; Exit leaves the loop it is in right away. Repeat ... Forever never ends on its own, so it needs an Exit.
Local n = 1
Repeat
	n = n * 2
	If n > 1000 Then Exit
Forever
Print "The first power of two above 1000 is " + n + "."

; Exit works in For and While loops too. Here it stops the search at the first match.
Print
For i = 2 To 100
	If i Mod 7 = 0 And i Mod 5 = 0
		Print "The smallest number that both 5 and 7 divide is " + i + "."
		Exit
	EndIf
Next

; --- Goto and labels --------------------------------------------------------------------------------------------
; A label starts with a dot. Goto jumps to it. Old programs use Goto a lot. Loops and functions are almost always
; easier to read, so use Goto only when nothing else fits.
Print
Goto skipThis
Print "This line is never printed."
.skipThis
Print "Goto jumped over a line."

Print
Print "Press any key to quit."
WaitKey
End
