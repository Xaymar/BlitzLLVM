; Tutorial 2.02: Drawing
;
; The 2D drawing commands all use the current colour set by Color. Positions are in pixels: (0, 0) is the top left
; corner, x grows to the right and y grows downwards.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Graphics 640, 480, 0, 2
AppTitle "Tutorial 2.02: Drawing"
SetBuffer BackBuffer()

Local i, x, y, pulse
Local t# = 0

While Not KeyHit(1)
	t = t + 1
	ClsColor 16, 16, 32
	Cls

	; Plot sets a single pixel. Here: a field of stars.
	SeedRnd 42 ; The same seed every frame, so the stars stay in place.
	For i = 1 To 300
		Color Rand(80, 255), Rand(80, 255), 255
		Plot Rand(0, 639), Rand(0, 479)
	Next
	SeedRnd MilliSecs()

	; Line draws from one point to another. Many lines from one point make a fan.
	For i = 0 To 20
		Color 255, 12 * i, 0
		Line 20, 460, 20 + i * 15, 300
	Next

	; Rect x, y, width, height, solid. The last value 1 fills the rectangle, 0 draws only its outline.
	Color 60, 180, 255
	Rect 360, 320, 120, 80, 1
	Color 255, 255, 255
	Rect 350, 310, 140, 100, 0

	; Oval x, y, width, height, solid draws the ellipse that fits in that rectangle. Equal sizes make a circle.
	pulse = Int(20 + 10 * Sin(t * 3))
	Color 255, 220, 0
	Oval 540 - pulse, 120 - pulse, pulse * 2, pulse * 2, 1
	Color 200, 80, 200
	Oval 480, 300, 140, 60, 0

	; Text x, y, text, centreX, centreY. The last two (both optional) centre the text on the position.
	Color 255, 255, 255
	Text 320, 20, "Drawing with Plot, Line, Rect, Oval and Text", True, False
	; FontHeight and StringWidth measure text, which helps to line it up.
	Text 10, 40, "The font is " + FontHeight() + " pixels high, and this line is " + StringWidth("The font is 00 pixels high, and this line is 000 pixels wide.") + " pixels wide."

	; Origin moves (0, 0) somewhere else, so the same drawing code can draw in different places. Here a small
	; clock is drawn twice, around two different origins.
	For i = 0 To 1
		Origin 160 + i * 160, 200
		Color 90, 90, 120
		Oval -50, -50, 100, 100, 0
		Color 255, 255, 255
		x = Int(Cos(t * (i + 1) - 90) * 45)
		y = Int(Sin(t * (i + 1) - 90) * 45)
		Line 0, 0, x, y
	Next
	Origin 0, 0 ; Always put the origin back.

	; Viewport limits drawing to a rectangle. Everything outside it is left alone. Here a stripe pattern is drawn
	; over the whole window, but only the inside of the viewport shows it.
	Viewport 360, 120, 100, 100
	For i = 0 To 640 Step 8
		Color 0, 120 + (i Mod 64) * 2, 90
		Line i - Int(t) Mod 64, 0, i - Int(t) Mod 64 + 200, 480
	Next
	Viewport 0, 0, GraphicsWidth(), GraphicsHeight()

	Flip
Wend
End
