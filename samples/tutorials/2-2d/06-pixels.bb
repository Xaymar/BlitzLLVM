; Tutorial 2.06: Pixels
;
; Sometimes you want to set every pixel yourself: for fire, plasma, water ripples or a procedural texture. Plot is
; too slow for a whole screen. Instead, lock the buffer, write the pixels with WritePixelFast and unlock it again.
; A pixel is one integer that holds the colour as $AARRGGBB: alpha, red, green and blue, 8 bits each.
;
; This tutorial draws a moving "plasma" into an image, from sine waves.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Graphics 640, 480, 0, 2
AppTitle "Tutorial 2.06: Pixels"
SetBuffer BackBuffer()

; Writing every pixel of a large picture takes time, so the plasma is drawn small and then tiled.
Const W = 160, H = 120
Local plasma = CreateImage(W, H)

; A palette of 256 colours, worked out once. Each entry packs red, green and blue into one integer.
Dim palette(255)
Local i, r, g, b
For i = 0 To 255
	r = Int(128 + 127 * Sin(i * 360.0 / 256))
	g = Int(128 + 127 * Sin(i * 360.0 / 256 + 120))
	b = Int(128 + 127 * Sin(i * 360.0 / 256 + 240))
	palette(i) = (255 Shl 24) Or (r Shl 16) Or (g Shl 8) Or b
Next

; Sines are slow compared to looking a number up, so a table of them is made once as well.
Dim sine(359)
For i = 0 To 359
	sine(i) = Int(64 * Sin(Float(i)))
Next

Local t = 0, x, y, value, buffer
Local mouseRGB, pixel

While Not KeyHit(1)
	t = t + 2
	buffer = ImageBuffer(plasma)

	; LockBuffer makes the pixels reachable. Between LockBuffer and UnlockBuffer only the pixel commands may be
	; used on that buffer.
	LockBuffer buffer
	For y = 0 To H - 1
		For x = 0 To W - 1
			; Four waves added together. The result is wrapped into 0 to 255 with "And 255".
			value = sine((x * 3 + t) Mod 360) + sine((y * 4 + t * 2) Mod 360) + sine((x * 2 + y * 2 + t) Mod 360) + sine(((x + y) * 5) Mod 360)
			WritePixelFast x, y, palette(value And 255), buffer
		Next
	Next
	UnlockBuffer buffer

	; Tile the small picture over the whole window: 4 by 4 copies.
	Cls
	For y = 0 To 3
		For x = 0 To 3
			DrawImage plasma, x * W, y * H
		Next
	Next

	; ReadPixel reads one pixel back. The parts of the colour are taken out with Shr and And.
	pixel = ReadPixel(MouseX(), MouseY())
	mouseRGB = pixel And $FFFFFF
	Color 0, 0, 0
	Rect 0, 460, 640, 20, 1
	Color 255, 255, 255
	Text 10, 462, "Colour under the mouse: red " + ((mouseRGB Shr 16) And 255) + ", green " + ((mouseRGB Shr 8) And 255) + ", blue " + (mouseRGB And 255)
	Flip
Wend
End
