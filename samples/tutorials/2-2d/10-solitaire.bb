; Tutorial 2.10: A Card Game: Solitaire
;
; The classic patience game with seven columns of cards. Build four piles, one per suit, from the ace up to the king.
; In the columns, cards go on a card one higher and of the other colour (a red 6 on a black 7), and only a king can
; start an empty column. The deck in the top left deals more cards when it is clicked.
;
; New things here:
;
;   - Pictures made once and reused: all 52 cards and the card back are drawn into images when the screen opens,
;     so each frame only has to copy them with DrawImage.
;   - Several piles kept in one 2D array, pileCard(pile, position), with the size of each pile in another array.
;   - Dragging with the mouse: MouseHit starts a drag, MouseDown keeps it going, and letting go drops the cards.
;   - A double click, found by comparing the time of two clicks.
;   - Undo, by copying the whole game into a second set of arrays before each move.
;
; Like tutorial 2.09 it has a main menu, options and statistics that are saved next to the program.
;
; Controls: drag cards with the left mouse button. Double click a card to send it to its suit pile. U undoes the last
; move, Escape goes back to the menu.

Const SCREEN_W = 800, SCREEN_H = 600
Const CARD_W = 72, CARD_H = 100
Const COLUMN_STEP = 104            ; From one column to the next.
Const TABLE_LEFT = 40, TOP_ROW_Y = 50, TABLEAU_Y = 180
Const DOWN_STEP = 8                ; How far a face-down card in a column shows of the one below it.
Const UP_STEP = 24                 ; The same for a face-up card.

; The piles. They are numbered so that one array can hold them all.
Const PILE_STOCK = 0, PILE_WASTE = 1, PILE_FOUNDATION = 2, PILE_TABLEAU = 6, PILE_COUNT = 13
; 2 to 5 are the four suit piles (foundations), 6 to 12 the seven columns (the tableau).

; A card is a number from 0 to 51: suit * 13 + rank. Rank 0 is the ace, 12 the king.
Const SUIT_SPADES = 0, SUIT_HEARTS = 1, SUIT_DIAMONDS = 2, SUIT_CLUBS = 3

Const STATE_MENU = 0, STATE_OPTIONS = 1, STATE_STATS = 2, STATE_HELP = 3, STATE_PLAY = 4, STATE_WON = 5

Const KEY_ESCAPE = 1, KEY_U = 22, KEY_ENTER = 28, KEY_SPACE = 57
Const KEY_UP = 200, KEY_DOWN = 208, KEY_LEFT = 203, KEY_RIGHT = 205

; --- The game's data -----------------------------------------------------------------------------------------------
Dim pileCard(PILE_COUNT - 1, 51)   ; pileCard(pile, 0) is the bottom card of a pile.
Dim pileSize(PILE_COUNT - 1)
Dim faceUp(51)                     ; True for a card that shows its face.

; The copy for undo.
Dim undoCard(PILE_COUNT - 1, 51), undoSize(PILE_COUNT - 1), undoFace(51)
Global undoValid, undoMoves

Global moves, startTime, endTime

; Dragging: which pile the cards come from, the first card taken, and where the mouse holds it.
Global dragging, dragPile, dragIndex, dragOffsetX, dragOffsetY
; Double click: the card and the time of the last click.
Global lastClickCard = -1, lastClickTime
; Finishing: once every card is face up, the cards go to their suit piles by themselves.
Global finishing, finishTimer

; --- Options and statistics ----------------------------------------------------------------------------------------
Global optDraw = 1               ; Cards dealt from the deck at a time: 1 or 3.
Global optBack = 0               ; Colour of the card backs: 0 blue, 1 red, 2 green.
Global optSound = True
Global optFullscreen = False
Global gamesPlayed, gamesWon
Dim bestTime(1)                  ; Best time in seconds for draw 1 and draw 3. 0 means "none yet".

Global settingsPath$ = SystemProperty$("appdir")
If settingsPath <> "" And Right$(settingsPath, 1) <> "\" And Right$(settingsPath, 1) <> "/" Then settingsPath = settingsPath + "/"
settingsPath = settingsPath + "solitaire.cfg"
LoadSettings()

; --- Menus -----------------------------------------------------------------------------------------------------------
Dim menuText$(6)
Global menuCount, menuSelected, menuTop
Global state = STATE_MENU

; --- Pictures and sounds ---------------------------------------------------------------------------------------------
Dim cardImage(51)
Global backImage, watermark
Global soundCard, soundDeal, soundWin

OpenScreen()
soundCard = MakeSound(1800, 30, True)
soundDeal = MakeSound(900, 60, True)
soundWin = MakeSound(880, 600, False)

Local timer = CreateTimer(60)
Local quit = False
GoToMenu()

While Not quit
	WaitTimer timer

	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_STATS, STATE_HELP
			If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Or MouseHit(1) Then GoToMenu()
		Case STATE_PLAY
			UpdatePlay()
		Case STATE_WON
			If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Or MouseHit(1) Then GoToMenu()
	End Select

	ClsColor 20, 90, 55
	Cls
	DrawWatermark()
	Select state
		Case STATE_PLAY, STATE_WON
			DrawTable()
			DrawHud()
			If state = STATE_WON Then DrawWon()
		Default
			DrawMenuScreen()
	End Select
	Flip 0
Wend
SaveSettings()
End

; --- Screen and settings ---------------------------------------------------------------------------------------------

; Graphics frees all images, so the cards are drawn again every time the screen opens.
Function OpenScreen()
	If optFullscreen Then Graphics SCREEN_W, SCREEN_H, 0, 1 Else Graphics SCREEN_W, SCREEN_H, 0, 2
	AppTitle "Solitaire"
	SetBuffer BackBuffer()
	SeedRnd MilliSecs()
	MakeCardImages()
	watermark = 0
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	If ReadInt(file) = 1 ; A version number, so a changed file format can be recognised later.
		optDraw = ReadInt(file)
		optBack = ReadInt(file)
		optSound = ReadInt(file)
		optFullscreen = ReadInt(file)
		gamesPlayed = ReadInt(file)
		gamesWon = ReadInt(file)
		bestTime(0) = ReadInt(file)
		bestTime(1) = ReadInt(file)
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optDraw <> 3 Then optDraw = 1
	If optBack < 0 Or optBack > 2 Then optBack = 0
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets.
	WriteInt file, 1
	WriteInt file, optDraw
	WriteInt file, optBack
	WriteInt file, optSound
	WriteInt file, optFullscreen
	WriteInt file, gamesPlayed
	WriteInt file, gamesWon
	WriteInt file, bestTime(0)
	WriteInt file, bestTime(1)
	CloseFile file
End Function

Function PlaySfx(sound)
	If optSound And sound <> 0 Then PlaySound sound
End Function

; --- Menus -----------------------------------------------------------------------------------------------------------
; The same menu code as in tutorial 2.09: a list of lines, the selected one, keys and mouse.

Function MenuInput()
	If KeyHit(KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount
	If KeyHit(KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount

	Local line = MenuLineAt(MouseX(), MouseY())
	If line >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = line

	If KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Then Return menuSelected
	If MouseHit(1) And line >= 0
		menuSelected = line
		Return line
	EndIf
	Return -1
End Function

Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 170 Or x >= SCREEN_W / 2 + 170 Or y < menuTop Then Return -1
	Local line = (y - menuTop) / 34
	If line >= menuCount Then Return -1
	Return line
End Function

Function GoToMenu()
	state = STATE_MENU
	menuCount = 5
	menuTop = 250
	menuSelected = 0
	menuText(0) = "Play (draw " + optDraw + ")"
	menuText(1) = "Options"
	menuText(2) = "Statistics"
	menuText(3) = "How to play"
	menuText(4) = "Quit"
	dragging = False
	FlushKeys
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

; Gives back True when the player chose Quit.
Function UpdateMenu()
	If KeyHit(KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0 : StartGame()
		Case 1 : GoToOptions()
		Case 2
			state = STATE_STATS
			FlushMouse
		Case 3
			state = STATE_HELP
			FlushMouse
		Case 4 : Return True
	End Select
	Return False
End Function

Function GoToOptions()
	state = STATE_OPTIONS
	menuCount = 5
	menuTop = 250
	menuSelected = 0
	RefreshOptionsText()
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

Function RefreshOptionsText()
	If optDraw = 1 Then menuText(0) = "Deal: one card at a time" Else menuText(0) = "Deal: three cards at a time"
	Select optBack
		Case 0 : menuText(1) = "Card backs: blue"
		Case 1 : menuText(1) = "Card backs: red"
		Case 2 : menuText(1) = "Card backs: green"
	End Select
	If optSound Then menuText(2) = "Sound: on" Else menuText(2) = "Sound: off"
	If optFullscreen Then menuText(3) = "Display: full screen" Else menuText(3) = "Display: window"
	menuText(4) = "Back"
End Function

Function UpdateOptions()
	Local change = 0
	If KeyHit(KEY_LEFT) Then change = -1
	If KeyHit(KEY_RIGHT) Then change = 1
	Local chosen = MenuInput()
	If chosen >= 0 Then change = 1

	If KeyHit(KEY_ESCAPE) Or chosen = 4
		SaveSettings()
		GoToMenu()
		menuSelected = 1
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optDraw = 4 - optDraw ; 1 becomes 3, 3 becomes 1.
		Case 1
			optBack = (optBack + change + 3) Mod 3
			MakeCardImages() ; The back picture changes.
		Case 2 : optSound = Not optSound
		Case 3
			optFullscreen = Not optFullscreen
			OpenScreen()
	End Select
	PlaySfx(soundCard)
	RefreshOptionsText()
End Function

Function DrawMenuScreen()
	; A fan of cards as the title.
	Local i
	For i = 0 To 4
		DrawImage cardImage(i * 13 Mod 52 + 12 - i * 3), SCREEN_W / 2 - 170 + i * 50, 60 + Abs(i - 2) * 8
	Next
	Color 255, 255, 255
	Text SCREEN_W / 2, 200, "S O L I T A I R E", True, True

	Select state
		Case STATE_MENU, STATE_OPTIONS
			For i = 0 To menuCount - 1
				If i = menuSelected
					Color 10, 60, 35
					Rect SCREEN_W / 2 - 170, menuTop + i * 34, 340, 30, 1
					Color 255, 240, 160
				Else
					Color 220, 240, 225
				EndIf
				Text SCREEN_W / 2, menuTop + i * 34 + 15, menuText(i), True, True
			Next
			Color 150, 200, 165
			If state = STATE_MENU
				Text SCREEN_W / 2, 450, "Up / Down or the mouse to choose, Enter or a click to select.", True, True
			Else
				Text SCREEN_W / 2, 450, "Left / Right or a click change the option, Escape goes back.", True, True
			EndIf
		Case STATE_STATS
			Color 220, 240, 225
			Text SCREEN_W / 2, 260, "Games played: " + gamesPlayed, True, True
			Text SCREEN_W / 2, 285, "Games won: " + gamesWon, True, True
			If gamesPlayed > 0 Then Text SCREEN_W / 2, 310, "Won: " + (gamesWon * 100 / gamesPlayed) + "%", True, True
			Text SCREEN_W / 2, 345, "Best time, one card at a time: " + TimeText$(bestTime(0)), True, True
			Text SCREEN_W / 2, 370, "Best time, three cards at a time: " + TimeText$(bestTime(1)), True, True
			Color 150, 200, 165
			Text SCREEN_W / 2, 450, "Press Enter or click to go back.", True, True
		Case STATE_HELP
			Color 220, 240, 225
			Text SCREEN_W / 2, 250, "Build four piles at the top right, one per suit, from the ace up to the king.", True, True
			Text SCREEN_W / 2, 275, "In the seven columns a card goes on one a rank higher of the other colour.", True, True
			Text SCREEN_W / 2, 300, "Only a king can go into an empty column.", True, True
			Text SCREEN_W / 2, 335, "Click the deck at the top left to deal more cards.", True, True
			Text SCREEN_W / 2, 360, "Drag cards with the mouse. Double click sends a card to its suit pile.", True, True
			Text SCREEN_W / 2, 385, "U undoes the last move, Escape goes back to the menu.", True, True
			Color 150, 200, 165
			Text SCREEN_W / 2, 450, "Press Enter or click to go back.", True, True
	End Select
	Color 120, 170, 135
	Text SCREEN_W / 2, SCREEN_H - 20, "A BlitzLLVM sample game", True, True
End Function

; A time in seconds as minutes:seconds, or "-" for 0, which means "no time yet".
Function TimeText$(seconds)
	If seconds = 0 Then Return "-"
	Return ClockText$(seconds)
End Function

Function ClockText$(seconds)
	Local s$ = Str(seconds Mod 60)
	If Len(s) < 2 Then s = "0" + s
	Return (seconds / 60) + ":" + s
End Function

; --- Starting a game -------------------------------------------------------------------------------------------------

Function StartGame()
	; Shuffle: walk through the deck and swap every card with a random one at or after it. Every order is equally
	; likely this way.
	Local deck[51], i, j, swap
	For i = 0 To 51
		deck[i] = i
	Next
	For i = 0 To 50
		j = Rand(i, 51)
		swap = deck[i] : deck[i] = deck[j] : deck[j] = swap
	Next

	For i = 0 To PILE_COUNT - 1
		pileSize(i) = 0
	Next
	; Deal the columns: column 1 gets one card, column 7 seven. Only the last card of each column shows its face.
	Local column, n = 0
	For column = 0 To 6
		For i = 0 To column
			AddCard(PILE_TABLEAU + column, deck[n], i = column)
			n = n + 1
		Next
	Next
	; The rest is the deck.
	While n < 52
		AddCard(PILE_STOCK, deck[n], False)
		n = n + 1
	Wend

	moves = 0
	startTime = 0
	undoValid = False
	dragging = False
	finishing = False
	gamesPlayed = gamesPlayed + 1
	SaveSettings()
	state = STATE_PLAY
	PlaySfx(soundDeal)
	FlushMouse
	FlushKeys
End Function

Function AddCard(pile, card, up)
	pileCard(pile, pileSize(pile)) = card
	pileSize(pile) = pileSize(pile) + 1
	faceUp(card) = up
End Function

Function TopCard(pile)
	If pileSize(pile) = 0 Then Return -1
	Return pileCard(pile, pileSize(pile) - 1)
End Function

Function CardRank(card)
	Return card Mod 13
End Function

Function CardSuit(card)
	Return card / 13
End Function

Function IsRed(card)
	Return CardSuit(card) = SUIT_HEARTS Or CardSuit(card) = SUIT_DIAMONDS
End Function

; --- Where things are on the screen -----------------------------------------------------------------------------------

Function PileX(pile)
	If pile = PILE_STOCK Then Return TABLE_LEFT
	If pile = PILE_WASTE Then Return TABLE_LEFT + COLUMN_STEP
	If pile < PILE_TABLEAU Then Return TABLE_LEFT + (pile - PILE_FOUNDATION + 3) * COLUMN_STEP
	Return TABLE_LEFT + (pile - PILE_TABLEAU) * COLUMN_STEP
End Function

; The x position of a card in a pile. In the waste pile, the top three cards are spread out when dealing three.
Function CardX(pile, index)
	If pile = PILE_WASTE And optDraw = 3
		Local spread = index - (pileSize(pile) - 3)
		If spread < 0 Then spread = 0
		Return PileX(pile) + spread * 16
	EndIf
	Return PileX(pile)
End Function

; The y position of a card in a pile. Columns spread their cards downwards. A long column moves its face-up cards
; closer together, so it still fits on the screen.
Function CardY(pile, index)
	If pile < PILE_TABLEAU Then Return TOP_ROW_Y
	Local i, downCount = 0, upCount = 0
	For i = 0 To pileSize(pile) - 2
		If faceUp(pileCard(pile, i)) Then upCount = upCount + 1 Else downCount = downCount + 1
	Next
	Local upStep = UP_STEP
	Local room = SCREEN_H - 30 - CARD_H - TABLEAU_Y - downCount * DOWN_STEP
	If upCount > 0 And upCount * upStep > room Then upStep = room / upCount

	Local y = TABLEAU_Y
	For i = 0 To index - 1
		If faceUp(pileCard(pile, i)) Then y = y + upStep Else y = y + DOWN_STEP
	Next
	Return y
End Function

; Finds the card under a screen position. Gives back the pile, and puts the card's position in the pile into
; foundIndex: -1 when the position is on an empty pile. Gives back -1 when there is no pile there at all.
Global foundIndex
Function PileAt(x, y)
	Local pile, i
	For pile = 0 To PILE_COUNT - 1
		; The topmost card is checked first, because it covers the ones below.
		For i = pileSize(pile) - 1 To 0 Step -1
			If x >= CardX(pile, i) And x < CardX(pile, i) + CARD_W And y >= CardY(pile, i) And y < CardY(pile, i) + CARD_H
				foundIndex = i
				Return pile
			EndIf
		Next
		If pileSize(pile) = 0
			If x >= PileX(pile) And x < PileX(pile) + CARD_W And y >= CardY(pile, 0) And y < CardY(pile, 0) + CARD_H
				foundIndex = -1
				Return pile
			EndIf
		EndIf
	Next
	Return -1
End Function

; --- Playing ---------------------------------------------------------------------------------------------------------

Function UpdatePlay()
	If KeyHit(KEY_ESCAPE)
		GoToMenu()
		Return
	EndIf
	If KeyHit(KEY_U) And undoValid And Not dragging Then RestoreUndo()

	If finishing
		UpdateFinishing()
		Return
	EndIf

	If dragging
		; The button is still held: the cards follow the mouse, nothing else to do. Letting go drops them.
		If Not MouseDown(1) Then DropCards()
		Return
	EndIf

	If Not MouseHit(1) Then Return
	Local pile = PileAt(MouseX(), MouseY())
	If pile = -1 Then Return

	If pile = PILE_STOCK
		DealFromStock()
		Return
	EndIf
	If foundIndex = -1 Then Return
	Local card = pileCard(pile, foundIndex)
	If Not faceUp(card) Then Return

	; A second click on the same card within 400 milliseconds is a double click.
	If card = lastClickCard And MilliSecs() - lastClickTime < 400 And foundIndex = pileSize(pile) - 1
		lastClickCard = -1
		If SendToFoundation(pile) Then Return
	EndIf
	lastClickCard = card
	lastClickTime = MilliSecs()

	; Only the top card of the waste and suit piles can be taken. In a column, a card takes all cards on it along.
	If pile < PILE_TABLEAU And foundIndex <> pileSize(pile) - 1 Then Return
	dragging = True
	dragPile = pile
	dragIndex = foundIndex
	dragOffsetX = MouseX() - CardX(pile, foundIndex)
	dragOffsetY = MouseY() - CardY(pile, foundIndex)
End Function

Function DealFromStock()
	SaveUndo()
	Local i
	If pileSize(PILE_STOCK) = 0
		; The deck is empty: the waste pile is turned over and becomes the deck again.
		If pileSize(PILE_WASTE) = 0 Then Return
		For i = pileSize(PILE_WASTE) - 1 To 0 Step -1
			AddCard(PILE_STOCK, pileCard(PILE_WASTE, i), False)
		Next
		pileSize(PILE_WASTE) = 0
	Else
		For i = 1 To optDraw
			If pileSize(PILE_STOCK) > 0
				pileSize(PILE_STOCK) = pileSize(PILE_STOCK) - 1
				AddCard(PILE_WASTE, pileCard(PILE_STOCK, pileSize(PILE_STOCK)), True)
			EndIf
		Next
	EndIf
	CountMove()
	PlaySfx(soundDeal)
End Function

; Can the cards from position index of pile "from" go onto pile "target"?
Function CanMove(from, index, target)
	If target = from Or target = PILE_STOCK Or target = PILE_WASTE Then Return False
	Local card = pileCard(from, index), top = TopCard(target)
	If target < PILE_TABLEAU
		; A suit pile takes one card at a time: an ace on an empty pile, otherwise the next card of the same suit.
		If index <> pileSize(from) - 1 Then Return False
		If top = -1 Then Return CardRank(card) = 0
		Return CardSuit(card) = CardSuit(top) And CardRank(card) = CardRank(top) + 1
	EndIf
	; A column: a king on an empty column, otherwise one rank lower and the other colour.
	If top = -1 Then Return CardRank(card) = 12
	Return IsRed(card) <> IsRed(top) And CardRank(card) = CardRank(top) - 1
End Function

Function MoveCards(from, index, target)
	SaveUndo()
	Local i
	For i = index To pileSize(from) - 1
		AddCard(target, pileCard(from, i), True)
	Next
	pileSize(from) = index
	; A column whose top card is face down turns it over.
	If from >= PILE_TABLEAU And pileSize(from) > 0 Then faceUp(TopCard(from)) = True
	CountMove()
	PlaySfx(soundCard)
	CheckWon()
End Function

Function DropCards()
	dragging = False
	; The pile under the middle of the first dragged card is where the cards go.
	Local x = MouseX() - dragOffsetX + CARD_W / 2
	Local y = MouseY() - dragOffsetY + CARD_H / 2
	Local target, best = -1
	For target = PILE_FOUNDATION To PILE_COUNT - 1
		If x >= PileX(target) And x < PileX(target) + CARD_W
			If target < PILE_TABLEAU And y >= TOP_ROW_Y And y < TOP_ROW_Y + CARD_H Then best = target
			If target >= PILE_TABLEAU And y >= TABLEAU_Y Then best = target
		EndIf
	Next
	If best <> -1
		If CanMove(dragPile, dragIndex, best) Then MoveCards(dragPile, dragIndex, best)
	EndIf
	; If it could not move, the cards were never taken off their pile, so they simply show there again.
End Function

; Moves the top card of a pile to a suit pile, if one takes it. Gives back True when it moved.
Function SendToFoundation(pile)
	Local target
	For target = PILE_FOUNDATION To PILE_FOUNDATION + 3
		If CanMove(pile, pileSize(pile) - 1, target)
			MoveCards(pile, pileSize(pile) - 1, target)
			Return True
		EndIf
	Next
	Return False
End Function

Function CountMove()
	If moves = 0 Then startTime = MilliSecs() ; The clock starts with the first move.
	moves = moves + 1
	; When the deck is empty and every card in the columns shows its face, the game is as good as won.
	If pileSize(PILE_STOCK) > 0 Or pileSize(PILE_WASTE) > 0 Then Return
	Local pile, i
	For pile = PILE_TABLEAU To PILE_COUNT - 1
		For i = 0 To pileSize(pile) - 1
			If Not faceUp(pileCard(pile, i)) Then Return
		Next
	Next
	finishing = True
End Function

; Sends one card every few frames to the suit piles, until all are there.
Function UpdateFinishing()
	finishTimer = finishTimer - 1
	If finishTimer > 0 Then Return
	finishTimer = 4
	Local pile
	For pile = PILE_TABLEAU To PILE_COUNT - 1
		If pileSize(pile) > 0
			If SendToFoundation(pile) Then Return
		EndIf
	Next
End Function

Function CheckWon()
	Local pile, total = 0
	For pile = PILE_FOUNDATION To PILE_FOUNDATION + 3
		total = total + pileSize(pile)
	Next
	If total < 52 Then Return
	endTime = MilliSecs()
	finishing = False
	state = STATE_WON
	gamesWon = gamesWon + 1
	Local seconds = (endTime - startTime + 999) / 1000, slot = 0
	If optDraw = 3 Then slot = 1
	If seconds < 1 Then seconds = 1
	If bestTime(slot) = 0 Or seconds < bestTime(slot) Then bestTime(slot) = seconds
	SaveSettings()
	PlaySfx(soundWin)
	FlushMouse
	FlushKeys
End Function

; --- Undo ------------------------------------------------------------------------------------------------------------
; Before every move the whole game is copied. Undo copies it back. That is less clever than remembering each move,
; but it cannot go wrong, and 13 piles of 52 numbers are copied in no time.

Function SaveUndo()
	Local pile, i
	For pile = 0 To PILE_COUNT - 1
		undoSize(pile) = pileSize(pile)
		For i = 0 To pileSize(pile) - 1
			undoCard(pile, i) = pileCard(pile, i)
		Next
	Next
	For i = 0 To 51
		undoFace(i) = faceUp(i)
	Next
	undoMoves = moves
	undoValid = True
End Function

Function RestoreUndo()
	Local pile, i
	For pile = 0 To PILE_COUNT - 1
		pileSize(pile) = undoSize(pile)
		For i = 0 To pileSize(pile) - 1
			pileCard(pile, i) = undoCard(pile, i)
		Next
	Next
	For i = 0 To 51
		faceUp(i) = undoFace(i)
	Next
	moves = undoMoves + 1 ; Undo counts as a move too.
	undoValid = False      ; One step back only.
	PlaySfx(soundCard)
End Function

; --- Drawing the table -----------------------------------------------------------------------------------------------

Function DrawTable()
	Local pile, i, lastShown
	For pile = 0 To PILE_COUNT - 1
		; An outline shows where a pile is, even when it is empty.
		Color 40, 120, 75
		Rect PileX(pile), CardY(pile, 0), CARD_W, CARD_H, 0
		If pile >= PILE_FOUNDATION And pile < PILE_TABLEAU
			Text PileX(pile) + CARD_W / 2, TOP_ROW_Y + CARD_H / 2, "A", True, True
		EndIf

		lastShown = pileSize(pile) - 1
		If dragging And pile = dragPile Then lastShown = dragIndex - 1 ; The dragged cards are drawn last, on top.
		For i = 0 To lastShown
			DrawCard(pileCard(pile, i), CardX(pile, i), CardY(pile, i))
		Next
	Next

	If dragging
		Local x = MouseX() - dragOffsetX, y = MouseY() - dragOffsetY
		For i = dragIndex To pileSize(dragPile) - 1
			DrawCard(pileCard(dragPile, i), x, y + (i - dragIndex) * UP_STEP)
		Next
	EndIf
End Function

Function DrawCard(card, x, y)
	If faceUp(card) Then DrawImage cardImage(card), x, y Else DrawImage backImage, x, y
End Function

Function DrawHud()
	Local seconds = 0
	If moves > 0
		If state = STATE_WON Then seconds = (endTime - startTime) / 1000 Else seconds = (MilliSecs() - startTime) / 1000
	EndIf
	Color 220, 240, 225
	Text 10, 8, "Moves: " + moves
	Text SCREEN_W - 10 - StringWidth("Time: 00:00"), 8, "Time: " + ClockText$(seconds)
	Color 150, 200, 165
	Text SCREEN_W / 2, SCREEN_H - 12, "U undoes a move, Escape goes to the menu.", True, True
End Function

Function DrawWon()
	Color 10, 50, 30
	Rect 0, SCREEN_H / 2 - 40, SCREEN_W, 80, 1
	Color 255, 240, 160
	Text SCREEN_W / 2, SCREEN_H / 2 - 12, "All four suits are complete in " + moves + " moves!", True, True
	Color 200, 230, 210
	Text SCREEN_W / 2, SCREEN_H / 2 + 14, "Press Enter or click to go back to the menu.", True, True
End Function

; --- Pictures of the cards -------------------------------------------------------------------------------------------

Function MakeCardImages()
	Local card, rank$, image
	For card = 0 To 51
		If cardImage(card) <> 0 Then FreeImage cardImage(card)
		image = CreateImage(CARD_W, CARD_H)
		cardImage(card) = image
		SetBuffer ImageBuffer(image)
		DrawCardShape(245, 245, 240)
		If IsRed(card) Then Color 200, 30, 30 Else Color 20, 20, 30
		rank = Mid$("A23456789TJQK", CardRank(card) + 1, 1)
		If rank = "T" Then rank = "10"
		; The rank and a small suit sign in the top left and the bottom right corner, a big suit sign in the middle.
		Text 6, 4, rank
		DrawSuit(CardSuit(card), 10, 24, 10)
		Text CARD_W - 6 - StringWidth(rank), CARD_H - 4 - FontHeight(), rank
		DrawSuit(CardSuit(card), CARD_W - 11, CARD_H - 26, 10)
		DrawSuit(CardSuit(card), CARD_W / 2, CARD_H / 2, 30)
		If CardRank(card) >= 10
			; Jack, queen and king get a frame around the middle, to set them apart.
			Rect 18, 22, CARD_W - 36, CARD_H - 44, 0
		EndIf
	Next

	If backImage <> 0 Then FreeImage backImage
	backImage = CreateImage(CARD_W, CARD_H)
	SetBuffer ImageBuffer(backImage)
	DrawCardShape(245, 245, 240)
	Local r = 40, g = 70, b = 170, x, y
	If optBack = 1 Then r = 170 : g = 40 : b = 50
	If optBack = 2 Then r = 30 : g = 130 : b = 70
	Color r, g, b
	Rect 5, 5, CARD_W - 10, CARD_H - 10, 1
	; A diamond pattern on the back.
	Color r + 50, g + 50, b + 50
	For y = 9 To CARD_H - 10 Step 8
		For x = 9 + (y / 8 Mod 2) * 4 To CARD_W - 10 Step 8
			Rect x, y, 2, 2, 1
		Next
	Next
	SetBuffer BackBuffer()
End Function

; A white card with cut corners and a thin grey edge. The corners stay black, which DrawImage leaves out.
Function DrawCardShape(r, g, b)
	Color 120, 120, 120
	Rect 2, 0, CARD_W - 4, CARD_H, 1
	Rect 0, 2, CARD_W, CARD_H - 4, 1
	Rect 1, 1, CARD_W - 2, CARD_H - 2, 1
	Color r, g, b
	Rect 2, 1, CARD_W - 4, CARD_H - 2, 1
	Rect 1, 2, CARD_W - 2, CARD_H - 4, 1
End Function

; Draws a suit sign of a given size around a centre point, with the current colour. Each sign is built from ovals
; and from a stack of lines that get shorter, which fills a triangle.
Function DrawSuit(suit, cx, cy, size)
	Local h = size / 2, y, w
	Select suit
		Case SUIT_HEARTS
			Oval cx - h, cy - h, h + 1, h + 1, 1
			Oval cx, cy - h, h + 1, h + 1, 1
			For y = 0 To h + h / 2
				w = h - y * 2 / 3
				Line cx - w, cy - h / 4 + y, cx + w, cy - h / 4 + y
			Next
		Case SUIT_DIAMONDS
			For y = -h To h
				w = (h - Abs(y)) * 3 / 4
				Line cx - w, cy + y, cx + w, cy + y
			Next
		Case SUIT_SPADES
			For y = 0 To h + h / 2
				w = y * 2 / 3
				Line cx - w, cy - h + y, cx + w, cy - h + y
			Next
			Oval cx - h, cy, h + 1, h + 1, 1
			Oval cx, cy, h + 1, h + 1, 1
			Rect cx - size / 12, cy + h / 2, size / 6 + 1, h / 2 + 2, 1
		Case SUIT_CLUBS
			Oval cx - h / 2, cy - h, h + 1, h + 1, 1
			Oval cx - h, cy - h / 4, h + 1, h + 1, 1
			Oval cx, cy - h / 4, h + 1, h + 1, 1
			Rect cx - size / 12, cy, size / 6 + 1, h + 1, 1
	End Select
End Function

; --- A hidden watermark ----------------------------------------------------------------------------------------------
; Every frame carries a pattern that nobody can see: some pixels of the green table are one step bluer. A program can
; find it again in a screenshot, which shows that the picture came from this sample. See tutorial 2.09.

Function DrawWatermark()
	If watermark = 0
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				If (x * 7 + y * 13) Mod 29 < 3
					WritePixelFast x, y, (20 Shl 16) Or (90 Shl 8) Or 56, buffer
				Else
					WritePixelFast x, y, 0, buffer
				EndIf
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function

; --- Sounds made in code, as in tutorial 2.07 ------------------------------------------------------------------------

Function MakeSound(hz#, lengthMs, noise)
	Local rate = 22050, samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2), i, v#
	PokeInt bank, 0, $46464952      ; "RIFF"
	PokeInt bank, 4, 36 + samples * 2
	PokeInt bank, 8, $45564157      ; "WAVE"
	PokeInt bank, 12, $20746D66     ; "fmt "
	PokeInt bank, 16, 16
	PokeShort bank, 20, 1
	PokeShort bank, 22, 1
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2
	PokeShort bank, 32, 2
	PokeShort bank, 34, 16
	PokeInt bank, 36, $61746164     ; "data"
	PokeInt bank, 40, samples * 2
	For i = 0 To samples - 1
		If noise Then v = Rnd(-1, 1) Else v = Sin(i * hz * 360.0 / rate) * Sin(i * 180.0 / samples)
		v = v * (1.0 - Float(i) / samples) * 0.4
		PokeShort bank, 44 + i * 2, Int(v * 32767) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right$(path, 1) <> "\" And Right$(path, 1) <> "/" Then path = path + "/"
	path = path + "solitaire-" + MilliSecs() + "-" + Rand(1000, 9999) + ".wav"
	Local file = WriteFile(path)
	If file
		WriteBytes bank, file, 0, BankSize(bank)
		CloseFile file
	EndIf
	FreeBank bank
	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function
