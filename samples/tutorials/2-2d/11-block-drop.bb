; Tutorial 2.11: A Falling Block Puzzle: Block Drop
;
; Pieces made of four blocks fall into a well ten blocks wide. Move and turn them so that they fill whole rows: a full
; row disappears and everything above it drops down. The game ends when the well is filled up to the top. Every ten
; rows the pieces fall faster.
;
; New things here:
;
;   - Shapes written as small pictures in Data lines, read with Restore and Read.
;   - Turning a shape a quarter turn with a little maths, instead of drawing every turn by hand.
;   - A "bag" of pieces: one of each kind in a random order, so no piece is missing for long.
;   - Keys that repeat while held, like in a text editor: one step at once, a pause, then quick steps.
;   - A high score table that is kept in order, saved together with the date of each score.
;
; Like tutorials 2.09 and 2.10 it has a main menu, options and a pause menu, and remembers its settings.
;
; Controls: Left / Right move, Up or X turns clockwise, Z turns the other way, Down drops faster, Space drops at once,
; C holds a piece for later. Escape or P pauses.

Include "<keys.bb>"
Include "<mouse.bb>"
Include "<graphics.bb>"

Const SCREEN_W = 800, SCREEN_H = 600
Const COLUMNS = 10, ROWS = 22
Const HIDDEN_ROWS = 2              ; The top two rows are above the well: new pieces appear there.
Const CELL = 24                    ; Size of one block on screen.
Const WELL_X = 280, WELL_Y = 60    ; Top left corner of the visible part of the well.
Const KINDS = 7                    ; Seven different pieces.

Const STATE_MENU = 0, STATE_OPTIONS = 1, STATE_SCORES = 2, STATE_HELP = 3
Const STATE_PLAY = 4, STATE_PAUSED = 5, STATE_OVER = 6

; --- The pieces --------------------------------------------------------------------------------------------------
; Every piece sits in a square box: 4 by 4 for the long one, 2 by 2 for the square, 3 by 3 for the rest. For each kind
; and each of the four turns, cellX and cellY hold where its four blocks are inside the box.
Dim pieceName$(KINDS - 1), pieceSize(KINDS - 1)
Dim pieceRed(KINDS - 1), pieceGreen(KINDS - 1), pieceBlue(KINDS - 1)
Dim cellX(KINDS - 1, 3, 3), cellY(KINDS - 1, 3, 3) ; (kind, turn, block)

; Read the pictures from the Data lines at the end of the program. Restore picks the label to start reading from.
Restore PieceShapes
Local k, t, i, x, y, row$, count
For k = 0 To KINDS - 1
	Read pieceName(k), pieceRed(k), pieceGreen(k), pieceBlue(k), pieceSize(k)
	count = 0
	For y = 0 To pieceSize(k) - 1
		Read row
		For x = 0 To pieceSize(k) - 1
			If Mid$(row, x + 1, 1) = "X"
				cellX(k, 0, count) = x
				cellY(k, 0, count) = y
				count = count + 1
			EndIf
		Next
	Next

	; Each turn is the turn before it, turned a quarter clockwise. In a box of size n a block at (x, y) moves to
	; (n - 1 - y, x): the top row becomes the right column, the left column becomes the top row.
	For t = 1 To 3
		For i = 0 To 3
			cellX(k, t, i) = pieceSize(k) - 1 - cellY(k, t - 1, i)
			cellY(k, t, i) = cellX(k, t - 1, i)
		Next
	Next
Next

; When a turned piece does not fit, it may still fit a little to the side or one row higher. These are the places
; tried, in order. Real games use longer lists that differ per piece; this short one feels fine.
Dim kickX(5), kickY(5)
Restore KickOffsets
For i = 0 To 5
	Read kickX(i), kickY(i)
Next

; --- The well and the falling piece -------------------------------------------------------------------------------
Dim well(COLUMNS - 1, ROWS - 1)    ; 0 is empty, otherwise the kind of the piece + 1, which gives the colour.
Dim fullRow(ROWS - 1)              ; True for rows that are full and about to go.

Global kind = -1, turn             ; The falling piece: its kind (-1 for none) and its turn, 0 to 3.
Global pieceX, pieceY              ; Where the top left corner of its box is in the well.
Global holdKind = -1, holdUsed     ; The piece put aside with C. It can be swapped once per piece.
Dim queue(5)                       ; The pieces that come next, queue(0) first.
Dim bag(KINDS - 1)
Global bagLeft

Global score, clearedRows, level
Global fallTime#                   ; Seconds since the piece last fell a row.
Global lockFrames, lockMoves       ; How long a piece has been lying on something, and how often that was put off.
Global heldDir, repeatFrames       ; The direction held with Left / Right and for how long.
Global clearFrames                 ; While above 0, the full rows flash. When it reaches 0 they are removed.
Global message$, messageFrames
Global overFrames, newRank         ; Time since the game ended, and its place in the high scores (-1 for none).

; --- Options and high scores ---------------------------------------------------------------------------------------
Global optStartLevel = 1
Global optGhost = True             ; Show where the piece will land.
Global optPreview = 3              ; How many of the next pieces are shown: 1, 3 or 5.
Global optSound = True
Global optFullscreen = False
Dim bestScore(4), bestRows(4), bestLevel(4), bestDate$(4)

Global settingsPath$ = SystemProperty$("appdir")
If settingsPath <> "" And Right$(settingsPath, 1) <> "\" And Right$(settingsPath, 1) <> "/" Then settingsPath = settingsPath + "/"
settingsPath = settingsPath + "block-drop.cfg"
LoadSettings()

; --- Menus -----------------------------------------------------------------------------------------------------------
Dim menuText$(6)
Global menuCount, menuSelected, menuTop
Global state = STATE_MENU

; --- Pictures and sounds ---------------------------------------------------------------------------------------------
Dim blockImage(KINDS - 1)
Global watermark
Global soundMove, soundTurn, soundLock, soundClear, soundFour, soundLevel, soundOver

OpenScreen()
soundMove = MakeSound(1400, 15, False)
soundTurn = MakeSound(900, 35, False)
soundLock = MakeSound(300, 60, True)
soundClear = MakeSound(660, 300, False)
soundFour = MakeSound(990, 500, False)
soundLevel = MakeSound(1320, 250, False)
soundOver = MakeSound(180, 900, False)

Local timer = CreateTimer(60)
Local quit = False
GoToMenu()

While Not quit
	WaitTimer timer

	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_SCORES, STATE_HELP
			If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Or MouseHit(BB_MOUSE_LEFT)
				Local fromScores = (state = STATE_SCORES)
				GoToMenu()
				If fromScores Then menuSelected = 2 Else menuSelected = 3 ; Back on the line that was chosen.
			EndIf
		Case STATE_PLAY
			UpdatePlay()
		Case STATE_PAUSED
			UpdatePause()
		Case STATE_OVER
			UpdateOver()
	End Select

	ClsColor 14, 16, 28
	Cls
	DrawWatermark()
	Select state
		Case STATE_PLAY, STATE_PAUSED, STATE_OVER
			DrawGame()
		Default
			DrawMenuScreen()
	End Select
	Flip 0
Wend
SaveSettings()
End

; --- Screen and settings ---------------------------------------------------------------------------------------------

; Graphics frees all images, so the blocks are drawn again every time the screen opens.
Function OpenScreen()
	If optFullscreen Then Graphics SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_FULLSCREEN Else Graphics SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_WINDOWED
	AppTitle "Block Drop"
	SetBuffer BackBuffer()
	SeedRnd MilliSecs()
	MakeBlockImages()
	watermark = 0
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	Local i
	If ReadInt(file) = 1 ; A version number, so a changed file format can be recognised later.
		optStartLevel = ReadInt(file)
		optGhost = ReadInt(file)
		optPreview = ReadInt(file)
		optSound = ReadInt(file)
		optFullscreen = ReadInt(file)
		For i = 0 To 4
			bestScore(i) = ReadInt(file)
			bestRows(i) = ReadInt(file)
			bestLevel(i) = ReadInt(file)
			bestDate(i) = ReadString$(file)
		Next
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optStartLevel < 1 Or optStartLevel > 15 Then optStartLevel = 1
	If optPreview <> 1 And optPreview <> 5 Then optPreview = 3
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets.
	Local i
	WriteInt file, 1
	WriteInt file, optStartLevel
	WriteInt file, optGhost
	WriteInt file, optPreview
	WriteInt file, optSound
	WriteInt file, optFullscreen
	For i = 0 To 4
		WriteInt file, bestScore(i)
		WriteInt file, bestRows(i)
		WriteInt file, bestLevel(i)
		WriteString file, bestDate(i)
	Next
	CloseFile file
End Function

Function PlaySfx(sound)
	If optSound And sound <> 0 Then PlaySound sound
End Function

; --- Menus -----------------------------------------------------------------------------------------------------------
; The same menu code as in tutorials 2.09 and 2.10: a list of lines, the selected one, keys and mouse.

Function MenuInput()
	If KeyHit(BB_KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount
	If KeyHit(BB_KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount

	Local entry = MenuLineAt(MouseX(), MouseY())
	If entry >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = entry

	If KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Then Return menuSelected
	If MouseHit(BB_MOUSE_LEFT) And entry >= 0
		menuSelected = entry
		Return entry
	EndIf
	Return -1
End Function

Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 170 Or x >= SCREEN_W / 2 + 170 Or y < menuTop Then Return -1
	Local entry = (y - menuTop) / 34
	If entry >= menuCount Then Return -1
	Return entry
End Function

Function GoToMenu()
	state = STATE_MENU
	menuCount = 5
	menuTop = 250
	menuSelected = 0
	menuText(0) = "Play (start at level " + optStartLevel + ")"
	menuText(1) = "Options"
	menuText(2) = "High scores"
	menuText(3) = "How to play"
	menuText(4) = "Quit"
	FlushKeys
	FlushMouse
	IgnoreMouseMoves()
End Function

; MouseXSpeed and MouseYSpeed tell how far the mouse moved since they were last asked. Asking once here forgets any
; old movement, so a mouse that is just resting over a menu does not pick a line when the menu opens.
Function IgnoreMouseMoves()
	MouseXSpeed()
	MouseYSpeed()
End Function

; Gives back True when the player chose Quit.
Function UpdateMenu()
	If KeyHit(BB_KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0 : StartGame()
		Case 1 : GoToOptions()
		Case 2
			state = STATE_SCORES
			newRank = -1
			FlushMouse
		Case 3
			state = STATE_HELP
			FlushMouse
		Case 4 : Return True
	End Select
	Return False
End Function

Function GoToOptions()
	state = STATE_OPTIONS
	menuCount = 6
	menuTop = 240
	menuSelected = 0
	RefreshOptionsText()
	FlushMouse
	IgnoreMouseMoves()
End Function

Function RefreshOptionsText()
	menuText(0) = "Start at level: " + optStartLevel
	If optGhost Then menuText(1) = "Landing shadow: on" Else menuText(1) = "Landing shadow: off"
	menuText(2) = "Next pieces shown: " + optPreview
	If optSound Then menuText(3) = "Sound: on" Else menuText(3) = "Sound: off"
	If optFullscreen Then menuText(4) = "Display: full screen" Else menuText(4) = "Display: window"
	menuText(5) = "Back"
End Function

Function UpdateOptions()
	Local change = 0
	If KeyHit(BB_KEY_LEFT) Then change = -1
	If KeyHit(BB_KEY_RIGHT) Then change = 1
	Local chosen = MenuInput()
	If chosen >= 0 Then change = 1

	If KeyHit(BB_KEY_ESCAPE) Or chosen = 5
		SaveSettings()
		GoToMenu()
		menuSelected = 1
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optStartLevel = (optStartLevel - 1 + change + 15) Mod 15 + 1 ; 1 to 15, going round.
		Case 1 : optGhost = Not optGhost
		Case 2
			optPreview = optPreview + change * 2
			If optPreview > 5 Then optPreview = 1
			If optPreview < 1 Then optPreview = 5
		Case 3 : optSound = Not optSound
		Case 4
			optFullscreen = Not optFullscreen
			OpenScreen()
	End Select
	PlaySfx(soundTurn)
	RefreshOptionsText()
End Function

Function DrawMenuScreen()
	; All seven pieces as the title picture.
	Local i
	For i = 0 To KINDS - 1
		DrawPiece(i, 130 + i * 90, 110)
	Next
	Color 255, 255, 255
	Text SCREEN_W / 2, 190, "B L O C K   D R O P", True, True

	Select state
		Case STATE_MENU, STATE_OPTIONS
			For i = 0 To menuCount - 1
				If i = menuSelected
					Color 40, 50, 90
					Rect SCREEN_W / 2 - 170, menuTop + i * 34, 340, 30, 1
					Color 255, 240, 160
				Else
					Color 210, 215, 240
				EndIf
				Text SCREEN_W / 2, menuTop + i * 34 + 15, menuText(i), True, True
			Next
			Color 130, 140, 180
			If state = STATE_MENU
				Text SCREEN_W / 2, 470, "Up / Down or the mouse to choose, Enter or a click to select.", True, True
			Else
				Text SCREEN_W / 2, 470, "Left / Right or a click change the option, Escape goes back.", True, True
			EndIf
		Case STATE_SCORES
			Color 255, 240, 160
			Text 190, 240, "Score"
			Text 330, 240, "Rows"
			Text 420, 240, "Level"
			Text 510, 240, "Date"
			For i = 0 To 4
				If i = newRank Then Color 255, 240, 160 Else Color 210, 215, 240
				Text 160, 275 + i * 28, (i + 1) + "."
				If bestScore(i) > 0
					Text 190, 275 + i * 28, bestScore(i)
					Text 330, 275 + i * 28, bestRows(i)
					Text 420, 275 + i * 28, bestLevel(i)
					Text 510, 275 + i * 28, bestDate(i)
				Else
					Text 190, 275 + i * 28, "-"
				EndIf
			Next
			Color 130, 140, 180
			Text SCREEN_W / 2, 470, "Press Enter or click to go back.", True, True
		Case STATE_HELP
			Color 210, 215, 240
			Text SCREEN_W / 2, 240, "Fill whole rows with the falling pieces. A full row disappears.", True, True
			Text SCREEN_W / 2, 265, "More rows at once give more points: four at once give the most.", True, True
			Text SCREEN_W / 2, 290, "Every ten rows the level goes up and the pieces fall faster.", True, True
			Text SCREEN_W / 2, 315, "The game ends when there is no room left at the top.", True, True
			Text SCREEN_W / 2, 350, "Left / Right move, Up or X turns clockwise, Z the other way.", True, True
			Text SCREEN_W / 2, 375, "Down drops faster, Space drops at once, C holds a piece for later.", True, True
			Text SCREEN_W / 2, 400, "Escape or P pauses the game.", True, True
			Color 130, 140, 180
			Text SCREEN_W / 2, 470, "Press Enter or click to go back.", True, True
	End Select
	Color 100, 110, 150
	Text SCREEN_W / 2, SCREEN_H - 20, "A BlitzLLVM sample game", True, True
End Function

; --- The pause menu --------------------------------------------------------------------------------------------------

Function GoToPause()
	state = STATE_PAUSED
	menuCount = 3
	menuTop = 250
	menuSelected = 0
	menuText(0) = "Continue"
	menuText(1) = "Start again"
	menuText(2) = "Back to the main menu"
	FlushMouse
	IgnoreMouseMoves()
End Function

Function UpdatePause()
	If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_P)
		state = STATE_PLAY
		FlushKeys
		Return
	EndIf
	Select MenuInput()
		Case 0
			state = STATE_PLAY
			FlushKeys
		Case 1 : StartGame()
		Case 2 : GoToMenu()
	End Select
End Function

; --- Playing ---------------------------------------------------------------------------------------------------------

Function StartGame()
	Local x, y, i
	For y = 0 To ROWS - 1
		For x = 0 To COLUMNS - 1
			well(x, y) = 0
		Next
		fullRow(y) = False
	Next
	score = 0
	clearedRows = 0
	level = optStartLevel
	holdKind = -1
	bagLeft = 0
	For i = 0 To 5
		queue(i) = FromBag()
	Next
	heldDir = 0
	clearFrames = 0
	messageFrames = 0
	state = STATE_PLAY
	FlushKeys
	FlushMouse
	NextPiece()
End Function

; The bag holds one piece of each kind. It hands them out in a random order and is filled again once it is empty.
Function FromBag()
	Local i, j, swap
	If bagLeft = 0
		For i = 0 To KINDS - 1
			bag(i) = i
		Next
		For i = 0 To KINDS - 2 ; Shuffle as in tutorial 2.10.
			j = Rand(i, KINDS - 1)
			swap = bag(i) : bag(i) = bag(j) : bag(j) = swap
		Next
		bagLeft = KINDS
	EndIf
	bagLeft = bagLeft - 1
	Return bag(bagLeft)
End Function

; Takes the first piece of the queue and moves the others up.
Function NextPiece()
	Local i, k = queue(0)
	For i = 0 To 4
		queue(i) = queue(i + 1)
	Next
	queue(5) = FromBag()
	holdUsed = False
	SpawnPiece(k)
End Function

; Puts a piece at the top, in the middle. Its lowest row is the first visible row of the well.
Function SpawnPiece(k)
	kind = k
	turn = 0
	pieceX = (COLUMNS - pieceSize(k)) / 2
	pieceY = HIDDEN_ROWS - 1
	fallTime = 0
	lockFrames = 0
	lockMoves = 0
	If Not Fits(kind, turn, pieceX, pieceY) Then EndGame() ; No room: the well is full.
End Function

; True when the piece fits at this place: inside the well and only on empty cells.
Function Fits(k, t, px, py)
	Local i, x, y
	For i = 0 To 3
		x = px + cellX(k, t, i)
		y = py + cellY(k, t, i)
		If x < 0 Or x >= COLUMNS Or y < 0 Or y >= ROWS Then Return False
		; This needs its own line: Blitz always works out both sides of an Or, so "x < 0 Or well(x, y) <> 0" would
		; look outside the array when x is -1.
		If well(x, y) <> 0 Then Return False
	Next
	Return True
End Function

Function TryMove(dx, dy)
	If Not Fits(kind, turn, pieceX + dx, pieceY + dy) Then Return False
	pieceX = pieceX + dx
	pieceY = pieceY + dy
	PutOffLocking()
	Return True
End Function

Function MoveSideways(dir)
	If TryMove(dir, 0) Then PlaySfx(soundMove)
End Function

; Turns the piece by a quarter: dir is 1 for clockwise, -1 for the other way.
Function TryTurn(dir)
	Local t = (turn + dir + 4) Mod 4, i
	For i = 0 To 5
		If Fits(kind, t, pieceX + kickX(i), pieceY + kickY(i))
			turn = t
			pieceX = pieceX + kickX(i)
			pieceY = pieceY + kickY(i)
			PutOffLocking()
			PlaySfx(soundTurn)
			Return True
		EndIf
	Next
	Return False
End Function

; A piece that lies on something locks after half a second. Moving or turning it starts that time again, but only
; 15 times, or a player could keep a piece alive forever.
Function PutOffLocking()
	If lockFrames > 0 And lockMoves < 15
		lockFrames = 0
		lockMoves = lockMoves + 1
	EndIf
End Function

Function HoldPiece()
	If holdUsed Then Return
	Local k = holdKind
	holdKind = kind
	If k < 0
		NextPiece()
	Else
		SpawnPiece(k)
	EndIf
	holdUsed = True
	PlaySfx(soundTurn)
End Function

Function UpdatePlay()
	If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_P)
		GoToPause()
		Return
	EndIf
	If messageFrames > 0 Then messageFrames = messageFrames - 1

	; Full rows flash for a moment before they go. No piece falls meanwhile.
	If clearFrames > 0
		clearFrames = clearFrames - 1
		If clearFrames = 0
			RemoveFullRows()
			NextPiece()
		EndIf
		Return
	EndIf

	; Left / Right: KeyHit moves one step for every press, even a tap so short that it falls between two frames.
	; KeyDown then repeats the step while the key is held: after 10 frames, one step every 3 frames.
	If KeyHit(BB_KEY_LEFT) Then MoveSideways(-1)
	If KeyHit(BB_KEY_RIGHT) Then MoveSideways(1)
	Local dir = KeyDown(BB_KEY_RIGHT) - KeyDown(BB_KEY_LEFT)
	If dir <> heldDir Then repeatFrames = 0
	heldDir = dir
	If dir <> 0
		repeatFrames = repeatFrames + 1
		If repeatFrames >= 10 And (repeatFrames - 10) Mod 3 = 0 Then MoveSideways(dir)
	EndIf

	If KeyHit(BB_KEY_UP) Or KeyHit(BB_KEY_X) Then TryTurn(1)
	If KeyHit(BB_KEY_Z) Or KeyHit(BB_KEY_LCTRL) Then TryTurn(-1)
	If KeyHit(BB_KEY_C) Or KeyHit(BB_KEY_LSHIFT) Or KeyHit(BB_KEY_RSHIFT)
		HoldPiece()
		If state <> STATE_PLAY Then Return ; The held piece had no room: game over.
	EndIf

	; Space drops the piece all the way and locks it at once. Each row is worth 2 points.
	If KeyHit(BB_KEY_SPACE)
		While Fits(kind, turn, pieceX, pieceY + 1)
			pieceY = pieceY + 1
			score = score + 2
		Wend
		LockPiece()
		Return
	EndIf

	; Falling. The time for one row starts at 1 second and shrinks with every level. ^ raises to a power:
	; level 1 gives 0.8 ^ 0 = 1, level 5 0.772 ^ 4 = 0.36, level 15 0.702 ^ 14 = 0.007 seconds.
	Local rowTime# = (0.8 - (level - 1) * 0.007) ^ (level - 1)
	Local soft = KeyDown(BB_KEY_DOWN)
	If soft Then rowTime = rowTime / 20 ; Down makes it twenty times faster, for 1 point per row.

	fallTime = fallTime + 1.0 / 60
	If Fits(kind, turn, pieceX, pieceY + 1)
		lockFrames = 0
		; At high levels a piece falls more than one row in a frame.
		While fallTime >= rowTime And Fits(kind, turn, pieceX, pieceY + 1)
			fallTime = fallTime - rowTime
			pieceY = pieceY + 1
			If soft Then score = score + 1
		Wend
	Else
		fallTime = 0
		lockFrames = lockFrames + 1
		If lockFrames >= 30 Then LockPiece()
	EndIf
End Function

; Writes the piece into the well, then looks for full rows.
Function LockPiece()
	Local i, x, y, aboveWell = True, full = 0, points
	For i = 0 To 3
		x = pieceX + cellX(kind, turn, i)
		y = pieceY + cellY(kind, turn, i)
		well(x, y) = kind + 1
		If y >= HIDDEN_ROWS Then aboveWell = False
	Next
	kind = -1
	PlaySfx(soundLock)

	For y = 0 To ROWS - 1
		fullRow(y) = True
		For x = 0 To COLUMNS - 1
			If well(x, y) = 0 Then fullRow(y) = False
		Next
		If fullRow(y) Then full = full + 1
	Next

	If full > 0
		Select full
			Case 1
				points = 100
				message = "Single"
			Case 2
				points = 300
				message = "Double"
			Case 3
				points = 500
				message = "Triple"
			Default
				points = 800
				message = "Four rows!"
		End Select
		score = score + points * level
		clearedRows = clearedRows + full
		If optStartLevel + clearedRows / 10 > level
			level = optStartLevel + clearedRows / 10
			message = message + "  Level " + level
			PlaySfx(soundLevel)
		ElseIf full = 4
			PlaySfx(soundFour)
		Else
			PlaySfx(soundClear)
		EndIf
		messageFrames = 90
		clearFrames = 20
	ElseIf aboveWell
		EndGame() ; The whole piece is above the well: it is full.
	Else
		NextPiece()
	EndIf
End Function

; Walks up from the bottom and copies every row that is not full down to the next free place. Whatever is left at
; the top becomes empty.
Function RemoveFullRows()
	Local x, y, target = ROWS - 1
	For y = ROWS - 1 To 0 Step -1
		If Not fullRow(y)
			For x = 0 To COLUMNS - 1
				well(x, target) = well(x, y)
			Next
			target = target - 1
		EndIf
	Next
	For y = target To 0 Step -1
		For x = 0 To COLUMNS - 1
			well(x, y) = 0
		Next
	Next
	For y = 0 To ROWS - 1
		fullRow(y) = False
	Next
End Function

; --- The end of a game and the high scores ---------------------------------------------------------------------------

Function EndGame()
	state = STATE_OVER
	overFrames = 0
	PlaySfx(soundOver)

	; The table is kept in order, best first. Find the first score this one beats, move everything from there down by
	; one place (the last one drops out) and put the new score in the gap.
	Local i, j
	newRank = -1
	For i = 0 To 4
		If score > bestScore(i)
			For j = 4 To i + 1 Step -1
				bestScore(j) = bestScore(j - 1)
				bestRows(j) = bestRows(j - 1)
				bestLevel(j) = bestLevel(j - 1)
				bestDate(j) = bestDate(j - 1)
			Next
			bestScore(i) = score
			bestRows(i) = clearedRows
			bestLevel(i) = level
			bestDate(i) = CurrentDate$()
			newRank = i
			Exit
		EndIf
	Next
	SaveSettings()
End Function

Function UpdateOver()
	overFrames = overFrames + 1
	; Wait a moment first, so that a key still held from playing does not skip this screen.
	If overFrames < 45
		FlushKeys
		FlushMouse
		Return
	EndIf
	If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Or MouseHit(BB_MOUSE_LEFT)
		If newRank >= 0
			GoToMenu()
			state = STATE_SCORES ; Show the table with the new score in it.
		Else
			GoToMenu()
		EndIf
	EndIf
End Function

; --- Drawing the game ------------------------------------------------------------------------------------------------

Function DrawGame()
	Local x, y, i, wellW = COLUMNS * CELL, wellH = (ROWS - HIDDEN_ROWS) * CELL
	Local showBlocks = (state <> STATE_PAUSED) ; Paused: hide the well, so nobody can plan while the game stands still.

	; The well, with faint lines between the cells.
	Color 60, 70, 115
	Rect WELL_X - 4, WELL_Y - 4, wellW + 8, wellH + 8, 1
	Color 8, 10, 20
	Rect WELL_X, WELL_Y, wellW, wellH, 1
	Color 20, 24, 40
	For x = 1 To COLUMNS - 1
		Line WELL_X + x * CELL, WELL_Y, WELL_X + x * CELL, WELL_Y + wellH - 1
	Next
	For y = 1 To ROWS - HIDDEN_ROWS - 1
		Line WELL_X, WELL_Y + y * CELL, WELL_X + wellW - 1, WELL_Y + y * CELL
	Next

	If showBlocks
		; The blocks lying in the well. Full rows blink white before they go.
		For y = HIDDEN_ROWS To ROWS - 1
			For x = 0 To COLUMNS - 1
				If well(x, y) <> 0
					If fullRow(y) And (clearFrames / 4) Mod 2 = 0
						Color 255, 255, 255
						Rect WELL_X + x * CELL, WELL_Y + (y - HIDDEN_ROWS) * CELL, CELL, CELL, 1
					Else
						DrawImage blockImage(well(x, y) - 1), WELL_X + x * CELL, WELL_Y + (y - HIDDEN_ROWS) * CELL
					EndIf
				EndIf
			Next
		Next

		If kind >= 0
			; The landing shadow: an outline where the piece would land if it dropped now.
			If optGhost
				Local landY = pieceY
				While Fits(kind, turn, pieceX, landY + 1)
					landY = landY + 1
				Wend
				Color pieceRed(kind) / 2, pieceGreen(kind) / 2, pieceBlue(kind) / 2
				For i = 0 To 3
					y = landY + cellY(kind, turn, i)
					If y >= HIDDEN_ROWS
						x = WELL_X + (pieceX + cellX(kind, turn, i)) * CELL
						Rect x + 1, WELL_Y + (y - HIDDEN_ROWS) * CELL + 1, CELL - 2, CELL - 2, 0
					EndIf
				Next
			EndIf
			; The piece itself. Blocks still above the well are not drawn.
			For i = 0 To 3
				y = pieceY + cellY(kind, turn, i)
				If y >= HIDDEN_ROWS
					DrawImage blockImage(kind), WELL_X + (pieceX + cellX(kind, turn, i)) * CELL, WELL_Y + (y - HIDDEN_ROWS) * CELL
				EndIf
			Next
		EndIf
	EndIf

	; Left: the held piece and the numbers.
	DrawPanel(80, WELL_Y, "HOLD")
	If holdKind >= 0 And showBlocks
		DrawPiece(holdKind, 150, WELL_Y + 70)
		If holdUsed ; Darken it while it cannot be swapped.
			Color 8, 10, 20
			For y = WELL_Y + 34 To WELL_Y + 110 Step 2
				Line 82, y, 218, y
			Next
		EndIf
	EndIf
	Color 150, 160, 210
	Text 80, 220, "SCORE"
	Text 80, 280, "LEVEL"
	Text 80, 340, "ROWS"
	Color 255, 255, 255
	Text 80, 240, score
	Text 80, 300, level
	Text 80, 360, clearedRows

	; Right: the next pieces.
	DrawPanel(580, WELL_Y, "NEXT")
	If showBlocks
		DrawPiece(queue(0), 650, WELL_Y + 70)
		For i = 1 To optPreview - 1
			DrawPiece(queue(i), 650, WELL_Y + 90 + i * 72)
		Next
	EndIf

	If messageFrames > 0 And showBlocks
		Color 255, 240, 160
		Text WELL_X + wellW / 2, WELL_Y + 120, message, True, True
	EndIf

	Color 100, 110, 150
	Text SCREEN_W / 2, SCREEN_H - 20, "A BlitzLLVM sample game", True, True

	If state = STATE_PAUSED Then DrawPause()
	If state = STATE_OVER Then DrawOver()
End Function

Function DrawPanel(x, y, title$)
	Color 60, 70, 115
	Rect x, y, 140, 120, 0
	Color 150, 160, 210
	Text x + 70, y + 14, title, True, True
End Function

; Draws a piece in its first turn, centred on (cx, cy).
Function DrawPiece(k, cx, cy)
	Local i, minX = 3, maxX = 0, minY = 3, maxY = 0
	For i = 0 To 3
		If cellX(k, 0, i) < minX Then minX = cellX(k, 0, i)
		If cellX(k, 0, i) > maxX Then maxX = cellX(k, 0, i)
		If cellY(k, 0, i) < minY Then minY = cellY(k, 0, i)
		If cellY(k, 0, i) > maxY Then maxY = cellY(k, 0, i)
	Next
	Local left0 = cx - (maxX - minX + 1) * CELL / 2, top0 = cy - (maxY - minY + 1) * CELL / 2
	For i = 0 To 3
		DrawImage blockImage(k), left0 + (cellX(k, 0, i) - minX) * CELL, top0 + (cellY(k, 0, i) - minY) * CELL
	Next
End Function

Function DrawPause()
	Color 255, 255, 255
	Text WELL_X + COLUMNS * CELL / 2, 200, "PAUSED", True, True
	Local i
	For i = 0 To menuCount - 1
		If i = menuSelected
			Color 40, 50, 90
			Rect SCREEN_W / 2 - 170, menuTop + i * 34, 340, 30, 1
			Color 255, 240, 160
		Else
			Color 210, 215, 240
		EndIf
		Text SCREEN_W / 2, menuTop + i * 34 + 15, menuText(i), True, True
	Next
End Function

Function DrawOver()
	Local cx = WELL_X + COLUMNS * CELL / 2
	Color 8, 10, 20
	Rect WELL_X - 30, 190, COLUMNS * CELL + 60, 150, 1
	Color 60, 70, 115
	Rect WELL_X - 30, 190, COLUMNS * CELL + 60, 150, 0
	Color 255, 255, 255
	Text cx, 215, "GAME OVER", True, True
	Color 210, 215, 240
	Text cx, 250, "Score: " + score, True, True
	If newRank >= 0
		Color 255, 240, 160
		Text cx, 275, "New high score, place " + (newRank + 1) + "!", True, True
	EndIf
	If overFrames >= 45
		Color 130, 140, 180
		Text cx, 315, "Press Enter", True, True
	EndIf
End Function

; --- Pictures made in code -------------------------------------------------------------------------------------------

; One block per kind: the colour, a light edge at the top and left, a dark edge at the bottom and right, so it looks
; raised.
Function MakeBlockImages()
	Local k, r, g, b
	For k = 0 To KINDS - 1
		r = pieceRed(k)
		g = pieceGreen(k)
		b = pieceBlue(k)
		blockImage(k) = CreateImage(CELL, CELL)
		SetBuffer ImageBuffer(blockImage(k))
		Color r, g, b
		Rect 0, 0, CELL, CELL, 1
		Color Brighter(r), Brighter(g), Brighter(b)
		Rect 0, 0, CELL, 3, 1
		Rect 0, 0, 3, CELL, 1
		Color r * 55 / 100 + 1, g * 55 / 100 + 1, b * 55 / 100 + 1 ; + 1, so that it never becomes black: see below.
		Rect 0, CELL - 3, CELL, 3, 1
		Rect CELL - 3, 0, 3, CELL, 1
		Color (r + Brighter(r)) / 2, (g + Brighter(g)) / 2, (b + Brighter(b)) / 2
		Rect 6, 6, CELL - 12, CELL - 12, 1
	Next
	SetBuffer BackBuffer()
End Function

Function Brighter(value)
	value = value + 80
	If value > 255 Then value = 255
	Return value
End Function

; --- A hidden watermark ----------------------------------------------------------------------------------------------
; Every frame carries a pattern that nobody can see: some pixels of the background are one step bluer. A program can
; find it again in a screenshot, which shows that the picture came from this sample. See tutorial 2.09.
; Black pixels of an image are see-through when it is drawn, which is why everything else in the image is black, and
; why the blocks above are never fully black.

Function DrawWatermark()
	If watermark = 0
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				If (x * 7 + y * 13) Mod 29 < 3
					WritePixelFast x, y, (14 Shl 16) Or (16 Shl 8) Or 29, buffer
				Else
					WritePixelFast x, y, 0, buffer
				EndIf
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function

; --- Sounds made in code, as in tutorial 2.07 ------------------------------------------------------------------------

Function MakeSound(hz#, lengthMs, noise)
	Local rate = 22050, samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2), i, v#
	PokeInt bank, 0, $46464952      ; "RIFF"
	PokeInt bank, 4, 36 + samples * 2
	PokeInt bank, 8, $45564157      ; "WAVE"
	PokeInt bank, 12, $20746D66     ; "fmt "
	PokeInt bank, 16, 16
	PokeShort bank, 20, 1
	PokeShort bank, 22, 1
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2
	PokeShort bank, 32, 2
	PokeShort bank, 34, 16
	PokeInt bank, 36, $61746164     ; "data"
	PokeInt bank, 40, samples * 2
	For i = 0 To samples - 1
		If noise Then v = Rnd(-1, 1) Else v = Sin(i * hz * 360.0 / rate) * Sin(i * 180.0 / samples)
		v = v * (1.0 - Float(i) / samples) * 0.4
		PokeShort bank, 44 + i * 2, Int(v * 32767) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right$(path, 1) <> "\" And Right$(path, 1) <> "/" Then path = path + "/"
	path = path + "block-drop-" + MilliSecs() + "-" + Rand(1000, 9999) + ".wav"
	Local file = WriteFile(path)
	If file
		WriteBytes bank, file, 0, BankSize(bank)
		CloseFile file
	EndIf
	FreeBank bank
	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

