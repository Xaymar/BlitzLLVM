; Tutorial 2.09: A Complete Game: Minefield
;
; This tutorial is a whole small game: a field of covered squares hides some mines. Uncover a square, and it shows
; how many mines touch it. Use the numbers to find every square without a mine. Mark the squares you think hide a
; mine with a flag.
;
; It puts the earlier tutorials together and adds what a finished game needs around the game itself:
;
;   - A main menu and an options screen that work with the mouse and with the keyboard.
;   - Options that are saved to a file, so they are still set the next time the game starts.
;   - Switching between a window and full screen while the game runs.
;   - Best times, also saved.
;
; The game itself shows 2D arrays (the field), a flood fill (uncovering a whole empty area at once) and how to turn
; the mouse position into a square of a grid.
;
; Controls: left click uncovers a square, right click puts a flag on it (or a question mark, if that option is on).
; Left click on a number whose mines are all flagged uncovers the squares around it. Escape goes back to the menu.

Include "<keys.bb>"
Include "<mouse.bb>"
Include "<graphics.bb>"

; --- Constants and settings ---------------------------------------------------------------------------------------

Const SCREEN_W = 640, SCREEN_H = 480
Const TILE = 22                  ; Size of one square in pixels.
Const MAX_COLS = 24, MAX_ROWS = 16

; The screens the game can show. See tutorial 2.08 for how a state machine works.
Const STATE_MENU = 0, STATE_OPTIONS = 1, STATE_BEST = 2, STATE_PLAY = 3, STATE_WON = 4, STATE_LOST = 5

; What the player put on a covered square.
Const MARK_NONE = 0, MARK_FLAG = 1, MARK_QUESTION = 2

; The three field sizes: columns, rows and mines. Data keeps them together and easy to change.
Dim sizeName$(2), sizeCols(2), sizeRows(2), sizeMines(2)
Restore fieldSizes
Local i
For i = 0 To 2
	Read sizeName(i), sizeCols(i), sizeRows(i), sizeMines(i)
Next

; The options. Their values are loaded from the settings file below, if there is one.
Global optSize = 1            ; 0 small, 1 medium, 2 large.
Global optQuestion = False    ; Right click also gives a question mark.
Global optSound = True
Global optFullscreen = False

; The best time for each size, in seconds. 0 means "no time yet".
Dim bestTime(2)

; The settings file sits next to the program. SystemProperty$("appdir") is the folder of the running program.
Global settingsPath$ = SystemProperty$("appdir")
If settingsPath <> "" And Right$(settingsPath, 1) <> "\" And Right$(settingsPath, 1) <> "/" Then settingsPath = settingsPath + "/"
settingsPath = settingsPath + "minefield.cfg"
LoadSettings()

; --- The field ----------------------------------------------------------------------------------------------------
; One array per thing a square knows. Dim(23, 15) gives 24 by 16 squares, the largest field.
Dim mine(MAX_COLS - 1, MAX_ROWS - 1)      ; True where a mine is.
Dim around(MAX_COLS - 1, MAX_ROWS - 1)    ; How many mines touch the square.
Dim open(MAX_COLS - 1, MAX_ROWS - 1)      ; True when uncovered.
Dim mark(MAX_COLS - 1, MAX_ROWS - 1)      ; MARK_NONE, MARK_FLAG or MARK_QUESTION.

; A list of squares still to uncover, for the flood fill. Each square goes in at most once.
Dim fillX(MAX_COLS * MAX_ROWS), fillY(MAX_COLS * MAX_ROWS)

Global cols, rows, mineCount
Global boardX, boardY          ; Top left corner of the field on the screen.
Global minesPlaced             ; Mines are placed on the first click, so the first click is always safe.
Global openCount, flagCount
Global startTime, endTime      ; MilliSecs() at the first click and at the end.
Global hitX = -1, hitY = -1    ; The mine that went off.
Global newBest

; --- Menus --------------------------------------------------------------------------------------------------------
Dim menuText$(5)
Global menuCount, menuSelected
Global state = STATE_MENU

; --- Sounds, made in code like in tutorial 2.07 ------------------------------------------------------------------
Global soundClick, soundFlag, soundBoom, soundWin

; --- Start --------------------------------------------------------------------------------------------------------
OpenScreen()
soundClick = MakeSound(880, 40, False)
soundFlag = MakeSound(520, 70, False)
soundBoom = MakeSound(60, 700, True)
soundWin = MakeSound(1320, 400, False)

Local timer = CreateTimer(60)
Local quit = False

While Not quit
	WaitTimer timer

	Select state
		Case STATE_MENU
			quit = UpdateMainMenu()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_BEST
			If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_ENTER) Or MouseHit(BB_MOUSE_LEFT) Then state = STATE_MENU
		Case STATE_PLAY
			UpdatePlay()
		Case STATE_WON, STATE_LOST
			If KeyHit(BB_KEY_R) Then StartGame()
			If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_ENTER) Or MouseHit(BB_MOUSE_LEFT) Then GoToMenu()
	End Select

	Cls
	DrawWatermark()
	Select state
		Case STATE_MENU
			DrawTitle()
			DrawMenu(240)
		Case STATE_OPTIONS
			DrawTitle()
			DrawMenu(200)
			Color 150, 160, 190
			Text SCREEN_W / 2, 420, "Up / Down choose, Left / Right or click change, Escape goes back.", True, True
		Case STATE_BEST
			DrawBestTimes()
		Default
			DrawField()
			DrawHud()
			If state = STATE_WON Then DrawBanner("Cleared!", "R plays again, Enter or a click goes to the menu.")
			If state = STATE_LOST Then DrawBanner("Boom.", "R tries again, Enter or a click goes to the menu.")
	End Select
	Flip 0
Wend
SaveSettings()
End

; --- Screen and settings ------------------------------------------------------------------------------------------

; Opens the window or full screen, as the option says. Calling Graphics again is how a Blitz program switches: it
; frees all images and fonts, so a game that has any loads them again afterwards. This one draws everything with
; Rect, Oval and Text every frame, so there is nothing to reload. Sounds and timers survive.
Function OpenScreen()
	If optFullscreen Then Graphics SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_FULLSCREEN Else Graphics SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_WINDOWED
	AppTitle "Minefield"
	SetBuffer BackBuffer()
	SeedRnd MilliSecs()
	watermark = 0 ; Graphics freed the old watermark image.
End Function

Function LoadSettings()
	; FileType gives 1 for a file, 0 when there is none, for example the first time the game runs.
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	; The first number is a version. If the file format ever changes, old files can still be recognised.
	If ReadInt(file) = 1
		optSize = ReadInt(file)
		optQuestion = ReadInt(file)
		optSound = ReadInt(file)
		optFullscreen = ReadInt(file)
		Local i
		For i = 0 To 2
			bestTime(i) = ReadInt(file)
		Next
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optSize < 0 Or optSize > 2 Then optSize = 1
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; The folder may be read-only. The game still works, it just forgets the options.
	WriteInt file, 1
	WriteInt file, optSize
	WriteInt file, optQuestion
	WriteInt file, optSound
	WriteInt file, optFullscreen
	Local i
	For i = 0 To 2
		WriteInt file, bestTime(i)
	Next
	CloseFile file
End Function

; --- Menus --------------------------------------------------------------------------------------------------------
; A menu is a list of lines and the number of the selected one. The keyboard moves the selection, and the mouse
; selects whatever line it is over. MenuInput gives back the line that was chosen with Enter, Space or a click, or
; -1 if nothing was chosen this frame.

Function MenuInput(top)
	If KeyHit(BB_KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount
	If KeyHit(BB_KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount

	Local line = MenuLineAt(top, MouseX(), MouseY())
	If line >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = line ; Only when the mouse moves.

	If KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Then Return menuSelected
	If MouseHit(BB_MOUSE_LEFT) And line >= 0
		menuSelected = line
		Return line
	EndIf
	Return -1
End Function

; Which menu line is at a screen position, or -1. Each line is 36 pixels high and 320 wide.
Function MenuLineAt(top, x, y)
	If x < SCREEN_W / 2 - 160 Or x >= SCREEN_W / 2 + 160 Or y < top Then Return -1
	Local line = (y - top) / 36
	If line >= menuCount Then Return -1
	Return line
End Function

Function DrawMenu(top)
	Local i, y
	For i = 0 To menuCount - 1
		y = top + i * 36
		If i = menuSelected
			Color 60, 90, 160
			Rect SCREEN_W / 2 - 160, y, 320, 32, 1
			Color 255, 255, 255
		Else
			Color 170, 180, 210
		EndIf
		Text SCREEN_W / 2, y + 16, menuText(i), True, True
	Next
End Function

Function DrawTitle()
	; The title is drawn with squares, like an uncovered field.
	Local word$ = "MINEFIELD", i, x
	x = SCREEN_W / 2 - Len(word) * 30 / 2
	For i = 1 To Len(word)
		DrawCoveredSquare(x + (i - 1) * 30, 90, 28)
		Color 230, 240, 255
		Text x + (i - 1) * 30 + 14, 104, Mid$(word, i, 1), True, True
	Next
	Color 120, 130, 160
	Text SCREEN_W / 2, 150, "Find every square without a mine.", True, True
	Color 80, 90, 120
	Text SCREEN_W / 2, SCREEN_H - 20, "A BlitzLLVM sample game", True, True
End Function

Function GoToMenu()
	state = STATE_MENU
	menuCount = 4
	menuText(0) = "Play (" + sizeName(optSize) + ")"
	menuText(1) = "Options"
	menuText(2) = "Best times"
	menuText(3) = "Quit"
	FlushKeys ; Forget keys pressed on the screen before, so they don't act here too.
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

; Gives back True when the player chose Quit.
Function UpdateMainMenu()
	If menuCount = 0 Then GoToMenu() ; The very first frame.
	If KeyHit(BB_KEY_ESCAPE) Then Return True
	Select MenuInput(240)
		Case 0
			StartGame()
		Case 1
			GoToOptions()
		Case 2
			state = STATE_BEST
			FlushMouse
		Case 3
			Return True
	End Select
	Return False
End Function

Function GoToOptions()
	state = STATE_OPTIONS
	menuCount = 5
	menuSelected = 0
	RefreshOptionsText()
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

Function RefreshOptionsText()
	menuText(0) = "Field: " + sizeName(optSize) + " (" + sizeCols(optSize) + " x " + sizeRows(optSize) + ", " + sizeMines(optSize) + " mines)"
	menuText(1) = "Question marks: " + OnOff$(optQuestion)
	menuText(2) = "Sound: " + OnOff$(optSound)
	If optFullscreen Then menuText(3) = "Display: full screen" Else menuText(3) = "Display: window"
	menuText(4) = "Back"
End Function

Function OnOff$(value)
	If value Then Return "on"
	Return "off"
End Function

Function UpdateOptions()
	Local change = 0
	If KeyHit(BB_KEY_LEFT) Then change = -1
	If KeyHit(BB_KEY_RIGHT) Then change = 1
	Local chosen = MenuInput(200)
	If chosen >= 0 Then change = 1 ; Enter or a click steps to the next value.

	If KeyHit(BB_KEY_ESCAPE) Or (chosen = 4)
		SaveSettings()
		GoToMenu()
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0
			optSize = (optSize + change + 3) Mod 3
		Case 1
			optQuestion = Not optQuestion
		Case 2
			optSound = Not optSound
		Case 3
			optFullscreen = Not optFullscreen
			OpenScreen()
	End Select
	If optSound Then PlaySound soundClick
	RefreshOptionsText()
End Function

Function DrawBestTimes()
	DrawTitle()
	Local i
	For i = 0 To 2
		Color 200, 210, 240
		Text SCREEN_W / 2 - 120, 230 + i * 30, sizeName(i)
		If bestTime(i) > 0
			Text SCREEN_W / 2 + 120, 230 + i * 30, FormatTime$(bestTime(i) * 1000), True
		Else
			Color 120, 130, 160
			Text SCREEN_W / 2 + 120, 230 + i * 30, "-", True
		EndIf
	Next
	Color 150, 160, 190
	Text SCREEN_W / 2, 420, "Press Enter or click to go back.", True, True
End Function

; --- The game -----------------------------------------------------------------------------------------------------

Function StartGame()
	cols = sizeCols(optSize)
	rows = sizeRows(optSize)
	mineCount = sizeMines(optSize)
	boardX = (SCREEN_W - cols * TILE) / 2
	boardY = 44 + (SCREEN_H - 88 - rows * TILE) / 2 ; Between the bars at the top and the bottom.

	Local x, y
	For y = 0 To rows - 1
		For x = 0 To cols - 1
			mine(x, y) = False
			open(x, y) = False
			mark(x, y) = MARK_NONE
			around(x, y) = 0
		Next
	Next
	minesPlaced = False
	openCount = 0
	flagCount = 0
	startTime = 0
	endTime = 0
	hitX = -1
	newBest = False
	state = STATE_PLAY
	FlushMouse
End Function

; Puts the mines on random squares, but never on the first square clicked or next to it. Then counts, for every
; square, how many mines touch it.
Function PlaceMines(safeX, safeY)
	Local placed = 0, x, y, dx, dy
	While placed < mineCount
		x = Rand(0, cols - 1)
		y = Rand(0, rows - 1)
		; Not works on everything to its right, so "Not a And b" means "Not (a And b)". The brackets keep it to the
		; mine check alone.
		If (Not mine(x, y)) And (Abs(x - safeX) > 1 Or Abs(y - safeY) > 1)
			mine(x, y) = True
			placed = placed + 1
		EndIf
	Wend

	For y = 0 To rows - 1
		For x = 0 To cols - 1
			For dy = -1 To 1
				For dx = -1 To 1
					If InField(x + dx, y + dy)
						If mine(x + dx, y + dy) Then around(x, y) = around(x, y) + 1
					EndIf
				Next
			Next
		Next
	Next
	minesPlaced = True
	startTime = MilliSecs()
End Function

Function InField(x, y)
	Return x >= 0 And y >= 0 And x < cols And y < rows
End Function

Function UpdatePlay()
	If KeyHit(BB_KEY_ESCAPE)
		GoToMenu()
		Return
	EndIf

	; Turn the mouse position into a square. Positions left of or above the field give negative numbers, so they
	; are checked before the division.
	Local mx = MouseX() - boardX, my = MouseY() - boardY
	Local x = -1, y = -1
	If mx >= 0 And my >= 0
		x = mx / TILE
		y = my / TILE
	EndIf
	Local leftClick = MouseHit(BB_MOUSE_LEFT), rightClick = MouseHit(BB_MOUSE_RIGHT)
	If Not InField(x, y) Then Return

	If rightClick And Not open(x, y)
		; Right click cycles the mark: none, flag, question mark (if on), none.
		If mark(x, y) = MARK_NONE
			mark(x, y) = MARK_FLAG
			flagCount = flagCount + 1
		ElseIf mark(x, y) = MARK_FLAG
			flagCount = flagCount - 1
			If optQuestion Then mark(x, y) = MARK_QUESTION Else mark(x, y) = MARK_NONE
		Else
			mark(x, y) = MARK_NONE
		EndIf
		If optSound Then PlaySound soundFlag
	EndIf

	If leftClick
		If Not minesPlaced Then PlaceMines(x, y)
		If open(x, y)
			ChordAround(x, y)
		ElseIf mark(x, y) <> MARK_FLAG
			Uncover(x, y)
		EndIf
		If state = STATE_PLAY And optSound Then PlaySound soundClick
		CheckWon()
	EndIf
End Function

; Uncovers a square. A square with no mines around it uncovers its neighbours too, and they do the same: this is a
; flood fill. A function that calls itself could do it, but a long chain of calls can run out of stack space, so
; this one keeps a list of squares that still need to be done.
Function Uncover(startX, startY)
	If open(startX, startY) Or mark(startX, startY) = MARK_FLAG Then Return
	If mine(startX, startY)
		Explode(startX, startY)
		Return
	EndIf

	Local count = 1, x, y, dx, dy
	fillX(0) = startX
	fillY(0) = startY
	open(startX, startY) = True
	openCount = openCount + 1
	While count > 0
		count = count - 1
		x = fillX(count)
		y = fillY(count)
		If around(x, y) = 0
			For dy = -1 To 1
				For dx = -1 To 1
					If InField(x + dx, y + dy)
						If (Not open(x + dx, y + dy)) And mark(x + dx, y + dy) <> MARK_FLAG
							; Opened as it goes into the list, so it can never go in twice.
							open(x + dx, y + dy) = True
							openCount = openCount + 1
							fillX(count) = x + dx
							fillY(count) = y + dy
							count = count + 1
						EndIf
					EndIf
				Next
			Next
		EndIf
	Wend
End Function

; A click on an uncovered number: if as many flags as the number are around it, everything else around it is
; uncovered at once. A wrong flag makes this set off a mine, just as a wrong click would.
Function ChordAround(x, y)
	If around(x, y) = 0 Then Return
	Local flags = 0, dx, dy
	For dy = -1 To 1
		For dx = -1 To 1
			If InField(x + dx, y + dy)
				If mark(x + dx, y + dy) = MARK_FLAG Then flags = flags + 1
			EndIf
		Next
	Next
	If flags <> around(x, y) Then Return
	For dy = -1 To 1
		For dx = -1 To 1
			If InField(x + dx, y + dy) And state = STATE_PLAY Then Uncover(x + dx, y + dy)
		Next
	Next
End Function

Function Explode(x, y)
	hitX = x
	hitY = y
	endTime = MilliSecs()
	state = STATE_LOST
	If optSound Then PlaySound soundBoom
End Function

Function CheckWon()
	If state <> STATE_PLAY Then Return
	If openCount < cols * rows - mineCount Then Return
	endTime = MilliSecs()
	state = STATE_WON
	; Flag every mine, so the field looks finished.
	Local x, y
	For y = 0 To rows - 1
		For x = 0 To cols - 1
			If mine(x, y) Then mark(x, y) = MARK_FLAG
		Next
	Next
	flagCount = mineCount

	Local seconds = (endTime - startTime + 999) / 1000 ; Round up: 10.2 seconds counts as 11.
	If seconds < 1 Then seconds = 1                     ; 0 means "no time yet", so the quickest win counts as 1.
	If bestTime(optSize) = 0 Or seconds < bestTime(optSize)
		bestTime(optSize) = seconds
		newBest = True
		SaveSettings()
	EndIf
	If optSound Then PlaySound soundWin
End Function

; --- Drawing the field --------------------------------------------------------------------------------------------

Function DrawCoveredSquare(x, y, size)
	Color 70, 90, 140
	Rect x, y, size, size, 1
	Color 110, 135, 195 ; Light edge at the top and left...
	Rect x, y, size, 2, 1
	Rect x, y, 2, size, 1
	Color 40, 50, 85    ; ...and a dark one at the bottom and right, so it looks raised.
	Rect x, y + size - 2, size, 2, 1
	Rect x + size - 2, y, 2, size, 1
End Function

Function DrawField()
	Local x, y, px, py
	For y = 0 To rows - 1
		For x = 0 To cols - 1
			px = boardX + x * TILE
			py = boardY + y * TILE
			If open(x, y) Or (state = STATE_LOST And mine(x, y))
				; Uncovered: flat, a little darker, with the number or the mine.
				If x = hitX And y = hitY Then Color 200, 60, 50 Else Color 28, 32, 48
				Rect px, py, TILE - 1, TILE - 1, 1
				If mine(x, y)
					DrawMine(px + TILE / 2, py + TILE / 2)
				ElseIf around(x, y) > 0
					SetNumberColor(around(x, y))
					Text px + TILE / 2, py + TILE / 2, around(x, y), True, True
				EndIf
			Else
				DrawCoveredSquare(px, py, TILE - 1)
				If mark(x, y) = MARK_FLAG
					DrawFlag(px, py)
					; A flag on a square without a mine is shown crossed out once the game is lost.
					If state = STATE_LOST And Not mine(x, y)
						Color 255, 80, 60
						Line px + 3, py + 3, px + TILE - 5, py + TILE - 5
						Line px + TILE - 5, py + 3, px + 3, py + TILE - 5
					EndIf
				ElseIf mark(x, y) = MARK_QUESTION
					Color 230, 230, 120
					Text px + TILE / 2, py + TILE / 2, "?", True, True
				EndIf
			EndIf
		Next
	Next
End Function

Function SetNumberColor(n)
	Select n
		Case 1 : Color 110, 170, 255
		Case 2 : Color 110, 220, 120
		Case 3 : Color 255, 120, 110
		Case 4 : Color 200, 130, 255
		Case 5 : Color 255, 180, 80
		Case 6 : Color 90, 220, 220
		Default : Color 240, 240, 240
	End Select
End Function

Function DrawFlag(px, py)
	Color 230, 230, 240
	Line px + 7, py + 4, px + 7, py + TILE - 6 ; The pole.
	Color 255, 110, 60
	Local i
	For i = 0 To 4
		Line px + 8, py + 4 + i, px + 15 - i, py + 4 + i ; A small triangle, one line at a time.
		Line px + 8, py + 12 - i, px + 15 - i, py + 12 - i
	Next
End Function

Function DrawMine(cx, cy)
	Color 170, 175, 190
	Line cx - 7, cy, cx + 7, cy
	Line cx, cy - 7, cx, cy + 7
	Line cx - 5, cy - 5, cx + 5, cy + 5
	Line cx - 5, cy + 5, cx + 5, cy - 5
	Oval cx - 5, cy - 5, 11, 11, 1
	Color 255, 255, 255
	Rect cx - 3, cy - 3, 3, 3, 1 ; A shine.
End Function

Function DrawHud()
	Local elapsed = 0
	If startTime > 0
		If endTime > 0 Then elapsed = endTime - startTime Else elapsed = MilliSecs() - startTime
	EndIf
	Color 20, 24, 38
	Rect 0, 0, SCREEN_W, 44, 1
	Color 255, 140, 90
	Text 20, 22, "Mines left: " + (mineCount - flagCount), False, True
	Color 200, 210, 240
	Text SCREEN_W / 2, 22, sizeName(optSize), True, True
	Text SCREEN_W - 20 - StringWidth("Time: 00:00"), 22, "Time: " + FormatTime$(elapsed), False, True
End Function

Function DrawBanner(title$, hint$)
	; A bar at the bottom, below the field, so the field stays visible.
	Color 20, 24, 38
	Rect 0, SCREEN_H - 44, SCREEN_W, 44, 1
	If newBest Then title = title + "  A new best time: " + FormatTime$(bestTime(optSize) * 1000)
	Color 255, 220, 90
	Text SCREEN_W / 2, SCREEN_H - 32, title, True, True
	Color 160, 170, 200
	Text SCREEN_W / 2, SCREEN_H - 13, hint, True, True
End Function

; Milliseconds as minutes:seconds, for example 01:05.
Function FormatTime$(ms)
	Local seconds = ms / 1000
	Local minutes = seconds / 60
	seconds = seconds Mod 60
	Return Right$("0" + minutes, 2) + ":" + Right$("0" + seconds, 2)
End Function

; --- Sound --------------------------------------------------------------------------------------------------------
; A short sound: a tone, or noise for the explosion, that fades out. The WAV file is built in a bank as in tutorial
; 2.07, saved to the temp folder, loaded and deleted.
; --- A hidden watermark ------------------------------------------------------------------------------------------
; Every frame carries a pattern that nobody can see: some background pixels are (0, 0, 1) instead of black, one step
; of blue. A program can find the pattern again in a screenshot, which shows that the picture came from this sample.
; The pattern is made once as an image. Black is the mask colour of an image, so DrawImage only draws the marked
; pixels, and everything drawn after it covers it.

Global watermark

Function DrawWatermark()
	If watermark = 0
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				If (x * 7 + y * 13) Mod 29 < 3 Then WritePixelFast x, y, 1, buffer Else WritePixelFast x, y, 0, buffer
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function

Function MakeSound(hz#, lengthMs, noise)
	Local rate = 22050, samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2), i, v#
	PokeInt bank, 0, $46464952      ; "RIFF", as one number: the bytes R, I, F, F read backwards.
	PokeInt bank, 4, 36 + samples * 2
	PokeInt bank, 8, $45564157      ; "WAVE"
	PokeInt bank, 12, $20746D66     ; "fmt "
	PokeInt bank, 16, 16
	PokeShort bank, 20, 1
	PokeShort bank, 22, 1
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2
	PokeShort bank, 32, 2
	PokeShort bank, 34, 16
	PokeInt bank, 36, $61746164     ; "data"
	PokeInt bank, 40, samples * 2
	For i = 0 To samples - 1
		If noise Then v = Rnd(-1.0, 1.0) Else v = Sin(i * hz * 360.0 / rate)
		v = v * (1.0 - Float(i) / samples) * 0.4
		PokeShort bank, 44 + i * 2, Int(v * 32767) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right$(path, 1) <> "\" And Right$(path, 1) <> "/" Then path = path + "/"
	path = path + "minefield-" + MilliSecs() + "-" + Rand(1000, 9999) + ".wav"
	Local file = WriteFile(path)
	If file
		WriteBytes bank, file, 0, BankSize(bank)
		CloseFile file
	EndIf
	FreeBank bank
	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

; Name, columns, rows and mines of the three field sizes.
.fieldSizes
Data "Small", 10, 8, 12
Data "Medium", 16, 12, 32
Data "Large", 24, 16, 70
