; Tutorial 2.05: Images
;
; An image is a picture you can draw again and again, much faster than drawing it from lines and ovals every
; frame. Images can be loaded from files with LoadImage, but they can also be made by the program itself: create
; an empty image, point the drawing commands at its buffer, and draw into it. That is what this tutorial does, so
; it needs no files.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Graphics 640, 480, 0, 2
AppTitle "Tutorial 2.05: Images"
SetBuffer BackBuffer()

; --- Making images ------------------------------------------------------------------------------------------------

; A ship: CreateImage makes an empty image, SetBuffer ImageBuffer() sends all drawing into it.
Local ship = CreateImage(32, 32)
SetBuffer ImageBuffer(ship)
Cls ; Fills the image with black (the ClsColor).
Color 80, 200, 255
Local y
For y = 0 To 31
	Line 16 - y / 2, y, 16 + y / 2, y ; A filled triangle, one line at a time.
Next
Color 255, 255, 255
Oval 13, 14, 6, 8, 1

; A tile for the floor, drawn as a small chequer.
Local tile = CreateImage(32, 32)
SetBuffer ImageBuffer(tile)
Color 40, 40, 70
Rect 0, 0, 32, 32, 1
Color 55, 55, 95
Rect 0, 0, 16, 16, 1
Rect 16, 16, 16, 16, 1

; A coin with two frames: one image can hold several frames of the same size, for animation.
Local coin = CreateImage(16, 16, 2)
SetBuffer ImageBuffer(coin, 0)
Color 255, 210, 0
Oval 0, 0, 16, 16, 1
SetBuffer ImageBuffer(coin, 1)
Color 255, 210, 0
Oval 5, 0, 6, 16, 1

; Back to the screen.
SetBuffer BackBuffer()

; MaskImage sets the colour that is not drawn, so the black around the ship and the coin is see-through. Black is
; the default mask, but saying it makes the code clearer.
MaskImage ship, 0, 0, 0
MaskImage coin, 0, 0, 0

; The handle is the point of the image that sits at the drawing position. MidHandle puts it in the middle, which
; makes it easy to centre the image on a position and to rotate it around its middle.
MidHandle ship
MidHandle coin

; Rotated copies, made once at the start. Rotating while drawing every frame would be slow.
Dim shipAngles(15)
Local i
For i = 0 To 15
	shipAngles(i) = CopyImage(ship)
	RotateImage shipAngles(i), i * 22.5
Next

; --- Using them ---------------------------------------------------------------------------------------------------

Local shipX# = 320, shipY# = 240, angle# = 0
Local coinX = Rand(40, 600), coinY = Rand(40, 440), coins = 0
Local frame = 0, scroll = 0, direction

While Not KeyHit(1)
	; Turn with Left/Right, fly forward with Up. 0 degrees points up here, so Sin and Cos swap their usual roles.
	angle = angle + (KeyDown(205) - KeyDown(203)) * 4
	If KeyDown(200)
		shipX = shipX + Sin(angle) * 3
		shipY = shipY - Cos(angle) * 3
	EndIf
	If shipX < 0 Then shipX = shipX + 640
	If shipX > 640 Then shipX = shipX - 640
	If shipY < 0 Then shipY = shipY + 480
	If shipY > 480 Then shipY = shipY - 480

	frame = frame + 1
	scroll = (scroll + 1) Mod 32

	; TileImage fills the whole buffer with copies of an image. The offset makes the floor scroll.
	TileImage tile, scroll, scroll

	; Pick the pre-rotated ship closest to the current angle.
	direction = Int(((angle Mod 360) + 360) / 22.5) Mod 16
	DrawImage shipAngles(direction), Int(shipX), Int(shipY)

	; Draw the coin frame by frame: it spins by switching between its two frames.
	DrawImage coin, coinX, coinY, (frame / 10) Mod 2

	; ImagesCollide checks whether the visible pixels of two images touch. The mask colour does not count.
	If ImagesCollide(shipAngles(direction), Int(shipX), Int(shipY), 0, coin, coinX, coinY, 0)
		coins = coins + 1
		coinX = Rand(40, 600)
		coinY = Rand(40, 440)
	EndIf

	Color 255, 255, 255
	Text 10, 10, "Left / Right turn, Up flies. Coins: " + coins
	Flip
Wend
End
