; Tutorial 2.07: Making Sounds
;
; LoadSound loads WAV, OGG and other sound files. A sound file is just bytes, though, so a program can also write
; its own: compute the samples, put them into a bank behind a small WAV header, save it, and load it. That way a
; game can ship without any sound files at all.
;
; This tutorial builds a few instruments and turns the keyboard into a small synthesizer:
;   A S D F G H J K   play a scale (C D E F G A B C)
;   1 2 3 4           choose the wave shape
;   Left / Right      pan the sound,  Up / Down  change the volume

Include "<keys.bb>"
Include "<graphics.bb>"

Graphics 640, 480, 0, BB_GRAPHICS_WINDOWED
AppTitle "Tutorial 2.07: Making Sounds"
SetBuffer BackBuffer()

Const WAVE_SINE = 1, WAVE_SQUARE = 2, WAVE_SAW = 3, WAVE_NOISE = 4
Const RATE = 22050 ; Samples per second.

; One sound per wave shape, all at the note A (440 Hz). Other notes are played by changing the pitch.
Dim sounds(4)
Local wave
For wave = 1 To 4
	sounds(wave) = MakeTone(440, 600, wave)
Next

; The key codes of A S D F G H J K and how much each note's pitch differs from A.
Dim keys(7), ratios#(7)
Restore scale
Local i
For i = 0 To 7
	Read keys(i), ratios(i)
Next

Local current = WAVE_SINE, pan# = 0, volume# = 0.8
Local channel, lastNote = -1
Local name$, x, y, lastY

While Not KeyHit(BB_KEY_ESCAPE)
	For wave = 1 To 4
		If KeyHit(BB_KEY_1 + wave - 1) Then current = wave ; The number keys 1 to 9 have codes that follow each other.
	Next
	If KeyHit(BB_KEY_LEFT) And pan > -1 Then pan = pan - 0.5
	If KeyHit(BB_KEY_RIGHT) And pan < 1 Then pan = pan + 0.5
	If KeyHit(BB_KEY_UP) And volume < 1 Then volume = volume + 0.1
	If KeyHit(BB_KEY_DOWN) And volume > 0.15 Then volume = volume - 0.1

	For i = 0 To 7
		If KeyHit(keys(i))
			; PlaySound starts the sound and gives back a channel. The channel controls this one playing copy.
			channel = PlaySound(sounds(current))
			; ChannelPitch sets the playback rate in samples per second. Twice the rate is one octave higher.
			ChannelPitch channel, Int(RATE * ratios(i))
			ChannelVolume channel, volume ; 0 is silent, 1 is full volume.
			ChannelPan channel, pan       ; -1 is left, 0 the middle, 1 right.
			lastNote = i
		EndIf
	Next

	Cls
	Color 255, 255, 255
	Text 10, 10, "A S D F G H J K play notes, 1 to 4 choose the wave."
	Text 10, 25, "Left and Right pan, Up and Down change the volume."
	Select current
		Case WAVE_SINE : name = "sine (soft, like a flute)"
		Case WAVE_SQUARE : name = "square (hollow, like old consoles)"
		Case WAVE_SAW : name = "saw (bright and buzzy)"
		Case WAVE_NOISE : name = "noise (drums and explosions)"
	End Select
	Text 10, 50, "Wave: " + name
	Text 10, 65, "Pan: " + pan + "   Volume: " + volume

	; Draw the shape of the current wave.
	Color 80, 200, 255
	lastY = 240
	For x = 0 To 639
		y = 240 - Int(80 * WaveValue(current, x * 2 * 360.0 / 640))
		Line x - 1, lastY, x, y
		lastY = y
	Next

	; A little keyboard, with the last played key lit.
	For i = 0 To 7
		If i = lastNote Then Color 255, 200, 60 Else Color 200, 200, 200
		Rect 120 + i * 50, 380, 46, 80, 1
		Color 0, 0, 0
		Text 143 + i * 50, 440, Mid$("ASDFGHJK", i + 1, 1), True, False
	Next
	Flip
Wend
End

; The value of a wave at an angle in degrees, from -1 to 1.
Function WaveValue#(wave, angle#)
	Local phase# = angle - Floor(angle / 360) * 360 ; Wrap into 0 to 360.
	Select wave
		Case WAVE_SINE : Return Sin(phase)
		Case WAVE_SQUARE : If phase < 180 Then Return 1.0 Else Return -1.0
		Case WAVE_SAW : Return phase / 180 - 1
		Default : Return Rnd(-1.0, 1.0)
	End Select
End Function

; Writes a WAV file with a tone into the temp folder, loads it as a sound and deletes the file again.
Function MakeTone(hz#, lengthMs, wave)
	Local samples = RATE * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The 44 byte header of a WAV file: "RIFF", the size, "WAVE", a "fmt " block that says 16-bit mono at RATE,
	; and a "data" block with the samples.
	PokeText(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeText(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16       ; The size of the fmt block.
	PokeShort bank, 20, 1      ; 1 means plain samples (PCM).
	PokeShort bank, 22, 1      ; One channel (mono).
	PokeInt bank, 24, RATE     ; Samples per second.
	PokeInt bank, 28, RATE * 2 ; Bytes per second.
	PokeShort bank, 32, 2      ; Bytes per sample.
	PokeShort bank, 34, 16     ; Bits per sample.
	PokeText(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local i, v#, envelope#
	For i = 0 To samples - 1
		v = WaveValue(wave, i * hz * 360.0 / RATE)
		; An envelope shapes the loudness: a quick start, then a slow fade. Without it every note would click.
		envelope = 1.0 - Float(i) / samples
		If i < 200 Then envelope = envelope * i / 200.0
		; 16-bit samples go from -32768 to 32767. "And $FFFF" keeps the lower 16 bits of negative numbers.
		PokeShort bank, 44 + i * 2, Int(v * envelope * 0.5 * 32767) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right$(path, 1) <> "\" And Right$(path, 1) <> "/" Then path = path + "/"
	path = path + "tutorial-tone-" + wave + ".wav"
	Local file = WriteFile(path)
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

; Writes the characters of a text into a bank, one byte each.
Function PokeText(bank, offset, text$)
	Local i
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid$(text, i, 1))
	Next
End Function

; Key and pitch ratio of each note, from A (440 Hz) up: C5 D5 E5 F5 G5 A5 B5 C6, as ratios of the A4 sample.
.scale
Data BB_KEY_A, 1.189, BB_KEY_S, 1.335, BB_KEY_D, 1.498, BB_KEY_F, 1.587, BB_KEY_G, 1.782, BB_KEY_H, 2.0, BB_KEY_J, 2.245
Data BB_KEY_K, 2.378
