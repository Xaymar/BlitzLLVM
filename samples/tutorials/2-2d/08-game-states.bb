; Tutorial 2.08: Game States and Objects
;
; A whole game has several screens: a title, the game itself, a pause screen, "game over". The simplest way to
; organise them is a state variable that says which screen is active, and a Select in the main loop that runs the
; code for that state. Objects of the game (here: falling stars to catch) live in a Type list, and each frame every
; object is updated and drawn.
;
; This is a tiny but complete game: catch the falling stars with the basket, miss three and the game is over.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Graphics 640, 480, 0, 2
AppTitle "Tutorial 2.08: Game States and Objects"
SetBuffer BackBuffer()
SeedRnd MilliSecs()

Const STATE_TITLE = 0, STATE_PLAY = 1, STATE_PAUSE = 2, STATE_OVER = 3

Type FallingStar
	Field x#, y#
	Field speed#
End Type

Global state = STATE_TITLE
Global basketX# = 320
Global score, missed, best
Global spawnTimer

Local timer = CreateTimer(60)

While Not KeyHit(1)
	WaitTimer timer

	; Update: only the code of the current state runs.
	Select state
		Case STATE_TITLE
			If KeyHit(57) Then StartGame()
		Case STATE_PLAY
			UpdateGame()
			If KeyHit(25) Then state = STATE_PAUSE ; P pauses.
		Case STATE_PAUSE
			If KeyHit(25) Then state = STATE_PLAY
		Case STATE_OVER
			If KeyHit(57) Then state = STATE_TITLE
	End Select

	; Draw: the playing field is drawn in every state, the text on top depends on the state.
	Cls
	DrawGame()
	Color 255, 255, 255
	Select state
		Case STATE_TITLE
			Text 320, 200, "STAR CATCHER", True, True
			Text 320, 240, "Left / Right move the basket. Press Space to start.", True, True
		Case STATE_PAUSE
			Text 320, 240, "Paused. Press P to go on.", True, True
		Case STATE_OVER
			Text 320, 220, "Game over! You caught " + score + " stars.", True, True
			Text 320, 250, "Press Space.", True, True
	End Select
	Text 10, 10, "Score " + score + "   Missed " + missed + " / 3   Best " + best
	Flip
Wend
End

Function StartGame()
	score = 0
	missed = 0
	basketX = 320
	Delete Each FallingStar ; Remove what was left from the last game.
	state = STATE_PLAY
End Function

Function UpdateGame()
	basketX = basketX + (KeyDown(205) - KeyDown(203)) * 6
	If basketX < 30 Then basketX = 30
	If basketX > 610 Then basketX = 610

	; A new star every so often, more often as the score grows.
	spawnTimer = spawnTimer - 1
	If spawnTimer <= 0
		Local s.FallingStar = New FallingStar
		s\x = Rnd(20, 620)
		s\y = -10.0
		s\speed = Rnd(2, 3) + score * 0.05
		spawnTimer = 50 - score
		If spawnTimer < 15 Then spawnTimer = 15
	EndIf

	; Move every star. Caught and missed ones are deleted while looping, which For ... Each allows.
	For s.FallingStar = Each FallingStar
		s\y = s\y + s\speed
		If s\y > 440 And s\y < 460 And Abs(s\x - basketX) < 35
			score = score + 1
			Delete s
		ElseIf s\y > 490
			missed = missed + 1
			Delete s
		EndIf
	Next

	If missed >= 3
		If score > best Then best = score
		state = STATE_OVER
	EndIf
End Function

Function DrawGame()
	Local s.FallingStar
	For s = Each FallingStar
		Color 255, 230, 80
		Oval Int(s\x) - 6, Int(s\y) - 6, 12, 12, 1
	Next
	Color 160, 100, 50
	Rect Int(basketX) - 30, 450, 60, 20, 1
	Color 210, 150, 90
	Rect Int(basketX) - 30, 450, 60, 4, 1
End Function
