; Tutorial 2.04: Timing
;
; Computers and screens run at different speeds. A game that moves things by a fixed amount every frame runs twice
; as fast on a 120 Hz screen as on a 60 Hz one. There are two common cures, and this tutorial shows both next to a
; ball that does it wrong:
;
;   Fixed rate:  a timer makes the loop run a set number of times per second (CreateTimer and WaitTimer).
;   Delta time:  measure how long the last frame took (MilliSecs) and move by speed multiplied by that time.
;
; Press 1, 2 or 3 to change how fast the loop runs, and watch which balls keep their speed.

Graphics 640, 480, 0, 2
AppTitle "Tutorial 2.04: Timing"
SetBuffer BackBuffer()

Const SPEED# = 200 ; Pixels per second.

Local naiveX# = 0      ; Moves 200/60 pixels every frame, so its speed depends on the frame rate.
Local deltaX# = 0      ; Moves by SPEED times the seconds since the last frame.
Local fixedX# = 0      ; Moves in fixed steps of 1/60 second, as many steps as time has passed.

Local loopRate = 60
Local timer = CreateTimer(Float(loopRate))

Local lastTime = MilliSecs()
Local accumulator# = 0
Const STEP_SECONDS# = 1.0 / 60

; For the frames-per-second counter.
Local fpsFrames = 0, fpsTime = MilliSecs(), fps = 0
Local now, seconds#

While Not KeyHit(1)
	; Change how often the loop runs, to see the effect.
	If KeyHit(2) Then loopRate = 20 : FreeTimer timer : timer = CreateTimer(Float(loopRate))
	If KeyHit(3) Then loopRate = 60 : FreeTimer timer : timer = CreateTimer(Float(loopRate))
	If KeyHit(4) Then loopRate = 144 : FreeTimer timer : timer = CreateTimer(Float(loopRate))

	; WaitTimer sleeps until the timer ticks again. Sleeping also leaves the CPU free for other programs.
	WaitTimer timer

	; How much time passed since the last frame? MilliSecs counts milliseconds since the computer started.
	now = MilliSecs()
	seconds = (now - lastTime) / 1000.0
	lastTime = now
	If seconds > 0.25 Then seconds = 0.25 ; After a long pause (dragging the window) do not jump too far.

	; 1. Wrong: a fixed amount per frame.
	naiveX = naiveX + SPEED / 60

	; 2. Delta time: speed times time. Smooth, but every computer computes slightly different steps.
	deltaX = deltaX + SPEED * seconds

	; 3. Fixed steps: collect the passed time, then update in exact 1/60 second steps. Every computer runs the very
	;    same steps, which matters for physics and for replays.
	accumulator = accumulator + seconds
	While accumulator >= STEP_SECONDS
		fixedX = fixedX + SPEED * STEP_SECONDS
		accumulator = accumulator - STEP_SECONDS
	Wend

	If naiveX > 640 Then naiveX = naiveX - 680
	If deltaX > 640 Then deltaX = deltaX - 680
	If fixedX > 640 Then fixedX = fixedX - 680

	; Count frames for one second, then show the count.
	fpsFrames = fpsFrames + 1
	If now - fpsTime >= 1000
		fps = fpsFrames
		fpsFrames = 0
		fpsTime = now
	EndIf

	Cls
	Color 255, 90, 90
	Oval Int(naiveX), 150, 30, 30, 1
	Color 90, 255, 120
	Oval Int(deltaX), 250, 30, 30, 1
	Color 90, 160, 255
	Oval Int(fixedX), 350, 30, 30, 1

	Color 255, 255, 255
	Text 10, 10, "Keys 1, 2 and 3 run the loop 20, 60 or 144 times per second."
	Text 10, 30, "Now: " + loopRate + " per second, measured " + fps + " frames per second."
	Text 10, 130, "Red: the same step every frame. Its speed changes with the rate."
	Text 10, 230, "Green: speed times the time of the last frame (delta time)."
	Text 10, 330, "Blue: fixed 1/60 second steps, as many as time has passed."
	; Flip 0 shows the frame right away instead of waiting for the screen, so the timer alone sets the pace.
	Flip 0
Wend
End
