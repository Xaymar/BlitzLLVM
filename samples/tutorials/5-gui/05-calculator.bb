; Tutorial 5.05: Calculator
;
; A whole program made of gadgets: a calculator like the ones on a desk, with memory keys, a few extra keys for roots
; and squares, and a list of past results. It brings together what this chapter showed, and adds a few things that
; finished programs need:
;
;   - The keyboard works as well as the mouse. A canvas can have the keyboard's focus, and while it has, the keys that
;     are typed come as $103 events with the character in EventData. After every click the program gives the focus
;     back to the display, so typing always reaches it.
;   - The window grows and shrinks with SetGadgetShape when the extra keys or the history are turned on or off.
;   - The choices in the View menu are saved in a file, so the calculator looks the same the next time.
;
; The numbers are Doubles, the BlitzLLVM type for numbers with about 16 digits of precision, where a Float only has
; about 7. The display shows up to 12 digits, which a Double keeps exactly. Double("2.5") turns text into a Double,
; and NumberText$ below turns a Double back into text with the digits a calculator shows.
;
; New things here:
;   Double numbers, and Long for whole numbers that do not fit in an Int.
;   Key characters from a canvas ($103), and ActivateGadget to give it the focus.
;   Many buttons kept in an array, and a Select on which one was pressed.
;   SetGadgetShape to change the size of a window, and options saved to a file.
;
; Keys: 0 to 9 and . type numbers, + - * / calculate, Enter or = gives the result, Backspace takes back the last digit,
; Delete clears the entry, Escape clears everything, % is percent.

Const EVENT_KEY_CHAR = $103, EVENT_GADGET = $401, EVENT_WINDOW_CLOSE = $803, EVENT_MENU = $1001
Const MENU_EXTRA = 1, MENU_HISTORY = 2, MENU_GROUPING = 3, MENU_CLEAR_HISTORY = 4, MENU_QUIT = 5
Const MENU_KEYS = 10, MENU_ABOUT = 11

Const OPTIONS_FILE$ = "calculator.cfg", OPTIONS_VERSION = 1
Const MAX_DIGITS = 12

; The size of the parts of the window, inside its frame.
Const MARGIN = 10, KEY_W = 56, KEY_H = 40, GAP = 6, MEMORY_H = 28
Const DISPLAY_H = 64, HISTORY_W = 210
Const GRID_COLUMNS = 4, GRID_ROWS = 5

; --- The keys --------------------------------------------------------------------------------------------------------
; Every key has a number. The keys are kept in the array key(), and what each one does is decided by its number, so
; the code that runs for a click and the code that runs for a typed character can be the same.
Const K_0 = 0, K_1 = 1, K_2 = 2, K_3 = 3, K_4 = 4, K_5 = 5, K_6 = 6, K_7 = 7, K_8 = 8, K_9 = 9
Const K_POINT = 10, K_SIGN = 11, K_ADD = 12, K_SUBTRACT = 13, K_MULTIPLY = 14, K_DIVIDE = 15, K_EQUALS = 16
Const K_CLEAR = 17, K_CLEAR_ENTRY = 18, K_BACK = 19
Const K_MC = 20, K_MR = 21, K_MPLUS = 22, K_MMINUS = 23
Const K_ROOT = 24, K_SQUARE = 25, K_INVERSE = 26, K_PERCENT = 27, K_PI = 28
Const KEY_COUNT = 29
Dim key(KEY_COUNT - 1)

; The characters for times, divided by and plus or minus. They are in the 256 characters that Blitz strings know.
Global TIMES$ = Chr(215), DIVIDED$ = Chr(247), PLUS_MINUS$ = Chr(177)

Global window = CreateWindow("Calculator", 200, 120, 400, 400, 0, 1 + 4)

; The display is a canvas: it can show the numbers big and to the right, and it takes the keys that are typed.
Global display = CreateCanvas(MARGIN, MARGIN, 10, DISPLAY_H, window)
Global bigFont = LoadFont("Arial", 30, True), smallFont = LoadFont("Arial", 14)

; The memory keys, over the first four columns.
Local i
key(K_MC) = CreateButton("MC", 0, 0, 10, MEMORY_H, window)
key(K_MR) = CreateButton("MR", 0, 0, 10, MEMORY_H, window)
key(K_MPLUS) = CreateButton("M+", 0, 0, 10, MEMORY_H, window)
key(K_MMINUS) = CreateButton("M-", 0, 0, 10, MEMORY_H, window)
For i = 0 To 3
	SetGadgetShape key(K_MC + i), MARGIN + i * (KEY_W + GAP), MARGIN + DISPLAY_H + GAP, KEY_W, MEMORY_H
Next

; The main keys, row by row from the Data at the end of the file: the number of each key and its text.
Global gridY = MARGIN + DISPLAY_H + GAP + MEMORY_H + GAP
Local row, column, number, label$
Restore KeyGrid
For row = 0 To GRID_ROWS - 1
	For column = 0 To GRID_COLUMNS
		Read number, label
		label = Replace(Replace(Replace(label, "*", TIMES), "+-", PLUS_MINUS), "^2", Chr(178))
		If label = "/" Then label = DIVIDED ; Only the key itself: "1/x" keeps its /.
		key(number) = CreateButton(label, MARGIN + column * (KEY_W + GAP), gridY + row * (KEY_H + GAP), KEY_W, KEY_H, window)
	Next
Next

; The history: the calculations that were finished with =. A click on one brings its result back, which is kept in
; the array historyResult$ at the same place as the line in the list. Only the last HISTORY_MAX are kept.
Const HISTORY_MAX = 100
Global historyList = CreateListBox(0, MARGIN, HISTORY_W - MARGIN, 10, window)
Dim historyResult$(HISTORY_MAX - 1)

; --- The menus -------------------------------------------------------------------------------------------------------
Local bar = WindowMenu(window)
Local viewMenu = CreateMenu("&View", 0, bar)
Global extraItem = CreateMenu("&Extra keys", MENU_EXTRA, viewMenu)
Global historyItem = CreateMenu("&History", MENU_HISTORY, viewMenu)
Global groupingItem = CreateMenu("&Group digits (1,234,567)", MENU_GROUPING, viewMenu)
CreateMenu "", 0, viewMenu
CreateMenu "&Clear the history", MENU_CLEAR_HISTORY, viewMenu
CreateMenu "", 0, viewMenu
CreateMenu "&Quit", MENU_QUIT, viewMenu
Local helpMenu = CreateMenu("&Help", 0, bar)
CreateMenu "&Keys", MENU_KEYS, helpMenu
CreateMenu "&About", MENU_ABOUT, helpMenu

; --- What the calculator knows ---------------------------------------------------------------------------------------
Global shown:Double = 0       ; The number on the display.
Global entry$ = ""            ; What is being typed, as text, so "0." and "1.50" show as typed. Empty if nothing is.
Global stored:Double = 0      ; The number before the operator, as in the 12 of "12 + 3".
Global operator = -1          ; The key of the operator that waits for its second number, -1 if none does.
Global hasSecond = False      ; Whether that second number was given yet: typed, recalled or worked out.
Global expression$ = ""       ; The small line over the number, such as "12 +".
Global memory:Double = 0, hasMemory = False
Global errorText$ = ""        ; Set when a calculation went wrong. The next key starts over.
Global extraKeys = False, showHistory = False, grouping = True

; When the window changes its size, every gadget keeps its distance to the top left corner. Without this, they would
; keep their place relative to the middle of the window, and move when ApplyLayout makes the window bigger or smaller.
SetGadgetLayout display, 1, 0, 1, 0
SetGadgetLayout historyList, 1, 0, 1, 0
For i = 0 To KEY_COUNT - 1
	SetGadgetLayout key(i), 1, 0, 1, 0
Next

LoadOptions()
ApplyLayout()
ShowDisplay()
ActivateGadget display

Repeat
	Select WaitEvent()
		Case EVENT_GADGET
			If EventSource() = historyList
				i = SelectedGadgetItem(historyList)
				If i >= 0 Then RecallNumber(Double(historyResult(i)))
			Else
				For i = 0 To KEY_COUNT - 1
					If EventSource() = key(i)
						PressKey(i)
						Exit
					EndIf
				Next
			EndIf
			ActivateGadget display ; Back to the display, so the keyboard keeps working.

		Case EVENT_KEY_CHAR
			i = KeyOfCharacter(EventData())
			If i >= 0 Then PressKey(i)

		Case EVENT_MENU
			Select EventData()
				Case MENU_EXTRA
					extraKeys = Not extraKeys
					ApplyLayout()
					SaveOptions()
				Case MENU_HISTORY
					showHistory = Not showHistory
					ApplyLayout()
					SaveOptions()
				Case MENU_GROUPING
					grouping = Not grouping
					ApplyLayout()
					ShowDisplay()
					SaveOptions()
				Case MENU_CLEAR_HISTORY
					ClearGadgetItems historyList
				Case MENU_QUIT
					Exit
				Case MENU_KEYS
					Notify "Keys:" + Chr(10) + Chr(10) + "0 to 9 and . type a number." + Chr(10) + "+ - * / calculate." + Chr(10) + "Enter or = gives the result." + Chr(10) + "Backspace takes back the last digit." + Chr(10) + "Delete clears the entry, Escape everything." + Chr(10) + "% is percent."
				Case MENU_ABOUT
					Notify "Calculator" + Chr(10) + Chr(10) + "Tutorial 5.05 of BlitzLLVM."
			End Select
			ActivateGadget display

		Case EVENT_WINDOW_CLOSE
			Exit
	End Select
Forever
End

; --- Pressing keys ---------------------------------------------------------------------------------------------------
; Everything a key does. Clicks and typed characters both end up here.
Function PressKey(k)
	; After an error, any key starts over. Only clearing keys do nothing more than that.
	If errorText <> ""
		ClearAll()
		If k = K_CLEAR Or k = K_CLEAR_ENTRY Or k = K_BACK
			ShowDisplay()
			Return
		EndIf
	EndIf

	Select k
		Case K_0, K_1, K_2, K_3, K_4, K_5, K_6, K_7, K_8, K_9
			TypeCharacter(Str(k))
		Case K_POINT
			TypeCharacter(".")
		Case K_SIGN
			If entry <> ""
				; While typing, the sign goes on the text, so "0." stays "-0." and does not become "0".
				If Left(entry, 1) = "-" Then entry = Mid(entry, 2) Else entry = "-" + entry
				shown = Double(entry)
			Else
				shown = -shown
			EndIf
		Case K_ADD, K_SUBTRACT, K_MULTIPLY, K_DIVIDE
			PressOperator(k)
		Case K_EQUALS
			PressEquals()
		Case K_CLEAR
			ClearAll()
		Case K_CLEAR_ENTRY
			entry = ""
			shown = 0
			hasSecond = True
		Case K_BACK
			If entry <> ""
				entry = Left(entry, Len(entry) - 1)
				If entry = "-" Then entry = ""
				shown = Double(entry)
			EndIf
		Case K_MC
			memory = 0
			hasMemory = False
		Case K_MR
			If hasMemory Then RecallNumber(memory)
		Case K_MPLUS
			memory = memory + shown
			hasMemory = True
			entry = ""
		Case K_MMINUS
			memory = memory - shown
			hasMemory = True
			entry = ""
		Case K_ROOT
			If shown < 0
				errorText = "No root of a negative number"
			Else
				SetResult(Sqr(shown))
			EndIf
		Case K_SQUARE
			SetResult(shown * shown)
		Case K_INVERSE
			If shown = 0 Then errorText = "Cannot divide by zero" Else SetResult(1 / shown)
		Case K_PI
			SetResult(Double("3.14159265358979"))
		Case K_PERCENT
			; Like on a desk calculator: 200 + 10 % is 200 + 20, and 200 * 10 % is 200 * 0.1.
			If operator = K_ADD Or operator = K_SUBTRACT
				SetResult(stored * shown / 100)
			Else
				SetResult(shown / 100)
			EndIf
	End Select
	ShowDisplay()
End Function

; A digit or the point is added to the number that is being typed. If nothing is being typed, a new number starts.
Function TypeCharacter(c$)
	If c = "." And Instr(entry, ".") Then Return
	If CountDigits(entry) >= MAX_DIGITS Then Return
	If entry = "0" And c <> "." Then entry = ""
	If entry = "-0" And c <> "." Then entry = "-"
	If (entry = "" Or entry = "-") And c = "." Then entry = entry + "0"
	entry = entry + c
	shown = Double(entry)
	hasSecond = True
End Function

; An operator. If one is already waiting and a second number was typed, that calculation is done first, so
; "2 + 3 *" shows 5 like a desk calculator does. Pressing another operator right after one only changes it.
Function PressOperator(k)
	If operator >= 0 And hasSecond
		If Not Calculate(stored, operator, shown) Then Return
	ElseIf operator < 0
		stored = shown
	EndIf
	operator = k
	entry = ""
	hasSecond = False
	expression = Grouped(NumberText(stored)) + " " + OperatorText(k)
End Function

Function PressEquals()
	If operator < 0 Then Return
	; "5 + =" uses the 5 twice, like most calculators.
	Local second:Double = shown
	If Not hasSecond Then second = stored
	Local calculation$ = Grouped(NumberText(stored)) + " " + OperatorText(operator) + " " + Grouped(NumberText(second)) + " ="
	If Not Calculate(stored, operator, second) Then Return
	expression = calculation
	operator = -1
	AddHistory(calculation + " " + Grouped(NumberText(shown)), shown)
End Function

; Works out a operator b into stored and shown. False if it went wrong.
Function Calculate(a:Double, k, b:Double)
	Local result:Double
	Select k
		Case K_ADD
			result = a + b
		Case K_SUBTRACT
			result = a - b
		Case K_MULTIPLY
			result = a * b
		Case K_DIVIDE
			If b = 0
				errorText = "Cannot divide by zero"
				Return False
			EndIf
			result = a / b
	End Select
	If Not SetResult(result) Then Return False
	stored = result
	Return True
End Function

; Puts a result on the display. A number with more than 12 digits before the point does not fit, which is an error.
Function SetResult(value:Double)
	If Abs(value) >= Double("1e12")
		errorText = "Too big"
		Return False
	EndIf
	shown = value
	entry = ""
	hasSecond = True
	Return True
End Function

; A number from the memory or the history. It is shown as if it had been typed in, for the next calculation.
Function RecallNumber(value:Double)
	If errorText <> "" Then ClearAll()
	shown = value
	entry = "" ; Typing starts a new number instead of adding digits to this one.
	hasSecond = True
	If operator < 0 Then expression = ""
	ShowDisplay()
End Function

Function ClearAll()
	shown = 0
	stored = 0
	entry = ""
	operator = -1
	hasSecond = False
	expression = ""
	errorText = ""
End Function

; Which key a typed character is, or -1.
Function KeyOfCharacter(c)
	If c >= Asc("0") And c <= Asc("9") Then Return K_0 + c - Asc("0")
	Select c
		Case Asc("."), Asc(",")
			Return K_POINT
		Case Asc("+")
			Return K_ADD
		Case Asc("-")
			Return K_SUBTRACT
		Case Asc("*"), Asc("x"), Asc("X")
			Return K_MULTIPLY
		Case Asc("/")
			Return K_DIVIDE
		Case Asc("="), 13
			Return K_EQUALS
		Case 8
			Return K_BACK
		Case 4
			Return K_CLEAR_ENTRY
		Case 27
			Return K_CLEAR
		Case Asc("%")
			Return K_PERCENT
	End Select
	Return -1
End Function

Function OperatorText$(k)
	Select k
		Case K_ADD
			Return "+"
		Case K_SUBTRACT
			Return "-"
		Case K_MULTIPLY
			Return TIMES
		Case K_DIVIDE
			Return DIVIDED
	End Select
	Return ""
End Function

; --- Showing numbers -------------------------------------------------------------------------------------------------
; A Double as a calculator shows it: up to 12 digits, no zeros at the end of the decimals. The number is made into a
; whole number with as many decimals as fit, and the point is put back into its text. A Long is used for that,
; because 12 digits are too many for an Int, which ends at about 2 billion.
Function NumberText$(value:Double)
	If value = 0 Then Return "0"
	Local sign$ = "", size:Double = Abs(value)
	If value < 0 Then sign = "-"
	Local decimals = MAX_DIGITS - 1 - Int(Floor(Log10(size)))
	If decimals < 0 Then decimals = 0
	If decimals > MAX_DIGITS - 1 Then decimals = MAX_DIGITS - 1
	Local power:Double = 1, k
	For k = 1 To decimals
		power = power * 10
	Next
	; Long() rounds to the nearest whole number.
	Local digits$ = Str(Long(size * power))
	If digits = "0" Then Return "0"
	If decimals > 0
		While Len(digits) <= decimals
			digits = "0" + digits
		Wend
		digits = Left(digits, Len(digits) - decimals) + "." + Right(digits, decimals)
		While Right(digits, 1) = "0"
			digits = Left(digits, Len(digits) - 1)
		Wend
		If Right(digits, 1) = "." Then digits = Left(digits, Len(digits) - 1)
	EndIf
	Return sign + digits
End Function

; Commas between groups of three digits before the point, if that option is on.
Function Grouped$(text$)
	If Not grouping Then Return text
	Local sign$ = "", rest$ = "", whole$ = text, point = Instr(text, ".")
	If Left(whole, 1) = "-"
		sign = "-"
		whole = Mid(whole, 2)
		point = point - 1
	EndIf
	If point > 0
		rest = Mid(whole, point)
		whole = Left(whole, point - 1)
	EndIf
	Local result$ = ""
	While Len(whole) > 3
		result = "," + Right(whole, 3) + result
		whole = Left(whole, Len(whole) - 3)
	Wend
	Return sign + whole + result + rest
End Function

Function CountDigits(text$)
	Local i, count = 0
	For i = 1 To Len(text)
		If Asc(Mid(text, i, 1)) >= Asc("0") And Asc(Mid(text, i, 1)) <= Asc("9") Then count = count + 1
	Next
	Return count
End Function

; Draws the display: the small line on top, an M while the memory holds a number, and the big number at the right.
Function ShowDisplay()
	SetBuffer CanvasBuffer(display)
	ClsColor 200, 214, 188
	Cls
	Local w = GadgetWidth(display), number$
	Color 70, 90, 70
	SetFont smallFont
	If hasMemory Then Text 8, 6, "M"
	Text w - 8 - StringWidth(expression), 6, expression

	Color 25, 35, 25
	If errorText <> ""
		SetFont smallFont
		Text w - 8 - StringWidth(errorText), DISPLAY_H - 8 - FontHeight(), errorText
	Else
		If entry <> "" Then number = entry Else number = NumberText(shown)
		number = Grouped(number)
		SetFont bigFont
		Text w - 8 - StringWidth(number), DISPLAY_H - 4 - FontHeight(), number
	EndIf
	FlipCanvas display
End Function

; Adds a line to the history. When it is full, the oldest line goes, and the results move up with the lines.
Function AddHistory(text$, value:Double)
	Local i
	If CountGadgetItems(historyList) = HISTORY_MAX
		RemoveGadgetItem historyList, 0
		For i = 0 To HISTORY_MAX - 2
			historyResult(i) = historyResult(i + 1)
		Next
	EndIf
	historyResult(CountGadgetItems(historyList)) = NumberText(value)
	AddGadgetItem historyList, text
End Function

; --- Layout and options ----------------------------------------------------------------------------------------------
; Places everything for the options that are on: the fifth column of keys only with the extra keys, the history only
; with the history. The window is then made as big as what is in it, plus its frame, menu bar and title. The
; difference between GadgetWidth and ClientWidth is how much of the window is frame.
Function ApplyLayout()
	Local columns = GRID_COLUMNS, i
	If extraKeys Then columns = columns + 1
	Local keysW = columns * KEY_W + (columns - 1) * GAP
	Local insideW = MARGIN + keysW + MARGIN
	Local insideH = gridY + GRID_ROWS * (KEY_H + GAP) - GAP + MARGIN

	SetGadgetShape display, MARGIN, MARGIN, keysW, DISPLAY_H
	For i = 0 To KEY_COUNT - 1
		If GadgetX(key(i)) >= MARGIN + GRID_COLUMNS * (KEY_W + GAP)
			If extraKeys Then ShowGadget key(i) Else HideGadget key(i)
		EndIf
	Next
	If showHistory
		SetGadgetShape historyList, insideW, MARGIN, HISTORY_W - MARGIN, insideH - MARGIN * 2
		ShowGadget historyList
		insideW = insideW + HISTORY_W
	Else
		HideGadget historyList
	EndIf

	Local frameW = GadgetWidth(window) - ClientWidth(window), frameH = GadgetHeight(window) - ClientHeight(window)
	SetGadgetShape window, GadgetX(window), GadgetY(window), insideW + frameW, insideH + frameH

	If extraKeys Then CheckMenu extraItem Else UncheckMenu extraItem
	If showHistory Then CheckMenu historyItem Else UncheckMenu historyItem
	If grouping Then CheckMenu groupingItem Else UncheckMenu groupingItem
	UpdateWindowMenu window
	ShowDisplay()
End Function

Function LoadOptions()
	Local file = ReadFile(OPTIONS_FILE)
	If file = 0 Then Return
	If ReadInt(file) = OPTIONS_VERSION
		extraKeys = ReadByte(file)
		showHistory = ReadByte(file)
		grouping = ReadByte(file)
	EndIf
	CloseFile file
End Function

Function SaveOptions()
	Local file = WriteFile(OPTIONS_FILE)
	If file = 0 Then Return
	WriteInt file, OPTIONS_VERSION
	WriteByte file, extraKeys
	WriteByte file, showHistory
	WriteByte file, grouping
	CloseFile file
End Function

; The keys, five rows of five. The fifth column holds the extra keys. "*", "/", "+-" and "^2" are replaced by the
; characters for times, divided by, plus or minus and squared when the buttons are made.
.KeyGrid
Data K_CLEAR, "C", K_CLEAR_ENTRY, "CE", K_BACK, "Back", K_DIVIDE, "/", K_ROOT, "Sqrt"
Data K_7, "7", K_8, "8", K_9, "9", K_MULTIPLY, "*", K_SQUARE, "x^2"
Data K_4, "4", K_5, "5", K_6, "6", K_SUBTRACT, "-", K_INVERSE, "1/x"
Data K_1, "1", K_2, "2", K_3, "3", K_ADD, "+", K_PERCENT, "%"
Data K_SIGN, "+-", K_0, "0", K_POINT, ".", K_EQUALS, "=", K_PI, "Pi"
