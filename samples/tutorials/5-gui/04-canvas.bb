; Tutorial 5.04: Painting on a Canvas
;
; A canvas is a gadget to draw on with the 2D commands of chapter 2. CanvasBuffer gives its buffer for SetBuffer, and
; FlipCanvas shows what was drawn, like Flip does for the window of Graphics. A canvas also tells about the mouse:
; BB_EVENT_MOUSE_DOWN when a button goes down on it, BB_EVENT_MOUSE_UP when it comes up and BB_EVENT_MOUSE_MOVE when
; the mouse moves, with EventX and EventY counted from the top left corner of the canvas and EventData the button
; (BB_MOUSE_LEFT, BB_MOUSE_RIGHT, ...).
;
; This is a small paint program. The picture is kept in an image. The canvas shows the image, and on top of it a
; preview of the line or box that is being dragged, which only goes into the image once the mouse button comes up.
;
; New things here:
;   CreateCanvas, CanvasBuffer and FlipCanvas.
;   Mouse events from a canvas: BB_EVENT_MOUSE_DOWN, BB_EVENT_MOUSE_UP and BB_EVENT_MOUSE_MOVE.
;   A second canvas used as a palette of colours, and RequestColor for any other colour.
;   Drawing into an image with SetBuffer ImageBuffer, and SaveImage with RequestFile.
;   One step of undo, by keeping a copy of the picture from before the last change.

Include "<mouse.bb>"
Include "<gui.bb>"

Const PICTURE_W = 480, PICTURE_H = 360
Const TOOL_PEN = 0, TOOL_LINE = 1, TOOL_BOX = 2, TOOL_ROUND = 3

Local window = CreateWindow("Tutorial 5.04: Painting on a Canvas", 80, 60, 640, 400, 0, BB_WINDOW_TITLEBAR)

; --- The tools on the left -------------------------------------------------------------------------------------------
CreateLabel "Tool:", 10, 10, 120, 18, window
Local toolList = CreateListBox(10, 28, 130, 76, window)
AddGadgetItem toolList, "Pen"
AddGadgetItem toolList, "Line"
AddGadgetItem toolList, "Box"
AddGadgetItem toolList, "Round"
SelectGadgetItem toolList, TOOL_PEN

CreateLabel "Size:", 10, 112, 40, 18, window
Local sizeSlider = CreateSlider(10, 130, 130, 22, window)
SetSliderRange sizeSlider, 1, 20
SetSliderValue sizeSlider, 2 ; The slider goes from 0 to 19, the size from 1 to 20.
Local filledBox = CreateButton("Filled", 10, 158, 130, 20, window, BB_BUTTON_CHECKBOX)

; The palette: a small canvas with 16 colours, 4 by 4. A click on it picks the colour under the mouse. The last one
; is the colour of the paper, which rubs out.
CreateLabel "Colour:", 10, 186, 120, 18, window
Global palette = CreateCanvas(10, 204, 128, 64, window)
Dim paletteRGB(15)
Restore PaletteColours
Local i, r, g, b
For i = 0 To 15
	Read r, g, b
	paletteRGB(i) = (r Shl 16) Or (g Shl 8) Or b
Next
Local moreColours = CreateButton("More colours...", 10, 272, 130, 24, window)

Local undoButton = CreateButton("Undo", 10, 304, 62, 26, window)
Local clearButton = CreateButton("Clear", 78, 304, 62, 26, window)
Local saveButton = CreateButton("Save...", 10, 336, 130, 26, window)

; --- The picture -----------------------------------------------------------------------------------------------------
Global canvas = CreateCanvas(150, 10, PICTURE_W, PICTURE_H, window)
Global picture = CreateImage(PICTURE_W, PICTURE_H)
Global backup = CreateImage(PICTURE_W, PICTURE_H) ; The picture before the last change, for Undo.
ClearPicture()

Global colour = $203060
Global tool = TOOL_PEN, size = 3, filled = False
Global dragging = False, startX, startY, lastX, lastY, mouseX, mouseY
DisableGadget undoButton
ShowPalette()
ShowPicture()

Repeat
	Select WaitEvent()
		Case BB_EVENT_MOUSE_DOWN
			If EventSource() = canvas And EventData() = BB_MOUSE_LEFT
				CopyRect 0, 0, PICTURE_W, PICTURE_H, 0, 0, ImageBuffer(picture), ImageBuffer(backup)
				EnableGadget undoButton
				dragging = True
				startX = EventX() : startY = EventY()
				lastX = startX : lastY = startY
				mouseX = startX : mouseY = startY
				If tool = TOOL_PEN Then PaintStroke(startX, startY, startX, startY)
				ShowPicture()
			ElseIf EventSource() = palette
				; Which of the 4 x 4 squares was clicked.
				i = (EventY() / 16) * 4 + EventX() / 32
				If i >= 0 And i < 16 Then colour = paletteRGB(i)
				ShowPalette()
			EndIf

		Case BB_EVENT_MOUSE_MOVE
			If EventSource() = canvas And dragging
				mouseX = EventX() : mouseY = EventY()
				If tool = TOOL_PEN
					; The pen draws from where the mouse was to where it is now, so fast moves leave no gaps.
					PaintStroke(lastX, lastY, mouseX, mouseY)
					lastX = mouseX : lastY = mouseY
				EndIf
				ShowPicture()
			EndIf

		Case BB_EVENT_MOUSE_UP
			If EventSource() = canvas And dragging
				dragging = False
				; Lines and boxes go into the picture now, where the mouse let go.
				SetBuffer ImageBuffer(picture)
				DrawShape(startX, startY, EventX(), EventY())
				ShowPicture()
			EndIf

		Case BB_EVENT_GADGET
			Select EventSource()
				Case toolList
					tool = SelectedGadgetItem(toolList)
				Case sizeSlider
					size = SliderValue(sizeSlider) + 1
				Case filledBox
					filled = ButtonState(filledBox)
				Case moreColours
					; RequestColor starts with the colour given, and gives 1 if the user picked one.
					If RequestColor((colour Shr 16) And 255, (colour Shr 8) And 255, colour And 255)
						colour = (RequestedRed() Shl 16) Or (RequestedGreen() Shl 8) Or RequestedBlue()
						ShowPalette()
					EndIf
				Case undoButton
					CopyRect 0, 0, PICTURE_W, PICTURE_H, 0, 0, ImageBuffer(backup), ImageBuffer(picture)
					DisableGadget undoButton
					ShowPicture()
				Case clearButton
					CopyRect 0, 0, PICTURE_W, PICTURE_H, 0, 0, ImageBuffer(picture), ImageBuffer(backup)
					EnableGadget undoButton
					ClearPicture()
					ShowPicture()
				Case saveButton
					Local name$ = RequestFile("Save the picture", "bmp", True, "picture.bmp")
					If name <> ""
						If Not SaveImage(picture, name) Then Notify "Could not save " + name + ".", True
					EndIf
			End Select

		Case BB_EVENT_WINDOW_CLOSE
			Exit
	End Select
Forever
End

Function ClearPicture()
	SetBuffer ImageBuffer(picture)
	ClsColor 255, 255, 250
	Cls
End Function

; Shows the picture on the canvas, with what is being dragged drawn on top. The preview is drawn into the canvas, not
; into the picture, so it is gone again on the next move.
Function ShowPicture()
	SetBuffer CanvasBuffer(canvas)
	DrawBlock picture, 0, 0
	If dragging And tool <> TOOL_PEN Then DrawShape(startX, startY, mouseX, mouseY)
	FlipCanvas canvas
End Function

; Draws the line or box of the tool into the buffer that is set.
Function DrawShape(x1, y1, x2, y2)
	UseColour()
	Local boxX = Min(x1, x2), boxY = Min(y1, y2), k, width = Abs(x2 - x1) + 1, height = Abs(y2 - y1) + 1
	Select tool
		Case TOOL_LINE
			ThickLine(x1, y1, x2, y2)
		Case TOOL_BOX
			If filled
				Rect boxX, boxY, width, height, True
			Else
				For k = 0 To size - 1
					If width > k * 2 And height > k * 2 Then Rect boxX + k, boxY + k, width - k * 2, height - k * 2, False
				Next
			EndIf
		Case TOOL_ROUND
			If filled
				Oval boxX, boxY, width, height, True
			Else
				For k = 0 To size - 1
					If width > k * 2 And height > k * 2 Then Oval boxX + k, boxY + k, width - k * 2, height - k * 2, False
				Next
			EndIf
	End Select
End Function

; The pen paints straight into the picture.
Function PaintStroke(x1, y1, x2, y2)
	SetBuffer ImageBuffer(picture)
	UseColour()
	ThickLine(x1, y1, x2, y2)
End Function

; A line as thick as the size: round dots of that size, close enough together to touch.
Function ThickLine(x1, y1, x2, y2)
	Local steps = Max(Abs(x2 - x1), Abs(y2 - y1)), s, x#, y#
	If size <= 1
		Line x1, y1, x2, y2
		Return
	EndIf
	For s = 0 To steps
		If steps = 0
			x = Float(x1) : y = Float(y1)
		Else
			x = x1 + (x2 - x1) * Float(s) / steps
			y = y1 + (y2 - y1) * Float(s) / steps
		EndIf
		Oval Int(x - size / 2.0), Int(y - size / 2.0), size, size, True
	Next
End Function

Function UseColour()
	Color (colour Shr 16) And 255, (colour Shr 8) And 255, colour And 255
End Function

; The palette, with a frame around the colour that is in use.
Function ShowPalette()
	SetBuffer CanvasBuffer(palette)
	ClsColor 212, 208, 200
	Cls
	Local i, c, x, y
	For i = 0 To 15
		c = paletteRGB(i)
		x = (i Mod 4) * 32
		y = (i / 4) * 16
		Color (c Shr 16) And 255, (c Shr 8) And 255, c And 255
		Rect x + 1, y + 1, 30, 14, True
		If c = colour
			Color 0, 0, 0
			Rect x, y, 32, 16, False
			Color 255, 255, 255
			Rect x + 1, y + 1, 30, 14, False
		EndIf
	Next
	FlipCanvas palette
End Function

.PaletteColours
Data 0, 0, 0,  90, 90, 90,  170, 170, 170,  255, 255, 255
Data 32, 48, 96,  40, 110, 210,  90, 190, 230,  40, 140, 70
Data 120, 200, 80,  250, 220, 60,  240, 140, 40,  200, 40, 40
Data 240, 120, 150,  140, 60, 170,  120, 80, 40,  255, 255, 250
