; Tutorial 5.02: Gadgets
;
; A tour of the gadgets that forms are made of, in a small form that puts together a hero for a game. Every gadget
; sends the event $401 when the user changes it, with EventSource saying which one it was. What it holds is then read
; with the function that belongs to it: TextFieldText for a text field, SelectedGadgetItem for a list, ButtonState
; for a check box, SliderValue for a slider.
;
; New things here:
;   CreateTextField, CreateComboBox, CreateListBox, CreateSlider, CreateProgBar and CreatePanel.
;   Check boxes and radio buttons: CreateButton with style 2 and 3, ButtonState and SetButtonState.
;   AddGadgetItem, RemoveGadgetItem, CountGadgetItems, GadgetItemText and SelectGadgetItem for lists.
;   A tabber with one panel per page, shown and hidden with ShowGadget and HideGadget.
;   DisableGadget and EnableGadget, and Notify for a small message box.

Const EVENT_GADGET = $401, EVENT_WINDOW_CLOSE = $803

Local window = CreateWindow("Tutorial 5.02: Gadgets", 140, 90, 440, 400, 0, 1)

; --- The tabber ------------------------------------------------------------------------------------------------------
; A tabber only draws the tabs. What is on each page goes on a panel of its own, and the program shows the panel of
; the page that was picked. ClientWidth and ClientHeight are the size of the inside of the tabber, under the tabs.
Local tabber = CreateTabber(10, 10, 420, 310, window)
AddGadgetItem tabber, "Hero"
AddGadgetItem tabber, "Bag"
SelectGadgetItem tabber, 0
Local heroPage = CreatePanel(0, 0, ClientWidth(tabber), ClientHeight(tabber), tabber)
Local bagPage = CreatePanel(0, 0, ClientWidth(tabber), ClientHeight(tabber), tabber)
HideGadget bagPage

; --- Page 1: the hero ------------------------------------------------------------------------------------------------
CreateLabel "Name:", 10, 14, 70, 20, heroPage
Local nameField = CreateTextField(90, 10, 200, 22, heroPage)
SetGadgetText nameField, "Edda"

; A combo box is a list that folds away and shows only the item that was picked.
CreateLabel "Kind:", 10, 44, 70, 20, heroPage
Local kindBox = CreateComboBox(90, 40, 200, 22, heroPage)
AddGadgetItem kindBox, "Knight"
AddGadgetItem kindBox, "Archer"
AddGadgetItem kindBox, "Wizard"
AddGadgetItem kindBox, "Thief"
SelectGadgetItem kindBox, 0

; Radio buttons (style 3) on the same panel belong together: picking one takes the dot from the others. A panel with
; style 1 has a line around it, which shows the user that the buttons in it belong together.
CreateLabel "How hard:", 10, 78, 70, 20, heroPage
Local hardPanel = CreatePanel(90, 74, 200, 30, heroPage, 1)
Local easy = CreateButton("Easy", 6, 5, 60, 20, hardPanel, 3)
Local normal = CreateButton("Normal", 70, 5, 66, 20, hardPanel, 3)
Local hard = CreateButton("Hard", 140, 5, 56, 20, hardPanel, 3)
SetButtonState normal, True

; Check boxes (style 2) are each on or off on their own.
Local mapBox = CreateButton("Starts with a map", 90, 114, 200, 20, heroPage, 2)
Local petBox = CreateButton("Has a pet", 90, 138, 200, 20, heroPage, 2)
SetButtonState mapBox, True

; A slider. SetSliderRange takes how much of it is shown at once (1 for a slider) and the total, so this one goes from
; 0 to 20. The style 1 lays it across, 2 would stand it upright.
CreateLabel "Strength:", 10, 174, 70, 20, heroPage
Local strengthSlider = CreateSlider(90, 170, 200, 24, heroPage, 1)
SetSliderRange strengthSlider, 1, 21
SetSliderValue strengthSlider, 10
Local strengthLabel = CreateLabel("", 300, 174, 110, 20, heroPage)

; Progress bars show a number from 0 to 1. Here they show what the slider gives to strength and takes from speed.
CreateLabel "Strong:", 10, 208, 70, 20, heroPage
Local strongBar = CreateProgBar(90, 206, 200, 18, heroPage)
CreateLabel "Fast:", 10, 234, 70, 20, heroPage
Local fastBar = CreateProgBar(90, 232, 200, 18, heroPage)

; --- Page 2: the bag -------------------------------------------------------------------------------------------------
CreateLabel "What the hero carries:", 10, 10, 300, 20, bagPage
Local bagList = CreateListBox(10, 32, 260, 230, bagPage)
AddGadgetItem bagList, "Bread"
AddGadgetItem bagList, "Rope"
AddGadgetItem bagList, "Lantern"
Local itemField = CreateTextField(280, 32, 120, 22, bagPage)
Local addButton = CreateButton("Add", 280, 60, 120, 26, bagPage)
Local removeButton = CreateButton("Remove", 280, 92, 120, 26, bagPage)
Local bagCount = CreateLabel("", 280, 130, 130, 40, bagPage)
DisableGadget removeButton ; Nothing is picked yet, so there is nothing to remove.

; --- Below the tabber ------------------------------------------------------------------------------------------------
Local summary = CreateLabel("", 10, 332, 300, 50, window)
Local doneButton = CreateButton("Done", 330, 340, 100, 28, window)

ShowStrength(strengthSlider, strengthLabel, strongBar, fastBar)
ShowSummary(summary, nameField, kindBox, petBox)
ShowBagCount(bagCount, bagList)

Local picked, text$
Repeat
	Select WaitEvent()
		Case EVENT_GADGET
			Select EventSource()
				Case tabber
					; EventData is the page that was picked.
					If EventData() = 0
						ShowGadget heroPage
						HideGadget bagPage
					Else
						HideGadget heroPage
						ShowGadget bagPage
					EndIf
				Case strengthSlider
					ShowStrength(strengthSlider, strengthLabel, strongBar, fastBar)
				Case nameField, kindBox, petBox
					ShowSummary(summary, nameField, kindBox, petBox)
				Case bagList
					; Something was picked in the list, so it can be removed now.
					If SelectedGadgetItem(bagList) >= 0 Then EnableGadget removeButton
				Case addButton
					text = Trim(TextFieldText(itemField))
					If text <> ""
						AddGadgetItem bagList, text
						SetGadgetText itemField, ""
						ShowBagCount(bagCount, bagList)
					EndIf
				Case removeButton
					picked = SelectedGadgetItem(bagList)
					If picked >= 0 Then RemoveGadgetItem bagList, picked
					DisableGadget removeButton
					ShowBagCount(bagCount, bagList)
				Case doneButton
					Notify HeroText$(nameField, kindBox, easy, hard, mapBox, petBox, strengthSlider, bagList)
			End Select
		Case EVENT_WINDOW_CLOSE
			Exit
	End Select
Forever
End

Function ShowStrength(slider, label, strongBar, fastBar)
	Local strength = SliderValue(slider)
	SetGadgetText label, strength + " of 20"
	UpdateProgBar strongBar, strength / 20.0
	UpdateProgBar fastBar, 1 - strength / 20.0
End Function

Function ShowSummary(label, nameField, kindBox, petBox)
	Local text$ = TextFieldText(nameField) + " the " + GadgetItemText(kindBox, SelectedGadgetItem(kindBox))
	If ButtonState(petBox) Then text = text + ", with a pet"
	SetGadgetText label, text + "."
End Function

Function ShowBagCount(label, bagList)
	SetGadgetText label, CountGadgetItems(bagList) + " things in the bag."
End Function

; Everything that was picked, put together as text.
Function HeroText$(nameField, kindBox, easy, hard, mapBox, petBox, slider, bagList)
	Local text$ = TextFieldText(nameField) + " the " + GadgetItemText(kindBox, SelectedGadgetItem(kindBox)) + "." + Chr(10)
	If ButtonState(easy)
		text = text + "Plays it easy."
	ElseIf ButtonState(hard)
		text = text + "Plays it hard."
	Else
		text = text + "Plays it normal."
	EndIf
	text = text + Chr(10) + "Strength " + SliderValue(slider) + ", speed " + (20 - SliderValue(slider)) + "." + Chr(10)
	If ButtonState(mapBox) Then text = text + "Starts with a map." + Chr(10)
	If ButtonState(petBox) Then text = text + "Has a pet." + Chr(10)
	Local i
	text = text + "Carries:"
	For i = 0 To CountGadgetItems(bagList) - 1
		If i > 0 Then text = text + ","
		text = text + " " + GadgetItemText(bagList, i)
	Next
	If CountGadgetItems(bagList) = 0 Then text = text + " nothing"
	Return text + "."
End Function
