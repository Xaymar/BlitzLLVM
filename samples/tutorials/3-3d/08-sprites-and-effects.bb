; Tutorial 3.08: Sprites and Particles
;
; A sprite is a flat square that always turns to face the camera. With a soft, round texture and additive blending
; it looks like a glowing ball of light, and hundreds of them make sparks, fire, smoke and magic: a particle
; effect.
;
; New things here:
;   CreateSprite       makes a sprite. ScaleSprite sets its size.
;   EntityBlend 3      adds the sprite's colour to what is behind it, so overlapping sprites get brighter.
;   EntityAlpha        makes an entity see-through: 1 is solid, 0 invisible.
;   CopyEntity         makes a cheap copy of an entity, sharing its mesh and texture. FreeEntity removes one.
;
; Controls: Space makes an explosion, Left / Right turn the camera around the fountain.
;
; Works on: the original Blitz3D and BlitzLLVM.

Graphics3D 640, 480, 0, 2
AppTitle "Tutorial 3.08: Sprites and Particles"
SetBuffer BackBuffer()

; The camera sits on a pivot in the middle, so turning the pivot swings the camera around the fountain.
Local cameraPivot = CreatePivot()
Local camera = CreateCamera(cameraPivot)
PositionEntity camera, 0, 4, -14
RotateEntity camera, 12, 0, 0
CameraClsColor camera, 5, 5, 15

Local light = CreateLight()
RotateEntity light, 50, 0, 0
AmbientLight 40, 40, 60

Local ground = CreatePlane()
EntityColor ground, 30, 30, 45

; --- A soft, round texture ----------------------------------------------------------------------------------------
; White in the middle, fading to nothing at the edge. The colour of each sprite comes from EntityColor, so one
; white texture serves every colour.
Local glow = CreateTexture(32, 32, 1 + 2)
Local x, y, distance#, brightness
LockBuffer TextureBuffer(glow)
For y = 0 To 31
	For x = 0 To 31
		distance = Sqr((x - 15.5) * (x - 15.5) + (y - 15.5) * (y - 15.5)) / 16 ; 0 in the middle, 1 at the edge.
		brightness = 0
		If distance < 1 Then brightness = Int(255 * (1 - distance) * (1 - distance))
		WritePixelFast x, y, (brightness Shl 24) Or $FFFFFF, TextureBuffer(glow)
	Next
Next
UnlockBuffer TextureBuffer(glow)

; --- The template sprite ------------------------------------------------------------------------------------------
; Every particle is a copy of this one. The template itself stays hidden.
Local template = CreateSprite()
EntityTexture template, glow
EntityBlend template, 3 ; Additive.
EntityFX template, 1    ; Full bright: lights do not change its colour.
HideEntity template

; --- Particles ----------------------------------------------------------------------------------------------------
Type Particle
	Field entity
	Field vx#, vy#, vz# ; Speed in each direction.
	Field life#         ; Counts down from 1 to 0.
	Field fade#         ; How much life it loses per frame.
	Field size#
End Type

Local fountain = CreateCylinder(16)
ScaleEntity fountain, 0.6, 0.5, 0.6
PositionEntity fountain, 0, 0.5, 0
EntityColor fountain, 90, 90, 110

Local p.Particle, i, count

While Not KeyHit(1)
	TurnEntity cameraPivot, 0, (KeyDown(203) - KeyDown(205)) * 1.5, 0

	; The fountain makes a few blue-white sparks every frame.
	For i = 1 To 4
		SpawnParticle(template, 0, 1, 0, Rnd(-0.04, 0.04), Rnd(0.2, 0.28), Rnd(-0.04, 0.04), 0.012, 0.35, 120, 180, 255)
	Next

	; Space: an explosion in the air, a ball of orange sparks flying in every direction.
	If KeyHit(57)
		For i = 1 To 200
			SpawnParticle(template, 0, 5, 0, Rnd(-0.2, 0.2), Rnd(-0.2, 0.2), Rnd(-0.2, 0.2), Rnd(0.01, 0.03), 0.5, 255, Rnd(100, 200), 40)
		Next
	EndIf

	; Move every particle, let gravity pull it down, fade it out and remove it when its life is over.
	count = 0
	For p = Each Particle
		p\vy = p\vy - 0.006
		TranslateEntity p\entity, p\vx, p\vy, p\vz
		If EntityY(p\entity) < 0.1 ; Bounce off the ground, losing some speed.
			PositionEntity p\entity, EntityX(p\entity), 0.1, EntityZ(p\entity)
			p\vy = -p\vy * 0.4
		EndIf
		p\life = p\life - p\fade
		If p\life <= 0
			FreeEntity p\entity
			Delete p
		Else
			EntityAlpha p\entity, p\life
			ScaleSprite p\entity, p\size * p\life, p\size * p\life ; Shrinks as it fades.
			count = count + 1
		EndIf
	Next

	RenderWorld
	Color 255, 255, 255
	Text 10, 10, "Space makes an explosion, Left / Right turn the camera."
	Text 10, 30, "Particles: " + count
	Flip
Wend
End

; Makes one particle: a copy of the template at a position, with a speed, a fade rate, a size and a colour.
Function SpawnParticle(template, x#, y#, z#, vx#, vy#, vz#, fade#, size#, red#, green#, blue#)
	Local p.Particle = New Particle
	p\entity = CopyEntity(template)
	ShowEntity p\entity ; The template is hidden, so make sure the copy is not.
	PositionEntity p\entity, x, y, z
	EntityColor p\entity, red, green, blue
	ScaleSprite p\entity, size, size
	p\vx = vx
	p\vy = vy
	p\vz = vz
	p\life = 1
	p\fade = fade
	p\size = size
End Function
