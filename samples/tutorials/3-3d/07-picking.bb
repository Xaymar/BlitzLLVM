; Tutorial 3.07: Picking
;
; Picking answers the question "what is under this point?". CameraPick sends a ray from the camera through a pixel
; of the screen, so it finds what the mouse points at. LinePick sends a ray from any point in any direction, which
; is handy for line of sight or a laser.
;
; Only entities with a pick mode can be picked. EntityPickMode entity, 1 picks it as a sphere, 2 as its triangles
; (exact, slower), 3 as a box. After a pick, PickedEntity, PickedX/Y/Z and PickedNX/NY/NZ tell what was hit, where,
; and which way the surface faces there.
;
; Controls: click a block to paint it, right-click to remove it. The red laser in the middle shows LinePick.
;
; Works on: the original Blitz3D and BlitzLLVM.

Graphics3D 640, 480, 0, 2
AppTitle "Tutorial 3.07: Picking"
SetBuffer BackBuffer()

Local camera = CreateCamera()
PositionEntity camera, 0, 9, -14.0
RotateEntity camera, 35, 0, 0
CameraClsColor camera, 40, 45, 60

Local light = CreateLight()
RotateEntity light, 60, 30, 0
AmbientLight 90, 90, 100

; A floor that can be picked as its triangles.
Local ground = CreateCube()
ScaleEntity ground, 8, 0.2, 8
PositionEntity ground, 0, -0.2, 0
EntityColor ground, 80, 90, 80
EntityPickMode ground, 2

; A grid of blocks, picked as boxes.
Local x, z, block, height#
For x = -3 To 3
	For z = -3 To 3
		If Rand(0, 2) > 0
			block = CreateCube()
			height = Rnd(0.3, 1.5)
			ScaleEntity block, 0.45, height, 0.45
			PositionEntity block, x * 1.1, height, z * 1.1 ; A cube is 2 high, so this puts it on the floor.
			EntityColor block, 200, 200, 200
			EntityPickMode block, 3
			NameEntity block, "Block " + (x + 4) + "/" + (z + 4) ; A name, to show what was picked.
		EndIf
	Next
Next

; A marker that shows where the mouse ray hits: a small sphere that is not pickable itself.
Local marker = CreateSphere(8)
ScaleEntity marker, 0.12, 0.12, 0.12
EntityColor marker, 255, 255, 0
EntityFX marker, 1

; The laser: a thin, long cube that is stretched to the length of the LinePick.
Local laser = CreateCube()
EntityColor laser, 255, 40, 40
EntityFX laser, 1

Local picked, name$, angle# = 0, length#, hitX#, hitY#, hitZ#, leftClick, rightClick

While Not KeyHit(1)
	; Read the clicks every frame, so that a click is not saved up for later.
	leftClick = MouseHit(1)
	rightClick = MouseHit(2)

	; --- Mouse picking ---
	picked = CameraPick(camera, Float(MouseX()), Float(MouseY()))
	If picked
		; Remember the hit point: the LinePick below replaces all the Picked... values.
		hitX = PickedX()
		hitY = PickedY()
		hitZ = PickedZ()
		; Put the marker on the hit point, pushed out a little along the surface's direction.
		PositionEntity marker, hitX + PickedNX() * 0.1, hitY + PickedNY() * 0.1, hitZ + PickedNZ() * 0.1
		ShowEntity marker
		If picked = ground Then name = "the floor" Else name = EntityName(picked)

		If leftClick And picked <> ground Then EntityColor picked, Rnd(80, 255), Rnd(80, 255), Rnd(80, 255)
		If rightClick And picked <> ground
			FreeEntity picked
			picked = 0
			HideEntity marker
		EndIf
	Else
		HideEntity marker
		name = "nothing"
	EndIf

	; --- Line picking ---
	; A ray from the middle, 0.6 units up, turning around. LinePick x, y, z, dx, dy, dz: the d values are the
	; direction and the length of the ray at once.
	angle = angle + 0.5
	If LinePick(0, 0.6, 0, Sin(angle) * 20, 0, Cos(angle) * 20)
		length = Sqr(PickedX() * PickedX() + PickedZ() * PickedZ())
	Else
		length = 20
	EndIf
	; Stretch the laser from the middle to the hit point. It is a cube, so it is 2 units long before scaling.
	ScaleEntity laser, 0.03, 0.03, length / 2
	RotateEntity laser, 0, -angle, 0
	PositionEntity laser, 0, 0.6, 0
	MoveEntity laser, 0, 0, length / 2

	RenderWorld

	; CameraProject turns a 3D point into a screen position, ProjectedX/Y. Here it labels the hit point.
	If picked
		CameraProject camera, hitX, hitY, hitZ
		Color 255, 255, 0
		Text Int(ProjectedX()) + 10, Int(ProjectedY()) - 20, name
	EndIf

	Color 255, 255, 255
	Text 10, 10, "Left click paints a block, right click removes it."
	Text 10, 30, "The mouse points at " + name + "."
	Flip
Wend
End
