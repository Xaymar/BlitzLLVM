; Tutorial 3.04: Textures Made in Code
;
; A texture is an image that is wrapped onto a mesh. LoadTexture loads one from a file, but CreateTexture makes an
; empty one, and SetBuffer TextureBuffer() sends the 2D drawing commands into it, just like ImageBuffer does for
; images. This tutorial paints three textures that way: bricks, a chequered floor and see-through water.
;
; Texture coordinates (u and v) say which part of the texture lands on which vertex. They go from 0 to 1 across the
; texture, and values past 1 repeat it. ScaleTexture, PositionTexture and RotateTexture change them all at once.
;
; Works on: the original Blitz3D and BlitzLLVM.

Graphics3D 640, 480, 0, 2
AppTitle "Tutorial 3.04: Textures Made in Code"
SetBuffer BackBuffer()

Local camera = CreateCamera()
PositionEntity camera, 0, 4, -9.0
RotateEntity camera, 20, 0, 0
CameraClsColor camera, 20, 20, 30

Local light = CreateLight()
RotateEntity light, 40, 30, 0
AmbientLight 90, 90, 100

; --- Bricks -------------------------------------------------------------------------------------------------------
; CreateTexture width, height, flags. Sizes that are powers of two (64, 128, 256 ...) work everywhere.
Local bricks = CreateTexture(128, 128)
SetBuffer TextureBuffer(bricks)
Color 150, 150, 140 ; The mortar between the bricks.
Rect 0, 0, 128, 128, 1
Local row, column, shift, shade
For row = 0 To 7
	shift = (row Mod 2) * 16 ; Every other row is shifted by half a brick.
	For column = -1 To 3
		shade = Rand(-20, 20)
		Color 160 + shade, 70 + shade / 2, 50
		Rect column * 32 + shift + 1, row * 16 + 1, 30, 14, 1
	Next
Next

; --- A chequered floor --------------------------------------------------------------------------------------------
Local chequer = CreateTexture(64, 64)
SetBuffer TextureBuffer(chequer)
Color 220, 220, 220
Rect 0, 0, 64, 64, 1
Color 60, 60, 80
Rect 0, 0, 32, 32, 1
Rect 32, 32, 32, 32, 1

; --- Water, pixel by pixel ----------------------------------------------------------------------------------------
; Flag 2 gives the texture an alpha channel: each pixel says how see-through it is. WritePixelFast writes a whole
; pixel as one number, $AARRGGBB, so the alpha is the highest byte. It needs LockBuffer around it.
Local water = CreateTexture(64, 64, 1 + 2)
Local x, y, wave#, alpha, blue
LockBuffer TextureBuffer(water)
For y = 0 To 63
	For x = 0 To 63
		wave = Sin(x * 11.25) * Sin(y * 11.25 + x * 5.625) ; 11.25 degrees per pixel makes one full wave in 32.
		blue = 180 + Int(60 * wave)
		alpha = 140 + Int(60 * wave)
		WritePixelFast x, y, (alpha Shl 24) Or (40 Shl 16) Or (110 Shl 8) Or blue, TextureBuffer(water)
	Next
Next
UnlockBuffer TextureBuffer(water)

SetBuffer BackBuffer() ; Always switch back before drawing the frame.

; --- Using them ---------------------------------------------------------------------------------------------------
; A wall of bricks: a cube, flattened.
Local wall = CreateCube()
ScaleEntity wall, 3, 1.5, 0.5
PositionEntity wall, 0, 1.5, 3
EntityTexture wall, bricks

; A spinning brick cube. The same texture can be used on as many entities as you like.
Local cube = CreateCube()
PositionEntity cube, -3.5, 1, 0
EntityTexture cube, bricks

; CreatePlane makes a flat floor that goes on forever. Its texture coordinates match world units, so one copy of
; the texture covers one unit. ScaleTexture 4, 4 stretches it over four units.
Local ground = CreatePlane()
EntityTexture ground, chequer
ScaleTexture chequer, 4, 4

; A pool of water: a flat cube just above the floor. EntityAlpha would make the whole entity see-through, but the
; texture's own alpha makes some parts more see-through than others.
Local pool = CreateCube()
ScaleEntity pool, 2, 0.05, 2
PositionEntity pool, 3, 0.05, 0
EntityTexture pool, water
ScaleTexture water, 0.5, 0.5

Local scroll# = 0

While Not KeyHit(1)
	TurnEntity cube, 0.3, 0.7, 0

	; PositionTexture moves the texture over the surface. Moving it a little every frame makes the water flow.
	scroll = scroll + 0.002
	PositionTexture water, scroll, scroll * 0.5

	RenderWorld
	Color 255, 255, 255
	Text 10, 10, "Every texture here was painted by the program."
	Flip
Wend
End
