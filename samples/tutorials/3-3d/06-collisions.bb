; Tutorial 3.06: Collisions
;
; Entities pass through each other unless you ask for collisions. That takes three steps:
;
;   1. EntityType gives each entity a collision type, a number you choose: 1 for the player, 2 for walls ...
;   2. Collisions source, destination, method, response says what happens when a type runs into another type.
;   3. UpdateWorld moves entities back out of whatever they ran into. Call it once per frame, before RenderWorld.
;
; The moving entity is always a sphere (or an ellipsoid). EntityRadius sets its size. Method 2 checks against the
; triangles of the other mesh, so walls can have any shape. Response 2 makes the sphere slide along what it hit,
; which is what lets a player walk along a wall instead of sticking to it.
;
; Controls: arrow keys roll the ball, Space jumps. Collect all the gems.
;
; Works on: the original Blitz3D and BlitzLLVM.

Graphics3D 640, 480, 0, 2
AppTitle "Tutorial 3.06: Collisions"
SetBuffer BackBuffer()

; The collision types. Constants make the Collisions lines below readable.
Const TYPE_PLAYER = 1, TYPE_WORLD = 2, TYPE_GEM = 3

Local light = CreateLight()
RotateEntity light, 50, 20, 0
AmbientLight 80, 80, 90

; --- The level: a floor, walls around it, boxes and a ramp ---------------------------------------------------------
Local ground = CreateCube()
ScaleEntity ground, 12, 0.5, 12
PositionEntity ground, 0, -0.5, 0
EntityColor ground, 90, 140, 90
EntityType ground, TYPE_WORLD

Local i, block
For i = 0 To 3 ; Four walls around the edge.
	block = CreateCube()
	EntityColor block, 140, 130, 120
	EntityType block, TYPE_WORLD
	If i < 2
		ScaleEntity block, 12, 1, 0.5
		PositionEntity block, 0, 1, (i * 2 - 1) * 12.0
	Else
		ScaleEntity block, 0.5, 1, 12
		PositionEntity block, ((i - 2) * 2 - 1) * 12.0, 1, 0
	EndIf
Next

For i = 0 To 5 ; A few boxes to bump into.
	block = CreateCube()
	PositionEntity block, Rnd(-9.0, 9.0), 1, Rnd(-9.0, 9.0)
	EntityColor block, 180, 110, 60
	EntityType block, TYPE_WORLD
Next

; A ramp: a flat box, tilted. The ball rolls up it because response 2 slides along slopes too.
Local ramp = CreateCube()
ScaleEntity ramp, 1.5, 0.2, 4
RotateEntity ramp, -20.0, 0, 0
PositionEntity ramp, 0, 0.8, 4
EntityColor ramp, 200, 200, 90
EntityType ramp, TYPE_WORLD

; --- Gems -------------------------------------------------------------------------------------------------------
; Gems get a type too, but the player does not slide off them: response 1 stops, and the program removes the gem.
Type Gem
	Field entity
End Type

Local g.Gem
For i = 0 To 9
	g = New Gem
	g\entity = CreateSphere(6)
	ScaleEntity g\entity, 0.3, 0.5, 0.3
	PositionEntity g\entity, Rnd(-10.0, 10.0), 0.7, Rnd(-10.0, 10.0)
	EntityColor g\entity, 80, 220, 255
	EntityShininess g\entity, 1
	EntityType g\entity, TYPE_GEM
	EntityRadius g\entity, 0.5
Next
; One gem on top of the ramp.
PositionEntity g\entity, 0, 2.5, 7

; --- The player ---------------------------------------------------------------------------------------------------
Local player = CreateSphere(12)
ScaleEntity player, 0.5, 0.5, 0.5
PositionEntity player, 0, 1, -8.0
EntityColor player, 255, 90, 90
EntityType player, TYPE_PLAYER
EntityRadius player, 0.5 ; The radius is in world units, so it matches the scaled sphere.

; Player against the level: method 2 (sphere to triangles), response 2 (slide).
Collisions TYPE_PLAYER, TYPE_WORLD, 2, 2
; Player against gems: method 1 (sphere to sphere), response 1 (stop). Only the hit matters here.
Collisions TYPE_PLAYER, TYPE_GEM, 1, 1

Local camera = CreateCamera()
CameraClsColor camera, 120, 170, 230

Local fallSpeed# = 0, onGround = False, gems = 10, hit

While Not KeyHit(1)
	; Gravity: the ball falls faster and faster, until UpdateWorld stops it on the ground.
	fallSpeed = fallSpeed - 0.01
	If onGround And KeyHit(57) Then fallSpeed = 0.25

	; TranslateEntity moves in world directions, so the arrows always mean the same direction on screen.
	TranslateEntity player, (KeyDown(205) - KeyDown(203)) * 0.12, fallSpeed, (KeyDown(200) - KeyDown(208)) * 0.12

	UpdateWorld

	; After UpdateWorld, CountCollisions says how many hits the entity had this frame, and the Collision...
	; commands tell where each one was.
	onGround = False
	For i = 1 To CountCollisions(player)
		; CollisionNY is the up part of the surface's direction at the hit. Close to 1 means something to stand on.
		If CollisionNY(player, i) > 0.5
			onGround = True
			If fallSpeed < 0 Then fallSpeed = 0
		EndIf
	Next

	; EntityCollided gives back the entity of a type that was hit this frame, or 0 if there was none.
	hit = EntityCollided(player, TYPE_GEM)
	If hit
		For g = Each Gem
			If g\entity = hit
				FreeEntity g\entity
				Delete g
				gems = gems - 1
			EndIf
		Next
	EndIf

	; Fell off the level? Start again.
	If EntityY(player) < -10.0
		PositionEntity player, 0, 1, -8.0
		ResetEntity player ; Forgets the old position, so UpdateWorld does not "collide" all the way back.
		fallSpeed = 0
	EndIf

	; The camera follows from behind and above.
	PositionEntity camera, EntityX(player), EntityY(player) + 6, EntityZ(player) - 9
	PointEntity camera, player

	For g = Each Gem
		TurnEntity g\entity, 0, 2, 0
	Next

	RenderWorld
	Color 255, 255, 255
	Text 10, 10, "Arrows roll, Space jumps.  Gems left: " + gems
	If gems = 0 Then Text 320, 220, "All gems collected!", True, True
	Flip
Wend
End
