; Tutorial 3.03: Building Meshes from Code
;
; A mesh is made of surfaces, and a surface is a list of vertices (corner points) and triangles that connect
; three vertices each. CreateCube and CreateSphere build meshes for you, but you can build any shape yourself:
; terrain, a road, a voxel world, a level from a map.
;
; This tutorial builds two meshes: a small pyramid, vertex by vertex, and a hilly landscape made from a grid.
;
; Works on: the original Blitz3D and BlitzLLVM.

Graphics3D 640, 480, 0, 2
AppTitle "Tutorial 3.03: Building Meshes from Code"
SetBuffer BackBuffer()

Local camera = CreateCamera()
PositionEntity camera, 0, 20, -42.0
RotateEntity camera, 25, 0, 0
CameraClsColor camera, 140, 190, 255

Local light = CreateLight()
RotateEntity light, 50, -40.0, 0
AmbientLight 70, 70, 90

; --- A pyramid, one vertex and one triangle at a time ------------------------------------------------------------
Local pyramid = CreateMesh()
Local surface = CreateSurface(pyramid)

; AddVertex surface, x, y, z gives back the number of the new vertex.
Local top = AddVertex(surface, 0, 2, 0)
Local frontLeft = AddVertex(surface, -1.5, 0, -1.5)
Local frontRight = AddVertex(surface, 1.5, 0, -1.5)
Local backRight = AddVertex(surface, 1.5, 0, 1.5)
Local backLeft = AddVertex(surface, -1.5, 0, 1.5)

; AddTriangle surface, a, b, c connects three vertices. The order matters: seen from the front, the corners go
; clockwise. The back of a triangle is not drawn, so a triangle in the wrong order is invisible from outside.
AddTriangle surface, top, frontRight, frontLeft
AddTriangle surface, top, backRight, frontRight
AddTriangle surface, top, backLeft, backRight
AddTriangle surface, top, frontLeft, backLeft

; Shading needs normals: the direction each vertex faces. UpdateNormals works them out from the triangles. The
; pyramid shares its top vertex between all four sides, so its shading is smooth there. For hard edges, every
; side would need vertices of its own.
UpdateNormals pyramid
EntityColor pyramid, 255, 200, 90
PositionEntity pyramid, 0, 10, 0
ScaleEntity pyramid, 2, 2, 2

; --- A landscape from a grid -----------------------------------------------------------------------------------
Const GRID = 40           ; Squares along each side.
Const CELL# = 1.0         ; Size of one square.

Local land = CreateMesh()
Local landSurface = CreateSurface(land)
Local x, z, h#, v, red#, green#, blue#

; First all vertices, row by row. The height of each one comes from a few sine waves. VertexColor gives every
; vertex its own colour: green low down, rock higher up and snow at the top.
For z = 0 To GRID
	For x = 0 To GRID
		h = 3 * Sin(x * 13.0) * Cos(z * 11.0) + 2 * Sin(x * 5.0 + z * 7.0)
		v = AddVertex(landSurface, (x - GRID / 2) * CELL, h, (z - GRID / 2) * CELL)
		If h > 3
			red = 240 : green = 240 : blue = 250
		ElseIf h > 1
			red = 130 : green = 120 : blue = 100
		Else
			red = 70 : green = 150 : blue = 60
		EndIf
		VertexColor landSurface, v, red, green, blue
	Next
Next

; Then two triangles for every square of the grid. Vertex (x, z) has the number z * (GRID + 1) + x.
Local a, b, c, d
For z = 0 To GRID - 1
	For x = 0 To GRID - 1
		a = z * (GRID + 1) + x       ; This corner,
		b = a + 1                    ; the one to the right,
		c = a + (GRID + 1)           ; the one behind,
		d = c + 1                    ; and the one behind and to the right.
		AddTriangle landSurface, a, c, d
		AddTriangle landSurface, a, d, b
	Next
Next
UpdateNormals land

; EntityFX 2 tells the mesh to use the vertex colours.
EntityFX land, 2

Local wireOn = False

While Not KeyHit(1)
	TurnEntity land, 0, 0.2, 0
	TurnEntity pyramid, 0, -1.0, 0

	; W toggles wireframe mode, which shows the triangles.
	If KeyHit(17) Then wireOn = Not wireOn : WireFrame wireOn

	RenderWorld
	Color 0, 0, 0
	Text 10, 10, "W toggles wireframe."
	Text 10, 30, "The landscape has " + CountVertices(landSurface) + " vertices and " + CountTriangles(landSurface) + " triangles."
	Flip
Wend
End
