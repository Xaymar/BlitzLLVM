; Tutorial 3.05: Cameras and Lights
;
; A camera has more settings than its position: how far it can see, how wide it looks (zoom), fog, and which part
; of the screen it draws into (its viewport). A game can have several cameras at once, for split-screen or a
; rear-view mirror.
;
; There are three kinds of light:
;   1  directional  shines in one direction everywhere, like the sun. Only its rotation matters.
;   2  point        shines in all directions from one place, like a lamp. Only its position matters.
;   3  spot         shines in a cone from one place, like a torch. Both matter.
;
; Controls: 1, 2 and 3 switch the coloured lights on and off, F toggles fog, Up / Down zoom the big camera.

Include "<keys.bb>"
Include "<graphics.bb>"
Include "<entity.bb>"

Graphics3D 640, 480, 0, BB_GRAPHICS_WINDOWED
AppTitle "Tutorial 3.05: Cameras and Lights"
SetBuffer BackBuffer()

AmbientLight 45, 45, 55

; --- A scene to look at: a floor and rows of pillars --------------------------------------------------------------
; Lighting is worked out at the vertices and blended across each triangle. A floor made of two big triangles would
; hardly show the lamp's small circle of light, so this floor is a plane split into many small squares. 16 per side
; is the most that works everywhere.
Local ground = CreatePlane(16)
EntityColor ground, 120, 120, 120

Local i, j, pillar
For i = -3 To 3
	For j = 0 To 6
		pillar = CreateCylinder(16)
		ScaleEntity pillar, 0.4, 1.5, 0.4
		PositionEntity pillar, i * 3.0, 1.5, j * 4.0
	Next
Next

; --- Lights -------------------------------------------------------------------------------------------------------
; A dim blue directional light, like moonlight. LightColor sets its colour.
Local moon = CreateLight(BB_LIGHT_DIRECTIONAL)
RotateEntity moon, 60, 30, 0
LightColor moon, 70, 90, 150

; A red point light. LightRange is how far its light reaches.
Local lamp = CreateLight(BB_LIGHT_POINT)
PositionEntity lamp, -4, 1.5, 6
LightColor lamp, 255, 60, 40
LightRange lamp, 6
Local lampBall = CreateSphere(8, lamp) ; A small ball shows where the lamp is.
ScaleEntity lampBall, 0.15, 0.15, 0.15
EntityFX lampBall, BB_FX_FULLBRIGHT
EntityColor lampBall, 255, 60, 40

; A yellow spot light, pointing down at an angle. LightConeAngles sets the inner and outer angle of the cone: full
; light inside the inner one, fading to nothing at the outer one.
Local torch = CreateLight(BB_LIGHT_SPOT)
PositionEntity torch, 4, 6, 6
RotateEntity torch, 70, 0, 0
LightColor torch, 255, 230, 120
LightConeAngles torch, 10, 35
LightRange torch, 20

; --- Cameras ------------------------------------------------------------------------------------------------------
; The main camera. CameraRange sets the nearest and farthest distance it draws.
Local camera = CreateCamera()
PositionEntity camera, 0, 5, -10
RotateEntity camera, 20, 0, 0
CameraRange camera, 0.1, 60
CameraClsColor camera, 10, 10, 20

; A second camera, high above, looking straight down. CameraViewport puts it into a small box in the corner. It is
; drawn after the first camera, so it ends up on top.
Local topCamera = CreateCamera()
PositionEntity topCamera, 0, 30, 9
RotateEntity topCamera, 90, 0, 0
CameraViewport topCamera, 470, 10, 160, 120
CameraClsColor topCamera, 0, 0, 0

Local fogOn = False, zoom# = 1.0, angle# = 0
Dim lights(3), lightOn(3)
lights(1) = moon : lights(2) = lamp : lights(3) = torch
For i = 1 To 3
	lightOn(i) = True
Next

While Not KeyHit(BB_KEY_ESCAPE)
	; ShowEntity and HideEntity switch an entity on and off. A hidden light gives no light. The array remembers
	; which lights are on.
	For i = 1 To 3
		If KeyHit(BB_KEY_1 + i - 1) ; The number keys 1 to 9 have codes that follow each other.
			lightOn(i) = Not lightOn(i)
			If lightOn(i) Then ShowEntity lights(i) Else HideEntity lights(i)
		EndIf
	Next

	; Fog fades things into a colour as they get further away. Mode 1 is linear fog between the two distances.
	If KeyHit(BB_KEY_F)
		fogOn = Not fogOn
		If fogOn
			CameraFogMode camera, 1
			CameraFogRange camera, 4, 22
			CameraFogColor camera, 10, 10, 20
		Else
			CameraFogMode camera, 0
		EndIf
	EndIf

	; CameraZoom: 1 is normal, more than 1 looks through a telescope, less than 1 is a wide angle.
	If KeyDown(BB_KEY_UP) And zoom < 4 Then zoom = zoom * 1.02
	If KeyDown(BB_KEY_DOWN) And zoom > 0.5 Then zoom = zoom / 1.02
	CameraZoom camera, zoom

	; The lamp wanders around in a circle.
	angle = angle + 1
	PositionEntity lamp, Sin(angle) * 6, 1.5, 9 + Cos(angle) * 6

	RenderWorld ; Draws every camera, each into its own viewport.

	Color 255, 255, 255
	Text 10, 10, "1, 2, 3: moonlight, lamp, torch."
	Text 10, 30, "F: fog.  Up / Down: zoom."
	Text 10, 50, "Zoom " + Int(zoom * 100) + "%"
	Color 255, 255, 0
	Rect 469, 9, 162, 122, 0 ; A frame around the small camera's viewport.
	Flip
Wend
End
