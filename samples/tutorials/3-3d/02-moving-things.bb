; Tutorial 3.02: Moving, Turning and Parents
;
; Every entity has a position, a rotation and a scale. There are two ways to change each one:
;
;   PositionEntity / RotateEntity / ScaleEntity  set an absolute value.
;   MoveEntity / TurnEntity                      change it relative to where the entity already is and faces.
;
; MoveEntity moves along the entity's own axes: MoveEntity e, 0, 0, 1 is "one step forward", whichever way the
; entity faces. TranslateEntity moves along the world's axes instead.
;
; Entities can also have a parent. A child moves, turns and scales with its parent, which is how a moon follows
; its planet, a wheel stays on a car, or a gun stays in a hand. This tutorial builds a small solar system and a
; camera you can fly around.
;
; Controls: arrow keys turn and move the camera, A and Z move it up and down.

Include "<keys.bb>"
Include "<graphics.bb>"
Include "<entity.bb>"

Graphics3D 640, 480, 0, BB_GRAPHICS_WINDOWED
AppTitle "Tutorial 3.02: Moving, Turning and Parents"
SetBuffer BackBuffer()

Local camera = CreateCamera()
PositionEntity camera, 0, 8, -18

; A point light in the middle shines in all directions, like a lamp: BB_LIGHT_POINT.
Local sunLight = CreateLight(BB_LIGHT_POINT)
LightRange sunLight, 40
AmbientLight 30, 30, 40

; The sun. EntityFX BB_FX_FULLBRIGHT makes it "full bright": it ignores lighting and always shows its full colour.
Local sun = CreateSphere(24)
ScaleEntity sun, 2, 2, 2
EntityColor sun, 255, 220, 80
EntityFX sun, BB_FX_FULLBRIGHT

; A pivot is an invisible entity: just a position and rotation. Turning a pivot in the sun's middle carries the
; planet that is its child around in a circle, without any maths.
Local planetOrbit = CreatePivot()
Local planet = CreateSphere(16, planetOrbit) ; The second argument of Create... is the parent.
PositionEntity planet, 8, 0, 0              ; Positions of children are relative to their parent.
EntityColor planet, 60, 140, 255

; The moon orbits the planet the same way: a pivot that is a child of the planet, and a moon on that pivot.
Local moonOrbit = CreatePivot(planet)
Local moon = CreateSphere(12, moonOrbit)
PositionEntity moon, 2, 0, 0
ScaleEntity moon, 0.4, 0.4, 0.4
EntityColor moon, 200, 200, 200

; A ring of cubes, made in a loop. Each one is turned to a different angle around the middle, then moved
; "forward" along its own z axis, which spreads them in a circle.
Local i, rock
For i = 0 To 23
	rock = CreateCube()
	ScaleEntity rock, 0.3, 0.3, 0.3
	RotateEntity rock, 0, Float(i * 15), 0
	MoveEntity rock, 0, 0, 13
	EntityColor rock, 150, 110, 80
Next

; PointEntity turns an entity so that it faces another one.
PointEntity camera, sun

While Not KeyHit(BB_KEY_ESCAPE)
	TurnEntity planetOrbit, 0, 0.5, 0 ; The planet goes around the sun...
	TurnEntity planet, 0, 2, 0        ; ...spins around itself...
	TurnEntity moonOrbit, 0, 3, 0     ; ...and the moon goes around the planet.

	; Camera controls: Left and Right turn, Up and Down move forward and back, A and Z move up and down.
	TurnEntity camera, 0, (KeyDown(BB_KEY_LEFT) - KeyDown(BB_KEY_RIGHT)) * 1.5, 0
	MoveEntity camera, 0, 0, (KeyDown(BB_KEY_UP) - KeyDown(BB_KEY_DOWN)) * 0.3
	TranslateEntity camera, 0, (KeyDown(BB_KEY_A) - KeyDown(BB_KEY_Z)) * 0.2, 0 ; Up and down in the world, not the camera.

	RenderWorld
	Color 255, 255, 255
	Text 10, 10, "Arrows fly the camera, A / Z go up and down."
	; EntityX/Y/Z give a position. The last argument True asks for the position in the world, not the parent.
	Text 10, 30, "The moon is at x " + Int(EntityX(moon, True)) + ", z " + Int(EntityZ(moon, True)) + " in the world."
	Text 10, 50, "It is " + Int(EntityDistance(camera, moon)) + " units away from the camera."
	Flip
Wend
End
