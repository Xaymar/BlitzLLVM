; Cave Echoes: a short walk across a hillside at dusk, past a campfire and into a cave, to hear the audio effects of
; BlitzLLVM 2.0 at work.
;
; What to listen for:
;   - Clap (E or the left mouse button) in front of the cliff: the echo comes back later the further away you stand.
;     An echo effect on its own bus, fed by a send, with its delay set from the distance to the rock face.
;   - Walk into the cave: an audio scene for "inside" blends in step by step, the reverb opens up and the wind fades.
;   - Go round a corner of rock: the campfire and the dripping water lose their high notes while rock is in the way.
;     A low-pass effect on each of those channels, set from a line-of-sight test.
;   - Walk down the hill to the river: far away it is a dull rumble, close by it hisses. That is air absorption.
;   - Escape pauses: everything is muffled and turned down by a third audio scene, and restored as it was.
;
; Every sound can be replaced with your own: see data/README.md. Missing files are made by the program itself.
; Start the program with a folder as its command line to load the sounds from there instead of data/.
;
; Controls: W A S D walk, the mouse looks around, Shift runs, E or the left mouse button claps, F1 hides the
; information, Escape pauses.
;
; The options are saved in cave-echoes.cfg next to the program.

Include "<keys.bb>"
Include "<mouse.bb>"
Include "<graphics.bb>"
Include "<entity.bb>"
Include "<texture.bb>"
Include "<audio.bb>"

Const SCREEN_W = 1280, SCREEN_H = 720

Const STATE_MENU = 0, STATE_OPTIONS = 1, STATE_PLAY = 2, STATE_PAUSED = 3

Const TYPE_PLAYER = 1, TYPE_ROCK = 2

; The layout of the world, in meters. The cliff face is at CLIFF_Z, the tunnel runs into it and opens into a chamber.
Const CLIFF_Z# = 40.0, CLIFF_TOP# = 22.0
Const TUNNEL_HALF# = 4.0, TUNNEL_TOP# = 6.0, TUNNEL_END# = 58.0
Const CHAMBER_HALF# = 14.0, CHAMBER_TOP# = 14.0, CHAMBER_END# = 82.0
Const RIVER_Z# = -146.0, RIVER_Y# = -17.0
Const EYE_HEIGHT# = 0.7    ; Above the collision sphere, which floats one meter above the ground.
Const WALK_SPEED# = 4.0, RUN_SPEED# = 8.0, STEP_LENGTH# = 1.6
Const SPEED_OF_SOUND# = 340.0

; Which kind of sound the program makes when a file is missing.
Const KIND_FIRE = 0, KIND_DRIP = 1, KIND_WIND = 2, KIND_RIVER = 3, KIND_STEP = 4, KIND_CLAP = 5

; --- Options -----------------------------------------------------------------------------------------------------
Global optAir = 2          ; 0 to 3: off, light, normal, strong.
Global optOcclusion = True
Global optReverb = True
Global optEcho = True
Global optVolume = 4       ; 0 to 4, in quarters.
Global optSensitivity = 3  ; 1 to 5.
Global optInvert = False
Dim airAmount#(3)
airAmount(0) = 0 : airAmount(1) = 1 : airAmount(2) = 3 : airAmount(3) = 6
Dim airName$(3)
airName(0) = "Off" : airName(1) = "Light" : airName(2) = "Normal" : airName(3) = "Strong"

Global appDir$ = SystemProperty$("appdir")
If appDir <> "" And Right(appDir, 1) <> "\" And Right(appDir, 1) <> "/" Then appDir = appDir + "/"
Global settingsPath$ = appDir + "cave-echoes.cfg"
LoadSettings()

; The sound files: data/ next to the program, or the folder given on the command line.
Global dataDir$ = Trim(CommandLine$())
If Left(dataDir, 1) = Chr(34) Then dataDir = Mid(dataDir, 2)
If Right(dataDir, 1) = Chr(34) Then dataDir = Left(dataDir, Len(dataDir) - 1)
If dataDir = "" Then dataDir = appDir + "data"
; Run straight from the compiler, the program sits in a temporary folder: then data/ is in the current folder,
; which is the folder of the .bb file.
If FileType(dataDir) <> 2
	Local here$ = CurrentDir$()
	If here <> "" And Right(here, 1) <> "\" And Right(here, 1) <> "/" Then here = here + "/"
	If FileType(here + "data") = 2 Then dataDir = here + "data"
EndIf
If Right(dataDir, 1) <> "\" And Right(dataDir, 1) <> "/" Then dataDir = dataDir + "/"

; --- Menus ---------------------------------------------------------------------------------------------------------
Dim menuText$(9)
Global menuCount, menuSelected, menuTop
Global state = STATE_MENU
Global returnState = STATE_MENU ; Where the options go back to: the main menu or the pause menu.
Global showInfo = True

; --- Screen and world ----------------------------------------------------------------------------------------------
Graphics3D SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_WINDOWED
AppTitle "Cave Echoes"
SetBuffer BackBuffer()
SeedRnd 1234 ; The same trees and rocks every time.

Global body = CreatePivot()        ; The player: turns left and right, collides with the rock.
Global camera = CreateCamera(body) ; Looks up and down.
PositionEntity camera, 0, EYE_HEIGHT, 0
CameraRange camera, 0.1, 600
CameraClsColor camera, 34, 38, 62
CameraFogMode camera, 1
CameraFogColor camera, 34, 38, 62
CameraFogRange camera, 40, 260
EntityType body, TYPE_PLAYER
EntityRadius body, 0.5
Collisions TYPE_PLAYER, TYPE_ROCK, BB_COLLIDE_POLYGON, BB_RESPONSE_SLIDE

AmbientLight 46, 50, 70
Global moon = CreateLight(BB_LIGHT_DIRECTIONAL)
LightColor moon, 120, 115, 160
RotateEntity moon, 40, 30, 0
Global lantern = CreateLight(BB_LIGHT_POINT, camera) ; A dim light the player carries, for the dark cave.
LightColor lantern, 90, 80, 60
LightRange lantern, 6

Global glow = MakeGlowTexture()
Global ground = BuildGround()
Global rock = BuildRock()
Dim flame(3)
Global firePivot = BuildCampfire(7, 24)
Global dripPivot = CreatePivot()
PositionEntity dripPivot, 10, 3, 76
Global riverPivot = CreatePivot()
PositionEntity riverPivot, 0, RIVER_Y + 1, RIVER_Z
BuildScenery()

Global yaw# = 0, pitch# = 0, walked# = 0, lastX# = 0, lastZ# = 0
Global fireLight = CreateLight(BB_LIGHT_POINT)
PositionEntity fireLight, 7, 1.4, 24
LightRange fireLight, 18
Global caveLight = CreateLight(BB_LIGHT_POINT)
PositionEntity caveLight, 9, 6, 75
LightColor caveLight, 40, 90, 110
LightRange caveLight, 16
ResetPlayer()

; --- Sounds and the audio setup -------------------------------------------------------------------------------------
; Bus layout:   world (every sound of the scene, with the cave reverb) -> master (with the pause muffle)
;               ambience (the wind, turned down inside the cave)        -> master
;               echo (only the repeats of the cliff echo, fed by sends) -> master
Dim soundSource$(KIND_CLAP)

Global listener = CreateListener(camera, 1, 1, 1) ; One world unit is one meter.
Global worldBus = CreateAudioBus()
Global ambienceBus = CreateAudioBus()
Global echoBus = CreateAudioBus()

Global caveReverb = AddAudioEffect(worldBus, BB_EFFECT_REVERB)
AudioEffectParam caveReverb, BB_EFFECTPARAM_MIX, 0
Global cliffEcho = AddAudioEffect(echoBus, BB_EFFECT_ECHO)
AudioEffectParam cliffEcho, BB_EFFECTPARAM_MIX, 1      ; The bus only carries the repeats, the dry clap plays on world.
AudioEffectParam cliffEcho, BB_EFFECTPARAM_FEEDBACK, 0.3
AudioEffectParam cliffEcho, BB_EFFECTPARAM_DAMPING, 0.5
Global pauseMuffle = AddAudioEffect(BB_MASTER_BUS, BB_EFFECT_LOWPASS)

; Outside: dry, with the wind. Inside: a big stony reverb and only a breath of wind.
Global sceneOutside = CreateAudioScene()
AudioSceneParam sceneOutside, caveReverb, BB_EFFECTPARAM_MIX, 0
AudioSceneParam sceneOutside, caveReverb, BB_EFFECTPARAM_SIZE, 0.3
AudioSceneVolume sceneOutside, ambienceBus, 1
Global sceneInside = CreateAudioScene()
AudioSceneParam sceneInside, caveReverb, BB_EFFECTPARAM_MIX, 0.5
AudioSceneParam sceneInside, caveReverb, BB_EFFECTPARAM_SIZE, 0.88
AudioSceneParam sceneInside, caveReverb, BB_EFFECTPARAM_DAMPING, 0.35
AudioSceneParam sceneInside, caveReverb, BB_EFFECTPARAM_PREDELAY, 0.03
AudioSceneVolume sceneInside, ambienceBus, 0.12
; Paused: muffled and quieter. sceneBefore is filled with whatever was playing when the pause began.
Global scenePaused = CreateAudioScene()
AudioSceneParam scenePaused, pauseMuffle, BB_EFFECTPARAM_FREQUENCY, 650
AudioSceneVolume scenePaused, worldBus, 0.45
AudioSceneVolume scenePaused, ambienceBus, 0.3
Global sceneBefore = CreateAudioScene()

Global soundFire = LoadSfx("campfire", KIND_FIRE, True)
Global soundDrip = LoadSfx("cave-drip", KIND_DRIP, True)
Global soundRiver = LoadSfx("river", KIND_RIVER, True)
Global soundWind = LoadSfx("wind", KIND_WIND, False)
Global soundStep = LoadSfx("footstep", KIND_STEP, False)
Global soundClap = LoadSfx("clap", KIND_CLAP, False)
If soundFire Then LoopSound soundFire : SoundBus soundFire, worldBus
If soundDrip Then LoopSound soundDrip : SoundBus soundDrip, worldBus
If soundRiver Then LoopSound soundRiver : SoundBus soundRiver, worldBus
If soundWind Then LoopSound soundWind : SoundBus soundWind, ambienceBus
If soundStep Then SoundBus soundStep, worldBus
If soundClap Then SoundBus soundClap, worldBus

; The looping sounds play all the time; the occluded ones get a low-pass each.
Global channelFire = 0, channelDrip = 0, channelRiver = 0, channelWind = 0
Global occludeFire = 0, occludeDrip = 0, occludeRiver = 0
If soundFire Then channelFire = EmitSound(soundFire, firePivot) : occludeFire = AddChannelEffect(channelFire, BB_EFFECT_LOWPASS)
If soundDrip Then channelDrip = EmitSound(soundDrip, dripPivot) : occludeDrip = AddChannelEffect(channelDrip, BB_EFFECT_LOWPASS)
If soundRiver Then channelRiver = EmitSound(soundRiver, riverPivot) : occludeRiver = AddChannelEffect(channelRiver, BB_EFFECT_LOWPASS)
If soundWind Then channelWind = PlaySound(soundWind)
Global fireBlocked = False, dripBlocked = False, riverBlocked = False
ApplyOptions()
ApplyAudioScene sceneOutside

; --- Main loop -----------------------------------------------------------------------------------------------------
Global caveWeight# = 0, echoDelay# = 0, frame = 0
Local timer = CreateTimer(60)
GoToMenu()
Local quit = False
While Not quit
	WaitTimer timer
	frame = frame + 1
	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_PLAY
			UpdatePlayer()
		Case STATE_PAUSED
			UpdatePause()
	End Select
	UpdateFire()
	If state <> STATE_PAUSED Then UpdateAudio()
	UpdateWorld
	FollowGround()
	RenderWorld
	Select state
		Case STATE_PLAY
			If showInfo Then DrawInfo()
		Case STATE_MENU
			DrawTitle()
			DrawMenu()
		Default
			DrawPanel()
			DrawMenu()
	End Select
	Flip 0
Wend
SaveSettings()
End

; --- Player --------------------------------------------------------------------------------------------------------

Function ResetPlayer()
	yaw = 0 : pitch = -10
	PositionEntity body, -6, GroundHeight(-6, -3) + 1, -3
	ResetEntity body
	RotateEntity body, 0, yaw, 0
	RotateEntity camera, pitch, 0, 0
End Function

Function UpdatePlayer()
	If KeyHit(BB_KEY_ESCAPE) Then OpenPause() : Return
	If KeyHit(BB_KEY_F1) Then showInfo = Not showInfo

	; Mouse look: the pointer is put back in the middle every frame, so only its movement counts.
	Local turn# = optSensitivity * 0.05
	yaw = yaw - MouseXSpeed() * turn
	If optInvert Then pitch = pitch - MouseYSpeed() * turn Else pitch = pitch + MouseYSpeed() * turn
	If pitch > 80 Then pitch = 80
	If pitch < -80 Then pitch = -80
	MoveMouse SCREEN_W / 2, SCREEN_H / 2
	RotateEntity body, 0, yaw, 0
	RotateEntity camera, pitch, 0, 0

	Local forward# = Float(KeyDown(BB_KEY_W) - KeyDown(BB_KEY_S))
	Local side# = Float(KeyDown(BB_KEY_D) - KeyDown(BB_KEY_A))
	If forward <> 0 And side <> 0 Then forward = forward * 0.7071 : side = side * 0.7071
	Local speed# = WALK_SPEED
	If KeyDown(BB_KEY_LSHIFT) Or KeyDown(BB_KEY_RSHIFT) Then speed = RUN_SPEED
	MoveEntity body, side * speed / 60.0, 0, forward * speed / 60.0

	If KeyHit(BB_KEY_E) Or MouseHit(BB_MOUSE_LEFT) Then Clap()
End Function

; After UpdateWorld has slid the player along the rock, put them on the ground and count their steps.
Function FollowGround()
	Local x# = EntityX(body), z# = EntityZ(body)
	If x < -140 Then x = -140
	If x > 140 Then x = 140
	If z < RIVER_Z + 7 Then z = RIVER_Z + 7
	PositionEntity body, x, GroundHeight(x, z) + 1, z
	ResetEntity body
	If state <> STATE_PLAY Then lastX = x : lastZ = z : Return
	walked = walked + Sqr((x - lastX) * (x - lastX) + (z - lastZ) * (z - lastZ))
	lastX = x : lastZ = z
	If walked >= STEP_LENGTH
		walked = walked - STEP_LENGTH
		If walked > STEP_LENGTH Then walked = 0
		PlayStep()
	EndIf
End Function

Function PlayStep()
	If soundStep = 0 Then Return
	Local channel = PlaySound(soundStep)
	ChannelVolume channel, Rnd(0.45, 0.6)
	If soundSource(KIND_STEP) = "" Then ChannelPitch channel, Rand(19000, 25000) ; Only the made-up step is 22050 Hz.
	If optEcho Then ChannelSend channel, echoBus, 0.5
End Function

Function Clap()
	If soundClap = 0 Then Return
	Local channel = PlaySound(soundClap)
	If optEcho Then ChannelSend channel, echoBus, 1
End Function

; --- Audio, every frame --------------------------------------------------------------------------------------------

Function UpdateAudio()
	Local x# = EntityX(body), z# = EntityZ(body)

	; How far into the cave the player is: 0 outside the mouth, 1 from the end of the tunnel on.
	caveWeight = 0
	If z > CLIFF_Z And Abs(x) < CHAMBER_HALF Then caveWeight = (z - CLIFF_Z) / (TUNNEL_END - CLIFF_Z)
	If caveWeight > 1 Then caveWeight = 1
	BlendAudioScene sceneOutside, sceneInside, caveWeight, 50
	AudioEffectBypass caveReverb, Not optReverb

	; The echo from the cliff face: there and back at the speed of sound. Quieter further away and inside.
	Local distance# = CLIFF_Z - z
	If distance < 2 Then distance = 2
	echoDelay = 2 * distance / SPEED_OF_SOUND
	If echoDelay > 4 Then echoDelay = 4
	AudioEffectParam cliffEcho, BB_EFFECTPARAM_DELAY, echoDelay, 100
	Local echoVolume# = (1 - caveWeight) * (1.0 - distance / 220.0)
	If echoVolume < 0 Or optEcho = False Then echoVolume = 0
	AudioBusVolume echoBus, echoVolume, 50

	; Occlusion: a line-of-sight test against the rock, a few times a second.
	If frame Mod 6 = 0
		fireBlocked = Occlude(occludeFire, firePivot)
		dripBlocked = Occlude(occludeDrip, dripPivot)
		riverBlocked = Occlude(occludeRiver, riverPivot)
	EndIf
End Function

Function Occlude(effect, target)
	If effect = 0 Then Return False
	Local blocked = (EntityVisible(camera, target) = False)
	If blocked And optOcclusion
		AudioEffectParam effect, BB_EFFECTPARAM_FREQUENCY, 550, 250
	Else
		AudioEffectParam effect, BB_EFFECTPARAM_FREQUENCY, 20000, 250
	EndIf
	Return blocked
End Function

Function ApplyOptions()
	ListenerAirAbsorption airAmount(optAir)
	AudioBusVolume BB_MASTER_BUS, optVolume / 4.0
	If optOcclusion = False
		If occludeFire Then AudioEffectParam occludeFire, BB_EFFECTPARAM_FREQUENCY, 20000
		If occludeDrip Then AudioEffectParam occludeDrip, BB_EFFECTPARAM_FREQUENCY, 20000
		If occludeRiver Then AudioEffectParam occludeRiver, BB_EFFECTPARAM_FREQUENCY, 20000
	EndIf
End Function

; --- Pause ---------------------------------------------------------------------------------------------------------

Function OpenPause()
	CaptureAudioScene sceneBefore
	ApplyAudioScene scenePaused, 300
	If channelFire Then PauseChannel channelFire ; The world stands still, the wind keeps blowing.
	If channelDrip Then PauseChannel channelDrip
	If channelRiver Then PauseChannel channelRiver
	state = STATE_PAUSED
	OpenMenu(3, SCREEN_H / 2 - 30)
	menuText(0) = "Resume"
	menuText(1) = "Options"
	menuText(2) = "Main menu"
	ShowPointer
End Function

Function ClosePause()
	ApplyAudioScene sceneBefore, 300
	If channelFire Then ResumeChannel channelFire
	If channelDrip Then ResumeChannel channelDrip
	If channelRiver Then ResumeChannel channelRiver
End Function

Function UpdatePause()
	If KeyHit(BB_KEY_ESCAPE) Then ClosePause() : StartPlay() : Return
	Select MenuInput()
		Case 0
			ClosePause()
			StartPlay()
		Case 1
			GoToOptions(STATE_PAUSED)
		Case 2
			ClosePause()
			ResetPlayer()
			GoToMenu()
	End Select
End Function

Function StartPlay()
	state = STATE_PLAY
	HidePointer
	MoveMouse SCREEN_W / 2, SCREEN_H / 2
	MouseXSpeed()
	MouseYSpeed()
	FlushKeys
	FlushMouse
End Function

; --- Menus ---------------------------------------------------------------------------------------------------------

Function OpenMenu(count, top)
	menuCount = count
	menuTop = top
	menuSelected = 0
	FlushKeys
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

Function GoToMenu()
	state = STATE_MENU
	OpenMenu(3, SCREEN_H / 2 + 40)
	menuText(0) = "Explore"
	menuText(1) = "Options"
	menuText(2) = "Quit"
	ShowPointer
End Function

Function UpdateMenu()
	If KeyHit(BB_KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0 : StartPlay()
		Case 1 : GoToOptions(STATE_MENU)
		Case 2 : Return True
	End Select
	; The camera looks slowly around the clearing behind the menu.
	yaw = Sin(MilliSecs() * 0.004) * 25
	RotateEntity body, 0, yaw, 0
	Return False
End Function

Function GoToOptions(back)
	returnState = back
	state = STATE_OPTIONS
	OpenMenu(8, SCREEN_H / 2 - 130)
	RefreshOptionsText()
End Function

Function RefreshOptionsText()
	menuText(0) = "Air absorption: " + airName(optAir)
	menuText(1) = "Occlusion: " + OnOff(optOcclusion)
	menuText(2) = "Cave reverb: " + OnOff(optReverb)
	menuText(3) = "Cliff echo: " + OnOff(optEcho)
	menuText(4) = "Volume: " + (optVolume * 25) + "%"
	menuText(5) = "Mouse speed: " + optSensitivity
	menuText(6) = "Invert mouse: " + OnOff(optInvert)
	menuText(7) = "Back"
End Function

Function OnOff$(value)
	If value Then Return "On"
	Return "Off"
End Function

Function UpdateOptions()
	Local change = 0
	If KeyHit(BB_KEY_LEFT) Then change = -1
	If KeyHit(BB_KEY_RIGHT) Then change = 1
	Local chosen = MenuInput()
	If chosen >= 0 Then change = 1 ; Enter or a click steps to the next value.

	If KeyHit(BB_KEY_ESCAPE) Or chosen = 7
		SaveSettings()
		If returnState = STATE_PAUSED
			state = STATE_PAUSED
			OpenMenu(3, SCREEN_H / 2 - 30)
			menuText(0) = "Resume"
			menuText(1) = "Options"
			menuText(2) = "Main menu"
			menuSelected = 1
		Else
			GoToMenu()
			menuSelected = 1
		EndIf
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optAir = (optAir + change + 4) Mod 4
		Case 1 : optOcclusion = Not optOcclusion
		Case 2 : optReverb = Not optReverb
		Case 3 : optEcho = Not optEcho
		Case 4 : optVolume = (optVolume + change + 5) Mod 5
		Case 5 : optSensitivity = (optSensitivity - 1 + change + 5) Mod 5 + 1
		Case 6 : optInvert = Not optInvert
	End Select
	ApplyOptions()
	RefreshOptionsText()
End Function

; A menu is a list of lines and the number of the selected one. The keyboard moves the selection, the mouse selects
; the line it is over. MenuInput gives back the line chosen with Enter, Space or a click, or -1.
Function MenuInput()
	If KeyHit(BB_KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount
	If KeyHit(BB_KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount

	Local line = MenuLineAt(MouseX(), MouseY())
	If line >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = line

	If KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Then Return menuSelected
	If MouseHit(BB_MOUSE_LEFT) And line >= 0
		menuSelected = line
		Return line
	EndIf
	Return -1
End Function

Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 200 Or x >= SCREEN_W / 2 + 200 Or y < menuTop Then Return -1
	Local line = (y - menuTop) / 32
	If line >= menuCount Then Return -1
	Return line
End Function

Function DrawMenu()
	Local i, y
	For i = 0 To menuCount - 1
		y = menuTop + i * 32
		If i = menuSelected
			Color 150, 80, 30
			Rect SCREEN_W / 2 - 200, y, 400, 28, 1
			Color 255, 230, 170
		Else
			Color 210, 210, 225
		EndIf
		Text SCREEN_W / 2, y + 14, menuText(i), True, True
	Next
End Function

Function DrawPanel()
	Color 20, 22, 36
	Rect SCREEN_W / 2 - 230, menuTop - 60, 460, menuCount * 32 + 90, 1
	Color 150, 80, 30
	Rect SCREEN_W / 2 - 230, menuTop - 60, 460, menuCount * 32 + 90, 0
	Color 255, 230, 170
	If state = STATE_PAUSED Then Text SCREEN_W / 2, menuTop - 32, "Paused", True, True
	If state = STATE_OPTIONS Then Text SCREEN_W / 2, menuTop - 32, "Options", True, True
End Function

Function DrawTitle()
	Color 20, 22, 36
	Rect SCREEN_W / 2 - 340, SCREEN_H / 2 - 150, 680, 300, 1
	Color 150, 80, 30
	Rect SCREEN_W / 2 - 340, SCREEN_H / 2 - 150, 680, 300, 0
	Color 255, 230, 170
	Text SCREEN_W / 2, SCREEN_H / 2 - 120, "CAVE ECHOES", True, True
	Color 200, 200, 215
	Text SCREEN_W / 2, SCREEN_H / 2 - 90, "A walk to hear the audio effects of BlitzLLVM 2.0", True, True
	Text SCREEN_W / 2, SCREEN_H / 2 - 50, "W A S D walk, the mouse looks, Shift runs", True, True
	Text SCREEN_W / 2, SCREEN_H / 2 - 30, "E or the left mouse button claps, F1 hides the information, Escape pauses", True, True
	Text SCREEN_W / 2, SCREEN_H / 2 + 5, "Headphones recommended", True, True
	DrawMenu()
End Function

Function DrawInfo()
	Local where$ = "On the hillside"
	If caveWeight > 0 Then where = "In the tunnel"
	If caveWeight >= 1 Then where = "In the cave"
	Local y = 12
	Color 255, 230, 170
	Text 12, y, where : y = y + 22
	Color 210, 210, 225
	Local reverb# = GetAudioEffectParam(caveReverb, BB_EFFECTPARAM_MIX)
	If optReverb Then Text 12, y, "Cave reverb mix: " + Int(reverb * 100) + "%" Else Text 12, y, "Cave reverb: off"
	y = y + 18
	If optEcho
		If caveWeight < 1 Then Text 12, y, "Cliff echo: " + Int(echoDelay * 1000) + " ms (clap with E)" Else Text 12, y, "Cliff echo: none in here"
	Else
		Text 12, y, "Cliff echo: off"
	EndIf
	y = y + 18
	Text 12, y, "Campfire: " + Heard(fireBlocked) : y = y + 18
	Text 12, y, "Dripping water: " + Heard(dripBlocked) : y = y + 18
	Local meters# = EntityDistance(camera, riverPivot)
	If optAir = 0
		Text 12, y, "River: " + Int(meters) + " m, air absorption off"
	Else
		Local cutoff# = 2000000.0 / (airAmount(optAir) * meters)
		If cutoff > 20000 Then cutoff = 20000
		Text 12, y, "River: " + Int(meters) + " m, air leaves " + Int(cutoff) + " Hz"
	EndIf
	y = y + 18
	Color 150, 150, 170
	Text 12, SCREEN_H - 24, "Sounds from " + dataDir + ": " + SoundSummary$()
End Function

Function Heard$(blocked)
	If blocked = False Then Return "in sight"
	If optOcclusion Then Return "behind rock, muffled"
	Return "behind rock (occlusion off)"
End Function

Function SoundSummary$()
	Local own = 0, i
	For i = 0 To KIND_CLAP
		If soundSource(i) <> "" Then own = own + 1
	Next
	If own = 0 Then Return "none found, all six are made by the program"
	Return own + " of 6 files found, the rest are made by the program"
End Function

; --- The campfire --------------------------------------------------------------------------------------------------

Function UpdateFire()
	Local i, flicker# = Rnd(0.8, 1.0)
	LightColor fireLight, 255 * flicker, 130 * flicker, 50 * flicker
	For i = 0 To 3
		Local s# = 0.9 + Sin(MilliSecs() * 0.3 + i * 97) * 0.15 + Rnd(-0.08, 0.08)
		ScaleSprite flame(i), s * (1.1 - i * 0.16), s * (1.5 - i * 0.2)
	Next
End Function

Function BuildCampfire(x#, z#)
	Local pivot = CreatePivot()
	PositionEntity pivot, x, 0.6, z
	Local i
	For i = 0 To 2 ; The logs.
		Local wood = CreateCylinder(6)
		ScaleEntity wood, 0.12, 0.7, 0.12
		RotateEntity wood, 70, Float(i * 120), 0
		PositionEntity wood, x, 0.25, z
		EntityColor wood, 90, 55, 30
	Next
	For i = 0 To 9 ; The ring of stones.
		Local stone = CreateSphere(5)
		ScaleEntity stone, 0.25, 0.16, 0.22
		PositionEntity stone, x + Cos(Float(i * 36)) * 0.95, 0.08, z + Sin(Float(i * 36)) * 0.95
		EntityColor stone, 95, 95, 100
	Next
	For i = 0 To 3 ; The flames: glowing sprites, added on top of what is behind them.
		flame(i) = CreateSprite()
		EntityTexture flame(i), glow
		EntityBlend flame(i), BB_BLEND_ADD
		EntityFX flame(i), BB_FX_FULLBRIGHT + BB_FX_NO_FOG
		EntityColor flame(i), 255, Float(150 - i * 25), 50
		PositionEntity flame(i), x, 0.7 + i * 0.3, z
	Next
	Return pivot
End Function

Function MakeGlowTexture()
	Local texture = CreateTexture(64, 64, BB_TEXTURE_COLOR + BB_TEXTURE_ALPHA)
	LockBuffer TextureBuffer(texture)
	Local x, y
	For y = 0 To 63
		For x = 0 To 63
			Local d# = Sqr((x - 31.5) * (x - 31.5) + (y - 31.5) * (y - 31.5)) / 32.0
			Local a = 0
			If d < 1 Then a = Int((1 - d) * (1 - d) * 255)
			WritePixelFast x, y, (a Shl 24) Or (a Shl 16) Or (a Shl 8) Or a, TextureBuffer(texture)
		Next
	Next
	UnlockBuffer TextureBuffer(texture)
	Return texture
End Function

; --- The land ------------------------------------------------------------------------------------------------------

; Flat in front of the cliff, then falling away down the hill towards the river, with a few soft bumps.
Function GroundHeight#(x#, z#)
	If z >= -4 Then Return 0
	Local t# = -4 - z
	Local bumps# = Sin(x * 6.0 + z * 3.5) * 1.3 + Sin(x * 2.7 - z * 5.1) * 0.9
	Local fade# = t / 25.0
	If fade > 1 Then fade = 1
	Return -t * 0.12 + bumps * fade
End Function

Function BuildGround()
	Local mesh = CreateMesh()
	Local surface = CreateSurface(mesh)
	Local cell# = 5.0, countX = 60, countZ = 40
	Local i, j
	For j = 0 To countZ
		For i = 0 To countX
			Local x# = -150 + i * cell, z# = CLIFF_Z - (countZ - j) * cell
			Local h# = GroundHeight(x, z)
			Local v = AddVertex(surface, x, h, z)
			Local shade# = 0.85 + Sin(x * 17 + z * 23) * 0.1
			If z > 0 Then shade = shade * 0.85 ; Trodden earth near the cliff.
			VertexColor surface, v, 60 * shade, 95 * shade, 45 * shade
		Next
	Next
	For j = 0 To countZ - 1
		For i = 0 To countX - 1
			Local a = j * (countX + 1) + i
			AddTriangle surface, a, a + countX + 1, a + countX + 2
			AddTriangle surface, a, a + countX + 2, a + 1
		Next
	Next
	UpdateNormals mesh
	EntityFX mesh, BB_FX_VERTEX_COLORS
	; The ground is left out of the line-of-sight test: only rock muffles sounds here, so the river down the hill
	; shows the air absorption on its own.

	; The river at the bottom of the hill.
	Local water = CreateMesh()
	surface = CreateSurface(water)
	AddPlane(surface, 1, RIVER_Y, -150, RIVER_Z - 8, 150, RIVER_Z + 6, 1, 10, 0, 40, 70, 110)
	EntityFX water, BB_FX_VERTEX_COLORS
	EntityShininess water, 0.8
	Return mesh
End Function

; The cliff and the cave are one mesh, so the line-of-sight test and the collisions see all the rock at once.
Function BuildRock()
	Local mesh = CreateMesh()
	Local face = CreateSurface(mesh)
	; The cliff face, with the tunnel mouth left open, and the top of the hill.
	AddPlane(face, 2, CLIFF_Z, -150, 0, -TUNNEL_HALF, CLIFF_TOP, -1, 4, 1.6, 105, 95, 90)
	AddPlane(face, 2, CLIFF_Z, TUNNEL_HALF, 0, 150, CLIFF_TOP, -1, 4, 1.6, 105, 95, 90)
	AddPlane(face, 2, CLIFF_Z, -TUNNEL_HALF, TUNNEL_TOP, TUNNEL_HALF, CLIFF_TOP, -1, 4, 1.6, 105, 95, 90)
	AddPlane(face, 1, CLIFF_TOP, -150, CLIFF_Z, 150, CLIFF_Z + 200, 1, 10, 1.0, 55, 80, 45)

	Local cave = CreateSurface(mesh)
	; The tunnel.
	AddPlane(cave, 1, 0, -TUNNEL_HALF, CLIFF_Z, TUNNEL_HALF, TUNNEL_END, 1, 2, 0.1, 80, 70, 60)
	AddPlane(cave, 1, TUNNEL_TOP, -TUNNEL_HALF, CLIFF_Z, TUNNEL_HALF, TUNNEL_END, -1, 2, 0.6, 85, 78, 72)
	AddPlane(cave, 0, -TUNNEL_HALF, CLIFF_Z, 0, TUNNEL_END, TUNNEL_TOP, 1, 2, 0.6, 90, 82, 76)
	AddPlane(cave, 0, TUNNEL_HALF, CLIFF_Z, 0, TUNNEL_END, TUNNEL_TOP, -1, 2, 0.6, 90, 82, 76)
	; The chamber, with the end of the tunnel in its front wall.
	AddPlane(cave, 1, 0, -CHAMBER_HALF, TUNNEL_END, CHAMBER_HALF, CHAMBER_END, 1, 2, 0.15, 75, 68, 60)
	AddPlane(cave, 1, CHAMBER_TOP, -CHAMBER_HALF, TUNNEL_END, CHAMBER_HALF, CHAMBER_END, -1, 2, 1.5, 80, 74, 70)
	AddPlane(cave, 0, -CHAMBER_HALF, TUNNEL_END, 0, CHAMBER_END, CHAMBER_TOP, 1, 2, 1.5, 88, 80, 74)
	AddPlane(cave, 0, CHAMBER_HALF, TUNNEL_END, 0, CHAMBER_END, CHAMBER_TOP, -1, 2, 1.5, 88, 80, 74)
	AddPlane(cave, 2, CHAMBER_END, -CHAMBER_HALF, 0, CHAMBER_HALF, CHAMBER_TOP, -1, 2, 1.5, 88, 80, 74)
	AddPlane(cave, 2, TUNNEL_END, -CHAMBER_HALF, 0, -TUNNEL_HALF, CHAMBER_TOP, 1, 2, 1.0, 88, 80, 74)
	AddPlane(cave, 2, TUNNEL_END, TUNNEL_HALF, 0, CHAMBER_HALF, CHAMBER_TOP, 1, 2, 1.0, 88, 80, 74)
	AddPlane(cave, 2, TUNNEL_END, -TUNNEL_HALF, TUNNEL_TOP, TUNNEL_HALF, CHAMBER_TOP, 1, 2, 1.0, 88, 80, 74)

	UpdateNormals mesh
	EntityFX mesh, BB_FX_VERTEX_COLORS
	EntityType mesh, TYPE_ROCK
	EntityPickMode mesh, BB_PICK_POLYGON
	Return mesh
End Function

; A flat grid of quads on a plane across one axis (0 x, 1 y, 2 z) at position pos, from (u0, v0) to (u1, v1) in the
; other two axes, with its front towards facing (+1 or -1) along the axis. The inner vertices are pushed towards
; the front by up to bump meters, which makes the rock lumpy; the edges stay put, so neighbouring planes still meet.
Function AddPlane(surface, axis, pos#, u0#, v0#, u1#, v1#, facing, cell#, bump#, r, g, b)
	Local countU = Int(Abs(u1 - u0) / cell + 0.5), countV = Int(Abs(v1 - v0) / cell + 0.5)
	If countU < 1 Then countU = 1
	If countV < 1 Then countV = 1
	Local base = CountVertices(surface)
	Local i, j
	For i = 0 To countU
		For j = 0 To countV
			Local u# = u0 + (u1 - u0) * i / countU, v# = v0 + (v1 - v0) * j / countV
			Local p# = pos
			Local shade# = 0.8 + Abs(Sin(u * 41 + v * 29 + pos * 7)) * 0.3
			If i > 0 And i < countU And j > 0 And j < countV
				p = pos + facing * Abs(Sin(u * 53 + v * 31) * Cos(u * 23 - v * 47)) * bump
				shade = shade - Abs(p - pos) / (bump + 0.01) * 0.15
			EndIf
			Local vertex
			Select axis
				Case 0 : vertex = AddVertex(surface, p, v, u)
				Case 1 : vertex = AddVertex(surface, u, p, v)
				Default : vertex = AddVertex(surface, u, v, p)
			End Select
			VertexColor surface, vertex, r * shade, g * shade, b * shade
		Next
	Next
	; The corners in the order (u0, v0), (u0, v1), (u1, v1), (u1, v0) go clockwise seen from +x, from +y and from -z.
	Local flip = False
	If axis = 0 And facing < 0 Then flip = True
	If axis = 1 And facing < 0 Then flip = True
	If axis = 2 And facing > 0 Then flip = True
	For i = 0 To countU - 1
		For j = 0 To countV - 1
			Local a = base + i * (countV + 1) + j
			Local bb = a + 1, c = a + countV + 2, d = a + countV + 1
			If flip
				AddTriangle surface, a, c, bb
				AddTriangle surface, a, d, c
			Else
				AddTriangle surface, a, bb, c
				AddTriangle surface, a, c, d
			EndIf
		Next
	Next
End Function

Function BuildScenery()
	Local i
	; Trees on the hillside, but not in the clearing in front of the cave or by the path down to the river.
	Local trunk = CreateCylinder(6)
	ScaleEntity trunk, 0.25, 1.5, 0.25
	EntityColor trunk, 70, 50, 35
	Local crown = CreateCone(8)
	ScaleEntity crown, 1.8, 3.5, 1.8
	EntityColor crown, 30, 60, 40
	HideEntity trunk
	HideEntity crown
	For i = 1 To 70
		Local x# = Rnd(-130, 130), z# = Rnd(-135, 30)
		If Abs(x) > 18 Or z < -20
			If Abs(x) > 8
				Local h# = GroundHeight(x, z)
				Local t = CopyEntity(trunk)
				PositionEntity t, x, h + 1.5, z
				Local c = CopyEntity(crown)
				Local s# = Rnd(0.8, 1.4)
				ScaleEntity c, 1.8 * s, 3.5 * s, 1.8 * s
				PositionEntity c, x, h + 3 + 3.5 * s, z
			EndIf
		EndIf
	Next
	; Boulders along the foot of the cliff.
	For i = 1 To 24
		x = Rnd(-120, 120)
		If Abs(x) > 10
			Local boulder = CreateSphere(6)
			ScaleEntity boulder, Rnd(1, 3), Rnd(0.8, 2.2), Rnd(1, 2.5)
			PositionEntity boulder, x, 0, CLIFF_Z - Rnd(0.5, 3)
			EntityColor boulder, 100, 92, 88
		EndIf
	Next
	; Stalactites in the chamber, and a pool under the drip.
	Local spike = CreateCone(6)
	RotateEntity spike, 180, 0, 0
	EntityColor spike, 95, 88, 80
	HideEntity spike
	For i = 1 To 30
		Local sp = CopyEntity(spike)
		Local size# = Rnd(0.6, 2.4)
		ScaleEntity sp, size * 0.25, size, size * 0.25
		PositionEntity sp, Rnd(-CHAMBER_HALF + 1, CHAMBER_HALF - 1), CHAMBER_TOP - 0.5 - size * 0.5, Rnd(TUNNEL_END + 2, CHAMBER_END - 1)
	Next
	Local pool = CreateMesh()
	Local surface = CreateSurface(pool)
	AddPlane(surface, 1, 0.22, 6, 71, 13, 81, 1, 2, 0, 50, 95, 120)
	EntityFX pool, BB_FX_VERTEX_COLORS
	EntityShininess pool, 1
End Function

; --- Sounds --------------------------------------------------------------------------------------------------------

; Loads data/<name>.ogg, .wav, .flac or .mp3, or makes a stand-in for the sound when none of them is there.
Function LoadSfx(name$, kind, positional)
	Local extension$[3]
	extension[0] = ".ogg" : extension[1] = ".wav" : extension[2] = ".flac" : extension[3] = ".mp3"
	Local i, sound = 0
	For i = 0 To 3
		Local path$ = dataDir + name + extension[i]
		If FileType(path) = 1
			If positional Then sound = Load3DSound(path) Else sound = LoadSound(path)
			If sound Then soundSource(kind) = path : Return sound
		EndIf
	Next
	Return MakeSound(kind, positional)
End Function

; Writes a WAV file to the temporary folder and loads it: 16-bit mono at 22050 Hz.
Function MakeSound(kind, positional)
	Local rate = 22050
	Local seconds#
	Select kind
		Case KIND_FIRE : seconds = 4
		Case KIND_DRIP : seconds = 3
		Case KIND_WIND : seconds = 6
		Case KIND_RIVER : seconds = 4
		Case KIND_STEP : seconds = 0.16
		Default : seconds = 0.09
	End Select
	Local samples = Int(rate * seconds)
	Local bank = CreateBank(44 + samples * 2)
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16
	PokeShort bank, 20, 1
	PokeShort bank, 22, 1
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2
	PokeShort bank, 32, 2
	PokeShort bank, 34, 16
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local low# = 0, low2# = 0, burst# = 0, burstDecay# = 0, phase# = 0, hz# = 0, drip# = 0
	Local i
	For i = 0 To samples - 1
		Local t# = Float(i) / samples
		Local noise# = Rnd(-1, 1)
		Local v# = 0
		Select kind
			Case KIND_FIRE
				; A soft roar with crackles: short bursts of noise that start at random.
				low = low + (noise - low) * 0.05
				If burst < 0.02 And Rnd(1) < 0.0009 Then burst = Rnd(0.4, 1) : burstDecay = Rnd(0.990, 0.997)
				burst = burst * burstDecay
				v = low * 0.5 + noise * burst
			Case KIND_DRIP
				; Two drops: a quick falling whistle each, then silence.
				If i = Int(samples * 0.1) Or i = Int(samples * 0.62) Then drip = 1 : hz = Rnd(1300, 1700)
				drip = drip * 0.9993
				hz = hz * 0.99993
				phase = phase + 360.0 * hz / rate
				v = Sin(phase) * drip * drip * 0.8
			Case KIND_WIND
				; Filtered noise that swells twice over the loop, so the loop has no seam.
				Local gust# = 0.55 + 0.45 * Sin(t * 720 - 90) * Sin(t * 360)
				low = low + (noise - low) * (0.01 + gust * 0.03)
				low2 = low2 + (low - low2) * 0.2
				v = low2 * (2.5 + gust * 3)
			Case KIND_RIVER
				; Broad rushing noise, brighter than the wind, so the air absorption has something to take away.
				low = low + (noise - low) * 0.35
				v = (low * 0.6 + noise * 0.25) * (0.85 + 0.15 * Sin(t * 1080))
			Case KIND_STEP
				; A dull thud on gravel.
				low = low + (noise - low) * 0.15
				v = (low * 1.6 + noise * 0.25) * (1 - t) * (1 - t) * (1 - t)
			Default
				; A sharp clap: bright noise that dies quickly.
				v = noise * Exp(-t * 9) * 0.9
		End Select
		If kind <> KIND_FIRE And kind <> KIND_WIND And kind <> KIND_RIVER And kind <> KIND_DRIP
			If i < 32 Then v = v * i / 32.0 ; No click at the start.
		EndIf
		If v > 1 Then v = 1
		If v < -1 Then v = -1
		PokeShort bank, 44 + i * 2, Int(v * 30000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "cave-echoes-" + kind + "-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the demo still runs.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank
	Local sound
	If positional Then sound = Load3DSound(path) Else sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

; --- Settings ------------------------------------------------------------------------------------------------------

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	If ReadInt(file) = 1
		optAir = ReadInt(file)
		optOcclusion = ReadInt(file)
		optReverb = ReadInt(file)
		optEcho = ReadInt(file)
		optVolume = ReadInt(file)
		optSensitivity = ReadInt(file)
		optInvert = ReadInt(file)
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optAir < 0 Or optAir > 3 Then optAir = 2
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
	If optSensitivity < 1 Or optSensitivity > 5 Then optSensitivity = 3
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the demo still works, it just forgets the options.
	WriteInt file, 1
	WriteInt file, optAir
	WriteInt file, optOcclusion
	WriteInt file, optReverb
	WriteInt file, optEcho
	WriteInt file, optVolume
	WriteInt file, optSensitivity
	WriteInt file, optInvert
	CloseFile file
End Function
