If folder <> "" And Right(folder, 1) <> "\" And Right(folder, 1) <> "/" Then folder = folder + "/"
Global settingsPath$ = folder + "movie-billboard.cfg"
LoadSettings()

; --- Screen ----------------------------------------------------------------------------------------------------------
Graphics3D SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_WINDOWED
AppTitle "Neon Plaza"
SetBuffer BackBuffer()
Global titleFont = LoadFont("Arial", 64, True)
Global menuFont = LoadFont("Arial", 24, True)
Global smallFont = LoadFont("Arial", 18)

Global camera = CreateCamera()
CameraRange camera, 0.1, 600
CameraClsColor camera, 8, 6, 20
CameraFogMode camera, 1
CameraFogColor camera, 24, 14, 46
CameraFogRange camera, 30, 230
CreateListener camera, 0.5, 1, 1 ; The ear is on the camera. A rolloff of 0.5 lets the screen carry across the plaza.
AmbientLight 255, 255, 255

; --- The movie -------------------------------------------------------------------------------------------------------
Global moviePath$ = FindMovie()
Global movieName$ = ""
Global movie = 0
If moviePath <> "" Then movie = OpenMovie(moviePath)
If movie <> 0 Then movieName = FileName(moviePath)
