Local quit = False
While Not quit
	WaitTimer timer
	frame = frame + 1

	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_HELP
			UpdateMenuCamera()
			If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Or MouseHit(BB_MOUSE_LEFT) Then GoToMenu() : menuSelected = 2
		Case STATE_PLAY
			UpdatePlay()
		Case STATE_PAUSED
			UpdatePause()
	End Select

	UpdateCity()
	RenderWorld
	DrawOverlay()
	Flip
Wend

SaveSettings()
If movie <> 0 Then CloseMovie movie
End

; --- Finding the movie -----------------------------------------------------------------------------------------------

; The path on the command line, else the first movie file in the data folder, else "".
Function FindMovie$()
	Local arg$ = Trim(CommandLine$())
	If Left(arg, 1) = Chr(34) Then arg = Mid(arg, 2)
	If Right(arg, 1) = Chr(34) Then arg = Left(arg, Len(arg) - 1)
	If arg <> "" And FileType(arg) = 1 Then Return arg

	Local dataPath$ = folder + "data/"
	Local best$ = ""
	Local dir = ReadDir(dataPath)
	If dir = 0 Then Return ""
	Repeat
		Local f$ = NextFile$(dir)
		If f = "" Then Exit
		If FileType(dataPath + f) = 1 And IsMovieFile(f)
			If best = "" Or Lower(f) < Lower(best) Then best = f
		EndIf
	Forever
	CloseDir dir
	If best = "" Then Return ""
	Return dataPath + best
End Function

Function IsMovieFile(f$)
	Local dot = Instr(f, ".")
	If dot = 0 Then Return False
	; The last dot: names like "my.trailer.mp4" are fine.
	Local nextDot = Instr(f, ".", dot + 1)
	While nextDot > 0
		dot = nextDot
		nextDot = Instr(f, ".", dot + 1)
	Wend
	Local ext$ = Lower(Mid(f, dot + 1))
	Select ext
		Case "mp4", "m4v", "mov", "mkv", "webm", "avi", "mpg", "mpeg", "ts", "wmv", "ogv", "flv"
			Return True
	End Select
	Return False
End Function

Function FileName$(path$)
	Local i
	For i = Len(path) To 1 Step -1
		Local c$ = Mid(path, i, 1)
		If c = "/" Or c = "\" Then Return Mid(path, i + 1)
	Next
	Return path
End Function

; --- Building the city -----------------------------------------------------------------------------------------------

; Blocks of towers around an open plaza in the middle. The block north of the plaza is the tower with the screen.
Function BuildCity()
	; The street: one big square, with the texture repeated every 8 units.
	Local ground = CreateMesh()
	Local surf = CreateSurface(ground)
	Local s# = CITY + 60, uv# = s / 4
	AddQuad(surf, -s, 0, s, s, 0, s, s, 0, -s, -s, 0, -s, uv, uv)
	EntityTexture ground, texGround
	EntityFX ground, BB_FX_FULLBRIGHT

	; The sky: a big ball seen from the inside, without fog so it stays dark purple at the horizon.
	Local sky = CreateSphere(16)
	ScaleEntity sky, 500, 500, 500
	EntityColor sky, 22, 12, 42
	EntityFX sky, BB_FX_FULLBRIGHT + BB_FX_NO_FOG + BB_FX_TWO_SIDED
	EntityOrder sky, 1

	Local i, j
	For i = -BLOCKS To BLOCKS
		For j = -BLOCKS To BLOCKS
			If Abs(i) <= 1 And Abs(j) <= 1 Then
				; The plaza.
			ElseIf i = 0 And j = 2
				; The screen tower. Its front is just behind the screen.
				AddBuilding(0, 44, 14, 8, 42, 1)
			Else
				; One to four towers on a block, with streets of at least 8 units between the blocks.
				Local cx# = i * BLOCK, cz# = j * BLOCK
				If Rand(1, 3) = 1
					AddBuilding(cx, cz, Rnd(5, 8), Rnd(5, 8), Rnd(12, 70), Rand(0, 2))
				Else
					AddBuilding(cx - 4, cz - 4, Rnd(2.5, 3.8), Rnd(2.5, 3.8), Rnd(10, 45), Rand(0, 2))
					AddBuilding(cx + 4, cz - 4, Rnd(2.5, 3.8), Rnd(2.5, 3.8), Rnd(10, 45), Rand(0, 2))
					AddBuilding(cx - 4, cz + 4, Rnd(2.5, 3.8), Rnd(2.5, 3.8), Rnd(10, 45), Rand(0, 2))
					AddBuilding(cx + 4, cz + 4, Rnd(2.5, 3.8), Rnd(2.5, 3.8), Rnd(10, 45), Rand(0, 2))
				EndIf
			EndIf
		Next
	Next

	; Street lamps around the plaza: a post and a glowing head.
	For i = 0 To 7
		Local a# = i * 45 + 22.5
		Local lx# = Sin(a) * 26, lz# = Cos(a) * 26
		Local post = CreateCylinder(6)
		ScaleEntity post, 0.08, 2.2, 0.08
		PositionEntity post, lx, 2.2, lz
		EntityColor post, 40, 40, 55
		EntityFX post, BB_FX_FULLBRIGHT
		Local head = CreateSphere(8)
		ScaleEntity head, 0.35, 0.35, 0.35
		PositionEntity head, lx, 4.5, lz
		EntityColor head, 160, 255, 250
		EntityFX head, BB_FX_FULLBRIGHT
		Local b.Building = New Building
		b\x = lx : b\z = lz : b\hw = 0.1 : b\hd = 0.1
	Next

	; Flying cars in lanes above the streets, half along x and half along z.
	For i = 0 To 23
		Local c.Car = New Car
		c\alongX = i Mod 2
		c\speed = Rnd(0.25, 0.6)
		If Rand(0, 1) = 0 Then c\speed = -c\speed
		c\ent = CreateCube()
		EntityFX c\ent, BB_FX_FULLBRIGHT
		Local lane# = (Rand(-BLOCKS, BLOCKS - 1) + 0.5) * BLOCK
		Local y# = Rnd(14, 34)
		If c\alongX
			ScaleEntity c\ent, 1.3, 0.35, 0.6
			PositionEntity c\ent, Rnd(-CITY, CITY), y, lane
		Else
			ScaleEntity c\ent, 0.6, 0.35, 1.3
			PositionEntity c\ent, lane, y, Rnd(-CITY, CITY)
		EndIf
		Select Rand(0, 2)
			Case 0 : EntityColor c\ent, 255, 80, 200
			Case 1 : EntityColor c\ent, 80, 230, 255
			Default : EntityColor c\ent, 255, 200, 80
		End Select
	Next
End Function

; A tower with lit windows, and on some of them a glowing strip around the roof.
Function AddBuilding(x#, z#, hw#, hd#, h#, tint)
	Local b.Building = New Building
	b\x = x : b\z = z : b\hw = hw : b\hd = hd

	Local mesh = CreateMesh()
	Local surf = CreateSurface(mesh)
	AddBoxSides(surf, x, z, hw, hd, 0, h, 8)
	EntityTexture mesh, texWindows(tint)
	EntityFX mesh, BB_FX_FULLBRIGHT

	If Rand(0, 2) > 0
		Local neon = CreateMesh()
		Local ns = CreateSurface(neon)
		AddBoxSides(ns, x, z, hw + 0.05, hd + 0.05, h - 0.6, h - 0.25, 0)
		EntityTexture neon, texWhite
		EntityFX neon, BB_FX_FULLBRIGHT
		Select tint
			Case 0 : EntityColor neon, 255, 150, 40
			Case 1 : EntityColor neon, 40, 220, 255
			Default : EntityColor neon, 255, 40, 200
		End Select
	EndIf
End Function

; The four walls and the roof of a box from y0 to y1. tile is the size in units of one repeat of the texture (0 stretches
; it once over every side).
Function AddBoxSides(surf, x#, z#, hw#, hd#, y0#, y1#, tile#)
	Local uw# = 1, ud# = 1, uh# = 1
	If tile > 0 Then uw = hw * 2 / tile : ud = hd * 2 / tile : uh = (y1 - y0) / tile
	Local x0# = x - hw, x1# = x + hw, z0# = z - hd, z1# = z + hd
	AddQuad(surf, x0, y1, z0, x1, y1, z0, x1, y0, z0, x0, y0, z0, uw, uh) ; South (-z).
	AddQuad(surf, x1, y1, z1, x0, y1, z1, x0, y0, z1, x1, y0, z1, uw, uh) ; North (+z).
	AddQuad(surf, x1, y1, z0, x1, y1, z1, x1, y0, z1, x1, y0, z0, ud, uh) ; East (+x).
	AddQuad(surf, x0, y1, z1, x0, y1, z0, x0, y0, z0, x0, y0, z1, ud, uh) ; West (-x).
	; The roof is dark: the texture at a spot between the windows.
	Local a = AddVertex(surf, x0, y1, z1, 0.01, 0.01), b = AddVertex(surf, x1, y1, z1, 0.01, 0.01)
	Local c = AddVertex(surf, x1, y1, z0, 0.01, 0.01), d = AddVertex(surf, x0, y1, z0, 0.01, 0.01)
	AddTriangle surf, a, b, c
	AddTriangle surf, a, c, d
End Function

; A four-cornered side, given top left, top right, bottom right and bottom left as seen from the front.
Function AddQuad(surf, x0#, y0#, z0#, x1#, y1#, z1#, x2#, y2#, z2#, x3#, y3#, z3#, u#, v#)
	Local a = AddVertex(surf, x0, y0, z0, 0, 0)
	Local b = AddVertex(surf, x1, y1, z1, u, 0)
	Local c = AddVertex(surf, x2, y2, z2, u, v)
	Local d = AddVertex(surf, x3, y3, z3, 0, v)
	AddTriangle surf, a, b, c
	AddTriangle surf, a, c, d
End Function

; The screen, its frame, and where its sound comes from.
Function BuildScreen()
	Local hw# = screenWidth / 2, hh# = screenHeight / 2

	; The frame: a dark box a little bigger than the screen, with a cyan glow along its edge.
	Local frameMesh = CreateMesh()
	Local fs = CreateSurface(frameMesh)
	AddBoxSides(fs, SCREEN_X, SCREEN_Z + 0.25, hw + 0.6, 0.2, SCREEN_Y - hh - 0.6, SCREEN_Y + hh + 0.6, 0)
	AddQuad(fs, SCREEN_X - hw - 0.6, SCREEN_Y + hh + 0.6, SCREEN_Z + 0.05, SCREEN_X + hw + 0.6, SCREEN_Y + hh + 0.6, SCREEN_Z + 0.05, SCREEN_X + hw + 0.6, SCREEN_Y - hh - 0.6, SCREEN_Z + 0.05, SCREEN_X - hw - 0.6, SCREEN_Y - hh - 0.6, SCREEN_Z + 0.05, 1, 1)
	EntityTexture frameMesh, texWhite
	EntityColor frameMesh, 12, 12, 20
	EntityFX frameMesh, BB_FX_FULLBRIGHT
	Local glow = CreateMesh()
	Local gs = CreateSurface(glow)
	AddBoxSides(gs, SCREEN_X, SCREEN_Z + 0.2, hw + 0.75, 0.1, SCREEN_Y - hh - 0.75, SCREEN_Y - hh - 0.6, 0)
	AddBoxSides(gs, SCREEN_X, SCREEN_Z + 0.2, hw + 0.75, 0.1, SCREEN_Y + hh + 0.6, SCREEN_Y + hh + 0.75, 0)
	EntityTexture glow, texWhite
	EntityColor glow, 60, 240, 255
	EntityFX glow, BB_FX_FULLBRIGHT

	; The picture: one quad facing south, in front of the frame.
	screenEnt = CreateMesh()
	Local ss = CreateSurface(screenEnt)
	AddQuad(ss, -hw, hh, 0, hw, hh, 0, hw, -hh, 0, -hw, -hh, 0, 1, 1)
	PositionEntity screenEnt, SCREEN_X, SCREEN_Y, SCREEN_Z
	EntityFX screenEnt, BB_FX_FULLBRIGHT + BB_FX_NO_FOG

	If movie <> 0
		EntityTexture screenEnt, GetMovieTexture(movie)
		LoopMovie movie, optLoop
		EmitMovie movie, screenEnt
		If MovieChannel(movie) <> 0 Then ChannelRadius MovieChannel(movie), hw
	Else
		; No movie: a test pattern that scrolls, and a hum from the screen so there is still something to hear.
		testPattern = MakeTestPattern()
		EntityTexture screenEnt, testPattern
		screenSound = MakeTone(110, 2000, 0.3, True)
		If screenSound <> 0
			LoopSound screenSound
			humChannel = EmitSound(screenSound, screenEnt)
			If humChannel <> 0 Then ChannelRadius humChannel, hw
		EndIf
	EndIf
End Function

; --- Textures --------------------------------------------------------------------------------------------------------

Function MakeWhiteTexture()
	Local tex = CreateTexture(4, 4, BB_TEXTURE_COLOR)
	SetBuffer TextureBuffer(tex)
	ClsColor 255, 255, 255
	Cls
	SetBuffer BackBuffer()
	ClsColor 0, 0, 0
	Return tex
End Function

; 64 by 64 pixels for 8 by 8 units: dark wall, 4 by 4 windows, about half of them lit.
Function MakeWindowTexture(r, g, b)
	Local tex = CreateTexture(64, 64, BB_TEXTURE_COLOR + BB_TEXTURE_MIPMAPPED)
	Local buf = TextureBuffer(tex)
	LockBuffer buf
	Local x, y, wx, wy
	For y = 0 To 63
		For x = 0 To 63
			WritePixelFast x, y, $FF0C0A16, buf
		Next
	Next
	For wy = 0 To 3
		For wx = 0 To 3
			Local lit# = 0.08
			If Rand(0, 9) < 5 Then lit = Rnd(0.55, 1.0)
			Local c = $FF000000 + (Int(r * lit) Shl 16) + (Int(g * lit) Shl 8) + Int(b * lit)
			For y = wy * 16 + 4 To wy * 16 + 12
				For x = wx * 16 + 3 To wx * 16 + 12
					WritePixelFast x, y, c, buf
				Next
			Next
		Next
	Next
	UnlockBuffer buf
	Return tex
End Function

; 64 by 64 pixels for 4 by 4 units: dark paving with thin cyan seams.
Function MakeGroundTexture()
	Local tex = CreateTexture(64, 64, BB_TEXTURE_COLOR + BB_TEXTURE_MIPMAPPED)
	Local buf = TextureBuffer(tex)
	LockBuffer buf
	Local x, y
	For y = 0 To 63
		For x = 0 To 63
			Local v = 20 + Rand(0, 6)
			Local c = $FF000000 + (v Shl 16) + (v Shl 8) + (v + 8)
			If x = 0 Or y = 0 Then c = $FF1A4A5A
			WritePixelFast x, y, c, buf
		Next
	Next
	UnlockBuffer buf
	Return tex
End Function

; Colour bars with "NO SIGNAL", for when there is no movie.
Function MakeTestPattern()
	Local tex = CreateTexture(256, 144, BB_TEXTURE_COLOR)
	SetBuffer TextureBuffer(tex)
	Local i
	For i = 0 To 6
		Select i
			Case 0 : Color 200, 200, 200
			Case 1 : Color 200, 200, 0
			Case 2 : Color 0, 200, 200
			Case 3 : Color 0, 200, 0
			Case 4 : Color 200, 0, 200
			Case 5 : Color 200, 0, 0
			Default : Color 0, 0, 200
		End Select
		Rect i * 256 / 7, 0, 256 / 7 + 1, 104, 1
	Next
	Color 16, 16, 24
	Rect 0, 104, 256, 40, 1
	Color 255, 255, 255
	SetFont menuFont
	Text 128, 124, "NO SIGNAL", True, True
	SetFont 0
	Color 0, 0, 0
	Rect 64, 40, 128, 28, 1
	Color 255, 255, 255
	Text 128, 54, "put a movie in data/", True, True
	SetBuffer BackBuffer()
	Return tex
End Function

; --- Sounds ----------------------------------------------------------------------------------------------------------

; A sine tone with a little buzz, written as a WAV file and loaded. A looped tone (the hum) has no fade, so it loops
; without a click; it is a whole number of cycles long. Returns 0 if it could not be made: the demo works without it.
Function MakeTone(hz#, lengthMs, volume#, looped)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	If looped Then samples = Int(Floor(samples * hz / rate) * rate / hz)
	Local bank = CreateBank(44 + samples * 2)
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16
	PokeShort bank, 20, 1
	PokeShort bank, 22, 1
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2
	PokeShort bank, 32, 2
	PokeShort bank, 34, 16
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local i, t#, v#, envelope#
	For i = 0 To samples - 1
		t = Float(i) / rate
		v = Sin(360.0 * hz * t) * 0.8 + Sin(720.0 * hz * t) * 0.15 + Sin(1080.0 * hz * t) * 0.05
		envelope = 1.0
		If Not looped
			If i < 64 Then envelope = i / 64.0
			envelope = envelope * (1.0 - Float(i) / samples)
		EndIf
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "movie-billboard-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound
	If looped Then sound = Load3DSound(path) Else sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

Function PlayClick()
	If sndClick <> 0 Then PlaySound sndClick
End Function

; --- Updates ---------------------------------------------------------------------------------------------------------

; Things that move whatever the state: the cars, and the test pattern when there is no movie.
Function UpdateCity()
	Local c.Car
	For c = Each Car
		If c\alongX
			MoveEntity c\ent, c\speed / 1.3, 0, 0
			If EntityX(c\ent) > CITY + 40 Then PositionEntity c\ent, -CITY - 40, EntityY(c\ent), EntityZ(c\ent)
			If EntityX(c\ent) < -CITY - 40 Then PositionEntity c\ent, CITY + 40, EntityY(c\ent), EntityZ(c\ent)
		Else
			MoveEntity c\ent, 0, 0, c\speed / 1.3
			If EntityZ(c\ent) > CITY + 40 Then PositionEntity c\ent, EntityX(c\ent), EntityY(c\ent), -CITY - 40
			If EntityZ(c\ent) < -CITY - 40 Then PositionEntity c\ent, EntityX(c\ent), EntityY(c\ent), CITY + 40
		EndIf
	Next
	If testPattern <> 0 Then PositionTexture testPattern, 0, (frame Mod 240) / 240.0
End Function

Function UpdatePlay()
	If KeyHit(BB_KEY_ESCAPE) Then GoToPause() : Return
	If KeyHit(BB_KEY_P) Then SetMoviePaused(Not moviePaused)
	If KeyHit(BB_KEY_R) And movie <> 0
		SeekMovie movie, 0
		SetMoviePaused(False)
		PlayMovie movie
	EndIf

	; Looking around. The mouse is put back in the middle every update, so it never leaves the window.
	Local mx# = Float(MouseXSpeed()), my# = Float(MouseYSpeed())
	MoveMouse SCREEN_W / 2, SCREEN_H / 2
	Local turn# = optSensitivity * 0.03
	yaw = yaw - mx * turn
	If optInvert Then pitch = pitch - my * turn Else pitch = pitch + my * turn
	If pitch > 85 Then pitch = 85
	If pitch < -85 Then pitch = -85

	; Walking, relative to where the player looks, one axis at a time so walls can be slid along.
	Local fwd# = Float(KeyDown(BB_KEY_W) - KeyDown(BB_KEY_S))
	Local side# = Float(KeyDown(BB_KEY_D) - KeyDown(BB_KEY_A))
	Local speed# = WALK_SPEED
	If KeyDown(BB_KEY_LSHIFT) Then speed = RUN_SPEED
	If fwd <> 0 And side <> 0 Then speed = speed * 0.7071
	Local dx# = (Sin(-yaw) * fwd + Cos(yaw) * side) * speed
	Local dz# = (Cos(yaw) * fwd + Sin(yaw) * side) * speed
	If Not Blocked(px + dx, pz) Then px = px + dx
	If Not Blocked(px, pz + dz) Then pz = pz + dz
	If fwd <> 0 Or side <> 0 Then bobPhase = bobPhase + speed * 90

	PlaceCamera()
End Function

Function Blocked(x#, z#)
	If Abs(x) > CITY Or Abs(z) > CITY Then Return True
	Local b.Building
	For b = Each Building
		If Abs(x - b\x) < b\hw + PLAYER_R And Abs(z - b\z) < b\hd + PLAYER_R Then Return True
	Next
	Return False
End Function

Function PlaceCamera()
	PositionEntity camera, px, EYE + Sin(bobPhase) * 0.04, pz
	RotateEntity camera, pitch, yaw, 0
End Function

Function ResetPlayer()
	px = 0 : pz = -18 : yaw = 0 : pitch = -12 : bobPhase = 0
End Function

; Behind the menus the camera circles slowly around the plaza, always looking at the screen.
Function UpdateMenuCamera()
	Local a# = Sin(frame * 0.15) * 35
	PositionEntity camera, Sin(a) * 30, 6, SCREEN_Z - Cos(a) * 52
	PointEntity camera, screenEnt
End Function

Function SetMoviePaused(paused)
	If movie = 0 Then Return
	moviePaused = paused
	If paused Then PauseMovie movie Else PlayMovie movie
End Function

; --- Menus -----------------------------------------------------------------------------------------------------------

Function MenuInput()
	If KeyHit(BB_KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount : PlayClick()
	If KeyHit(BB_KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount : PlayClick()
	Local row = MenuLineAt(MouseX(), MouseY())
	If row >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = row
	If KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Then Return menuSelected
	If MouseHit(BB_MOUSE_LEFT) And row >= 0
		menuSelected = row
		Return row
	EndIf
	Return -1
End Function

; Which line is at a screen position, or -1. Lines are 36 pixels apart and 440 wide.
Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 220 Or x >= SCREEN_W / 2 + 220 Or y < menuTop Then Return -1
	Local row = (y - menuTop) / 36
	If row >= menuCount Then Return -1
	Return row
End Function

Function OpenMenu(newState, count, top)
	state = newState
	menuCount = count
	menuTop = top
	menuSelected = 0
	ShowPointer
	FlushKeys
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

Function GoToMenu()
	OpenMenu(STATE_MENU, 4, 520)
	menuText(0) = "Walk into the plaza"
	menuText(1) = "Options"
	menuText(2) = "How it works"
	menuText(3) = "Quit"
End Function

Function GoToPause()
	OpenMenu(STATE_PAUSED, 4, 300)
	menuText(0) = "Back to the plaza"
	menuText(1) = "Options"
	menuText(2) = "Play the movie from the start"
	menuText(3) = "Main menu"
End Function

Function GoToOptions(fromPause)
	optionsFromPause = fromPause
	OpenMenu(STATE_OPTIONS, 6, 250)
	RefreshOptionsText()
End Function

Function RefreshOptionsText()
	menuText(0) = "Mouse speed: " + optSensitivity
	If optInvert Then menuText(1) = "Invert mouse: On" Else menuText(1) = "Invert mouse: Off"
	menuText(2) = "Field of view: " + fovName(optFov)
	menuText(3) = "Movie volume: " + (optVolume * 10) + "%"
	If optLoop Then menuText(4) = "Loop the movie: On" Else menuText(4) = "Loop the movie: Off"
	menuText(5) = "Back"
End Function

Function StartPlay()
	state = STATE_PLAY
	HidePointer
	FlushKeys
	FlushMouse
	MoveMouse SCREEN_W / 2, SCREEN_H / 2
	MouseXSpeed()
	MouseYSpeed()
	PlaceCamera()
End Function

Function UpdateMenu()
	UpdateMenuCamera()
	If KeyHit(BB_KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0
			PlayClick()
			ResetPlayer()
			StartPlay()
		Case 1
			PlayClick()
			GoToOptions(False)
		Case 2
			PlayClick()
			state = STATE_HELP
			FlushKeys
			FlushMouse
		Case 3
			Return True
	End Select
	Return False
End Function

Function UpdatePause()
	If KeyHit(BB_KEY_ESCAPE) Then StartPlay() : Return
	Select MenuInput()
		Case 0
			PlayClick()
			StartPlay()
		Case 1
			PlayClick()
			GoToOptions(True)
		Case 2
			PlayClick()
			If movie <> 0
				SeekMovie movie, 0
				SetMoviePaused(False)
				PlayMovie movie
			EndIf
			StartPlay()
		Case 3
			PlayClick()
			GoToMenu()
	End Select
End Function

Function UpdateOptions()
	If Not optionsFromPause Then UpdateMenuCamera()
	Local change = 0
	If KeyHit(BB_KEY_LEFT) Then change = -1
	If KeyHit(BB_KEY_RIGHT) Then change = 1
	Local picked = MenuInput()
	If picked >= 0 Then change = 1 ; Enter or a click steps to the next value.

	If KeyHit(BB_KEY_ESCAPE) Or picked = 5
		SaveSettings()
		PlayClick()
		If optionsFromPause Then GoToPause() Else GoToMenu()
		menuSelected = 1
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optSensitivity = (optSensitivity - 1 + change + 10) Mod 10 + 1
		Case 1 : optInvert = Not optInvert
		Case 2 : optFov = (optFov + change + 3) Mod 3
		Case 3 : optVolume = (optVolume + change + 11) Mod 11
		Case 4 : optLoop = Not optLoop
	End Select
	ApplyOptions()
	PlayClick()
	RefreshOptionsText()
End Function

Function ApplyOptions()
	CameraZoom camera, fovZoom(optFov)
	If movie <> 0
		MovieVolume movie, optVolume / 10.0
		LoopMovie movie, optLoop
	EndIf
	If humChannel <> 0 Then ChannelVolume humChannel, optVolume / 10.0
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawOverlay()
	Select state
		Case STATE_MENU
			DrawTitle("NEON PLAZA", 70)
			SmallText(SCREEN_W / 2, 120, "A movie on a screen in the city, and its sound in the street", True)
			DrawMenu()
			DrawMovieLine(SCREEN_H - 40)
		Case STATE_OPTIONS
			ShadeScreen()
			DrawTitle("Options", 170)
			DrawMenu()
			SmallText(SCREEN_W / 2, 490, "Left/Right or a click change the selected option.", True)
		Case STATE_HELP
			ShadeScreen()
			DrawHelp()
		Case STATE_PLAY
			DrawHud()
		Case STATE_PAUSED
			ShadeScreen()
			DrawTitle("Paused", 220)
			DrawMenu()
	End Select
End Function

Function DrawHud()
	DrawMovieLine(16)
	Local dx# = px - SCREEN_X, dz# = pz - SCREEN_Z
	SmallText(16, 40, "Distance to the screen: " + Int(Sqr(dx * dx + dz * dz)) + " m", False)
	SmallText(16, SCREEN_H - 30, "WASD walk, Shift run, P pause the movie, R from the start, Escape menu", False)
	; A small dot in the middle, so it is clear where the view points.
	Color 255, 255, 255
	Rect SCREEN_W / 2 - 1, SCREEN_H / 2 - 1, 3, 3, 1
End Function

; What is playing: the file and the time, or where to put a file.
Function DrawMovieLine(y)
	If movie = 0
		If moviePath = ""
			SmallText(16, y, "No movie found. Put one into the data folder or give its path on the command line (see README.md).", False)
		Else
			SmallText(16, y, "Could not open " + moviePath + ". The test pattern plays instead.", False)
		EndIf
		Return
	EndIf
	Local s$ = movieName + "   " + TimeText(MoviePosition(movie)) + " / " + TimeText(MovieLength(movie))
	If moviePaused
		s = s + "   (paused)"
	ElseIf Not MoviePlaying(movie)
		s = s + "   (over, R plays it again)"
	EndIf
	SmallText(16, y, s, False)
End Function

Function TimeText$(seconds#)
	Local t = Int(Floor(seconds))
	If t < 0 Then t = 0
	Local sec$ = Str(t Mod 60)
	If Len(sec) < 2 Then sec = "0" + sec
	Return (t / 60) + ":" + sec
End Function

Function DrawTitle(title$, y)
	SetFont titleFont
	Color 30, 10, 40
	Text SCREEN_W / 2 + 3, y + 3, title, True, True
	Color 255, 90, 220
	Text SCREEN_W / 2, y, title, True, True
	SetFont 0
End Function

Function DrawMenu()
	Local i, y
	SetFont menuFont
	For i = 0 To menuCount - 1
		y = menuTop + i * 36
		If i = menuSelected
			Color 70, 20, 80
			Rect SCREEN_W / 2 - 220, y, 440, 32, 1
			Color 60, 240, 255
			Rect SCREEN_W / 2 - 220, y, 440, 32, 0
			Color 255, 245, 255
		Else
			Color 16, 12, 30
			Rect SCREEN_W / 2 - 220, y, 440, 32, 1
			Color 205, 205, 235
		EndIf
		Text SCREEN_W / 2, y + 16, menuText(i), True, True
	Next
	SetFont 0
End Function

Function DrawHelp()
	DrawTitle("How it works", 110)
	Local y = 175, i, helpLine$
	Restore HelpText
	SetFont smallFont
	For i = 1 To 15
		Read helpLine
		Color 230, 230, 245
		Text 200, y, helpLine
		y = y + 24
	Next
	SetFont 0
	SmallText(SCREEN_W / 2, 580, "Press Enter or click to go back.", True)
End Function

Function SmallText(x, y, s$, centered)
	SetFont smallFont
	Color 0, 0, 0
	Text x + 1, y + 1, s, centered
	Color 230, 235, 250
	Text x, y, s, centered
	SetFont 0
End Function

; Darkens the scene behind a menu, with a pattern of every other pixel, so the text stays easy to read.
Function ShadeScreen()
	Color 0, 0, 0
	Local y
	For y = 0 To SCREEN_H - 1 Step 2
		Line 0, y, SCREEN_W - 1, y
	Next
End Function

; --- Settings --------------------------------------------------------------------------------------------------------

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If file = 0 Then Return
	While Not Eof(file)
		Local l$ = ReadLine(file)
		Local eq = Instr(l, "=")
		If eq > 0
			Local key$ = Lower(Trim(Left(l, eq - 1))), value = Int(Trim(Mid(l, eq + 1)))
			Select key
				Case "sensitivity" : If value >= 1 And value <= 10 Then optSensitivity = value
				Case "invert" : optInvert = (value <> 0)
				Case "fov" : If value >= 0 And value <= 2 Then optFov = value
				Case "volume" : If value >= 0 And value <= 10 Then optVolume = value
				Case "loop" : optLoop = (value <> 0)
			End Select
		EndIf
	Wend
	CloseFile file
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If file = 0 Then Return
	WriteLine file, "sensitivity=" + optSensitivity
	WriteLine file, "invert=" + optInvert
	WriteLine file, "fov=" + optFov
	WriteLine file, "volume=" + optVolume
	WriteLine file, "loop=" + optLoop
	CloseFile file
End Function

