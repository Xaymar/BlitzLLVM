; Foldgate: a puzzle game about two linked holes in the walls. Shoot one, shoot the other, step through.
;
; Every picture and sound in this game is made by the code itself, so there are no files to ship with it.
;
; Controls:
;   Mouse                  look around
;   W A S D                walk
;   Space                  jump
;   Left mouse button      open the amber gate on the panel you look at
;   Right mouse button     open the violet gate
;   E                      pick up a cube, or put it down
;   R                      start the chamber again
;   Escape or P            the pause menu
;   Menus                  Up/Down or the mouse choose, Enter/Space or a click select, Left/Right change an option
;
; How it plays: every chamber is a room of dark walls and white panels. A gate can only open on a white panel. With
; both gates open, whatever goes into one comes out of the other, at the same speed, so falling into a gate in the
; floor throws you out of a gate in a wall. Cubes hold down buttons, buttons open doors, and green goo is deadly.
;
; How it works: a chamber is a grid of cells, 2 units on a side, read from Data lines. The player and the cubes are
; boxes that move one axis at a time and stop at solid cells. A cell with a gate on it is not solid for a box that
; fits inside the gate, so the box can go in; once its middle is behind the gate, it is moved to the other gate,
; turned around, and keeps its speed.
;
; The view through a gate uses the stencil buffer (SetCameraStencil, SetEntityStencil). RenderWorld runs three times
; a frame: first the room from the player's eyes, where each gate writes its number into the stencil. Then twice from
; a camera that stands behind the other gate, as far behind it as the player is in front of this one; this time
; everything is only drawn where the stencil holds that gate's number. The walls that carry gates are on the outside
; of a chamber, so there is never anything between that camera and its gate.
;
; The options, the chambers that are open and the best times are saved in foldgate.cfg next to the program.

Include "<keys.bb>"
Include "<mouse.bb>"
Include "<graphics.bb>"
Include "<texture.bb>"
Include "<entity.bb>"

Const SCREEN_W = 800, SCREEN_H = 600
Const BG_R = 10, BG_G = 12, BG_B = 18

Const CELL# = 2.0            ; The size of a cell, in units (metres).
Const MAX_X = 14, MAX_Y = 9, MAX_Z = 14
Const K_AIR = 0, K_WALL = 1, K_PANEL = 2, K_GLASS = 3
Const LEVELS = 6

Const GRAVITY# = 0.012       ; In units per update per update; there are 60 updates every second.
Const JUMP_SPEED# = 0.19     ; A jump of about 1.5 units: not enough to climb a cell.
Const WALK_SPEED# = 0.1      ; 6 units a second.
Const MAX_FALL# = 1.0        ; The fastest anything falls, in units per update.
Const PLAYER_HW# = 0.35, PLAYER_HH# = 0.8, EYE# = 0.6
Const CUBE_H# = 0.4
Const GATE_R# = 0.92         ; The radius of a gate; a cell side is 2 units.
Const HOLD_DIST# = 1.6       ; How far in front of the eyes a carried cube is.

Const STATE_MENU = 0, STATE_LEVELS = 1, STATE_OPTIONS = 2, STATE_HELP = 3, STATE_PLAY = 4, STATE_PAUSED = 5
Const STATE_DONE = 6, STATE_DEAD = 7

; --- Things in a chamber ---------------------------------------------------------------------------------------------

Type Cube
	Field ent
	Field x#, y#, z#, vx#, vy#, vz#
	Field sx#, sy#, sz#   ; Where it appears, and appears again after falling into goo.
	Field onGround
	Field stuck   ; How many frames a carried cube has been kept far from where it should be.
End Type

Type Button
	Field cx, cy, cz
	Field ent, light
	Field pressed
End Type

Type Door
	Field cx, cy, cz
	Field ent, alongX
	Field open#           ; 0 closed, 1 open.
End Type

Type Spark
	Field ent
	Field vx#, vy#, vz#, life, maxLife
End Type

; --- The grid --------------------------------------------------------------------------------------------------------
Dim kind(MAX_X - 1, MAX_Y - 1, MAX_Z - 1)
Dim goo(MAX_X - 1, MAX_Y - 1, MAX_Z - 1)
Dim exitCell(MAX_X - 1, MAX_Y - 1, MAX_Z - 1)
Dim gateFace(MAX_X - 1, MAX_Y - 1, MAX_Z - 1, 5) ; Whether a gate can open on this side of the cell.
Global sizeX, sizeY, sizeZ

; The six sides of a cell: +x, -x, +y, -y, +z, -z.
Dim faceX(5), faceY(5), faceZ(5)
faceX(0) = 1 : faceX(1) = -1 : faceY(2) = 1 : faceY(3) = -1 : faceZ(4) = 1 : faceZ(5) = -1
; The corners of each side of a unit box, in the order AddTriangle needs them to face out.
Dim faceCorner(5, 3, 2)
Restore FaceCorners
Local f, c, a
For f = 0 To 5
	For c = 0 To 3
		For a = 0 To 2
			Read faceCorner(f, c, a)
		Next
	Next
Next

; --- The gates -------------------------------------------------------------------------------------------------------
; Gate 0 is amber, gate 1 is violet. Each has a pivot on the wall (its z axis points out of the wall), a pivot turned
; half around (for the way out), the disc and the glowing rim, and the camera that shows what is behind the other one.
Dim gateOn(1), gateCX(1), gateCY(1), gateCZ(1), gateSide(1)
Dim gatePivot(1), gateBack(1), gateDisc(1), gateRim(1), gateCam(1), gateProbe(1), gateGlow(1)
Dim gateR(1), gateG(1), gateB(1)
gateR(0) = 255 : gateG(0) = 150 : gateB(0) = 30
gateR(1) = 150 : gateG(1) = 70 : gateB(1) = 255

; --- Options and progress --------------------------------------------------------------------------------------------
Global optSensitivity = 5    ; 1 to 10.
Global optInvert = False
Global optFov = 1            ; 0 narrow, 1 normal, 2 wide.
Global optVolume = 4         ; 0 to 4, in quarters.
Global optBob = True         ; Whether the view bobs while walking.
Global optFullscreen = False
Global levelsOpen = 1        ; How many chambers can be chosen.
Dim bestTime(LEVELS - 1)     ; In updates; 0 when not finished yet.
Dim fovName$(2), fovZoom#(2)
fovName(0) = "Narrow" : fovZoom(0) = 1.25
fovName(1) = "Normal" : fovZoom(1) = 1.0
fovName(2) = "Wide" : fovZoom(2) = 0.8

Global folder$ = SystemProperty$("appdir")
If folder <> "" And Right(folder, 1) <> "\" And Right(folder, 1) <> "/" Then folder = folder + "/"
Global settingsPath$ = folder + "foldgate.cfg"
LoadSettings()

; --- The player ------------------------------------------------------------------------------------------------------
Global px#, py#, pz#, pvx#, pvy#, pvz#, yaw#, pitch#, onGround
Global startX#, startY#, startZ#, startYaw#
Global carried.Cube
Global bobPhase#, landTimer, lastFall#

; --- The game --------------------------------------------------------------------------------------------------------
Global state = STATE_MENU, frame
Global level, levelName$, levelHint$, levelTicks, gatesShot, hintTimer
Global deadTimer, doneNewBest
Dim menuText$(9)
Global menuCount, menuSelected, menuTop
Global optionsFromPause, menuAngle#
Global exitCount
Dim exitEnt(15)
; The box being moved by MoveBox: where it is, how fast it goes, its half sizes, and what happened.
Global bx#, by#, bz#, bvx#, bvy#, bvz#, bhw#, bhh#, bGround, bSelf.Cube, bPassed, bSlack#
Global shadeImage
Global watermark, watermarkColor ; DrawWatermark makes the image the first time it is needed.

; Entities and textures. OpenScreen makes them, and makes them again when the screen opens in another mode.
Global camera, sun, body, chamber, glassMesh, gooMesh, exitBeam
Global texWall, texPanel, texGlass, texGoo, texCube, texGlow, texDoor, texRim
Dim texGate(1)
Global titleFont, menuFont, helpFont, hudFont, bigFont
OpenScreen()

Const WAVE_SQUARE = 0, WAVE_SINE = 1, WAVE_NOISE = 2
Global sndShoot = MakeSound(1800, 500, 120, WAVE_SINE, 0.25)
Global sndOpen = MakeSound(200, 700, 320, WAVE_SINE, 0.3)
Global sndFizzle = MakeSound(900, 200, 180, WAVE_NOISE, 0.2)
Global sndPass = MakeSound(300, 1200, 260, WAVE_SINE, 0.22)
Global sndJump = MakeSound(300, 520, 90, WAVE_SINE, 0.15)
Global sndLand = MakeSound(140, 60, 90, WAVE_NOISE, 0.25)
Global sndPress = MakeSound(500, 250, 140, WAVE_SQUARE, 0.12)
Global sndRelease = MakeSound(250, 500, 140, WAVE_SQUARE, 0.1)
Global sndDoor = MakeSound(110, 160, 500, WAVE_SQUARE, 0.12)
Global sndPick = MakeSound(700, 1000, 80, WAVE_SINE, 0.2)
Global sndDrop = MakeSound(600, 350, 80, WAVE_SINE, 0.2)
Global sndGoo = MakeSound(200, 50, 600, WAVE_NOISE, 0.4)
Global sndDone = MakeSound(520, 1560, 700, WAVE_SINE, 0.3)
Global sndClick = MakeSound(900, 900, 25, WAVE_SQUARE, 0.08)

Local timer = CreateTimer(60)
GoToMenu()
Local quit = False
While Not quit
	WaitTimer timer
	frame = frame + 1

	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_LEVELS
			UpdateLevelMenu()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_HELP
			UpdateMenuScene()
			If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Or MouseHit(BB_MOUSE_LEFT) Then GoToMenu() : menuSelected = 3
		Case STATE_PLAY
			UpdatePlay()
		Case STATE_PAUSED
			UpdatePause()
		Case STATE_DONE
			UpdateDone()
		Case STATE_DEAD
			UpdateDead()
	End Select

	DrawGame()
	Flip
Wend

SaveSettings()
End

; --- Screen and settings ---------------------------------------------------------------------------------------------

; Opens the window or full screen, as the option says. Graphics3D frees every entity, texture and font, so all of them
; are made again here, and the chamber behind the menus is built again.
Function OpenScreen()
	If optFullscreen Then Graphics3D SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_FULLSCREEN Else Graphics3D SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_WINDOWED
	AppTitle "Foldgate"
	SetBuffer BackBuffer()

	; The old entities are gone; forget them.
	Delete Each Cube
	Delete Each Button
	Delete Each Door
	Delete Each Spark
	carried = Null
	chamber = 0
	exitCount = 0

	MakeTextures()
	titleFont = LoadFont("Arial", 60, True)
	menuFont = LoadFont("Arial", 18, True)
	helpFont = LoadFont("Arial", 16)
	hudFont = LoadFont("Arial", 18, True)
	bigFont = LoadFont("Arial", 40, True)

	; The player's eyes. The background and the watermark are drawn by Cls first, so the camera only clears the depth
	; buffer. It has a stencil, cleared to 0, which the gates write into.
	camera = CreateCamera()
	CameraRange camera, 0.04, 300
	CameraClsMode camera, False, True
	SetCameraStencil camera, True

	; The cameras behind the gates draw over the same picture, and keep the stencil the first one wrote.
	Local i
	For i = 0 To 1
		gateCam(i) = CreateCamera()
		CameraRange gateCam(i), 0.04, 300
		CameraClsMode gateCam(i), False, True
		SetCameraStencil gateCam(i), True
		SetCameraStencilClear gateCam(i), False, 0
		CameraProjMode gateCam(i), BB_PROJ_NONE
	Next
	ApplyCameraOptions()

	sun = CreateLight()
	RotateEntity sun, 55, -30, 0
	LightColor sun, 200, 200, 190
	AmbientLight 110, 112, 120

	BuildLevel(0, True)
	watermark = 0
	shadeImage = 0
End Function

Function ApplyCameraOptions()
	CameraZoom camera, fovZoom(optFov)
	CameraZoom gateCam(0), fovZoom(optFov)
	CameraZoom gateCam(1), fovZoom(optFov)
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	If ReadInt(file) = 1 ; A version number, so a changed file format can be recognised later.
		optSensitivity = ReadInt(file)
		optInvert = ReadInt(file)
		optFov = ReadInt(file)
		optVolume = ReadInt(file)
		optBob = ReadInt(file)
		optFullscreen = ReadInt(file)
		levelsOpen = ReadInt(file)
		Local i
		For i = 0 To LEVELS - 1
			bestTime(i) = ReadInt(file)
		Next
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optSensitivity < 1 Or optSensitivity > 10 Then optSensitivity = 5
	If optFov < 0 Or optFov > 2 Then optFov = 1
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
	If levelsOpen < 1 Or levelsOpen > LEVELS Then levelsOpen = 1
	For i = 0 To LEVELS - 1
		If bestTime(i) < 0 Then bestTime(i) = 0
	Next
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets.
	WriteInt file, 1
	WriteInt file, optSensitivity
	WriteInt file, optInvert
	WriteInt file, optFov
	WriteInt file, optVolume
	WriteInt file, optBob
	WriteInt file, optFullscreen
	WriteInt file, levelsOpen
	Local i
	For i = 0 To LEVELS - 1
		WriteInt file, bestTime(i)
	Next
	CloseFile file
End Function

; Every sound goes through here, so the volume option works everywhere.
Function PlaySfx(sound, volume# = 1.0)
	If sound = 0 Or optVolume = 0 Then Return
	Local channel = PlaySound(sound)
	ChannelVolume channel, volume * optVolume / 4.0
End Function

; --- Building a chamber ----------------------------------------------------------------------------------------------
; A chamber is read from Data lines: its name, a hint, its size in cells, which way the player looks at the start, and
; then the cells, one line of characters for each row, bottom layer first:
;   #  dark wall           P  white panel (gates open on it)    G  glass
;   .  air                 S  where the player starts            C  a cube
;   B  a button            D  a door (open while every button is pressed)
;   E  the way out         X  goo, deadly

Function BuildLevel(index, forMenu)
	ClearLevel()
	level = index
	Select index
		Case 0 : Restore Level1
		Case 1 : Restore Level2
		Case 2 : Restore Level3
		Case 3 : Restore Level4
		Case 4 : Restore Level5
		Default : Restore Level6
	End Select
	Read levelName, levelHint, sizeX, sizeY, sizeZ, startYaw

	Local x, y, z, row$, ch$
	For y = 0 To MAX_Y - 1
		For z = 0 To MAX_Z - 1
			For x = 0 To MAX_X - 1
				kind(x, y, z) = K_WALL
				goo(x, y, z) = False
				exitCell(x, y, z) = False
			Next
		Next
	Next

	; Solid things are made first: the walls, then the doors, buttons and cubes.
	Local cubeX#[15], cubeY#[15], cubeZ#[15], cubes = 0
	For y = 0 To sizeY - 1
		For z = 0 To sizeZ - 1
			Read row
			For x = 0 To sizeX - 1
				ch = Mid(row, x + 1, 1)
				Select ch
					Case "#" : kind(x, y, z) = K_WALL
					Case "P" : kind(x, y, z) = K_PANEL
					Case "G" : kind(x, y, z) = K_GLASS
					Default
						kind(x, y, z) = K_AIR
						Select ch
							Case "S"
								startX = (x + 0.5) * CELL : startY = y * CELL + PLAYER_HH + 0.01 : startZ = (z + 0.5) * CELL
							Case "C"
								If cubes <= 15
									cubeX[cubes] = (x + 0.5) * CELL : cubeY[cubes] = y * CELL + CUBE_H + 0.01 : cubeZ[cubes] = (z + 0.5) * CELL
									cubes = cubes + 1
								EndIf
							Case "B" : AddButton(x, y, z)
							Case "D" : AddDoor(x, y, z)
							Case "E" : exitCell(x, y, z) = True
							Case "X" : goo(x, y, z) = True
						End Select
				End Select
			Next
		Next
	Next
	FindGateFaces()

	chamber = BuildWalls()
	BuildGlassAndGoo()
	Local d.Door
	For d = Each Door
		MakeDoor(d)
	Next
	Local i
	For i = 0 To cubes - 1
		AddCube(cubeX[i], cubeY[i], cubeZ[i])
	Next
	MakeExits()

	; The player's body, only seen through a gate.
	body = MakeBody()

	; The gates come last, so they are drawn after everything else in the room: a gate only marks the stencil where
	; it can be seen.
	For i = 0 To 1
		MakeGate(i)
	Next
	; The camera that shows what is behind gate 0 stands behind gate 1, and the other way round.
	EntityParent gateCam(0), gateBack(1), False
	EntityParent gateCam(1), gateBack(0), False

	px = startX : py = startY : pz = startZ
	pvx = 0 : pvy = 0 : pvz = 0
	yaw = startYaw : pitch = 0
	onGround = False
	carried = Null
	levelTicks = 0
	gatesShot = 0
	hintTimer = 600
	If forMenu Then PlaceMenuGates()
End Function

Function ClearLevel()
	Local cb.Cube, bt.Button, d.Door, s.Spark
	For cb = Each Cube
		FreeEntity cb\ent
		Delete cb
	Next
	For bt = Each Button
		FreeEntity bt\ent
		Delete bt
	Next
	For d = Each Door
		If d\ent <> 0 Then FreeEntity d\ent
		Delete d
	Next
	For s = Each Spark
		FreeEntity s\ent
		Delete s
	Next
	carried = Null
	If chamber <> 0
		FreeEntity chamber
		FreeEntity glassMesh
		FreeEntity gooMesh
		FreeEntity body
		Local i
		For i = 0 To exitCount - 1
			FreeEntity exitEnt(i)
		Next
		For i = 0 To 1
			EntityParent gateCam(i), 0 ; The cameras stay; the gates go.
		Next
		For i = 0 To 1
			FreeEntity gatePivot(i) ; Its children go with it.
			gateOn(i) = False
		Next
	EndIf
	exitCount = 0
	chamber = 0
End Function

Function IsOpen(x, y, z)
	If x < 0 Or y < 0 Or z < 0 Or x >= sizeX Or y >= sizeY Or z >= sizeZ Then Return False
	Return kind(x, y, z) = K_AIR
End Function

; A gate can open on the side of a white panel that faces an open cell, but only if no open cell lies behind the
; plane of that side. Then the camera that looks out of the gate never has anything between itself and the gate.
Function FindGateFaces()
	Local x, y, z, f, ox, oy, oz, plane#, ok
	For x = 0 To sizeX - 1
		For y = 0 To sizeY - 1
			For z = 0 To sizeZ - 1
				For f = 0 To 5
					gateFace(x, y, z, f) = False
					If kind(x, y, z) = K_PANEL
						If IsOpen(x + faceX(f), y + faceY(f), z + faceZ(f))
							ok = True
							; The side lies between this cell and the next one; "behind" means on this cell's side.
							plane = (x + 0.5 + faceX(f) * 0.5) * faceX(f) + (y + 0.5 + faceY(f) * 0.5) * faceY(f) + (z + 0.5 + faceZ(f) * 0.5) * faceZ(f)
							For ox = 0 To sizeX - 1
								For oy = 0 To sizeY - 1
									For oz = 0 To sizeZ - 1
										If ok
											If kind(ox, oy, oz) = K_AIR
												If (ox + 0.5) * faceX(f) + (oy + 0.5) * faceY(f) + (oz + 0.5) * faceZ(f) < plane Then ok = False
											EndIf
										EndIf
									Next
								Next
							Next
							gateFace(x, y, z, f) = ok
						EndIf
					EndIf
				Next
			Next
		Next
	Next
End Function

; The walls: every side of a solid cell that faces an open one. Dark walls and white panels are two surfaces of the
; same mesh.
Function BuildWalls()
	Local mesh = CreateMesh()
	Local dark = CreateSurface(mesh), white = CreateSurface(mesh)
	Local bDark = CreateBrush(), bWhite = CreateBrush()
	BrushTexture bDark, texWall
	BrushTexture bWhite, texPanel
	PaintSurface dark, bDark
	PaintSurface white, bWhite
	FreeBrush bDark
	FreeBrush bWhite
	Local x, y, z, f
	For x = 0 To sizeX - 1
		For y = 0 To sizeY - 1
			For z = 0 To sizeZ - 1
				If kind(x, y, z) = K_WALL Or kind(x, y, z) = K_PANEL
					For f = 0 To 5
						If IsOpen(x + faceX(f), y + faceY(f), z + faceZ(f))
							If kind(x, y, z) = K_PANEL And gateFace(x, y, z, f)
								AddFace(white, x, y, z, f, 255, 255, 255)
							ElseIf kind(x, y, z) = K_PANEL
								AddFace(white, x, y, z, f, 170, 170, 175) ; A panel a gate cannot use is a little darker.
							Else
								AddFace(dark, x, y, z, f, 255, 255, 255)
							EndIf
						EndIf
					Next
				EndIf
			Next
		Next
	Next
	Return mesh
End Function

; One side of a cell as two triangles, with the texture once across it.
Function AddFace(surface, x, y, z, f, r, g, b)
	Local c, v[3], cx#, cy#, cz#, u#, w#
	For c = 0 To 3
		cx = (x + faceCorner(f, c, 0)) * CELL
		cy = (y + faceCorner(f, c, 1)) * CELL
		cz = (z + faceCorner(f, c, 2)) * CELL
		; The texture is laid on the two directions that run along the side.
		If f < 2
			u = Float(faceCorner(f, c, 2)) : w = 1 - Float(faceCorner(f, c, 1))
		ElseIf f < 4
			u = Float(faceCorner(f, c, 0)) : w = Float(faceCorner(f, c, 2))
		Else
			u = Float(faceCorner(f, c, 0)) : w = 1 - Float(faceCorner(f, c, 1))
		EndIf
		v[c] = AddVertex(surface, cx, cy, cz, u, w)
		VertexNormal surface, v[c], Float(faceX(f)), Float(faceY(f)), Float(faceZ(f))
		VertexColor surface, v[c], Float(r), Float(g), Float(b)
	Next
	AddTriangle surface, v[0], v[1], v[2]
	AddTriangle surface, v[0], v[2], v[3]
End Function

; Glass is see-through and both its sides show. Goo is a glowing green sheet a little above the bottom of its cell.
Function BuildGlassAndGoo()
	glassMesh = CreateMesh()
	Local glass = CreateSurface(glassMesh)
	Local x, y, z, f
	For x = 0 To sizeX - 1
		For y = 0 To sizeY - 1
			For z = 0 To sizeZ - 1
				If kind(x, y, z) = K_GLASS
					For f = 0 To 5
						If IsOpen(x + faceX(f), y + faceY(f), z + faceZ(f)) Then AddFace(glass, x, y, z, f, 255, 255, 255)
					Next
				EndIf
			Next
		Next
	Next
	EntityTexture glassMesh, texGlass
	EntityAlpha glassMesh, 0.45
	EntityFX glassMesh, BB_FX_VERTEX_COLORS

	gooMesh = CreateMesh()
	Local sheet = CreateSurface(gooMesh), v0, v1, v2, v3, h#
	For x = 0 To sizeX - 1
		For y = 0 To sizeY - 1
			For z = 0 To sizeZ - 1
				If goo(x, y, z)
					h = y * CELL + 0.5
					v0 = AddVertex(sheet, x * CELL, h, z * CELL, 0, 0)
					v1 = AddVertex(sheet, x * CELL, h, (z + 1) * CELL, 0, 1)
					v2 = AddVertex(sheet, (x + 1) * CELL, h, (z + 1) * CELL, 1, 1)
					v3 = AddVertex(sheet, (x + 1) * CELL, h, z * CELL, 1, 0)
					AddTriangle sheet, v0, v1, v2
					AddTriangle sheet, v0, v2, v3
				EndIf
			Next
		Next
	Next
	EntityTexture gooMesh, texGoo
	EntityFX gooMesh, BB_FX_FULLBRIGHT
End Function

; The way out: a column of soft green light in every exit cell.
Function MakeExits()
	Local x, y, z, beam
	For x = 0 To sizeX - 1
		For y = 0 To sizeY - 1
			For z = 0 To sizeZ - 1
				If exitCell(x, y, z) And exitCount <= 15
					beam = CreateCylinder(16, False)
					ScaleEntity beam, 0.7, CELL * 0.5, 0.7
					PositionEntity beam, (x + 0.5) * CELL, (y + 0.5) * CELL, (z + 0.5) * CELL
					EntityColor beam, 90, 255, 150
					EntityAlpha beam, 0.35
					EntityBlend beam, BB_BLEND_ADD
					EntityFX beam, BB_FX_FULLBRIGHT + BB_FX_TWO_SIDED
					exitEnt(exitCount) = beam
					exitCount = exitCount + 1
				EndIf
			Next
		Next
	Next
End Function

Function AddButton(x, y, z)
	Local bt.Button = New Button
	bt\cx = x : bt\cy = y : bt\cz = z
	bt\ent = CreateCylinder(20)
	ScaleEntity bt\ent, 0.8, 0.08, 0.8
	PositionEntity bt\ent, (x + 0.5) * CELL, y * CELL + 0.08, (z + 0.5) * CELL
	EntityColor bt\ent, 220, 60, 50
End Function

Function AddDoor(x, y, z)
	Local d.Door = New Door
	d\cx = x : d\cy = y : d\cz = z
End Function

; A door is a thick panel across its cell, between the two walls it sits in. It slides up into the ceiling.
Function MakeDoor(d.Door)
	d\alongX = Not (IsOpen(d\cx - 1, d\cy, d\cz) Or IsOpen(d\cx + 1, d\cy, d\cz))
	d\ent = CreateCube()
	EntityTexture d\ent, texDoor
	If d\alongX Then ScaleEntity d\ent, CELL * 0.5, CELL * 0.5, 0.15 Else ScaleEntity d\ent, 0.15, CELL * 0.5, CELL * 0.5
	PositionEntity d\ent, (d\cx + 0.5) * CELL, (d\cy + 0.5) * CELL, (d\cz + 0.5) * CELL
	d\open = 0
End Function

Function AddCube(x#, y#, z#)
	Local cb.Cube = New Cube
	cb\sx = x : cb\sy = y : cb\sz = z
	cb\x = x : cb\y = y : cb\z = z
	cb\ent = CreateCube()
	ScaleEntity cb\ent, CUBE_H, CUBE_H, CUBE_H
	EntityTexture cb\ent, texCube
	PositionEntity cb\ent, x, y, z
End Function

; The player as others would see them: a suit and a helmet with a glowing visor.
Function MakeBody()
	Local root = CreatePivot()
	Local torso = CreateCylinder(12, True, root)
	ScaleEntity torso, 0.3, 0.55, 0.22
	PositionEntity torso, 0, -0.15, 0
	EntityColor torso, 225, 225, 230
	Local head = CreateSphere(12, root)
	ScaleEntity head, 0.22, 0.24, 0.22
	PositionEntity head, 0, 0.58, 0
	EntityColor head, 235, 235, 240
	Local visor = CreateCube(head)
	ScaleEntity visor, 0.7, 0.3, 0.2
	PositionEntity visor, 0, 0.1, 0.85
	EntityColor visor, 60, 200, 255
	EntityFX visor, BB_FX_FULLBRIGHT
	Local pack = CreateCube(root)
	ScaleEntity pack, 0.22, 0.3, 0.1
	PositionEntity pack, 0, 0, -0.27
	EntityColor pack, 70, 70, 80
	Return root
End Function

; --- Gates -----------------------------------------------------------------------------------------------------------

; A gate's entities, hidden until it is shot on a wall. The disc is a flat circle that faces out of the wall; the rim is
; a glowing ring around it, and the glow a soft light in front of it.
Function MakeGate(i)
	gatePivot(i) = CreatePivot()
	gateBack(i) = CreatePivot(gatePivot(i))
	RotateEntity gateBack(i), 0, 180, 0
	gateProbe(i) = CreatePivot(gatePivot(i))

	gateDisc(i) = CreateMesh(gatePivot(i))
	Local s = CreateSurface(gateDisc(i)), k, a#, centre, v
	centre = AddVertex(s, 0, 0, 0, 0.5, 0.5)
	For k = 0 To 31
		a = k * 360.0 / 32
		v = AddVertex(s, Cos(a) * GATE_R, Sin(a) * GATE_R, 0, 0.5 + Cos(a) * 0.5, 0.5 - Sin(a) * 0.5)
	Next
	For k = 0 To 31
		AddTriangle s, centre, 1 + k, 1 + (k + 1) Mod 32
	Next
	UpdateNormals gateDisc(i)
	PositionEntity gateDisc(i), 0, 0, 0.015
	EntityTexture gateDisc(i), texGate(i)
	EntityFX gateDisc(i), BB_FX_FULLBRIGHT

	gateRim(i) = CreateMesh(gatePivot(i))
	s = CreateSurface(gateRim(i))
	Local inner#, outer#, v0, v1, v2, v3, a2#
	inner = GATE_R - 0.02 : outer = GATE_R + 0.1
	For k = 0 To 31
		a = k * 360.0 / 32 : a2 = (k + 1) * 360.0 / 32
		v0 = AddVertex(s, Cos(a) * inner, Sin(a) * inner, 0, 0, 0)
		v1 = AddVertex(s, Cos(a) * outer, Sin(a) * outer, 0, 1, 0)
		v2 = AddVertex(s, Cos(a2) * outer, Sin(a2) * outer, 0, 1, 1)
		v3 = AddVertex(s, Cos(a2) * inner, Sin(a2) * inner, 0, 0, 1)
		AddTriangle s, v0, v1, v2
		AddTriangle s, v0, v2, v3
	Next
	PositionEntity gateRim(i), 0, 0, 0.025
	EntityTexture gateRim(i), texRim
	EntityColor gateRim(i), Float(gateR(i)), Float(gateG(i)), Float(gateB(i))
	EntityFX gateRim(i), BB_FX_FULLBRIGHT

	gateGlow(i) = CreateSprite(gatePivot(i))
	EntityTexture gateGlow(i), texGlow
	ScaleSprite gateGlow(i), 1.6, 1.6
	PositionEntity gateGlow(i), 0, 0, 0.3
	EntityColor gateGlow(i), Float(gateR(i)), Float(gateG(i)), Float(gateB(i))
	EntityAlpha gateGlow(i), 0.35
	EntityBlend gateGlow(i), BB_BLEND_ADD
	EntityFX gateGlow(i), BB_FX_FULLBRIGHT

	HideEntity gatePivot(i)
	gateOn(i) = False
End Function

; Opens gate i on side f of cell x, y, z. ux, uy, uz is the way "up" the gate: straight up on a wall, and the way
; the player looked on a floor or a ceiling. The pivot is turned so that its z axis points out of the wall and its y
; axis up the gate; of the twelve turns in steps of 90 degrees, one fits.
Function OpenGate(i, x, y, z, f, ux, uy, uz)
	gateOn(i) = True
	gateCX(i) = x : gateCY(i) = y : gateCZ(i) = z : gateSide(i) = f
	ShowEntity gatePivot(i)
	PositionEntity gatePivot(i), (x + 0.5 + faceX(f) * 0.5) * CELL, (y + 0.5 + faceY(f) * 0.5) * CELL, (z + 0.5 + faceZ(f) * 0.5) * CELL
	Local p, w
	For p = -90 To 90 Step 90
		For w = 0 To 270 Step 90
			RotateEntity gatePivot(i), Float(p), Float(w), 0
			TFormVector 0, 0, 1, gatePivot(i), 0
			If Abs(TFormedX() - faceX(f)) < 0.01 And Abs(TFormedY() - faceY(f)) < 0.01 And Abs(TFormedZ() - faceZ(f)) < 0.01
				TFormVector 0, 1, 0, gatePivot(i), 0
				If Abs(TFormedX() - ux) < 0.01 And Abs(TFormedY() - uy) < 0.01 And Abs(TFormedZ() - uz) < 0.01 Then Return
			EndIf
		Next
	Next
End Function

Function CloseGates()
	Local i
	For i = 0 To 1
		gateOn(i) = False
		HideEntity gatePivot(i)
	Next
End Function

Function GatesLinked()
	Return gateOn(0) And gateOn(1)
End Function

; Shoots gate i along the view. The shot flies through the grid cell by cell and stops at the first solid one; if the
; side it hits can carry a gate, and the other gate is not already there, the gate opens there.
Function ShootGate(i)
	Local ex# = px, ey# = py + EYE, ez# = pz
	TFormVector 0, 0, 1, camera, 0
	Local dx# = TFormedX(), dy# = TFormedY(), dz# = TFormedZ()
	PlaySfx(sndShoot)
	gatesShot = gatesShot + 1

	; Walk the grid: the cell the eyes are in, then always across the nearest cell side.
	Local cx = Int(Floor(ex / CELL)), cy = Int(Floor(ey / CELL)), cz = Int(Floor(ez / CELL))
	Local sx = Int(Sgn(dx)), sy = Int(Sgn(dy)), sz = Int(Sgn(dz))
	Local tx# = 1000000, ty# = 1000000, tz# = 1000000, ddx# = 1000000, ddy# = 1000000, ddz# = 1000000
	If sx <> 0 Then ddx = CELL / Abs(dx) : tx = ((cx + (sx > 0)) * CELL - ex) / dx
	If sy <> 0 Then ddy = CELL / Abs(dy) : ty = ((cy + (sy > 0)) * CELL - ey) / dy
	If sz <> 0 Then ddz = CELL / Abs(dz) : tz = ((cz + (sz > 0)) * CELL - ez) / dz
	Local f = -1, t# = 0, k
	For k = 0 To 80
		If tx < ty And tx < tz
			cx = cx + sx : t = tx : tx = tx + ddx
			If sx > 0 Then f = 1 Else f = 0
		ElseIf ty < tz
			cy = cy + sy : t = ty : ty = ty + ddy
			If sy > 0 Then f = 3 Else f = 2
		Else
			cz = cz + sz : t = tz : tz = tz + ddz
			If sz > 0 Then f = 5 Else f = 4
		EndIf
		If cx < 0 Or cy < 0 Or cz < 0 Or cx >= sizeX Or cy >= sizeY Or cz >= sizeZ Then Exit
		If kind(cx, cy, cz) <> K_AIR Or DoorBlocks(cx, cy, cz) Then Exit
	Next
	Local hx# = ex + dx * t, hy# = ey + dy * t, hz# = ez + dz * t
	If cx < 0 Or cy < 0 Or cz < 0 Or cx >= sizeX Or cy >= sizeY Or cz >= sizeZ Or f < 0
		Return
	EndIf
	If kind(cx, cy, cz) <> K_PANEL Or (Not gateFace(cx, cy, cz, f))
		BurstSparks(hx, hy, hz, 160, 160, 170, 10, 0.06)
		PlaySfx(sndFizzle, 0.7)
		Return
	EndIf
	Local o = 1 - i
	If gateOn(o) And gateCX(o) = cx And gateCY(o) = cy And gateCZ(o) = cz And gateSide(o) = f
		BurstSparks(hx, hy, hz, 160, 160, 170, 10, 0.06)
		PlaySfx(sndFizzle, 0.7)
		Return
	EndIf

	; Up the gate: straight up on walls; on a floor or a ceiling, the way the player faces, turned to the nearest axis.
	; Floor and ceiling gates shot facing the same way then line up, so falling from one to the other keeps the way
	; the player faces.
	Local ux = 0, uy = 1, uz = 0
	If f = 2 Or f = 3
		uy = 0
		If Abs(dx) > Abs(dz) Then ux = Int(Sgn(dx)) Else uz = Int(Sgn(dz))
		If ux = 0 And uz = 0 Then uz = 1
	EndIf
	; A carried cube that the gate is shot through to stays where it is.
	OpenGate(i, cx, cy, cz, f, ux, uy, uz)
	BurstSparks(hx + faceX(f) * 0.1, hy + faceY(f) * 0.1, hz + faceZ(f) * 0.1, Float(gateR(i)), Float(gateG(i)), Float(gateB(i)), 16, 0.08)
	PlaySfx(sndOpen)
End Function

; --- Boxes in the grid -----------------------------------------------------------------------------------------------
; The player and the cubes are boxes. MoveBox moves the box in bx, by, bz by its speed, one axis at a time, and stops
; it at whatever is solid. A cell with a gate on it is not solid for a box that fits inside the gate, so that box can
; go in; once its middle is behind the gate (and the other gate is open), it comes out of the other gate.


Function MoveBox()
	bGround = False
	bPassed = -1
	MoveAxis(0, bvx)
	MoveAxis(1, bvy)
	MoveAxis(2, bvz)
	Local i
	For i = 0 To 1
		If bPassed < 0 And GatesLinked()
			If BoxInGate(i) And BehindGate(i) Then PassGate(i)
		EndIf
	Next
End Function

Function MoveAxis(axis, d#)
	If d = 0 Then Return
	Select axis
		Case 0 : bx = bx + d
		Case 1 : by = by + d
		Case 2 : bz = bz + d
	End Select
	Local x0 = Int(Floor((bx - bhw) / CELL)), x1 = Int(Floor((bx + bhw) / CELL))
	Local y0 = Int(Floor((by - bhh) / CELL)), y1 = Int(Floor((by + bhh) / CELL))
	Local z0 = Int(Floor((bz - bhw) / CELL)), z1 = Int(Floor((bz + bhw) / CELL))
	; The step itself may push the box a little out of a gate (into the floor under it, say) before it is stopped.
	bSlack = Abs(d) + 0.01
	Local x, y, z, hit = False, limit#
	If d > 0 Then limit = 1000000 Else limit = -1000000
	For x = x0 To x1
		For y = y0 To y1
			For z = z0 To z1
				If CellBlocks(x, y, z)
					hit = True
					Select axis
						Case 0
							If d > 0 Then limit = Min(limit, x * CELL - bhw - 0.001) Else limit = Max(limit, (x + 1) * CELL + bhw + 0.001)
						Case 1
							If d > 0 Then limit = Min(limit, y * CELL - bhh - 0.001) Else limit = Max(limit, (y + 1) * CELL + bhh + 0.001)
						Case 2
							If d > 0 Then limit = Min(limit, z * CELL - bhw - 0.001) Else limit = Max(limit, (z + 1) * CELL + bhw + 0.001)
					End Select
				EndIf
			Next
		Next
	Next
	; The cubes are solid too: the player can stand on them, and they stack.
	Local cb.Cube, h# = CUBE_H
	For cb = Each Cube
		If cb <> bSelf And cb <> carried
			If Abs(bx - cb\x) < bhw + h And Abs(by - cb\y) < bhh + h And Abs(bz - cb\z) < bhw + h
				hit = True
				Select axis
					Case 0
						If d > 0 Then limit = Min(limit, cb\x - h - bhw - 0.001) Else limit = Max(limit, cb\x + h + bhw + 0.001)
					Case 1
						If d > 0 Then limit = Min(limit, cb\y - h - bhh - 0.001) Else limit = Max(limit, cb\y + h + bhh + 0.001)
					Case 2
						If d > 0 Then limit = Min(limit, cb\z - h - bhw - 0.001) Else limit = Max(limit, cb\z + h + bhw + 0.001)
				End Select
			EndIf
		EndIf
	Next
	bSlack = 0.01
	If Not hit Then Return
	Select axis
		Case 0 : bx = limit : bvx = 0
		Case 1
			by = limit
			If d < 0 Then bGround = True
			bvy = 0
		Case 2 : bz = limit : bvz = 0
	End Select
End Function

; Whether a cell stops the box: walls, panels and glass do, and closed doors; outside the chamber is solid too. A
; cell with a gate does not, for a box that fits inside that gate.
Function CellBlocks(x, y, z)
	If x < 0 Or y < 0 Or z < 0 Or x >= sizeX Or y >= sizeY Or z >= sizeZ Then Return True
	If kind(x, y, z) = K_AIR Then Return DoorBlocks(x, y, z)
	; A carried cube never goes through a gate on its own; it comes along when the player does.
	If GatesLinked() And (bSelf = Null Or bSelf <> carried)
		Local i
		For i = 0 To 1
			If gateCX(i) = x And gateCY(i) = y And gateCZ(i) = z
				If BoxInGate(i) Then Return False
			EndIf
		Next
	EndIf
	Return True
End Function

Function DoorBlocks(x, y, z)
	Local d.Door
	For d = Each Door
		If d\cx = x And d\cy = y And d\cz = z Then Return d\open < 0.95
	Next
	Return False
End Function

; Whether the box fits inside gate i, across the two directions that run along its wall (give or take bSlack).
Function BoxInGate(i)
	Local f = gateSide(i), x = gateCX(i), y = gateCY(i), z = gateCZ(i)
	If faceX(f) = 0
		If bx - bhw < x * CELL - bSlack Or bx + bhw > (x + 1) * CELL + bSlack Then Return False
	EndIf
	If faceY(f) = 0
		If by - bhh < y * CELL - bSlack Or by + bhh > (y + 1) * CELL + bSlack Then Return False
	EndIf
	If faceZ(f) = 0
		If bz - bhw < z * CELL - bSlack Or bz + bhw > (z + 1) * CELL + bSlack Then Return False
	EndIf
	Return True
End Function

; Whether the middle of the box has gone through the wall of gate i.
Function BehindGate(i)
	Local f = gateSide(i)
	Local d# = (bx - EntityX(gatePivot(i))) * faceX(f) + (by - EntityY(gatePivot(i))) * faceY(f) + (bz - EntityZ(gatePivot(i))) * faceZ(f)
	Return d < 0
End Function

; Moves the box from gate i to the other one: its place and its speed are turned around with the gates, and it is
; pushed out of the other wall far enough to be clear of it.
Function PassGate(i)
	Local o = 1 - i
	TFormPoint bx, by, bz, 0, gatePivot(i)
	TFormPoint TFormedX(), TFormedY(), TFormedZ(), gateBack(o), 0
	bx = TFormedX() : by = TFormedY() : bz = TFormedZ()
	TFormVector bvx, bvy, bvz, 0, gatePivot(i)
	TFormVector TFormedX(), TFormedY(), TFormedZ(), gateBack(o), 0
	bvx = TFormedX() : bvy = TFormedY() : bvz = TFormedZ()

	Local f = gateSide(o), half#
	If faceY(f) <> 0 Then half = bhh Else half = bhw
	Local out# = (bx - EntityX(gatePivot(o))) * faceX(f) + (by - EntityY(gatePivot(o))) * faceY(f) + (bz - EntityZ(gatePivot(o))) * faceZ(f)
	If out < half + 0.01
		bx = bx + faceX(f) * (half + 0.01 - out)
		by = by + faceY(f) * (half + 0.01 - out)
		bz = bz + faceZ(f) * (half + 0.01 - out)
	EndIf
	; Across the gate the box is kept inside the gate's square, so it never comes out partly inside a wall (a tall
	; player out of a floor gate into a wall gate would otherwise poke into the ceiling).
	If faceX(f) = 0 Then bx = Max(gateCX(o) * CELL + bhw + 0.01, Min((gateCX(o) + 1) * CELL - bhw - 0.01, bx))
	If faceY(f) = 0 Then by = Max(gateCY(o) * CELL + bhh + 0.01, Min((gateCY(o) + 1) * CELL - bhh - 0.01, by))
	If faceZ(f) = 0 Then bz = Max(gateCZ(o) * CELL + bhw + 0.01, Min((gateCZ(o) + 1) * CELL - bhw - 0.01, bz))
	bPassed = i
End Function

; --- The player ------------------------------------------------------------------------------------------------------

Function UpdatePlay()
	levelTicks = levelTicks + 1
	If hintTimer > 0 Then hintTimer = hintTimer - 1

	; Looking around.
	Local speed# = optSensitivity * 0.05
	Local mx# = Float(MouseXSpeed()), my# = Float(MouseYSpeed())
	MoveMouse SCREEN_W / 2, SCREEN_H / 2
	yaw = yaw - mx * speed
	If optInvert Then pitch = pitch - my * speed Else pitch = pitch + my * speed
	pitch = Max(-89, Min(89, pitch))

	; Walking: on the ground the speed follows the keys quickly, in the air only a little, so a throw out of a gate
	; keeps its speed.
	Local fx# = 0, fz# = 0
	If KeyDown(BB_KEY_W) Then fz = fz + 1
	If KeyDown(BB_KEY_S) Then fz = fz - 1
	If KeyDown(BB_KEY_A) Then fx = fx - 1
	If KeyDown(BB_KEY_D) Then fx = fx + 1
	Local wantX# = 0, wantZ# = 0, l# = Sqr(fx * fx + fz * fz)
	If l > 0
		fx = fx / l : fz = fz / l
		wantX = (fz * -Sin(yaw) + fx * Cos(yaw)) * WALK_SPEED
		wantZ = (fz * Cos(yaw) + fx * Sin(yaw)) * WALK_SPEED
	EndIf
	If onGround
		pvx = pvx + (wantX - pvx) * 0.3
		pvz = pvz + (wantZ - pvz) * 0.3
		If KeyHit(BB_KEY_SPACE) Then pvy = JUMP_SPEED : PlaySfx(sndJump)
	Else
		KeyHit(BB_KEY_SPACE)
		If l > 0
			; In the air the keys can only add speed up to walking speed in their direction, never take a throw away.
			Local along# = pvx * wantX / WALK_SPEED + pvz * wantZ / WALK_SPEED
			If along < WALK_SPEED
				pvx = pvx + wantX * 0.05
				pvz = pvz + wantZ * 0.05
			EndIf
		EndIf
	EndIf
	If (Not onGround) And l = 0 And pvy < 0 Then SteerToFloorGate()
	pvy = Max(pvy - GRAVITY, -MAX_FALL)
	lastFall = pvy

	bx = px : by = py : bz = pz : bvx = pvx : bvy = pvy : bvz = pvz
	bhw = PLAYER_HW : bhh = PLAYER_HH : bSelf = Null
	MoveBox()
	Local wasGround = onGround
	px = bx : py = by : pz = bz : pvx = bvx : pvy = bvy : pvz = bvz : onGround = bGround
	If bPassed >= 0 Then PlayerPassed(bPassed)
	If onGround And (Not wasGround) And lastFall < -0.25 Then PlaySfx(sndLand, Min(1, -lastFall * 2))

	; Gates and cubes.
	If MouseHit(BB_MOUSE_LEFT) Then ShootGate(0)
	If MouseHit(BB_MOUSE_RIGHT) Then ShootGate(1)
	If KeyHit(BB_KEY_E) Then PickOrDrop()

	; The camera first, so a carried cube follows the eyes to where they are now, even right after a gate.
	PlaceCamera()
	UpdateCubes()
	UpdateButtonsAndDoors()
	UpdateSparks()

	; Goo, the way out, and falling out of the world (which should never happen).
	Local cx = Int(Floor(px / CELL)), cy = Int(Floor((py - PLAYER_HH + 0.05) / CELL)), cz = Int(Floor(pz / CELL))
	If InGrid(cx, cy, cz)
		If goo(cx, cy, cz) And py - PLAYER_HH < cy * CELL + 0.45 Then PlayerDied() : Return
	EndIf
	cy = Int(Floor(py / CELL))
	If InGrid(cx, cy, cz)
		If exitCell(cx, cy, cz) Then LevelDone() : Return
	EndIf
	If py < -20 Then PlayerDied() : Return

	If KeyHit(BB_KEY_R) Then StartLevel(level) : Return
	If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_P) Then GoToPause()
End Function

Function InGrid(x, y, z)
	Return x >= 0 And y >= 0 And z >= 0 And x < sizeX And y < sizeY And z < sizeZ
End Function

; The player came out of the other gate: the view turns with the gates (any roll is left out), and a carried cube
; comes along.
; Falling towards a gate in the floor with no key held, a player who is already partly over it and barely moving
; sideways drifts a little to its middle, so a fall that starts at its edge still goes in. It only corrects small
; misses: anything thrown out of a gate is far too fast for it, and any key held takes the steering back.
Function SteerToFloorGate()
	If Not GatesLinked() Then Return
	If Abs(pvx) > WALK_SPEED Or Abs(pvz) > WALK_SPEED Then Return
	Local i, gx#, gz#, dx#, dz#, reach# = CELL * 0.5 + PLAYER_HW
	For i = 0 To 1
		If gateSide(i) = 2
			gx = EntityX(gatePivot(i)) : gz = EntityZ(gatePivot(i))
			dx = gx - px : dz = gz - pz
			If py - PLAYER_HH > EntityY(gatePivot(i)) And Abs(dx) < reach And Abs(dz) < reach
				pvx = pvx + (Max(-0.04, Min(0.04, dx * 0.05)) - pvx) * 0.1
				pvz = pvz + (Max(-0.04, Min(0.04, dz * 0.05)) - pvz) * 0.1
				Return
			EndIf
		EndIf
	Next
End Function

Function PlayerPassed(i)
	Local o = 1 - i
	TFormVector 0, 0, 1, camera, 0
	TFormVector TFormedX(), TFormedY(), TFormedZ(), 0, gatePivot(i)
	TFormVector TFormedX(), TFormedY(), TFormedZ(), gateBack(o), 0
	Local fx# = TFormedX(), fy# = TFormedY(), fz# = TFormedZ()
	; The top of the view goes through as well. Looking (nearly) straight up or down, the way the view faces has to
	; come from it, or the turn would be a guess.
	TFormVector 0, 1, 0, camera, 0
	TFormVector TFormedX(), TFormedY(), TFormedZ(), 0, gatePivot(i)
	TFormVector TFormedX(), TFormedY(), TFormedZ(), gateBack(o), 0
	Local ux# = TFormedX(), uz# = TFormedZ()
	If fx * fx + fz * fz > 0.25
		yaw = VectorYaw(fx, 0, fz)
	ElseIf fy < 0
		yaw = VectorYaw(ux, 0, uz)
	Else
		yaw = VectorYaw(-ux, 0, -uz)
	EndIf
	; Between two walls, or a floor and a ceiling, the view goes through exactly. Between a wall and a floor or
	; ceiling it turns by a quarter, so the eyes are brought halfway back to level, and nobody comes out staring at
	; a ceiling.
	pitch = Max(-89, Min(89, VectorPitch(fx, fy, fz)))
	If (faceY(gateSide(i)) <> 0) <> (faceY(gateSide(o)) <> 0) Then pitch = Max(-45, Min(45, pitch * 0.5))
	PlaySfx(sndPass)
	If carried <> Null
		; The cube is still on the far side; bring it to the player, it slides out to the hold point from there.
		Local f = gateSide(o)
		carried\x = px + faceX(f) * 0.1 : carried\y = py + 0.2 + faceY(f) * 0.1 : carried\z = pz + faceZ(f) * 0.1
		carried\vx = 0 : carried\vy = 0 : carried\vz = 0
	EndIf
End Function

Function PlaceCamera()
	Local bob# = 0
	If optBob And onGround
		Local moving# = Sqr(pvx * pvx + pvz * pvz)
		bobPhase = bobPhase + moving * 90
		bob = Sin(bobPhase) * moving * 0.4
	EndIf
	PositionEntity camera, px, py + EYE + bob, pz
	RotateEntity camera, pitch, yaw, 0
	PositionEntity body, px, py, pz
	RotateEntity body, 0, yaw, 0
End Function

Function PlayerDied()
	PlaySfx(sndGoo)
	state = STATE_DEAD
	deadTimer = 90
	If carried <> Null Then carried = Null
End Function

Function UpdateDead()
	deadTimer = deadTimer - 1
	TranslateEntity camera, 0, -0.01, 0
	UpdateSparks()
	If deadTimer <= 0 Then StartLevel(level)
End Function

; --- Cubes, buttons and doors ----------------------------------------------------------------------------------------

; E picks up the cube in front of the player, or puts the carried one down.
Function PickOrDrop()
	If carried <> Null
		carried\vx = pvx : carried\vy = 0 : carried\vz = pvz
		carried = Null
		PlaySfx(sndDrop)
		Return
	EndIf
	TFormVector 0, 0, 1, camera, 0
	Local dx# = TFormedX(), dy# = TFormedY(), dz# = TFormedZ()
	Local cb.Cube, best.Cube = Null, bestD# = 3.0, ox#, oy#, oz#, along#, side#
	For cb = Each Cube
		ox = cb\x - px : oy = cb\y - (py + EYE) : oz = cb\z - pz
		along = ox * dx + oy * dy + oz * dz
		If along > 0 And along < bestD
			side = Sqr(Max(0, ox * ox + oy * oy + oz * oz - along * along))
			If side < 0.8 Then best = cb : bestD = along
		EndIf
	Next
	If best <> Null
		carried = best
		PlaySfx(sndPick)
	EndIf
End Function

Function UpdateCubes()
	Local cb.Cube, tx#, ty#, tz#, cx, cy, cz
	For cb = Each Cube
		bx = cb\x : by = cb\y : bz = cb\z
		bhw = CUBE_H : bhh = CUBE_H : bSelf = cb
		If cb = carried
			; A carried cube floats towards a point in front of the eyes, but walls still stop it.
			TFormPoint 0, 0, HOLD_DIST, camera, 0
			tx = TFormedX() : ty = TFormedY() : tz = TFormedZ()
			bvx = (tx - cb\x) * 0.5 : bvy = (ty - cb\y) * 0.5 : bvz = (tz - cb\z) * 0.5
			bvx = Max(-0.6, Min(0.6, bvx)) : bvy = Max(-0.6, Min(0.6, bvy)) : bvz = Max(-0.6, Min(0.6, bvz))
			MoveBox()
			; A cube that stays stuck far behind for a while (on a corner, say) is dropped.
			If (bx - tx) * (bx - tx) + (by - ty) * (by - ty) + (bz - tz) * (bz - tz) > 6.0 Then cb\stuck = cb\stuck + 1 Else cb\stuck = 0
			If cb\stuck > 30 Then carried = Null : cb\stuck = 0
		Else
			bvx = cb\vx : bvy = Max(cb\vy - GRAVITY, -MAX_FALL) : bvz = cb\vz
			MoveBox()
			If bGround
				bvx = bvx * 0.7 : bvz = bvz * 0.7
			EndIf
			If bPassed >= 0 Then PlaySfx(sndPass, 0.5)
		EndIf
		cb\x = bx : cb\y = by : cb\z = bz : cb\vx = bvx : cb\vy = bvy : cb\vz = bvz : cb\onGround = bGround
		If cb = carried Then cb\vx = 0 : cb\vy = 0 : cb\vz = 0

		; Goo dissolves a cube; a new one appears where it first was.
		cx = Int(Floor(cb\x / CELL)) : cy = Int(Floor((cb\y - CUBE_H + 0.05) / CELL)) : cz = Int(Floor(cb\z / CELL))
		If InGrid(cx, cy, cz)
			If goo(cx, cy, cz) And cb\y - CUBE_H < cy * CELL + 0.45
				BurstSparks(cb\x, cb\y, cb\z, 90, 255, 90, 14, 0.06)
				If cb = carried Then carried = Null
				cb\x = cb\sx : cb\y = cb\sy : cb\z = cb\sz : cb\vx = 0 : cb\vy = 0 : cb\vz = 0
				PlaySfx(sndGoo, 0.5)
			EndIf
		EndIf
		If cb\y < -20
			cb\x = cb\sx : cb\y = cb\sy : cb\z = cb\sz : cb\vx = 0 : cb\vy = 0 : cb\vz = 0
		EndIf
		PositionEntity cb\ent, cb\x, cb\y, cb\z
	Next
End Function

; A button is pressed while the player or a cube stands on it. Doors open while every button is pressed.
Function UpdateButtonsAndDoors()
	Local bt.Button, cb.Cube, all = True, was, cx#, cz#, floorY#
	For bt = Each Button
		was = bt\pressed
		cx = (bt\cx + 0.5) * CELL : cz = (bt\cz + 0.5) * CELL : floorY = bt\cy * CELL
		bt\pressed = False
		If Abs(px - cx) < 0.9 And Abs(pz - cz) < 0.9 And py - PLAYER_HH < floorY + 0.4 And py - PLAYER_HH > floorY - 0.1 Then bt\pressed = True
		For cb = Each Cube
			If cb <> carried
				If Abs(cb\x - cx) < 0.9 And Abs(cb\z - cz) < 0.9 And cb\y - CUBE_H < floorY + 0.4 And cb\y - CUBE_H > floorY - 0.1 Then bt\pressed = True
			EndIf
		Next
		If bt\pressed
			EntityColor bt\ent, 70, 230, 90
			PositionEntity bt\ent, cx, floorY + 0.03, cz
			If Not was Then PlaySfx(sndPress)
		Else
			EntityColor bt\ent, 220, 60, 50
			PositionEntity bt\ent, cx, floorY + 0.08, cz
			If was Then PlaySfx(sndRelease)
		EndIf
		If Not bt\pressed Then all = False
	Next

	Local d.Door, target#, blocked
	For d = Each Door
		If all Then target = 1 Else target = 0
		; A door does not close on the player or on a cube.
		If target = 0 And d\open > 0
			bx = px : by = py : bz = pz : bhw = PLAYER_HW : bhh = PLAYER_HH
			If BoxTouchesCell(d\cx, d\cy, d\cz) Then target = d\open
			For cb = Each Cube
				bx = cb\x : by = cb\y : bz = cb\z : bhw = CUBE_H : bhh = CUBE_H
				If BoxTouchesCell(d\cx, d\cy, d\cz) Then target = d\open
			Next
		EndIf
		If d\open < target
			If d\open = 0 Then PlaySfx(sndDoor)
			d\open = Min(target, d\open + 0.04)
		ElseIf d\open > target
			If d\open = 1 Then PlaySfx(sndDoor)
			d\open = Max(target, d\open - 0.04)
		EndIf
		PositionEntity d\ent, (d\cx + 0.5) * CELL, (d\cy + 0.5 + d\open * 0.95) * CELL, (d\cz + 0.5) * CELL
	Next
End Function

Function BoxTouchesCell(x, y, z)
	If bx + bhw <= x * CELL Or bx - bhw >= (x + 1) * CELL Then Return False
	If by + bhh <= y * CELL Or by - bhh >= (y + 1) * CELL Then Return False
	If bz + bhw <= z * CELL Or bz - bhw >= (z + 1) * CELL Then Return False
	Return True
End Function

; --- Sparks ----------------------------------------------------------------------------------------------------------

Function BurstSparks(x#, y#, z#, r#, g#, b#, count, speed#)
	Local i, s.Spark
	For i = 1 To count
		s = New Spark
		s\ent = CreateSprite()
		EntityTexture s\ent, texGlow
		EntityBlend s\ent, BB_BLEND_ADD
		EntityFX s\ent, BB_FX_FULLBRIGHT
		EntityColor s\ent, r, g, b
		ScaleSprite s\ent, 0.15, 0.15
		PositionEntity s\ent, x, y, z
		s\vx = Rnd(-speed, speed) : s\vy = Rnd(-speed, speed) : s\vz = Rnd(-speed, speed)
		s\maxLife = Rand(20, 40)
		s\life = s\maxLife
	Next
End Function

Function UpdateSparks()
	Local s.Spark
	For s = Each Spark
		s\life = s\life - 1
		If s\life <= 0
			FreeEntity s\ent
			Delete s
		Else
			s\vy = s\vy - 0.002
			TranslateEntity s\ent, s\vx, s\vy, s\vz
			EntityAlpha s\ent, Float(s\life) / s\maxLife
		EndIf
	Next
End Function

Function Min#(a#, b#)
	If a < b Then Return a
	Return b
End Function

Function Max#(a#, b#)
	If a > b Then Return a
	Return b
End Function

; --- Starting and finishing ------------------------------------------------------------------------------------------

Function StartLevel(index)
	BuildLevel(index, False)
	state = STATE_PLAY
	HidePointer
	FlushKeys
	FlushMouse
	MoveMouse SCREEN_W / 2, SCREEN_H / 2
	MouseXSpeed()
	MouseYSpeed()
	PlaceCamera()
End Function

; Back to playing after the pause menu or the options.
Function CarryOn()
	state = STATE_PLAY
	HidePointer
	FlushKeys
	FlushMouse
	MoveMouse SCREEN_W / 2, SCREEN_H / 2
	MouseXSpeed()
	MouseYSpeed()
End Function

Function LevelDone()
	PlaySfx(sndDone)
	doneNewBest = (bestTime(level) = 0 Or levelTicks < bestTime(level))
	If doneNewBest Then bestTime(level) = levelTicks
	If level + 2 > levelsOpen Then levelsOpen = level + 2 : If levelsOpen > LEVELS Then levelsOpen = LEVELS
	SaveSettings()
	carried = Null
	OpenMenu(STATE_DONE, 3, 330)
	If level < LEVELS - 1 Then menuText(0) = "Next chamber" Else menuText(0) = "Back to the main menu"
	menuText(1) = "This chamber again"
	menuText(2) = "Choose a chamber"
End Function

Function UpdateDone()
	UpdateSparks()
	Local choice = MenuInput()
	If KeyHit(BB_KEY_ESCAPE) Then choice = 2
	Select choice
		Case 0
			If level < LEVELS - 1 Then StartLevel(level + 1) Else GoToMenu()
		Case 1 : StartLevel(level)
		Case 2 : GoToLevelMenu()
	End Select
End Function

; --- Menus -----------------------------------------------------------------------------------------------------------
; A menu is a list of lines and the number of the selected one. The keyboard moves the selection, the mouse selects
; the line it is over. MenuInput gives back the line chosen with Enter, Space or a click, or -1.

Function MenuInput()
	If KeyHit(BB_KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount : PlaySfx(sndClick)
	If KeyHit(BB_KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount : PlaySfx(sndClick)

	Local row = MenuLineAt(MouseX(), MouseY())
	If row >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = row

	If KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Then Return menuSelected
	If MouseHit(BB_MOUSE_LEFT) And row >= 0
		menuSelected = row
		Return row
	EndIf
	Return -1
End Function

; Which line is at a screen position, or -1. Lines are 32 pixels apart and 440 wide.
Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 220 Or x >= SCREEN_W / 2 + 220 Or y < menuTop Then Return -1
	Local row = (y - menuTop) / 32
	If row >= menuCount Then Return -1
	Return row
End Function

; Everything that opens a menu goes through here: show the mouse again and forget old keys and clicks.
Function OpenMenu(newState, count, top)
	state = newState
	menuCount = count
	menuTop = top
	menuSelected = 0
	ShowPointer
	FlushKeys
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

Function GoToMenu()
	optionsFromPause = False
	If state <> STATE_MENU And state <> STATE_OPTIONS And state <> STATE_HELP And state <> STATE_LEVELS Then BuildLevel(0, True)
	OpenMenu(STATE_MENU, 5, 280)
	If levelsOpen > 1 Then menuText(0) = "Carry on: chamber " + levelsOpen Else menuText(0) = "Play"
	If levelsOpen > LEVELS - 1 And bestTime(LEVELS - 1) > 0 Then menuText(0) = "Play again from the start"
	menuText(1) = "Choose a chamber"
	menuText(2) = "Options"
	menuText(3) = "How to play"
	menuText(4) = "Quit"
End Function

; Gives back True when the player chose Quit.
Function UpdateMenu()
	UpdateMenuScene()
	If KeyHit(BB_KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0
			If levelsOpen > LEVELS - 1 And bestTime(LEVELS - 1) > 0 Then StartLevel(0) Else StartLevel(levelsOpen - 1)
		Case 1 : GoToLevelMenu()
		Case 2 : GoToOptions()
		Case 3 : OpenMenu(STATE_HELP, 0, 0)
		Case 4 : Return True
	End Select
	Return False
End Function

; Behind the menus the camera stands in the first chamber and looks slowly around, with both gates open.
Function UpdateMenuScene()
	menuAngle = menuAngle + 0.12
	PositionEntity camera, 3.5 * CELL, 1.6 * CELL, 4.8 * CELL
	RotateEntity camera, 8 + Sin(menuAngle * 0.7) * 6, 140 + Sin(menuAngle) * 70, 0
	PositionEntity body, 0, -100, 0
	UpdateSparks()
End Function

; In the menus the first chamber shows its two gates: one in the side wall, one above the ledge.
Function PlaceMenuGates()
	OpenGate(0, 0, 1, 4, 0, 0, 1, 0)
	OpenGate(1, 3, 2, 0, 4, 0, 1, 0)
	; And someone stands in front of one of them.
	px = 1.5 * CELL : py = CELL + PLAYER_HH : pz = 4.5 * CELL
	PositionEntity body, px, py, pz
	RotateEntity body, 0, -60, 0
End Function

Function GoToLevelMenu()
	If state = STATE_PLAY Or state = STATE_PAUSED Or state = STATE_DONE Or state = STATE_DEAD Then BuildLevel(0, True)
	OpenMenu(STATE_LEVELS, LEVELS + 1, 200)
	Local i
	For i = 0 To LEVELS - 1
		If i < levelsOpen
			menuText(i) = (i + 1) + ". " + LevelTitle(i)
			If bestTime(i) > 0 Then menuText(i) = menuText(i) + "   (best " + TimeText(bestTime(i)) + ")"
		Else
			menuText(i) = (i + 1) + ". (finish chamber " + i + " first)"
		EndIf
	Next
	menuText(LEVELS) = "Back"
	menuSelected = levelsOpen - 1 : If menuSelected > LEVELS - 1 Then menuSelected = LEVELS - 1
End Function

Function UpdateLevelMenu()
	UpdateMenuScene()
	Local choice = MenuInput()
	If KeyHit(BB_KEY_ESCAPE) Then choice = LEVELS
	If choice = LEVELS
		GoToMenu()
		menuSelected = 1
	ElseIf choice >= 0
		If choice < levelsOpen Then StartLevel(choice) Else PlaySfx(sndFizzle, 0.5)
	EndIf
End Function

; The name of a chamber, read from its Data lines.
Function LevelTitle$(index)
	Select index
		Case 0 : Restore Level1
		Case 1 : Restore Level2
		Case 2 : Restore Level3
		Case 3 : Restore Level4
		Case 4 : Restore Level5
		Default : Restore Level6
	End Select
	Local title$
	Read title
	Return title
End Function

Function GoToPause()
	OpenMenu(STATE_PAUSED, 4, 260)
	menuText(0) = "Carry on"
	menuText(1) = "Start the chamber again"
	menuText(2) = "Options"
	menuText(3) = "Back to the main menu"
End Function

Function UpdatePause()
	UpdateSparks()
	Select MenuInput()
		Case 0 : CarryOn()
		Case 1 : StartLevel(level)
		Case 2 : GoToOptions()
		Case 3 : GoToMenu()
	End Select
	If (KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_P)) And state = STATE_PAUSED Then CarryOn()
End Function

Function GoToOptions()
	optionsFromPause = (state = STATE_PAUSED)
	OpenMenu(STATE_OPTIONS, 7, 220)
	RefreshOptionsText()
End Function

Function RefreshOptionsText()
	menuText(0) = "Mouse speed: " + optSensitivity
	If optInvert Then menuText(1) = "Mouse up looks: down" Else menuText(1) = "Mouse up looks: up"
	menuText(2) = "Field of view: " + fovName(optFov)
	menuText(3) = "Sound volume: " + (optVolume * 25) + "%"
	If optBob Then menuText(4) = "View bobs when walking: yes" Else menuText(4) = "View bobs when walking: no"
	If optionsFromPause
		menuText(5) = "Display: change it in the main menu"
	ElseIf optFullscreen
		menuText(5) = "Display: full screen"
	Else
		menuText(5) = "Display: window"
	EndIf
	menuText(6) = "Back"
End Function

Function UpdateOptions()
	If Not optionsFromPause Then UpdateMenuScene()
	Local change = 0
	If KeyHit(BB_KEY_LEFT) Then change = -1
	If KeyHit(BB_KEY_RIGHT) Then change = 1
	Local picked = MenuInput()
	If picked >= 0 Then change = 1 ; Enter or a click steps to the next value.

	If KeyHit(BB_KEY_ESCAPE) Or picked = 6
		SaveSettings()
		If optionsFromPause
			GoToPause()
			menuSelected = 2
		Else
			GoToMenu()
			menuSelected = 2
		EndIf
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optSensitivity = (optSensitivity - 1 + change + 10) Mod 10 + 1
		Case 1 : optInvert = Not optInvert
		Case 2 : optFov = (optFov + change + 3) Mod 3
		Case 3 : optVolume = (optVolume + change + 5) Mod 5
		Case 4 : optBob = Not optBob
		Case 5
			; Opening the screen again frees the whole chamber, so this can only be done from the main menu.
			If Not optionsFromPause
				optFullscreen = Not optFullscreen
				OpenScreen()
			EndIf
	End Select
	ApplyCameraOptions()
	PlaySfx(sndClick)
	RefreshOptionsText()
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	ClsColor BG_R, BG_G, BG_B
	Cls
	DrawWatermark(BG_R, BG_G, BG_B)
	If chamber <> 0 Then RenderChamber()

	Select state
		Case STATE_MENU
			DrawTitle("FOLDGATE", 160)
			SmallText(SCREEN_W / 2, 220, "Two gates, one way through", True)
			DrawMenu()
		Case STATE_LEVELS
			ShadeScreen()
			DrawTitle("Chambers", 130)
			DrawMenu()
		Case STATE_OPTIONS
			ShadeScreen()
			DrawTitle("Options", 150)
			DrawMenu()
			SmallText(SCREEN_W / 2, 470, "Left/Right or a click change the selected option.", True)
		Case STATE_HELP
			ShadeScreen()
			DrawHelp()
		Case STATE_PLAY
			DrawHud()
		Case STATE_DEAD
			DrawHud()
			Color 60, 255, 90
			SetFont bigFont
			Text SCREEN_W / 2, SCREEN_H / 2 - 60, "Dissolved", True, True
			SetFont 0
		Case STATE_PAUSED
			DrawHud()
			ShadeScreen()
			DrawTitle("Paused", 190)
			DrawMenu()
		Case STATE_DONE
			ShadeScreen()
			DrawTitle("Chamber " + (level + 1) + " solved", 170)
			SmallText(SCREEN_W / 2, 235, levelName, True)
			SmallText(SCREEN_W / 2, 265, "Time: " + TimeText(levelTicks) + "     Shots: " + gatesShot, True)
			If doneNewBest
				SmallText(SCREEN_W / 2, 290, "A new best time!", True)
			Else
				SmallText(SCREEN_W / 2, 290, "Best time: " + TimeText(bestTime(level)), True)
			EndIf
			If level = LEVELS - 1 Then SmallText(SCREEN_W / 2, 450, "That was the last chamber. Well folded!", True)
			DrawMenu()
	End Select

	If state = STATE_MENU Or state = STATE_OPTIONS Or state = STATE_HELP Or state = STATE_LEVELS
		Color 130, 140, 160
		Text SCREEN_W / 2, SCREEN_H - 24, "A BlitzLLVM sample game", True, True
	EndIf
End Function

; The chamber is drawn in up to three passes. The first one is the view from the player's eyes; there each open gate
; writes its number (1 or 2) into the stencil where it can be seen. With both gates open, each gate then gets a pass
; from the camera behind the other gate, which only draws where the stencil holds this gate's number. The player's
; own body only shows in those passes, through a gate.
Function RenderChamber()
	Local linked = GatesLinked(), i
	CameraProjMode camera, BB_PROJ_PERSPECTIVE
	CameraProjMode gateCam(0), BB_PROJ_NONE
	CameraProjMode gateCam(1), BB_PROJ_NONE
	SetChamberStencil(7, 0)
	For i = 0 To 1
		If linked Then SetEntityStencil gateDisc(i), 7, i + 1, 255, 255, 0, 0, 2 Else SetEntityStencil gateDisc(i), 7
	Next
	; The player's own body is only seen through a gate, never from the eyes inside it.
	HideEntity body
	RenderWorld
	If Not linked Then Return

	ShowEntity body
	CameraProjMode camera, BB_PROJ_NONE
	For i = 0 To 1
		PlaceGateCamera(i)
		CameraProjMode gateCam(i), BB_PROJ_PERSPECTIVE
		CameraProjMode gateCam(1 - i), BB_PROJ_NONE
		SetChamberStencil(2, i + 1)
		SetEntityStencil gateDisc(0), 2, i + 1
		SetEntityStencil gateDisc(1), 2, i + 1
		; The camera stands behind the other gate's disc and glow, which would cover the whole view.
		HideEntity gateDisc(1 - i)
		HideEntity gateGlow(1 - i)
		RenderWorld
		ShowEntity gateDisc(1 - i)
		ShowEntity gateGlow(1 - i)
	Next
	CameraProjMode gateCam(0), BB_PROJ_NONE
	CameraProjMode gateCam(1), BB_PROJ_NONE
	CameraProjMode camera, BB_PROJ_PERSPECTIVE
	HideEntity body
End Function

; The camera behind gate i's partner stands where the player's eyes are, seen from gate i.
Function PlaceGateCamera(i)
	PositionEntity gateProbe(i), EntityX(camera, True), EntityY(camera, True), EntityZ(camera, True), True
	RotateEntity gateProbe(i), EntityPitch(camera, True), EntityYaw(camera, True), EntityRoll(camera, True), True
	PositionEntity gateCam(i), EntityX(gateProbe(i)), EntityY(gateProbe(i)), EntityZ(gateProbe(i))
	RotateEntity gateCam(i), EntityPitch(gateProbe(i)), EntityYaw(gateProbe(i)), EntityRoll(gateProbe(i))
End Function

; Gives everything in the chamber, except the gate discs, the same stencil test.
Function SetChamberStencil(compare, reference)
	SetTreeStencil(chamber, compare, reference)
	SetTreeStencil(glassMesh, compare, reference)
	SetTreeStencil(gooMesh, compare, reference)
	SetTreeStencil(body, compare, reference)
	Local i
	For i = 0 To exitCount - 1
		SetEntityStencil exitEnt(i), compare, reference
	Next
	For i = 0 To 1
		SetEntityStencil gateRim(i), compare, reference
		SetEntityStencil gateGlow(i), compare, reference
	Next
	Local cb.Cube, bt.Button, d.Door, s.Spark
	For cb = Each Cube
		SetEntityStencil cb\ent, compare, reference
	Next
	For bt = Each Button
		SetEntityStencil bt\ent, compare, reference
	Next
	For d = Each Door
		SetEntityStencil d\ent, compare, reference
	Next
	For s = Each Spark
		SetEntityStencil s\ent, compare, reference
	Next
End Function

; An entity and all its children; pivots draw nothing and are left alone.
Function SetTreeStencil(ent, compare, reference)
	If EntityClass(ent) <> "Pivot" Then SetEntityStencil ent, compare, reference
	Local i
	For i = 1 To CountChildren(ent)
		SetTreeStencil(GetChild(ent, i), compare, reference)
	Next
End Function

Function DrawHud()
	; The aim: a dot, with the left half of a ring in amber once that gate is open, and the right half in violet.
	Local cx = SCREEN_W / 2, cy = SCREEN_H / 2, a, i
	Color 255, 255, 255
	Rect cx - 1, cy - 1, 3, 3, 1
	For i = 0 To 1
		If gateOn(i) Then Color gateR(i), gateG(i), gateB(i) Else Color 90, 90, 100
		For a = 100 To 260 Step 8
			If i = 0 Then Rect Int(Float(cx) + Cos(Float(a)) * 12), Int(Float(cy) + Sin(Float(a)) * 12), 2, 2, 1 Else Rect Int(Float(cx) - Cos(Float(a)) * 12), Int(Float(cy) + Sin(Float(a)) * 12), 2, 2, 1
		Next
	Next

	SetFont hudFont
	Color 0, 0, 0
	Text 21, 21, "Chamber " + (level + 1) + ": " + levelName
	Text SCREEN_W - 19, 21, TimeText(levelTicks), True
	Color 230, 235, 245
	Text 20, 20, "Chamber " + (level + 1) + ": " + levelName
	Text SCREEN_W - 20, 20, TimeText(levelTicks), True
	SetFont 0
	If carried <> Null Then SmallText(SCREEN_W / 2, SCREEN_H - 60, "E puts the cube down", True)
	If hintTimer > 0 And state = STATE_PLAY Then SmallText(SCREEN_W / 2, SCREEN_H - 36, levelHint, True)
End Function

Function TimeText$(updates)
	Local tenths = updates / 6
	Local seconds = tenths / 10
	Return (seconds / 60) + ":" + Right("0" + (seconds Mod 60), 2) + "." + (tenths Mod 10)
End Function

Function SmallText(x, y, text$, centred)
	SetFont helpFont
	Color 0, 0, 0
	Text x + 1, y + 1, text, centred, True
	Color 230, 235, 245
	Text x, y, text, centred, True
	SetFont 0
End Function

; Darkens the picture behind a menu, so the text is easy to read: a black rectangle drawn with every other pixel.
Function ShadeScreen()
	If shadeImage = 0
		shadeImage = CreateImage(SCREEN_W, SCREEN_H)
		Local buffer = ImageBuffer(shadeImage), x, y
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				If (x + y) Mod 2 = 0 Then WritePixelFast x, y, $0A0C14, buffer Else WritePixelFast x, y, 0, buffer
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage shadeImage, 0, 0
End Function

; The title in amber, with a violet shadow on one side: the two gates.
Function DrawTitle(text$, y)
	SetFont titleFont
	Color 30, 20, 50
	Text SCREEN_W / 2 + 4, y + 4, text, True, True
	Color gateR(1), gateG(1), gateB(1)
	Text SCREEN_W / 2 + 2, y + 2, text, True, True
	Color gateR(0), gateG(0), gateB(0)
	Text SCREEN_W / 2, y, text, True, True
	SetFont 0
End Function

Function DrawMenu()
	Local i, y
	For i = 0 To menuCount - 1
		y = menuTop + i * 32
		If i = menuSelected
			Color 90, 55, 20
			Rect SCREEN_W / 2 - 220, y, 440, 28, 1
			Color gateR(0), gateG(0), gateB(0)
			Rect SCREEN_W / 2 - 220, y, 440, 28, 0
			Color 255, 245, 225
		Else
			Color 20, 22, 34
			Rect SCREEN_W / 2 - 220, y, 440, 28, 1
			Color 205, 212, 235
		EndIf
		SetFont menuFont
		Text SCREEN_W / 2, y + 14, menuText(i), True, True
		SetFont 0
	Next
End Function

Function DrawHelp()
	DrawTitle("How to play", 90)
	Local y = 145, i, helpLine$
	Restore HelpText
	SetFont helpFont
	For i = 1 To 16
		Read helpLine
		Color 230, 235, 245
		Text 100, y, helpLine
		y = y + 20
	Next
	SetFont 0
	SmallText(SCREEN_W / 2, 500, "Press Enter or click to go back.", True)
End Function

; --- Watermark -------------------------------------------------------------------------------------------------------
; Every frame carries a faint pattern that nobody can see: some pixels of the background are one step bluer than the
; rest. A program can find the pattern again in a screenshot, which shows that the picture came from this sample game.
; The pattern is drawn as a masked image just after Cls, so the chamber is drawn over it.


Function DrawWatermark(r, g, b)
	Local rgb = (r Shl 16) Or (g Shl 8) Or b
	If watermark = 0 Or rgb <> watermarkColor
		If watermark <> 0 Then FreeImage watermark
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		watermarkColor = rgb
		Local marked = b + 1
		If b = 255 Then marked = 254
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				; Black is the mask colour, so only the marked pixels are drawn.
				If (x * 7 + y * 13) Mod 29 < 3
					WritePixelFast x, y, (r Shl 16) Or (g Shl 8) Or marked, buffer
				Else
					WritePixelFast x, y, 0, buffer
				EndIf
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function

; --- Pictures --------------------------------------------------------------------------------------------------------
; All textures are drawn pixel by pixel when the screen opens.

Function MakeTextures()
	Local size = 128, x, y, v#, r, g, b, buffer, d#, a#, edge

	; Dark walls: big rough tiles with dark seams.
	texWall = CreateTexture(size, size, BB_TEXTURE_COLOR + BB_TEXTURE_MIPMAPPED)
	buffer = TextureBuffer(texWall)
	LockBuffer buffer
	For y = 0 To size - 1
		For x = 0 To size - 1
			v = 58 + Rnd(-7, 7) + 6.0 * Sin(Float(x * 9 + y * 4))
			If x Mod 64 < 2 Or y Mod 64 < 2 Then v = 30
			WritePixelFast x, y, ColorValue(v * 0.9, v * 0.95, v * 1.1), buffer
		Next
	Next
	UnlockBuffer buffer

	; White panels: four smooth plates with thin grey seams and a darker border.
	texPanel = CreateTexture(size, size, BB_TEXTURE_COLOR + BB_TEXTURE_MIPMAPPED)
	buffer = TextureBuffer(texPanel)
	LockBuffer buffer
	For y = 0 To size - 1
		For x = 0 To size - 1
			v = 222 + Rnd(-3, 3)
			If x Mod 64 < 2 Or y Mod 64 < 2 Then v = 160
			If x < 3 Or y < 3 Or x > size - 4 Or y > size - 4 Then v = 140
			WritePixelFast x, y, ColorValue(v, v, v * 1.03), buffer
		Next
	Next
	UnlockBuffer buffer

	; Glass: pale blue with a bright frame.
	texGlass = CreateTexture(size, size, BB_TEXTURE_COLOR + BB_TEXTURE_MIPMAPPED)
	buffer = TextureBuffer(texGlass)
	LockBuffer buffer
	For y = 0 To size - 1
		For x = 0 To size - 1
			edge = (x < 5 Or y < 5 Or x > size - 6 Or y > size - 6)
			If edge Then WritePixelFast x, y, ColorValue(200, 230, 255), buffer Else WritePixelFast x, y, ColorValue(90, 150, 200.0 + 30.0 * Sin(Float(x * 3 + y * 3))), buffer
		Next
	Next
	UnlockBuffer buffer

	; Goo: green with lighter bubbles.
	texGoo = CreateTexture(size, size, BB_TEXTURE_COLOR + BB_TEXTURE_MIPMAPPED)
	buffer = TextureBuffer(texGoo)
	LockBuffer buffer
	For y = 0 To size - 1
		For x = 0 To size - 1
			v = Sin(x * 8.4) * Cos(y * 5.6) + Sin((x + y) * 11.2) * 0.5
			WritePixelFast x, y, ColorValue(40 + v * 20, 170 + v * 50, 50 + v * 20), buffer
		Next
	Next
	UnlockBuffer buffer

	; The cube: light grey sides, an amber frame and a ring in the middle.
	texCube = CreateTexture(64, 64, BB_TEXTURE_COLOR + BB_TEXTURE_MIPMAPPED)
	buffer = TextureBuffer(texCube)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			d = Sqr((x - 31.5) * (x - 31.5) + (y - 31.5) * (y - 31.5))
			If x < 8 Or y < 8 Or x > 55 Or y > 55
				WritePixelFast x, y, ColorValue(110, 110, 120), buffer
			ElseIf x < 10 Or y < 10 Or x > 53 Or y > 53 Or (d > 12 And d < 16)
				WritePixelFast x, y, ColorValue(255, 160, 50), buffer
			Else
				WritePixelFast x, y, ColorValue(200, 202, 208), buffer
			EndIf
		Next
	Next
	UnlockBuffer buffer

	; Doors: yellow and black stripes.
	texDoor = CreateTexture(64, 64, BB_TEXTURE_COLOR + BB_TEXTURE_MIPMAPPED)
	buffer = TextureBuffer(texDoor)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			If ((x + y) / 8) Mod 2 = 0 Then WritePixelFast x, y, ColorValue(230, 190, 40), buffer Else WritePixelFast x, y, ColorValue(35, 35, 40), buffer
		Next
	Next
	UnlockBuffer buffer

	; A soft round glow for sparks and the light in front of the gates.
	texGlow = CreateTexture(64, 64, BB_TEXTURE_COLOR + BB_TEXTURE_ALPHA)
	buffer = TextureBuffer(texGlow)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			d = Sqr((x - 31.5) * (x - 31.5) + (y - 31.5) * (y - 31.5)) / 32.0
			a = Max(0, 1 - d)
			a = a * a
			WritePixelFast x, y, (Int(a * 255) Shl 24) Or $FFFFFF, buffer
		Next
	Next
	UnlockBuffer buffer

	; The rim: bright at the edge of the hole, fading outwards (across u).
	texRim = CreateTexture(32, 4, BB_TEXTURE_COLOR)
	buffer = TextureBuffer(texRim)
	LockBuffer buffer
	For x = 0 To 31
		v = Float(255 - x * 5)
		For y = 0 To 3
			WritePixelFast x, y, ColorValue(v, v, v), buffer
		Next
	Next
	UnlockBuffer buffer

	; A gate that has no partner yet: a swirl in its colour.
	Local i
	For i = 0 To 1
		texGate(i) = CreateTexture(size, size, BB_TEXTURE_COLOR)
		buffer = TextureBuffer(texGate(i))
		LockBuffer buffer
		For y = 0 To size - 1
			For x = 0 To size - 1
				d = Sqr((x - 63.5) * (x - 63.5) + (y - 63.5) * (y - 63.5)) / 64.0
				a = ATan2(y - 63.5, x - 63.5)
				v = 0.55 + 0.45 * Sin(a * 3 + d * 720)
				v = v * (0.4 + 0.6 * d)
				WritePixelFast x, y, ColorValue(gateR(i) * v, gateG(i) * v, gateB(i) * v), buffer
			Next
		Next
		UnlockBuffer buffer
	Next
End Function

Function ColorValue(r#, g#, b#)
	Local ri = Int(Max(0, Min(255, r))), gi = Int(Max(0, Min(255, g))), bi = Int(Max(0, Min(255, b)))
	Return $FF000000 Or (ri Shl 16) Or (gi Shl 8) Or bi
End Function

; --- Sounds ----------------------------------------------------------------------------------------------------------
; A short sound made sample by sample into a WAV file in a bank, written to a temporary file and loaded from there.

Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0, i, t#, hz#, v#, envelope#, held# = 0
	For i = 0 To samples - 1
		t = Float(i) / samples
		hz = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1
			Case WAVE_SINE
				v = Sin(phase)
			Default
				; Noise that changes at the given pitch: low pitches rumble, high ones hiss.
				If phase < 360.0 * hz / rate Then held = Rnd(-1, 1)
				v = held
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		envelope = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.3 Then envelope = envelope * (1.0 - t) / 0.7
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "foldgate-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

