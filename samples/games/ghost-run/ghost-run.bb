; A timer keeps the game at 60 updates per second on every computer.
Global timer = CreateTimer(60)

GoToMenu()
Local quit = False
While Not quit
	WaitTimer timer
	frame = frame + 1
	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_TRACKS
			UpdateTracks()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_HELP
			UpdateDemo()
			If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Or MouseHit(1) Then GoToMenu() : menuSelected = 2
		Case STATE_COUNTDOWN
			UpdateCountdown()
		Case STATE_RACE
			UpdateRace()
		Case STATE_PAUSED
			UpdatePause()
		Case STATE_FINISHED
			UpdateFinished()
		Case STATE_RESULTS
			UpdateResults()
	End Select

	If messageTimer > 0 Then messageTimer = messageTimer - 1
	If splitTimer > 0 Then splitTimer = splitTimer - 1
	PositionTexture padTex, 0, -frame * 0.05
