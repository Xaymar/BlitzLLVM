Const BARRIER# = 1.2        ; How high the barriers are.
Const SLAB# = 0.8           ; How thick the road is.

; The car. Units are metres and seconds; there are 60 updates every second.
Const RIDE# = 0.9           ; How high the middle of the car rides over the road.
Const RADIUS# = 0.7         ; The sphere that bumps into things.
Const GRAVITY# = 26.0
Const SPRING# = 260.0, DAMPING# = 22.0
Const TOP_SPEED# = 58.0, ACCELERATION# = 24.0, BRAKING# = 42.0, REVERSE_SPEED# = 12.0
