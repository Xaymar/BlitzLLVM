; --- Screen and settings ---------------------------------------------------------------------------------------------

; Opens the window or full screen, as the option says, and makes every entity, texture and picture of the game. When
; the screen is opened again, everything of the old one is freed first; Graphics3D should do that too, but freeing it
; here makes sure nothing of the old screen stays behind.
Global screenOpen
Function OpenScreen()
	If screenOpen
		ClearWorld        ; All entities (with the physics bodies, which are entities too), brushes and textures.
		FreeFont titleFont : FreeFont menuFont : FreeFont hudFont : FreeFont bigFont : FreeFont smallFont
		If minimapImage <> 0 Then FreeImage minimapImage
		If shadeImage <> 0 Then FreeImage shadeImage
		If watermark <> 0 Then FreeImage watermark
	EndIf
	screenOpen = True
	If optFullscreen Then Graphics3D SCREEN_W, SCREEN_H, 0, 1 Else Graphics3D SCREEN_W, SCREEN_H, 0, 2
	AppTitle "Ghost Run"
	SetBuffer BackBuffer()
	SeedRnd MilliSecs()

	camera = CreateCamera()
	CameraRange camera, 0.3, 900
	CameraFogMode camera, 1
	CameraFogColor camera, SKY_R, SKY_G, SKY_B
	CameraFogRange camera, 220, 800
	; The sky is drawn by Cls before RenderWorld (with the watermark in it), so the camera only clears depth.
	CameraClsMode camera, False, True
	camTarget = CreatePivot()

	sun = CreateLight()
	RotateEntity sun, 50, -30, 0
	LightColor sun, 255, 245, 225
	AmbientLight 120, 125, 140

	titleFont = LoadFont("Arial", 64, True, True)
	menuFont = LoadFont("Arial", 18, True)
	hudFont = LoadFont("Arial", 26, True)
	bigFont = LoadFont("Arial", 96, True)
	smallFont = LoadFont("Arial", 16)

	MakeTextures()
	Local ground = CreatePlane()
	EntityTexture ground, grassTex
	EntityColor ground, 200, 220, 180

	trackMesh = 0
	trackBody = 0
	scenery = 0
	minimapImage = 0
	shadeImage = 0
	watermark = 0
	BuildTrack(setupTrack)

	; The cars get new models. The ghost is made by MakeGhost when a run starts.
	If player <> Null
		Delete player
		player = Null
	EndIf
	ghost = 0
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	Local t
	If ReadInt(file) = 1 ; A version number, so a changed file format can be recognised later.
		optCamera = ReadInt(file)
		optColour = ReadInt(file)
		optGhost = ReadInt(file)
		optVolume = ReadInt(file)
		optEngine = ReadInt(file)
		optFullscreen = ReadInt(file)
		setupTrack = ReadInt(file)
		For t = 0 To TRACKS - 1
			bestTime(t) = ReadInt(file)
		Next
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optCamera < 0 Or optCamera > 1 Then optCamera = 0
	If optColour < 0 Or optColour >= CAR_COLOURS Then optColour = 0
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
	If setupTrack < 0 Or setupTrack >= TRACKS Then setupTrack = 0
	For t = 0 To TRACKS - 1
		If bestTime(t) < 0 Or bestTime(t) > MAX_FRAMES Then bestTime(t) = 0
	Next
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets the options.
	WriteInt file, 1
	WriteInt file, optCamera
	WriteInt file, optColour
	WriteInt file, optGhost
	WriteInt file, optVolume
	WriteInt file, optEngine
	WriteInt file, optFullscreen
	WriteInt file, setupTrack
	Local t
	For t = 0 To TRACKS - 1
		WriteInt file, bestTime(t)
	Next
	CloseFile file
End Function

; Every sound goes through here, so the volume option works everywhere.
Function PlaySfx(sound)
	If sound = 0 Or optVolume = 0 Then Return
	Local channel = PlaySound(sound)
	ChannelVolume channel, optVolume / 4.0
End Function

Function ShowMessage(text$)
	messageText = text
	messageTimer = 120
End Function

; --- Ghost files -----------------------------------------------------------------------------------------------------
; A ghost file: "GRGH", a version, a number that changes when the track changes, the frames, the gates and the update
; each gate was passed, then six numbers for every update: where the car was and how it was turned.

Const GHOST_MAGIC = $48475247

Function GhostPath$(t)
	Return folder + "ghost-run-" + (t + 1) + ".ghost"
End Function

Function TrackSignature()
	Return slices * 100 + gates
End Function

Function LoadGhost(t)
	ghostFrames = 0
	If FileType(GhostPath(t)) <> 1 Then Return
	Local file = ReadFile(GhostPath(t))
	If Not file Then Return
	Local frames, count, i
	If ReadInt(file) = GHOST_MAGIC And ReadInt(file) = 1 And ReadInt(file) = TrackSignature()
		frames = ReadInt(file)
		count = ReadInt(file)
		; Only a file of exactly the right size is used, so a broken ghost is never shown.
		If frames > 0 And frames <= MAX_FRAMES And count = gates And FileSize(GhostPath(t)) = 20 + count * 4 + frames * 24
			For i = 0 To count - 1
				ghostGate(i) = ReadInt(file)
			Next
			For i = 0 To frames - 1
				ghostX(i) = ReadFloat(file) : ghostY(i) = ReadFloat(file) : ghostZ(i) = ReadFloat(file)
				ghostPitch(i) = ReadFloat(file) : ghostYaw(i) = ReadFloat(file) : ghostRoll(i) = ReadFloat(file)
			Next
			ghostFrames = frames
		EndIf
	EndIf
	CloseFile file
End Function

; The run just driven becomes the ghost, in memory and in the file.
Function KeepGhost(t, frames)
	Local i
	For i = 0 To frames - 1
		ghostX(i) = recX(i) : ghostY(i) = recY(i) : ghostZ(i) = recZ(i)
		ghostPitch(i) = recPitch(i) : ghostYaw(i) = recYaw(i) : ghostRoll(i) = recRoll(i)
	Next
	For i = 0 To gates - 1
		ghostGate(i) = recGate(i)
	Next
	ghostFrames = frames

	Local file = WriteFile(GhostPath(t))
	If Not file Then Return
	WriteInt file, GHOST_MAGIC
	WriteInt file, 1
	WriteInt file, TrackSignature()
	WriteInt file, frames
	WriteInt file, gates
	For i = 0 To gates - 1
		WriteInt file, recGate(i)
	Next
	For i = 0 To frames - 1
		WriteFloat file, recX(i) : WriteFloat file, recY(i) : WriteFloat file, recZ(i)
		WriteFloat file, recPitch(i) : WriteFloat file, recYaw(i) : WriteFloat file, recRoll(i)
	Next
	CloseFile file
End Function

; --- Building the track ----------------------------------------------------------------------------------------------

Function BuildTrack(index)
	slices = 0
	gates = 0
	turtleX = 0 : turtleY = 12 : turtleZ = 0 : turtleYaw = 0 : turtleBank = 0 : turtleOpen = False
	EmitSlice()

	; Read the pieces one by one: a letter and a number, which is 1 when it is left out.
	Local pieces$ = trackPieces(index) + " ", word$, i, letter$, n
	For i = 1 To Len(pieces)
		If Mid(pieces, i, 1) = " "
			If word <> ""
				letter = Left(word, 1)
				n = 1
				If Len(word) > 1 Then n = Int(Mid(word, 2))
				AddPiece(letter, n)
			EndIf
			word = ""
		Else
			word = word + Mid(pieces, i, 1)
		EndIf
	Next

	MakeFrames()
	MakeTrackMesh()
	MakeScenery()
	MakeMinimap()
	LoadGhost(index)
End Function

Function EmitSlice()
	If slices >= MAX_SLICES Then RuntimeError "The track is too long."
	sX(slices) = turtleX : sY(slices) = turtleY : sZ(slices) = turtleZ
	sYaw(slices) = turtleYaw : sBank(slices) = turtleBank
	sGap(slices) = False : sOpen(slices) = turtleOpen : sBoost(slices) = False
	slices = slices + 1
End Function

; Moves the turtle along its heading. A heading of 0 is +z, and more turns left, like the yaw of an entity.
Function Advance(length#)
	turtleX = turtleX - Sin(turtleYaw) * length
	turtleZ = turtleZ + Cos(turtleYaw) * length
End Function

Function AddPiece(letter$, n)
	Local k, steps, t#, y0# = turtleY, radius#, angle#, turn#, bank#
	Select letter
		Case "S" ; A straight of 16 units for each n.
			For k = 1 To n * 8
				Advance(SLICE_STEP) : EmitSlice()
			Next
		Case "B" ; A straight with a boost pad.
			For k = 1 To n * 8
				Advance(SLICE_STEP) : EmitSlice()
				If k > 1 And k < n * 8 - 1 Then sBoost(slices - 2) = True
			Next
		Case "U", "D" ; A slope up or down by 3 units for each n, over 48 units, that starts and ends flat.
			If letter = "D" Then n = -n
			For k = 1 To 24
				t = k / 24.0
				Advance(SLICE_STEP)
				turtleY = y0 + n * 3.0 * (1 - Cos(180 * t)) / 2
				EmitSlice()
			Next
		Case "H" ; A hump that throws a fast car into the air.
			For k = 1 To 12
				t = k / 12.0
				Advance(SLICE_STEP)
				turtleY = y0 + n * 1.2 * Sin(180 * t)
				EmitSlice()
			Next
		Case "L", "R", "l", "r" ; A turn of 45 degrees for each n: wide in capitals, tight in small letters.
			radius = 30 : bank = 10
			If letter = "l" Or letter = "r" Then radius = 16 : bank = 6
			angle = Float(n * 45)
			If letter = "R" Or letter = "r" Then angle = -angle : bank = -bank
			steps = Int(Ceil(Abs(angle) * Pi / 180 * radius / SLICE_STEP))
			turn = angle / steps
			For k = 1 To steps
				turtleYaw = turtleYaw + turn / 2
				Advance(Abs(angle) * Pi / 180 * radius / steps)
				turtleYaw = turtleYaw + turn / 2
				; The road leans into the turn, most in the middle of it.
				turtleBank = bank * Sin(180.0 * k / steps)
				EmitSlice()
			Next
			turtleBank = 0
		Case "J" ; A kicker, then a gap of 10 units for each n, and the road goes on 2 units lower for each n.
			For k = 1 To 6
				t = k / 6.0
				Advance(SLICE_STEP)
				turtleY = y0 + 1.6 * t * t
				EmitSlice()
			Next
			sGap(slices - 1) = True
			Advance(Float(n * 10))
			turtleY = y0 - n * 2
			EmitSlice()
		Case "C" ; A checkpoint.
			gateSlice(gates) = slices - 1
			gates = gates + 1
		Case "F" ; The finish, and some road after it to slow down on.
			gateSlice(gates) = slices - 1
			gates = gates + 1
			For k = 1 To 24
				Advance(SLICE_STEP) : EmitSlice()
			Next
		Case "O" ; Barriers off, or on again.
			turtleOpen = Not turtleOpen
	End Select
End Function

; Works out the directions at every slice. Forward follows the road, also up and down hills; right leans with the
; bank; up is square to both.
Function MakeFrames()
	Local i, a, b, fx#, fy#, fz#, rx#, ry#, rz#, length#
	sDist(0) = 0
	For i = 0 To slices - 1
		a = i - 1 : b = i + 1
		If a < 0 Or (a >= 0 And sGap(Max(a, 0))) Then a = i
		If b >= slices Or sGap(i) Then b = i
		If a = b
			fx = -Sin(sYaw(i)) : fy = 0 : fz = Cos(sYaw(i))
		Else
			fx = sX(b) - sX(a) : fy = sY(b) - sY(a) : fz = sZ(b) - sZ(a)
		EndIf
		length = Sqr(fx * fx + fy * fy + fz * fz)
		sFX(i) = fx / length : sFY(i) = fy / length : sFZ(i) = fz / length
		; Flat right, tilted up by the bank.
		rx = Cos(sYaw(i)) * Cos(sBank(i)) : ry = Sin(sBank(i)) : rz = Sin(sYaw(i)) * Cos(sBank(i))
		Cross(sFX(i), sFY(i), sFZ(i), rx, ry, rz)
		sUX(i) = crossX : sUY(i) = crossY : sUZ(i) = crossZ
		Cross(sUX(i), sUY(i), sUZ(i), sFX(i), sFY(i), sFZ(i))
		sRX(i) = crossX : sRY(i) = crossY : sRZ(i) = crossZ
		If i > 0 Then sDist(i) = sDist(i - 1) + Distance(sX(i), sY(i), sZ(i), sX(i - 1), sY(i - 1), sZ(i - 1))
	Next
End Function

Global crossX#, crossY#, crossZ#
; The cross product, normalised, into crossX, crossY and crossZ.
Function Cross(ax#, ay#, az#, bx#, by#, bz#)
	crossX = ay * bz - az * by
	crossY = az * bx - ax * bz
	crossZ = ax * by - ay * bx
	Local length# = Sqr(crossX * crossX + crossY * crossY + crossZ * crossZ)
	If length > 0 Then crossX = crossX / length : crossY = crossY / length : crossZ = crossZ / length
End Function

Function Distance#(x1#, y1#, z1#, x2#, y2#, z2#)
	Return Sqr((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1) + (z2 - z1) * (z2 - z1))
End Function

; Corner k of AddQuad: a point of slice i, lat units right of the middle and h units above the road.
Function SetCorner(k, i, lat#, h#, u#, v#)
	qX(k) = sX(i) + sRX(i) * lat + sUX(i) * h
	qY(k) = sY(i) + sRY(i) * lat + sUY(i) * h
	qZ(k) = sZ(i) + sRZ(i) * lat + sUZ(i) * h
	qU(k) = u : qV(k) = v
End Function

; Adds the four corners in qX/qY/qZ as two triangles. The graphics card draws the side that sees the corners go round
; clockwise; with both set, the quad is seen from both sides.
Function AddQuad(surface, front, back)
	Local v0 = AddVertex(surface, qX(0), qY(0), qZ(0), qU(0), qV(0))
	Local v1 = AddVertex(surface, qX(1), qY(1), qZ(1), qU(1), qV(1))
	Local v2 = AddVertex(surface, qX(2), qY(2), qZ(2), qU(2), qV(2))
	Local v3 = AddVertex(surface, qX(3), qY(3), qZ(3), qU(3), qV(3))
	If front
		AddTriangle surface, v0, v1, v2
		AddTriangle surface, v0, v2, v3
	EndIf
	If back
		AddTriangle surface, v0, v2, v1
		AddTriangle surface, v0, v3, v2
	EndIf
End Function

; The road, its edges and barriers are one mesh, which is also the physics body. The gates, pads and the rest are
; another mesh, which the car never touches.
Function MakeTrackMesh()
	If trackMesh <> 0 Then FreeEntity trackMesh
	If trackBody <> 0 Then FreeEntity trackBody : trackBody = 0
	trackMesh = CreateMesh()
	Local brush = CreateBrush()
	BrushTexture brush, roadTex
	Local road = CreateSurface(trackMesh, brush)
	FreeBrush brush
	brush = CreateBrush()
	BrushTexture brush, barrierTex
	Local walls = CreateSurface(trackMesh, brush)
	FreeBrush brush
	brush = CreateBrush(150, 145, 140)
	Local sides = CreateSurface(trackMesh, brush)
	FreeBrush brush

	Local i, side, v0#, v1#, w# = HALF_WIDTH
	For i = 0 To slices - 2
		If Not sGap(i)
			v0 = sDist(i) / 12.0 : v1 = sDist(i + 1) / 12.0
			; The top, seen from above: left, next left, next right, right is clockwise.
			SetCorner(0, i, -w, 0, 0, v0) : SetCorner(1, i + 1, -w, 0, 0, v1)
			SetCorner(2, i + 1, w, 0, 1, v1) : SetCorner(3, i, w, 0, 1, v0)
			AddQuad(road, True, False)
			; The underside and the two edges of the slab.
			SetCorner(0, i, -w, -SLAB, 0, 0) : SetCorner(1, i + 1, -w, -SLAB, 0, 0)
			SetCorner(2, i + 1, w, -SLAB, 0, 0) : SetCorner(3, i, w, -SLAB, 0, 0)
			AddQuad(sides, False, True)
			For side = -1 To 1 Step 2
				SetCorner(0, i, w * side, 0, 0, 0) : SetCorner(1, i + 1, w * side, 0, 0, 0)
				SetCorner(2, i + 1, w * side, -SLAB, 0, 0) : SetCorner(3, i, w * side, -SLAB, 0, 0)
				AddQuad(sides, True, True)
				If Not sOpen(i)
					v0 = sDist(i) / 4.0 : v1 = sDist(i + 1) / 4.0
					SetCorner(0, i, w * side, BARRIER, v0, 0) : SetCorner(1, i + 1, w * side, BARRIER, v1, 0)
					SetCorner(2, i + 1, w * side, 0, v1, 1) : SetCorner(3, i, w * side, 0, v0, 1)
					AddQuad(walls, True, True)
				EndIf
			Next
		EndIf
	Next
	; Walls across the road behind the start and after the run-off of the finish.
	For side = 0 To 1
		i = 0
		If side = 1 Then i = slices - 1
		SetCorner(0, i, -w, 3, 0, 0) : SetCorner(1, i, w, 3, 3, 0) : SetCorner(2, i, w, 0, 3, 1) : SetCorner(3, i, -w, 0, 0, 1)
		AddQuad(walls, True, True)
	Next
	UpdateNormals trackMesh

	; The physics body is an exact triangle mesh of the same shape. It is static: it never moves.
	trackBody = CreatePhysicsBodyFromEntity(trackMesh, 1, 5)
	PhysicsUpdate 0 ; Queries see the bodies as the last update left them, so take the new body over now.
End Function

Function MakeScenery()
	If scenery <> 0 Then FreeEntity scenery
	scenery = CreatePivot()
	Local i, k, part, side, x#, z#, near#, tries

	; Boost pads: arrows a little above the road, which glow and scroll.
	Local pads = CreateMesh(scenery)
	Local brush = CreateBrush()
	BrushTexture brush, padTex
	BrushFX brush, 1
	padSurface = CreateSurface(pads, brush)
	FreeBrush brush
	For i = 0 To slices - 2
		If sBoost(i)
			SetCorner(0, i, -3, 0.04, 0, sDist(i) / 6.0) : SetCorner(1, i + 1, -3, 0.04, 0, sDist(i + 1) / 6.0)
			SetCorner(2, i + 1, 3, 0.04, 1, sDist(i + 1) / 6.0) : SetCorner(3, i, 3, 0.04, 1, sDist(i) / 6.0)
			AddQuad(padSurface, True, False)
		EndIf
	Next

	; Gates: two posts and a banner. The start and the finish are chequered, checkpoints blue until passed.
	For k = -1 To gates - 1
		If k = -1 Then i = START_SLICE + 2 Else i = gateSlice(k)
		For side = -1 To 1 Step 2
			part = CreateCube(scenery)
			ScaleEntity part, 0.35, 3.0, 0.35
			RotateEntity part, 0, sYaw(i), 0
			PositionEntity part, sX(i) + sRX(i) * side * (HALF_WIDTH + 0.8), sY(i) + 3.0, sZ(i) + sRZ(i) * side * (HALF_WIDTH + 0.8)
			EntityColor part, 230, 230, 235
		Next
		part = CreateCube(scenery)
		ScaleEntity part, HALF_WIDTH + 1.15, 0.7, 0.15
		RotateEntity part, 0, sYaw(i), 0
		PositionEntity part, sX(i), sY(i) + 5.6, sZ(i)
		If k = -1 Or k = gates - 1
			EntityTexture part, checkerTex
		Else
			EntityColor part, 60, 140, 255
			gateBanner(k) = part
		EndIf
		EntityFX part, 1
	Next

	; Pillars under the road.
	For i = 0 To slices - 1 Step 10
		If sY(i) > SLAB + 1 And Not sGap(i)
			part = CreateCube(scenery)
			ScaleEntity part, 0.7, (sY(i) - SLAB) / 2, 0.7
			RotateEntity part, 0, sYaw(i), 0
			PositionEntity part, sX(i), (sY(i) - SLAB) / 2, sZ(i)
			EntityColor part, 170, 165, 160
		EndIf
	Next

	; Trees on the fields, never under the road.
	Local tree = CreatePivot(scenery), trunk = CreateCylinder(6, True, tree), crown = CreateCone(8, True, tree)
	ScaleEntity trunk, 0.5, 2, 0.5
	PositionEntity trunk, 0, 2, 0
	EntityTexture trunk, barkTex
	ScaleEntity crown, 3, 6, 3
	PositionEntity crown, 0, 8, 0
	EntityColor crown, 50, 120, 60
	For k = 1 To 160
		tries = 0
		Repeat
			x = Rnd(-500, 500) : z = Rnd(-500, 500)
			near = 100000
			For i = 0 To slices - 1 Step 4
				near = Min(near, (sX(i) - x) * (sX(i) - x) + (sZ(i) - z) * (sZ(i) - z))
			Next
			tries = tries + 1
		Until near > 18 * 18 Or tries > 20
		part = CopyEntity(tree, scenery)
		PositionEntity part, x, 0, z
		ScaleEntity part, Rnd(0.7, 1.3), Rnd(0.7, 1.4), Rnd(0.7, 1.3)
		TurnEntity part, 0, Rnd(360), 0
	Next
	FreeEntity tree
End Function

; --- The car ---------------------------------------------------------------------------------------------------------

; A car made of boxes and cylinders under a pivot. The ghost gets the same shape, see-through and without wheels that
; steer.
Function MakeCarModel(parent, r#, g#, b#, alpha#)
	Local part = CreateCube(parent)
	ScaleEntity part, 0.95, 0.28, 2.0
	PositionEntity part, 0, -0.12, 0
	EntityColor part, r, g, b
	EntityAlpha part, alpha
	EntityShininess part, 0.6
	part = CreateCube(parent) ; The cabin.
	ScaleEntity part, 0.72, 0.26, 0.9
	PositionEntity part, 0, 0.36, -0.25
	EntityColor part, 40, 50, 70
	EntityAlpha part, alpha
	EntityShininess part, 1
	part = CreateCube(parent) ; The wing at the back.
	ScaleEntity part, 0.95, 0.05, 0.25
	PositionEntity part, 0, 0.42, -1.75
	EntityColor part, r * 0.6, g * 0.6, b * 0.6
	EntityAlpha part, alpha
	Local side
	For side = -1 To 1 Step 2
		part = CreateCube(parent)
		ScaleEntity part, 0.05, 0.2, 0.08
		PositionEntity part, 0.7 * side, 0.2, -1.75
		EntityColor part, 30, 30, 35
		EntityAlpha part, alpha
	Next
End Function

Function NewCar.Car()
	Local c.Car = New Car
	c\ent = CreatePivot()
	MakeCarModel(c\ent, carR(optColour), carG(optColour), carB(optColour), 1)
	Local w, x#, z#
	For w = 0 To 3
		If w Mod 2 = 0 Then x = -0.95 Else x = 0.95
		If w < 2 Then z = 1.25 Else z = -1.25
		c\wheel[w] = CreatePivot(c\ent)
		PositionEntity c\wheel[w], x, -0.5, z
		c\tyre[w] = CreateCylinder(12, True, c\wheel[w])
		ScaleEntity c\tyre[w], 0.42, 0.18, 0.42
		RotateEntity c\tyre[w], 0, 0, 90
		EntityTexture c\tyre[w], checkerTex
		EntityColor c\tyre[w], 60, 60, 60
	Next
	Return c
End Function

Function MakeGhost()
	If ghost <> 0 Then FreeEntity ghost
	ghost = CreatePivot()
	MakeCarModel(ghost, 180, 220, 255, 0.35)
	Local w, x#, z#, tyre
	For w = 0 To 3
		If w Mod 2 = 0 Then x = -0.95 Else x = 0.95
		If w < 2 Then z = 1.25 Else z = -1.25
		tyre = CreateCylinder(12, True, ghost)
		ScaleEntity tyre, 0.42, 0.18, 0.42
		RotateEntity tyre, 0, 0, 90
		PositionEntity tyre, x, -0.5, z
		EntityColor tyre, 180, 220, 255
		EntityAlpha tyre, 0.35
	Next
	HideEntity ghost
End Function

; Puts the car on slice i, standing still and facing along the road.
Function PlaceCar(c.Car, i)
	RotateEntity c\ent, 0, sYaw(i), 0
	AlignToVector c\ent, sUX(i), sUY(i), sUZ(i), 2, 1
	PositionEntity c\ent, sX(i) + sUX(i) * RIDE, sY(i) + sUY(i) * RIDE, sZ(i) + sUZ(i) * RIDE
	c\vx = 0 : c\vy = 0 : c\vz = 0
	c\oldX = EntityX(c\ent) : c\oldY = EntityY(c\ent) : c\oldZ = EntityZ(c\ent)
	c\steer = 0 : c\boost = 0 : c\airTime = 0 : c\grounded = 4
	c\near = i
End Function

Global axisFX#, axisFY#, axisFZ#, axisRX#, axisRY#, axisRZ#, axisUX#, axisUY#, axisUZ#
Function CarAxes(c.Car)
	TFormVector 0, 0, 1, c\ent, 0
	axisFX = TFormedX() : axisFY = TFormedY() : axisFZ = TFormedZ()
	TFormVector 1, 0, 0, c\ent, 0
	axisRX = TFormedX() : axisRY = TFormedY() : axisRZ = TFormedZ()
	TFormVector 0, 1, 0, c\ent, 0
	axisUX = TFormedX() : axisUY = TFormedY() : axisUZ = TFormedZ()
End Function

; The speed along the car's nose, in units per second; negative when reversing.
Function ForwardSpeed#(c.Car)
	CarAxes(c)
	Return c\vx * axisFX + c\vy * axisFY + c\vz * axisFZ
End Function

; One update of driving. throttle is 1 (accelerate), 0 or -1 (brake and reverse); steer is -1 (right) to 1 (left).
Function DriveCar(c.Car, throttle#, steer#, handbrake)
	; Turn the wheel towards what was asked, a little every update.
	c\steer = c\steer + Clamp(steer - c\steer, -0.12, 0.12)

	; The four wheels look for the road with a ray each, straight down from the car.
	CarAxes(c)
	Local w, x#, y#, z#, hits, nx#, ny#, nz#, height#, wx#, wz#
	For w = 0 To 3
		If w Mod 2 = 0 Then wx = -0.95 Else wx = 0.95
		If w < 2 Then wz = 1.25 Else wz = -1.25
		TFormPoint wx, 0, wz, c\ent, 0
		x = TFormedX() : y = TFormedY() : z = TFormedZ()
		If PhysicsRayCast(x + axisUX * 0.4, y + axisUY * 0.4, z + axisUZ * 0.4, x - axisUX * (RIDE + 0.6), y - axisUY * (RIDE + 0.6), z - axisUZ * (RIDE + 0.6))
			hits = hits + 1
			nx = nx + GetPhysicsHitNX() : ny = ny + GetPhysicsHitNY() : nz = nz + GetPhysicsHitNZ()
			height = height + GetPhysicsHitDistance() - 0.4
		EndIf
	Next

	c\vy = c\vy - GRAVITY * DT
	Local vf#, vs#, vu#, push#, rate#, length#
	If hits > 0
		If c\airTime > 30 Then PlaySfx(soundLand)
		c\airTime = 0
		length = Sqr(nx * nx + ny * ny + nz * nz)
		nx = nx / length : ny = ny / length : nz = nz / length
		height = height / hits
		; Springs: push the car away from the road as it comes closer than its ride height, and damp the bounce.
		vu = c\vx * nx + c\vy * ny + c\vz * nz
		push = SPRING * (RIDE - height) * hits / 4.0 - DAMPING * vu
		If push > 0
			c\vx = c\vx + nx * push * DT : c\vy = c\vy + ny * push * DT : c\vz = c\vz + nz * push * DT
		EndIf
		; Stand up square to the road.
		AlignToVector c\ent, nx, ny, nz, 2, 0.25
		CarAxes(c)

		; Split the speed into along the nose, sideways and up, change them, and put them back together.
		vf = c\vx * axisFX + c\vy * axisFY + c\vz * axisFZ
		vs = c\vx * axisRX + c\vy * axisRY + c\vz * axisRZ
		vu = c\vx * axisUX + c\vy * axisUY + c\vz * axisUZ
		If throttle > 0
			If vf < 0 Then vf = vf + BRAKING * DT Else vf = vf + ACCELERATION * DT * Max(0, 1 - vf / TOP_SPEED)
		ElseIf throttle < 0
			If vf > 0.5 Then vf = vf - BRAKING * DT Else vf = Max(-REVERSE_SPEED, vf - ACCELERATION * 0.5 * DT)
		Else
			vf = vf * 0.992 ; Rolling to a stop.
		EndIf
		If handbrake Then vf = vf * 0.993
		If c\boost > 0 Then vf = Min(BOOST_SPEED, vf + 40 * DT)
		; Tyres grip: most of the sliding sideways is gone in every update. With the handbrake they slide.
		If handbrake Then vs = vs * 0.97 Else vs = vs * 0.82
		c\vx = axisFX * vf + axisRX * vs + axisUX * vu
		c\vy = axisFY * vf + axisRY * vs + axisUY * vu
		c\vz = axisFZ * vf + axisRZ * vs + axisUZ * vu

		; Steering turns the car round its own up. It needs some speed, and gets gentler as the car gets faster.
		rate = c\steer * 2.6 * Min(1, Abs(vf) / 8.0) / (1 + Abs(vf) / 45.0)
		If handbrake Then rate = rate * 1.6
		If vf < 0 Then rate = -rate
		TurnEntity c\ent, 0, rate, 0
	Else
		c\airTime = c\airTime + 1
		; In the air the car can still be turned a little, and slowly levels out for the landing.
		TurnEntity c\ent, 0, c\steer * 1.2, 0
		AlignToVector c\ent, 0, 1, 0, 2, 0.015
	EndIf
	c\grounded = hits
	If c\boost > 0 Then c\boost = c\boost - 1

	MoveCar(c)

	; Spin the tyres with the speed and point the front ones where the car steers.
	vf = ForwardSpeed(c)
	c\spin = c\spin + vf * DT / 0.42 * 57.3
	For w = 0 To 3
		If w < 2 Then RotateEntity c\wheel[w], 0, c\steer * 25, 0
		RotateEntity c\tyre[w], c\spin, 0, 90
	Next
End Function

; Moves the car by its speed for one update. A sphere goes ahead of it; whatever it touches stops the part of the
; movement that goes into it, and the rest slides along. Three tries are enough for a corner between two walls.
Function MoveCar(c.Car)
	c\oldX = EntityX(c\ent) : c\oldY = EntityY(c\ent) : c\oldZ = EntityZ(c\ent)
	Local x# = c\oldX, y# = c\oldY, z# = c\oldZ
	Local dx# = c\vx * DT, dy# = c\vy * DT, dz# = c\vz * DT
	Local try, length#, travel#, nx#, ny#, nz#, into#
	For try = 1 To 3
		length = Sqr(dx * dx + dy * dy + dz * dz)
		If length < 0.0001 Then Exit
		If Not PhysicsSphereCast(x, y, z, x + dx, y + dy, z + dz, RADIUS)
			x = x + dx : y = y + dy : z = z + dz
			Exit
		EndIf
		nx = GetPhysicsHitNX() : ny = GetPhysicsHitNY() : nz = GetPhysicsHitNZ()
		travel = Max(0, GetPhysicsHitDistance() - 0.01)
		x = x + dx / length * travel : y = y + dy / length * travel : z = z + dz / length * travel
		; Take away the speed into the surface.
		into = c\vx * nx + c\vy * ny + c\vz * nz
		If into < 0
			c\vx = c\vx - nx * into : c\vy = c\vy - ny * into : c\vz = c\vz - nz * into
			; A wall (not the road) scrapes some speed off, and makes a noise when hit hard.
			If ny < 0.5
				c\vx = c\vx * 0.985 : c\vy = c\vy * 0.985 : c\vz = c\vz * 0.985
				If into < -8 And frame - c\lastImpact > 20 And c = player And state = STATE_RACE
					PlaySfx(soundWall)
					c\lastImpact = frame
				EndIf
			EndIf
		EndIf
		; What is left of the movement, without the part into the surface.
		dx = dx / length * (length - travel) : dy = dy / length * (length - travel) : dz = dz / length * (length - travel)
		into = dx * nx + dy * ny + dz * nz
		If into < 0 Then dx = dx - nx * into : dy = dy - ny * into : dz = dz - nz * into
		; Starting inside something: step out of it along its normal.
		If travel = 0 Then x = x + nx * 0.02 : y = y + ny * 0.02 : z = z + nz * 0.02
	Next
	PositionEntity c\ent, x, y, z
End Function

; Finds the slice nearest to the car, looking only near the last one, so tracks that cross over do not confuse it.
Function UpdateNear(c.Car)
	Local i, best = c\near, bestDistance# = 1000000000, d#
	Local x# = EntityX(c\ent), y# = EntityY(c\ent), z# = EntityZ(c\ent)
	For i = Max(0, c\near - 4) To Min(slices - 1, c\near + 16)
		d = (sX(i) - x) * (sX(i) - x) + (sY(i) - y) * (sY(i) - y) + (sZ(i) - z) * (sZ(i) - z)
		If d < bestDistance Then bestDistance = d : best = i
	Next
	c\near = best
End Function

; True when the car is on the road at slice i, not just near it.
Function OnRoadAt(c.Car, i)
	Local dx# = EntityX(c\ent) - sX(i), dy# = EntityY(c\ent) - sY(i), dz# = EntityZ(c\ent) - sZ(i)
	Return Abs(dx * sRX(i) + dy * sRY(i) + dz * sRZ(i)) < HALF_WIDTH And Abs(dx * sUX(i) + dy * sUY(i) + dz * sUZ(i)) < 3
End Function

; The computer drives by aiming at a point further along the middle of the road, the faster the further. It brakes
; when the road ahead turns a lot, and it does not steer while flying.
Function AutoDrive(c.Car)
	Local vf# = ForwardSpeed(c)
	Local ahead = Min(slices - 1, c\near + 4 + Int(Abs(vf) / 7))
	TFormPoint sX(ahead), sY(ahead), sZ(ahead), 0, c\ent
	Local angle# = ATan2(TFormedX(), TFormedZ())
	; How much the road turns in the next 60 units sets the speed to drive at.
	Local i, turn#, most#
	For i = c\near To Min(slices - 1, c\near + 30)
		turn = Abs(WrapAngle(sYaw(i) - sYaw(c\near)))
		If turn > most Then most = turn
	Next
	Local wanted# = 75 - most * 0.4
	Local throttle# = 1
	If vf > wanted + 2 Or (Abs(angle) > 25 And vf > 30) Then throttle = -1
	DriveCar(c, throttle, Clamp(-angle / 12.0, -1, 1), False)
End Function

Function WrapAngle#(angle#)
	While angle > 180
		angle = angle - 360
	Wend
	While angle <= -180
		angle = angle + 360
	Wend
	Return angle
End Function

; --- Camera ----------------------------------------------------------------------------------------------------------

Function ChaseCamera(c.Car, snap)
	Local back# = 7.5, height# = 3.2
	If optCamera = 1 Then back = 12 : height = 5.0
	CarAxes(c)
	; Behind the car as seen from above, so the camera does not roll or dip with every bump.
	Local hx# = axisFX, hz# = axisFZ, length# = Sqr(hx * hx + hz * hz)
	If length < 0.01 Then hx = 0 : hz = 1 Else hx = hx / length : hz = hz / length
	Local x# = EntityX(c\ent) - hx * back, y# = EntityY(c\ent) + height, z# = EntityZ(c\ent) - hz * back
	If snap
		PositionEntity camera, x, y, z
	Else
		PositionEntity camera, EntityX(camera) + (x - EntityX(camera)) * 0.2, EntityY(camera) + (y - EntityY(camera)) * 0.12, EntityZ(camera) + (z - EntityZ(camera)) * 0.2
	EndIf
	PositionEntity camTarget, EntityX(c\ent) + hx * 10, EntityY(c\ent) + 1.2, EntityZ(c\ent) + hz * 10
	PointEntity camera, camTarget
	; A wider view at speed.
	Local speed# = Sqr(c\vx * c\vx + c\vy * c\vy + c\vz * c\vz)
	CameraZoom camera, 1.05 - Min(speed, 90) / 400.0
End Function

; --- Sound -----------------------------------------------------------------------------------------------------------

Function StartEngine()
	If optEngine And optVolume > 0 And soundEngine <> 0 And engineChannel = 0
		engineChannel = PlaySound(soundEngine)
		ChannelVolume engineChannel, optVolume / 4.0 * 0.5
	EndIf
End Function

Function StopEngine()
	If engineChannel <> 0 Then StopChannel engineChannel
	engineChannel = 0
End Function

Function UpdateEngine()
	If engineChannel = 0 Then Return
	Local speed# = Abs(ForwardSpeed(player))
	; The pitch climbs with the speed, and drops a little at every gear change, every 18 units per second.
	Local gear# = speed - Floor(speed / 18) * 18
	ChannelPitch engineChannel, Int(15000 + gear * 900 + speed * 220)
End Function

; --- Menus -----------------------------------------------------------------------------------------------------------

Function MenuInput()
	If KeyHit(KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount : PlaySfx(soundClick)
	If KeyHit(KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount : PlaySfx(soundClick)

	Local row = MenuLineAt(MouseX(), MouseY())
	If row >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = row

	If KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Then Return menuSelected
	If MouseHit(1) And row >= 0
		menuSelected = row
		Return row
	EndIf
	Return -1
End Function

; Which line is at a screen position, or -1. Lines are 32 pixels apart and 400 wide.
Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 200 Or x >= SCREEN_W / 2 + 200 Or y < menuTop Then Return -1
	Local row = (y - menuTop) / 32
	If row >= menuCount Then Return -1
	Return row
End Function

; Everything that opens a menu goes through here: forget old keys, clicks and mouse movement.
Function OpenMenu(newState, count, top)
	state = newState
	menuCount = count
	menuTop = top
	menuSelected = 0
	ShowPointer
	FlushKeys
	FlushMouse
	MouseXSpeed() ; So a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

; Behind the menus the computer drives the track, and starts again at the end.
Function StartDemo()
	If player = Null Then player = NewCar()
	PlaceCar(player, START_SLICE)
	If ghost <> 0 Then HideEntity ghost
	demo = True
	ChaseCamera(player, True)
End Function

Function UpdateDemo()
	If player = Null Or Not demo Then StartDemo()
	AutoDrive(player)
	UpdateNear(player)
	If player\near >= slices - 8 Or EntityY(player\ent) < sY(player\near) - 15 Then StartDemo()
	ChaseCamera(player, False)
End Function

Function GoToMenu()
	StopEngine()
	If state >= STATE_COUNTDOWN Or player = Null Then StartDemo()
	optionsFromPause = False
	OpenMenu(STATE_MENU, 4, 330)
	menuText(0) = "Play"
	menuText(1) = "Options"
	menuText(2) = "How to play"
	menuText(3) = "Quit"
End Function

; Gives back True when the player chose Quit.
Function UpdateMenu()
	UpdateDemo()
	If KeyHit(KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0 : GoToTracks()
		Case 1 : GoToOptions()
		Case 2 : OpenMenu(STATE_HELP, 0, 0)
		Case 3 : Return True
	End Select
	Return False
End Function

Function GoToTracks()
	OpenMenu(STATE_TRACKS, 3, 250)
	RefreshTracksText()
	menuSelected = 1 ; Start.
End Function

Function RefreshTracksText()
	menuText(0) = "Track: " + trackNames(setupTrack)
	menuText(1) = "Start"
	menuText(2) = "Back"
End Function

Function UpdateTracks()
	UpdateDemo()
	Local change = 0
	If KeyHit(KEY_LEFT) Then change = -1
	If KeyHit(KEY_RIGHT) Then change = 1
	Local picked = MenuInput()
	If KeyHit(KEY_ESCAPE) Or picked = 2
		SaveSettings()
		GoToMenu()
		Return
	EndIf
	If picked = 1
		SaveSettings()
		StartRun()
		Return
	EndIf
	If picked = 0 Then change = 1 ; Enter or a click steps to the next track; Left/Right work on every line.
	If change = 0 Then Return
	setupTrack = (setupTrack + change + TRACKS) Mod TRACKS
	BuildTrack(setupTrack)
	StartDemo()
	PlaySfx(soundClick)
	RefreshTracksText()
End Function

Function GoToOptions()
	optionsFromPause = state = STATE_PAUSED
	OpenMenu(STATE_OPTIONS, 7, 230)
	RefreshOptionsText()
End Function

Function RefreshOptionsText()
	If optCamera = 0 Then menuText(0) = "Camera: close" Else menuText(0) = "Camera: far"
	menuText(1) = "Car colour: " + carColourNames(optColour)
	If optGhost Then menuText(2) = "Ghost of your best run: on" Else menuText(2) = "Ghost of your best run: off"
	menuText(3) = "Sound volume: " + (optVolume * 25) + "%"
	If optEngine Then menuText(4) = "Engine sound: on" Else menuText(4) = "Engine sound: off"
	If optFullscreen Then menuText(5) = "Display: full screen" Else menuText(5) = "Display: window"
	menuText(6) = "Back"
End Function

Function UpdateOptions()
	If Not optionsFromPause Then UpdateDemo()
	Local change = 0
	If KeyHit(KEY_LEFT) Then change = -1
	If KeyHit(KEY_RIGHT) Then change = 1
	Local picked = MenuInput()
	If picked >= 0 Then change = 1

	If KeyHit(KEY_ESCAPE) Or picked = 6
		SaveSettings()
		If optionsFromPause Then GoToPause() Else GoToMenu()
		menuSelected = 1 + optionsFromPause
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optCamera = 1 - optCamera
		Case 1
			optColour = (optColour + change + CAR_COLOURS) Mod CAR_COLOURS
			RepaintCar()
		Case 2
			optGhost = Not optGhost
			If ghost <> 0 And Not optGhost Then HideEntity ghost
		Case 3
			optVolume = (optVolume + change + 5) Mod 5
			If engineChannel <> 0 Then ChannelVolume engineChannel, optVolume / 4.0 * 0.5
		Case 4 : optEngine = Not optEngine
		Case 5 : ToggleFullscreen()
	End Select
	PlaySfx(soundClick)
	RefreshOptionsText()
End Function

; Graphics3D frees every entity, so after the switch the car and the ghost are made again. From the pause menu the
; run carries on from the same place.
Function ToggleFullscreen()
	optFullscreen = Not optFullscreen
	Local running = optionsFromPause
	Local keepX#, keepY#, keepZ#, keepPitch#, keepYaw#, keepRoll#, keepNear
	Local keepVX#, keepVY#, keepVZ#
	If running
		keepX = EntityX(player\ent) : keepY = EntityY(player\ent) : keepZ = EntityZ(player\ent)
		keepPitch = EntityPitch(player\ent) : keepYaw = EntityYaw(player\ent) : keepRoll = EntityRoll(player\ent)
		keepVX = player\vx : keepVY = player\vy : keepVZ = player\vz : keepNear = player\near
	EndIf
	OpenScreen()
	player = NewCar()
	If running
		RotateEntity player\ent, keepPitch, keepYaw, keepRoll
		PositionEntity player\ent, keepX, keepY, keepZ
		player\vx = keepVX : player\vy = keepVY : player\vz = keepVZ : player\near = keepNear
		player\oldX = keepX : player\oldY = keepY : player\oldZ = keepZ
		demo = False
		MakeGhost()
		PaintGates()
		ChaseCamera(player, True)
	Else
		StartDemo()
	EndIf
End Function

Function RepaintCar()
	If player = Null Then Return
	Local keepX# = EntityX(player\ent), keepY# = EntityY(player\ent), keepZ# = EntityZ(player\ent)
	Local keepPitch# = EntityPitch(player\ent), keepYaw# = EntityYaw(player\ent), keepRoll# = EntityRoll(player\ent)
	Local c.Car = NewCar()
	RotateEntity c\ent, keepPitch, keepYaw, keepRoll
	PositionEntity c\ent, keepX, keepY, keepZ
	c\vx = player\vx : c\vy = player\vy : c\vz = player\vz : c\near = player\near : c\grounded = player\grounded
	FreeEntity player\ent
	Delete player
	player = c
End Function

Function GoToPause()
	If engineChannel <> 0 Then PauseChannel engineChannel
	OpenMenu(STATE_PAUSED, 4, 260)
	menuText(0) = "Carry on"
	menuText(1) = "Start again"
	menuText(2) = "Options"
	menuText(3) = "Main menu"
End Function

Function UpdatePause()
	Local picked = MenuInput()
	If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_P) Then picked = 0
	Select picked
		Case 0
			HidePointer
			If raceFrames = 0 Then state = STATE_COUNTDOWN Else state = STATE_RACE
			If engineChannel <> 0 Then ResumeChannel engineChannel
		Case 1 : StartRun()
		Case 2 : GoToOptions()
		Case 3 : GoToMenu()
	End Select
End Function

; --- A run -----------------------------------------------------------------------------------------------------------

Function StartRun()
	If player = Null Then player = NewCar()
	demo = False
	PlaceCar(player, START_SLICE)
	MakeGhost()
	raceFrames = 0
	countdown = 0
	nextGate = 0
	lastGate = -1
	respawns = 0
	splitTimer = 0
	messageTimer = 0
	PaintGates()
	StopEngine()
	StartEngine()
	HidePointer
	FlushKeys
	state = STATE_COUNTDOWN
	ChaseCamera(player, True)
End Function

; Checkpoints already passed turn green.
Function PaintGates()
	Local k
	For k = 0 To gates - 2
		If k < nextGate Then EntityColor gateBanner(k), 70, 220, 110 Else EntityColor gateBanner(k), 60, 140, 255
	Next
End Function

Function UpdateCountdown()
	; Hold the car on the line; the engine can already be revved.
	PlaceCar(player, START_SLICE)
	If countdown Mod 60 = 0 Then PlaySfx(soundBeep)
	countdown = countdown + 1
	If countdown >= 180
		state = STATE_RACE
		PlaySfx(soundGo)
	EndIf
	ShowGhost(0)
	ChaseCamera(player, False)
	UpdateEngine()
	If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_P) Then GoToPause()
End Function

Function PlayerInput()
	Local throttle# = 0, steer# = 0
	If KeyDown(KEY_UP) Or KeyDown(KEY_W) Then throttle = 1
	If KeyDown(KEY_DOWN) Or KeyDown(KEY_S) Then throttle = -1
	If KeyDown(KEY_LEFT) Or KeyDown(KEY_A) Then steer = steer + 1
	If KeyDown(KEY_RIGHT) Or KeyDown(KEY_D) Then steer = steer - 1
	DriveCar(player, throttle, steer, KeyDown(KEY_SPACE))
End Function

Function UpdateRace()
	PlayerInput()
	UpdateNear(player)
	Record()
	raceFrames = raceFrames + 1
	ShowGhost(raceFrames)
	CheckPads(player)
	CheckGates()
	If state <> STATE_RACE Then Return ; The finish was crossed.

	; Off the track, or flying for a long time: back to the last checkpoint.
	If EntityY(player\ent) < sY(player\near) - 12 Or player\airTime > 360 Or EntityY(player\ent) < 1
		Respawn("Back to the checkpoint")
	EndIf
	If KeyHit(KEY_BACKSPACE) Then Respawn("")
	If KeyHit(KEY_R) Then StartRun() : Return
	ChaseCamera(player, False)
	UpdateEngine()
	If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_P) Then GoToPause()
End Function

Function Respawn(text$)
	Local i = START_SLICE
	If lastGate >= 0 Then i = gateSlice(lastGate)
	PlaceCar(player, i)
	respawns = respawns + 1
	If text <> "" Then ShowMessage(text)
	ChaseCamera(player, True)
End Function

; Keeps where the car is in this update, for the ghost.
Function Record()
	If raceFrames >= MAX_FRAMES Then Return
	recX(raceFrames) = EntityX(player\ent, True)
	recY(raceFrames) = EntityY(player\ent, True)
	recZ(raceFrames) = EntityZ(player\ent, True)
	recPitch(raceFrames) = EntityPitch(player\ent, True)
	recYaw(raceFrames) = EntityYaw(player\ent, True)
	recRoll(raceFrames) = EntityRoll(player\ent, True)
End Function

; Puts the ghost where the best run was after the same time. After its finish it stays on the line.
Function ShowGhost(f)
	If ghost = 0 Then Return
	If ghostFrames = 0 Or Not optGhost
		HideEntity ghost
		Return
	EndIf
	f = Min(f, ghostFrames - 1)
	ShowEntity ghost
	RotateEntity ghost, ghostPitch(f), ghostYaw(f), ghostRoll(f), True
	PositionEntity ghost, ghostX(f), ghostY(f), ghostZ(f), True
	; Fade the ghost out when it is right on top of the car, so it does not block the view.
	Local d# = EntityDistance(ghost, player\ent)
	Local alpha# = Clamp((d - 2) / 8.0, 0.08, 0.35), part
	For part = 1 To CountChildren(ghost)
		EntityAlpha GetChild(ghost, part), alpha
	Next
End Function

Function CheckPads(c.Car)
	If c\grounded = 0 Then Return
	If sBoost(c\near) And OnRoadAt(c, c\near)
		If c\boost = 0 Then PlaySfx(soundBoost)
		c\boost = BOOST_TIME
	EndIf
End Function

; A gate is passed when the car goes from before it to after it, between the posts.
Function CheckGates()
	If nextGate >= gates Then Return
	Local i = gateSlice(nextGate)
	Local behind# = (player\oldX - sX(i)) * sFX(i) + (player\oldY - sY(i)) * sFY(i) + (player\oldZ - sZ(i)) * sFZ(i)
	Local x# = EntityX(player\ent) - sX(i), y# = EntityY(player\ent) - sY(i), z# = EntityZ(player\ent) - sZ(i)
	Local past# = x * sFX(i) + y * sFY(i) + z * sFZ(i)
	Local lat# = x * sRX(i) + y * sRY(i) + z * sRZ(i), up# = x * sUX(i) + y * sUY(i) + z * sUZ(i)
	If behind < 0 And past >= 0 And Abs(lat) < HALF_WIDTH + 1 And up > -2 And up < 7
		recGate(nextGate) = raceFrames
		If ghostFrames > 0 And optGhost
			Local delta = raceFrames - ghostGate(nextGate)
			splitAhead = delta <= 0
			splitText = SplitText(delta)
			splitTimer = 150
		EndIf
		lastGate = nextGate
		nextGate = nextGate + 1
		If nextGate = gates
			Finish()
		Else
			PlaySfx(soundGate)
			PaintGates()
		EndIf
	EndIf
End Function

Function Finish()
	PlaySfx(soundFinish)
	finishFrames = raceFrames
	oldBest = bestTime(setupTrack)
	newBest = (oldBest = 0 Or finishFrames < oldBest) And finishFrames <= MAX_FRAMES
	If newBest
		bestTime(setupTrack) = finishFrames
		KeepGhost(setupTrack, finishFrames)
		SaveSettings()
	EndIf
	finishTimer = 150
	state = STATE_FINISHED
End Function

; After the finish the car rolls out on its own, then the results come up.
Function UpdateFinished()
	DriveCar(player, -1, 0, False)
	UpdateNear(player)
	raceFrames = raceFrames + 1
	ShowGhost(raceFrames)
	ChaseCamera(player, False)
	UpdateEngine()
	finishTimer = finishTimer - 1
	If finishTimer <= 0 Or KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Then GoToResults()
End Function

Function GoToResults()
	StopEngine()
	OpenMenu(STATE_RESULTS, 3, 400)
	menuText(0) = "Try again"
	menuText(1) = "Next track"
	menuText(2) = "Main menu"
End Function

Function UpdateResults()
	; The car stands at the end of the track; the camera slowly circles it.
	DriveCar(player, -1, 0, False)
	TurnEntity camTarget, 0, 0.3, 0
	Local angle# = frame * 0.3
	PositionEntity camera, EntityX(player\ent) + Sin(angle) * 9, EntityY(player\ent) + 3, EntityZ(player\ent) + Cos(angle) * 9
	PointEntity camera, player\ent
	Select MenuInput()
		Case 0 : StartRun()
		Case 1
			setupTrack = (setupTrack + 1) Mod TRACKS
			SaveSettings()
			BuildTrack(setupTrack)
			StartRun()
		Case 2 : GoToMenu()
	End Select
	If KeyHit(KEY_ESCAPE) Then GoToMenu()
End Function

; The medal a time earns: 3 gold, 2 silver, 1 bronze, 0 none.
Function MedalFor(t, frames)
	If frames = 0 Then Return 0
	Local medal
	For medal = 0 To 2
		If frames <= Int(medalTime(t, medal) * 60) Then Return 3 - medal
	Next
	Return 0
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	; The sky, with the watermark in it, then the world on top. The camera only clears the depth buffer.
	ClsColor SKY_R, SKY_G, SKY_B
	Cls
	DrawWatermark(SKY_R, SKY_G, SKY_B)
	RenderWorld

	Select state
		Case STATE_MENU
			DrawTitle("Ghost Run", 120)
			SmallText(SCREEN_W / 2, 175, "Race the clock, and your own best run.")
			DrawMenu()
		Case STATE_TRACKS
			ShadeScreen()
			DrawTitle("Choose a track", 170)
			DrawMenu()
			DrawTrackInfo(370)
		Case STATE_OPTIONS
			ShadeScreen()
			DrawTitle("Options", 150)
			DrawMenu()
			SmallText(SCREEN_W / 2, 470, "Left/Right or a click change the selected option.")
		Case STATE_HELP
			ShadeScreen()
			DrawHelp()
		Case STATE_COUNTDOWN
			DrawHud()
			DrawBig(Str(3 - countdown / 60), 220)
		Case STATE_RACE
			DrawHud()
			If raceFrames < 60 Then DrawBig("GO!", 220)
		Case STATE_PAUSED
			DrawHud()
			ShadeScreen()
			DrawTitle("Paused", 180)
			DrawMenu()
		Case STATE_FINISHED
			DrawHud()
			DrawBig(TimeText(finishFrames), 220)
			If newBest Then SmallText(SCREEN_W / 2, 300, "New best time!")
		Case STATE_RESULTS
			ShadeScreen()
			DrawResults()
			DrawMenu()
	End Select

	If state <= STATE_HELP
		Color 40, 60, 100
		Text SCREEN_W / 2, SCREEN_H - 24, "A BlitzLLVM sample game", True, True
	EndIf
End Function

Function DrawTrackInfo(y)
	Local t = setupTrack, best$ = "--"
	If bestTime(t) > 0 Then best = TimeText(bestTime(t)) + "  (" + medalNames(MedalFor(t, bestTime(t))) + ")"
	SmallText(SCREEN_W / 2, y, "Your best:  " + best)
	SmallText(SCREEN_W / 2, y + 26, "Gold " + TimeText(Int(medalTime(t, 0) * 60)) + "     Silver " + TimeText(Int(medalTime(t, 1) * 60)) + "     Bronze " + TimeText(Int(medalTime(t, 2) * 60)))
	SmallText(SCREEN_W / 2, y + 52, (gates - 1) + " checkpoints, " + Int(sDist(slices - 1)) + " metres")
	If bestTime(t) > 0 And ghostFrames > 0 Then SmallText(SCREEN_W / 2, y + 78, "Your best run will drive with you as a ghost.")
End Function

Function DrawHud()
	SetFont hudFont
	; The clock at the top in the middle, and how far ahead or behind the ghost at the last checkpoint.
	ShadowText(SCREEN_W / 2, 14, TimeText(raceFrames), True)
	If splitTimer > 0
		SetFont menuFont
		Local w = StringWidth(splitText) + 24
		If splitAhead Then Color 30, 120, 255 Else Color 220, 50, 50
		Rect SCREEN_W / 2 - w / 2, 50, w, 26, 1
		Color 255, 255, 255
		Text SCREEN_W / 2, 63, splitText, True, True
	EndIf

	; Checkpoints on the left, the best time on the right.
	SetFont menuFont
	ShadowText(20, 16, "Checkpoint " + Min(nextGate, gates - 1) + " / " + (gates - 1), False)
	Local best$ = "Best  --"
	If bestTime(setupTrack) > 0 Then best = "Best  " + TimeText(bestTime(setupTrack))
	ShadowText(SCREEN_W - 20 - StringWidth(best), 16, best, False)
	Local target = MedalFor(setupTrack, 1) ; Gold, the medal to aim for.
	If bestTime(setupTrack) > 0 Then target = Min(3, MedalFor(setupTrack, bestTime(setupTrack)) + 1)
	If target > 0
		Local aim$ = medalNames(target) + "  " + TimeText(Int(medalTime(setupTrack, 3 - target) * 60))
		ShadowText(SCREEN_W - 20 - StringWidth(aim), 40, aim, False)
	EndIf

	; Speed at the bottom right, the map at the bottom left.
	SetFont hudFont
	Local speed$ = Int(Abs(ForwardSpeed(player)) * 3.6) + " km/h"
	ShadowText(SCREEN_W - 20 - StringWidth(speed), SCREEN_H - 44, speed, False)
	If player\boost > 0
		SetFont menuFont
		ShadowText(SCREEN_W - 20 - StringWidth("Boost"), SCREEN_H - 70, "Boost", False)
	EndIf
	DrawMinimap()

	If messageTimer > 0
		SetFont hudFont
		ShadowText(SCREEN_W / 2, 150, messageText, True)
	EndIf
	SetFont 0
End Function

Function DrawMinimap()
	Local x0 = 12, y0 = SCREEN_H - MINIMAP - 12
	DrawImage minimapImage, x0, y0
	If ghost <> 0 And ghostFrames > 0 And optGhost
		DrawMapDot(EntityX(ghost), EntityZ(ghost), x0, y0, 3, 200, 230, 255)
	EndIf
	DrawMapDot(EntityX(player\ent), EntityZ(player\ent), x0, y0, 4, Int(carR(optColour)), Int(carG(optColour)), Int(carB(optColour)))
End Function

Function DrawMapDot(x#, z#, x0, y0, size, r, g, b)
	Color 0, 0, 0
	Oval x0 + MapX(x) - size - 1, y0 + MapY(z) - size - 1, size * 2 + 2, size * 2 + 2, 1
	Color r, g, b
	Oval x0 + MapX(x) - size, y0 + MapY(z) - size, size * 2, size * 2, 1
End Function

Global mapMinX#, mapMinZ#, mapScale#
Function MapX(x#)
	Return Int(8 + (x - mapMinX) * mapScale)
End Function

Function MapY(z#)
	Return Int(MINIMAP - 8 - (z - mapMinZ) * mapScale)
End Function

; The track seen from above, drawn once into a picture, with the checkpoints as dots.
Function MakeMinimap()
	Local i, maxX# = -100000, maxZ# = -100000
	mapMinX = 100000 : mapMinZ = 100000
	For i = 0 To slices - 1
		mapMinX = Min(mapMinX, sX(i)) : maxX = Max(maxX, sX(i))
		mapMinZ = Min(mapMinZ, sZ(i)) : maxZ = Max(maxZ, sZ(i))
	Next
	mapScale = (MINIMAP - 16) / Max(maxX - mapMinX, maxZ - mapMinZ)
	; Centre the shorter side.
	mapMinX = mapMinX - ((MINIMAP - 16) / mapScale - (maxX - mapMinX)) / 2
	mapMinZ = mapMinZ - ((MINIMAP - 16) / mapScale - (maxZ - mapMinZ)) / 2

	If minimapImage <> 0 Then FreeImage minimapImage
	minimapImage = CreateImage(MINIMAP, MINIMAP)
	SetBuffer ImageBuffer(minimapImage)
	ClsColor 0, 0, 0
	Cls
	Local dx, dy, x1, y1, x2, y2
	For i = 0 To slices - 2
		If Not sGap(i)
			x1 = MapX(sX(i)) : y1 = MapY(sZ(i)) : x2 = MapX(sX(i + 1)) : y2 = MapY(sZ(i + 1))
			Color 20, 30, 50
			For dx = -2 To 2
				For dy = -2 To 2
					Line x1 + dx, y1 + dy, x2 + dx, y2 + dy
				Next
			Next
		EndIf
	Next
	For i = 0 To slices - 2
		If Not sGap(i)
			x1 = MapX(sX(i)) : y1 = MapY(sZ(i)) : x2 = MapX(sX(i + 1)) : y2 = MapY(sZ(i + 1))
			Color 220, 225, 235
			For dx = -1 To 1
				Line x1 + dx, y1, x2 + dx, y2
				Line x1, y1 + dx, x2, y2 + dx
			Next
		EndIf
	Next
	Color 60, 140, 255
	For i = 0 To gates - 2
		Rect MapX(sX(gateSlice(i))) - 2, MapY(sZ(gateSlice(i))) - 2, 5, 5, 1
	Next
	Color 255, 255, 255
	Rect MapX(sX(START_SLICE)) - 3, MapY(sZ(START_SLICE)) - 3, 7, 7, 1
	Color 255, 200, 60
	Rect MapX(sX(gateSlice(gates - 1))) - 3, MapY(sZ(gateSlice(gates - 1))) - 3, 7, 7, 1
	SetBuffer BackBuffer()
End Function

Function DrawResults()
	DrawTitle(trackNames(setupTrack), 110)
	SetFont bigFont
	Color 20, 30, 60
	Text SCREEN_W / 2 + 4, 214, TimeText(finishFrames), True, True
	Color 255, 255, 255
	Text SCREEN_W / 2, 210, TimeText(finishFrames), True, True
	SetFont hudFont
	Local medal = MedalFor(setupTrack, finishFrames)
	Select medal
		Case 3 : Color 255, 210, 60
		Case 2 : Color 210, 215, 230
		Case 1 : Color 220, 140, 80
		Default : Color 200, 200, 210
	End Select
	If medal > 0 Then Text SCREEN_W / 2, 280, medalNames(medal) + " medal", True, True Else Text SCREEN_W / 2, 280, "No medal yet", True, True
	SetFont 0
	If newBest
		If oldBest > 0
			SmallText(SCREEN_W / 2, 320, "New best time, " + SplitText(finishFrames - oldBest) + ". The ghost is saved.")
		Else
			SmallText(SCREEN_W / 2, 320, "Your first time on this track. The ghost is saved.")
		EndIf
	Else
		SmallText(SCREEN_W / 2, 320, "Best time " + TimeText(oldBest) + ", this run " + SplitText(finishFrames - oldBest) + ".")
	EndIf
	If respawns = 1 Then SmallText(SCREEN_W / 2, 346, "1 trip back to a checkpoint")
	If respawns > 1 Then SmallText(SCREEN_W / 2, 346, respawns + " trips back to a checkpoint")
End Function

; A time in updates as minutes, seconds and hundredths.
Function TimeText$(updates)
	Local hundredths = updates * 100 / 60
	Local seconds = hundredths / 100, minutes = seconds / 60
	Return minutes + ":" + Right("0" + (seconds Mod 60), 2) + "." + Right("0" + (hundredths Mod 100), 2)
End Function

; A difference in updates as seconds with a sign: -0.42 is ahead.
Function SplitText$(updates)
	Local sign$ = "+"
	If updates < 0 Then sign = "-" : updates = -updates
	Local hundredths = updates * 100 / 60
	Return sign + (hundredths / 100) + "." + Right("0" + (hundredths Mod 100), 2)
End Function

Function ShadowText(x, y, text$, centred)
	Color 10, 20, 40
	Text x + 2, y + 2, text, centred
	Color 255, 255, 255
	Text x, y, text, centred
End Function

Function SmallText(x, y, text$)
	SetFont smallFont
	Color 10, 20, 40
	Text x + 1, y + 1, text, True, True
	Color 235, 240, 250
	Text x, y, text, True, True
	SetFont 0
End Function

Function DrawBig(text$, y)
	SetFont bigFont
	Color 20, 30, 60
	Text SCREEN_W / 2 + 4, y + 4, text, True, True
	Color 255, 220, 90
	Text SCREEN_W / 2, y, text, True, True
	SetFont 0
End Function

; Darkens the picture behind a menu, so the text is easy to read: a dark rectangle drawn with every other pixel.
Function ShadeScreen()
	If shadeImage = 0
		shadeImage = CreateImage(SCREEN_W, SCREEN_H)
		Local buffer = ImageBuffer(shadeImage), x, y
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				If (x + y) Mod 2 = 0 Then WritePixelFast x, y, $101828, buffer Else WritePixelFast x, y, 0, buffer
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage shadeImage, 0, 0
End Function

Function DrawTitle(text$, y)
	Local dx, dy
	SetFont titleFont
	Color 20, 30, 60
	For dy = -3 To 3 Step 3
		For dx = -3 To 3 Step 3
			Text SCREEN_W / 2 + dx, y + dy, text, True, True
		Next
	Next
	Color 255, 235, 120
	Text SCREEN_W / 2, y, text, True, True
	SetFont 0
End Function

Function DrawMenu()
	Local i, y
	For i = 0 To menuCount - 1
		y = menuTop + i * 32
		If i = menuSelected
			Color 40, 90, 170
			Rect SCREEN_W / 2 - 200, y, 400, 28, 1
			Color 150, 200, 255
			Rect SCREEN_W / 2 - 200, y, 400, 28, 0
			Color 255, 255, 255
		Else
			Color 20, 30, 55
			Rect SCREEN_W / 2 - 200, y, 400, 28, 1
			Color 205, 215, 235
		EndIf
		SetFont menuFont
		Text SCREEN_W / 2, y + 14, menuText(i), True, True
		SetFont 0
	Next
End Function

Function DrawHelp()
	DrawTitle("How to play", 90)
	Local y = 140, i
	Restore HelpText
	Local helpLine$
	SetFont smallFont
	For i = 1 To 18
		Read helpLine
		Color 235, 240, 250
		Text 100, y, helpLine
		y = y + 20
	Next
	SetFont 0
	SmallText(SCREEN_W / 2, 530, "Press Enter or click to go back.")
End Function

; --- Watermark -------------------------------------------------------------------------------------------------------
; Every frame carries a faint pattern that nobody can see: some sky pixels are one step bluer than the rest. A program
; can find the pattern again in a screenshot, which shows that the picture came from this sample game. The pattern is
; drawn as a masked image just after Cls, so the world is drawn over it.
Global watermark, watermarkColor

Function DrawWatermark(r, g, b)
	Local rgb = (r Shl 16) Or (g Shl 8) Or b
	If watermark = 0 Or rgb <> watermarkColor
		If watermark <> 0 Then FreeImage watermark
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		watermarkColor = rgb
		Local marked = b + 1
		If b = 255 Then marked = 254
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				; Black is the mask colour, so only the marked pixels are drawn.
				If (x * 7 + y * 13) Mod 29 < 3
					WritePixelFast x, y, (r Shl 16) Or (g Shl 8) Or marked, buffer
				Else
					WritePixelFast x, y, 0, buffer
				EndIf
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function

; --- Pictures --------------------------------------------------------------------------------------------------------

Function MakeTextures()
	Local x, y, buffer, v, r, g, b

	; The road: grey asphalt with white edges and a dashed line in the middle. u runs across the road, v along it.
	roadTex = CreateTexture(128, 128)
	buffer = TextureBuffer(roadTex)
	LockBuffer buffer
	For y = 0 To 127
		For x = 0 To 127
			v = Rand(-6, 6)
			r = 88 + v : g = 90 + v : b = 96 + v
			If (x = 63 Or x = 64) And y Mod 64 < 32 Then r = 230 : g = 230 : b = 225
			If x < 6 Or x > 121
				; Red and white kerbs at the edges.
				If (y / 16) Mod 2 = 0 Then r = 220 : g = 50 : b = 45 Else r = 240 : g = 240 : b = 240
			EndIf
			WritePixelFast x, y, $FF000000 Or (r Shl 16) Or (g Shl 8) Or b, buffer
		Next
	Next
	UnlockBuffer buffer

	; The barriers: yellow and dark stripes that lean, so speed is easy to feel.
	barrierTex = CreateTexture(64, 64)
	buffer = TextureBuffer(barrierTex)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			If ((x + y) / 16) Mod 2 = 0 Then r = 245 : g = 200 : b = 40 Else r = 40 : g = 40 : b = 50
			If y < 4 Or y > 59 Then r = 230 : g = 230 : b = 230
			WritePixelFast x, y, $FF000000 Or (r Shl 16) Or (g Shl 8) Or b, buffer
		Next
	Next
	UnlockBuffer buffer

	; Grass with a few lighter patches.
	grassTex = CreateTexture(128, 128)
	buffer = TextureBuffer(grassTex)
	LockBuffer buffer
	For y = 0 To 127
		For x = 0 To 127
			v = Rand(-10, 10) + Int(8 * Sin(x * 360 / 128.0) * Cos(y * 720 / 128.0))
			WritePixelFast x, y, $FF000000 Or ((80 + v) Shl 16) Or ((150 + v) Shl 8) Or (70 + v), buffer
		Next
	Next
	UnlockBuffer buffer
	ScaleTexture grassTex, 24, 24

	; A chequered flag for the start and finish banners, and the tyres.
	checkerTex = CreateTexture(64, 64)
	buffer = TextureBuffer(checkerTex)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			If ((x / 8) + (y / 8)) Mod 2 = 0 Then WritePixelFast x, y, $FFF0F0F0, buffer Else WritePixelFast x, y, $FF181818, buffer
		Next
	Next
	UnlockBuffer buffer

	; Boost pads: orange arrows on dark ground. v grows along the track, so the tips are at the high v.
	padTex = CreateTexture(64, 64)
	buffer = TextureBuffer(padTex)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			r = 60 : g = 30 : b = 10
			If Abs((y Mod 32) - 24 + Abs(x - 31.5) * 0.6) < 5 Then r = 255 : g = 150 : b = 30
			WritePixelFast x, y, $FF000000 Or (r Shl 16) Or (g Shl 8) Or b, buffer
		Next
	Next
	UnlockBuffer buffer

	; Bark for the trees.
	barkTex = CreateTexture(32, 32)
	buffer = TextureBuffer(barkTex)
	LockBuffer buffer
	For y = 0 To 31
		For x = 0 To 31
			v = Rand(-12, 12)
			If x Mod 8 = 0 Then v = v - 20
			WritePixelFast x, y, $FF000000 Or ((110 + v) Shl 16) Or ((80 + v) Shl 8) Or (50 + v), buffer
		Next
	Next
	UnlockBuffer buffer
End Function

Function Clamp#(value#, low#, high#)
	If value < low Then Return low
	If value > high Then Return high
	Return value
End Function

; --- Sounds ----------------------------------------------------------------------------------------------------------
; A sound made sample by sample into a WAV file in a bank, written to a temporary file and loaded from there.

Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = WaveBank(samples)
	Local phase# = 0, i, t#, hz#, v#, envelope#
	For i = 0 To samples - 1
		t = Float(i) / samples
		hz = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1
			Case WAVE_SINE
				v = Sin(phase)
			Default
				v = Rnd(-1, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		envelope = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.4 Then envelope = envelope * (1.0 - t) / 0.6
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next
	Return SoundFromBank(bank, False)
End Function

; The engine: a growl that loops without a click, because it holds a whole number of waves. Its pitch follows the
; speed while driving.
Function MakeEngineSound()
	Local rate = 22050, samples = 22050 / 2
	Local bank = WaveBank(samples)
	Local i, t#, v#
	For i = 0 To samples - 1
		t = Float(i) / rate
		; 90, 180 and 270 waves a second fit exactly into half a second, and so does the rumble.
		v = Sin(t * 360 * 90) * 0.5 + Sin(t * 360 * 180) * 0.3 + Sin(t * 360 * 270) * 0.15
		If Sin(t * 360 * 90) > 0.7 Then v = v + 0.2 ; A harder edge, like cylinders firing.
		v = v * (0.75 + 0.25 * Sin(t * 360 * 14))
		PokeShort bank, 44 + i * 2, Int(v * 0.45 * 32000) And $FFFF
	Next
	Return SoundFromBank(bank, True)
End Function

; A bank with a WAV header for 16-bit mono sound at 22050 samples a second; the samples go after byte 44.
Function WaveBank(samples)
	Local bank = CreateBank(44 + samples * 2)
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, 22050
	PokeInt bank, 28, 22050 * 2 ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2
	Return bank
End Function

Function SoundFromBank(bank, looping)
	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "ghost-run-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	If sound <> 0 And looping Then LoopSound sound
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

