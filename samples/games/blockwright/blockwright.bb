; Blockwright: build anything out of blocks in a small world of hills, lakes and trees.
;
; Every picture and sound in this game is made by the code itself, so there are no files to ship with it.
;
; Controls:
;   Mouse                   look around
;   W A S D                 walk
;   Space                   jump, or swim up in water; fly up while flying
;   Left Shift              fly down while flying
;   F                       start or stop flying
;   Left mouse button       take away the block you look at
;   Right mouse button      put the chosen block against the side you look at
;   Mouse wheel, 1 to 9, 0  choose a block
;   Escape                  the pause menu
;   Menus                   Up/Down or the mouse choose, Enter/Space or a click select, Left/Right change an option
;
; The world is a grid of 64 x 32 x 64 blocks. It is drawn as 32 meshes, one for each "chunk" of 16 x 16 x 16
; blocks, and a mesh only has the sides of blocks that touch air, water or glass, since the other sides can never be
; seen. Changing a block builds only its chunk again (and its neighbour, when the block is at the edge).
;
; The world is saved in blockwright.world next to the program when you go back to the menu or quit, and the options
; in blockwright.cfg.

Include "<keys.bb>"
Include "<mouse.bb>"
Include "<graphics.bb>"
Include "<texture.bb>"
Include "<entity.bb>"

Const SCREEN_W = 800, SCREEN_H = 600

; --- The world -------------------------------------------------------------------------------------------------------
Const WORLD_X = 64, WORLD_Y = 32, WORLD_Z = 64
Const CHUNK = 16
Const CHUNKS_X = WORLD_X / CHUNK, CHUNKS_Y = WORLD_Y / CHUNK, CHUNKS_Z = WORLD_Z / CHUNK
Const CHUNK_COUNT = CHUNKS_X * CHUNKS_Y * CHUNKS_Z
Const SEA_LEVEL = 9

; The kinds of blocks. 0 is air.
Const B_AIR = 0, B_GRASS = 1, B_DIRT = 2, B_STONE = 3, B_COBBLE = 4, B_SAND = 5, B_LOG = 6, B_PLANKS = 7
Const B_LEAVES = 8, B_BRICK = 9, B_GLASS = 10, B_LAMP = 11, B_SNOW = 12, B_WATER = 13
Const BLOCK_KINDS = 14

Const STATE_MENU = 0, STATE_OPTIONS = 1, STATE_HELP = 2, STATE_CONFIRM = 3, STATE_PLAY = 4, STATE_PAUSED = 5

; The blocks are kept in a bank, one byte each. Index = (y * WORLD_Z + z) * WORLD_X + x.
Global world = CreateBank(WORLD_X * WORLD_Y * WORLD_Z)
Global worldSeed

; What each kind of block looks like: the tile of the texture for its top, bottom and sides, and its name.
Dim tileTop(BLOCK_KINDS - 1), tileBottom(BLOCK_KINDS - 1), tileSide(BLOCK_KINDS - 1), blockName$(BLOCK_KINDS - 1)
Restore BlockKinds
Local i
For i = 1 To BLOCK_KINDS - 1
	Read blockName(i), tileTop(i), tileBottom(i), tileSide(i)
Next

; The blocks the player can build with, in the order of the bar at the bottom of the screen.
Const BAR_SLOTS = 13
Dim barBlock(BAR_SLOTS - 1)
Restore PaletteOrder
For i = 0 To BAR_SLOTS - 1
	Read barBlock(i)
Next

; The six sides of a block: four corners each (bottom left, top left, top right, bottom right, seen from outside),
; the direction it faces, and how bright it is drawn. Light from above makes tops bright and bottoms dark.
Dim sideCorner#(5, 3, 2), sideDir(5, 2), sideLight#(5)
Restore BlockSides
Local s, c
For s = 0 To 5
	Read sideDir(s, 0), sideDir(s, 1), sideDir(s, 2), sideLight(s)
	For c = 0 To 3
		Read sideCorner(s, c, 0), sideCorner(s, c, 1), sideCorner(s, c, 2)
	Next
Next

; --- Options ---------------------------------------------------------------------------------------------------------
Global optSensitivity = 5    ; 1 to 10.
Global optInvert = False
Global optView = 1           ; 0 near, 1 middle, 2 far.
Global optFov = 1            ; 0 narrow, 1 normal, 2 wide.
Global optVolume = 4         ; 0 to 4, in quarters.
Global optFullscreen = False
Dim viewName$(2), viewDistance#(2), fovName$(2), fovZoom#(2)
viewName(0) = "Near" : viewDistance(0) = 32
viewName(1) = "Middle" : viewDistance(1) = 52
viewName(2) = "Far" : viewDistance(2) = 80
fovName(0) = "Narrow" : fovZoom(0) = 1.25
fovName(1) = "Normal" : fovZoom(1) = 1.0
fovName(2) = "Wide" : fovZoom(2) = 0.78

Global folder$ = SystemProperty$("appdir")
If folder <> "" And Right(folder, 1) <> "\" And Right(folder, 1) <> "/" Then folder = folder + "/"
Global settingsPath$ = folder + "blockwright.cfg"
Global worldPath$ = folder + "blockwright.world"
LoadSettings()

; --- The player ------------------------------------------------------------------------------------------------------
; The position is the middle of the feet. The player is a box 0.6 wide and 1.75 high, with the eyes at 1.6.
Const PLAYER_HALF# = 0.3, PLAYER_HEIGHT# = 1.75, EYE_HEIGHT# = 1.6, REACH# = 6.0
Global playerX#, playerY#, playerZ#, velocityY#, yaw#, pitch#, onGround, flying, inWater
Global chosen = 0            ; The place in the palette of the block to build with.

; What the player looks at, found by LookAt: the block, and the empty place in front of the side that was hit.
Global lookHit, lookX, lookY, lookZ, placeX, placeY, placeZ

; --- Game ------------------------------------------------------------------------------------------------------------
Global state = STATE_MENU, frame, menuAngle#
Dim menuText$(7)
Global menuCount, menuSelected, menuTop
Global messageText$, messageTimer
Global optionsFromPause    ; Whether the options were opened from the pause menu, which they then go back to.

; Entities and textures. OpenScreen makes them, and makes them again when the screen opens in another mode.
Global camera, sun, atlas, outline, worldPivot, menuTarget
Dim chunkMesh(CHUNK_COUNT - 1), chunkWater(CHUNK_COUNT - 1)
Dim icon(BLOCK_KINDS - 1)
Dim tilePixel(15, 255) ; The colours of the 16 tiles of 16 x 16 pixels, made once.
MakeTiles()

If Not LoadWorld() Then NewWorld(MilliSecs())
OpenScreen()

Const WAVE_SQUARE = 0, WAVE_SINE = 1, WAVE_NOISE = 2
Global soundBreak = MakeSound(320, 90, 140, WAVE_NOISE, 0.3)
Global soundPlace = MakeSound(300, 520, 90, WAVE_SINE, 0.35)
Global soundClick = MakeSound(900, 900, 25, WAVE_SQUARE, 0.08)
Global soundSplash = MakeSound(500, 200, 260, WAVE_NOISE, 0.15)

Local timer = CreateTimer(60)
GoToMenu()
Local quit = False
While Not quit
	WaitTimer timer
	frame = frame + 1
	If messageTimer > 0 Then messageTimer = messageTimer - 1

	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_HELP
			UpdateMenuCamera()
			If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Or MouseHit(BB_MOUSE_LEFT) Then GoToMenu() : menuSelected = 3
		Case STATE_CONFIRM
			UpdateConfirm()
		Case STATE_PLAY
			UpdatePlayer()
			UpdateBuilding()
			If KeyHit(BB_KEY_ESCAPE) Then GoToPause()
		Case STATE_PAUSED
			quit = UpdatePause()
	End Select

	DrawGame()
	Flip
Wend

SaveWorld()
SaveSettings()
End

; --- Screen and settings ---------------------------------------------------------------------------------------------

; Opens the window or full screen, as the option says. Graphics3D frees every entity and texture, so the camera, the
; texture and all the chunk meshes are made again here. The world itself is in a bank, which stays.
Function OpenScreen()
	If optFullscreen Then Graphics3D SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_FULLSCREEN Else Graphics3D SCREEN_W, SCREEN_H, 0, BB_GRAPHICS_WINDOWED
	AppTitle "Blockwright"
	SetBuffer BackBuffer()

	worldPivot = CreatePivot()
	menuTarget = CreatePivot() ; What the camera circles around behind the menus: the middle of the world.
	PositionEntity menuTarget, WORLD_X / 2, 10, WORLD_Z / 2
	camera = CreateCamera()
	CameraRange camera, 0.05, 200
	CameraFogMode camera, 1
	; The sky is drawn by Cls before RenderWorld (with the watermark on it), so the camera only clears depth.
	CameraClsMode camera, False, True
	ApplyViewOptions()

	sun = CreateLight()
	RotateEntity sun, 50, 30, 0
	AmbientLight 120, 120, 130

	MakeAtlas()
	MakeIcons()
	outline = MakeOutline()

	Local i
	For i = 0 To CHUNK_COUNT - 1
		chunkMesh(i) = 0
		chunkWater(i) = 0
		BuildChunk(i)
	Next
	watermark = 0
End Function

Function ApplyViewOptions()
	If state = STATE_PLAY Or state = STATE_PAUSED Or optionsFromPause
		CameraFogRange camera, viewDistance(optView) * 0.45, viewDistance(optView)
	Else
		CameraFogRange camera, 90, 160 ; Behind the menus the camera is far away, and should see the whole world.
	EndIf
	CameraFogColor camera, 150, 196, 236
	CameraZoom camera, fovZoom(optFov)
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	If ReadInt(file) = 1 ; A version number, so a changed file format can be recognised later.
		optSensitivity = ReadInt(file)
		optInvert = ReadInt(file)
		optView = ReadInt(file)
		optFov = ReadInt(file)
		optVolume = ReadInt(file)
		optFullscreen = ReadInt(file)
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optSensitivity < 1 Or optSensitivity > 10 Then optSensitivity = 5
	If optView < 0 Or optView > 2 Then optView = 1
	If optFov < 0 Or optFov > 2 Then optFov = 1
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets the options.
	WriteInt file, 1
	WriteInt file, optSensitivity
	WriteInt file, optInvert
	WriteInt file, optView
	WriteInt file, optFov
	WriteInt file, optVolume
	WriteInt file, optFullscreen
	CloseFile file
End Function

; Every sound goes through here, so the volume option works everywhere.
Function PlaySfx(sound)
	If sound = 0 Or optVolume = 0 Then Return
	Local channel = PlaySound(sound)
	ChannelVolume channel, optVolume / 4.0
End Function

Function ShowMessage(text$)
	messageText = text
	messageTimer = 150
End Function

; --- The world -------------------------------------------------------------------------------------------------------

; The block at a place. Outside the world there is air, and below it solid stone, so nobody falls out of the world.
Function BlockAt(x, y, z)
	If y < 0 Then Return B_STONE
	If x < 0 Or z < 0 Or x >= WORLD_X Or y >= WORLD_Y Or z >= WORLD_Z Then Return B_AIR
	Return PeekByte(world, (y * WORLD_Z + z) * WORLD_X + x)
End Function

Function SetBlock(x, y, z, kind)
	If x < 0 Or y < 0 Or z < 0 Or x >= WORLD_X Or y >= WORLD_Y Or z >= WORLD_Z Then Return
	PokeByte world, (y * WORLD_Z + z) * WORLD_X + x, kind
End Function

; Blocks you can stand on and cannot walk through. Water is neither.
Function IsSolid(kind)
	Return kind <> B_AIR And kind <> B_WATER
End Function

; Blocks you can see through, so the sides of their neighbours must be drawn.
Function IsSeeThrough(kind)
	Return kind = B_AIR Or kind = B_WATER Or kind = B_GLASS Or kind = B_LEAVES
End Function

; A new world from a seed: rolling hills from smooth noise, sand at the water, snow on the tops, stone underneath,
; and trees on the grass.
Function NewWorld(seed)
	worldSeed = seed
	Local x, y, z, height, kind
	For z = 0 To WORLD_Z - 1
		For x = 0 To WORLD_X - 1
			height = Int(4 + SmoothNoise(Float(x), Float(z), 18.0, seed) * 16 + SmoothNoise(Float(x), Float(z), 6.0, seed + 7) * 5)
			If height < 2 Then height = 2
			If height > WORLD_Y - 8 Then height = WORLD_Y - 8
			For y = 0 To WORLD_Y - 1
				kind = B_AIR
				If y < height - 3
					kind = B_STONE
				ElseIf y < height
					kind = B_DIRT
				ElseIf y = height
					If height <= SEA_LEVEL + 1
						kind = B_SAND
					ElseIf height >= 19
						kind = B_SNOW
					Else
						kind = B_GRASS
					EndIf
				ElseIf y <= SEA_LEVEL
					kind = B_WATER
				EndIf
				SetBlock(x, y, z, kind)
			Next
		Next
	Next

	; Trees, never too close to the edge or to each other.
	Local tries, tx, tz, top
	For tries = 1 To 90
		tx = 3 + Int(Hash(tries, 1, seed) * (WORLD_X - 6))
		tz = 3 + Int(Hash(tries, 2, seed) * (WORLD_Z - 6))
		top = SurfaceHeight(tx, tz)
		If BlockAt(tx, top, tz) = B_GRASS And TreeRoom(tx, top, tz) Then GrowTree(tx, top + 1, tz, 4 + Int(Hash(tries, 3, seed) * 2))
	Next

	; The player starts on dry ground as near to the middle as there is some: look in growing squares around it.
	Local radius, dx, dz, found = False
	For radius = 0 To WORLD_X / 2 - 1
		For dz = -radius To radius
			For dx = -radius To radius
				If (Abs(dx) = radius Or Abs(dz) = radius) And (Not found)
					tx = WORLD_X / 2 + dx : tz = WORLD_Z / 2 + dz
					top = SurfaceHeight(tx, tz)
					kind = BlockAt(tx, top, tz)
					If top > SEA_LEVEL And (kind = B_GRASS Or kind = B_SAND Or kind = B_SNOW) Then found = True
				EndIf
			Next
		Next
		If found Then Exit
	Next
	If Not found Then tx = WORLD_X / 2 : tz = WORLD_Z / 2 : top = SurfaceHeight(tx, tz)
	playerX = tx + 0.5
	playerZ = tz + 0.5
	playerY = Float(top + 1)
	velocityY = 0 : yaw = 0 : pitch = 10 : flying = False
End Function

; The height of the highest block that is not air at (x, z).
Function SurfaceHeight(x, z)
	Local y
	For y = WORLD_Y - 1 To 0 Step -1
		If BlockAt(x, y, z) <> B_AIR Then Return y
	Next
	Return 0
End Function

Function TreeRoom(x, y, z)
	Local dx, dz
	For dz = -2 To 2
		For dx = -2 To 2
			If BlockAt(x + dx, y + 1, z + dz) <> B_AIR Then Return False
		Next
	Next
	Return y + 8 < WORLD_Y
End Function

Function GrowTree(x, y, z, height)
	Local dx, dy, dz, i
	For dy = height - 2 To height + 1
		For dz = -2 To 2
			For dx = -2 To 2
				; A round crown: fewer leaves at the top and the corners.
				If dx * dx + dz * dz + (dy - height + 1) * (dy - height + 1) * 2 <= 6
					If BlockAt(x + dx, y + dy, z + dz) = B_AIR Then SetBlock(x + dx, y + dy, z + dz, B_LEAVES)
				EndIf
			Next
		Next
	Next
	For i = 0 To height - 1
		SetBlock(x, y + i, z, B_LOG)
	Next
End Function

; A number from 0 to 1 for each corner of a grid, always the same for the same corner and seed.
Function Hash#(x, z, seed)
	Local h = x * 374761393 + z * 668265263 + seed * 982451653
	h = (h Xor (h Shr 13)) * 1274126177
	h = h Xor (h Shr 16)
	Return (h And $FFFF) / 65535.0
End Function

; Smooth noise: the Hash of the four grid corners around (x, z), blended with a soft curve. "size" is how far apart
; the corners are, so a bigger size gives wider hills.
Function SmoothNoise#(x#, z#, size#, seed)
	Local gx# = x / size, gz# = z / size
	Local ix = Int(Floor(gx)), iz = Int(Floor(gz))
	Local fx# = gx - ix, fz# = gz - iz
	fx = fx * fx * (3 - 2 * fx)
	fz = fz * fz * (3 - 2 * fz)
	Local a# = Hash(ix, iz, seed), b# = Hash(ix + 1, iz, seed)
	Local c# = Hash(ix, iz + 1, seed), d# = Hash(ix + 1, iz + 1, seed)
	Return (a + (b - a) * fx) + ((c + (d - c) * fx) - (a + (b - a) * fx)) * fz
End Function

; The world file: a name and version, the seed, the player, then every block.
Function SaveWorld()
	Local file = WriteFile(worldPath)
	If Not file Then Return
	WriteInt file, $31575842 ; "BXW1"
	WriteInt file, WORLD_X : WriteInt file, WORLD_Y : WriteInt file, WORLD_Z
	WriteInt file, worldSeed
	WriteFloat file, playerX : WriteFloat file, playerY : WriteFloat file, playerZ
	WriteFloat file, yaw : WriteFloat file, pitch
	WriteByte file, flying
	WriteByte file, chosen
	WriteBytes world, file, 0, BankSize(world)
	CloseFile file
End Function

Function LoadWorld()
	If FileType(worldPath) <> 1 Then Return False
	Local file = ReadFile(worldPath)
	If Not file Then Return False
	Local ok = ReadInt(file) = $31575842
	If ok Then ok = ReadInt(file) = WORLD_X And ReadInt(file) = WORLD_Y And ReadInt(file) = WORLD_Z
	If ok
		worldSeed = ReadInt(file)
		playerX = ReadFloat(file) : playerY = ReadFloat(file) : playerZ = ReadFloat(file)
		yaw = ReadFloat(file) : pitch = ReadFloat(file)
		flying = ReadByte(file)
		chosen = ReadByte(file)
		ok = ReadBytes(world, file, 0, BankSize(world)) = BankSize(world)
	EndIf
	CloseFile file
	If chosen < 0 Or chosen >= BAR_SLOTS Then chosen = 0
	; A broken file: start a fresh world instead.
	Local i
	If ok
		For i = 0 To BankSize(world) - 1
			If PeekByte(world, i) >= BLOCK_KINDS Then ok = False : Exit
		Next
	EndIf
	Return ok
End Function

; --- Chunk meshes ----------------------------------------------------------------------------------------------------

; Builds the meshes of one chunk: one for the solid blocks, and one for the water, which is see-through and so must be
; drawn after everything behind it.
Function BuildChunk(index)
	Local cx = index Mod CHUNKS_X, cy = (index / CHUNKS_X) Mod CHUNKS_Y, cz = index / (CHUNKS_X * CHUNKS_Y)
	Local mesh = chunkMesh(index), water = chunkWater(index), surface, waterSurface
	If mesh = 0
		mesh = CreateMesh(worldPivot)
		surface = CreateSurface(mesh)
		EntityTexture mesh, atlas
		EntityFX mesh, BB_FX_FULLBRIGHT + BB_FX_VERTEX_COLORS ; Light comes from the vertex colours, worked out here.
		chunkMesh(index) = mesh
		water = CreateMesh(worldPivot)
		waterSurface = CreateSurface(water)
		EntityTexture water, atlas
		EntityFX water, BB_FX_FULLBRIGHT + BB_FX_VERTEX_COLORS + BB_FX_TWO_SIDED ; Both sides, so the water surface is seen from below too.
		EntityAlpha water, 0.7
		chunkWater(index) = water
	Else
		surface = GetSurface(mesh, 1)
		waterSurface = GetSurface(water, 1)
		ClearSurface surface
		ClearSurface waterSurface
	EndIf

	Local x, y, z, kind, s, neighbour
	For y = cy * CHUNK To cy * CHUNK + CHUNK - 1
		For z = cz * CHUNK To cz * CHUNK + CHUNK - 1
			For x = cx * CHUNK To cx * CHUNK + CHUNK - 1
				kind = BlockAt(x, y, z)
				If kind = B_WATER
					; Water only shows where it meets air.
					For s = 0 To 5
						If BlockAt(x + sideDir(s, 0), y + sideDir(s, 1), z + sideDir(s, 2)) = B_AIR Then AddSide(waterSurface, x, y, z, s, kind)
					Next
				ElseIf kind <> B_AIR
					For s = 0 To 5
						neighbour = BlockAt(x + sideDir(s, 0), y + sideDir(s, 1), z + sideDir(s, 2))
						; A side is seen when the neighbour can be seen through, but not between two blocks of glass.
						If IsSeeThrough(neighbour) And neighbour <> kind Then AddSide(surface, x, y, z, s, kind)
					Next
				EndIf
			Next
		Next
	Next
End Function

; Adds one side of a block as two triangles. Corners next to solid blocks are drawn darker, a cheap "ambient
; occlusion" that makes the edges and corners of the world easy to see.
Function AddSide(surface, x, y, z, s, kind)
	Local tile
	If s = 0
		tile = tileTop(kind)
	ElseIf s = 1
		tile = tileBottom(kind)
	Else
		tile = tileSide(kind)
	EndIf
	; The tile's place in the 4 x 4 texture, kept half a pixel inside so that its neighbours never bleed in.
	Local u0# = (tile Mod 4) * 0.25 + 0.5 / 64, v0# = (tile / 4) * 0.25 + 0.5 / 64, size# = 0.25 - 1.0 / 64
	Local base = CountVertices(surface), c, light#, cornerX#, cornerY#, cornerZ#, u#, v#
	Local lowered# = 0
	If kind = B_WATER And s = 0 Then lowered = 0.12 ; The water surface sits a little below the top of its block.
	For c = 0 To 3
		cornerX = sideCorner(s, c, 0) : cornerY = sideCorner(s, c, 1) : cornerZ = sideCorner(s, c, 2)
		If c = 0 Or c = 3 Then v = v0 + size Else v = v0
		If c = 2 Or c = 3 Then u = u0 + size Else u = u0
		light = sideLight(s)
		If kind = B_LAMP Then light = 1.15 Else light = light * CornerShade#(x, y, z, s, cornerX, cornerY, cornerZ)
		AddVertex surface, x + cornerX, y + cornerY - lowered * cornerY, z + cornerZ, u, v
		VertexColor surface, base + c, Min(255, 255 * light), Min(255, 255 * light), Min(255, 255 * light)
	Next
	AddTriangle surface, base, base + 1, base + 2
	AddTriangle surface, base, base + 2, base + 3
End Function

; How much light reaches a corner of a side: count the solid blocks around the corner, just outside the side.
Function CornerShade#(x, y, z, s, cornerX#, cornerY#, cornerZ#)
	; The block just outside the side, and the two that touch the corner along the side.
	Local ox = x + sideDir(s, 0), oy = y + sideDir(s, 1), oz = z + sideDir(s, 2)
	Local ax, ay, az, bx, by, bz
	If sideDir(s, 0) <> 0
		ay = Int(cornerY) * 2 - 1 : bz = Int(cornerZ) * 2 - 1
	ElseIf sideDir(s, 1) <> 0
		ax = Int(cornerX) * 2 - 1 : bz = Int(cornerZ) * 2 - 1
	Else
		ax = Int(cornerX) * 2 - 1 : by = Int(cornerY) * 2 - 1
	EndIf
	Local count = 0
	If IsSolid(BlockAt(ox + ax, oy + ay, oz + az)) And BlockAt(ox + ax, oy + ay, oz + az) <> B_GLASS Then count = count + 1
	If IsSolid(BlockAt(ox + bx, oy + by, oz + bz)) And BlockAt(ox + bx, oy + by, oz + bz) <> B_GLASS Then count = count + 1
	If IsSolid(BlockAt(ox + ax + bx, oy + ay + by, oz + az + bz)) And BlockAt(ox + ax + bx, oy + ay + by, oz + az + bz) <> B_GLASS Then count = count + 1
	Return 1.0 - count * 0.16
End Function

; After a block changed: build its chunk again, and the chunk next to it when the block is on the edge, because the
; neighbour's sides may now show or hide.
Function BlockChanged(x, y, z)
	Local dx, dy, dz
	RebuildChunkAt(x, y, z)
	For dx = -1 To 1 Step 2
		If Int((x + dx) / CHUNK) <> Int(x / CHUNK) Then RebuildChunkAt(x + dx, y, z)
	Next
	For dy = -1 To 1 Step 2
		If Int((y + dy) / CHUNK) <> Int(y / CHUNK) Then RebuildChunkAt(x, y + dy, z)
	Next
	For dz = -1 To 1 Step 2
		If Int((z + dz) / CHUNK) <> Int(z / CHUNK) Then RebuildChunkAt(x, y, z + dz)
	Next
End Function

Function RebuildChunkAt(x, y, z)
	If x < 0 Or y < 0 Or z < 0 Or x >= WORLD_X Or y >= WORLD_Y Or z >= WORLD_Z Then Return
	BuildChunk((z / CHUNK * CHUNKS_Y + y / CHUNK) * CHUNKS_X + x / CHUNK)
End Function

; The thin frame around the block the player looks at: twelve slim boxes along the edges of a cube.
Function MakeOutline()
	Local mesh = CreateMesh(), surface = CreateSurface(mesh), e, t# = 0.02
	For e = 0 To 11
		Local axis = e / 4, a# = (e Mod 2) * 1.0, b# = ((e / 2) Mod 2) * 1.0
		Select axis
			Case 0 : AddBox(surface, -t, a - t, b - t, 1 + t, a + t, b + t)
			Case 1 : AddBox(surface, a - t, -t, b - t, a + t, 1 + t, b + t)
			Case 2 : AddBox(surface, a - t, b - t, -t, a + t, b + t, 1 + t)
		End Select
	Next
	EntityColor mesh, 20, 20, 20
	EntityFX mesh, BB_FX_FULLBRIGHT
	HideEntity mesh
	Return mesh
End Function

; A box from (x1, y1, z1) to (x2, y2, z2), made from the corners of the sides of a block.
Function AddBox(surface, x1#, y1#, z1#, x2#, y2#, z2#)
	Local s, c, base
	For s = 0 To 5
		base = CountVertices(surface)
		For c = 0 To 3
			AddVertex surface, x1 + (x2 - x1) * sideCorner(s, c, 0), y1 + (y2 - y1) * sideCorner(s, c, 1), z1 + (z2 - z1) * sideCorner(s, c, 2)
		Next
		AddTriangle surface, base, base + 1, base + 2
		AddTriangle surface, base, base + 2, base + 3
	Next
End Function

; --- Looking at blocks -----------------------------------------------------------------------------------------------

; Walks along the line of sight from block to block (a "DDA" walk: always step into the next block that the line
; enters first) until it finds a block that is not air or water, or REACH is used up.
Function LookAt()
	Local ox# = EntityX(camera, True), oy# = EntityY(camera, True), oz# = EntityZ(camera, True)
	TFormVector 0, 0, 1, camera, 0
	Local dx# = TFormedX(), dy# = TFormedY(), dz# = TFormedZ()
	Local x = Int(Floor(ox)), y = Int(Floor(oy)), z = Int(Floor(oz))
	Local stepX = Int(Sgn(dx)), stepY = Int(Sgn(dy)), stepZ = Int(Sgn(dz))
	; How far along the line one whole block is in each direction, and how far to the first border.
	Local deltaX# = 1000000, deltaY# = 1000000, deltaZ# = 1000000
	If dx <> 0 Then deltaX = Abs(1 / dx)
	If dy <> 0 Then deltaY = Abs(1 / dy)
	If dz <> 0 Then deltaZ = Abs(1 / dz)
	Local nextX# = deltaX * 1000000, nextY# = deltaY * 1000000, nextZ# = deltaZ * 1000000
	If dx > 0 Then nextX = (x + 1 - ox) * deltaX
	If dx < 0 Then nextX = (ox - x) * deltaX
	If dy > 0 Then nextY = (y + 1 - oy) * deltaY
	If dy < 0 Then nextY = (oy - y) * deltaY
	If dz > 0 Then nextZ = (z + 1 - oz) * deltaZ
	If dz < 0 Then nextZ = (oz - z) * deltaZ

	Local travelled# = 0, kind
	lookHit = False
	While travelled <= REACH
		placeX = x : placeY = y : placeZ = z
		If nextX < nextY And nextX < nextZ
			x = x + stepX : travelled = nextX : nextX = nextX + deltaX
		ElseIf nextY < nextZ
			y = y + stepY : travelled = nextY : nextY = nextY + deltaY
		Else
			z = z + stepZ : travelled = nextZ : nextZ = nextZ + deltaZ
		EndIf
		If travelled > REACH Then Exit
		kind = BlockAt(x, y, z)
		If y < 0 Then Exit
		If kind <> B_AIR And kind <> B_WATER
			lookHit = True
			lookX = x : lookY = y : lookZ = z
			Exit
		EndIf
	Wend
End Function

; --- The player ------------------------------------------------------------------------------------------------------

Function UpdatePlayer()
	; Looking: the mouse turns the view, and is put back into the middle of the screen every frame.
	Local turn# = optSensitivity * 0.045
	yaw = yaw - MouseXSpeed() * turn
	If optInvert Then pitch = pitch - MouseYSpeed() * turn Else pitch = pitch + MouseYSpeed() * turn
	If pitch > 89 Then pitch = 89
	If pitch < -89 Then pitch = -89
	MoveMouse SCREEN_W / 2, SCREEN_H / 2

	If KeyHit(BB_KEY_F)
		flying = Not flying
		velocityY = 0
		If flying Then ShowMessage("Flying: Space goes up, Shift goes down. F to land.") Else ShowMessage("Walking.")
	EndIf
	; Choosing a block: the wheel or the number keys.
	Local wheel = MouseZSpeed(), k
	If wheel <> 0 Then chosen = (chosen - Sgn(wheel) + BAR_SLOTS) Mod BAR_SLOTS : PlaySfx(soundClick)
	For k = 0 To 9
		If KeyHit(BB_KEY_1 + k) And k < BAR_SLOTS Then chosen = k : PlaySfx(soundClick)
	Next

	; Walking: W and S along the view, A and D to the side, in the flat plane whatever the pitch is.
	Local forward# = Float(KeyDown(BB_KEY_W) - KeyDown(BB_KEY_S)), sideways# = Float(KeyDown(BB_KEY_D) - KeyDown(BB_KEY_A))
	Local speed# = 0.075
	Local wasInWater = inWater
	inWater = BlockAt(Int(Floor(playerX)), Int(Floor(playerY + 0.4)), Int(Floor(playerZ))) = B_WATER
	If inWater And (Not wasInWater) And velocityY < -0.15 Then PlaySfx(soundSplash)
	If flying Then speed = 0.16
	If inWater And (Not flying) Then speed = 0.045
	If forward <> 0 And sideways <> 0 Then speed = speed * 0.7071
	Local moveX# = (Sin(-yaw) * forward + Cos(yaw) * sideways) * speed
	Local moveZ# = (Cos(yaw) * forward + Sin(yaw) * sideways) * speed

	If flying
		velocityY = (KeyDown(BB_KEY_SPACE) - KeyDown(BB_KEY_LSHIFT)) * 0.14
	ElseIf inWater
		velocityY = velocityY * 0.85 - 0.004
		If KeyDown(BB_KEY_SPACE) Then velocityY = velocityY + 0.012
		If velocityY < -0.06 Then velocityY = -0.06
	Else
		velocityY = velocityY - 0.012 ; Gravity.
		If velocityY < -0.6 Then velocityY = -0.6
		If KeyDown(BB_KEY_SPACE) And onGround Then velocityY = 0.2
	EndIf

	; Move along one axis at a time, and stop at the base block in the way. Doing the axes one by one lets the
	; player slide along walls instead of sticking to them.
	MovePlayer(moveX, 0, 0)
	MovePlayer(0, 0, moveZ)
	onGround = False
	If Not MovePlayer(0, velocityY, 0)
		If velocityY < 0 Then onGround = True
		velocityY = 0
	EndIf

	; Never leave the world.
	If playerX < PLAYER_HALF Then playerX = PLAYER_HALF
	If playerZ < PLAYER_HALF Then playerZ = PLAYER_HALF
	If playerX > WORLD_X - PLAYER_HALF Then playerX = WORLD_X - PLAYER_HALF
	If playerZ > WORLD_Z - PLAYER_HALF Then playerZ = WORLD_Z - PLAYER_HALF
	If playerY > WORLD_Y + 8 Then playerY = WORLD_Y + 8

	PlaceCamera()
End Function

Function PlaceCamera()
	PositionEntity camera, playerX, playerY + EYE_HEIGHT, playerZ
	RotateEntity camera, pitch, yaw, 0
End Function

; Moves the player by (dx, dy, dz) unless the box of the player would then be inside a solid block. Gives back
; whether it moved.
Function MovePlayer(dx#, dy#, dz#)
	If dx = 0 And dy = 0 And dz = 0 Then Return True
	If BoxHitsBlocks(playerX + dx, playerY + dy, playerZ + dz) Then Return False
	playerX = playerX + dx
	playerY = playerY + dy
	playerZ = playerZ + dz
	Return True
End Function

Function BoxHitsBlocks(px#, py#, pz#)
	Local x, y, z
	For y = Int(Floor(py)) To Int(Floor(py + PLAYER_HEIGHT))
		For z = Int(Floor(pz - PLAYER_HALF)) To Int(Floor(pz + PLAYER_HALF))
			For x = Int(Floor(px - PLAYER_HALF)) To Int(Floor(px + PLAYER_HALF))
				If IsSolid(BlockAt(x, y, z)) Then Return True
			Next
		Next
	Next
	Return False
End Function

Function UpdateBuilding()
	LookAt()
	If lookHit
		PositionEntity outline, Float(lookX), Float(lookY), Float(lookZ)
		ShowEntity outline
	Else
		HideEntity outline
	EndIf

	If MouseHit(BB_MOUSE_LEFT) And lookHit
		If lookY = 0
			ShowMessage("The bottom of the world stays.")
		Else
			SetBlock(lookX, lookY, lookZ, WaterOrAir(lookX, lookY, lookZ))
			BlockChanged(lookX, lookY, lookZ)
			PlaySfx(soundBreak)
		EndIf
	EndIf
	If MouseHit(BB_MOUSE_RIGHT) And lookHit
		Local kind = barBlock(chosen)
		If placeY >= WORLD_Y
			ShowMessage("That is too high: the sky is the limit.")
		ElseIf IsSolid(kind) And BoxTouchesBlock(placeX, placeY, placeZ)
			ShowMessage("You are standing there.")
		Else
			SetBlock(placeX, placeY, placeZ, kind)
			BlockChanged(placeX, placeY, placeZ)
			PlaySfx(soundPlace)
		EndIf
	EndIf
End Function

; A block that is taken away next to water fills with water, so lakes do not get holes in them.
Function WaterOrAir(x, y, z)
	If BlockAt(x + 1, y, z) = B_WATER Or BlockAt(x - 1, y, z) = B_WATER Or BlockAt(x, y + 1, z) = B_WATER Or BlockAt(x, y, z + 1) = B_WATER Or BlockAt(x, y, z - 1) = B_WATER Then Return B_WATER
	Return B_AIR
End Function

Function BoxTouchesBlock(x, y, z)
	If playerX + PLAYER_HALF <= x Or playerX - PLAYER_HALF >= x + 1 Then Return False
	If playerZ + PLAYER_HALF <= z Or playerZ - PLAYER_HALF >= z + 1 Then Return False
	If playerY + PLAYER_HEIGHT <= y Or playerY >= y + 1 Then Return False
	Return True
End Function

; --- Menus -----------------------------------------------------------------------------------------------------------
; A menu is a list of lines and the number of the selected one. The keyboard moves the selection, the mouse selects
; the line it is over. MenuInput gives back the line chosen with Enter, Space or a click, or -1.

Function MenuInput()
	If KeyHit(BB_KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount : PlaySfx(soundClick)
	If KeyHit(BB_KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount : PlaySfx(soundClick)

	Local row = MenuLineAt(MouseX(), MouseY())
	If row >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = row

	If KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Then Return menuSelected
	If MouseHit(BB_MOUSE_LEFT) And row >= 0
		menuSelected = row
		Return row
	EndIf
	Return -1
End Function

; Which line is at a screen position, or -1. Lines are 32 pixels apart and 400 wide.
Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 200 Or x >= SCREEN_W / 2 + 200 Or y < menuTop Then Return -1
	Local row = (y - menuTop) / 32
	If row >= menuCount Then Return -1
	Return row
End Function

; Everything that opens a menu goes through here: show the mouse again and forget old keys and clicks.
Function OpenMenu(newState, count, top)
	state = newState
	menuCount = count
	menuTop = top
	menuSelected = 0
	HideEntity outline
	ShowPointer
	FlushKeys
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
	MouseZSpeed()
	ApplyViewOptions()
End Function

Function GoToMenu()
	optionsFromPause = False
	OpenMenu(STATE_MENU, 5, 300)
	menuText(0) = "Play"
	menuText(1) = "New world"
	menuText(2) = "Options"
	menuText(3) = "How to play"
	menuText(4) = "Quit"
End Function

; Gives back True when the player chose Quit.
Function UpdateMenu()
	UpdateMenuCamera()

	If KeyHit(BB_KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0 : StartPlaying()
		Case 1
			OpenMenu(STATE_CONFIRM, 2, 330)
			menuText(0) = "Yes, make a new world"
			menuText(1) = "No, keep this one"
			menuSelected = 1
		Case 2 : GoToOptions()
		Case 3 : OpenMenu(STATE_HELP, 0, 0)
		Case 4 : Return True
	End Select
	Return False
End Function

Function UpdateConfirm()
	UpdateMenuCamera()
	Local answer = MenuInput()
	If KeyHit(BB_KEY_ESCAPE) Then answer = 1
	If answer = 0
		NewWorld(MilliSecs())
		Local i
		For i = 0 To CHUNK_COUNT - 1
			BuildChunk(i)
		Next
		SaveWorld()
		StartPlaying()
		ShowMessage("A new world. Have fun building!")
	ElseIf answer = 1
		GoToMenu()
		menuSelected = 1
	EndIf
End Function

Function UpdateMenuCamera()
	menuAngle = menuAngle + 0.08
	PositionEntity camera, WORLD_X / 2 + Sin(menuAngle) * 70, 42, WORLD_Z / 2 - Cos(menuAngle) * 70
	PointEntity camera, menuTarget
End Function

Function StartPlaying()
	state = STATE_PLAY
	ApplyViewOptions()
	HidePointer
	MoveMouse SCREEN_W / 2, SCREEN_H / 2
	FlushKeys
	FlushMouse
	MouseXSpeed()
	MouseYSpeed()
	MouseZSpeed()
	PlaceCamera()
End Function

Function GoToPause()
	OpenMenu(STATE_PAUSED, 4, 280)
	menuText(0) = "Back to building"
	menuText(1) = "Save the world"
	menuText(2) = "Options"
	menuText(3) = "Save and go to the main menu"
End Function

; Gives back True when the program should end (never, the pause menu always goes somewhere else base).
Function UpdatePause()
	Select MenuInput()
		Case 0 : StartPlaying()
		Case 1
			SaveWorld()
			ShowMessage("The world is saved.")
		Case 2 : GoToOptions()
		Case 3
			SaveWorld()
			GoToMenu()
	End Select
	If KeyHit(BB_KEY_ESCAPE) And state = STATE_PAUSED Then StartPlaying()
	Return False
End Function

Function GoToOptions()
	optionsFromPause = state = STATE_PAUSED
	OpenMenu(STATE_OPTIONS, 7, 230)
	RefreshOptionsText()
End Function

Function RefreshOptionsText()
	menuText(0) = "Mouse speed: " + optSensitivity
	If optInvert Then menuText(1) = "Mouse up looks: down" Else menuText(1) = "Mouse up looks: up"
	menuText(2) = "View distance: " + viewName(optView)
	menuText(3) = "Field of view: " + fovName(optFov)
	menuText(4) = "Sound volume: " + (optVolume * 25) + "%"
	If optFullscreen Then menuText(5) = "Display: full screen" Else menuText(5) = "Display: window"
	menuText(6) = "Back"
End Function

Function UpdateOptions()
	If Not optionsFromPause Then UpdateMenuCamera()
	Local change = 0
	If KeyHit(BB_KEY_LEFT) Then change = -1
	If KeyHit(BB_KEY_RIGHT) Then change = 1
	Local picked = MenuInput()
	If picked >= 0 Then change = 1 ; Enter or a click steps to the next value.

	If KeyHit(BB_KEY_ESCAPE) Or picked = 6
		SaveSettings()
		If optionsFromPause
			GoToPause()
			menuSelected = 2
		Else
			GoToMenu()
			menuSelected = 2
		EndIf
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optSensitivity = (optSensitivity - 1 + change + 10) Mod 10 + 1
		Case 1 : optInvert = Not optInvert
		Case 2 : optView = (optView + change + 3) Mod 3
		Case 3 : optFov = (optFov + change + 3) Mod 3
		Case 4 : optVolume = (optVolume + change + 5) Mod 5
		Case 5
			optFullscreen = Not optFullscreen
			OpenScreen()
			If optionsFromPause Then PlaceCamera()
	End Select
	ApplyViewOptions()
	PlaySfx(soundClick)
	RefreshOptionsText()
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	; The sky, with the watermark in it, then the world on top. The camera only clears the depth buffer.
	ClsColor 150, 196, 236
	Cls
	DrawWatermark(150, 196, 236)
	RenderWorld

	Select state
		Case STATE_PLAY
			DrawHud()
		Case STATE_PAUSED
			DrawHud()
			ShadeScreen()
			DrawTitle("Paused", 200)
			DrawMenu()
		Case STATE_MENU
			DrawTitle("Blockwright", 170)
			DrawMenu()
		Case STATE_CONFIRM
			ShadeScreen()
			DrawTitle("Make a new world?", 220)
			Color 230, 235, 245
			SetFont helpFont
			Text SCREEN_W / 2, 280, "The world you have now is lost.", True, True
			SetFont 0
			DrawMenu()
		Case STATE_OPTIONS
			ShadeScreen()
			DrawTitle("Options", 170)
			DrawMenu()
			Color 200, 210, 230
			SetFont helpFont
			Text SCREEN_W / 2, 480, "Left/Right or a click change the selected option.", True, True
			SetFont 0
		Case STATE_HELP
			ShadeScreen()
			DrawHelp()
	End Select

	If messageTimer > 0 And state = STATE_PLAY
		SetFont helpFont
		Color 0, 0, 0
		Text SCREEN_W / 2 + 1, 41, messageText, True, True
		Color 255, 250, 220
		Text SCREEN_W / 2, 40, messageText, True, True
		SetFont 0
	EndIf
	If state <= STATE_CONFIRM
		Color 40, 50, 70
		Text SCREEN_W / 2, SCREEN_H - 24, "A BlitzLLVM sample game", True, True
	EndIf
End Function

; Darkens the picture behind a menu, so the text is easy to read: a black rectangle drawn with every other pixel.
Global shadeImage
Function ShadeScreen()
	If shadeImage = 0
		shadeImage = CreateImage(SCREEN_W, SCREEN_H)
		Local buffer = ImageBuffer(shadeImage), x, y
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				If (x + y) Mod 2 = 0 Then WritePixelFast x, y, $101820, buffer Else WritePixelFast x, y, 0, buffer
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage shadeImage, 0, 0
End Function

Function DrawTitle(text$, y)
	Local dx, dy
	SetFont titleFont
	Color 30, 40, 60
	For dy = -2 To 2 Step 2
		For dx = -2 To 2 Step 2
			Text SCREEN_W / 2 + dx, y + dy, text, True, True
		Next
	Next
	Color 255, 236, 170
	Text SCREEN_W / 2, y, text, True, True
	SetFont 0
End Function

Function DrawMenu()
	Local i, y
	For i = 0 To menuCount - 1
		y = menuTop + i * 32
		If i = menuSelected
			Color 60, 110, 60
			Rect SCREEN_W / 2 - 200, y, 400, 28, 1
			Color 160, 220, 140
			Rect SCREEN_W / 2 - 200, y, 400, 28, 0
			Color 255, 250, 220
		Else
			Color 25, 35, 50
			Rect SCREEN_W / 2 - 200, y, 400, 28, 1
			Color 210, 220, 235
		EndIf
		SetFont menuFont
		Text SCREEN_W / 2, y + 14, menuText(i), True, True
		SetFont 0
	Next
End Function

Function DrawHelp()
	DrawTitle("How to play", 110)
	Local y = 170, i
	Restore HelpText
	Local helpLine$
	SetFont helpFont
	For i = 1 To 14
		Read helpLine
		Color 230, 235, 245
		Text 130, y, helpLine
		y = y + 20
	Next
	SetFont 0
	Color 170, 190, 220
	SetFont helpFont
	Text SCREEN_W / 2, 480, "Press Enter or click to go back.", True, True
	SetFont 0
End Function

; The crosshair, the bar of blocks, and the name of the chosen one.
Function DrawHud()
	Color 255, 255, 255
	Rect SCREEN_W / 2 - 9, SCREEN_H / 2 - 1, 18, 2, 1
	Rect SCREEN_W / 2 - 1, SCREEN_H / 2 - 9, 2, 18, 1

	Local slot = 40, x0 = SCREEN_W / 2 - BAR_SLOTS * slot / 2, y0 = SCREEN_H - 52, i
	Color 20, 25, 35
	Rect x0 - 4, y0 - 4, BAR_SLOTS * slot + 8, slot + 8, 1
	For i = 0 To BAR_SLOTS - 1
		DrawImage icon(barBlock(i)), x0 + i * slot + 4, y0 + 4
		If i = chosen
			Color 255, 240, 150
			Rect x0 + i * slot, y0, slot, slot, 0
			Rect x0 + i * slot + 1, y0 + 1, slot - 2, slot - 2, 0
		EndIf
		If i < 10
			Color 220, 225, 235
			Text x0 + i * slot + 3, y0 + 1, (i + 1) Mod 10
		EndIf
	Next
	Color 0, 0, 0
	Text SCREEN_W / 2 + 1, y0 - 15, blockName(barBlock(chosen)), True, True
	Color 255, 255, 255
	Text SCREEN_W / 2, y0 - 16, blockName(barBlock(chosen)), True, True
	If flying
		Color 255, 255, 255
		Text 10, 10, "Flying"
	EndIf
End Function

; --- Watermark -------------------------------------------------------------------------------------------------------
; Every frame carries a faint pattern that nobody can see: some sky pixels are one step bluer than the rest. A program
; can find the pattern again in a screenshot, which shows that the picture came from this sample game. The pattern is
; drawn as a masked image just after Cls, so the world is drawn over it.

Global watermark, watermarkColor ; DrawWatermark makes the image the base time it is needed.

Function DrawWatermark(r, g, b)
	Local rgb = (r Shl 16) Or (g Shl 8) Or b
	If watermark = 0 Or rgb <> watermarkColor
		If watermark <> 0 Then FreeImage watermark
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		watermarkColor = rgb
		Local marked = b + 1
		If b = 255 Then marked = 254
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				; Black is the mask colour, so only the marked pixels are drawn.
				If (x * 7 + y * 13) Mod 29 < 3
					WritePixelFast x, y, (r Shl 16) Or (g Shl 8) Or marked, buffer
				Else
					WritePixelFast x, y, 0, buffer
				EndIf
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function

; --- Pictures --------------------------------------------------------------------------------------------------------

; The 16 tiles of the blocks, 16 x 16 pixels each, painted pixel by pixel into tilePixel(). A fixed seed makes them
; look the same every time. A colour of 0 is see-through (glass and the gaps in leaves).
Function MakeTiles()
	SeedRnd 1234
	Local tile, x, y, r#, g#, b#, n#, rgb
	For tile = 0 To 15
		For y = 0 To 15
			For x = 0 To 15
				n = Rnd(-1, 1)
				Select tile
					Case 0 ; Grass from above.
						r = 80 + n * 18 : g = 150 + n * 30 : b = 60 + n * 14
					Case 1 ; Grass from the side: dirt with a green top edge that hangs down a little.
						If y < 3 + (x * 7 Mod 3)
							r = 80 + n * 18 : g = 150 + n * 30 : b = 60 + n * 14
						Else
							r = 130 + n * 20 : g = 92 + n * 16 : b = 60 + n * 12
						EndIf
					Case 2 ; Dirt.
						r = 130 + n * 20 : g = 92 + n * 16 : b = 60 + n * 12
					Case 3 ; Stone.
						r = 128 + n * 16 : g = r : b = r + 6
					Case 4 ; Cobblestone: round stones with dark gaps.
						If ((x + (y / 4) * 3) Mod 5 = 0) Or (y Mod 4 = 0)
							r = 70 : g = 70 : b = 75
						Else
							r = 140 + n * 22 : g = r : b = r
						EndIf
					Case 5 ; Sand.
						r = 222 + n * 12 : g = 204 + n * 12 : b = 150 + n * 10
					Case 6 ; Log from the side: bark in stripes.
						r = 105 + n * 10 + (x Mod 3 = 0) * -25 : g = 75 + n * 8 : b = 45 + n * 6
					Case 7 ; Log from above: rings.
						n = Sqr((x - 7.5) * (x - 7.5) + (y - 7.5) * (y - 7.5))
						If n > 7 Or Int(n) Mod 3 = 0
							r = 120 : g = 88 : b = 52
						Else
							r = 184 : g = 150 : b = 100
						EndIf
					Case 8 ; Planks.
						If y Mod 4 = 3 Or (x = (y / 4) * 5 Mod 16)
							r = 120 : g = 86 : b = 50
						Else
							r = 186 + n * 12 : g = 144 + n * 10 : b = 92 + n * 8
						EndIf
					Case 9 ; Leaves, with gaps to see through.
						If Rand(0, 5) = 0
							r = 0 : g = 0 : b = 0
						Else
							r = 50 + n * 16 : g = 120 + n * 28 : b = 40 + n * 10
						EndIf
					Case 10 ; Bricks.
						If y Mod 4 = 3 Or ((x + (y / 4 Mod 2) * 4) Mod 8 = 7)
							r = 200 : g = 195 : b = 185
						Else
							r = 165 + n * 18 : g = 70 + n * 10 : b = 55 + n * 8
						EndIf
					Case 11 ; Glass: only a frame and a glint.
						If x = 0 Or y = 0 Or x = 15 Or y = 15
							r = 200 : g = 225 : b = 235
						ElseIf (x = y + 3 Or x = y + 4) And x < 9
							r = 235 : g = 245 : b = 250
						Else
							r = 0 : g = 0 : b = 0
						EndIf
					Case 12 ; Lamp: a warm glowing panel.
						n = Abs(x - 7.5) + Abs(y - 7.5)
						r = 255 : g = 250 - n * 6 : b = 190 - n * 8
						If x = 0 Or y = 0 Or x = 15 Or y = 15 Then r = 140 : g = 110 : b = 70
					Case 13 ; Snow.
						r = 238 + n * 8 : g = 242 + n * 8 : b = 250
					Case 14 ; Water.
						r = 40 + n * 8 : g = 100 + n * 12 + (((x + y * 2) Mod 7) = 0) * 30 : b = 200 + n * 10
					Default
						r = 255 : g = 0 : b = 255
				End Select
				If r < 0 Then r = 0
				If g < 0 Then g = 0
				If b < 0 Then b = 0
				If r > 255 Then r = 255
				If g > 255 Then g = 255
				If b > 255 Then b = 255
				rgb = (Int(r) Shl 16) Or (Int(g) Shl 8) Or Int(b)
				; Only the see-through pixels may be pure black: nudge the others.
				If rgb = 0 And tile <> 9 And tile <> 11 Then rgb = $010101
				tilePixel(tile, y * 16 + x) = rgb
			Next
		Next
	Next
	SeedRnd MilliSecs()
End Function

; The texture of all blocks: the 16 tiles in a 4 x 4 grid. Flag 4 makes black see-through. The sampler picks the
; nearest pixel instead of blending, so the blocks keep their sharp, pixelated look up close.
Function MakeAtlas()
	atlas = CreateTexture(64, 64, BB_TEXTURE_COLOR + BB_TEXTURE_MASKED)
	Local buffer = TextureBuffer(atlas), tile, x, y
	LockBuffer buffer
	For tile = 0 To 15
		For y = 0 To 15
			For x = 0 To 15
				WritePixelFast (tile Mod 4) * 16 + x, (tile / 4) * 16 + y, $FF000000 Or tilePixel(tile, y * 16 + x), buffer
			Next
		Next
	Next
	UnlockBuffer buffer
	Local sampler = CreateSampler()
	SetSamplerFilterMin sampler, 0
	SetSamplerFilterMag sampler, 0
	SetSamplerFilterMip sampler, 0
	SetTextureSampler atlas, sampler
End Function

; A small picture of each block for the bar: its side tile, twice as big.
Function MakeIcons()
	Local kind, tile, x, y, rgb, buffer
	For kind = 1 To BLOCK_KINDS - 1
		icon(kind) = CreateImage(32, 32)
		tile = tileSide(kind)
		buffer = ImageBuffer(icon(kind))
		LockBuffer buffer
		For y = 0 To 31
			For x = 0 To 31
				rgb = tilePixel(tile, (y / 2) * 16 + x / 2)
				If rgb = 0 Then rgb = $1A2030 ; The see-through parts show the dark bar behind them.
				WritePixelFast x, y, rgb, buffer
			Next
		Next
		UnlockBuffer buffer
	Next
	titleFont = LoadFont("Arial", 44, True)
	menuFont = LoadFont("Arial", 18, True)
	helpFont = LoadFont("Arial", 16)
End Function

Global titleFont, menuFont, helpFont

; --- Sounds ----------------------------------------------------------------------------------------------------------
; A short sound made sample by sample into a WAV file in a bank, written to a temporary file and loaded from there.

Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0, i, t#, hz#, v#, envelope#
	For i = 0 To samples - 1
		t = Float(i) / samples
		hz = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1
			Case WAVE_SINE
				v = Sin(phase)
			Default
				v = Rnd(-1, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		envelope = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.4 Then envelope = envelope * (1.0 - t) / 0.6
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "blockwright-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

