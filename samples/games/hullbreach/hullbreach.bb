; --- Building the arena ----------------------------------------------------------------------------------------------

; Reads the arena from its Data lines and makes it: one mesh with a surface for each material, the jump pads, the
; pickups and the places where machines appear. Whatever was in the old arena goes.
Function BuildArena(index)
	ClearArena()
	Select index
		Case 0 : Restore Arena0
		Case 1 : Restore Arena1
		Default : Restore Arena2
	End Select
	Read arenaName, accentR, accentG, accentB, startX, startZ, startYaw, centreX, centreY, centreZ

	arena = CreateMesh()
	Local deckBrush = CreateBrush()
	BrushTexture deckBrush, texDeck
	Local wallBrush = CreateBrush()
	BrushTexture wallBrush, texWall
	Local crateBrush = CreateBrush()
	BrushTexture crateBrush, texCrate
	Local glowBrush = CreateBrush(accentR, accentG, accentB)
	BrushTexture glowBrush, texPanel
	BrushFX glowBrush, 1
	Local deck = CreateSurface(arena, deckBrush)
	Local wall = CreateSurface(arena, wallBrush)
	Local crate = CreateSurface(arena, crateBrush)
	Local glow = CreateSurface(arena, glowBrush)
	FreeBrush deckBrush
	FreeBrush wallBrush
	FreeBrush crateBrush
	FreeBrush glowBrush

	Local kind, x0#, y0#, z0#, x1#, y1#, z1#
	Repeat
		Read kind
		If kind = 0 Then Exit
		Read x0, y0, z0, x1, y1, z1
		Select kind
			Case 1 : AddShape(deck, x0, y0, z0, x1, z1, y1, y1, y1, y1)
			Case 2 : AddShape(wall, x0, y0, z0, x1, z1, y1, y1, y1, y1)
			Case 3 : AddShape(crate, x0, y0, z0, x1, z1, y1, y1, y1, y1)
			Case 4 : AddShape(glow, x0, y0, z0, x1, z1, y1, y1, y1, y1)
			; Ramps: the top rises from y0 to y1 towards +x, -x, +z or -z.
			Case 5 : AddShape(deck, x0, y0, z0, x1, z1, y0, y0, y1, y1)
			Case 6 : AddShape(deck, x0, y0, z0, x1, z1, y1, y1, y0, y0)
			Case 7 : AddShape(deck, x0, y0, z0, x1, z1, y0, y1, y1, y0)
			Case 8 : AddShape(deck, x0, y0, z0, x1, z1, y1, y0, y0, y1)
		End Select
	Forever
	UpdateNormals arena
	EntityType arena, COL_WORLD
	EntityPickMode arena, 2

	; Jump pads: where they are and where they throw you.
	padCount = 0
	Repeat
		Read kind
		If kind = 0 Then Exit
		Read padX(padCount), padY(padCount), padZ(padCount), padTX(padCount), padTY(padCount), padTZ(padCount)
		padEnt(padCount) = CreateCylinder(16)
		ScaleEntity padEnt(padCount), 1.2, 0.06, 1.2
		PositionEntity padEnt(padCount), padX(padCount), padY(padCount) + 0.03, padZ(padCount)
		EntityColor padEnt(padCount), accentR, accentG, accentB
		EntityFX padEnt(padCount), 1
		padGlow(padCount) = MakeGlow(accentR, accentG, accentB, 1.6)
		PositionEntity padGlow(padCount), padX(padCount), padY(padCount) + 0.6, padZ(padCount)
		padCount = padCount + 1
	Forever

	Local x#, y#, z#
	Repeat
		Read kind
		If kind = 0 Then Exit
		Read x, y, z
		AddItem(kind, x, y, z)
	Forever

	spawnCount = 0
	Repeat
		Read kind
		If kind = 0 Then Exit
		Read spawnX(spawnCount), spawnY(spawnCount), spawnZ(spawnCount)
		spawnCount = spawnCount + 1
	Forever
End Function

Function ClearArena()
	Local f.Foe, s.Shot, p.Spark, it.Item, i
	For f = Each Foe
		FreeEntity f\ent
		Delete f
	Next
	boss = Null
	For s = Each Shot
		FreeEntity s\ent
		Delete s
	Next
	For p = Each Spark
		FreeEntity p\ent
		Delete p
	Next
	For it = Each Item
		FreeEntity it\ent
		FreeEntity it\glow
		Delete it
	Next
	For i = 0 To padCount - 1
		FreeEntity padEnt(i)
		FreeEntity padGlow(i)
	Next
	padCount = 0
	If arena <> 0 Then FreeEntity arena
	arena = 0
End Function

; A box, or a ramp, from x0..x1 and z0..z1, with its bottom at yb. The top corners have their own heights: at
; (x0, z0), (x0, z1), (x1, z1) and (x1, z0). A box has the same height at all four.
Function AddShape(surface, x0#, yb#, z0#, x1#, z1#, h00#, h01#, h11#, h10#)
	Local side, c, sx#, sy#, sz#
	For side = 0 To 5
		For c = 0 To 3
			If boxSide(side, c, 0) Then sx = x1 Else sx = x0
			If boxSide(side, c, 2) Then sz = z1 Else sz = z0
			If boxSide(side, c, 1) = 0
				sy = yb
			ElseIf boxSide(side, c, 0) = 0
				If boxSide(side, c, 2) = 0 Then sy = h00 Else sy = h01
			Else
				If boxSide(side, c, 2) = 0 Then sy = h10 Else sy = h11
			EndIf
			shapeCorner(c, 0) = sx
			shapeCorner(c, 1) = sy
			shapeCorner(c, 2) = sz
		Next
		AddFace(surface, boxAxis(side))
	Next
End Function

; Adds the four corners in shapeCorner() as two triangles. A triangle with two corners in the same place (the thin
; end of a ramp) is left out. The texture is laid on from the side, 4 metres to a picture.
Function AddFace(surface, axis)
	Local c, v0, u#, v#
	v0 = CountVertices(surface)
	For c = 0 To 3
		Select axis
			Case 0 : u = shapeCorner(c, 2) / 4.0 : v = -shapeCorner(c, 1) / 4.0
			Case 1 : u = shapeCorner(c, 0) / 4.0 : v = shapeCorner(c, 2) / 4.0
			Default : u = shapeCorner(c, 0) / 4.0 : v = -shapeCorner(c, 1) / 4.0
		End Select
		AddVertex surface, shapeCorner(c, 0), shapeCorner(c, 1), shapeCorner(c, 2), u, v
	Next
	If Not (SameCorner(0, 1) Or SameCorner(1, 2) Or SameCorner(0, 2)) Then AddTriangle surface, v0, v0 + 1, v0 + 2
	If Not (SameCorner(0, 2) Or SameCorner(2, 3) Or SameCorner(0, 3)) Then AddTriangle surface, v0, v0 + 2, v0 + 3
End Function

Function SameCorner(a, b)
	Return Abs(shapeCorner(a, 0) - shapeCorner(b, 0)) + Abs(shapeCorner(a, 1) - shapeCorner(b, 1)) + Abs(shapeCorner(a, 2) - shapeCorner(b, 2)) < 0.001
End Function

; A soft round glow that always faces the camera, added on top of what is behind it.
Function MakeGlow(r#, g#, b#, size#, parent = 0)
	Local sprite = CreateSprite(parent)
	EntityTexture sprite, texGlow
	EntityBlend sprite, 3
	EntityFX sprite, 1 + 8
	EntityColor sprite, r, g, b
	ScaleSprite sprite, size, size
	Return sprite
End Function

; --- Space -----------------------------------------------------------------------------------------------------------

; Stars, a gas giant, two clouds of gas and the sun. They all hang on one pivot that moves with the camera, so they
; seem endlessly far away.
Function MakeSky()
	sky = CreatePivot()
	Local stars = CreateMesh(sky)
	Local surface = CreateSurface(stars)
	Local i, corner, dx#, dy#, dz#, l#, ux#, uy#, uz#, vx#, vy#, vz#, size#, v0, bright#, r#, g#, b#
	SeedRnd 77
	For i = 1 To 900
		Repeat
			dx = Rnd(-1, 1) : dy = Rnd(-1, 1) : dz = Rnd(-1, 1)
			l = Sqr(dx * dx + dy * dy + dz * dz)
		Until l > 0.1 And l <= 1
		dx = dx / l : dy = dy / l : dz = dz / l
		; Two directions across the line of sight, for the corners of the little square.
		If Abs(dy) < 0.9
			ux = dz : uy = 0 : uz = -dx
		Else
			ux = 0 : uy = -dz : uz = dy
		EndIf
		l = Sqr(ux * ux + uy * uy + uz * uz)
		ux = ux / l : uy = uy / l : uz = uz / l
		vx = dy * uz - dz * uy : vy = dz * ux - dx * uz : vz = dx * uy - dy * ux
		size = Rnd(0.8, 2.2)
		If Rand(0, 20) = 0 Then size = size * 2
		bright = Rnd(0.45, 1.0)
		r = 255 * bright : g = 255 * bright : b = 255 * bright
		Select Rand(0, 5)
			Case 0 : b = b * 0.75
			Case 1 : r = r * 0.75
		End Select
		dx = dx * 900 : dy = dy * 900 : dz = dz * 900
		v0 = AddVertex(surface, dx - ux * size - vx * size, dy - uy * size - vy * size, dz - uz * size - vz * size)
		AddVertex surface, dx - ux * size + vx * size, dy - uy * size + vy * size, dz - uz * size + vz * size
		AddVertex surface, dx + ux * size + vx * size, dy + uy * size + vy * size, dz + uz * size + vz * size
		AddVertex surface, dx + ux * size - vx * size, dy + uy * size - vy * size, dz + uz * size - vz * size
		For corner = 0 To 3
			VertexColor surface, v0 + corner, r, g, b
		Next
		AddTriangle surface, v0, v0 + 1, v0 + 2
		AddTriangle surface, v0, v0 + 2, v0 + 3
	Next
	SeedRnd MilliSecs()
	EntityFX stars, 1 + 2 + 8 + 16

	Local planet = CreateSphere(32, sky)
	ScaleEntity planet, 150, 150, 150
	PositionEntity planet, -700, 40, 420
	RotateEntity planet, 12, 0, 18
	EntityTexture planet, texPlanet
	EntityFX planet, 8

	Local cloud = MakeGlow(120, 40, 150, 520, sky)
	EntityTexture cloud, texNebula
	PositionEntity cloud, 500, 200, 700
	cloud = MakeGlow(30, 90, 120, 420, sky)
	EntityTexture cloud, texNebula
	PositionEntity cloud, 700, -260, -400

	; The sun is where the light comes from.
	TFormVector 0, 0, -800, sun, 0
	Local glow = MakeGlow(255, 240, 210, 70, sky)
	PositionEntity glow, TFormedX(), TFormedY(), TFormedZ()
	glow = MakeGlow(255, 200, 140, 220, sky)
	PositionEntity glow, TFormedX(), TFormedY(), TFormedZ()
	EntityAlpha glow, 0.45
End Function

; --- Guns and machines -----------------------------------------------------------------------------------------------

; A box of the given size around (x, y, z), hung on a parent. Glowing boxes are not lit, so they look like lights.
Function MakeBox(parent, sx#, sy#, sz#, x#, y#, z#, r#, g#, b#, glowing = False)
	Local box = CreateCube(parent)
	ScaleMesh box, sx / 2, sy / 2, sz / 2
	PositionEntity box, x, y, z
	EntityColor box, r, g, b
	If glowing Then EntityFX box, 1
	Return box
End Function

; The gun in the player's hands, made of boxes, with the barrel pointing forwards (+z).
Function MakeGun(w, parent)
	Local root = CreatePivot(parent)
	Select w
		Case W_BLASTER
			MakeBox(root, 0.09, 0.11, 0.38, 0, 0, 0, 90, 100, 120)
			MakeBox(root, 0.05, 0.05, 0.2, 0, 0.02, 0.26, 70, 75, 90)
			MakeBox(root, 0.04, 0.025, 0.25, 0, 0.065, 0, 80, 220, 255, True)
			MakeBox(root, 0.06, 0.14, 0.08, 0, -0.1, -0.08, 50, 55, 70)
		Case W_SCATTER
			MakeBox(root, 0.07, 0.07, 0.55, -0.04, 0.02, 0.1, 60, 60, 65)
			MakeBox(root, 0.07, 0.07, 0.55, 0.04, 0.02, 0.1, 60, 60, 65)
			MakeBox(root, 0.16, 0.12, 0.24, 0, -0.04, -0.14, 170, 100, 40)
			MakeBox(root, 0.17, 0.03, 0.05, 0, 0.06, -0.02, 255, 160, 60, True)
		Case W_RAIL
			MakeBox(root, 0.08, 0.1, 0.7, 0, 0, 0.12, 70, 80, 75)
			MakeBox(root, 0.12, 0.12, 0.05, 0, 0, 0.0, 100, 255, 140, True)
			MakeBox(root, 0.12, 0.12, 0.05, 0, 0, 0.14, 100, 255, 140, True)
			MakeBox(root, 0.12, 0.12, 0.05, 0, 0, 0.28, 100, 255, 140, True)
			MakeBox(root, 0.07, 0.15, 0.2, 0, -0.08, -0.18, 50, 55, 50)
		Case W_ROCKET
			MakeBox(root, 0.17, 0.17, 0.6, 0, 0.01, 0.05, 120, 60, 55)
			MakeBox(root, 0.2, 0.2, 0.06, 0, 0.01, 0.34, 80, 80, 85)
			MakeBox(root, 0.08, 0.08, 0.15, 0, 0.13, -0.05, 70, 70, 75)
			MakeBox(root, 0.18, 0.02, 0.2, 0, 0.1, 0.12, 255, 90, 60, True)
	End Select
	Return root
End Function

; A machine of each kind, hidden; the ones in the game are copies. The first child is always the eye, which glows.
Function MakeFoeTemplate(kind)
	Local root, part, i
	Select kind
		Case F_CRAWLER
			root = CreateSphere(10)
			ScaleMesh root, 0.7, 0.45, 0.95
			part = CreateSphere(6, root)
			ScaleMesh part, 0.2, 0.13, 0.12
			PositionEntity part, 0, 0.12, 0.85
			EntityColor part, 255, 230, 60
			EntityFX part, 1
			For i = -1 To 1 Step 2
				part = MakeBox(root, 0.1, 0.1, 0.75, i * 0.75, -0.25, 0.3, 70, 40, 55)
				RotateEntity part, 20, Float(-i * 40), 0
				part = MakeBox(root, 0.1, 0.1, 0.75, i * 0.75, -0.25, -0.3, 70, 40, 55)
				RotateEntity part, 20, Float(i * 40), 0
			Next
			For i = 0 To 2
				part = CreateCone(5, True, root)
				ScaleMesh part, 0.1, 0.3, 0.1
				PositionEntity part, 0, 0.5, 0.4 - i * 0.4
				RotateEntity part, -30, 0, 0
				EntityColor part, 220, 200, 190
			Next
		Case F_DRONE
			root = CreateSphere(12)
			ScaleMesh root, 0.55, 0.55, 0.55
			part = CreateSphere(8, root)
			ScaleMesh part, 0.2, 0.2, 0.12
			PositionEntity part, 0, 0, 0.5
			EntityColor part, 255, 70, 40
			EntityFX part, 1
			part = CreateCylinder(16, True, root)
			ScaleMesh part, 0.95, 0.05, 0.95
			EntityColor part, 60, 65, 80
			MakeBox(root, 0.15, 0.15, 0.4, 0.75, 0, 0.1, 70, 70, 80)
			MakeBox(root, 0.15, 0.15, 0.4, -0.75, 0, 0.1, 70, 70, 80)
		Case F_BRUTE
			root = CreateCube()
			ScaleMesh root, 0.9, 0.8, 0.6
			PositionMesh root, 0, 0.1, 0
			part = CreateSphere(8, root)
			ScaleMesh part, 0.22, 0.12, 0.1
			PositionEntity part, 0, 1.15, 0.42
			EntityColor part, 255, 140, 30
			EntityFX part, 1
			MakeBox(root, 0.7, 0.45, 0.6, 0, 1.15, 0.05, 90, 95, 60)
			MakeBox(root, 0.45, 0.6, 0.5, -0.45, -0.95, 0, 60, 60, 50)
			MakeBox(root, 0.45, 0.6, 0.5, 0.45, -0.95, 0, 60, 60, 50)
			MakeBox(root, 0.35, 0.35, 1.0, 1.1, 0.6, 0.2, 70, 70, 75)
			MakeBox(root, 0.3, 0.3, 0.05, 1.1, 0.6, 0.72, 255, 120, 30, True)
			MakeBox(root, 0.3, 1.0, 0.35, -1.05, 0.1, 0.1, 90, 95, 60)
		Case F_WARDEN
			root = CreateSphere(20)
			ScaleMesh root, 2.6, 2.3, 2.6
			part = CreateSphere(12, root)
			ScaleMesh part, 0.75, 0.75, 0.3
			PositionEntity part, 0, 0, 2.45
			EntityColor part, 255, 60, 200
			EntityFX part, 1
			part = CreateCylinder(24, True, root)
			ScaleMesh part, 4.2, 0.22, 4.2
			EntityColor part, 70, 60, 90
			part = CreateCylinder(24, True, root)
			ScaleMesh part, 4.3, 0.06, 4.3
			PositionEntity part, 0, 0.25, 0
			EntityColor part, 255, 60, 200
			EntityFX part, 1
			For i = 0 To 5
				part = CreateCone(6, True, root)
				ScaleMesh part, 0.35, 1.2, 0.35
				PositionMesh part, 0, 2.6, 0
				RotateEntity part, 0, Float(i * 60), 70
				EntityColor part, 200, 190, 210
			Next
	End Select
	EntityColor root, foeR(kind), foeG(kind), foeB(kind)
	Return root
End Function

; --- Pickups ---------------------------------------------------------------------------------------------------------

Function AddItem(kind, x#, y#, z#)
	Local it.Item = New Item
	it\kind = kind
	it\x = x : it\y = y + 0.7 : it\z = z
	it\ent = CreatePivot()
	Local r# = 255, g# = 255, b# = 255
	Select kind
		Case I_HEALTH, I_BIG_HEALTH
			Local size# = 0.45
			If kind = I_BIG_HEALTH Then size = 0.7
			MakeBox(it\ent, size, size, size, 0, 0, 0, 235, 235, 240)
			MakeBox(it\ent, size * 0.7, size * 0.22, size * 1.02, 0, 0, 0, 255, 40, 40, True)
			MakeBox(it\ent, size * 0.22, size * 0.7, size * 1.02, 0, 0, 0, 255, 40, 40, True)
			MakeBox(it\ent, size * 1.02, size * 0.22, size * 0.7, 0, 0, 0, 255, 40, 40, True)
			r = 255 : g = 80 : b = 80
		Case I_ARMOR
			Local shell = CreateSphere(12, it\ent)
			ScaleMesh shell, 0.45, 0.55, 0.18
			EntityColor shell, 60, 200, 120
			MakeBox(it\ent, 0.5, 0.06, 0.4, 0, 0.1, 0, 140, 255, 180, True)
			r = 80 : g = 255 : b = 150
		Case I_SHELLS
			MakeBox(it\ent, 0.5, 0.3, 0.35, 0, 0, 0, 170, 100, 40)
			MakeBox(it\ent, 0.52, 0.06, 0.37, 0, 0.08, 0, 255, 160, 60, True)
			r = 255 : g = 160 : b = 60
		Case I_CELLS
			MakeBox(it\ent, 0.35, 0.45, 0.35, 0, 0, 0, 60, 70, 65)
			MakeBox(it\ent, 0.25, 0.47, 0.25, 0, 0, 0, 100, 255, 140, True)
			r = 100 : g = 255 : b = 140
		Case I_ROCKETS
			MakeBox(it\ent, 0.16, 0.16, 0.6, -0.1, 0, 0, 150, 60, 50)
			MakeBox(it\ent, 0.16, 0.16, 0.6, 0.1, 0, 0, 150, 60, 50)
			MakeBox(it\ent, 0.38, 0.05, 0.2, 0, 0.1, 0.2, 255, 90, 60, True)
			r = 255 : g = 90 : b = 60
		Case I_SCATTERGUN, I_RAILGUN, I_LAUNCHER
			Local model = MakeGun(kind - I_SCATTERGUN + W_SCATTER, it\ent)
			ScaleEntity model, 1.8, 1.8, 1.8
			r = 255 : g = 230 : b = 120
	End Select
	PositionEntity it\ent, it\x, it\y, it\z
	it\glow = MakeGlow(r, g, b, 1.1)
	PositionEntity it\glow, it\x, it\y - 0.4, it\z
	EntityAlpha it\glow, 0.6
End Function

Function UpdateItems()
	Local it.Item
	For it = Each Item
		If it\wait > 0
			it\wait = it\wait - 1
			If it\wait = 0
				ShowEntity it\ent
				ShowEntity it\glow
				BurstSparks(it\x, it\y, it\z, 255, 255, 255, 10, 0.06, 0.25)
			EndIf
		Else
			RotateEntity it\ent, 0, frame * 2.0, 0
			PositionEntity it\ent, it\x, it\y + Sin(frame * 3 + it\x * 40) * 0.12, it\z
			If state = STATE_PLAY
				If Distance(it\x, it\y, it\z, gPX, gPY, gPZ) < 1.4
					If TakeItem(it\kind)
						PlaySfx(sndPickup)
						HideEntity it\ent
						HideEntity it\glow
						it\wait = ItemWait(it\kind)
					EndIf
				EndIf
			EndIf
		EndIf
	Next
End Function

; How long a pickup takes to come back, in updates: health and armour take long, so they are worth fighting over.
Function ItemWait(kind)
	Select kind
		Case I_HEALTH : Return 25 * 60
		Case I_BIG_HEALTH, I_ARMOR : Return 45 * 60
		Case I_SCATTERGUN, I_RAILGUN, I_LAUNCHER : Return 30 * 60
	End Select
	Return 20 * 60
End Function

; Gives the player what a pickup holds. Gives back False when the player has no use for it, so it stays.
Function TakeItem(kind)
	Select kind
		Case I_HEALTH
			If health >= MAX_HEALTH Then Return False
			health = Min(health + 15, MAX_HEALTH)
			ShowBanner("", "Health +15", 60)
		Case I_BIG_HEALTH
			If health >= MAX_HEALTH Then Return False
			health = Min(health + 50, MAX_HEALTH)
			ShowBanner("", "Health +50", 60)
		Case I_ARMOR
			If armor >= MAX_ARMOR Then Return False
			armor = Min(armor + 50, MAX_ARMOR)
			ShowBanner("", "Armour +50", 60)
		Case I_SHELLS : Return GiveAmmo(W_SCATTER, 8)
		Case I_CELLS : Return GiveAmmo(W_RAIL, 5)
		Case I_ROCKETS : Return GiveAmmo(W_ROCKET, 5)
		Case I_SCATTERGUN, I_RAILGUN, I_LAUNCHER
			Local w = kind - I_SCATTERGUN + W_SCATTER
			If Not owned(w)
				owned(w) = True
				ammo(w) = IntMax(ammo(w), maxAmmo(w) / 2)
				ShowBanner("", "You found the " + weaponName(w) + "! Press " + (w + 1) + " to use it.", 180)
				ChooseWeapon(w)
				Return True
			EndIf
			Return GiveAmmo(w, maxAmmo(w) / 4)
	End Select
	Return True
End Function

; Ammunition for a gun the player does not have yet is still kept, for when the gun turns up.
Function GiveAmmo(w, amount)
	If ammo(w) >= maxAmmo(w) Then Return False
	ammo(w) = IntMin(ammo(w) + amount, maxAmmo(w))
	ShowBanner("", weaponName(w) + " ammunition +" + amount, 60)
	Return True
End Function

Function Min#(a#, b#)
	If a < b Then Return a
	Return b
End Function

Function Max#(a#, b#)
	If a > b Then Return a
	Return b
End Function

Function IntMin(a, b)
	If a < b Then Return a
	Return b
End Function

Function IntMax(a, b)
	If a > b Then Return a
	Return b
End Function

; --- Starting, finishing and losing ----------------------------------------------------------------------------------

Function NewGame()
	Local w
	For w = 0 To WEAPONS - 1
		owned(w) = False
		ammo(w) = 0
	Next
	owned(W_BLASTER) = True
	armor = 0
	score = 0
	kills = 0
	shotsFired = 0
	shotsHit = 0
	playTicks = 0
	sector = 0
	SaveSectorStart()
	StartSector()
End Function

; What the player has when a station starts, so "Try again" can give exactly that back.
Function SaveSectorStart()
	Local w
	For w = 0 To WEAPONS - 1
		savedOwned(w) = owned(w)
		savedAmmo(w) = ammo(w)
	Next
	savedArmor = armor
	savedScore = score
	savedKills = kills
End Function

Function RestoreSectorStart()
	Local w
	For w = 0 To WEAPONS - 1
		owned(w) = savedOwned(w)
		ammo(w) = savedAmmo(w)
	Next
	armor = savedArmor
	score = savedScore
	kills = savedKills
End Function

Function StartSector()
	BuildArena(sector)
	health = MAX_HEALTH
	PlacePlayer()
	weapon = W_BLASTER
	Local w
	For w = WEAPONS - 1 To 1 Step -1
		If owned(w) And ammo(w) > 0 And w <> W_ROCKET Then weapon = w : Exit
	Next
	ChooseWeapon(weapon)
	switchTimer = 0
	fireTimer = 20
	hurtFlash = 0
	wave = 0
	wavePhase = PHASE_INTRO
	waveTimer = 180
	sectorTicks = 0
	ShowBanner("Station " + (sector + 1) + ": " + arenaName, "Get ready", 170)
	StartPlaying()
End Function

Function PlacePlayer()
	PositionEntity player, startX, PLAYER_HALF + 0.05, startZ
	ResetEntity player
	pvx = 0 : pvy = 0 : pvz = 0
	yaw = startYaw
	pitch = 0
	padFlight = False
	onGround = False
End Function

Function StartPlaying()
	state = STATE_PLAY
	HidePointer
	MoveMouse SCREEN_W / 2, SCREEN_H / 2
	FlushKeys
	FlushMouse
	MouseXSpeed()
	MouseYSpeed()
	MouseZSpeed()
End Function

; All machines of the station are down: count the bonus and show how it went.
Function StationCleared()
	clearBonus = 1000 * (sector + 1)
	timeBonus = IntMax(0, 240 - sectorTicks / 60) * 10
	score = score + clearBonus + timeBonus
	PlaySfx(sndWave)
	If sector = SECTORS - 1
		If score > bestScore Then bestScore = score : SaveSettings()
		OpenMenu(STATE_WON, 1, 430)
		menuText(0) = "Back to the main menu"
	Else
		OpenMenu(STATE_CLEAR, 2, 400)
		menuText(0) = "On to station " + (sector + 2)
		menuText(1) = "Back to the main menu"
	EndIf
End Function

Function PlayerDied()
	health = 0
	If score > bestScore Then bestScore = score : SaveSettings()
	PlaySfx(sndDie)
	OpenMenu(STATE_DEAD, 2, 380)
	menuText(0) = "Try this station again"
	menuText(1) = "Back to the main menu"
End Function

; --- The player ------------------------------------------------------------------------------------------------------

Function UpdatePlay()
	playTicks = playTicks + 1
	sectorTicks = sectorTicks + 1
	If bannerTimer > 0 Then bannerTimer = bannerTimer - 1
	If hitMarker > 0 Then hitMarker = hitMarker - 1

	gPX = EntityX(player) : gPY = EntityY(player) : gPZ = EntityZ(player)
	MovePlayer()
	UpdateGun()
	UpdateFoes()
	UpdateWorld
	AfterCollisions()
	gPX = EntityX(player) : gPY = EntityY(player) : gPZ = EntityZ(player)
	UpdatePads()
	UpdateShots()
	RemoveDeadFoes()
	UpdateItems()
	UpdateSparks()
	UpdateWaves()
	PlaceCamera()

	If gPY < VOID_DEPTH
		ShowBanner("", "Lost in space! -25", 120)
		PlacePlayer()
		DamagePlayer(25)
	EndIf

	If health <= 0 And state = STATE_PLAY Then PlayerDied() : Return
	If (KeyHit(KEY_ESCAPE) Or KeyHit(KEY_P)) And state = STATE_PLAY Then GoToPause()
End Function

Function MovePlayer()
	; Looking around. MoveMouse puts the pointer back in the middle, so it never reaches the edge of the window.
	Local turn# = optSensitivity * 0.045
	yaw = yaw - MouseXSpeed() * turn
	If optInvert Then pitch = pitch - MouseYSpeed() * turn Else pitch = pitch + MouseYSpeed() * turn
	If pitch > 88 Then pitch = 88
	If pitch < -88 Then pitch = -88
	MoveMouse SCREEN_W / 2, SCREEN_H / 2

	; Which way the keys push: forward is where the player looks, flattened.
	Local fx# = -Sin(yaw), fz# = Cos(yaw)
	Local wx# = 0, wz# = 0
	If KeyDown(KEY_W) Then wx = wx + fx : wz = wz + fz
	If KeyDown(KEY_S) Then wx = wx - fx : wz = wz - fz
	If KeyDown(KEY_D) Then wx = wx + fz : wz = wz - fx
	If KeyDown(KEY_A) Then wx = wx - fz : wz = wz + fx
	Local l# = Sqr(wx * wx + wz * wz)
	If l > 0 Then wx = wx / l : wz = wz / l

	If onGround
		; On the ground the player follows the keys almost at once.
		pvx = pvx + (wx * RUN_SPEED - pvx) * 0.25
		pvz = pvz + (wz * RUN_SPEED - pvz) * 0.25
		If KeyDown(KEY_SPACE)
			pvy = JUMP_SPEED
			onGround = False
		EndIf
		swayPhase = swayPhase + Sqr(pvx * pvx + pvz * pvz) * 40
	ElseIf l > 0 And Not padFlight
		; In the air the keys steer a little, but a rocket's push or a jump pad's throw is kept.
		Local speed# = Sqr(pvx * pvx + pvz * pvz)
		pvx = pvx + wx * 0.012
		pvz = pvz + wz * 0.012
		Local newSpeed# = Sqr(pvx * pvx + pvz * pvz)
		Local limit# = Max(speed, RUN_SPEED)
		If newSpeed > limit Then pvx = pvx * limit / newSpeed : pvz = pvz * limit / newSpeed
	EndIf
	pvy = pvy - GRAVITY
	If pvy < -0.9 Then pvy = -0.9
	TranslateEntity player, pvx, pvy, pvz
End Function

; After UpdateWorld moved everything: what the player and the machines touched. A side facing up is ground, one
; facing down is a ceiling, and speed into a wall is taken away so nobody sticks to it.
Function AfterCollisions()
	Local i, nx#, ny#, nz#, into#
	onGround = False
	For i = 1 To CountCollisions(player)
		nx = CollisionNX(player, i) : ny = CollisionNY(player, i) : nz = CollisionNZ(player, i)
		If ny > 0.5
			onGround = True
			padFlight = False
			If pvy < 0 Then pvy = 0
		Else
			into = pvx * nx + pvy * ny + pvz * nz
			If into < 0 Then pvx = pvx - nx * into : pvy = pvy - ny * into : pvz = pvz - nz * into
		EndIf
	Next

	Local f.Foe
	For f = Each Foe
		If f\kind = F_CRAWLER Or f\kind = F_BRUTE
			f\onGround = False
			For i = 1 To CountCollisions(f\ent)
				nx = CollisionNX(f\ent, i) : ny = CollisionNY(f\ent, i) : nz = CollisionNZ(f\ent, i)
				If ny > 0.5
					f\onGround = True
					If f\vy < 0 Then f\vy = 0
				Else
					into = f\vx * nx + f\vy * ny + f\vz * nz
					If into < 0 Then f\vx = f\vx - nx * into : f\vy = f\vy - ny * into : f\vz = f\vz - nz * into
				EndIf
			Next
		ElseIf f\kind = F_DRONE
			If CountCollisions(f\ent) > 0 Then f\orbitDir = -f\orbitDir : f\vx = -f\vx * 0.5 : f\vz = -f\vz * 0.5
		EndIf
	Next
End Function

Function UpdatePads()
	Local i, dx#, dz#, d#, dy#, vy#, t#
	For i = 0 To padCount - 1
		ScaleSprite padGlow(i), 1.4 + Sin(frame * 6.0 + i * 90.0) * 0.3, 1.4 + Sin(frame * 6.0 + i * 90.0) * 0.3
		dx = padX(i) - gPX : dz = padZ(i) - gPZ
		If dx * dx + dz * dz < 1.3 * 1.3 And Abs(gPY - PLAYER_HALF - padY(i)) < 0.5 And pvy <= 0.01
			; Throw the player so the jump goes 2.5 metres above the target and comes down on it.
			dx = padTX(i) - gPX : dz = padTZ(i) - gPZ
			d = Sqr(dx * dx + dz * dz)
			dy = padTY(i) - padY(i)
			vy = Sqr(2 * GRAVITY * (Max(dy, 0) + 2.5))
			t = (vy + Sqr(vy * vy - 2 * GRAVITY * dy)) / GRAVITY
			pvy = vy
			pvx = dx / t
			pvz = dz / t
			padFlight = True
			onGround = False
			PlaySfx(sndPad)
			BurstSparks(padX(i), padY(i) + 0.3, padZ(i), accentR, accentG, accentB, 14, 0.12, 0.3)
		EndIf
	Next
End Function

Function PlaceCamera()
	PositionEntity camera, gPX, gPY + EYE, gPZ
	RotateEntity camera, pitch, yaw, 0
	PositionEntity sky, gPX, gPY + EYE, gPZ
End Function

; Hurts the player. Armour takes half of every hit while it lasts.
Function DamagePlayer(amount#)
	If state <> STATE_PLAY Or amount <= 0 Then Return
	Local saved# = Min(amount / 2, armor)
	armor = armor - saved
	health = health - (amount - saved)
	hurtFlash = Min(hurtFlash + amount / 40.0, 0.8)
	PlaySfx(sndHurt)
End Function

; --- Guns ------------------------------------------------------------------------------------------------------------

Function ChooseWeapon(w)
	Local i
	For i = 0 To WEAPONS - 1
		HideEntity gun(i)
	Next
	weapon = w
	nextWeapon = w
	ShowEntity gun(w)
End Function

Function UpdateGun()
	Local w, i
	; Choosing: the number keys, or the wheel to the next or previous gun the player has.
	For w = 0 To WEAPONS - 1
		If KeyHit(KEY_1 + w) And owned(w) And w <> nextWeapon Then nextWeapon = w : switchTimer = 16
	Next
	Local wheel = MouseZSpeed()
	If wheel <> 0
		w = nextWeapon
		For i = 1 To WEAPONS
			If wheel < 0 Then w = (w + 1) Mod WEAPONS Else w = (w + WEAPONS - 1) Mod WEAPONS
			If owned(w) Then Exit
		Next
		If w <> nextWeapon Then nextWeapon = w : switchTimer = 16
	EndIf
	If switchTimer > 0
		switchTimer = switchTimer - 1
		If switchTimer = 8 Then ChooseWeapon(nextWeapon) : nextWeapon = weapon
	EndIf

	If fireTimer > 0 Then fireTimer = fireTimer - 1
	If muzzleTimer > 0
		muzzleTimer = muzzleTimer - 1
		If muzzleTimer = 0 Then HideEntity muzzle
	EndIf
	If MouseDown(1) And fireTimer = 0 And switchTimer = 0
		If weapon <> W_BLASTER And ammo(weapon) <= 0
			; Out of ammunition: click, and take the best other gun.
			PlaySfx(sndEmpty)
			fireTimer = 20
			nextWeapon = W_BLASTER
			If owned(W_SCATTER) And ammo(W_SCATTER) > 0 Then nextWeapon = W_SCATTER
			If owned(W_RAIL) And ammo(W_RAIL) > 0 And nextWeapon = W_BLASTER Then nextWeapon = W_RAIL
			switchTimer = 16
		Else
			FireWeapon()
		EndIf
	EndIf

	; The gun sits low on the right, sways while running, kicks back when it fires and dips while being changed.
	recoil = recoil * 0.85
	Local swayX# = 0, swayY# = 0
	If optSway And onGround
		swayX = Sin(swayPhase) * 0.02
		swayY = Abs(Cos(swayPhase)) * 0.018
	EndIf
	Local dip# = 0
	If switchTimer > 0 Then dip = (8 - Abs(switchTimer - 8)) * 0.04
	PositionEntity gunPivot, 0.2 + swayX, -0.2 + swayY - dip - recoil * 0.2, 0.42 - recoil * 0.6
	RotateEntity gunPivot, -recoil * 40, 0, 0
End Function

Function FireWeapon()
	fireTimer = weaponDelay(weapon)
	If weapon <> W_BLASTER Then ammo(weapon) = ammo(weapon) - 1
	shotsFired = shotsFired + 1

	; Where the shot starts: the eye, looking straight ahead. Where it seems to come from: the gun's muzzle.
	Local ox# = EntityX(camera, True), oy# = EntityY(camera, True), oz# = EntityZ(camera, True)
	TFormVector 0, 0, 1, camera, 0
	Local dx# = TFormedX(), dy# = TFormedY(), dz# = TFormedZ()
	TFormPoint 0.2, -0.18, 0.7, camera, 0
	Local mx# = TFormedX(), my# = TFormedY(), mz# = TFormedZ()

	PositionEntity muzzle, 0, 0.03, 0.45
	ShowEntity muzzle
	muzzleTimer = 3
	Local i, hit, l#, sx#, sy#, sz#
	Select weapon
		Case W_BLASTER
			EntityColor muzzle, 80, 220, 255
			FirePlayerShot(S_BOLT, ox + dx * 0.4, oy + dy * 0.4 - 0.08, oz + dz * 0.4, dx, dy, dz, 1.4, 14)
			recoil = 0.04
			PlaySfx(sndBlaster)
		Case W_SCATTER
			EntityColor muzzle, 255, 170, 70
			For i = 1 To 9
				TFormVector Rnd(-0.075, 0.075), Rnd(-0.055, 0.055), 1, camera, 0
				sx = TFormedX() : sy = TFormedY() : sz = TFormedZ()
				l = Sqr(sx * sx + sy * sy + sz * sz)
				hit = hit Or TraceShot(ox, oy, oz, sx / l, sy / l, sz / l, 70, 8, False)
			Next
			If hit Then shotsHit = shotsHit + 1
			recoil = 0.12
			PlaySfx(sndScatter)
		Case W_RAIL
			EntityColor muzzle, 100, 255, 140
			If TraceShot(ox, oy, oz, dx, dy, dz, 400, 105, True) Then shotsHit = shotsHit + 1
			MakeBeam(mx, my, mz, ox + dx * traceEnd, oy + dy * traceEnd, oz + dz * traceEnd)
			recoil = 0.1
			PlaySfx(sndRail)
		Case W_ROCKET
			EntityColor muzzle, 255, 120, 60
			FirePlayerShot(S_ROCKET, ox + dx * 0.5, oy + dy * 0.5 - 0.1, oz + dz * 0.5, dx, dy, dz, 0.75, 95)
			recoil = 0.1
			PlaySfx(sndRocket)
	End Select
End Function

; A shot that hits at once along a line. Stops at the first wall, and at the first machine unless it pierces.
; Gives back True when it hit a machine; traceEnd is how far the line went.
Global traceEnd#
Function TraceShot(ox#, oy#, oz#, dx#, dy#, dz#, range#, damage#, pierce)
	Local wallT# = range
	If LinePick(ox, oy, oz, dx * range, dy * range, dz * range) <> 0
		wallT = Distance(ox, oy, oz, PickedX(), PickedY(), PickedZ())
	EndIf
	Local f.Foe, nearest.Foe, nearestT# = wallT, t#, hit = False
	For f = Each Foe
		If f\hp > 0
			t = RayHitsFoe(f, ox, oy, oz, dx, dy, dz)
			If t >= 0 And t < wallT
				If pierce
					DamageFoe(f, damage)
					BurstSparks(ox + dx * t, oy + dy * t, oz + dz * t, 120, 255, 160, 8, 0.08, 0.2)
					hit = True
				ElseIf t < nearestT
					nearest = f
					nearestT = t
				EndIf
			EndIf
		EndIf
	Next
	If nearest <> Null
		DamageFoe(nearest, damage)
		BurstSparks(ox + dx * nearestT, oy + dy * nearestT, oz + dz * nearestT, 255, 200, 120, 3, 0.06, 0.15)
		traceEnd = nearestT
		Return True
	EndIf
	traceEnd = wallT
	If wallT < range Then BurstSparks(ox + dx * wallT, oy + dy * wallT, oz + dz * wallT, 255, 220, 160, 2, 0.05, 0.12)
	Return hit
End Function

; Where a line from (ox, oy, oz) in the direction d first enters a machine's sphere, or -1 if it misses.
Function RayHitsFoe#(f.Foe, ox#, oy#, oz#, dx#, dy#, dz#)
	Local cx# = EntityX(f\ent) - ox, cy# = EntityY(f\ent) - oy, cz# = EntityZ(f\ent) - oz
	Local t# = cx * dx + cy * dy + cz * dz
	If t < 0 Then Return -1
	Local r# = foeRadius(f\kind) * 1.1
	Local miss# = cx * cx + cy * cy + cz * cz - t * t
	If miss > r * r Then Return -1
	Return Max(t - Sqr(r * r - miss), 0)
End Function

; The railgun's beam: a thin glowing rod from the gun to where the shot stopped.
Function MakeBeam(x1#, y1#, z1#, x2#, y2#, z2#)
	Local p.Spark = New Spark
	p\ent = CreateCylinder(6)
	RotateMesh p\ent, 90, 0, 0
	Local l# = Distance(x1, y1, z1, x2, y2, z2)
	PositionEntity p\ent, (x1 + x2) / 2, (y1 + y2) / 2, (z1 + z2) / 2
	PointEntity p\ent, CreatePivotAt(x2, y2, z2)
	ScaleEntity p\ent, 0.04, 0.04, l / 2
	EntityColor p\ent, 120, 255, 170
	EntityFX p\ent, 1 + 8
	EntityBlend p\ent, 3
	p\beam = True
	p\life = 24
	p\maxLife = 24
	p\alpha = 1
End Function

; A pivot that only exists to be pointed at. Kept and moved, so no pivots pile up.
Global aimPivot
Function CreatePivotAt(x#, y#, z#)
	If aimPivot = 0 Then aimPivot = CreatePivot()
	PositionEntity aimPivot, x, y, z
	Return aimPivot
End Function

; --- Shots -----------------------------------------------------------------------------------------------------------

Function FirePlayerShot(kind, x#, y#, z#, dx#, dy#, dz#, speed#, damage#)
	Local s.Shot = NewShot(kind, x, y, z, dx * speed, dy * speed, dz * speed, damage)
	s\fromPlayer = True
End Function

Function NewShot.Shot(kind, x#, y#, z#, vx#, vy#, vz#, damage#)
	Local s.Shot = New Shot
	s\kind = kind
	s\x = x : s\y = y : s\z = z
	s\vx = vx : s\vy = vy : s\vz = vz
	s\damage = damage
	s\life = 60 * 6
	Select kind
		Case S_BOLT : s\ent = MakeGlow(90, 220, 255, 0.35)
		Case S_ROCKET : s\ent = MakeGlow(255, 150, 80, 0.5)
		Case S_PLASMA : s\ent = MakeGlow(255, 110, 40, 0.75)
		Case S_FOE_ROCKET : s\ent = MakeGlow(255, 60, 30, 0.95)
	End Select
	PositionEntity s\ent, x, y, z
	Return s
End Function

; Fires a machine's shot from (x, y, z) at the player's middle. Spread turns it that many degrees to the side.
Function FireFoeShot(kind, x#, y#, z#, speed#, damage#, spread#)
	Local dx# = gPX - x, dy# = gPY - y, dz# = gPZ - z
	Local l# = Sqr(dx * dx + dy * dy + dz * dz)
	If l < 0.01 Then Return
	dx = dx / l : dy = dy / l : dz = dz / l
	If spread <> 0
		Local c# = Cos(spread), s# = Sin(spread), nx# = dx * c - dz * s
		dz = dx * s + dz * c
		dx = nx
	EndIf
	speed = speed * diffShot(optDifficulty)
	NewShot(kind, x, y, z, dx * speed, dy * speed, dz * speed, damage * diffDamage(optDifficulty))
End Function

Function UpdateShots()
	Local s.Shot, nx#, ny#, nz#, f.Foe, gone, d#
	For s = Each Shot
		gone = False
		nx = s\x + s\vx : ny = s\y + s\vy : nz = s\z + s\vz
		; Walls first: the shot stops where the line from its old place to its new one meets the arena.
		If LinePick(s\x, s\y, s\z, s\vx, s\vy, s\vz) <> 0
			nx = PickedX() - s\vx * 0.02 : ny = PickedY() - s\vy * 0.02 : nz = PickedZ() - s\vz * 0.02
			gone = True
		EndIf
		If s\fromPlayer
			f = SegmentHitsFoe(s\x, s\y, s\z, nx, ny, nz)
			If f <> Null
				gone = True
				If s\kind = S_BOLT
					DamageFoe(f, s\damage)
					shotsHit = shotsHit + 1
				Else
					; A direct rocket hit hurts the one it hit fully, before the blast.
					DamageFoe(f, s\damage * 0.4)
				EndIf
			EndIf
		Else
			If SegmentDistance(s\x, s\y, s\z, nx, ny, nz, gPX, gPY, gPZ) < 0.6
				gone = True
				If s\kind = S_PLASMA Then DamagePlayer(s\damage) : PushPlayer(s\vx * 0.3, 0.02, s\vz * 0.3)
			EndIf
		EndIf
		s\x = nx : s\y = ny : s\z = nz
		PositionEntity s\ent, s\x, s\y, s\z
		If s\kind = S_ROCKET Or s\kind = S_FOE_ROCKET
			If frame Mod 2 = 0 Then AddSpark(s\x, s\y, s\z, 0, 0.01, 0, 200, 140, 120, 22, 0.25, 0.03, 0)
		EndIf
		s\life = s\life - 1
		If s\life <= 0 Then gone = True
		If gone
			Select s\kind
				Case S_ROCKET : Explode(s\x, s\y, s\z, 4.5, 80, True)
				Case S_FOE_ROCKET : Explode(s\x, s\y, s\z, 3.5, s\damage, False)
				Case S_PLASMA : BurstSparks(s\x, s\y, s\z, 255, 120, 50, 6, 0.06, 0.2)
				Default : BurstSparks(s\x, s\y, s\z, 90, 220, 255, 4, 0.05, 0.15)
			End Select
			FreeEntity s\ent
			Delete s
		EndIf
	Next
End Function

; The first machine a short line goes through, or Null.
Function SegmentHitsFoe.Foe(x1#, y1#, z1#, x2#, y2#, z2#)
	Local f.Foe
	For f = Each Foe
		If f\hp > 0
			If SegmentDistance(x1, y1, z1, x2, y2, z2, EntityX(f\ent), EntityY(f\ent), EntityZ(f\ent)) < foeRadius(f\kind) + 0.15
				Return f
			EndIf
		EndIf
	Next
	Return Null
End Function

; How close the line from (x1, y1, z1) to (x2, y2, z2) comes to the point (px, py, pz).
Function SegmentDistance#(x1#, y1#, z1#, x2#, y2#, z2#, px#, py#, pz#)
	Local dx# = x2 - x1, dy# = y2 - y1, dz# = z2 - z1
	Local l2# = dx * dx + dy * dy + dz * dz
	Local t# = 0
	If l2 > 0 Then t = ((px - x1) * dx + (py - y1) * dy + (pz - z1) * dz) / l2
	If t < 0 Then t = 0
	If t > 1 Then t = 1
	Return Distance(x1 + dx * t, y1 + dy * t, z1 + dz * t, px, py, pz)
End Function

Function Distance#(x1#, y1#, z1#, x2#, y2#, z2#)
	Return Sqr((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1) + (z2 - z1) * (z2 - z1))
End Function

; A blast hurts everything near it, less towards the edge, and pushes it away; the player too. The player's own
; rockets hurt the player less, and push harder, so they can throw the player up high.
Function Explode(x#, y#, z#, radius#, damage#, fromPlayer)
	PlaySfxAt(sndBoom, x, y, z)
	BurstSparks(x, y, z, 255, 170, 80, 26, 0.18, 0.5)
	AddSpark(x, y, z, 0, 0, 0, 255, 200, 140, 20, radius * 0.4, radius * 0.06, 0)
	Local f.Foe, d#, part#, hit = False
	For f = Each Foe
		If f\hp > 0
			d = Distance(x, y, z, EntityX(f\ent), EntityY(f\ent), EntityZ(f\ent)) - foeRadius(f\kind)
			If d < radius
				part = 1.0 - Max(d, 0) / radius
				If fromPlayer Or f\kind <> F_WARDEN Then DamageFoe(f, damage * part)
				If f\kind <> F_WARDEN
					f\vy = f\vy + 0.15 * part
					f\vx = f\vx + (EntityX(f\ent) - x) / (d + 1) * 0.2 * part
					f\vz = f\vz + (EntityZ(f\ent) - z) / (d + 1) * 0.2 * part
				EndIf
				If fromPlayer Then hit = True
			EndIf
		EndIf
	Next
	If hit Then shotsHit = shotsHit + 1

	d = Distance(x, y, z, gPX, gPY, gPZ)
	If d < radius
		part = 1.0 - d / radius
		Local push# = 0.42
		If fromPlayer Then DamagePlayer(damage * part * 0.35) : push = 0.5 Else DamagePlayer(damage * part)
		Local dx# = gPX - x, dy# = gPY - y + 0.3, dz# = gPZ - z
		Local l# = Sqr(dx * dx + dy * dy + dz * dz)
		If l < 0.01 Then dy = 1 : l = 1
		PushPlayer(dx / l * push * part, dy / l * push * part, dz / l * push * part)
	EndIf
End Function

Function PushPlayer(x#, y#, z#)
	pvx = pvx + x
	pvy = pvy + y
	pvz = pvz + z
	If y > 0.05 Then onGround = False : padFlight = False
End Function

; --- Machines --------------------------------------------------------------------------------------------------------

Function SpawnFoe.Foe(kind, x#, y#, z#)
	Local f.Foe = New Foe
	f\kind = kind
	f\ent = CopyEntity(foeTemplate(kind))
	ShowEntity f\ent
	f\eye = GetChild(f\ent, 1)
	PositionEntity f\ent, x, y, z
	If kind <> F_WARDEN
		EntityType f\ent, COL_FOE
		EntityRadius f\ent, foeRadius(kind), foeHeight(kind)
	EndIf
	ResetEntity f\ent
	f\hp = foeHp(kind)
	If kind = F_WARDEN Then f\hp = f\hp * diffBoss(optDifficulty)
	f\spawning = 40
	f\timer = Rand(60, 150)
	f\summon = 600
	f\orbit = Rnd(0, 360)
	f\orbitDir = 1 - 2 * Rand(0, 1)
	f\range = Rnd(9, 15)
	f\height = Rnd(3, 5.5)
	f\lastX = x : f\lastZ = z
	ScaleEntity f\ent, 0.1, 0.1, 0.1
	BurstSparks(x, y, z, 160, 120, 255, 16, 0.1, 0.35)
	PlaySfxAt(sndSpawn, x, y, z)
	Return f
End Function

Function DamageFoe(f.Foe, amount#)
	If f\hp <= 0 Then Return
	f\hp = f\hp - amount
	f\flash = 4
	hitMarker = 8
	If frame Mod 3 = 0 Then PlaySfx(sndHit)
End Function

Function UpdateFoes()
	Local f.Foe, s#
	For f = Each Foe
		If f\flash > 0
			f\flash = f\flash - 1
			If f\flash > 0 Then EntityColor f\ent, 255, 255, 255 Else EntityColor f\ent, foeR(f\kind), foeG(f\kind), foeB(f\kind)
		EndIf
		If f\spawning > 0
			f\spawning = f\spawning - 1
			s = 1.0 - f\spawning / 40.0
			ScaleEntity f\ent, 0.1 + s * 0.9, 0.1 + s * 0.9, 0.1 + s * 0.9
			; Walkers fall to the floor while they appear, so collisions have something to work with.
			If f\kind = F_CRAWLER Or f\kind = F_BRUTE Then f\vy = f\vy - GRAVITY : TranslateEntity f\ent, 0, f\vy, 0
		Else
			Select f\kind
				Case F_CRAWLER : ThinkCrawler(f)
				Case F_DRONE : ThinkDrone(f)
				Case F_BRUTE : ThinkBrute(f)
				Case F_WARDEN : ThinkWarden(f)
			End Select
		EndIf
		If EntityY(f\ent) < VOID_DEPTH Then f\hp = 0
	Next
	SeparateFoes()
End Function

; The direction and distance from a machine to the player, along the floor.
Global toX#, toZ#, toDist#
Function AimAtPlayer(f.Foe)
	toX = gPX - EntityX(f\ent)
	toZ = gPZ - EntityZ(f\ent)
	toDist = Sqr(toX * toX + toZ * toZ)
	If toDist > 0.01 Then toX = toX / toDist : toZ = toZ / toDist
End Function

; Crawlers run at the player and bite. They are a little slower than the player, so running away works, and they
; leap when they get close.
Function ThinkCrawler(f.Foe)
	AimAtPlayer(f)
	RotateEntity f\ent, 0, ATan2(-toX, toZ), 0
	Local speed# = 0.15 * diffSpeed(optDifficulty)
	If f\timer > 0 Then f\timer = f\timer - 1
	If f\attack > 0 Then f\attack = f\attack - 1
	If f\onGround
		f\vx = f\vx + (toX * speed - f\vx) * 0.2
		f\vz = f\vz + (toZ * speed - f\vz) * 0.2
		If toDist < 7 And toDist > 2.5 And f\timer = 0
			f\vy = 0.16
			f\vx = toX * 0.3
			f\vz = toZ * 0.3
			f\timer = Rand(90, 160)
		EndIf
		CheckStuck(f)
	EndIf
	f\vy = f\vy - GRAVITY
	TranslateEntity f\ent, f\vx, f\vy, f\vz

	If f\attack = 0 And Distance(EntityX(f\ent), EntityY(f\ent), EntityZ(f\ent), gPX, gPY, gPZ) < foeRadius(F_CRAWLER) + PLAYER_RADIUS + 0.5
		DamagePlayer(8 * diffDamage(optDifficulty))
		PushPlayer(toX * 0.12, 0.06, toZ * 0.12)
		PlaySfx(sndBite)
		f\attack = 60
	EndIf
End Function

; A walker that has hardly moved for half a second jumps, which gets it over crates and up steps.
Function CheckStuck(f.Foe)
	f\stuckTimer = f\stuckTimer + 1
	If f\stuckTimer < 30 Then Return
	f\stuckTimer = 0
	Local moved# = Abs(EntityX(f\ent) - f\lastX) + Abs(EntityZ(f\ent) - f\lastZ)
	f\lastX = EntityX(f\ent)
	f\lastZ = EntityZ(f\ent)
	If moved < 0.5 And toDist > 3 Then f\vy = 0.2
End Function

; Drones circle the player at a distance, above head height, and fire slow balls of plasma straight at where the
; player is now. They do not aim ahead, so running sideways makes them miss.
Function ThinkDrone(f.Foe)
	f\orbit = f\orbit + 0.5 * f\orbitDir
	If Rand(0, 400) = 0 Then f\orbitDir = -f\orbitDir
	Local tx# = gPX + Cos(f\orbit) * f\range
	Local ty# = gPY + f\height
	Local tz# = gPZ + Sin(f\orbit) * f\range
	Local x# = EntityX(f\ent), y# = EntityY(f\ent), z# = EntityZ(f\ent)
	f\vx = (f\vx + (tx - x) * 0.003) * 0.97
	f\vy = (f\vy + (ty - y) * 0.004) * 0.95
	f\vz = (f\vz + (tz - z) * 0.003) * 0.97
	Local speed# = Sqr(f\vx * f\vx + f\vy * f\vy + f\vz * f\vz), top# = 0.14 * diffSpeed(optDifficulty)
	If speed > top Then f\vx = f\vx * top / speed : f\vy = f\vy * top / speed : f\vz = f\vz * top / speed
	TranslateEntity f\ent, f\vx, f\vy + Sin(frame * 4 + f\orbit) * 0.01, f\vz
	PointEntity f\ent, player

	f\timer = f\timer - 1
	If f\timer <= 0
		If Distance(x, y, z, gPX, gPY, gPZ) < 45 And EntityVisible(f\ent, player)
			FireFoeShot(S_PLASMA, x, y, z, 0.32, 9, 0)
			PlaySfxAt(sndPlasma, x, y, z)
			f\timer = Int(Rand(90, 150) / diffRate(optDifficulty))
		Else
			f\timer = 20
		EndIf
	EndIf
End Function

; Brutes walk slowly towards the player, stop at a distance and fire rockets. Before each rocket the eye flares up
; and a whine plays for most of a second: that is the time to get out of the way.
Function ThinkBrute(f.Foe)
	AimAtPlayer(f)
	RotateEntity f\ent, 0, ATan2(-toX, toZ), 0
	Local speed# = 0.055 * diffSpeed(optDifficulty)
	If f\onGround
		If toDist > 11
			f\vx = f\vx + (toX * speed - f\vx) * 0.1
			f\vz = f\vz + (toZ * speed - f\vz) * 0.1
		Else
			f\vx = f\vx * 0.85
			f\vz = f\vz * 0.85
		EndIf
		CheckStuck(f)
	EndIf
	f\vy = f\vy - GRAVITY
	TranslateEntity f\ent, f\vx, f\vy, f\vz

	If f\attack > 0 Then f\attack = f\attack - 1
	If f\attack = 0 And Distance(EntityX(f\ent), EntityY(f\ent), EntityZ(f\ent), gPX, gPY, gPZ) < foeRadius(F_BRUTE) + PLAYER_RADIUS + 0.6
		DamagePlayer(18 * diffDamage(optDifficulty))
		PushPlayer(toX * 0.3, 0.12, toZ * 0.3)
		PlaySfx(sndBite)
		f\attack = 70
	EndIf

	If f\charge > 0
		f\charge = f\charge - 1
		Local glow# = 1.0 + (50 - f\charge) / 20.0
		ScaleEntity f\eye, glow, glow, glow
		If f\charge = 0
			ScaleEntity f\eye, 1, 1, 1
			TFormPoint 1.1, 0.6, 0.8, f\ent, 0
			FireFoeShot(S_FOE_ROCKET, TFormedX(), TFormedY(), TFormedZ(), 0.26, 30, 0)
			PlaySfxAt(sndRocket, EntityX(f\ent), EntityY(f\ent), EntityZ(f\ent))
			f\timer = Int(Rand(150, 230) / diffRate(optDifficulty))
		EndIf
	Else
		f\timer = f\timer - 1
		If f\timer <= 0
			If toDist < 50 And EntityVisible(f\ent, player)
				f\charge = 50
				PlaySfxAt(sndCharge, EntityX(f\ent), EntityY(f\ent), EntityZ(f\ent))
			Else
				f\timer = 30
			EndIf
		EndIf
	EndIf
End Function

; The Warden floats in a slow circle over the middle of the last station. It fires fans of five plasma balls, a
; rocket now and then, and calls drones when few are left.
Function ThinkWarden(f.Foe)
	f\orbit = f\orbit + 0.22
	PositionEntity f\ent, centreX + Cos(f\orbit) * 11, centreY + Sin(frame * 1.2) * 1.5, centreZ + Sin(f\orbit) * 11
	PointEntity f\ent, player
	Local x# = EntityX(f\ent), y# = EntityY(f\ent), z# = EntityZ(f\ent), i

	f\timer = f\timer - 1
	If f\timer <= 0
		TFormPoint 0, 0, 2.6, f\ent, 0
		For i = -2 To 2
			FireFoeShot(S_PLASMA, TFormedX(), TFormedY(), TFormedZ(), 0.3, 10, i * 11.0)
		Next
		PlaySfxAt(sndPlasma, x, y, z)
		f\timer = Int(115 / diffRate(optDifficulty))
	EndIf

	If f\charge > 0
		f\charge = f\charge - 1
		If f\charge = 0
			TFormPoint 0, -2, 2.6, f\ent, 0
			FireFoeShot(S_FOE_ROCKET, TFormedX(), TFormedY(), TFormedZ(), 0.28, 30, 0)
			PlaySfxAt(sndRocket, x, y, z)
		EndIf
	ElseIf f\attack <= 0
		f\charge = 50
		f\attack = Int(290 / diffRate(optDifficulty))
		PlaySfxAt(sndCharge, x, y, z)
	Else
		f\attack = f\attack - 1
	EndIf

	f\summon = f\summon - 1
	If f\summon <= 0
		f\summon = 600
		If CountFoes(F_DRONE) < 3
			SpawnFoe(F_DRONE, x + 4, y - 2, z)
			SpawnFoe(F_DRONE, x - 4, y - 2, z)
		EndIf
	EndIf
End Function

; Walkers push each other and the player apart, so they do not stand inside each other.
Function SeparateFoes()
	Local a.Foe, b.Foe, dx#, dz#, d#, room#
	For a = Each Foe
		If a\kind = F_CRAWLER Or a\kind = F_BRUTE
			dx = EntityX(a\ent) - gPX : dz = EntityZ(a\ent) - gPZ
			d = Sqr(dx * dx + dz * dz)
			room = foeRadius(a\kind) + PLAYER_RADIUS
			If d < room And d > 0.01 And Abs(EntityY(a\ent) - gPY) < foeHeight(a\kind) + PLAYER_HALF
				TranslateEntity player, -dx / d * (room - d) * 0.5, 0, -dz / d * (room - d) * 0.5
			EndIf
			b = After a
			While b <> Null
				If b\kind = F_CRAWLER Or b\kind = F_BRUTE
					dx = EntityX(a\ent) - EntityX(b\ent) : dz = EntityZ(a\ent) - EntityZ(b\ent)
					d = Sqr(dx * dx + dz * dz)
					room = foeRadius(a\kind) + foeRadius(b\kind)
					If d < room And d > 0.01
						a\vx = a\vx + dx / d * 0.02 : a\vz = a\vz + dz / d * 0.02
						b\vx = b\vx - dx / d * 0.02 : b\vz = b\vz - dz / d * 0.02
					EndIf
				EndIf
				b = After b
			Wend
		EndIf
	Next
End Function

Function CountFoes(kind)
	Local f.Foe, n = 0
	For f = Each Foe
		If f\kind = kind Or kind < 0 Then n = n + 1
	Next
	Return n
End Function

; Machines with no health left burst and are gone. When the Warden goes, everything it called goes with it.
Function RemoveDeadFoes()
	Local f.Foe, g.Foe, pass
	For pass = 1 To 2
		For f = Each Foe
			If f\hp <= 0
				If Not f\noScore
					score = score + foeScore(f\kind)
					kills = kills + 1
				EndIf
				Local x# = EntityX(f\ent), y# = EntityY(f\ent), z# = EntityZ(f\ent)
				If y > VOID_DEPTH
					BurstSparks(x, y, z, foeR(f\kind) + 80, foeG(f\kind) + 60, foeB(f\kind), 18, 0.14, 0.4)
					AddSpark(x, y, z, 0, 0, 0, 255, 190, 120, 18, foeRadius(f\kind), foeRadius(f\kind) * 0.15, 0)
					PlaySfxAt(sndDie, x, y, z)
				EndIf
				If f\kind = F_WARDEN
					For g = Each Foe
						If g <> f And g\hp > 0 Then g\hp = 0 : g\noScore = True
					Next
					BurstSparks(x, y, z, 255, 120, 220, 60, 0.35, 0.9)
					PlaySfx(sndBoom)
					boss = Null
				EndIf
				FreeEntity f\ent
				Delete f
			EndIf
		Next
	Next
End Function

; --- Waves -----------------------------------------------------------------------------------------------------------

Function UpdateWaves()
	Local k
	Select wavePhase
		Case PHASE_INTRO, PHASE_BREAK
			waveTimer = waveTimer - 1
			If waveTimer <= 0
				For k = 0 To FOE_KINDS - 1
					leftToSpawn(k) = waveFoes(sector, wave, k)
				Next
				wavePhase = PHASE_FIGHT
				spawnTimer = 0
				If leftToSpawn(F_WARDEN) > 0
					ShowBanner("The Warden", "Shoot the eye ball down!", 180)
				Else
					ShowBanner("Wave " + (wave + 1), "", 120)
				EndIf
				PlaySfx(sndWave)
			EndIf
		Case PHASE_FIGHT
			If spawnTimer > 0 Then spawnTimer = spawnTimer - 1
			If spawnTimer = 0 And LeftInWave() > 0 And CountFoes(-1) < diffAlive(optDifficulty) Then SpawnNext()
			If LeftInWave() = 0 And CountFoes(-1) = 0
				If wave = WAVES - 1
					wavePhase = PHASE_BREAK
					waveTimer = 999999
					StationCleared()
				Else
					wave = wave + 1
					wavePhase = PHASE_BREAK
					waveTimer = 200
					ShowBanner("Wave cleared", "Catch your breath", 150)
				EndIf
			EndIf
	End Select
End Function

Function LeftInWave()
	Local k, n = 0
	For k = 0 To FOE_KINDS - 1
		n = n + leftToSpawn(k)
	Next
	Return n
End Function

; Brings in the next machine of the wave, at a place some way from the player. The Warden comes first, over the
; middle of the arena; the others are picked at random from what is left.
Function SpawnNext()
	spawnTimer = 35
	Local kind
	If leftToSpawn(F_WARDEN) > 0
		kind = F_WARDEN
		boss = SpawnFoe(F_WARDEN, centreX, centreY, centreZ)
	Else
		Local pick = Rand(1, LeftInWave())
		For kind = 0 To FOE_KINDS - 1
			pick = pick - leftToSpawn(kind)
			If pick <= 0 Then Exit
		Next
		Local tries, i, best = 0, bestDist# = -1, d#
		For tries = 1 To 8
			i = Rand(0, spawnCount - 1)
			d = (spawnX(i) - gPX) * (spawnX(i) - gPX) + (spawnZ(i) - gPZ) * (spawnZ(i) - gPZ)
			If d > 14 * 14 Then best = i : Exit
			If d > bestDist Then bestDist = d : best = i
		Next
		Local y# = spawnY(best) + foeHeight(kind) + 0.1
		If kind = F_DRONE Then y = spawnY(best) + 4.5
		SpawnFoe(kind, spawnX(best), y, spawnZ(best))
	EndIf
	leftToSpawn(kind) = leftToSpawn(kind) - 1
End Function

; --- Sparks ----------------------------------------------------------------------------------------------------------

Function AddSpark(x#, y#, z#, vx#, vy#, vz#, r#, g#, b#, life, size#, grow#, fall#)
	If CountSparks >= 400 Then Return
	Local p.Spark = New Spark
	p\ent = MakeGlow(r, g, b, size)
	PositionEntity p\ent, x, y, z
	p\vx = vx : p\vy = vy : p\vz = vz
	p\life = life : p\maxLife = life
	p\size = size : p\grow = grow : p\fall = fall
	p\alpha = 1
	CountSparks = CountSparks + 1
End Function
Global CountSparks

Function BurstSparks(x#, y#, z#, r#, g#, b#, count, speed#, size#)
	Local i
	For i = 1 To count
		AddSpark(x, y, z, Rnd(-speed, speed), Rnd(-speed, speed) + speed * 0.3, Rnd(-speed, speed), r, g, b, Rand(14, 30), size * Rnd(0.5, 1.0), -size * 0.02, 0.004)
	Next
End Function

Function UpdateSparks()
	Local p.Spark
	For p = Each Spark
		p\life = p\life - 1
		If p\life <= 0
			FreeEntity p\ent
			Delete p
			If CountSparks > 0 Then CountSparks = CountSparks - 1
		Else
			If p\beam
				EntityAlpha p\ent, Float(p\life) / p\maxLife
			Else
				p\vy = p\vy - p\fall
				TranslateEntity p\ent, p\vx, p\vy, p\vz
				p\vx = p\vx * 0.95 : p\vy = p\vy * 0.95 : p\vz = p\vz * 0.95
				p\size = p\size + p\grow
				If p\size < 0.01 Then p\size = 0.01
				ScaleSprite p\ent, p\size, p\size
				EntityAlpha p\ent, Float(p\life) / p\maxLife
			EndIf
		EndIf
	Next
End Function

; --- Menus -----------------------------------------------------------------------------------------------------------
; A menu is a list of lines and the number of the selected one. The keyboard moves the selection, the mouse selects
; the line it is over. MenuInput gives back the line chosen with Enter, Space or a click, or -1.

Function MenuInput()
	If KeyHit(KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount : PlaySfx(sndClick)
	If KeyHit(KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount : PlaySfx(sndClick)

	Local row = MenuLineAt(MouseX(), MouseY())
	If row >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = row

	If KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Then Return menuSelected
	If MouseHit(1) And row >= 0
		menuSelected = row
		Return row
	EndIf
	Return -1
End Function

; Which line is at a screen position, or -1. Lines are 32 pixels apart and 400 wide.
Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 200 Or x >= SCREEN_W / 2 + 200 Or y < menuTop Then Return -1
	Local row = (y - menuTop) / 32
	If row >= menuCount Then Return -1
	Return row
End Function

; Everything that opens a menu goes through here: show the mouse again and forget old keys and clicks.
Function OpenMenu(newState, count, top)
	state = newState
	menuCount = count
	menuTop = top
	menuSelected = 0
	HideEntity overlay
	HideEntity muzzle
	ShowPointer
	FlushKeys
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
	MouseZSpeed()
End Function

Function GoToMenu()
	optionsFromPause = False
	If state <> STATE_MENU And state <> STATE_OPTIONS And state <> STATE_HELP Then BuildArena(0)
	OpenMenu(STATE_MENU, 4, 300)
	menuText(0) = "Start"
	menuText(1) = "Options"
	menuText(2) = "How to play"
	menuText(3) = "Quit"
	HideGuns()
End Function

Function HideGuns()
	Local w
	For w = 0 To WEAPONS - 1
		HideEntity gun(w)
	Next
End Function

; Gives back True when the player chose Quit.
Function UpdateMenu()
	UpdateMenuScene()
	If KeyHit(KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0 : NewGame()
		Case 1 : GoToOptions()
		Case 2 : OpenMenu(STATE_HELP, 0, 0)
		Case 3 : Return True
	End Select
	Return False
End Function

; Behind the menus the camera circles the first station.
Function UpdateMenuScene()
	menuAngle = menuAngle + 0.06
	PositionEntity camera, Sin(menuAngle) * 36, 16, -Cos(menuAngle) * 36
	PointEntity camera, CreatePivotAt(0, 0, 0)
	PositionEntity sky, EntityX(camera), EntityY(camera), EntityZ(camera)
	gPX = 0 : gPY = -1000 : gPZ = 0 ; Nobody is there to pick anything up.
	UpdateItems()
	UpdateSparks()
End Function

Function GoToPause()
	OpenMenu(STATE_PAUSED, 4, 280)
	menuText(0) = "Back to the fight"
	menuText(1) = "Options"
	menuText(2) = "Start this station again"
	menuText(3) = "Give up, back to the main menu"
End Function

Function UpdatePause()
	Select MenuInput()
		Case 0 : StartPlaying()
		Case 1 : GoToOptions()
		Case 2
			RestoreSectorStart()
			StartSector()
		Case 3
			If score > bestScore Then bestScore = score : SaveSettings()
			GoToMenu()
	End Select
	If (KeyHit(KEY_ESCAPE) Or KeyHit(KEY_P)) And state = STATE_PAUSED Then StartPlaying()
End Function

Function UpdateDead()
	; The view sinks to the floor.
	If EntityY(camera) > gPY - PLAYER_HALF + 0.3 Then TranslateEntity camera, 0, -0.03, 0
	TurnEntity camera, 0, 0, 0.3
	UpdateSparks()
	Select MenuInput()
		Case 0
			RestoreSectorStart()
			StartSector()
		Case 1 : GoToMenu()
	End Select
End Function

Function UpdateClear()
	UpdateSparks()
	Local choice = MenuInput()
	If KeyHit(KEY_ESCAPE) Then choice = 1
	Select choice
		Case 0
			sector = sector + 1
			SaveSectorStart()
			StartSector()
		Case 1
			If score > bestScore Then bestScore = score : SaveSettings()
			GoToMenu()
	End Select
End Function

Function UpdateWon()
	UpdateSparks()
	If frame Mod 20 = 0 Then BurstSparks(centreX + Rnd(-12, 12), centreY + Rnd(-2, 6), centreZ + Rnd(-12, 12), Rnd(100, 255), Rnd(100, 255), Rnd(100, 255), 20, 0.2, 0.5)
	If MenuInput() = 0 Or KeyHit(KEY_ESCAPE) Then GoToMenu()
End Function

Function GoToOptions()
	optionsFromPause = (state = STATE_PAUSED)
	OpenMenu(STATE_OPTIONS, 8, 210)
	RefreshOptionsText()
End Function

Function RefreshOptionsText()
	menuText(0) = "Mouse speed: " + optSensitivity
	If optInvert Then menuText(1) = "Mouse up looks: down" Else menuText(1) = "Mouse up looks: up"
	menuText(2) = "Field of view: " + fovName(optFov)
	menuText(3) = "Difficulty: " + diffName(optDifficulty)
	menuText(4) = "Sound volume: " + (optVolume * 25) + "%"
	If optSway Then menuText(5) = "Gun sways when running: yes" Else menuText(5) = "Gun sways when running: no"
	If optionsFromPause
		menuText(6) = "Display: change it in the main menu"
	ElseIf optFullscreen
		menuText(6) = "Display: full screen"
	Else
		menuText(6) = "Display: window"
	EndIf
	menuText(7) = "Back"
End Function

Function UpdateOptions()
	If Not optionsFromPause Then UpdateMenuScene()
	Local change = 0
	If KeyHit(KEY_LEFT) Then change = -1
	If KeyHit(KEY_RIGHT) Then change = 1
	Local picked = MenuInput()
	If picked >= 0 Then change = 1 ; Enter or a click steps to the next value.

	If KeyHit(KEY_ESCAPE) Or picked = 7
		SaveSettings()
		If optionsFromPause
			GoToPause()
			menuSelected = 1
		Else
			GoToMenu()
			menuSelected = 1
		EndIf
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optSensitivity = (optSensitivity - 1 + change + 10) Mod 10 + 1
		Case 1 : optInvert = Not optInvert
		Case 2 : optFov = (optFov + change + 3) Mod 3
		Case 3 : optDifficulty = (optDifficulty + change + 3) Mod 3
		Case 4 : optVolume = (optVolume + change + 5) Mod 5
		Case 5 : optSway = Not optSway
		Case 6
			; Opening the screen again frees the whole arena, so this can only be done from the main menu.
			If Not optionsFromPause
				optFullscreen = Not optFullscreen
				OpenScreen()
				HideGuns()
			EndIf
	End Select
	ApplyCameraOptions()
	PlaySfx(sndClick)
	RefreshOptionsText()
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	; Space, with the watermark in it, then the world on top. The camera only clears the depth buffer.
	ClsColor SKY_R, SKY_G, SKY_B
	Cls
	DrawWatermark(SKY_R, SKY_G, SKY_B)

	If state = STATE_PLAY And hurtFlash > 0.01
		ShowEntity overlay
		EntityAlpha overlay, hurtFlash
		hurtFlash = hurtFlash * 0.92
	Else
		HideEntity overlay
	EndIf
	RenderWorld

	Select state
		Case STATE_MENU
			DrawTitle("HULLBREACH", 150)
			SmallText(SCREEN_W / 2, 215, "Hold three stations against the machines", True)
			DrawMenu()
			If bestScore > 0 Then SmallText(SCREEN_W / 2, 445, "Best score: " + bestScore, True)
		Case STATE_OPTIONS
			If optionsFromPause Then DrawHud()
			ShadeScreen()
			DrawTitle("Options", 150)
			DrawMenu()
			SmallText(SCREEN_W / 2, 480, "Left/Right or a click change the selected option.", True)
		Case STATE_HELP
			ShadeScreen()
			DrawHelp()
		Case STATE_PLAY
			DrawHud()
		Case STATE_PAUSED
			DrawHud()
			ShadeScreen()
			DrawTitle("Paused", 200)
			DrawMenu()
		Case STATE_DEAD
			ShadeScreen()
			DrawTitle("You were taken apart", 200)
			SmallText(SCREEN_W / 2, 270, "Station " + (sector + 1) + ", wave " + (wave + 1) + ".  Score: " + score, True)
			DrawMenu()
		Case STATE_CLEAR
			ShadeScreen()
			DrawTitle("Station " + (sector + 1) + " is safe", 170)
			DrawStats(240)
			DrawMenu()
		Case STATE_WON
			ShadeScreen()
			DrawTitle("All stations are safe", 150)
			DrawStats(220)
			If score >= bestScore Then BigText(SCREEN_W / 2, 375, "A new best score!", 255, 230, 120)
			DrawMenu()
	End Select

	If state = STATE_MENU Or state = STATE_OPTIONS Or state = STATE_HELP
		Color 110, 120, 170
		Text SCREEN_W / 2, SCREEN_H - 24, "A BlitzLLVM sample game", True, True
	EndIf
End Function

Function DrawStats(y)
	SmallText(SCREEN_W / 2, y, "Station bonus: " + clearBonus + "    Time bonus: " + timeBonus, True)
	SmallText(SCREEN_W / 2, y + 24, "Machines destroyed: " + kills + "    Accuracy: " + Accuracy() + "%", True)
	SmallText(SCREEN_W / 2, y + 48, "Time played: " + TimeText(playTicks), True)
	BigText(SCREEN_W / 2, y + 95, "Score: " + score, 255, 255, 255)
End Function

Function Accuracy()
	If shotsFired = 0 Then Return 0
	Return Int(Min(100.0 * shotsHit / shotsFired, 100))
End Function

Function TimeText$(updates)
	Local seconds = updates / 60
	Local text$ = (seconds Mod 60)
	If Len(text) < 2 Then text = "0" + text
	Return (seconds / 60) + ":" + text
End Function

Function DrawHud()
	Local cx = SCREEN_W / 2, cy = SCREEN_H / 2
	; The crosshair, and a little cross around it for a moment after a hit.
	Color 255, 255, 255
	Rect cx - 10, cy, 6, 1, 1
	Rect cx + 5, cy, 6, 1, 1
	Rect cx, cy - 10, 1, 6, 1
	Rect cx, cy + 5, 1, 6, 1
	If hitMarker > 0
		Color 255, 220, 120
		Line cx - 9, cy - 9, cx - 5, cy - 5
		Line cx + 9, cy - 9, cx + 5, cy - 5
		Line cx - 9, cy + 9, cx - 5, cy + 5
		Line cx + 9, cy + 9, cx + 5, cy + 5
	EndIf

	; Health and armour on the left, ammunition on the right.
	Local hr = 255, hg = 255, hb = 255
	If health <= 25 And (frame / 15) Mod 2 = 0 Then hr = 255 : hg = 80 : hb = 80
	SmallText(24, SCREEN_H - 78, "HEALTH", False)
	BigText(64, SCREEN_H - 42, Int(Max(health, 0)), hr, hg, hb)
	SmallText(150, SCREEN_H - 78, "ARMOUR", False)
	BigText(190, SCREEN_H - 42, Int(armor), 140, 255, 180)

	SmallText(SCREEN_W - 140, SCREEN_H - 78, Upper(weaponName(weapon)), False)
	If weapon = W_BLASTER
		BigText(SCREEN_W - 100, SCREEN_H - 42, "--", 160, 220, 255)
	Else
		If ammo(weapon) = 0 Then BigText(SCREEN_W - 100, SCREEN_H - 42, 0, 255, 90, 80) Else BigText(SCREEN_W - 100, SCREEN_H - 42, ammo(weapon), 255, 230, 150)
	EndIf

	; The guns: lit when the player has them, framed when chosen.
	Local w, x
	SetFont helpFont
	For w = 0 To WEAPONS - 1
		x = cx - 196 + w * 98
		If w = weapon
			Color 255, 230, 150
			Rect x, SCREEN_H - 34, 94, 24, 0
		EndIf
		If owned(w) Then Color 220, 230, 245 Else Color 70, 75, 90
		Text x + 47, SCREEN_H - 22, (w + 1) + " " + weaponName(w), True, True
	Next

	; Where the fight stands, top left; the score, top right.
	SmallText(16, 14, "Station " + (sector + 1) + ": " + arenaName, False)
	If wavePhase = PHASE_FIGHT
		SmallText(16, 36, "Wave " + (wave + 1) + " of " + WAVES + "    Machines left: " + (LeftInWave() + CountFoes(-1)), False)
	EndIf
	SetFont hudFont
	Local scoreText$ = "Score " + score
	Color 0, 0, 0
	Text SCREEN_W - 15 - StringWidth(scoreText), 15, scoreText
	Color 255, 255, 255
	Text SCREEN_W - 16 - StringWidth(scoreText), 14, scoreText
	SetFont 0

	; The Warden's health.
	If boss <> Null
		Local part# = Max(boss\hp, 0) / (foeHp(F_WARDEN) * diffBoss(optDifficulty))
		Color 20, 10, 30
		Rect cx - 200, 60, 400, 14, 1
		Color 255, 60, 200
		Rect cx - 198, 62, Int(396 * part), 10, 1
		SmallText(cx, 50, "THE WARDEN", True)
	EndIf

	If bannerTimer > 0
		If bannerText <> "" Then BigText(cx, 170, bannerText, 255, 240, 200)
		If bannerSmall <> "" Then SmallText(cx, 215, bannerSmall, True)
	EndIf
	SetFont 0
End Function

; Text with a dark shadow, so it can be read over anything.
Function SmallText(x, y, text$, centred)
	SetFont helpFont
	Color 0, 0, 0
	Text x + 1, y + 1, text, centred, True
	Color 225, 232, 245
	Text x, y, text, centred, True
	SetFont 0
End Function

Function BigText(x, y, text$, r, g, b)
	SetFont bigFont
	Color 0, 0, 0
	Text x + 2, y + 2, text, True, True
	Color r, g, b
	Text x, y, text, True, True
	SetFont 0
End Function

; Darkens the picture behind a menu, so the text is easy to read: a black rectangle drawn with every other pixel.
Global shadeImage
Function ShadeScreen()
	If shadeImage = 0
		shadeImage = CreateImage(SCREEN_W, SCREEN_H)
		Local buffer = ImageBuffer(shadeImage), x, y
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				If (x + y) Mod 2 = 0 Then WritePixelFast x, y, $0C0A1A, buffer Else WritePixelFast x, y, 0, buffer
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage shadeImage, 0, 0
End Function

Function DrawTitle(text$, y)
	Local dx, dy
	SetFont titleFont
	Color 60, 20, 40
	For dy = -3 To 3 Step 3
		For dx = -3 To 3 Step 3
			Text SCREEN_W / 2 + dx, y + dy, text, True, True
		Next
	Next
	Color 255, 150, 70
	Text SCREEN_W / 2, y, text, True, True
	SetFont 0
End Function

Function DrawMenu()
	Local i, y
	For i = 0 To menuCount - 1
		y = menuTop + i * 32
		If i = menuSelected
			Color 120, 50, 30
			Rect SCREEN_W / 2 - 200, y, 400, 28, 1
			Color 255, 160, 90
			Rect SCREEN_W / 2 - 200, y, 400, 28, 0
			Color 255, 245, 225
		Else
			Color 20, 22, 40
			Rect SCREEN_W / 2 - 200, y, 400, 28, 1
			Color 205, 212, 235
		EndIf
		SetFont menuFont
		Text SCREEN_W / 2, y + 14, menuText(i), True, True
		SetFont 0
	Next
End Function

Function DrawHelp()
	DrawTitle("How to play", 90)
	Local y = 150, i, helpLine$
	Restore HelpText
	SetFont helpFont
	For i = 1 To 16
		Read helpLine
		Color 230, 235, 245
		Text 110, y, helpLine
		y = y + 20
	Next
	SetFont 0
	SmallText(SCREEN_W / 2, 500, "Press Enter or click to go back.", True)
End Function

; --- Watermark -------------------------------------------------------------------------------------------------------
; Every frame carries a faint pattern that nobody can see: some pixels of space are one step bluer than the rest. A
; program can find the pattern again in a screenshot, which shows that the picture came from this sample game. The
; pattern is drawn as a masked image just after Cls, so the world is drawn over it.

Global watermark, watermarkColor ; DrawWatermark makes the image the first time it is needed.

Function DrawWatermark(r, g, b)
	Local rgb = (r Shl 16) Or (g Shl 8) Or b
	If watermark = 0 Or rgb <> watermarkColor
		If watermark <> 0 Then FreeImage watermark
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		watermarkColor = rgb
		Local marked = b + 1
		If b = 255 Then marked = 254
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				; Black is the mask colour, so only the marked pixels are drawn.
				If (x * 7 + y * 13) Mod 29 < 3
					WritePixelFast x, y, (r Shl 16) Or (g Shl 8) Or marked, buffer
				Else
					WritePixelFast x, y, 0, buffer
				EndIf
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function

; --- Pictures --------------------------------------------------------------------------------------------------------

Function MakeTextures()
	SeedRnd 4321
	Local x, y, n#, v#, r#, g#, b#, d#, buffer

	; Deck plates: grey panels with dark seams, bolts at the corners and a faint scuffed look.
	texDeck = CreateTexture(128, 128)
	buffer = TextureBuffer(texDeck)
	LockBuffer buffer
	For y = 0 To 127
		For x = 0 To 127
			n = Rnd(-1, 1)
			v = 92 + n * 7
			If x Mod 64 < 2 Or y Mod 64 < 2 Then v = 46
			If (x Mod 64 = 2 Or y Mod 64 = 2) Then v = 120
			If x Mod 32 = 16 And y Mod 64 > 6 And y Mod 64 < 58 Then v = v - 12
			If (x Mod 64 > 5 And x Mod 64 < 9) And (y Mod 64 > 5 And y Mod 64 < 9) Then v = 140
			If (x Mod 64 > 55 And x Mod 64 < 59) And (y Mod 64 > 55 And y Mod 64 < 59) Then v = 140
			WritePixelFast x, y, ColorValue(v, v + 2, v + 8), buffer
		Next
	Next
	UnlockBuffer buffer

	; Wall plates: dark blue-grey, in rows, with a darker band.
	texWall = CreateTexture(128, 128)
	buffer = TextureBuffer(texWall)
	LockBuffer buffer
	For y = 0 To 127
		For x = 0 To 127
			n = Rnd(-1, 1)
			v = 62 + n * 5
			If y Mod 32 < 2 Then v = 30
			If x Mod 64 < 2 Then v = 34
			If y Mod 32 > 20 And y Mod 32 < 26 Then v = v - 16
			WritePixelFast x, y, ColorValue(v, v + 6, v + 22), buffer
		Next
	Next
	UnlockBuffer buffer

	; Crates: orange, with a frame and a cross brace.
	texCrate = CreateTexture(64, 64)
	buffer = TextureBuffer(texCrate)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			n = Rnd(-1, 1)
			r = 180 + n * 12 : g = 110 + n * 8 : b = 40
			If x < 5 Or y < 5 Or x > 58 Or y > 58 Or Abs(x - y) < 3 Or Abs(x + y - 63) < 3
				r = 90 + n * 8 : g = 60 : b = 30
			EndIf
			WritePixelFast x, y, ColorValue(r, g, b), buffer
		Next
	Next
	UnlockBuffer buffer

	; Light panels: nearly white, tinted by the arena's colour; thin darker lines make them look like tubes.
	texPanel = CreateTexture(32, 32)
	buffer = TextureBuffer(texPanel)
	LockBuffer buffer
	For y = 0 To 31
		For x = 0 To 31
			v = 255
			If y Mod 8 = 0 Then v = 170
			WritePixelFast x, y, ColorValue(v, v, v), buffer
		Next
	Next
	UnlockBuffer buffer

	; A soft round glow for sparks, shots and lights. Added on top, so black is nothing.
	texGlow = CreateTexture(64, 64)
	buffer = TextureBuffer(texGlow)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			d = Sqr((x - 31.5) * (x - 31.5) + (y - 31.5) * (y - 31.5)) / 32.0
			v = 0
			If d < 1 Then v = (1 - d) * (1 - d) * 255
			WritePixelFast x, y, ColorValue(v, v, v), buffer
		Next
	Next
	UnlockBuffer buffer

	; A gas giant: wavy bands of rust and cream.
	texPlanet = CreateTexture(256, 128)
	buffer = TextureBuffer(texPlanet)
	LockBuffer buffer
	For y = 0 To 127
		For x = 0 To 255
			v = Sin(y * 9.0 + Sin(x * 1.4 + y * 3.0) * 30 + Sin(y * 23.0) * 20) * 0.5 + 0.5
			n = Rnd(-1, 1) * 6
			r = 150 + v * 90 + n : g = 90 + v * 80 + n : b = 60 + v * 50 + n
			WritePixelFast x, y, ColorValue(r, g, b), buffer
		Next
	Next
	UnlockBuffer buffer

	; A cloud of gas: a few soft blobs with grain in them.
	texNebula = CreateTexture(128, 128)
	buffer = TextureBuffer(texNebula)
	LockBuffer buffer
	Local i
	For i = 0 To 5
		blobX(i) = Rnd(35, 93) : blobY(i) = Rnd(35, 93) : blobR(i) = Rnd(18, 34)
	Next
	For y = 0 To 127
		For x = 0 To 127
			v = 0
			For i = 0 To 5
				d = Sqr((x - blobX(i)) * (x - blobX(i)) + (y - blobY(i)) * (y - blobY(i))) / blobR(i)
				If d < 1 Then v = v + (1 - d) * (1 - d)
			Next
			d = Sqr((x - 63.5) * (x - 63.5) + (y - 63.5) * (y - 63.5)) / 64.0
			If d > 1 Then d = 1
			v = v * (1 - d) * Rnd(0.8, 1.0) * 160
			WritePixelFast x, y, ColorValue(v, v, v), buffer
		Next
	Next
	UnlockBuffer buffer
	SeedRnd MilliSecs()
End Function

; A colour for WritePixelFast, with every part kept between 0 and 255.
Function ColorValue(r#, g#, b#)
	If r < 0 Then r = 0
	If g < 0 Then g = 0
	If b < 0 Then b = 0
	If r > 255 Then r = 255
	If g > 255 Then g = 255
	If b > 255 Then b = 255
	Return $FF000000 Or (Int(r) Shl 16) Or (Int(g) Shl 8) Or Int(b)
End Function

; --- Sounds ----------------------------------------------------------------------------------------------------------
; A short sound made sample by sample into a WAV file in a bank, written to a temporary file and loaded from there.

Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0, i, t#, hz#, v#, envelope#, held# = 0
	For i = 0 To samples - 1
		t = Float(i) / samples
		hz = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1
			Case WAVE_SINE
				v = Sin(phase)
			Default
				; Noise that changes at the given pitch: low pitches rumble, high ones hiss.
				If phase < 360.0 * hz / rate Then held = Rnd(-1, 1)
				v = held
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		envelope = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.3 Then envelope = envelope * (1.0 - t) / 0.7
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "hullbreach-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

