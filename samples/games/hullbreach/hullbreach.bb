; --- Screen and settings ---------------------------------------------------------------------------------------------

; Opens the window or full screen, as the option says. Graphics3D frees every entity, texture and font, so all of them
; are made again here, and the arena behind the main menu is built again.
Function OpenScreen()
	If optFullscreen Then Graphics3D SCREEN_W, SCREEN_H, 0, 1 Else Graphics3D SCREEN_W, SCREEN_H, 0, 2
	AppTitle "Hullbreach"
	SetBuffer BackBuffer()

	; The old entities are gone; forget them.
	Delete Each Foe
	Delete Each Shot
	Delete Each Spark
	Delete Each Item
	boss = Null
	arena = 0
	padCount = 0
	aimPivot = 0
	CountSparks = 0

	MakeTextures()
	titleFont = LoadFont("Arial", 56, True)
	menuFont = LoadFont("Arial", 18, True)
	helpFont = LoadFont("Arial", 16)
	hudFont = LoadFont("Arial", 18, True)
	bigFont = LoadFont("Arial", 40, True)

	camera = CreateCamera()
	CameraRange camera, 0.05, 2000
	; Space and the watermark are drawn by Cls before RenderWorld, so the camera only clears depth.
	CameraClsMode camera, False, True
	ApplyCameraOptions()

	sun = CreateLight()
	RotateEntity sun, 35, -40, 0
	AmbientLight 95, 95, 115

	MakeSky()

	; A red sheet just in front of the eyes, seen when the player is hurt. EntityOrder draws it over everything.
	overlay = CreateSprite(camera)
	PositionEntity overlay, 0, 0, 1
	ScaleSprite overlay, 2, 2
	EntityColor overlay, 255, 30, 20
	EntityOrder overlay, -1
	EntityFX overlay, 1 + 8
	HideEntity overlay

	gunPivot = CreatePivot(camera)
	ScaleEntity gunPivot, 0.6, 0.6, 0.6
	Local w
	For w = 0 To WEAPONS - 1
		gun(w) = MakeGun(w, gunPivot)
		HideEntity gun(w)
	Next
	muzzle = CreateSprite(gunPivot)
	EntityTexture muzzle, texGlow
	EntityBlend muzzle, 3
	EntityFX muzzle, 1 + 8
	ScaleSprite muzzle, 0.14, 0.14
	HideEntity muzzle

	Local k
	For k = 0 To FOE_KINDS - 1
		foeTemplate(k) = MakeFoeTemplate(k)
		HideEntity foeTemplate(k)
	Next

	player = CreatePivot()
	EntityType player, COL_PLAYER
	EntityRadius player, PLAYER_RADIUS, PLAYER_HALF
	Collisions COL_PLAYER, COL_WORLD, 2, 3
	Collisions COL_FOE, COL_WORLD, 2, 3

	BuildArena(0)
	watermark = 0
	shadeImage = 0
End Function

Function ApplyCameraOptions()
	CameraZoom camera, fovZoom(optFov)
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	If ReadInt(file) = 1 ; A version number, so a changed file format can be recognised later.
		optSensitivity = ReadInt(file)
		optInvert = ReadInt(file)
		optFov = ReadInt(file)
		optDifficulty = ReadInt(file)
		optVolume = ReadInt(file)
		optSway = ReadInt(file)
		optFullscreen = ReadInt(file)
		bestScore = ReadInt(file)
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optSensitivity < 1 Or optSensitivity > 10 Then optSensitivity = 5
	If optFov < 0 Or optFov > 2 Then optFov = 1
	If optDifficulty < 0 Or optDifficulty > 2 Then optDifficulty = 1
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
	If bestScore < 0 Then bestScore = 0
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets the options.
	WriteInt file, 1
	WriteInt file, optSensitivity
	WriteInt file, optInvert
	WriteInt file, optFov
	WriteInt file, optDifficulty
	WriteInt file, optVolume
	WriteInt file, optSway
	WriteInt file, optFullscreen
	WriteInt file, bestScore
	CloseFile file
End Function

; Every sound goes through here, so the volume option works everywhere.
Function PlaySfx(sound, volume# = 1.0)
	If sound = 0 Or optVolume = 0 Then Return
	Local channel = PlaySound(sound)
	ChannelVolume channel, volume * optVolume / 4.0
End Function

; A sound from a place in the arena: quieter further away.
Function PlaySfxAt(sound, x#, y#, z#)
	Local d# = Distance(x, y, z, gPX, gPY, gPZ)
	Local volume# = 1.0 - d / 60.0
	If volume > 0.05 Then PlaySfx(sound, volume)
End Function

