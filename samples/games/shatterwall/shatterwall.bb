; Shatterwall: knock down every brick with a ball and a paddle.
;
; Every picture and sound in this game is made by the code itself, so there are no files to ship with it.
;
; Controls:
;   Mouse or Left/Right   move the paddle
;   Left click or Space   launch the ball
;   P                     pause
;   Escape                back to the menu, or quit from there
;   Menus                 Up/Down or the mouse choose, Enter/Space or a click select, Left/Right change an option
;
; Bricks: the number of stripes shows how many hits a brick needs. Grey bricks cannot be broken. Bricks with a
; dot always drop a capsule. Capsules: W = wider paddle, M = more balls, S = slower balls, + = an extra life.
;
; The options and the best score are saved in shatterwall.cfg next to the program.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Const SCREEN_W = 800, SCREEN_H = 600
Const FIELD_LEFT = 36, FIELD_RIGHT = 764, FIELD_TOP = 60 ; 14 bricks of 52 pixels fill the field exactly.
Const BRICK_COLUMNS = 14, BRICK_ROWS = 9, BRICK_W = 52, BRICK_H = 20, BRICK_GAP = 2
Const BRICKS_TOP = 100
Const PADDLE_Y = 550, PADDLE_H = 14, PADDLE_W_NORMAL = 100, PADDLE_W_WIDE = 160, PADDLE_SPEED# = 10
Const BALL_SIZE = 10, BALL_SPEED# = 6.5, BALL_SPEED_MAX# = 11
Const MAX_BALLS = 8
Const LEVEL_COUNT = 5

Const STATE_MENU = 0, STATE_OPTIONS = 1, STATE_HELP = 2, STATE_PLAY = 3, STATE_PAUSED = 4, STATE_CLEARED = 5
Const STATE_OVER = 6, STATE_WON = 7

Const KEY_ESCAPE = 1, KEY_P = 25, KEY_ENTER = 28, KEY_SPACE = 57
Const KEY_UP = 200, KEY_DOWN = 208, KEY_LEFT = 203, KEY_RIGHT = 205

; Brick kinds as stored in the level grid.
Const BRICK_NONE = 0, BRICK_SOLID = 9 ; 1 to 4 are normal bricks that need that many hits.

Const POWER_WIDE = 1, POWER_MULTI = 2, POWER_SLOW = 3, POWER_LIFE = 4

Type Ball
	Field x#, y#, vx#, vy#
	Field stuck          ; True while it rests on the paddle before launch.
	Field stuckOffset#   ; Where on the paddle it rests.
End Type

Type Capsule
	Field x#, y#
	Field kind
End Type

Type Shard
	Field x#, y#, vx#, vy#
	Field life#
	Field r, g, b
End Type

Type Popup
	Field x#, y#
	Field message$
	Field life
End Type

Dim bricks(BRICK_COLUMNS - 1, BRICK_ROWS - 1)
Dim brickDrops(BRICK_COLUMNS - 1, BRICK_ROWS - 1) ; The capsule a brick always drops, or 0.

; --- Options -----------------------------------------------------------------------------------------------------
Global optDifficulty = 1   ; 0 easy, 1 normal, 2 hard.
Global optVolume = 4       ; 0 to 4, in quarters.
Global optShake = True
Global optFullscreen = False
Dim difficultyName$(2), startLives(2), difficultySpeed#(2)
difficultyName(0) = "Easy" : startLives(0) = 5 : difficultySpeed(0) = 0.85
difficultyName(1) = "Normal" : startLives(1) = 3 : difficultySpeed(1) = 1.0
difficultyName(2) = "Hard" : startLives(2) = 2 : difficultySpeed(2) = 1.15
Dim bestScore(2) ; One best score per difficulty.

Global settingsPath$ = SystemProperty$("appdir")
If settingsPath <> "" And Right(settingsPath, 1) <> "\" And Right(settingsPath, 1) <> "/" Then settingsPath = settingsPath + "/"
settingsPath = settingsPath + "shatterwall.cfg"
LoadSettings()

; --- Game ----------------------------------------------------------------------------------------------------------
Global state = STATE_MENU
Global level, lives, score
Global paddleX#, paddleW#, wideTimer, slowTimer
Global speedScale# = 1.0
Global shake#
Global lastMouseX
Global framesWithoutBrick  ; Counts up while no brick is hit, for the aim help.

Dim menuText$(7)
Global menuCount, menuSelected, menuTop

Global background
OpenScreen()

Const WAVE_SQUARE = 0, WAVE_SINE = 1, WAVE_NOISE = 2
Global soundPaddle = MakeSound(300, 420, 50, WAVE_SQUARE, 0.25)
Global soundBrick = MakeSound(880, 660, 60, WAVE_SQUARE, 0.2)
Global soundSolid = MakeSound(180, 160, 70, WAVE_SQUARE, 0.25)
Global soundBreak = MakeSound(1200, 300, 120, WAVE_NOISE, 0.25)
Global soundPower = MakeSound(400, 1600, 250, WAVE_SINE, 0.35)
Global soundLose = MakeSound(400, 80, 600, WAVE_SQUARE, 0.25)
Global soundCleared = MakeSound(520, 1560, 700, WAVE_SINE, 0.35)

Local timer = CreateTimer(60)
lastMouseX = MouseX()

GoToMenu()
Local quit = False
While Not quit
	WaitTimer timer

	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_HELP
			If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Or MouseHit(1) Then GoToMenu()
		Case STATE_PLAY
			UpdatePaddle()
			UpdateBalls()
			UpdateCapsules()
			CheckCleared() ; Checked here, after all balls moved, because clearing the level removes the balls.
			If KeyHit(KEY_P) Then state = STATE_PAUSED
		Case STATE_PAUSED
			If KeyHit(KEY_P) Then state = STATE_PLAY
		Case STATE_CLEARED, STATE_OVER, STATE_WON
			If KeyHit(KEY_SPACE) Or KeyHit(KEY_ENTER) Or MouseHit(1)
				If state = STATE_CLEARED
					StartLevel(level + 1)
				Else
					GoToMenu()
				EndIf
			EndIf
	End Select
	If state >= STATE_PLAY And KeyHit(KEY_ESCAPE)
		If score > bestScore(optDifficulty) Then bestScore(optDifficulty) = score : SaveSettings()
		GoToMenu()
	EndIf

	UpdateEffects()
	DrawGame()
	Flip 0
Wend

End

; --- Screen and settings -------------------------------------------------------------------------------------------

; Opens the window or full screen, as the option says. Graphics frees all images, so the background is made again.
Function OpenScreen()
	If optFullscreen Then Graphics SCREEN_W, SCREEN_H, 0, 1 Else Graphics SCREEN_W, SCREEN_H, 0, 2
	AppTitle "Shatterwall"
	SetBuffer BackBuffer()
	SeedRnd MilliSecs()
	background = MakeBackground()
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	If ReadInt(file) = 1 ; A version number, so a changed file format can be recognised later.
		optDifficulty = ReadInt(file)
		optVolume = ReadInt(file)
		optShake = ReadInt(file)
		optFullscreen = ReadInt(file)
		Local i
		For i = 0 To 2
			bestScore(i) = ReadInt(file)
		Next
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optDifficulty < 0 Or optDifficulty > 2 Then optDifficulty = 1
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets the options.
	WriteInt file, 1
	WriteInt file, optDifficulty
	WriteInt file, optVolume
	WriteInt file, optShake
	WriteInt file, optFullscreen
	Local i
	For i = 0 To 2
		WriteInt file, bestScore(i)
	Next
	CloseFile file
End Function

; Every sound goes through here, so the volume option works everywhere.
Function PlaySfx(sound)
	If sound = 0 Or optVolume = 0 Then Return
	Local channel = PlaySound(sound)
	ChannelVolume channel, optVolume / 4.0
End Function

; --- Menus ---------------------------------------------------------------------------------------------------------
; A menu is a list of lines and the number of the selected one. The keyboard moves the selection, the mouse selects
; the line it is over. MenuInput gives back the line chosen with Enter, Space or a click, or -1.

Function MenuInput()
	If KeyHit(KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount : PlaySfx(soundPaddle)
	If KeyHit(KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount : PlaySfx(soundPaddle)

	Local line = MenuLineAt(MouseX(), MouseY())
	If line >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = line

	If KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Then Return menuSelected
	If MouseHit(1) And line >= 0
		menuSelected = line
		Return line
	EndIf
	Return -1
End Function

; Which line is at a screen position, or -1. Lines are 30 pixels apart and 360 wide.
Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 180 Or x >= SCREEN_W / 2 + 180 Or y < menuTop Then Return -1
	Local line = (y - menuTop) / 30
	If line >= menuCount Then Return -1
	Return line
End Function

Function DrawMenu()
	Local i, y
	For i = 0 To menuCount - 1
		y = menuTop + i * 30
		If i = menuSelected
			Color 40, 90, 170
			Rect SCREEN_W / 2 - 180, y, 360, 26, 1
			Color 255, 240, 200
		Else
			Color 200, 205, 230
		EndIf
		Text SCREEN_W / 2, y + 13, menuText(i), True, True
	Next
End Function

Function GoToMenu()
	state = STATE_MENU
	menuCount = 4
	menuTop = 290
	menuSelected = 0
	menuText(0) = "Play (" + difficultyName(optDifficulty) + ")"
	menuText(1) = "Options"
	menuText(2) = "How to play"
	menuText(3) = "Quit"
	Delete Each Ball
	Delete Each Capsule
	Delete Each Popup
	; Forget keys pressed during a game, so they do not act on the menu too.
	FlushKeys
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

; Gives back True when the player chose Quit.
Function UpdateMenu()
	If KeyHit(KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0 : StartGame()
		Case 1 : GoToOptions()
		Case 2
			state = STATE_HELP
			FlushKeys
			FlushMouse
		Case 3 : Return True
	End Select
	Return False
End Function

Function GoToOptions()
	state = STATE_OPTIONS
	menuCount = 5
	menuTop = 260
	menuSelected = 0
	RefreshOptionsText()
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

Function RefreshOptionsText()
	menuText(0) = "Difficulty: " + difficultyName(optDifficulty) + " (" + startLives(optDifficulty) + " lives)"
	menuText(1) = "Sound volume: " + (optVolume * 25) + "%"
	If optShake Then menuText(2) = "Screen shake: on" Else menuText(2) = "Screen shake: off"
	If optFullscreen Then menuText(3) = "Display: full screen" Else menuText(3) = "Display: window"
	menuText(4) = "Back"
End Function

Function UpdateOptions()
	Local change = 0
	If KeyHit(KEY_LEFT) Then change = -1
	If KeyHit(KEY_RIGHT) Then change = 1
	Local chosen = MenuInput()
	If chosen >= 0 Then change = 1 ; Enter or a click steps to the next value.

	If KeyHit(KEY_ESCAPE) Or chosen = 4
		SaveSettings()
		GoToMenu()
		menuSelected = 1 ; Back on "Options".
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optDifficulty = (optDifficulty + change + 3) Mod 3
		Case 1 : optVolume = (optVolume + change + 5) Mod 5
		Case 2 : optShake = Not optShake
		Case 3
			optFullscreen = Not optFullscreen
			OpenScreen()
	End Select
	PlaySfx(soundPaddle)
	RefreshOptionsText()
End Function

; --- Game flow -------------------------------------------------------------------------------------------------------

Function StartGame()
	score = 0
	lives = startLives(optDifficulty)
	FlushKeys : FlushMouse
	StartLevel(1)
End Function

Function StartLevel(number)
	level = number
	LoadLevel(level)
	Delete Each Capsule
	Delete Each Ball
	wideTimer = 0 : slowTimer = 0
	paddleW = Float(PADDLE_W_NORMAL)
	paddleX = (FIELD_LEFT + FIELD_RIGHT - paddleW) / 2
	speedScale = difficultySpeed(optDifficulty) * (1.0 + (level - 1) * 0.08) ; Each level is a little faster.
	framesWithoutBrick = 0
	NewStuckBall()
	AddPopup(Float(SCREEN_W / 2), 380, "Level " + level)
	state = STATE_PLAY
End Function

Function LoseLife()
	lives = lives - 1
	If optShake Then shake = 14
	PlaySfx(soundLose)
	Delete Each Capsule
	wideTimer = 0 : slowTimer = 0
	If lives <= 0
		state = STATE_OVER
		SaveBest()
	Else
		NewStuckBall()
	EndIf
End Function

Function CheckCleared()
	Local y%
	Local x%
	For y = 0 To BRICK_ROWS - 1
		For x = 0 To BRICK_COLUMNS - 1
			If bricks(x, y) >= 1 And bricks(x, y) <= 4 Then Return
		Next
	Next
	Delete Each Ball
	Delete Each Capsule
	score = score + 1000 * level
	PlaySfx(soundCleared)
	If level = LEVEL_COUNT
		state = STATE_WON
		SaveBest()
	Else
		state = STATE_CLEARED
	EndIf
End Function

Function SaveBest()
	If score <= bestScore(optDifficulty) Then Return
	bestScore(optDifficulty) = score
	SaveSettings()
End Function

; Levels are stored as text in Data lines at the bottom of this file. Each row has one character per brick:
; "." empty, "1" to "4" hits needed, "#" cannot be broken, and a letter is a 1-hit brick that drops a capsule.
Function LoadLevel(number)
	Select number
		Case 1 : Restore level1
		Case 2 : Restore level2
		Case 3 : Restore level3
		Case 4 : Restore level4
		Default : Restore level5
	End Select
	Local y%
	Local x%
	For y = 0 To BRICK_ROWS - 1
		Local row$
		Read row
		For x = 0 To BRICK_COLUMNS - 1
			Local c$ = Mid(row, x + 1, 1)
			bricks(x, y) = BRICK_NONE
			brickDrops(x, y) = 0
			Select c
				Case "1", "2", "3", "4"
					bricks(x, y) = Int(c)
				Case "#"
					bricks(x, y) = BRICK_SOLID
				Case "W" : bricks(x, y) = 1 : brickDrops(x, y) = POWER_WIDE
				Case "M" : bricks(x, y) = 1 : brickDrops(x, y) = POWER_MULTI
				Case "S" : bricks(x, y) = 1 : brickDrops(x, y) = POWER_SLOW
				Case "L" : bricks(x, y) = 1 : brickDrops(x, y) = POWER_LIFE
			End Select
		Next
	Next
End Function

; --- Paddle ----------------------------------------------------------------------------------------------------------

Function UpdatePaddle()
	; The mouse moves the paddle when it moves. Otherwise the arrow keys do.
	Local mx = MouseX()
	If mx <> lastMouseX
		paddleX = mx - paddleW / 2
		lastMouseX = mx
	EndIf
	paddleX = paddleX + (KeyDown(KEY_RIGHT) - KeyDown(KEY_LEFT)) * PADDLE_SPEED

	; Wide paddle grows and shrinks smoothly around its middle.
	Local targetW#
	If wideTimer > 0
		wideTimer = wideTimer - 1
		targetW = Float(PADDLE_W_WIDE)
	Else
		targetW = Float(PADDLE_W_NORMAL)
	EndIf
	Local oldW# = paddleW
	paddleW = paddleW + (targetW - paddleW) * 0.2
	paddleX = paddleX - (paddleW - oldW) / 2

	If paddleX < FIELD_LEFT Then paddleX = Float(FIELD_LEFT)
	If paddleX > FIELD_RIGHT - paddleW Then paddleX = FIELD_RIGHT - paddleW

	If slowTimer > 0 Then slowTimer = slowTimer - 1

	If KeyHit(KEY_SPACE) Or MouseHit(1) Then LaunchBalls()
End Function

Function NewStuckBall()
	Local b.Ball = New Ball
	b\stuck = True
	b\stuckOffset = Rnd(-0.3, 0.3)
	b\x = paddleX + paddleW / 2 - BALL_SIZE / 2
	b\y = Float(PADDLE_Y - BALL_SIZE)
End Function

Function LaunchBalls()
	Local b.Ball
	For b.Ball = Each Ball
		If b\stuck
			b\stuck = False
			SetBallDirection(b, -90 + b\stuckOffset * 120)
		EndIf
	Next
End Function

; Points a ball at an angle in degrees, at the current speed. -90 is straight up.
Function SetBallDirection(b.Ball, angle#)
	Local speed# = BALL_SPEED * speedScale
	If slowTimer > 0 Then speed = speed * 0.65
	If speed > BALL_SPEED_MAX Then speed = BALL_SPEED_MAX
	b\vx = Cos(angle) * speed
	b\vy = Sin(angle) * speed
End Function

; --- Balls -----------------------------------------------------------------------------------------------------------

Function UpdateBalls()
	Local count = 0
	Local b.Ball
	For b.Ball = Each Ball
		If b\stuck
			b\x = paddleX + paddleW / 2 + b\stuckOffset * paddleW / 2 - BALL_SIZE / 2
			b\y = Float(PADDLE_Y - BALL_SIZE)
		Else
			MoveBall(b)
		EndIf
	Next

	; Balls that fell out are gone. When none are left, a life is lost.
	For b.Ball = Each Ball
		If b\y > SCREEN_H Then Delete b Else count = count + 1
	Next
	If count = 0 And state = STATE_PLAY Then LoseLife()
End Function

Function MoveBall(b.Ball)
	; Keep the speed in step with the slow capsule, which can start or end while the ball flies.
	Local wanted# = BALL_SPEED * speedScale
	If slowTimer > 0 Then wanted = wanted * 0.65
	If wanted > BALL_SPEED_MAX Then wanted = BALL_SPEED_MAX
	Local current# = Sqr(b\vx * b\vx + b\vy * b\vy)
	If current > 0
		b\vx = b\vx * (current + (wanted - current) * 0.05) / current
		b\vy = b\vy * (current + (wanted - current) * 0.05) / current
	EndIf

	; Move in small steps, one axis at a time. When a step makes the ball overlap something, undo the step and
	; reverse the speed along that axis. This is simple and works for walls, bricks and the paddle alike.
	Local steps = Int(Ceil(Larger(Abs(b\vx), Abs(b\vy)) / 3))
	Local s%
	For s = 1 To steps
		b\x = b\x + b\vx / steps
		If HitSomething(b)
			b\x = b\x - b\vx / steps
			b\vx = -b\vx
		EndIf
		b\y = b\y + b\vy / steps
		If HitSomething(b)
			b\y = b\y - b\vy / steps
			b\vy = -b\vy
		EndIf
		If CheckPaddle(b) Then Exit
	Next

	; A ball that flies almost flat would take forever to come back down, so give it some height.
	If Abs(b\vy) < 1.2 Then b\vy = 1.2 * Sgn(b\vy + 0.001) : b\vx = b\vx * 0.98
End Function

; True if the ball overlaps a wall or a brick. Bricks it touches take a hit.
Function HitSomething(b.Ball)
	If b\x < FIELD_LEFT Or b\x + BALL_SIZE > FIELD_RIGHT Or b\y < FIELD_TOP Then Return True

	Local hit = False
	; Only the few grid cells under the ball can be touched.
	Local column0 = Int(Floor((b\x - FIELD_LEFT) / BRICK_W))
	Local column1 = Int(Floor((b\x + BALL_SIZE - FIELD_LEFT) / BRICK_W))
	Local row0 = Int(Floor((b\y - BRICKS_TOP) / BRICK_H))
	Local row1 = Int(Floor((b\y + BALL_SIZE - BRICKS_TOP) / BRICK_H))
	Local y%
	Local x%
	For y = row0 To row1
		For x = column0 To column1
			If x >= 0 And x < BRICK_COLUMNS And y >= 0 And y < BRICK_ROWS
				If bricks(x, y) <> BRICK_NONE
					HitBrick(x, y)
					hit = True
				EndIf
			EndIf
		Next
	Next
	Return hit
End Function

Function HitBrick(x, y)
	Local px# = Float(FIELD_LEFT + x * BRICK_W + BRICK_W / 2)
	Local py# = Float(BRICKS_TOP + y * BRICK_H + BRICK_H / 2)
	If bricks(x, y) = BRICK_SOLID
		PlaySfx(soundSolid)
		Return
	EndIf

	framesWithoutBrick = 0
	bricks(x, y) = bricks(x, y) - 1
	score = score + 10
	If bricks(x, y) > 0
		PlaySfx(soundBrick)
		Return
	EndIf

	; The brick broke.
	score = score + 40
	If optShake Then shake = shake + 2
	PlaySfx(soundBreak)
	BrickColor(1, y) ; The pieces take the colour of the brick.
	BurstShards(px, py, 18)
	If brickDrops(x, y) <> 0
		DropCapsule(px, py, brickDrops(x, y))
	ElseIf Rand(1, 15) = 1
		; A random capsule. Extra lives are rare: they mostly come from the bricks marked for them.
		If Rand(1, 20) = 1
			DropCapsule(px, py, POWER_LIFE)
		Else
			DropCapsule(px, py, Rand(POWER_WIDE, POWER_SLOW))
		EndIf
	EndIf
End Function

; Bounces a ball off the paddle. Where it lands on the paddle decides the new angle, like a curved surface.
Function CheckPaddle(b.Ball)
	If b\vy <= 0 Then Return False
	If b\y + BALL_SIZE < PADDLE_Y Or b\y > PADDLE_Y + PADDLE_H Then Return False
	If b\x + BALL_SIZE < paddleX Or b\x > paddleX + paddleW Then Return False

	Local offset# = ((b\x + BALL_SIZE / 2) - (paddleX + paddleW / 2)) / (paddleW / 2)
	If offset < -1 Then offset = -1
	If offset > 1 Then offset = 1
	b\y = Float(PADDLE_Y - BALL_SIZE)
	Local angle# = -90 + offset * 65

	; The last few bricks can be hard to reach. After 20 seconds without hitting one, the paddle helps a little: it
	; sends the ball halfway towards a brick that is still standing.
	If framesWithoutBrick > 60 * 20
		Local x, y, found = False
		For y = BRICK_ROWS - 1 To 0 Step -1
			For x = 0 To BRICK_COLUMNS - 1
				If Not found And bricks(x, y) >= 1 And bricks(x, y) <= 4 And Rand(1, 3) = 1
					Local towards# = ATan2(BRICKS_TOP + y * BRICK_H + BRICK_H / 2 - b\y, FIELD_LEFT + x * BRICK_W + BRICK_W / 2 - b\x)
					angle = (angle + towards) / 2
					found = True
				EndIf
			Next
		Next
	EndIf
	If angle < -160 Then angle = -160
	If angle > -20 Then angle = -20

	SetBallDirection(b, angle)
	PlaySfx(soundPaddle)
	Return True
End Function

; --- Capsules --------------------------------------------------------------------------------------------------------

Function DropCapsule(x#, y#, kind)
	Local c.Capsule = New Capsule
	c\x = x : c\y = y
	c\kind = kind
End Function

Function UpdateCapsules()
	Local c.Capsule
	For c.Capsule = Each Capsule
		c\y = c\y + 2.5
		If c\y > PADDLE_Y - 8 And c\y < PADDLE_Y + PADDLE_H + 8 And c\x > paddleX - 12 And c\x < paddleX + paddleW + 12
			CollectCapsule(c\kind, c\x, c\y)
			Delete c
		ElseIf c\y > SCREEN_H + 20
			Delete c
		EndIf
	Next
End Function

Function CollectCapsule(kind, x#, y#)
	PlaySfx(soundPower)
	score = score + 100
	Local b.Ball
	Local i%
	Select kind
		Case POWER_WIDE
			wideTimer = 60 * 15
			AddPopup(x, y - 20, "Wide paddle")
		Case POWER_SLOW
			slowTimer = 60 * 10
			AddPopup(x, y - 20, "Slow balls")
		Case POWER_LIFE
			lives = lives + 1
			AddPopup(x, y - 20, "Extra life")
		Case POWER_MULTI
			AddPopup(x, y - 20, "More balls")
			; Every flying ball splits into three, up to a limit. New balls go to the end of the list, so the loop
			; would reach them too and split them again. Counting the balls first and stopping after that many keeps
			; the split to the balls that were there before.
			Local count = 0, oldBalls
			For b.Ball = Each Ball
				count = count + 1
			Next
			oldBalls = count
			For b.Ball = Each Ball
				oldBalls = oldBalls - 1
				If oldBalls < 0 Then Exit
				If Not b\stuck
					Local angle# = ATan2(b\vy, b\vx)
					For i = -1 To 1 Step 2
						If count < MAX_BALLS
							Local nb.Ball = New Ball
							nb\x = b\x : nb\y = b\y
							SetBallDirection(nb, angle + i * 25)
							count = count + 1
						EndIf
					Next
				EndIf
			Next
	End Select
End Function

; --- Effects ---------------------------------------------------------------------------------------------------------

Function BurstShards(x#, y#, count)
	Local i%
	For i = 1 To count
		Local s.Shard = New Shard
		s\x = x + Rnd(Float(-BRICK_W / 2), Float(BRICK_W / 2))
		s\y = y + Rnd(Float(-BRICK_H / 2), Float(BRICK_H / 2))
		s\vx = Rnd(-3, 3)
		s\vy = Rnd(-4, 1)
		s\life = Rnd(0.6, 1.0)
		s\r = ColorRed() : s\g = ColorGreen() : s\b = ColorBlue()
	Next
End Function

Function AddPopup(x#, y#, message$)
	Local p.Popup = New Popup
	p\x = x : p\y = y
	p\message = message
	p\life = 120
End Function

Function UpdateEffects()
	Local s.Shard
	For s.Shard = Each Shard
		s\x = s\x + s\vx
		s\y = s\y + s\vy
		s\vy = s\vy + 0.25 ; Gravity pulls the pieces down.
		s\life = s\life - 0.02
		If s\life <= 0 Then Delete s
	Next
	Local p.Popup
	For p.Popup = Each Popup
		p\y = p\y - 0.6
		p\life = p\life - 1
		If p\life <= 0 Then Delete p
	Next
	If shake > 0 Then shake = shake * 0.85 - 0.1
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	Local ox = 0, oy = 0
	If shake > 0 Then ox = Rand(Int(-shake), Int(shake)) : oy = Rand(Int(-shake), Int(shake))
	Origin ox, oy

	DrawImage background, 0, 0

	; Field border.
	Color 70, 80, 130
	Rect FIELD_LEFT - 6, FIELD_TOP - 6, FIELD_RIGHT - FIELD_LEFT + 12, 6, 1
	Rect FIELD_LEFT - 6, FIELD_TOP, 6, SCREEN_H, 1
	Rect FIELD_RIGHT, FIELD_TOP, 6, SCREEN_H, 1

	If state >= STATE_PLAY
		DrawBricks()
		DrawPaddle()
		DrawBalls()
		DrawCapsules()
	EndIf
	DrawShards()

	Origin 0, 0
	DrawHud()
End Function

Function DrawBricks()
	Local y%
	Local x%
	Local i%
	For y = 0 To BRICK_ROWS - 1
		For x = 0 To BRICK_COLUMNS - 1
			Local kind = bricks(x, y)
			If kind <> BRICK_NONE
				Local bx = FIELD_LEFT + x * BRICK_W + BRICK_GAP / 2
				Local by = BRICKS_TOP + y * BRICK_H + BRICK_GAP / 2
				Local w = BRICK_W - BRICK_GAP, h = BRICK_H - BRICK_GAP
				If kind = BRICK_SOLID
					Color 120, 120, 130
					Rect bx, by, w, h, 1
					Color 170, 170, 180
					Rect bx, by, w, 3, 1
					Color 80, 80, 90
					Rect bx, by + h - 3, w, 3, 1
				Else
					; A darker frame, a lighter top edge and one stripe for every hit the brick still needs.
					BrickColor(kind, y)
					Local r = ColorRed(), g = ColorGreen(), b = ColorBlue()
					Color r / 2, g / 2, b / 2
					Rect bx, by, w, h, 1
					Color r, g, b
					Rect bx + 2, by + 2, w - 4, h - 4, 1
					Color Int(Smaller(Float(r + 70), 255)), Int(Smaller(Float(g + 70), 255)), Int(Smaller(Float(b + 70), 255))
					Rect bx + 2, by + 2, w - 4, 2, 1
					Color r / 2, g / 2, b / 2
					For i = 2 To kind
						Rect bx + 6 + (i - 2) * 6, by + 6, 3, h - 12, 1
					Next
					If brickDrops(x, y)
						Color 255, 255, 255
						Oval bx + w / 2 - 3, by + h / 2 - 3, 6, 6, 1
					EndIf
				EndIf
			EndIf
		Next
	Next
End Function

; Sets the drawing colour for a brick: one hue per row, brighter for bricks that need more hits.
Function BrickColor(hits, row)
	Local hue# = Float(row * 36)
	Local brightness# = 0.65 + hits * 0.1
	Color Int((128 + 127 * Cos(hue)) * brightness), Int((128 + 127 * Cos(hue - 120)) * brightness), Int((128 + 127 * Cos(hue + 120)) * brightness)
End Function

Function DrawPaddle()
	Color 40, 110, 200
	Rect Int(paddleX), PADDLE_Y, Int(paddleW), PADDLE_H, 1
	Color 110, 190, 255
	Rect Int(paddleX + 3), PADDLE_Y + 2, Int(paddleW - 6), 4, 1
	Color 230, 240, 255
	Rect Int(paddleX), PADDLE_Y, 6, PADDLE_H, 1
	Rect Int(paddleX + paddleW - 6), PADDLE_Y, 6, PADDLE_H, 1
End Function

Function DrawBalls()
	Local b.Ball
	For b.Ball = Each Ball
		Color 255, 200, 120
		Oval Int(b\x - 2), Int(b\y - 2), BALL_SIZE + 4, BALL_SIZE + 4, 1
		Color 255, 255, 240
		Oval Int(b\x), Int(b\y), BALL_SIZE, BALL_SIZE, 1
	Next
End Function

Function DrawCapsules()
	Local c.Capsule
	For c.Capsule = Each Capsule
		Local label$
		Select c\kind
			Case POWER_WIDE : Color 80, 200, 120 : label = "W"
			Case POWER_MULTI : Color 220, 120, 220 : label = "M"
			Case POWER_SLOW : Color 90, 170, 255 : label = "S"
			Case POWER_LIFE : Color 255, 90, 90 : label = "+"
		End Select
		Oval Int(c\x - 16), Int(c\y - 8), 32, 16, 1
		Color 255, 255, 255
		Text Int(c\x), Int(c\y), label, True, True
	Next
End Function

Function DrawShards()
	Local s.Shard
	For s.Shard = Each Shard
		Color Int(s\r * s\life), Int(s\g * s\life), Int(s\b * s\life)
		Rect Int(s\x), Int(s\y), 4, 3, 1
	Next
End Function

Function DrawHud()
	Color 220, 220, 240
	Text 24, 20, "Score " + score
	If state >= STATE_PLAY Then Text SCREEN_W / 2, 20, "Level " + level + " / " + LEVEL_COUNT, True, False
	Text SCREEN_W - 24 - StringWidth("Best " + bestScore(optDifficulty)), 20, "Best " + bestScore(optDifficulty)

	; One small paddle for every spare life. Past 8 there is one paddle and a number, so they never run off the field.
	Local i%
	If state >= STATE_PLAY
		Color 110, 190, 255
		If lives - 1 > 8
			Rect 24, SCREEN_H - 20, 24, 6, 1
			Text 56, SCREEN_H - 17, "x " + (lives - 1), False, True
		Else
			For i = 1 To lives - 1
				Rect 24 + (i - 1) * 30, SCREEN_H - 20, 24, 6, 1
			Next
		EndIf
	EndIf

	Local p.Popup
	For p.Popup = Each Popup
		Local f# = p\life / 40.0 ; Full brightness until the last 40 frames.
		If f > 1 Then f = 1
		Color Int(255 * f), Int(240 * f), Int(160 * f)
		Text Int(p\x), Int(p\y), p\message, True, True
	Next

	If state <= STATE_HELP
		DrawTitleBricks()
		Color 120, 125, 160
		Text SCREEN_W / 2, SCREEN_H - 30, "A BlitzLLVM sample game", True, True
	EndIf

	Color 255, 240, 200
	Select state
		Case STATE_MENU
			DrawMenu()
			Color 150, 155, 190
			Text SCREEN_W / 2, 460, "Up / Down or the mouse to choose, Enter or a click to select.", True, True
		Case STATE_OPTIONS
			DrawMenu()
			Color 150, 155, 190
			Text SCREEN_W / 2, 460, "Left / Right or a click change the option, Escape goes back.", True, True
		Case STATE_HELP
			Color 220, 220, 240
			Text SCREEN_W / 2, 280, "Break every brick to clear the level. There are " + LEVEL_COUNT + " levels.", True, True
			Text SCREEN_W / 2, 305, "Mouse or Left / Right moves the paddle, click or Space launches the ball.", True, True
			Text SCREEN_W / 2, 330, "The edge of the paddle sends the ball off at a steep angle.", True, True
			Text SCREEN_W / 2, 365, "Stripes show how many hits a brick needs. Grey bricks never break.", True, True
			Text SCREEN_W / 2, 390, "Bricks with a dot drop a capsule. W: wider paddle, M: more balls,", True, True
			Text SCREEN_W / 2, 410, "S: slower balls, +: an extra life. P pauses, Escape goes to the menu.", True, True
			Color 150, 155, 190
			Text SCREEN_W / 2, 460, "Press Enter or click to go back.", True, True
		Case STATE_PAUSED
			Text SCREEN_W / 2, 400, "Paused - press P", True, False
		Case STATE_CLEARED
			Text SCREEN_W / 2, 400, "Level " + level + " cleared! Click or press Space", True, False
		Case STATE_OVER
			Text SCREEN_W / 2, 400, "Game over. Click or press Space", True, False
		Case STATE_WON
			Text SCREEN_W / 2, 400, "Every wall is down! Final score " + score + ". Click or press Space", True, False
	End Select
End Function

; The title "SHATTERWALL" spelled out in bricks.
Function DrawTitleBricks()
	Restore titleLetters
	Local row%
	Local column%
	For row = 0 To 4
		Local pattern$
		Read pattern
		For column = 1 To Len(pattern)
			If Mid(pattern, column, 1) = "#"
				BrickColor(2, column / 4)
				Local bx = SCREEN_W / 2 - Len(pattern) * 7 + (column - 1) * 14
				Local by = Int(170 + row * 14 + Sin(MilliSecs() / 4.0 + column * 12) * 4)
				Rect bx, by, 12, 12, 1
			EndIf
		Next
	Next
End Function

; Paints a dark background with soft glowing dots into an image once, so each frame only has to copy it.
Function MakeBackground()
	Local image = CreateImage(SCREEN_W, SCREEN_H)
	SetBuffer ImageBuffer(image)
	Local y%
	For y = 0 To SCREEN_H - 1 Step 4
		Local f# = Float(y) / SCREEN_H
		Color Int(10 + 10 * f), Int(10 + 4 * f), Int(24 + 20 * f)
		Rect 0, y, SCREEN_W, 4, 1
	Next
	Local i%
	For i = 1 To 120
		Local x = Rand(SCREEN_W), y2 = Rand(SCREEN_H), size = Rand(1, 3)
		Local light = Rand(40, 110)
		Color light / 2, light / 2, light
		Oval x, y2, size, size, 1
	Next
	SetBuffer BackBuffer()
	AddWatermark(image)
	Return image
End Function

; --- Watermark -------------------------------------------------------------------------------------------------------
; Every frame carries a faint pattern that nobody can see: some background pixels are one step bluer than the rest.
; A program can find the pattern again in a screenshot, which shows that the picture came from this sample game.
; Here it is painted into the background image once, so it costs nothing while playing.

Function AddWatermark(image)
	Local buffer = ImageBuffer(image), x, y, rgb
	LockBuffer buffer
	For y = 0 To SCREEN_H - 1
		For x = 0 To SCREEN_W - 1
			If (x * 7 + y * 13) Mod 29 < 3
				rgb = ReadPixelFast(x, y, buffer)
				If (rgb And $FF) = 255 Then rgb = rgb - 1 Else rgb = rgb + 1
				WritePixelFast x, y, rgb, buffer
			EndIf
		Next
	Next
	UnlockBuffer buffer
End Function

; --- Helpers ---------------------------------------------------------------------------------------------------------

Function Larger#(a#, b#)
	If a > b Then Return a Else Return b
End Function

Function Smaller#(a#, b#)
	If a < b Then Return a Else Return b
End Function

; Makes a short sound effect without any sound file: it writes a WAV file into a bank, saves it to the temporary
; folder, loads it and deletes the file again. The pitch slides from startHz to endHz.
Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0
	Local i%
	For i = 0 To samples - 1
		Local t# = Float(i) / samples
		Local hz# = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Local v#
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1
			Case WAVE_SINE
				v = Sin(phase)
			Default
				v = Rnd(-1, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		Local envelope# = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.6 Then envelope = envelope * (1.0 - t) / 0.4
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "shatterwall-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i%
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

