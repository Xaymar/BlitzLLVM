; Shatterwall: knock down every brick with a ball and a paddle.
;
; Every picture and sound in this game is made by the code itself, so there are no files to ship with it.
;
; Controls:
;   Mouse or Left/Right   move the paddle
;   Left click or Space   launch the ball
;   P                     pause
;   Escape                back to the title screen, or quit from there
;
; Bricks: the number of stripes shows how many hits a brick needs. Grey bricks cannot be broken. Bricks with a
; dot always drop a capsule. Capsules: W = wider paddle, M = more balls, S = slower balls, + = an extra life.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Const SCREEN_W = 800, SCREEN_H = 600
Const FIELD_LEFT = 36, FIELD_RIGHT = 764, FIELD_TOP = 60 ; 14 bricks of 52 pixels fill the field exactly.
Const BRICK_COLUMNS = 14, BRICK_ROWS = 9, BRICK_W = 52, BRICK_H = 20, BRICK_GAP = 2
Const BRICKS_TOP = 100
Const PADDLE_Y = 550, PADDLE_H = 14, PADDLE_W_NORMAL = 100, PADDLE_W_WIDE = 160, PADDLE_SPEED# = 10
Const BALL_SIZE = 10, BALL_SPEED# = 6.5, BALL_SPEED_MAX# = 11
Const MAX_BALLS = 8
Const START_LIVES = 3
Const LEVEL_COUNT = 5

Const STATE_TITLE = 0, STATE_PLAY = 1, STATE_PAUSED = 2, STATE_CLEARED = 3, STATE_OVER = 4, STATE_WON = 5

Const KEY_ESCAPE = 1, KEY_P = 25, KEY_SPACE = 57, KEY_LEFT = 203, KEY_RIGHT = 205

; Brick kinds as stored in the level grid.
Const BRICK_NONE = 0, BRICK_SOLID = 9 ; 1 to 4 are normal bricks that need that many hits.

Const POWER_WIDE = 1, POWER_MULTI = 2, POWER_SLOW = 3, POWER_LIFE = 4

Type Ball
	Field x#, y#, vx#, vy#
	Field stuck          ; True while it rests on the paddle before launch.
	Field stuckOffset#   ; Where on the paddle it rests.
End Type

Type Capsule
	Field x#, y#
	Field kind
End Type

Type Shard
	Field x#, y#, vx#, vy#
	Field life#
	Field r, g, b
End Type

Type Popup
	Field x#, y#
	Field message$
	Field life
End Type

Dim bricks(BRICK_COLUMNS - 1, BRICK_ROWS - 1)
Dim brickDrops(BRICK_COLUMNS - 1, BRICK_ROWS - 1)

Global state = STATE_TITLE
Global level, lives, score, highScore
Global paddleX#, paddleW#, wideTimer, slowTimer
Global speedScale# = 1.0
Global shake#
Global lastMouseX

Graphics SCREEN_W, SCREEN_H, 0, 2
AppTitle "Shatterwall"
SetBuffer BackBuffer()
SeedRnd MilliSecs()

Global background = MakeBackground()

Const WAVE_SQUARE = 0, WAVE_SINE = 1, WAVE_NOISE = 2
Global soundPaddle = MakeSound(300, 420, 50, WAVE_SQUARE, 0.25)
Global soundBrick = MakeSound(880, 660, 60, WAVE_SQUARE, 0.2)
Global soundSolid = MakeSound(180, 160, 70, WAVE_SQUARE, 0.25)
Global soundBreak = MakeSound(1200, 300, 120, WAVE_NOISE, 0.25)
Global soundPower = MakeSound(400, 1600, 250, WAVE_SINE, 0.35)
Global soundLose = MakeSound(400, 80, 600, WAVE_SQUARE, 0.25)
Global soundCleared = MakeSound(520, 1560, 700, WAVE_SINE, 0.35)

Local timer = CreateTimer(60)
lastMouseX = MouseX()

Local quit = False
While Not quit
	WaitTimer timer

	Select state
		Case STATE_TITLE
			If KeyHit(KEY_SPACE) Or MouseHit(1) Then StartGame()
			If KeyHit(KEY_ESCAPE) Then quit = True
		Case STATE_PLAY
			UpdatePaddle()
			UpdateBalls()
			UpdateCapsules()
			CheckCleared() ; Checked here, after all balls moved, because clearing the level removes the balls.
			If KeyHit(KEY_P) Then state = STATE_PAUSED
		Case STATE_PAUSED
			If KeyHit(KEY_P) Then state = STATE_PLAY
		Case STATE_CLEARED, STATE_OVER, STATE_WON
			If KeyHit(KEY_SPACE) Or MouseHit(1)
				If state = STATE_CLEARED
					StartLevel(level + 1)
				Else
					state = STATE_TITLE
				EndIf
			EndIf
	End Select
	If state <> STATE_TITLE And KeyHit(KEY_ESCAPE) Then state = STATE_TITLE

	UpdateEffects()
	DrawGame()
	Flip 0
Wend

End

; --- Game flow -------------------------------------------------------------------------------------------------------

Function StartGame()
	score = 0
	lives = START_LIVES
	FlushKeys : FlushMouse
	StartLevel(1)
End Function

Function StartLevel(number)
	level = number
	LoadLevel(level)
	Delete Each Capsule
	Delete Each Ball
	wideTimer = 0 : slowTimer = 0
	paddleW = Float(PADDLE_W_NORMAL)
	paddleX = (FIELD_LEFT + FIELD_RIGHT - paddleW) / 2
	speedScale = 1.0 + (level - 1) * 0.08 ; Each level is a little faster.
	NewStuckBall()
	AddPopup(Float(SCREEN_W / 2), 380, "Level " + level)
	state = STATE_PLAY
End Function

Function LoseLife()
	lives = lives - 1
	shake = 14
	PlaySound soundLose
	Delete Each Capsule
	wideTimer = 0 : slowTimer = 0
	If lives <= 0
		If score > highScore Then highScore = score
		state = STATE_OVER
	Else
		NewStuckBall()
	EndIf
End Function

Function CheckCleared()
	Local y%
	Local x%
	For y = 0 To BRICK_ROWS - 1
		For x = 0 To BRICK_COLUMNS - 1
			If bricks(x, y) >= 1 And bricks(x, y) <= 4 Then Return
		Next
	Next
	Delete Each Ball
	Delete Each Capsule
	score = score + 1000 * level
	PlaySound soundCleared
	If level = LEVEL_COUNT
		If score > highScore Then highScore = score
		state = STATE_WON
	Else
		state = STATE_CLEARED
	EndIf
End Function

; Levels are stored as text in Data lines at the bottom of this file. Each row has one character per brick:
; "." empty, "1" to "4" hits needed, "#" cannot be broken, and a letter is a 1-hit brick that drops a capsule.
Function LoadLevel(number)
	Select number
		Case 1 : Restore level1
		Case 2 : Restore level2
		Case 3 : Restore level3
		Case 4 : Restore level4
		Default : Restore level5
	End Select
	Local y%
	Local x%
	For y = 0 To BRICK_ROWS - 1
		Local row$
		Read row
		For x = 0 To BRICK_COLUMNS - 1
			Local c$ = Mid(row, x + 1, 1)
			bricks(x, y) = BRICK_NONE
			brickDrops(x, y) = False
			Select c
				Case "1", "2", "3", "4"
					bricks(x, y) = Int(c)
				Case "#"
					bricks(x, y) = BRICK_SOLID
				Case "."
					; Empty.
				Default
					bricks(x, y) = 1
					brickDrops(x, y) = True
			End Select
		Next
	Next
End Function

; --- Paddle ----------------------------------------------------------------------------------------------------------

Function UpdatePaddle()
	; The mouse moves the paddle when it moves. Otherwise the arrow keys do.
	Local mx = MouseX()
	If mx <> lastMouseX
		paddleX = mx - paddleW / 2
		lastMouseX = mx
	EndIf
	paddleX = paddleX + (KeyDown(KEY_RIGHT) - KeyDown(KEY_LEFT)) * PADDLE_SPEED

	; Wide paddle grows and shrinks smoothly around its middle.
	Local targetW#
	If wideTimer > 0
		wideTimer = wideTimer - 1
		targetW = Float(PADDLE_W_WIDE)
	Else
		targetW = Float(PADDLE_W_NORMAL)
	EndIf
	Local oldW# = paddleW
	paddleW = paddleW + (targetW - paddleW) * 0.2
	paddleX = paddleX - (paddleW - oldW) / 2

	If paddleX < FIELD_LEFT Then paddleX = Float(FIELD_LEFT)
	If paddleX > FIELD_RIGHT - paddleW Then paddleX = FIELD_RIGHT - paddleW

	If slowTimer > 0 Then slowTimer = slowTimer - 1

	If KeyHit(KEY_SPACE) Or MouseHit(1) Then LaunchBalls()
End Function

Function NewStuckBall()
	Local b.Ball = New Ball
	b\stuck = True
	b\stuckOffset = Rnd(-0.3, 0.3)
	b\x = paddleX + paddleW / 2 - BALL_SIZE / 2
	b\y = Float(PADDLE_Y - BALL_SIZE)
End Function

Function LaunchBalls()
	Local b.Ball
	For b.Ball = Each Ball
		If b\stuck
			b\stuck = False
			SetBallDirection(b, -90 + b\stuckOffset * 120)
		EndIf
	Next
End Function

; Points a ball at an angle in degrees, at the current speed. -90 is straight up.
Function SetBallDirection(b.Ball, angle#)
	Local speed# = BALL_SPEED * speedScale
	If slowTimer > 0 Then speed = speed * 0.65
	If speed > BALL_SPEED_MAX Then speed = BALL_SPEED_MAX
	b\vx = Cos(angle) * speed
	b\vy = Sin(angle) * speed
End Function

; --- Balls -----------------------------------------------------------------------------------------------------------

Function UpdateBalls()
	Local count = 0
	Local b.Ball
	For b.Ball = Each Ball
		If b\stuck
			b\x = paddleX + paddleW / 2 + b\stuckOffset * paddleW / 2 - BALL_SIZE / 2
			b\y = Float(PADDLE_Y - BALL_SIZE)
		Else
			MoveBall(b)
		EndIf
	Next

	; Balls that fell out are gone. When none are left, a life is lost.
	For b.Ball = Each Ball
		If b\y > SCREEN_H Then Delete b Else count = count + 1
	Next
	If count = 0 And state = STATE_PLAY Then LoseLife()
End Function

Function MoveBall(b.Ball)
	; Keep the speed in step with the slow capsule, which can start or end while the ball flies.
	Local wanted# = BALL_SPEED * speedScale
	If slowTimer > 0 Then wanted = wanted * 0.65
	If wanted > BALL_SPEED_MAX Then wanted = BALL_SPEED_MAX
	Local current# = Sqr(b\vx * b\vx + b\vy * b\vy)
	If current > 0
		b\vx = b\vx * (current + (wanted - current) * 0.05) / current
		b\vy = b\vy * (current + (wanted - current) * 0.05) / current
	EndIf

	; Move in small steps, one axis at a time. When a step makes the ball overlap something, undo the step and
	; reverse the speed along that axis. This is simple and works for walls, bricks and the paddle alike.
	Local steps = Int(Ceil(Larger(Abs(b\vx), Abs(b\vy)) / 3))
	Local s%
	For s = 1 To steps
		b\x = b\x + b\vx / steps
		If HitSomething(b)
			b\x = b\x - b\vx / steps
			b\vx = -b\vx
		EndIf
		b\y = b\y + b\vy / steps
		If HitSomething(b)
			b\y = b\y - b\vy / steps
			b\vy = -b\vy
		EndIf
		If CheckPaddle(b) Then Exit
	Next

	; A ball that flies almost flat would take forever to come back down, so give it some height.
	If Abs(b\vy) < 1.2 Then b\vy = 1.2 * Sgn(b\vy + 0.001) : b\vx = b\vx * 0.98
End Function

; True if the ball overlaps a wall or a brick. Bricks it touches take a hit.
Function HitSomething(b.Ball)
	If b\x < FIELD_LEFT Or b\x + BALL_SIZE > FIELD_RIGHT Or b\y < FIELD_TOP Then Return True

	Local hit = False
	; Only the few grid cells under the ball can be touched.
	Local column0 = Int(Floor((b\x - FIELD_LEFT) / BRICK_W))
	Local column1 = Int(Floor((b\x + BALL_SIZE - FIELD_LEFT) / BRICK_W))
	Local row0 = Int(Floor((b\y - BRICKS_TOP) / BRICK_H))
	Local row1 = Int(Floor((b\y + BALL_SIZE - BRICKS_TOP) / BRICK_H))
	Local y%
	Local x%
	For y = row0 To row1
		For x = column0 To column1
			If x >= 0 And x < BRICK_COLUMNS And y >= 0 And y < BRICK_ROWS
				If bricks(x, y) <> BRICK_NONE
					HitBrick(x, y)
					hit = True
				EndIf
			EndIf
		Next
	Next
	Return hit
End Function

Function HitBrick(x, y)
	Local px# = Float(FIELD_LEFT + x * BRICK_W + BRICK_W / 2)
	Local py# = Float(BRICKS_TOP + y * BRICK_H + BRICK_H / 2)
	If bricks(x, y) = BRICK_SOLID
		PlaySound soundSolid
		Return
	EndIf

	bricks(x, y) = bricks(x, y) - 1
	score = score + 10
	If bricks(x, y) > 0
		PlaySound soundBrick
		Return
	EndIf

	; The brick broke.
	score = score + 40
	shake = shake + 2
	PlaySound soundBreak
	BrickColor(1, y) ; The pieces take the colour of the brick.
	BurstShards(px, py, 18)
	If brickDrops(x, y) Or Rand(1, 9) = 1 Then DropCapsule(px, py)
End Function

; Bounces a ball off the paddle. Where it lands on the paddle decides the new angle, like a curved surface.
Function CheckPaddle(b.Ball)
	If b\vy <= 0 Then Return False
	If b\y + BALL_SIZE < PADDLE_Y Or b\y > PADDLE_Y + PADDLE_H Then Return False
	If b\x + BALL_SIZE < paddleX Or b\x > paddleX + paddleW Then Return False

	Local offset# = ((b\x + BALL_SIZE / 2) - (paddleX + paddleW / 2)) / (paddleW / 2)
	If offset < -1 Then offset = -1.0
	If offset > 1 Then offset = 1
	b\y = Float(PADDLE_Y - BALL_SIZE)
	SetBallDirection(b, -90 + offset * 60)
	PlaySound soundPaddle
	Return True
End Function

; --- Capsules --------------------------------------------------------------------------------------------------------

Function DropCapsule(x#, y#)
	Local c.Capsule = New Capsule
	c\x = x : c\y = y
	c\kind = Rand(POWER_WIDE, POWER_LIFE)
	If c\kind = POWER_LIFE And Rand(1, 3) > 1 Then c\kind = Rand(POWER_WIDE, POWER_SLOW) ; Lives are rarer.
End Function

Function UpdateCapsules()
	Local c.Capsule
	For c.Capsule = Each Capsule
		c\y = c\y + 2.5
		If c\y > PADDLE_Y - 8 And c\y < PADDLE_Y + PADDLE_H + 8 And c\x > paddleX - 12 And c\x < paddleX + paddleW + 12
			CollectCapsule(c\kind, c\x, c\y)
			Delete c
		ElseIf c\y > SCREEN_H + 20
			Delete c
		EndIf
	Next
End Function

Function CollectCapsule(kind, x#, y#)
	PlaySound soundPower
	score = score + 100
	Local b.Ball
	Local i%
	Select kind
		Case POWER_WIDE
			wideTimer = 60 * 15
			AddPopup(x, y - 20, "Wide paddle")
		Case POWER_SLOW
			slowTimer = 60 * 10
			AddPopup(x, y - 20, "Slow balls")
		Case POWER_LIFE
			lives = lives + 1
			AddPopup(x, y - 20, "Extra life")
		Case POWER_MULTI
			AddPopup(x, y - 20, "More balls")
			; Every flying ball splits into three, up to a limit.
			Local count = 0
			For b.Ball = Each Ball
				count = count + 1
			Next
			For b.Ball = Each Ball
				If Not b\stuck
					Local angle# = ATan2(b\vy, b\vx)
					For i = -1 To 1 Step 2
						If count < MAX_BALLS
							Local nb.Ball = New Ball
							nb\x = b\x : nb\y = b\y
							SetBallDirection(nb, angle + i * 25)
							count = count + 1
						EndIf
					Next
				EndIf
			Next
	End Select
End Function

; --- Effects ---------------------------------------------------------------------------------------------------------

Function BurstShards(x#, y#, count)
	Local i%
	For i = 1 To count
		Local s.Shard = New Shard
		s\x = x + Rnd(Float(-BRICK_W / 2), Float(BRICK_W / 2))
		s\y = y + Rnd(Float(-BRICK_H / 2), Float(BRICK_H / 2))
		s\vx = Rnd(-3.0, 3)
		s\vy = Rnd(-4.0, 1)
		s\life = Rnd(0.6, 1.0)
		s\r = ColorRed() : s\g = ColorGreen() : s\b = ColorBlue()
	Next
End Function

Function AddPopup(x#, y#, message$)
	Local p.Popup = New Popup
	p\x = x : p\y = y
	p\message = message
	p\life = 120
End Function

Function UpdateEffects()
	Local s.Shard
	For s.Shard = Each Shard
		s\x = s\x + s\vx
		s\y = s\y + s\vy
		s\vy = s\vy + 0.25 ; Gravity pulls the pieces down.
		s\life = s\life - 0.02
		If s\life <= 0 Then Delete s
	Next
	Local p.Popup
	For p.Popup = Each Popup
		p\y = p\y - 0.6
		p\life = p\life - 1
		If p\life <= 0 Then Delete p
	Next
	If shake > 0 Then shake = shake * 0.85 - 0.1
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	Local ox = 0, oy = 0
	If shake > 0 Then ox = Rand(Int(-shake), Int(shake)) : oy = Rand(Int(-shake), Int(shake))
	Origin ox, oy

	DrawImage background, 0, 0

	; Field border.
	Color 70, 80, 130
	Rect FIELD_LEFT - 6, FIELD_TOP - 6, FIELD_RIGHT - FIELD_LEFT + 12, 6, 1
	Rect FIELD_LEFT - 6, FIELD_TOP, 6, SCREEN_H, 1
	Rect FIELD_RIGHT, FIELD_TOP, 6, SCREEN_H, 1

	If state <> STATE_TITLE
		DrawBricks()
		DrawPaddle()
		DrawBalls()
		DrawCapsules()
	EndIf
	DrawShards()

	Origin 0, 0
	DrawHud()
End Function

Function DrawBricks()
	Local y%
	Local x%
	Local i%
	For y = 0 To BRICK_ROWS - 1
		For x = 0 To BRICK_COLUMNS - 1
			Local kind = bricks(x, y)
			If kind <> BRICK_NONE
				Local bx = FIELD_LEFT + x * BRICK_W + BRICK_GAP / 2
				Local by = BRICKS_TOP + y * BRICK_H + BRICK_GAP / 2
				Local w = BRICK_W - BRICK_GAP, h = BRICK_H - BRICK_GAP
				If kind = BRICK_SOLID
					Color 120, 120, 130
					Rect bx, by, w, h, 1
					Color 170, 170, 180
					Rect bx, by, w, 3, 1
					Color 80, 80, 90
					Rect bx, by + h - 3, w, 3, 1
				Else
					; A darker frame, a lighter top edge and one stripe for every hit the brick still needs.
					BrickColor(kind, y)
					Local r = ColorRed(), g = ColorGreen(), b = ColorBlue()
					Color r / 2, g / 2, b / 2
					Rect bx, by, w, h, 1
					Color r, g, b
					Rect bx + 2, by + 2, w - 4, h - 4, 1
					Color Int(Smaller(Float(r + 70), 255)), Int(Smaller(Float(g + 70), 255)), Int(Smaller(Float(b + 70), 255))
					Rect bx + 2, by + 2, w - 4, 2, 1
					Color r / 2, g / 2, b / 2
					For i = 2 To kind
						Rect bx + 6 + (i - 2) * 6, by + 6, 3, h - 12, 1
					Next
					If brickDrops(x, y)
						Color 255, 255, 255
						Oval bx + w / 2 - 3, by + h / 2 - 3, 6, 6, 1
					EndIf
				EndIf
			EndIf
		Next
	Next
End Function

; Sets the drawing colour for a brick: one hue per row, brighter for bricks that need more hits.
Function BrickColor(hits, row)
	Local hue# = Float(row * 36)
	Local brightness# = 0.65 + hits * 0.1
	Color Int((128 + 127 * Cos(hue)) * brightness), Int((128 + 127 * Cos(hue - 120)) * brightness), Int((128 + 127 * Cos(hue + 120)) * brightness)
End Function

Function DrawPaddle()
	Color 40, 110, 200
	Rect Int(paddleX), PADDLE_Y, Int(paddleW), PADDLE_H, 1
	Color 110, 190, 255
	Rect Int(paddleX + 3), PADDLE_Y + 2, Int(paddleW - 6), 4, 1
	Color 230, 240, 255
	Rect Int(paddleX), PADDLE_Y, 6, PADDLE_H, 1
	Rect Int(paddleX + paddleW - 6), PADDLE_Y, 6, PADDLE_H, 1
End Function

Function DrawBalls()
	Local b.Ball
	For b.Ball = Each Ball
		Color 255, 200, 120
		Oval Int(b\x - 2), Int(b\y - 2), BALL_SIZE + 4, BALL_SIZE + 4, 1
		Color 255, 255, 240
		Oval Int(b\x), Int(b\y), BALL_SIZE, BALL_SIZE, 1
	Next
End Function

Function DrawCapsules()
	Local c.Capsule
	For c.Capsule = Each Capsule
		Local label$
		Select c\kind
			Case POWER_WIDE : Color 80, 200, 120 : label = "W"
			Case POWER_MULTI : Color 220, 120, 220 : label = "M"
			Case POWER_SLOW : Color 90, 170, 255 : label = "S"
			Case POWER_LIFE : Color 255, 90, 90 : label = "+"
		End Select
		Oval Int(c\x - 16), Int(c\y - 8), 32, 16, 1
		Color 255, 255, 255
		Text Int(c\x), Int(c\y), label, True, True
	Next
End Function

Function DrawShards()
	Local s.Shard
	For s.Shard = Each Shard
		Color Int(s\r * s\life), Int(s\g * s\life), Int(s\b * s\life)
		Rect Int(s\x), Int(s\y), 4, 3, 1
	Next
End Function

Function DrawHud()
	Color 220, 220, 240
	Text 24, 20, "Score " + score
	If state <> STATE_TITLE Then Text SCREEN_W / 2, 20, "Level " + level + " / " + LEVEL_COUNT, True, False
	Text SCREEN_W - 24 - StringWidth("Best " + highScore), 20, "Best " + highScore

	; One small paddle for every life left.
	Local i%
	If state <> STATE_TITLE
		Color 110, 190, 255
		For i = 1 To lives - 1
			Rect 24 + (i - 1) * 30, SCREEN_H - 20, 24, 6, 1
		Next
	EndIf

	Local p.Popup
	For p.Popup = Each Popup
		Local f# = p\life / 40.0 ; Full brightness until the last 40 frames.
		If f > 1 Then f = 1
		Color Int(255 * f), Int(240 * f), Int(160 * f)
		Text Int(p\x), Int(p\y), p\message, True, True
	Next

	Color 255, 240, 200
	Select state
		Case STATE_TITLE
			DrawTitleBricks()
			Color 220, 220, 240
			Text SCREEN_W / 2, 330, "Break every brick to clear the level. There are " + LEVEL_COUNT + " levels.", True, False
			Text SCREEN_W / 2, 360, "Mouse or Left / Right moves the paddle, click or Space launches the ball.", True, False
			Text SCREEN_W / 2, 420, "Click or press Space to start", True, False
		Case STATE_PAUSED
			Text SCREEN_W / 2, 400, "Paused - press P", True, False
		Case STATE_CLEARED
			Text SCREEN_W / 2, 400, "Level " + level + " cleared! Click or press Space", True, False
		Case STATE_OVER
			Text SCREEN_W / 2, 400, "Game over. Click or press Space", True, False
		Case STATE_WON
			Text SCREEN_W / 2, 400, "Every wall is down! Final score " + score + ". Click or press Space", True, False
	End Select
End Function

; The title "SHATTERWALL" spelled out in bricks.
Function DrawTitleBricks()
	Restore titleLetters
	Local row%
	Local column%
	For row = 0 To 4
		Local pattern$
		Read pattern
		For column = 1 To Len(pattern)
			If Mid(pattern, column, 1) = "#"
				BrickColor(2, column / 4)
				Local bx = SCREEN_W / 2 - Len(pattern) * 7 + (column - 1) * 14
				Local by = Int(170 + row * 14 + Sin(MilliSecs() / 4.0 + column * 12) * 4)
				Rect bx, by, 12, 12, 1
			EndIf
		Next
	Next
End Function

; Paints a dark background with soft glowing dots into an image once, so each frame only has to copy it.
Function MakeBackground()
	Local image = CreateImage(SCREEN_W, SCREEN_H)
	SetBuffer ImageBuffer(image)
	Local y%
	For y = 0 To SCREEN_H - 1 Step 4
		Local f# = Float(y) / SCREEN_H
		Color Int(10 + 10 * f), Int(10 + 4 * f), Int(24 + 20 * f)
		Rect 0, y, SCREEN_W, 4, 1
	Next
	Local i%
	For i = 1 To 120
		Local x = Rand(SCREEN_W), y2 = Rand(SCREEN_H), size = Rand(1, 3)
		Local light = Rand(40, 110)
		Color light / 2, light / 2, light
		Oval x, y2, size, size, 1
	Next
	SetBuffer BackBuffer()
	Return image
End Function

; --- Helpers ---------------------------------------------------------------------------------------------------------

Function Larger#(a#, b#)
	If a > b Then Return a Else Return b
End Function

Function Smaller#(a#, b#)
	If a < b Then Return a Else Return b
End Function

; Makes a short sound effect without any sound file: it writes a WAV file into a bank, saves it to the temporary
; folder, loads it and deletes the file again. The pitch slides from startHz to endHz.
Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0
	Local i%
	For i = 0 To samples - 1
		Local t# = Float(i) / samples
		Local hz# = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Local v#
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1.0
			Case WAVE_SINE
				v = Sin(phase)
			Default
				v = Rnd(-1.0, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		Local envelope# = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.6 Then envelope = envelope * (1.0 - t) / 0.4
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "shatterwall-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i%
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

