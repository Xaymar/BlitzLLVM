GoToMenu()
Local quit = False
While Not quit
	WaitTimer timer

	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_SETUP
			UpdateSetup()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_HELP
			If KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_ENTER) Or KeyHit(BB_KEY_SPACE) Or MouseHit(BB_MOUSE_LEFT) Then GoToMenu()
		Case STATE_PLAY
			UpdateRound()
			If state = STATE_PLAY And (KeyHit(BB_KEY_ESCAPE) Or KeyHit(BB_KEY_P)) Then GoToPause()
		Case STATE_PAUSED
			UpdatePause()
		Case STATE_RESULT
			PhysicsUpdate 1.0 / 60 ; The towers keep standing (or falling) behind the results.
			UpdateEffects()
			If KeyHit(BB_KEY_ESCAPE) Then GoToMenu()
			Select MenuInput()
				Case 0 : StartRound()
