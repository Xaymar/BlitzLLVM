; A mage: a robe, a face, a pointed hat and a staff whose orb glows while a spell is cast.
Function DrawMage(x, y, p, awake, scale# = 1.0)
	Local r = mageRed(p), g = mageGreen(p), b = mageBlue(p)
	If Not awake Then r = r / 3 : g = g / 3 : b = b / 3
	Local s# = scale
	mageScale = scale
	; Staff
	Color 120, 90, 60
	Rect x + S(14), y - S(40), S(3) + 1, S(44), 1
	Local orbR = 200, orbG = 200, orbB = 255
	If casting(p) > 0 Then orbR = 255 : orbG = 255 : orbB = 160
	Color orbR, orbG, orbB
	Oval x + S(10), y - S(48), S(10) + 1, S(10) + 1, 1
	; Robe
	Color r * 7 / 10, g * 7 / 10, b * 7 / 10
	Local i
	For i = 0 To Int(26 * s)
		Local half# = 4 * s + i * 0.45
		Rect x - Int(half), y - S(26) + i, Int(half * 2), 1, 1
	Next
	; Face and beard
	Color 240, 210, 180 : Oval x - S(6), y - S(36), S(12), S(11), 1
	Color 230, 230, 235 : Rect x - S(4), y - S(28), S(8) + 1, S(6), 1
	; Hat
	Color r, g, b
	For i = 0 To Int(26 * s)
		Local w# = i * 0.55
		Rect x - Int(w - 4 * s + i * 0.15), y - S(60) + i, Int(w * 2) + 1, 1, 1
	Next
	Rect x - S(13), y - S(35), S(26), S(3), 1
End Function

; Scales a size of the mage picture by the scale DrawMage was called with.
Function S(pixels)
	Return Int(pixels * mageScale)
End Function

