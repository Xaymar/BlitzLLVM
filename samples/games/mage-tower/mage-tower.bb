	For i = 0 To MAX_PLAYERS - 1
		Local y = menuTop + i * 34 + 15
		DrawMage(SCREEN_W / 2 - menuWidth / 2 - 30, y + 12, i, seatControl(i) <> CONTROL_OFF, 0.7)
