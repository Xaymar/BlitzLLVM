; --- Watermark -------------------------------------------------------------------------------------------------------
; Every frame carries a faint pattern that nobody can see: some sky pixels are one step bluer than the rest. A program
; can find the pattern again in a screenshot, which shows that the picture came from this sample game. The pattern is
; drawn as a masked image just after Cls, so the world is drawn over it.
Global watermark, watermarkColor

Function DrawWatermark(r, g, b)
	Local rgb = (r Shl 16) Or (g Shl 8) Or b
	If watermark = 0 Or rgb <> watermarkColor
		If watermark <> 0 Then FreeImage watermark
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		watermarkColor = rgb
		Local marked = b + 1
		If b = 255 Then marked = 254
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				; Black is the mask colour, so only the marked pixels are drawn.
				If (x * 7 + y * 13) Mod 29 < 3
					WritePixelFast x, y, (r Shl 16) Or (g Shl 8) Or marked, buffer
				Else
					WritePixelFast x, y, 0, buffer
				EndIf
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function

; --- Pictures --------------------------------------------------------------------------------------------------------

Function MakeTextures()
	Local x, y, buffer, v, lit, r, g, b, a#, dx#, dy#

	; The road: dark panels, bright edges and dashed lane lines. u runs across the road, v along it.
	roadTex = CreateTexture(128, 128)
	buffer = TextureBuffer(roadTex)
	LockBuffer buffer
	For y = 0 To 127
		For x = 0 To 127
			v = Rand(-4, 4)
			r = 34 + v : g = 32 + v : b = 54 + v
			If y Mod 64 = 0 Then r = 24 : g = 22 : b = 40
			If (x = 42 Or x = 43 Or x = 84 Or x = 85) And y Mod 32 < 16 Then r = 150 : g = 110 : b = 220
			If x < 5 Or x > 122 Then r = 90 : g = 220 : b = 255
			If x = 5 Or x = 122 Then r = 30 : g = 80 : b = 110
			WritePixelFast x, y, $FF000000 Or (r Shl 16) Or (g Shl 8) Or b, buffer
		Next
	Next
	UnlockBuffer buffer

	; The ground: a dark grid that fades into the fog.
	gridTex = CreateTexture(64, 64)
	buffer = TextureBuffer(gridTex)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			If x = 0 Or y = 0 Then WritePixelFast x, y, $FF4A2878, buffer Else WritePixelFast x, y, $FF140C26, buffer
		Next
	Next
	UnlockBuffer buffer
	ScaleTexture gridTex, 24, 24

	; A soft round glow, white in the middle. Drawn added to the picture, so it gives light, never shade.
	glowTex = CreateTexture(64, 64, 2)
	buffer = TextureBuffer(glowTex)
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			dx = (x - 31.5) / 31.5 : dy = (y - 31.5) / 31.5
			a = Max(0, 1 - Sqr(dx * dx + dy * dy))
			v = Int(255 * a * a)
			WritePixelFast x, y, (v Shl 24) Or (v Shl 16) Or (v Shl 8) Or v, buffer
		Next
	Next
	UnlockBuffer buffer

	; The shadow: black, more see-through towards the edges.
	shadowTex = CreateTexture(32, 32, 2)
	buffer = TextureBuffer(shadowTex)
	LockBuffer buffer
	For y = 0 To 31
		For x = 0 To 31
			dx = (x - 15.5) / 15.5 : dy = (y - 15.5) / 15.5
			a = Max(0, 1 - Sqr(dx * dx + dy * dy))
			WritePixelFast x, y, Int(170 * a) Shl 24, buffer
		Next
	Next
	UnlockBuffer buffer

	; Boost pads: yellow arrows pointing forwards. The charging strip: green bars.
	padTex = CreateTexture(64, 64)
	chargeTex = CreateTexture(64, 64)
	Local padBuffer = TextureBuffer(padTex), chargeBuffer = TextureBuffer(chargeTex)
	LockBuffer padBuffer
	LockBuffer chargeBuffer
	For y = 0 To 63
		For x = 0 To 63
			v = (y + Abs(x - 32)) Mod 32
			If v < 10 Then WritePixelFast x, y, $FFFFC830, padBuffer Else WritePixelFast x, y, $FF281800, padBuffer
			If y Mod 16 < 5 And x > 4 And x < 59 Then WritePixelFast x, y, $FF40FF90, chargeBuffer Else WritePixelFast x, y, $FF06200E, chargeBuffer
		Next
	Next
	UnlockBuffer chargeBuffer
	UnlockBuffer padBuffer

	; The weapon fields: diamonds whose colour runs through the rainbow.
	fieldTex = CreateTexture(64, 64)
	buffer = TextureBuffer(fieldTex)
	LockBuffer buffer
	Local hue#
	For y = 0 To 63
		For x = 0 To 63
			If Abs(x - 32) + Abs(y - 32) < 26 And Abs(x - 32) + Abs(y - 32) > 16
				hue = x * 360.0 / 64
				r = Int(128 + 127 * Cos(hue)) : g = Int(128 + 127 * Cos(hue - 120)) : b = Int(128 + 127 * Cos(hue + 120))
				WritePixelFast x, y, $FF000000 Or (r Shl 16) Or (g Shl 8) Or b, buffer
			Else
				WritePixelFast x, y, $FF140A20, buffer
			EndIf
		Next
	Next
	UnlockBuffer buffer

	; The start line.
	checkerTex = CreateTexture(64, 16)
	buffer = TextureBuffer(checkerTex)
	LockBuffer buffer
	For y = 0 To 15
		For x = 0 To 63
			If ((x / 8) + (y / 8)) Mod 2 = 0 Then WritePixelFast x, y, $FFF0F0F0, buffer Else WritePixelFast x, y, $FF181820, buffer
		Next
	Next
	UnlockBuffer buffer

	; Tower walls: rows of windows, some lit. The corner pixel stays dark for the roofs.
	windowTex = CreateTexture(64, 64)
	buffer = TextureBuffer(windowTex)
	SeedRnd 7
	LockBuffer buffer
	For y = 0 To 63
		For x = 0 To 63
			WritePixelFast x, y, $FF100C1E, buffer
		Next
	Next
	Local wx, wy
	For wy = 0 To 7
		For wx = 0 To 7
			lit = Rand(0, 9)
			If lit < 3
				r = 255 : g = 210 : b = 130
			ElseIf lit < 5
				r = 120 : g = 220 : b = 255
			Else
				r = 34 : g = 30 : b = 56
			EndIf
			For y = wy * 8 + 2 To wy * 8 + 6
				For x = wx * 8 + 2 To wx * 8 + 5
					WritePixelFast x, y, $FF000000 Or (r Shl 16) Or (g Shl 8) Or b, buffer
				Next
			Next
		Next
	Next
	UnlockBuffer buffer
	SeedRnd MilliSecs()
End Function

; --- Small helpers ---------------------------------------------------------------------------------------------------

Function WrapAngle#(angle#)
	While angle > 180
		angle = angle - 360
	Wend
	While angle <= -180
		angle = angle + 360
	Wend
	Return angle
End Function

Function Clamp#(value#, low#, high#)
	If value < low Then Return low
	If value > high Then Return high
	Return value
End Function

; --- Sounds ----------------------------------------------------------------------------------------------------------
; A sound made sample by sample into a WAV file in a bank, written to a temporary file and loaded from there.

Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = WaveBank(samples)
	Local phase# = 0, i, t#, hz#, v#, envelope#
	For i = 0 To samples - 1
		t = Float(i) / samples
		hz = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1
			Case WAVE_SINE
				v = Sin(phase)
			Default
				v = Rnd(-1, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		envelope = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.4 Then envelope = envelope * (1.0 - t) / 0.6
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next
	Return SoundFromBank(bank, False)
End Function

; An explosion: a sharp crack, then noise that grows darker as it dies away, over a deep rumble that sinks from
; rumbleHz. The noise goes through a simple low-pass filter whose cutoff falls over the length of the sound.
Function MakeBlastSound(lengthMs, volume#, rumbleHz#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = WaveBank(samples)
	Local i, t#, seconds#, v#, noise#, low# = 0, lower# = 0, cutoff#, phase# = 0, rumble#, envelope#
	For i = 0 To samples - 1
		t = Float(i) / samples
		seconds = Float(i) / rate
		noise = Rnd(-1, 1)
		; Two filters in a row: the second one keeps only the deepest part of the noise for the rumble.
		cutoff = 0.5 * (1 - t) * (1 - t) + 0.02
		low = low + (noise - low) * cutoff
		lower = lower + (low - lower) * 0.03
		phase = phase + 360.0 * rumbleHz * (1 - 0.4 * t) / rate
		If phase >= 360 Then phase = phase - 360
		rumble = Sin(phase) * (0.6 + 0.4 * Sin(seconds * 360 * 7))
		; The hiss dies away quickly, the rumble lingers.
		v = low * 0.6 * Exp(-seconds * 9 / (lengthMs / 1000.0))
		v = v + (lower * 6 + rumble * 0.8) * Exp(-seconds * 2.5 / (lengthMs / 1000.0))
		If seconds < 0.025 Then v = v + noise * 0.7 * (1 - seconds / 0.025) ; The crack at the start.
		envelope = 1 - t
		If i < 32 Then envelope = envelope * i / 32.0
		v = Clamp(v * envelope * volume, -1, 1)
		PokeShort bank, 44 + i * 2, Int(v * 32000) And $FFFF
	Next
	Return SoundFromBank(bank, False)
End Function

; The shield going up (a rising sweep) or down (a falling one): two tones a few waves a second apart, so they beat
; against each other and shimmer, with an octave above.
Function MakeShieldSound(startHz#, endHz#, lengthMs)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = WaveBank(samples)
	Local i, t#, hz#, a# = 0, b# = 0, c# = 0, v#, envelope#
	For i = 0 To samples - 1
		t = Float(i) / samples
		hz = startHz + (endHz - startHz) * Sqr(t)
		a = a + 360.0 * hz / rate
		b = b + 360.0 * (hz * 1.02 + 6) / rate
		c = c + 360.0 * hz * 2 / rate
		If a >= 360 Then a = a - 360
		If b >= 360 Then b = b - 360
		If c >= 360 Then c = c - 360
		v = Sin(a) * 0.45 + Sin(b) * 0.45 + Sin(c) * 0.15
		envelope = Sin(t * 180)
		PokeShort bank, 44 + i * 2, Int(v * envelope * 0.3 * 32000) And $FFFF
	Next
	Return SoundFromBank(bank, False)
End Function

; A hit on the shield: a bright zap that falls in pitch, ring-modulated so it sounds electric.
Function MakeShieldHitSound()
	Local rate = 22050, samples = 22050 / 4
	Local bank = WaveBank(samples)
	Local i, t#, a# = 0, v#
	For i = 0 To samples - 1
		t = Float(i) / samples
		a = a + 360.0 * (2200 - 1800 * t) / rate
		If a >= 360 Then a = a - 360
		v = Sin(a) * Sin(Float(i) / rate * 360 * 90) * 0.8 + Rnd(-0.2, 0.2) * (1 - t)
		v = v * (1 - t) * (1 - t)
		If i < 32 Then v = v * i / 32.0
		PokeShort bank, 44 + i * 2, Int(v * 0.35 * 32000) And $FFFF
	Next
	Return SoundFromBank(bank, False)
End Function

; The hum while the shield is up. It loops without a click: one second holds a whole number of every wave in it.
Function MakeShieldHum()
	Local rate = 22050, samples = 22050
	Local bank = WaveBank(samples)
	Local i, t#, v#
	For i = 0 To samples - 1
		t = Float(i) / rate
		v = Sin(t * 360 * 90) * 0.45 + Sin(t * 360 * 181) * 0.25 + Sin(t * 360 * 270) * 0.1
		v = v + Sin(t * 360 * 1350) * 0.07 * (0.5 + 0.5 * Sin(t * 360 * 6)) ; A faint high shimmer.
		v = v * (0.8 + 0.2 * Sin(t * 360 * 4))
		PokeShort bank, 44 + i * 2, Int(v * 0.4 * 32000) And $FFFF
	Next
	Return SoundFromBank(bank, True)
End Function

; The autopilot: a computer busy calculating. Short beeps at random pitches, with a few gaps, over a quiet hum. It
; loops, so each beep fades in and out and the hum fits a whole number of waves into the loop.
Function MakeComputerSound()
	; 24 beeps of 1225 samples make 4/3 of a second, which holds exactly 160 waves of the 120 Hz hum.
	Local rate = 22050, noteLength = 1225, notes = 24
	Local samples = noteLength * notes
	Local bank = WaveBank(samples)
	Local note, i, k, hz#, phase#, v#, envelope#, t#
	For note = 0 To notes - 1
		hz = 0
		If Rand(5) > 1 Then hz = 880 * 2 ^ (Rand(0, 18) / 12.0) ; A random note over an octave and a half.
		phase = 0
		For k = 0 To noteLength - 1
			i = note * noteLength + k
			t = Float(i) / rate
			v = Sin(t * 360 * 120) * 0.12
			If hz > 0
				phase = phase + 360.0 * hz / rate
				If phase >= 360 Then phase = phase - 360
				envelope = 1.0
				If k < 40 Then envelope = k / 40.0
				If k > noteLength - 40 Then envelope = (noteLength - k) / 40.0
				If phase < 180 Then v = v + 0.35 * envelope Else v = v - 0.35 * envelope
			EndIf
			PokeShort bank, 44 + i * 2, Int(v * 0.3 * 32000) And $FFFF
		Next
	Next
	Return SoundFromBank(bank, True)
End Function

; The engine: a low buzz that loops without a click, because it holds a whole number of waves. Its pitch follows the
; speed while racing.
Function MakeEngineSound()
	Local rate = 22050, samples = 22050 / 2
	Local bank = WaveBank(samples)
	Local i, t#, v#
	For i = 0 To samples - 1
		t = Float(i) / rate
		; 110 and 220 waves a second fit exactly into half a second, and so does the slow wobble.
		v = Sin(t * 360 * 110) * 0.5 + Sin(t * 360 * 220) * 0.25 + Sin(t * 360 * 330) * 0.12
		v = v * (0.8 + 0.2 * Sin(t * 360 * 8))
		PokeShort bank, 44 + i * 2, Int(v * 0.5 * 32000) And $FFFF
	Next
	Return SoundFromBank(bank, True)
End Function

; A bank with a WAV header for 16-bit mono sound at 22050 samples a second; the samples go after byte 44.
Function WaveBank(samples)
	Local bank = CreateBank(44 + samples * 2)
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, 22050
	PokeInt bank, 28, 22050 * 2 ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2
	Return bank
End Function

Function SoundFromBank(bank, looping)
	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "hoverline-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	If sound <> 0 And looping Then LoopSound sound
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

