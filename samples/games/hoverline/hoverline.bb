; --- Building the track ----------------------------------------------------------------------------------------------

Function BuildTrack(index)
	If trackRoot <> 0 Then FreeEntity trackRoot
	trackRoot = CreatePivot()

	Select index
		Case 0 : Restore TrackHarbour
		Case 1 : Restore TrackCanyon
		Default : Restore TrackKnot
	End Select
	Local count, i, j, k
	Read trackName, count, accentR, accentG, accentB
	For i = 0 To count - 1
		Read pointX(i), pointY(i), pointZ(i)
	Next

	; Walk along the curve in small steps, and remember how far along each step is.
	Local dense = count * POINT_STEPS, a, b, c, d, t#
	For i = 0 To count - 1
		a = (i + count - 1) Mod count : b = i : c = (i + 1) Mod count : d = (i + 2) Mod count
		For k = 0 To POINT_STEPS - 1
			t = Float(k) / POINT_STEPS
			j = i * POINT_STEPS + k
			denseX(j) = CatmullRom(pointX(a), pointX(b), pointX(c), pointX(d), t)
			denseY(j) = CatmullRom(pointY(a), pointY(b), pointY(c), pointY(d), t)
			denseZ(j) = CatmullRom(pointZ(a), pointZ(b), pointZ(c), pointZ(d), t)
		Next
	Next
	denseAt(0) = 0
	For j = 0 To dense - 1
		k = (j + 1) Mod dense
		denseAt(j + 1) = denseAt(j) + Distance(denseX(j), denseY(j), denseZ(j), denseX(k), denseY(k), denseZ(k))
	Next
	trackLength = denseAt(dense)

	; Then cut the curve into slices of the same length.
	slices = Int(trackLength / SLICE)
	If slices > MAX_SAMPLES Then slices = MAX_SAMPLES
	sliceLength = trackLength / slices
	Local at#, f#
	j = 0
	For i = 0 To slices - 1
		at = i * sliceLength
		While denseAt(j + 1) < at
			j = j + 1
		Wend
		k = (j + 1) Mod dense
		f = (at - denseAt(j)) / (denseAt(j + 1) - denseAt(j))
		tX(i) = denseX(j) + (denseX(k) - denseX(j)) * f
		tY(i) = denseY(j) + (denseY(k) - denseY(j)) * f
		tZ(i) = denseZ(j) + (denseZ(k) - denseZ(j)) * f
	Next

	; Forward points from the slice before to the slice after. The heading is the yaw of an entity facing that way.
	Local length#
	For i = 0 To slices - 1
		a = (i + slices - 1) Mod slices : c = (i + 1) Mod slices
		fX(i) = tX(c) - tX(a) : fY(i) = tY(c) - tY(a) : fZ(i) = tZ(c) - tZ(a)
		length = Sqr(fX(i) * fX(i) + fY(i) * fY(i) + fZ(i) * fZ(i))
		fX(i) = fX(i) / length : fY(i) = fY(i) / length : fZ(i) = fZ(i) / length
		tYaw(i) = ATan2(-fX(i), fZ(i))
	Next
	For i = 0 To slices - 1
		tTurn(i) = WrapAngle(tYaw((i + 1) Mod slices) - tYaw(i))
	Next

	; The road leans into the corners: more where the track turns more, smoothed over a few slices.
	Local sum#
	For i = 0 To slices - 1
		sum = 0
		For k = -8 To 8
			sum = sum + tTurn((i + k + slices) Mod slices)
		Next
		tBank(i) = Clamp(sum / 17.0 * 3.5, -24, 24) ; A left turn lifts the right side.
	Next

	; Right lies flat first, then tilts by the lean. Up is at right angles to forward and right.
	Local flatRX#, flatRZ#, flatUX#, flatUY#, flatUZ#, cosB#, sinB#
	For i = 0 To slices - 1
		length = Sqr(fX(i) * fX(i) + fZ(i) * fZ(i))
		flatRX = fZ(i) / length : flatRZ = -fX(i) / length
		Cross(fX(i), fY(i), fZ(i), flatRX, 0, flatRZ)
		flatUX = hX : flatUY = hY : flatUZ = hZ
		cosB = Cos(tBank(i)) : sinB = Sin(tBank(i))
		rX(i) = flatRX * cosB + flatUX * sinB
		rY(i) = flatUY * sinB
		rZ(i) = flatRZ * cosB + flatUZ * sinB
		Cross(fX(i), fY(i), fZ(i), rX(i), rY(i), rZ(i))
		uX(i) = hX : uY(i) = hY : uZ(i) = hZ
	Next

	; Boost pads, as a part of the lap and a distance from the middle, and the strip that charges energy.
	Read pads
	For i = 0 To pads - 1
		Read f, padLat(i)
		padSlice(i) = Int(f * slices)
	Next
	Local fromPart#, toPart#
	Read fromPart, toPart, chargeLat
	chargeFrom = Int(fromPart * slices)
	chargeTo = Int(toPart * slices)

	; Jumps: a ramp that rises at the end, then a gap with no road. Open parts: road without walls.
	For i = 0 To slices - 1
		sliceKind(i) = KIND_ROAD
	Next
	Local jumps, lift#, gapSlices, s0
	Read jumps
	For j = 1 To jumps
		Read f, lift, gapSlices
		s0 = Int(f * slices)
		For k = 0 To RAMP_SLICES - 1
			t = Float(k + 1) / RAMP_SLICES
			; Only the height changes, not the directions, so the road under the ramp stays where it was.
			tY((s0 + k) Mod slices) = tY((s0 + k) Mod slices) + lift * t * t
			sliceKind((s0 + k) Mod slices) = KIND_RAMP
		Next
		For k = 0 To gapSlices - 1
			sliceKind((s0 + RAMP_SLICES + k) Mod slices) = KIND_GAP
		Next
	Next
	Local opens
	Read opens
	For j = 1 To opens
		Read fromPart, toPart
		For i = Int(fromPart * slices) To Int(toPart * slices)
			sliceKind(i Mod slices) = KIND_OPEN
		Next
	Next
	; The rainbow weapon fields, as parts of the lap.
	Read fields
	For j = 0 To fields - 1
		Read f
		fieldSlice(j) = Int(f * slices)
	Next

	BuildRoad()
	BuildWalls()
	BuildDecoration()
	BuildCity()
	MakeMinimap()
End Function

Function CatmullRom#(p0#, p1#, p2#, p3#, t#)
	Return 0.5 * (2 * p1 + (p2 - p0) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t + (3 * p1 - p0 - 3 * p2 + p3) * t * t * t)
End Function

Function Distance#(x1#, y1#, z1#, x2#, y2#, z2#)
	Return Sqr((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1) + (z2 - z1) * (z2 - z1))
End Function

; The cross product of two directions, into hX, hY and hZ.
Function Cross(ax#, ay#, az#, bx#, by#, bz#)
	hX = ay * bz - az * by
	hY = az * bx - ax * bz
	hZ = ax * by - ay * bx
End Function

; A point on the track into gX, gY and gZ: dist along it, lat right of the middle and height above the road.
Function TrackPoint(dist#, lat#, height#)
	Local s# = dist / sliceLength
	Local i = Int(Floor(s)) Mod slices, n = (i + 1) Mod slices, f# = s - Floor(s)
	If i < 0 Then i = i + slices : n = (i + 1) Mod slices
	Local px# = tX(i) + (tX(n) - tX(i)) * f, py# = tY(i) + (tY(n) - tY(i)) * f, pz# = tZ(i) + (tZ(n) - tZ(i)) * f
	Local ux# = uX(i) + (uX(n) - uX(i)) * f, uy# = uY(i) + (uY(n) - uY(i)) * f, uz# = uZ(i) + (uZ(n) - uZ(i)) * f
	Local rx# = rX(i) + (rX(n) - rX(i)) * f, ry# = rY(i) + (rY(n) - rY(i)) * f, rz# = rZ(i) + (rZ(n) - rZ(i)) * f
	gX = px + rx * lat + ux * height
	gY = py + ry * lat + uy * height
	gZ = pz + rz * lat + uz * height
End Function

; The heading of the track at a distance along it, smoothly between slices.
Function TrackYaw#(dist#)
	Local s# = dist / sliceLength
	Local i = Int(Floor(s)) Mod slices, f# = s - Floor(s)
	Return tYaw(i) + tTurn(i) * f
End Function

Function SliceAt(dist#)
	Return Int(Floor(dist / sliceLength)) Mod slices
End Function

; The point of a slice moved along its own right, up and forward directions, into gX, gY and gZ.
Function FramePoint(i, lat#, height#, along#)
	gX = tX(i) + rX(i) * lat + uX(i) * height + fX(i) * along
	gY = tY(i) + rY(i) * lat + uY(i) * height + fY(i) * along
	gZ = tZ(i) + rZ(i) * lat + uZ(i) * height + fZ(i) * along
End Function

Function AddQuad(surface, x1#, y1#, z1#, x2#, y2#, z2#, x3#, y3#, z3#, x4#, y4#, z4#)
	Local base = CountVertices(surface)
	AddVertex surface, x1, y1, z1
	AddVertex surface, x2, y2, z2
	AddVertex surface, x3, y3, z3
	AddVertex surface, x4, y4, z4
	AddTriangle surface, base, base + 1, base + 2
	AddTriangle surface, base, base + 2, base + 3
	Return base
End Function

Function ColorQuad(surface, base, r1#, g1#, b1#, r2#, g2#, b2#)
	VertexColor surface, base, r1, g1, b1
	VertexColor surface, base + 1, r2, g2, b2
	VertexColor surface, base + 2, r2, g2, b2
	VertexColor surface, base + 3, r1, g1, b1
End Function

; The six sides of the box in cornerX/Y/Z, in one colour. Sides get texture coordinates that repeat every uvSize
; units along their width and height; the top and bottom take the corner of the texture.
Function AddBox(surface, r#, g#, b#, width#, height#, uvSize#)
	Local s, c, base, n, u#, v#
	For s = 0 To 5
		base = CountVertices(surface)
		For c = 0 To 3
			n = boxFace(s, c)
			If s < 2
				AddVertex surface, cornerX(n), cornerY(n), cornerZ(n), 0.01, 0.01
			Else
				u = 0 : v = 0
				If c = 2 Or c = 3 Then u = width / uvSize
				If c = 0 Or c = 3 Then v = height / uvSize
				AddVertex surface, cornerX(n), cornerY(n), cornerZ(n), u, v
			EndIf
			VertexColor surface, base + c, r, g, b
		Next
		AddTriangle surface, base, base + 1, base + 2
		AddTriangle surface, base, base + 2, base + 3
	Next
End Function

; A box lined up with slice i: from lat0 to lat1 across, h0 to h1 up, along0 to along1 forward.
Function FrameBox(surface, i, lat0#, lat1#, h0#, h1#, along0#, along1#, r#, g#, b#)
	Local n, lat#, h#, along#
	For n = 0 To 7
		lat = lat0 : h = h0 : along = along0
		If n And 1 Then lat = lat1
		If n And 2 Then h = h1
		If n And 4 Then along = along1
		FramePoint(i, lat, h, along)
		cornerX(n) = gX : cornerY(n) = gY : cornerZ(n) = gZ
	Next
	AddBox(surface, r, g, b, 1, 1, 1)
End Function

; A box lined up with the world.
Function WorldBox(surface, x0#, y0#, z0#, x1#, y1#, z1#, r#, g#, b#, uvSize#)
	Local n
	For n = 0 To 7
		If n And 1 Then cornerX(n) = x1 Else cornerX(n) = x0
		If n And 2 Then cornerY(n) = y1 Else cornerY(n) = y0
		If n And 4 Then cornerZ(n) = z1 Else cornerZ(n) = z0
	Next
	AddBox(surface, r, g, b, x1 - x0, y1 - y0, uvSize)
End Function

; The road: one textured strip from slice to slice, and a dark underside with edges below it.
Function BuildRoad()
	Local road = CreateMesh(trackRoot)
	Local top = CreateSurface(road)
	Local i, n, base, v0#, v1#
	For i = 0 To slices - 1
		n = (i + 1) Mod slices
		If HasRoad(i)
			base = CountVertices(top)
			v0 = i / 8.0 : v1 = (i + 1) / 8.0
			FramePoint(i, -TRACK_HALF, 0, 0) : AddVertex top, gX, gY, gZ, 0, v0
			FramePoint(n, -TRACK_HALF, 0, 0) : AddVertex top, gX, gY, gZ, 0, v1
			FramePoint(n, TRACK_HALF, 0, 0) : AddVertex top, gX, gY, gZ, 1, v1
			FramePoint(i, TRACK_HALF, 0, 0) : AddVertex top, gX, gY, gZ, 1, v0
			AddTriangle top, base, base + 1, base + 2
			AddTriangle top, base, base + 2, base + 3
		EndIf
	Next
	EntityTexture road, roadTex
	EntityFX road, 1

	; Red and white stripes along the edges where there are no walls, and across the end of every ramp.
	Local stripes = CreateMesh(trackRoot)
	Local stripeSurface = CreateSurface(stripes)
	Local sideSign, edge#, red#, x#, k
	For i = 0 To slices - 1
		If sliceKind(i) = KIND_OPEN
			n = (i + 1) Mod slices
			red = Float((i Mod 2) = 0)
			For sideSign = -1 To 1 Step 2
				edge = TRACK_HALF * sideSign
				FrameBox(stripeSurface, i, edge - 0.6, edge + 0.6, 0, 0.12, 0, sliceLength, 255 - red * 15, 255 - red * 215, 255 - red * 215)
			Next
		EndIf
		If sliceKind(i) = KIND_RAMP And sliceKind((i + 1) Mod slices) = KIND_GAP
			For k = 0 To 8
				red = Float((k Mod 2) = 0)
				x = -TRACK_HALF + k * TRACK_HALF * 2 / 9
				FrameBox(stripeSurface, i, x, x + TRACK_HALF * 2 / 9, 0, 0.12, -1.5, 0, 255 - red * 15, 255 - red * 215, 255 - red * 215)
			Next
		EndIf
	Next
	EntityFX stripes, 1 + 2

	; The start line: a chequered band across the road.
	Local startLine = CreateMesh(trackRoot)
	Local surface = CreateSurface(startLine)
	base = CountVertices(surface)
	FramePoint(0, -TRACK_HALF, 0.05, -1.5) : AddVertex surface, gX, gY, gZ, 0, 1
	FramePoint(0, -TRACK_HALF, 0.05, 1.5) : AddVertex surface, gX, gY, gZ, 0, 0
	FramePoint(0, TRACK_HALF, 0.05, 1.5) : AddVertex surface, gX, gY, gZ, 1, 0
	FramePoint(0, TRACK_HALF, 0.05, -1.5) : AddVertex surface, gX, gY, gZ, 1, 1
	AddTriangle surface, base, base + 1, base + 2
	AddTriangle surface, base, base + 2, base + 3
	EntityTexture startLine, checkerTex
	EntityFX startLine, 1

	; Boost pads and the charging strip glow, so they are added to the picture instead of covering it.
	Local overlay = CreateMesh(trackRoot)
	surface = CreateSurface(overlay)
	Local p, s
	For p = 0 To pads - 1
		For k = 0 To 3
			s = (padSlice(p) + k) Mod slices
			n = (s + 1) Mod slices
			base = CountVertices(surface)
			FramePoint(s, padLat(p) - 2.5, 0.06, 0) : AddVertex surface, gX, gY, gZ, 0, k * 0.5
			FramePoint(n, padLat(p) - 2.5, 0.06, 0) : AddVertex surface, gX, gY, gZ, 0, k * 0.5 + 0.5
			FramePoint(n, padLat(p) + 2.5, 0.06, 0) : AddVertex surface, gX, gY, gZ, 1, k * 0.5 + 0.5
			FramePoint(s, padLat(p) + 2.5, 0.06, 0) : AddVertex surface, gX, gY, gZ, 1, k * 0.5
			AddTriangle surface, base, base + 1, base + 2
			AddTriangle surface, base, base + 2, base + 3
		Next
	Next
	EntityTexture overlay, padTex
	EntityFX overlay, 1
	EntityBlend overlay, 3

	Local charge = CreateMesh(trackRoot)
	surface = CreateSurface(charge)
	For s = chargeFrom To chargeTo - 1
		n = (s + 1) Mod slices
		base = CountVertices(surface)
		FramePoint(s, chargeLat - 3, 0.06, 0) : AddVertex surface, gX, gY, gZ, 0, (s - chargeFrom) * 0.25
		FramePoint(n, chargeLat - 3, 0.06, 0) : AddVertex surface, gX, gY, gZ, 0, (s - chargeFrom + 1) * 0.25
		FramePoint(n, chargeLat + 3, 0.06, 0) : AddVertex surface, gX, gY, gZ, 1, (s - chargeFrom + 1) * 0.25
		FramePoint(s, chargeLat + 3, 0.06, 0) : AddVertex surface, gX, gY, gZ, 1, (s - chargeFrom) * 0.25
		AddTriangle surface, base, base + 1, base + 2
		AddTriangle surface, base, base + 2, base + 3
	Next
	EntityTexture charge, chargeTex
	EntityFX charge, 1
	EntityBlend charge, 3

	; The weapon fields: rainbow diamonds right across the road.
	fieldMesh = CreateMesh(trackRoot)
	surface = CreateSurface(fieldMesh)
	For p = 0 To fields - 1
		For k = 0 To 2
			s = (fieldSlice(p) + k) Mod slices
			n = (s + 1) Mod slices
			base = CountVertices(surface)
			FramePoint(s, -TRACK_HALF, 0.07, 0) : AddVertex surface, gX, gY, gZ, 0, k * 0.5
			FramePoint(n, -TRACK_HALF, 0.07, 0) : AddVertex surface, gX, gY, gZ, 0, k * 0.5 + 0.5
			FramePoint(n, TRACK_HALF, 0.07, 0) : AddVertex surface, gX, gY, gZ, 4, k * 0.5 + 0.5
			FramePoint(s, TRACK_HALF, 0.07, 0) : AddVertex surface, gX, gY, gZ, 4, k * 0.5
			AddTriangle surface, base, base + 1, base + 2
			AddTriangle surface, base, base + 2, base + 3
		Next
	Next
	EntityTexture fieldMesh, fieldTex
	EntityFX fieldMesh, 1
	EntityBlend fieldMesh, 3
	If Not raceWeapons Then HideEntity fieldMesh

	; Underneath: the bottom and both edges of the road, in dark colours.
	Local under = CreateMesh(trackRoot)
	surface = CreateSurface(under)
	Local x1#, y1#, z1#, x2#, y2#, z2#, x3#, y3#, z3#, x4#, y4#, z4#
	For i = 0 To slices - 1
		n = (i + 1) Mod slices
		If HasRoad(i)
			FramePoint(i, -TRACK_HALF, -0.8, 0) : x1 = gX : y1 = gY : z1 = gZ
			FramePoint(i, TRACK_HALF, -0.8, 0) : x2 = gX : y2 = gY : z2 = gZ
			FramePoint(n, TRACK_HALF, -0.8, 0) : x3 = gX : y3 = gY : z3 = gZ
			FramePoint(n, -TRACK_HALF, -0.8, 0) : x4 = gX : y4 = gY : z4 = gZ
			base = AddQuad(surface, x1, y1, z1, x2, y2, z2, x3, y3, z3, x4, y4, z4)
			ColorQuad(surface, base, 22, 18, 38, 22, 18, 38)
			For sideSign = -1 To 1 Step 2
				edge = TRACK_HALF * sideSign
				FramePoint(i, edge, -0.8, 0) : x1 = gX : y1 = gY : z1 = gZ
				FramePoint(i, edge, 0, 0) : x2 = gX : y2 = gY : z2 = gZ
				FramePoint(n, edge, 0, 0) : x3 = gX : y3 = gY : z3 = gZ
				FramePoint(n, edge, -0.8, 0) : x4 = gX : y4 = gY : z4 = gZ
				base = AddQuad(surface, x1, y1, z1, x2, y2, z2, x3, y3, z3, x4, y4, z4)
				ColorQuad(surface, base, 30, 26, 52, accentR / 3, accentG / 3, accentB / 3)
			Next
		EndIf
	Next
	EntityFX under, 1 + 2 + 16
End Function

; The walls are see-through light: drawn added to the picture, bright at the bottom and fading out at the top, with
; a bright rail along the top.
Function BuildWalls()
	Local walls = CreateMesh(trackRoot)
	Local surface = CreateSurface(walls)
	Local i, n, base, sideSign, edge#, rail#
	Local x1#, y1#, z1#, x2#, y2#, z2#, x3#, y3#, z3#, x4#, y4#, z4#
	For i = 0 To slices - 1
		n = (i + 1) Mod slices
		If HasWalls(i)
			For sideSign = -1 To 1 Step 2
				edge = TRACK_HALF * sideSign
				FramePoint(i, edge, 0, 0) : x1 = gX : y1 = gY : z1 = gZ
				FramePoint(i, edge, WALL_HEIGHT, 0) : x2 = gX : y2 = gY : z2 = gZ
				FramePoint(n, edge, WALL_HEIGHT, 0) : x3 = gX : y3 = gY : z3 = gZ
				FramePoint(n, edge, 0, 0) : x4 = gX : y4 = gY : z4 = gZ
				base = AddQuad(surface, x1, y1, z1, x2, y2, z2, x3, y3, z3, x4, y4, z4)
				ColorQuad(surface, base, accentR * 3 / 4, accentG * 3 / 4, accentB * 3 / 4, accentR / 10, accentG / 10, accentB / 10)

				rail = edge + 0.3 * sideSign
				FramePoint(i, edge, WALL_HEIGHT, 0) : x1 = gX : y1 = gY : z1 = gZ
				FramePoint(i, rail, WALL_HEIGHT, 0) : x2 = gX : y2 = gY : z2 = gZ
				FramePoint(n, rail, WALL_HEIGHT, 0) : x3 = gX : y3 = gY : z3 = gZ
				FramePoint(n, edge, WALL_HEIGHT, 0) : x4 = gX : y4 = gY : z4 = gZ
				base = AddQuad(surface, x1, y1, z1, x2, y2, z2, x3, y3, z3, x4, y4, z4)
				ColorQuad(surface, base, 255, 255, 255, 255, 255, 255)
			Next
		EndIf
	Next
	EntityFX walls, 1 + 2 + 16
	EntityBlend walls, 3
End Function

; True where slice i has road up to the next slice: not in a gap, and not the last slice before one.
Function HasRoad(i)
	Return sliceKind(i) <> KIND_GAP And sliceKind((i + 1) Mod slices) <> KIND_GAP
End Function

Function HasWalls(i)
	Return HasRoad(i) And sliceKind(i) <> KIND_OPEN
End Function

; Arches over the road, the start gate, and pillars that hold the road up.
Function BuildDecoration()
	Local deco = CreateMesh(trackRoot)
	Local surface = CreateSurface(deco)
	Local i, k, every = slices / 10, post# = TRACK_HALF + 0.9
	For i = every / 2 To slices - every / 2 Step every
		If HasWalls(i)
			FrameBox(surface, i, -post - 0.5, -post + 0.5, -0.8, 8.5, -0.5, 0.5, 40, 34, 70)
			FrameBox(surface, i, post - 0.5, post + 0.5, -0.8, 8.5, -0.5, 0.5, 40, 34, 70)
			FrameBox(surface, i, -post - 0.5, post + 0.5, 8.5, 9.2, -0.5, 0.5, accentR, accentG, accentB)
		EndIf
	Next

	; The start gate: tall posts and a chequered beam.
	FrameBox(surface, 0, -post - 0.8, -post + 0.8, -0.8, 11, -0.8, 0.8, 60, 50, 90)
	FrameBox(surface, 0, post - 0.8, post + 0.8, -0.8, 11, -0.8, 0.8, 60, 50, 90)
	Local width# = (post * 2 + 1.6) / 12, x#, shade
	For k = 0 To 11
		x = -post - 0.8 + k * width
		For shade = 0 To 1
			If (k + shade) Mod 2 = 0
				FrameBox(surface, 0, x, x + width, 9.5 + shade * 0.75, 10.25 + shade * 0.75, -0.6, 0.6, 250, 250, 250)
			Else
				FrameBox(surface, 0, x, x + width, 9.5 + shade * 0.75, 10.25 + shade * 0.75, -0.6, 0.6, 20, 20, 30)
			EndIf
		Next
	Next

	; A warning arch where every ramp starts, red and white.
	For i = 0 To slices - 1
		If sliceKind(i) = KIND_RAMP And sliceKind((i + slices - 1) Mod slices) <> KIND_RAMP
			FrameBox(surface, i, -post - 0.5, -post + 0.5, -0.8, 8.5, -0.5, 0.5, 240, 60, 60)
			FrameBox(surface, i, post - 0.5, post + 0.5, -0.8, 8.5, -0.5, 0.5, 240, 60, 60)
			For k = 0 To 7
				If k Mod 2 = 0
					FrameBox(surface, i, -post - 0.5 + k * (post * 2 + 1) / 8, -post - 0.5 + (k + 1) * (post * 2 + 1) / 8, 8.5, 9.4, -0.5, 0.5, 250, 250, 250)
				Else
					FrameBox(surface, i, -post - 0.5 + k * (post * 2 + 1) / 8, -post - 0.5 + (k + 1) * (post * 2 + 1) / 8, 8.5, 9.4, -0.5, 0.5, 240, 50, 50)
				EndIf
			Next
		EndIf
	Next

	; Pillars from the ground up to the road, except where they would go through a lower part of the track.
	For i = 0 To slices - 1 Step 9
		If tY(i) > 2.5 And HasRoad(i) And sliceKind(i) <> KIND_RAMP And Not TrackBelow(i)
			WorldBox(surface, tX(i) - 1.2, 0, tZ(i) - 1.2, tX(i) + 1.2, tY(i) - 1.0, tZ(i) + 1.2, 34, 30, 58, 1)
			WorldBox(surface, tX(i) - 1.4, tY(i) - 1.6, tZ(i) - 1.4, tX(i) + 1.4, tY(i) - 1.2, tZ(i) + 1.4, accentR, accentG, accentB, 1)
		EndIf
	Next
	EntityFX deco, 1 + 2
End Function

; True if another, lower part of the track passes under slice i.
Function TrackBelow(i)
	Local j, dx#, dz#
	For j = 0 To slices - 1
		If Abs(j - i) > 20 And Abs(j - i) < slices - 20 And tY(j) < tY(i) - 1
			dx = tX(j) - tX(i) : dz = tZ(j) - tZ(i)
			If dx * dx + dz * dz < (TRACK_HALF + 4) * (TRACK_HALF + 4) Then Return True
		EndIf
	Next
	Return False
End Function

; Towers with lit windows all around the track, but never on it.
Function BuildCity()
	SeedRnd 1234 ; The same city every time.
	Local city = CreateMesh(trackRoot)
	Local surface = CreateSurface(city)
	Local placed = 0, tries = 0, x#, z#, w#, h#, j, ok, dx#, dz#, room#
	While placed < 90 And tries < 2000
		tries = tries + 1
		x = Rnd(-650, 650) : z = Rnd(-650, 650)
		w = Rnd(10, 26) : h = Rnd(18, 110)
		ok = True
		room = TRACK_HALF + w + 10
		For j = 0 To slices - 1 Step 2
			dx = tX(j) - x : dz = tZ(j) - z
			If dx * dx + dz * dz < room * room Then ok = False : Exit
		Next
		If ok
			WorldBox(surface, x - w / 2, 0, z - w / 2, x + w / 2, h, z + w / 2, 255, 255, 255, 16)
			placed = placed + 1
		EndIf
	Wend
	EntityTexture city, windowTex
	EntityFX city, 1
	SeedRnd MilliSecs()
End Function

; A ring of dark hills on the horizon, with a warm glow behind them. It moves with the camera, so it is always far
; away, and fog does not hide it.
Function MakeMountains()
	Local ring = CreateMesh()
	Local surface = CreateSurface(ring), glowSurface = CreateSurface(ring)
	Local k, a0#, a1#, h0#, h1#, base, radius# = 900, glowRadius# = 950
	SeedRnd 99
	Local firstHeight# = Rnd(40, 150)
	h0 = firstHeight
	For k = 0 To 47
		a0 = k * 7.5 : a1 = (k + 1) * 7.5
		If k = 47 Then h1 = firstHeight Else h1 = Rnd(40, 150)
		base = AddQuad(surface, Sin(a0) * radius, -20, Cos(a0) * radius, Sin(a0) * radius, h0, Cos(a0) * radius, Sin(a1) * radius, h1, Cos(a1) * radius, Sin(a1) * radius, -20, Cos(a1) * radius)
		ColorQuad(surface, base, 20, 12, 36, 28, 16, 48)
		base = AddQuad(glowSurface, Sin(a0) * glowRadius, -20, Cos(a0) * glowRadius, Sin(a0) * glowRadius, 260, Cos(a0) * glowRadius, Sin(a1) * glowRadius, 260, Cos(a1) * glowRadius, Sin(a1) * glowRadius, -20, Cos(a1) * glowRadius)
		ColorQuad(glowSurface, base, 150, 60, 90, SKY_R, SKY_G, SKY_B)
		h0 = h1
	Next
	SeedRnd MilliSecs()
	EntityFX ring, 1 + 2 + 8 + 16
	Return ring
End Function

; --- Crafts ----------------------------------------------------------------------------------------------------------

Function NewCraft.Craft(name$, r, g, b, computer, skill#, ship)
	Local c.Craft = New Craft
	SetShip(c, ship)
	c\index = CraftCount() - 1
	c\name = name
	c\r = r : c\g = g : c\b = b
	c\computer = computer
	c\skill = skill
	MakeCraftMesh(c)
	Return c
End Function

Function MakeCraftMesh(c.Craft)
	Local mesh = CreateMesh()
	Local surface = CreateSurface(mesh)
	Local r# = Float(c\r), g# = Float(c\g), b# = Float(c\b)
	; The body: a wedge with a raised cockpit, made of flat triangles.
	AddTriangle3(surface, 0, 0, 2.4, 0.95, 0.25, -1.5, 0, 0.55, -0.5, r, g, b)
	AddTriangle3(surface, 0, 0, 2.4, 0, 0.55, -0.5, -0.95, 0.25, -1.5, r, g, b)
	AddTriangle3(surface, 0, 0.55, -0.5, 0.95, 0.25, -1.5, -0.95, 0.25, -1.5, r * 2 / 3, g * 2 / 3, b * 2 / 3)
	AddTriangle3(surface, 0, 0, 2.4, 1.05, -0.2, -1.6, 0.95, 0.25, -1.5, r * 3 / 4, g * 3 / 4, b * 3 / 4)
	AddTriangle3(surface, 0, 0, 2.4, -0.95, 0.25, -1.5, -1.05, -0.2, -1.6, r * 3 / 4, g * 3 / 4, b * 3 / 4)
	AddTriangle3(surface, 0, 0, 2.4, -1.05, -0.2, -1.6, 1.05, -0.2, -1.6, 40, 40, 50)
	AddTriangle3(surface, -0.95, 0.25, -1.5, 0.95, 0.25, -1.5, 1.05, -0.2, -1.6, 50, 50, 60)
	AddTriangle3(surface, -0.95, 0.25, -1.5, 1.05, -0.2, -1.6, -1.05, -0.2, -1.6, 50, 50, 60)
	; The canopy, a dark glass bump.
	AddTriangle3(surface, 0, 0.34, 0.9, 0.3, 0.38, -0.2, 0, 0.62, -0.35, 30, 50, 90)
	AddTriangle3(surface, 0, 0.34, 0.9, 0, 0.62, -0.35, -0.3, 0.38, -0.2, 30, 50, 90)
	; Two engine pods and a fin.
	WorldBox(surface, -1.55, -0.25, -1.8, -1.05, 0.2, 0.3, 70, 70, 85, 1)
	WorldBox(surface, 1.05, -0.25, -1.8, 1.55, 0.2, 0.3, 70, 70, 85, 1)
	WorldBox(surface, -1.6, 0.2, -1.2, -1.0, 0.26, 0.2, r, g, b, 1)
	WorldBox(surface, 1.0, 0.2, -1.2, 1.6, 0.26, 0.2, r, g, b, 1)
	AddTriangle3(surface, 0, 0.3, -0.9, 0, 1.1, -1.8, 0, 0.3, -1.6, r, g, b)
	AddTriangle3(surface, 0, 0.3, -0.9, 0, 0.3, -1.6, 0, 1.1, -1.8, r, g, b)
	UpdateNormals mesh
	EntityFX mesh, 2
	EntityShininess mesh, 0.6

	; The glow of the engines, a sprite that grows with the throttle.
	c\glow = CopyEntity(sparkTemplate, mesh)
	ShowEntity c\glow
	PositionEntity c\glow, 0, 0, -1.9
	EntityColor c\glow, 255, 170, 90
	EntityFX c\glow, 1

	; The shadow: a soft dark spot on the road under the craft.
	Local shadow = CreateMesh(mesh)
	Local s = CreateSurface(shadow)
	AddVertex s, -1.6, -HOVER + 0.08, -2.2, 0, 1
	AddVertex s, -1.6, -HOVER + 0.08, 2.6, 0, 0
	AddVertex s, 1.6, -HOVER + 0.08, 2.6, 1, 0
	AddVertex s, 1.6, -HOVER + 0.08, -2.2, 1, 1
	AddTriangle s, 0, 1, 2
	AddTriangle s, 0, 2, 3
	EntityTexture shadow, shadowTex
	EntityFX shadow, 1
	c\shadow = shadow

	; The shield: a see-through bubble, shown while the shield is up.
	c\shieldBubble = CreateSphere(10, mesh)
	ScaleEntity c\shieldBubble, 2.0, 1.2, 2.9
	EntityColor c\shieldBubble, 90, 180, 255
	EntityAlpha c\shieldBubble, 0.45
	EntityBlend c\shieldBubble, 3
	EntityFX c\shieldBubble, 1 + 16
	HideEntity c\shieldBubble
	c\mesh = mesh
End Function

Function AddTriangle3(surface, x1#, y1#, z1#, x2#, y2#, z2#, x3#, y3#, z3#, r#, g#, b#)
	Local base = CountVertices(surface)
	AddVertex surface, x1, y1, z1
	AddVertex surface, x2, y2, z2
	AddVertex surface, x3, y3, z3
	VertexColor surface, base, r, g, b
	VertexColor surface, base + 1, r, g, b
	VertexColor surface, base + 2, r, g, b
	AddTriangle surface, base, base + 1, base + 2
End Function

; The direction a craft moves in, into hX, hY and hZ: the track's forward, turned left by vang.
Function CraftHeading(c.Craft, angle#)
	Local i = SliceAt(c\d)
	hX = fX(i) * Cos(angle) - rX(i) * Sin(angle)
	hY = fY(i) * Cos(angle) - rY(i) * Sin(angle)
	hZ = fZ(i) * Cos(angle) - rZ(i) * Sin(angle)
End Function

; Puts the mesh where the craft is: up along the road's up, the nose where the craft points, leaning into turns.
Function PlaceCraft(c.Craft)
	Local bob# = Sin(frame * 4 + c\lat * 40) * 0.06
	If c\airborne Then bob = 0
	CraftPoint(c, HOVER + bob)
	PositionEntity c\mesh, gX, gY, gZ
	Local i = SliceAt(c\d)
	RotateEntity c\mesh, 0, 0, 0
	AlignToVector c\mesh, uX(i), uY(i), uZ(i), 2, 1
	CraftHeading(c, c\ang)
	TFormVector hX, hY, hZ, 0, c\mesh
	TurnEntity c\mesh, 0, ATan2(-TFormedX(), TFormedZ()), 0
	; The nose follows the climb or the fall, beyond the slope of the road itself.
	Local slope# = c\vy - fY(i) * c\spd * Cos(c\vang)
	TurnEntity c\mesh, -Clamp(ATan2(slope, Max(c\spd, 0.3)), -30, 30), 0, c\steer * 14
	If c\airborne And c\y > Ground(c\d, c\lat) + 2 Then HideEntity c\shadow Else ShowEntity c\shadow
	If c\shield > 0 And (c\shield > 60 Or frame Mod 8 < 5) Then ShowEntity c\shieldBubble Else HideEntity c\shieldBubble
	Local glowSize# = 0.6 + c\spd / classScale * 0.35
	If c\padTimer > 0 Or c\boostTimer > 0 Then glowSize = glowSize + 0.6 + Rnd(0.2)
	ScaleSprite c\glow, glowSize, glowSize
End Function

; The height of the road under a point of the track, which goes on past the edges where there is no road.
Function Ground#(dist#, lat#)
	TrackPoint(dist, lat, 0)
	Return gY
End Function

; Where a craft is, into gX, gY and gZ: on the track, then moved up or down by how far it is above or below the road.
Function CraftPoint(c.Craft, height#)
	Local above# = c\y - Ground(c\d, c\lat)
	TrackPoint(c\d, c\lat, height)
	gY = gY + above
End Function

; Gives a craft one of the designs. The strengths go from 2 to 8, and 5 is the middle.
Function SetShip(c.Craft, ship)
	c\ship = ship
	c\accelMul = 0.6 + shipAccel(ship) * 0.08
	c\topMul = 0.9 + shipSpeed(ship) * 0.02
	c\maxEnergy = shipEnergy(ship) * 20.0
	c\brakeMul = 0.6 + shipBrake(ship) * 0.08
End Function

; The speed class changes every speed in the game, and how fast the crafts can turn.
Function SetClass(k)
	setupClass = k
	topSpeed = classTop(k)
	classScale = topSpeed / classTop(0)
End Function

; Moves a craft for one update. throttle and brake are True or False, steer goes from -1 (right) to 1 (left).
Function DriveCraft(c.Craft, throttle, brake, steer#, air#)
	; air goes from -1 (the right air brake) to 1 (the left one).
	If c\respawn > 0
		c\respawn = c\respawn - 1
		If c\respawn = 0 Then Respawn(c)
		Return
	EndIf

	If c\autopilot > 0
		DriveAutopilot(c)
		Return
	EndIf

	Local top# = topSpeed * c\skill * c\topMul, push# = ACCELERATION * classScale * c\accelMul
	; A boost pad and the Boost pickup add up: each one raises the top speed and the push.
	If c\padTimer > 0
		top = top + PAD_SPEED * classScale
		push = push * 3
		c\padTimer = c\padTimer - 1
	EndIf
	If c\boostTimer > 0
		top = top + PAD_SPEED * classScale
		push = push * 3
		c\boostTimer = c\boostTimer - 1
	EndIf
	If c\airborne
		c\spd = c\spd * 0.999 ; Nothing to push against in the air.
	ElseIf throttle
		If c\spd < top Then c\spd = Min(top, c\spd + push) Else c\spd = c\spd - (c\spd - top) * 0.03
	Else
		c\spd = c\spd * 0.985
	EndIf
	If brake Then c\spd = Max(0, c\spd - 0.03 * classScale * c\brakeMul)
	If air <> 0 Then c\spd = c\spd * (1 - 0.006 * c\brakeMul)

	; Steering: quicker at low speed. Both air brakes turn tighter; one air brake turns the craft hard to its side and
	; lets it slide. The faster classes turn faster too, but not as much faster as they go.
	Local grip# = Sqr(classScale)
	Local rate# = (2.7 - 0.45 * c\spd / classScale) * grip
	If brake Then rate = rate + 1.3 * grip * c\brakeMul
	Local follow# = 0.15
	If air <> 0 Then follow = 0.09
	If c\airborne Then rate = rate * 0.5 : follow = 0.04
	c\ang = c\ang + steer * rate + air * AIR_BRAKE * grip * c\brakeMul
	c\steer = c\steer + (Clamp(steer + air, -1, 1) - c\steer) * 0.12
	; The craft slides: the way it moves follows the nose only bit by bit.
	c\vang = c\vang + WrapAngle(c\ang - c\vang) * follow

	; Move along the track. The craft keeps its heading in the world while the track turns under it.
	Local oldD# = c\d, oldYaw# = TrackYaw(c\d)
	c\d = c\d + c\spd * Cos(c\vang)
	c\lat = c\lat - c\spd * Sin(c\vang)
	If c\d >= trackLength Then c\d = c\d - trackLength
	If c\d < 0 Then c\d = c\d + trackLength
	Local turned# = WrapAngle(TrackYaw(c\d) - oldYaw)
	c\ang = WrapAngle(c\ang - turned)
	c\vang = WrapAngle(c\vang - turned)
	CheckLap(c, oldD)
	Local s = SliceAt(c\d), ground# = Ground(c\d, c\lat)

	; The walls. A craft touches a wall when it is against it and not clearly moving away. Touching slows it down
	; and costs a little energy, crashing into it costs a lot, and with no energy left the craft breaks. A craft that
	; is already beside the road or below it misses the walls.
	Local limit# = TRACK_HALF - CRAFT_HALF
	If HasWalls(s) And Abs(c\lat) >= limit - 0.05 And Abs(c\lat) < TRACK_HALF + 1 And c\y > ground - 1
		Local toward# = -Sin(c\vang) * Sgn(c\lat) ; More than 0 when moving towards this wall.
		If Abs(c\lat) > limit Then c\lat = Sgn(c\lat) * limit
		If toward > -0.02
			Local impact# = c\spd * Max(0, toward) / classScale
			If toward > 0
				c\vang = -c\vang * 0.3
				c\ang = c\ang * 0.5
			EndIf
			c\spd = c\spd * (0.975 - Min(0.5, impact * 0.7))
			If c\energy < 1 ; Not 0: energy creeps back up a little every update.
				BreakCraft(c)
				Return
			EndIf
			If c\shield = 0 Then c\energy = Max(0, c\energy - 0.15 - impact * 30)
			If (impact > 0.05 And frame - c\lastHit > 10) Or (c\spd > 0.6 * classScale And frame Mod 6 = 0)
				TrackPoint(c\d, c\lat + Sgn(c\lat) * CRAFT_HALF, HOVER * 0.6)
				If impact > 0.05
					BurstSparks(gX, gY, gZ, 255, 220, 140, 12, 0.25, 0.5)
					If c = player Then PlaySfx(soundWall)
					c\lastHit = frame
				Else
					BurstSparks(gX, gY, gZ, 255, 200, 120, 2, 0.12, 0.4)
				EndIf
			EndIf
		EndIf
		ground = Ground(c\d, c\lat)
	EndIf

	; Up and down. On the road the craft follows it, unless the road drops away faster than gravity pulls: then it
	; flies. In the air it falls, lands on road, or falls past it and is out.
	Local pull# = GRAVITY * classScale
	Local onRoad = HasRoad(s) And (sliceKind(s) <> KIND_OPEN Or Abs(c\lat) <= TRACK_HALF + 0.2)
	If Not c\airborne
		Local climb# = ground - c\y
		If onRoad And climb >= c\vy - pull * 1.5
			c\vy = climb
			c\y = ground
		Else
			c\airborne = True
			c\vy = c\vy - pull
			c\y = c\y + c\vy
		EndIf
	Else
		c\vy = c\vy - pull
		c\y = c\y + c\vy
		If onRoad And c\y <= ground And c\y > ground - 2.5
			If c\vy < -0.45 * classScale
				c\spd = c\spd * 0.93
				CraftPoint(c, 0)
				BurstSparks(gX, gY, gZ, 255, 220, 160, 10, 0.3, 0.6)
				If c = player Then PlaySfx(soundBump)
			EndIf
			c\y = ground
			c\vy = 0
			c\airborne = False
		ElseIf c\y < ground - 14
			FallOff(c)
			Return
		EndIf
	EndIf

	; Boost pads and the charging strip work only on the road.
	If Not c\airborne
		Local p
		For p = 0 To pads - 1
			If (s - padSlice(p) + slices) Mod slices < 4 And Abs(c\lat - padLat(p)) < 3
				If c\padTimer < PAD_TIME - 20 And c = player Then PlaySfx(soundPad)
				c\padTimer = Max(c\padTimer, PAD_TIME)
			EndIf
		Next
	EndIf
	If s >= chargeFrom And s < chargeTo And Abs(c\lat - chargeLat) < 3.5 And Not c\airborne
		c\energy = Min(c\maxEnergy, c\energy + 0.6)
	Else
		c\energy = Min(c\maxEnergy, c\energy + 0.02)
	EndIf
End Function

; A craft that fell off the track: out for a second, then back on the road.
Function FallOff(c.Craft)
	c\fell = True
	c\respawn = 60
	c\padTimer = 0
	HideEntity c\mesh
	If c = player
		PlaySfx(soundFall)
		ShowMessage("Fell off the track!")
	EndIf
End Function

; Brings back a craft that broke or fell, in the middle of the road. One that fell into a gap comes back after it.
Function Respawn(c.Craft)
	Local s = SliceAt(c\d), tries = 0
	While (Not HasRoad(s) Or sliceKind(s) = KIND_RAMP) And tries < slices
		s = (s + 1) Mod slices
		tries = tries + 1
	Wend
	If s <> SliceAt(c\d) Then c\d = (s + 0.5) * sliceLength
	c\lat = 0 : c\ang = 0 : c\vang = 0 : c\spd = 0.3 * classScale
	If Not c\fell Then c\energy = c\maxEnergy / 2
	c\fell = False
	c\airborne = False
	c\y = Ground(c\d, 0) : c\vy = 0
	ShowEntity c\mesh
End Function

; Counts laps when a craft crosses the start line going forwards, but only after it went round: it must have passed
; the middle of the lap since the last time.
Function CheckLap(c.Craft, oldD#)
	If oldD > trackLength * 0.75 And c\d < trackLength * 0.25
		If c\halfway
			c\halfway = False
			c\lap = c\lap + 1
			If c\lap = 1 And raceMode = MODE_TRIAL Then c\lapStart = raceFrames
			If c\lap >= 2 And Not c\finished
				c\lastLap = raceFrames - c\lapStart
				c\lapStart = raceFrames
				If c\bestLap = 0 Or c\lastLap < c\bestLap Then c\bestLap = c\lastLap
				If c = player Then PlayerLap()
				If raceMode = MODE_RACE And c\lap > raceLaps
					c\finished = True
					c\finishTime = raceFrames
				EndIf
			EndIf
		EndIf
	ElseIf oldD < trackLength * 0.25 And c\d > trackLength * 0.75
		c\halfway = False ; Went back over the line: that does not count.
	EndIf
	If c\d > trackLength * 0.45 And c\d < trackLength * 0.55 Then c\halfway = True
End Function

Function PlayerLap()
	PlaySfx(soundLap)
	If recordLap(setupTrack, setupClass) = 0 Or player\lastLap < recordLap(setupTrack, setupClass)
		recordLap(setupTrack, setupClass) = player\lastLap
		newLapRecord = True
		ShowMessage("Track record!  " + TimeText(player\lastLap))
	ElseIf player\lastLap = player\bestLap
		ShowMessage("Best lap  " + TimeText(player\lastLap))
	Else
		ShowMessage("Lap  " + TimeText(player\lastLap))
	EndIf
	If raceMode = MODE_RACE
		If player\lap = raceLaps Then ShowMessage("Final lap!")
		If player\lap > raceLaps
			player\finished = True
			player\finishTime = raceFrames
			player\computer = True
			player\skill = 0.9
			StopEngine()
			state = STATE_FINISHED
			finishTimer = 240
			If recordRace(setupTrack, setupLaps, setupClass) = 0 Or raceFrames < recordRace(setupTrack, setupLaps, setupClass)
				recordRace(setupTrack, setupLaps, setupClass) = raceFrames
				newRaceRecord = True
			EndIf
			SaveSettings()
		EndIf
	Else
		SaveSettings()
	EndIf
End Function

Function BreakCraft(c.Craft)
	c\respawn = 120
	c\spd = 0
	c\padTimer = 0
	HideEntity c\mesh
	CraftPoint(c, HOVER)
	BurstSparks(gX, gY, gZ, 255, 150, 60, 40, 0.5, 1.5)
	BurstSparks(gX, gY, gZ, 255, 240, 200, 20, 0.3, 2.5)
	If c = player
		PlaySfx(soundBreak)
		ShowMessage("Out of energy! Mind the walls.")
	EndIf
End Function

; The computer drives by looking ahead along the track: it keeps to the inside of the corners that come, slows down
; for sharp ones, steers round crafts in front of it, and boosts on straights when it has energy to spare.
Function DriveComputer(c.Craft)
	Local s = SliceAt(c\d), k, near#
	For k = 3 To 22
		near = near + tTurn((s + k) Mod slices)
	Next
	; Look ahead as far as the craft needs to slow down, for the sharpest bend and for jumps and open edges.
	Local look = Int(c\spd * 30 / sliceLength) + 6, sum#, worst#, jumpAhead = False, openAhead = False, kind
	If look > 150 Then look = 150
	For k = 0 To 5
		sum = sum + tTurn((s + k) Mod slices)
	Next
	For k = 0 To look
		worst = Max(worst, Abs(sum))
		sum = sum + tTurn((s + k + 6) Mod slices) - tTurn((s + k) Mod slices)
		kind = sliceKind((s + k) Mod slices)
		If k < 40 And (kind = KIND_RAMP Or kind = KIND_GAP) Then jumpAhead = True
		If k < 25 And kind = KIND_OPEN Then openAhead = True
	Next
	Local bend# = worst / (6 * sliceLength) ; Degrees of turn for every unit of track.

	Local limit# = TRACK_HALF - CRAFT_HALF - 0.6
	If openAhead Or sliceKind(s) = KIND_OPEN Then limit = TRACK_HALF - 3.5
	Local target# = Clamp(-near / 45.0, -1, 1) * (limit - 2.5) + c\lineOffset
	If jumpAhead Then target = c\lineOffset * 0.5 ; Straight over the middle of a jump.

	; Make room for crafts close in front.
	Local o.Craft, gap#
	For o = Each Craft
		If o <> c And o\respawn = 0
			gap = o\d - c\d
			If gap < -trackLength / 2 Then gap = gap + trackLength
			If gap > trackLength / 2 Then gap = gap - trackLength
			If gap > 0 And gap < 14 * classScale And Abs(o\lat - target) < 2.8
				If o\lat > 0 Then target = o\lat - 3 Else target = o\lat + 3
			EndIf
		EndIf
	Next
	target = Clamp(target, -limit, limit)

	Local wanted# = Clamp((c\lat - target) * 2.2, -22, 22)
	Local steer# = Clamp((wanted - c\ang) * 0.4, -1, 1)
	; When steering alone cannot turn fast enough, an air brake helps.
	Local air# = 0
	If Abs(wanted - c\ang) > 7 And c\spd > 0.8 * classScale Then air = Sgn(wanted - c\ang)

	; Catching up a little when far behind the player, and easing off a little when far in front.
	Local pace# = 1.0
	If player <> Null And player <> c ; Blitz checks both sides of And, so the player is looked at only inside.
		If Not player\computer
			gap = (c\lap * trackLength + c\d) - (player\lap * trackLength + player\d)
			If gap > 150 Then pace = 0.97
			If gap < -150 Then pace = 1.03
		EndIf
	EndIf
	; The fastest speed at which the craft can still turn as much as the bend ahead needs.
	Local grip# = Sqr(classScale)
	Local canTurn# = (2.7 + AIR_BRAKE * c\brakeMul * 0.5) * grip * 0.8
	Local wantSpeed# = Min(topSpeed * c\skill * c\topMul * pace, canTurn / (bend + 0.45 * grip / classScale + 0.001))
	If jumpAhead Then wantSpeed = topSpeed * c\skill * c\topMul
	; Boost only where the road ahead is straight enough for the extra speed.
	If (c\padTimer > 0 Or c\boostTimer > 0) And bend < 0.15 Then wantSpeed = wantSpeed + PAD_SPEED * classScale

	DriveCraft(c, c\spd < wantSpeed, c\spd > wantSpeed + 0.15 * classScale, steer, air)
End Function

; Crafts that touch push each other apart; the one behind loses a little speed and the one in front gains a little.
Function BumpCrafts()
	Local a.Craft, b.Craft, gap#, side#, push#
	For a = Each Craft
		b = After a
		While b <> Null
			If a\respawn = 0 And b\respawn = 0 And Abs(a\y - b\y) < 2
				gap = b\d - a\d
				If gap < -trackLength / 2 Then gap = gap + trackLength
				If gap > trackLength / 2 Then gap = gap - trackLength
				side = b\lat - a\lat
				If Abs(gap) < 4.2 And Abs(side) < CRAFT_HALF * 2.1
					push = (CRAFT_HALF * 2.1 - Abs(side)) / 2
					If side >= 0
						b\lat = b\lat + push : a\lat = a\lat - push
					Else
						b\lat = b\lat - push : a\lat = a\lat + push
					EndIf
					If gap > 0 And a\spd > b\spd
						a\spd = a\spd * 0.94 : b\spd = b\spd * 1.03
					ElseIf gap < 0 And b\spd > a\spd
						b\spd = b\spd * 0.94 : a\spd = a\spd * 1.03
					EndIf
					If a = player Or b = player
						If frame - player\lastHit > 15 Then PlaySfx(soundBump) : player\lastHit = frame
					EndIf
				EndIf
			EndIf
			b = After b
		Wend
	Next
End Function

; Sorts the crafts by place: those that finished first by finishing time, then by how far they went.
Function RankCrafts()
	Local c.Craft, n = 0, i, j, swapped.Craft
	For c = Each Craft
		order(n) = c
		n = n + 1
	Next
	For i = 0 To n - 2
		For j = 0 To n - 2 - i
			If Ahead(order(j + 1), order(j))
				swapped = order(j) : order(j) = order(j + 1) : order(j + 1) = swapped
			EndIf
		Next
	Next
	For i = 0 To n - 1
		order(i)\place = i + 1
	Next
End Function

Function Ahead(a.Craft, b.Craft)
	If a\finished And b\finished Then Return a\finishTime < b\finishTime
	If a\finished Then Return True
	If b\finished Then Return False
	Return a\lap * trackLength + a\d > b\lap * trackLength + b\d
End Function

Function CraftCount()
	Local c.Craft, n = 0
	For c = Each Craft
		n = n + 1
	Next
	Return n
End Function

Function ClearCrafts()
	ClearWeapons()
	Local c.Craft
	For c = Each Craft
		FreeEntity c\mesh
		Delete c
	Next
	player = Null
	demoTarget = Null
End Function

; Puts the crafts on the starting grid: two by two, behind the line.
Function GridCrafts()
	Local c.Craft, n = 0
	For c = Each Craft
		c\d = trackLength - 12 - (n / 2) * 10
		If n Mod 2 = 0 Then c\lat = -3.5 Else c\lat = 3.5
		c\ang = 0 : c\vang = 0 : c\spd = 0 : c\energy = c\maxEnergy
		c\y = Ground(c\d, c\lat) : c\vy = 0 : c\airborne = False : c\fell = False
		c\weapon = 0 : c\burst = 0 : c\shield = 0 : c\autopilot = 0 : c\lockTimer = 0 : c\lockTarget = Null
		c\lap = 0 : c\halfway = True : c\lapStart = 0 : c\lastLap = 0 : c\bestLap = 0
		c\finished = False : c\finishTime = 0 : c\respawn = 0 : c\padTimer = 0 : c\boostTimer = 0 : c\charge = 0
		c\lineOffset = Rnd(-1.5, 1.5)
		ShowEntity c\mesh
		PlaceCraft(c)
		n = n + 1
	Next
End Function

; --- Weapons ---------------------------------------------------------------------------------------------------------

; The shapes the quake wave and the pulse ring are copied from, made again with the screen.
Function MakeWeaponTemplates()
	; The quake: a glowing hump right across the road. x runs across, z along the track.
	quakeTemplate = CreateMesh()
	Local surface = CreateSurface(quakeTemplate), k, z0#, z1#, h0#, h1#, base
	For k = 0 To 7
		z0 = -3 + k * 0.75 : z1 = z0 + 0.75
		h0 = 1.6 * Sin(k * 22.5) : h1 = 1.6 * Sin((k + 1) * 22.5)
		base = AddQuad(surface, -TRACK_HALF, h0, z0, -TRACK_HALF, h1, z1, TRACK_HALF, h1, z1, TRACK_HALF, h0, z0)
		ColorQuad(surface, base, 255, 120 + k * 10.0, 40, 255, 130 + k * 10.0, 50)
	Next
	EntityFX quakeTemplate, 1 + 2 + 16
	EntityBlend quakeTemplate, 3
	HideEntity quakeTemplate

	; The pulse: a flat ring of radius 1, scaled up as it grows.
	ringTemplate = CreateMesh()
	surface = CreateSurface(ringTemplate)
	Local a0#, a1#
	For k = 0 To 39
		a0 = k * 9.0 : a1 = (k + 1) * 9.0
		base = AddQuad(surface, Sin(a0) * 0.8, 0, Cos(a0) * 0.8, Sin(a0), 0, Cos(a0), Sin(a1), 0, Cos(a1), Sin(a1) * 0.8, 0, Cos(a1) * 0.8)
		ColorQuad(surface, base, 40, 120, 160, 140, 240, 255)
		; A low glowing wall along the outer edge, so the ring shows from behind too.
		base = AddQuad(surface, Sin(a0), -0.3, Cos(a0), Sin(a0), 1.2, Cos(a0), Sin(a1), 1.2, Cos(a1), Sin(a1), -0.3, Cos(a1))
		ColorQuad(surface, base, 140, 240, 255, 20, 60, 90)
	Next
	EntityFX ringTemplate, 1 + 2 + 16
	EntityBlend ringTemplate, 3
	HideEntity ringTemplate
End Function

Function SetWeapons(enabled)
	raceWeapons = enabled
	If fieldMesh <> 0
		If raceWeapons Then ShowEntity fieldMesh Else HideEntity fieldMesh
	EndIf
End Function

Function ClearWeapons()
	Local sh.Shot, wv.Wave, pl.Pulse
	For sh = Each Shot
		FreeEntity sh\ent
		Delete sh
	Next
	For wv = Each Wave
		FreeEntity wv\ent
		Delete wv
	Next
	For pl = Each Pulse
		FreeEntity pl\ent
		Delete pl
	Next
End Function

; How far b is in front of a along the track, from minus half a lap to half a lap.
Function GapTo#(a.Craft, b.Craft)
	Local gap# = b\d - a\d
	If gap < -trackLength / 2 Then gap = gap + trackLength
	If gap > trackLength / 2 Then gap = gap - trackLength
	Return gap
End Function

; The first craft in front of c within range along the track, or Null.
Function CraftAhead.Craft(c.Craft, range#)
	Local o.Craft, best.Craft = Null, bestGap# = range, gap#
	For o = Each Craft
		If o <> c And o\respawn = 0
			gap = GapTo(c, o)
			If gap > 0 And gap < bestGap Then bestGap = gap : best = o
		EndIf
	Next
	Return best
End Function

; Uses the weapon or ability a craft holds.
Function FireWeapon(c.Craft)
	If c\weapon = WEAPON_NONE Or c\respawn > 0 Then Return
	Local loud = c = player
	Select c\weapon
		Case WEAPON_GATLING
			c\burst = GATLING_ROUNDS
		Case WEAPON_MISSILE
			Local missile.Shot = NewShot(c, SHOT_MISSILE)
			If c\lockTimer >= LOCK_TIME Then missile\target = c\lockTarget
			If loud Then PlaySfx(soundMissile)
		Case WEAPON_QUAKE
			Local wv.Wave = New Wave
			wv\owner = c
			wv\d = c\d + 4
			If wv\d >= trackLength Then wv\d = wv\d - trackLength
			wv\ent = CopyEntity(quakeTemplate)
			ShowEntity wv\ent
			If loud Then PlaySfx(soundBlast)
		Case WEAPON_BOOST
			c\boostTimer = 150
			c\spd = c\spd + 0.4 * classScale
			If loud Then PlaySfx(soundPad)
		Case WEAPON_SHIELD
			c\shield = SHIELD_TIME
			If loud Then PlaySfx(soundShield)
		Case WEAPON_AUTOPILOT
			c\autopilot = AUTOPILOT_TIME
			If loud Then PlaySfx(soundPickup)
		Case WEAPON_PULSE
			Local pl.Pulse = New Pulse
			pl\owner = c
			CraftPoint(c, 0.4)
			pl\x = gX : pl\y = gY : pl\z = gZ
			pl\hits = 1 Shl c\index
			pl\ent = CopyEntity(ringTemplate)
			ShowEntity pl\ent
			PositionEntity pl\ent, pl\x, pl\y, pl\z
			Local i = SliceAt(c\d)
			AlignToVector pl\ent, uX(i), uY(i), uZ(i), 2, 1
			If loud Then PlaySfx(soundPulse)
		Case WEAPON_PLASMA
			; Starts charging; UpdateWeapons fires it when it is full. It keeps the weapon until then.
			If c\charge = 0
				c\charge = 1
				If loud Then PlaySfx(soundCharge)
			EndIf
			Return
	End Select
	c\weapon = WEAPON_NONE
	c\lockTarget = Null
	c\lockTimer = 0
End Function

; A shot that flies straight out of the nose of a craft, through the world. Missiles turn towards their target.
Function NewShot.Shot(c.Craft, kind)
	Local sh.Shot = New Shot
	sh\kind = kind
	sh\owner = c
	CraftHeading(c, c\ang)
	Local dirX# = hX, dirY# = hY, dirZ# = hZ, speed#
	CraftPoint(c, HOVER)
	sh\x = gX + dirX * 3 : sh\y = gY + dirY * 3 : sh\z = gZ + dirZ * 3
	sh\ent = CopyEntity(sparkTemplate)
	ShowEntity sh\ent
	Select kind
		Case SHOT_BULLET
			speed = c\spd + 4
			sh\life = 45 : sh\damage = 2.5 : sh\radius = 1.7
			; A little spread, so a burst covers more than a line.
			dirX = dirX + Rnd(-0.02, 0.02) : dirZ = dirZ + Rnd(-0.02, 0.02)
			EntityColor sh\ent, 255, 230, 120
			ScaleSprite sh\ent, 0.45, 0.45
		Case SHOT_MISSILE
			speed = topSpeed * 1.35 + 1
			sh\life = 300 : sh\damage = 20 : sh\radius = 2.2
			EntityColor sh\ent, 255, 90, 60
			ScaleSprite sh\ent, 0.9, 0.9
		Default
			; Plasma: narrow and straight, so it only hits what the nose points at when it is fired.
			speed = c\spd + 3.5
			sh\life = 70 : sh\damage = 100 : sh\radius = 1.2
			EntityColor sh\ent, 120, 230, 255
			ScaleSprite sh\ent, 1.6, 1.6
	End Select
	sh\vx = dirX * speed : sh\vy = dirY * speed : sh\vz = dirZ * speed
	sh\slice = SliceAt(c\d)
	PositionEntity sh\ent, sh\x, sh\y, sh\z
	Return sh
End Function

; A hit from a weapon. It costs energy unless the shield is up, and with no energy left the craft breaks.
Function DamageCraft(c.Craft, amount#, by.Craft, what$)
	If c\respawn > 0 Then Return
	CraftPoint(c, HOVER)
	If c\shield > 0
		BurstSparks(gX, gY, gZ, 120, 200, 255, 8, 0.25, 0.6)
		If c = player Or by = player Then PlaySfx(soundShieldHit)
		Return
	EndIf
	BurstSparks(gX, gY, gZ, 255, 160, 80, 10, 0.3, 0.8)
	If c = player Or by = player Then PlaySfx(soundWall)
	; The harder the hit, the more speed it knocks off: a bullet a little, a missile a lot, plasma most of it.
	c\spd = c\spd * (1 - Clamp(amount * 0.025, 0.04, 0.7))
	c\energy = c\energy - amount
	If c\energy <= 0
		c\energy = 0
		BreakCraft(c)
		If by <> Null
			If c = player Then ShowMessage("Wrecked by " + by\name + "'s " + what + "!")
			If by = player And c <> player Then ShowMessage("You wrecked " + c\name + "!")
		EndIf
	EndIf
End Function

; The racing line the computer would take here: towards the inside of the corners ahead.
Function RacingLine#(c.Craft)
	Local s = SliceAt(c\d), k, near#
	For k = 3 To 22
		near = near + tTurn((s + k) Mod slices)
	Next
	Local limit# = TRACK_HALF - CRAFT_HALF - 0.6
	If sliceKind(s) = KIND_OPEN Then limit = TRACK_HALF - 3.5
	Return Clamp(-near / 45.0, -1, 1) * (limit - 2.5)
End Function

; Autopilot: for exactly 2.5 seconds the craft follows the racing line at its top speed, on the road, whatever the
; walls, gaps or bends would do to it.
Function DriveAutopilot(c.Craft)
	c\autopilot = c\autopilot - 1
	Local speed# = topSpeed * c\skill * c\topMul
	If c\padTimer > 0
		speed = speed + PAD_SPEED * classScale
		c\padTimer = c\padTimer - 1
	EndIf
	If c\boostTimer > 0
		speed = speed + PAD_SPEED * classScale
		c\boostTimer = c\boostTimer - 1
	EndIf
	c\spd = Max(c\spd, speed)
	Local oldD# = c\d
	c\d = c\d + c\spd
	If c\d >= trackLength Then c\d = c\d - trackLength
	CheckLap(c, oldD)
	c\lat = c\lat + (RacingLine(c) - c\lat) * 0.1
	c\ang = 0 : c\vang = 0
	c\steer = c\steer * 0.9
	Local ground# = Ground(c\d, c\lat)
	c\vy = ground - c\y
	c\y = ground
	c\airborne = False
	c\energy = Min(c\maxEnergy, c\energy + 0.02)
End Function

; Everything to do with weapons, once every update: picking them up, missile locks, the computer's choices, and
; moving the shots, waves and pulses.
Function UpdateWeapons()
	Local c.Craft, s, f
	For c = Each Craft
		If c\shield > 0 Then c\shield = c\shield - 1
		If raceWeapons And c\weapon = WEAPON_NONE And c\burst = 0 And c\respawn = 0 And Not c\airborne
			s = SliceAt(c\d)
			For f = 0 To fields - 1
				If (s - fieldSlice(f) + slices) Mod slices < 3
					c\weapon = Rand(1, WEAPONS)
					c\aiHold = Rand(30, 150)
					If c = player
						PlaySfx(soundPickup)
						ShowMessage(weaponNames(c\weapon))
					EndIf
				EndIf
			Next
		EndIf
		If c\burst > 0 And frame Mod 3 = 0 And c\respawn = 0
			NewShot(c, SHOT_BULLET)
			c\burst = c\burst - 1
			If c = player Then PlaySfx(soundShot)
		EndIf
		If c\charge > 0
			c\charge = c\charge + 1
			If c\respawn > 0
				c\charge = 0
			ElseIf c\charge >= PLASMA_CHARGE
				c\charge = 0
				c\weapon = WEAPON_NONE
				NewShot(c, SHOT_PLASMA)
				If c = player Then PlaySfx(soundPlasma)
			ElseIf frame Mod 2 = 0
				; Light gathers at the nose while it charges.
				CraftHeading(c, c\ang)
				Local nx# = hX, ny# = hY, nz# = hZ
				CraftPoint(c, HOVER)
				BurstSparks(gX + nx * 2.6, gY + ny * 2.6, gZ + nz * 2.6, 120, 230, 255, 1, 0.04, 0.4 + c\charge * 0.03)
			EndIf
		EndIf
		If c\weapon = WEAPON_MISSILE
			Local target.Craft = CraftAhead(c, 700)
			If target = Null Or target <> c\lockTarget
				c\lockTarget = target
				c\lockTimer = 0
			Else
				c\lockTimer = c\lockTimer + 1
				If c\lockTimer = LOCK_TIME And c = player Then PlaySfx(soundLock)
				If target = player And frame Mod 20 = 0 Then PlaySfx(soundWarning)
			EndIf
		EndIf
		If c\computer And c\weapon <> WEAPON_NONE Then ComputerWeapon(c)
	Next

	UpdateShots()
	UpdateWaves()
	UpdatePulses()
End Function

Function UpdateShots()
	Local sh.Shot, o.Craft, dx#, dy#, dz#, length#, speed#, hit, wall, along#, lat#, up#, i, n, dot#
	For sh = Each Shot
		If sh\target = player And frame Mod 10 = 0 Then PlaySfx(soundWarning)
		If sh\kind = SHOT_MISSILE And sh\target <> Null
			If sh\target\respawn = 0
				; Turn towards the target, keeping the speed.
				CraftPoint(sh\target, HOVER)
				dx = gX - sh\x : dy = gY - sh\y : dz = gZ - sh\z
				length = Sqr(dx * dx + dy * dy + dz * dz) + 0.001
				speed = Sqr(sh\vx * sh\vx + sh\vy * sh\vy + sh\vz * sh\vz)
				sh\vx = sh\vx + (dx / length * speed - sh\vx) * 0.15
				sh\vy = sh\vy + (dy / length * speed - sh\vy) * 0.15
				sh\vz = sh\vz + (dz / length * speed - sh\vz) * 0.15
				length = Sqr(sh\vx * sh\vx + sh\vy * sh\vy + sh\vz * sh\vz) + 0.001
				sh\vx = sh\vx / length * speed : sh\vy = sh\vy / length * speed : sh\vz = sh\vz / length * speed
			EndIf
		EndIf
		sh\x = sh\x + sh\vx : sh\y = sh\y + sh\vy : sh\z = sh\z + sh\vz
		PositionEntity sh\ent, sh\x, sh\y, sh\z
		If sh\kind <> SHOT_BULLET And frame Mod 2 = 0
			If sh\kind = SHOT_MISSILE Then BurstSparks(sh\x, sh\y, sh\z, 200, 190, 180, 1, 0.05, 0.6) Else BurstSparks(sh\x, sh\y, sh\z, 120, 230, 255, 1, 0.05, 0.9)
		EndIf
		sh\life = sh\life - 1
		hit = False

		; Which slice the shot is over: start from the last one and step along until the shot lies within it.
		i = sh\slice
		For n = 1 To 8
			along = (sh\x - tX(i)) * fX(i) + (sh\y - tY(i)) * fY(i) + (sh\z - tZ(i)) * fZ(i)
			If along > sliceLength
				i = (i + 1) Mod slices
			ElseIf along < 0
				i = (i + slices - 1) Mod slices
			Else
				Exit
			EndIf
		Next
		sh\slice = i
		lat = (sh\x - tX(i)) * rX(i) + (sh\y - tY(i)) * rY(i) + (sh\z - tZ(i)) * rZ(i)
		up = (sh\x - tX(i)) * uX(i) + (sh\y - tY(i)) * uY(i) + (sh\z - tZ(i)) * uZ(i)
		; The walls: past the edge of the road, below the top of the wall, where there is a wall.
		wall = HasWalls(i) And Abs(lat) > TRACK_HALF And Abs(lat) < TRACK_HALF + 3 And up < WALL_HEIGHT + 0.3 And up > -1
		If wall
			If sh\kind = SHOT_BULLET
				; Bullets bounce: the part of the movement towards the wall turns round.
				dot = sh\vx * rX(i) + sh\vy * rY(i) + sh\vz * rZ(i)
				If dot * lat > 0
					sh\vx = sh\vx - 2 * dot * rX(i) : sh\vy = sh\vy - 2 * dot * rY(i) : sh\vz = sh\vz - 2 * dot * rZ(i)
					BurstSparks(sh\x, sh\y, sh\z, 255, 230, 140, 2, 0.15, 0.3)
				EndIf
			Else
				Explode(sh)
				hit = True
			EndIf
		ElseIf HasRoad(i) And Abs(lat) < TRACK_HALF And up < -0.2 And up > -2
			; Into the road.
			If sh\kind <> SHOT_BULLET Then Explode(sh)
			hit = True
		EndIf

		For o = Each Craft
			If o <> sh\owner And o\respawn = 0 And Not hit
				CraftPoint(o, HOVER)
				dx = gX - sh\x : dy = gY - sh\y : dz = gZ - sh\z
				If dx * dx + dy * dy + dz * dz < sh\radius * sh\radius
					hit = True
					Select sh\kind
						Case SHOT_BULLET : DamageCraft(o, sh\damage, sh\owner, "gatling gun")
						Case SHOT_MISSILE : DamageCraft(o, sh\damage, sh\owner, "missile")
						Default : DamageCraft(o, sh\damage, sh\owner, "plasma")
					End Select
					If sh\kind <> SHOT_BULLET Then Explode(sh)
				EndIf
			EndIf
		Next
		If hit Or sh\life <= 0
			FreeEntity sh\ent
			Delete sh
		EndIf
	Next
End Function

; The blast where a missile or a plasma bolt ends: plasma's is much bigger.
Function Explode(sh.Shot)
	If sh\kind = SHOT_PLASMA
		BurstSparks(sh\x, sh\y, sh\z, 140, 230, 255, 40, 0.7, 2.2)
		BurstSparks(sh\x, sh\y, sh\z, 255, 255, 255, 20, 0.4, 3.5)
		BurstSparks(sh\x, sh\y, sh\z, 80, 140, 255, 25, 1.0, 1.4)
	Else
		BurstSparks(sh\x, sh\y, sh\z, 255, 140, 60, 25, 0.4, 1.2)
		BurstSparks(sh\x, sh\y, sh\z, 255, 230, 160, 10, 0.25, 2.0)
	EndIf
	; Loud enough to hear when it is near the camera.
	Local dx# = sh\x - EntityX(camera), dy# = sh\y - EntityY(camera), dz# = sh\z - EntityZ(camera)
	If dx * dx + dy * dy + dz * dz < 120 * 120
		If sh\kind = SHOT_PLASMA Then PlaySfx(soundBigBlast) Else PlaySfx(soundBlast)
	EndIf
End Function

Function UpdateWaves()
	Local wv.Wave, o.Craft, advance# = topSpeed * 1.5, rel#, oldD#, i, done
	For wv = Each Wave
		oldD = wv\d
		wv\d = wv\d + advance
		If wv\d >= trackLength Then wv\d = wv\d - trackLength
		wv\travelled = wv\travelled + advance
		For o = Each Craft
			If o <> wv\owner And o\respawn = 0 And Not o\airborne
				rel = o\d - oldD
				If rel < -trackLength / 2 Then rel = rel + trackLength
				If rel >= 0 And rel < advance
					If o\shield = 0
						DamageCraft(o, 25, wv\owner, "quake")
						o\airborne = True
						o\vy = 0.4 * classScale
					Else
						DamageCraft(o, 0, wv\owner, "quake")
					EndIf
				EndIf
			EndIf
		Next
		i = SliceAt(wv\d)
		done = wv\travelled > 700 Or Not HasRoad(i) ; The wave runs out, or there is no road for it.
		If done
			FreeEntity wv\ent
			Delete wv
		Else
			TrackPoint(wv\d, 0, 0)
			PositionEntity wv\ent, gX, gY, gZ
			RotateEntity wv\ent, 0, 0, 0
			AlignToVector wv\ent, uX(i), uY(i), uZ(i), 2, 1
			TFormVector fX(i), fY(i), fZ(i), 0, wv\ent
			TurnEntity wv\ent, 0, ATan2(-TFormedX(), TFormedZ()), 0
			EntityAlpha wv\ent, 1 - wv\travelled / 800
			If frame Mod 3 = 0
				TrackPoint(wv\d, Rnd(-TRACK_HALF, TRACK_HALF), 1)
				BurstSparks(gX, gY, gZ, 255, 150, 60, 2, 0.2, 0.8)
			EndIf
		EndIf
	Next
End Function

Function UpdatePulses()
	Local pl.Pulse, o.Craft, dx#, dy#, dz#, side#
	For pl = Each Pulse
		pl\radius = pl\radius + 0.7
		; The ring stays round the craft that set it off.
		If pl\owner <> Null
			If pl\owner\respawn = 0
				CraftPoint(pl\owner, 0.4)
				pl\x = gX : pl\y = gY : pl\z = gZ
				PositionEntity pl\ent, pl\x, pl\y, pl\z
			EndIf
		EndIf
		ScaleEntity pl\ent, pl\radius, 1, pl\radius
		EntityAlpha pl\ent, 1 - pl\radius / PULSE_RADIUS
		For o = Each Craft
			If o\respawn = 0 And (pl\hits And (1 Shl o\index)) = 0
				CraftPoint(o, HOVER)
				dx = gX - pl\x : dy = gY - pl\y : dz = gZ - pl\z
				If dx * dx + dy * dy + dz * dz < (pl\radius + 1.5) * (pl\radius + 1.5)
					pl\hits = pl\hits Or (1 Shl o\index)
					If o\shield = 0
						side = 1.6
						If pl\owner <> Null
							If o\lat < pl\owner\lat Then side = -1.6
						EndIf
						o\lat = o\lat + side
					EndIf
					DamageCraft(o, 20, pl\owner, "pulse")
				EndIf
			EndIf
		Next
		If pl\radius > PULSE_RADIUS
			FreeEntity pl\ent
			Delete pl
		EndIf
	Next
End Function

; The computer waits a moment after a pickup, then uses it when it is likely to help.
Function ComputerWeapon(c.Craft)
	c\aiHold = c\aiHold - 1
	If c\aiHold > 0 Or c\charge > 0 Then Return
	Local fire = c\aiHold < -600 ; Held for ten seconds: use it anyway.
	Local t.Craft = CraftAhead(c, 300), gap#, k, s = SliceAt(c\d), bends#
	For k = 0 To 40
		bends = bends + Abs(tTurn((s + k) Mod slices))
	Next
	Select c\weapon
		Case WEAPON_GATLING
			If t <> Null
				If GapTo(c, t) < 70 And Abs(t\lat - c\lat) < 2.5 And bends < 25 Then fire = True
			EndIf
		Case WEAPON_PLASMA
			If t <> Null
				If GapTo(c, t) < 130 And GapTo(c, t) > 30 And Abs(t\lat - c\lat) < 1.5 And bends < 10 Then fire = True
			EndIf
		Case WEAPON_MISSILE
			If c\lockTimer >= LOCK_TIME Then fire = True
		Case WEAPON_QUAKE
			If t <> Null
				If GapTo(c, t) < 250 Then fire = True
			EndIf
		Case WEAPON_PULSE
			Local o.Craft
			For o = Each Craft
				If o <> c And o\respawn = 0
					If Abs(GapTo(c, o)) < 12 Then fire = True
				EndIf
			Next
		Case WEAPON_BOOST
			If bends < 12 Then fire = True
		Case WEAPON_SHIELD
			If c\energy < c\maxEnergy * 0.35 Then fire = True
			Local sh.Shot
			For sh = Each Shot
				If sh\target = c Then fire = True
			Next
		Case WEAPON_AUTOPILOT
			If bends > 50 Or c\energy < c\maxEnergy * 0.25 Then fire = True
	End Select
	If fire Then FireWeapon(c)
End Function

; The held weapon at the top of the screen, and a bracket round the craft a missile is locking on to.
Function DrawWeaponHud()
	Local text$ = "", x = SCREEN_W / 2
	If player\weapon <> WEAPON_NONE
		text = weaponNames(player\weapon) + "   (Ctrl or F)"
		If player\weapon = WEAPON_MISSILE
			If player\lockTarget = Null
				text = "Missile: no target"
			ElseIf player\lockTimer >= LOCK_TIME
				text = "Missile locked on " + player\lockTarget\name + "   (Ctrl or F)"
			Else
				text = "Missile locking on " + player\lockTarget\name + "..."
			EndIf
		EndIf
	ElseIf player\burst > 0
		text = "Gatling gun  " + player\burst
	ElseIf player\shield > 0
		text = "Shield  " + (player\shield / 60 + 1) + " s"
	ElseIf player\autopilot > 0
		text = "Autopilot"
	EndIf
	If player\charge > 0 Then text = "Plasma charging " + Int(player\charge * 100 / PLASMA_CHARGE) + "%"
	If text <> ""
		SetFont menuFont
		Local w = StringWidth(text) + 30
		Color 20, 14, 40
		Rect x - w / 2, 14, w, 30, 1
		Color 200, 120, 255
		Rect x - w / 2, 14, w, 30, 0
		Color 245, 240, 255
		Text x, 29, text, True, True
		SetFont 0
	EndIf
	; Warnings when a rival's missile locks on to the player, or one is flying at them.
	Local warn$ = "", o.Craft, sh.Shot
	For o = Each Craft
		If o\weapon = WEAPON_MISSILE And o\lockTarget = player And o <> player
			If o\lockTimer >= LOCK_TIME Then warn = o\name + " has a missile lock on you!" Else warn = o\name + " is locking on..."
		EndIf
	Next
	For sh = Each Shot
		If sh\target = player Then warn = "MISSILE INCOMING!"
	Next
	If warn <> "" And frame Mod 30 < 22
		SetFont menuFont
		Color 20, 4, 8
		Text x + 2, 64, warn, True, True
		Color 255, 70, 60
		Text x, 62, warn, True, True
		SetFont 0
	EndIf

	If player\weapon = WEAPON_MISSILE And player\lockTarget <> Null
		CraftPoint(player\lockTarget, HOVER)
		CameraProject camera, gX, gY, gZ
		If ProjectedZ() > 0
			Local px = Int(ProjectedX()), py = Int(ProjectedY()), size = 22
			If player\lockTimer >= LOCK_TIME Then Color 255, 60, 60 Else Color 255, 200, 80
			If player\lockTimer >= LOCK_TIME Or frame Mod 20 < 14
				Rect px - size, py - size, 8, 2, 1 : Rect px - size, py - size, 2, 8, 1
				Rect px + size - 8, py - size, 8, 2, 1 : Rect px + size - 2, py - size, 2, 8, 1
				Rect px - size, py + size - 2, 8, 2, 1 : Rect px - size, py + size - 8, 2, 8, 1
				Rect px + size - 8, py + size - 2, 8, 2, 1 : Rect px + size - 2, py + size - 8, 2, 8, 1
			EndIf
		EndIf
	EndIf
End Function

; --- Sparks ----------------------------------------------------------------------------------------------------------

Function BurstSparks(x#, y#, z#, r#, g#, b#, count, speed#, size#)
	Local i, s.Spark
	For i = 1 To count
		s = New Spark
		s\ent = CopyEntity(sparkTemplate)
		ShowEntity s\ent
		PositionEntity s\ent, x, y, z
		EntityColor s\ent, r, g, b
		ScaleSprite s\ent, size, size
		s\vx = Rnd(-speed, speed) : s\vy = Rnd(0, speed * 1.5) : s\vz = Rnd(-speed, speed)
		s\maxLife = Rnd(20, 30 + 15 * size)
		s\life = s\maxLife
	Next
End Function

Function UpdateSparks()
	Local s.Spark
	For s = Each Spark
		s\life = s\life - 1
		If s\life <= 0
			FreeEntity s\ent
			Delete s
		Else
			s\vy = s\vy - 0.01
			TranslateEntity s\ent, s\vx, s\vy, s\vz
			EntityAlpha s\ent, s\life / s\maxLife
		EndIf
	Next
End Function

; --- Camera ----------------------------------------------------------------------------------------------------------

; Follows a craft from behind. The camera turns after the craft and leans with the road a little later than the craft
; does, which makes turns and corners easier to feel. It never falls behind, however fast the craft goes.
Function ChaseCamera(c.Craft, back#, height#, drop#)
	; drop lowers the point the camera looks at, which moves the craft up in the picture.
	Local i = SliceAt(c\d)
	CraftHeading(c, c\vang * 0.7 + c\ang * 0.3)
	If camReset
		camHeadX = hX : camHeadY = hY : camHeadZ = hZ
		camUpX = uX(i) : camUpY = uY(i) : camUpZ = uZ(i)
		camReset = False
	Else
		camHeadX = camHeadX + (hX - camHeadX) * 0.15
		camHeadY = camHeadY + (hY - camHeadY) * 0.15
		camHeadZ = camHeadZ + (hZ - camHeadZ) * 0.15
		camUpX = camUpX + (uX(i) - camUpX) * 0.08
		camUpY = camUpY + (uY(i) - camUpY) * 0.08
		camUpZ = camUpZ + (uZ(i) - camUpZ) * 0.08
	EndIf
	; Up and down with the craft, but the camera stays near the road when a craft falls.
	Local above# = Max(-4, c\y - Ground(c\d, c\lat))
	TrackPoint(c\d, c\lat, HOVER)
	Local px# = gX, py# = gY + above, pz# = gZ
	PositionEntity camera, px - camHeadX * back + camUpX * height, py - camHeadY * back + camUpY * height, pz - camHeadZ * back + camUpZ * height
	LookAt(px + camHeadX * 5 + camUpX * (1 - drop), py + camHeadY * 5 + camUpY * (1 - drop), pz + camHeadZ * 5 + camUpZ * (1 - drop))
	PositionEntity mountains, EntityX(camera), 0, EntityZ(camera)
End Function

; Turns the camera to a point, keeping its up close to camUp.
Function LookAt(x#, y#, z#)
	RotateEntity camera, 0, 0, 0
	AlignToVector camera, camUpX, camUpY, camUpZ, 2, 1
	TFormPoint x, y, z, 0, camera
	TurnEntity camera, 0, ATan2(-TFormedX(), TFormedZ()), 0
	TFormPoint x, y, z, 0, camera
	TurnEntity camera, -ATan2(TFormedY(), TFormedZ()), 0, 0
End Function

; --- Engine sound ----------------------------------------------------------------------------------------------------

Function StartEngine()
	StopEngine()
	If soundEngine = 0 Or optVolume = 0 Or Not optEngine Then Return
	engineChannel = PlaySound(soundEngine)
	ChannelVolume engineChannel, optVolume / 4.0 * 0.35
End Function

Function StopEngine()
	If engineChannel <> 0 Then StopChannel engineChannel
	engineChannel = 0
	StopLoops()
End Function

Function UpdateEngine()
	UpdateLoops()
	If engineChannel = 0 Then Return
	Local pitch# = 0.6 + player\spd / classScale * 0.4 + (classScale - 1) * 0.2
	If player\padTimer > 0 Or player\boostTimer > 0 Then pitch = pitch + 0.25
	If player\respawn > 0 Then pitch = 0.4
	ChannelPitch engineChannel, Int(22050 * pitch)
End Function

; The player's shield hums and the autopilot computes for as long as they last. Both only play while racing.
Function UpdateLoops()
	Local racing = state = STATE_RACE And optVolume > 0
	If racing And player\shield > 0 And player\respawn = 0
		If shieldChannel = 0
			shieldChannel = PlaySound(soundShieldHum)
			ChannelVolume shieldChannel, optVolume / 4.0 * 0.5
		EndIf
	ElseIf shieldChannel <> 0
		StopChannel shieldChannel
		shieldChannel = 0
		If racing Then PlaySfx(soundShieldDown)
	EndIf
	If racing And player\autopilot > 0 And player\respawn = 0
		If computerChannel = 0
			computerChannel = PlaySound(soundComputer)
			ChannelVolume computerChannel, optVolume / 4.0 * 0.6
		EndIf
	ElseIf computerChannel <> 0
		StopChannel computerChannel
		computerChannel = 0
	EndIf
End Function

Function StopLoops()
	If shieldChannel <> 0 Then StopChannel shieldChannel
	If computerChannel <> 0 Then StopChannel computerChannel
	shieldChannel = 0
	computerChannel = 0
End Function

Global shieldChannel, computerChannel

; --- Menus -----------------------------------------------------------------------------------------------------------

Function MenuInput()
	If KeyHit(KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount : PlaySfx(soundClick)
	If KeyHit(KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount : PlaySfx(soundClick)

	Local row = MenuLineAt(MouseX(), MouseY())
	If row >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = row

	If KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Then Return menuSelected
	If MouseHit(1) And row >= 0
		menuSelected = row
		Return row
	EndIf
	Return -1
End Function

; Which line is at a screen position, or -1. Lines are 32 pixels apart and 400 wide.
Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 200 Or x >= SCREEN_W / 2 + 200 Or y < menuTop Then Return -1
	Local row = (y - menuTop) / 32
	If row >= menuCount Then Return -1
	Return row
End Function

; Everything that opens a menu goes through here: forget old keys, clicks and mouse movement.
Function OpenMenu(newState, count, top)
	state = newState
	menuCount = count
	menuTop = top
	menuSelected = 0
	ShowPointer
	FlushKeys
	FlushMouse
	MouseXSpeed() ; So a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

; Behind the menus, four computer crafts race round the track, and the camera follows one after another.
Function StartDemo()
	ClearCrafts()
	StopEngine()
	SetWeapons(True)
	Local k, c.Craft
	For k = 0 To RACERS - 1
		NewCraft(RacerName(k), RacerR(k), RacerG(k), RacerB(k), True, 0.95 + k * 0.01, k Mod SHIPS)
	Next
	GridCrafts()
	k = 0
	For c = Each Craft
		c\d = Float(k) * trackLength / RACERS
		c\spd = 1.2 * classScale
		c\y = Ground(c\d, c\lat)
		k = k + 1
	Next
	demoTarget = First Craft
	demoTimer = 0
	camReset = True
End Function

Function UpdateDemo()
	If CraftCount() = 0 Then StartDemo()
	Local c.Craft
	For c = Each Craft
		DriveComputer(c)
	Next
	BumpCrafts()
	UpdateWeapons()
	For c = Each Craft
		PlaceCraft(c)
	Next
	demoTimer = demoTimer + 1
	If demoTimer > 480
		demoTimer = 0
		demoTarget = After demoTarget
		If demoTarget = Null Then demoTarget = First Craft
		camReset = True
	EndIf
	ChaseCamera(demoTarget, 14, 3, 3.5) ; Looking a little lower puts the craft above the menu.
End Function

Function GoToMenu()
	If state >= STATE_COUNTDOWN Or CraftCount() = 0 Then StartDemo()
	optionsFromPause = False
	OpenMenu(STATE_MENU, 5, 320)
	menuText(0) = "Race"
	menuText(1) = "Time trial"
	menuText(2) = "Options"
	menuText(3) = "How to play"
	menuText(4) = "Quit"
End Function

; Gives back True when the player chose Quit.
Function UpdateMenu()
	UpdateDemo()
	If KeyHit(KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0 : GoToSetup(MODE_RACE)
		Case 1 : GoToSetup(MODE_TRIAL)
		Case 2 : GoToOptions()
		Case 3 : OpenMenu(STATE_HELP, 0, 0)
		Case 4 : Return True
	End Select
	Return False
End Function

Function GoToSetup(newMode)
	raceMode = newMode
	If raceMode = MODE_RACE Then OpenMenu(STATE_SETUP, 8, SETUP_TOP) Else OpenMenu(STATE_SETUP, 5, SETUP_TOP)
	RefreshSetupText()
	menuSelected = menuCount - 2 ; Start.
End Function

Function RefreshSetupText()
	menuText(0) = "Track: " + trackNames(setupTrack)
	menuText(1) = "Class: " + classNames(setupClass) + "  (" + Int(classTop(setupClass) * 200) + " km/h)"
	menuText(2) = "Craft: " + shipNames(setupShip)
	If raceMode = MODE_RACE
		menuText(3) = "Laps: " + lapChoices(setupLaps)
		menuText(4) = "Rivals: " + rivalNames(setupRivals)
		If setupWeapons Then menuText(5) = "Weapons: on" Else menuText(5) = "Weapons: off"
	EndIf
	menuText(menuCount - 2) = "Start"
	menuText(menuCount - 1) = "Back"
End Function

Function UpdateSetup()
	UpdateDemo()
	Local change = 0
	If KeyHit(KEY_LEFT) Then change = -1
	If KeyHit(KEY_RIGHT) Then change = 1
	Local picked = MenuInput()
	If KeyHit(KEY_ESCAPE) Or picked = menuCount - 1
		SaveSettings()
		GoToMenu()
		If raceMode = MODE_TRIAL Then menuSelected = 1
		Return
	EndIf
	If picked = menuCount - 2
		SaveSettings()
		StartRace()
		Return
	EndIf
	If picked >= 0 Then change = 1 ; Enter or a click steps to the next value.
	If change = 0 Or menuSelected >= menuCount - 2 Then Return

	Select menuSelected
		Case 0
			setupTrack = (setupTrack + change + TRACKS) Mod TRACKS
			BuildTrack(setupTrack)
			StartDemo()
		Case 1
			SetClass((setupClass + change + CLASSES) Mod CLASSES)
			StartDemo()
		Case 2 : setupShip = (setupShip + change + SHIPS) Mod SHIPS
		Case 3 : setupLaps = (setupLaps + change + 3) Mod 3
		Case 4 : setupRivals = (setupRivals + change + 3) Mod 3
		Case 5 : setupWeapons = Not setupWeapons
	End Select
	PlaySfx(soundClick)
	RefreshSetupText()
End Function

Function GoToOptions()
	optionsFromPause = state = STATE_PAUSED
	OpenMenu(STATE_OPTIONS, 6, 250)
	RefreshOptionsText()
End Function

Function RefreshOptionsText()
	If optCamera = 0 Then menuText(0) = "Camera: close" Else menuText(0) = "Camera: far"
	If optFov = 0 Then menuText(1) = "Field of view: normal" Else menuText(1) = "Field of view: wide"
	menuText(2) = "Sound volume: " + (optVolume * 25) + "%"
	If optEngine Then menuText(3) = "Engine sound: on" Else menuText(3) = "Engine sound: off"
	If optFullscreen Then menuText(4) = "Display: full screen" Else menuText(4) = "Display: window"
	menuText(5) = "Back"
End Function

Function UpdateOptions()
	If Not optionsFromPause Then UpdateDemo()
	Local change = 0
	If KeyHit(KEY_LEFT) Then change = -1
	If KeyHit(KEY_RIGHT) Then change = 1
	Local picked = MenuInput()
	If picked >= 0 Then change = 1

	If KeyHit(KEY_ESCAPE) Or picked = 5
		SaveSettings()
		If optionsFromPause
			GoToPause()
			menuSelected = 2
		Else
			GoToMenu()
			menuSelected = 2
		EndIf
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optCamera = 1 - optCamera
		Case 1
			optFov = 1 - optFov
			ApplyCameraOptions()
		Case 2 : optVolume = (optVolume + change + 5) Mod 5
		Case 3 : optEngine = Not optEngine
		Case 4
			optFullscreen = Not optFullscreen
			OpenScreen()
			If optionsFromPause Then ChaseCamera(player, CameraBack(), CameraHeight(), 0)
	End Select
	PlaySfx(soundClick)
	RefreshOptionsText()
End Function

Function GoToPause()
	If engineChannel <> 0 Then PauseChannel engineChannel
	StopLoops() ; They start again when the race carries on.
	OpenMenu(STATE_PAUSED, 4, 260)
	menuText(0) = "Carry on"
	menuText(1) = "Start again"
	menuText(2) = "Options"
	menuText(3) = "Main menu"
End Function

Function UpdatePause()
	Local picked = MenuInput()
	If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_P) Then picked = 0
	Select picked
		Case 0
			state = STATE_RACE
			HidePointer
			If engineChannel <> 0 Then ResumeChannel engineChannel
			If raceFrames = 0 Then state = STATE_COUNTDOWN
		Case 1 : StartRace()
		Case 2 : GoToOptions()
		Case 3
			StopEngine()
			GoToMenu()
	End Select
End Function

; --- Racing ----------------------------------------------------------------------------------------------------------

Function RacerName$(k)
	Select k
		Case 0 : Return "You"
		Case 1 : Return "Vega"
		Case 2 : Return "Orin"
		Default : Return "Kestrel"
	End Select
End Function

Function RacerR(k)
	Select k
		Case 0 : Return 255
		Case 1 : Return 60
		Case 2 : Return 230
		Default : Return 120
	End Select
End Function

Function RacerG(k)
	Select k
		Case 0 : Return 140
		Case 1 : Return 200
		Case 2 : Return 70
		Default : Return 230
	End Select
End Function

Function RacerB(k)
	Select k
		Case 0 : Return 40
		Case 1 : Return 255
		Case 2 : Return 200
		Default : Return 90
	End Select
End Function

Function StartRace()
	ClearCrafts()
	StopEngine()
	raceLaps = lapChoices(setupLaps)
	SetWeapons(setupWeapons And raceMode = MODE_RACE)
	Local k, count = RACERS
	If raceMode = MODE_TRIAL Then count = 1
	player = NewCraft(RacerName(0), RacerR(0), RacerG(0), RacerB(0), False, 1.0, setupShip)
	For k = 1 To count - 1
		; Each rival flies a different design from the player's.
		NewCraft(RacerName(k), RacerR(k), RacerG(k), RacerB(k), True, rivalSkill(setupRivals) + (k - 2) * 0.012, (setupShip + k) Mod SHIPS)
	Next
	; The player starts at the back of the grid in a race. In a time trial the lap starts at the line.
	If raceMode = MODE_RACE Then Insert player After Last Craft
	GridCrafts()
	If raceMode = MODE_TRIAL
		player\d = trackLength - 40 : player\lat = 0 : player\y = Ground(player\d, 0)
		PlaceCraft(player)
	EndIf
	RankCrafts()
	raceFrames = 0
	countdown = 0
	newLapRecord = False
	newRaceRecord = False
	messageTimer = 0
	camReset = True
	state = STATE_COUNTDOWN
	HidePointer
	FlushKeys
	StartEngine()
End Function

Function UpdateCountdown()
	If countdown Mod 60 = 0 And countdown < 180 Then PlaySfx(soundBeep)
	countdown = countdown + 1
	If countdown = 180
		PlaySfx(soundGo)
		state = STATE_RACE
	EndIf
	Local c.Craft
	For c = Each Craft
		PlaceCraft(c)
	Next
	ChaseCamera(player, CameraBack(), CameraHeight(), 0)
	UpdateEngine()
	If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_P) Then GoToPause()
End Function

Function CameraBack#()
	If optCamera = 0 Then Return 7.5
	Return 11.0
End Function

Function CameraHeight#()
	If optCamera = 0 Then Return 2.4
	Return 3.6
End Function

Function UpdateRace()
	raceFrames = raceFrames + 1
	Local c.Craft
	For c = Each Craft
		If c\computer
			DriveComputer(c)
		Else
			Local steer# = 0
			If KeyDown(KEY_LEFT) Or KeyDown(KEY_A) Then steer = steer + 1
			If KeyDown(KEY_RIGHT) Or KeyDown(KEY_D) Then steer = steer - 1
			Local air# = 0
			If KeyDown(KEY_Q) Then air = air + 1
			If KeyDown(KEY_E) Then air = air - 1
			DriveCraft(c, KeyDown(KEY_UP) Or KeyDown(KEY_W), KeyDown(KEY_DOWN) Or KeyDown(KEY_S), steer, air)
			If KeyHit(KEY_LCTRL) Or KeyHit(KEY_RCTRL) Or KeyHit(KEY_F) Then FireWeapon(c)
		EndIf
	Next
	BumpCrafts()
	UpdateWeapons()
	For c = Each Craft
		PlaceCraft(c)
	Next
	RankCrafts()
	ChaseCamera(player, CameraBack(), CameraHeight(), 0)
	UpdateEngine()
End Function

Function GoToResults()
	; Crafts still racing get a finishing time from how fast they went so far.
	Local c.Craft, done#, total# = trackLength * raceLaps
	For c = Each Craft
		If Not c\finished
			done = (c\lap - 1) * trackLength + c\d
			If done < 1 Then done = 1
			c\finishTime = Int(raceFrames * total / done)
			If c\finishTime <= player\finishTime Then c\finishTime = player\finishTime + 1
			c\finished = True
		EndIf
	Next
	RankCrafts()
	ShowPointer
	OpenMenu(STATE_RESULTS, 2, 430)
	menuText(0) = "Race again"
	menuText(1) = "Main menu"
End Function

Function UpdateResults()
	Local c.Craft
	For c = Each Craft
		DriveComputer(c)
	Next
	BumpCrafts()
	UpdateWeapons()
	For c = Each Craft
		PlaceCraft(c)
	Next
	ChaseCamera(player, 12, 4, 0)
	Select MenuInput()
		Case 0 : StartRace()
		Case 1 : GoToMenu()
	End Select
	If KeyHit(KEY_ESCAPE) Then GoToMenu()
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	; The sky, with the watermark in it, then the world on top. The camera only clears the depth buffer.
	ClsColor SKY_R, SKY_G, SKY_B
	Cls
	DrawWatermark(SKY_R, SKY_G, SKY_B)
	RenderWorld

	Select state
		Case STATE_MENU
			DrawTitle("Hoverline", 120)
			DrawMenu()
		Case STATE_SETUP
			ShadeScreen()
			If raceMode = MODE_RACE Then DrawTitle("Race", 115) Else DrawTitle("Time trial", 115)
			DrawMenu()
			DrawShipStats(SETUP_TOP + menuCount * 32 + 14)
			DrawRecords(SETUP_TOP + menuCount * 32 + 92)
		Case STATE_OPTIONS
			ShadeScreen()
			DrawTitle("Options", 170)
			DrawMenu()
			SmallText(SCREEN_W / 2, 470, "Left/Right or a click change the selected option.")
		Case STATE_HELP
			ShadeScreen()
			DrawHelp()
		Case STATE_COUNTDOWN
			DrawHud()
			Local number = 3 - countdown / 60
			If number > 0 Then DrawBig(Str(number), 220)
		Case STATE_RACE
			DrawHud()
			If raceFrames < 60 Then DrawBig("GO!", 220)
		Case STATE_PAUSED
			DrawHud()
			ShadeScreen()
			DrawTitle("Paused", 180)
			DrawMenu()
		Case STATE_FINISHED
			DrawHud()
			DrawBig(PlaceText(player\place), 200)
			SmallText(SCREEN_W / 2, 290, "Finished in " + TimeText(player\finishTime))
		Case STATE_RESULTS
			ShadeScreen()
			DrawResults()
			DrawMenu()
	End Select

	If state <= STATE_HELP
		Color 120, 100, 160
		Text SCREEN_W / 2, SCREEN_H - 24, "A BlitzLLVM sample game", True, True
	EndIf
End Function

Function DrawHud()
	; Place and lap on the left, times on the right.
	SetFont hudFont
	If raceMode = MODE_RACE
		ShadowText(20, 14, PlaceText(player\place) + " / " + CraftCount(), False)
		ShadowText(20, 44, "Lap " + Int(Max(1, Min(raceLaps, player\lap))) + " / " + raceLaps, False)
	Else
		ShadowText(20, 14, "Time trial", False)
		ShadowText(20, 44, "Lap " + Int(Max(1, player\lap)), False)
	EndIf
	Local lapTime = raceFrames - player\lapStart
	If raceMode = MODE_TRIAL And player\lap = 0 Then lapTime = 0
	ShadowText(SCREEN_W - 20 - StringWidth(TimeText(lapTime)), 14, TimeText(lapTime), False)
	SetFont smallFont
	Local best$ = "Best lap  --"
	If player\bestLap > 0 Then best = "Best lap  " + TimeText(player\bestLap)
	ShadowText(SCREEN_W - 20 - StringWidth(best), 46, best, False)
	If recordLap(setupTrack, setupClass) > 0
		best = "Record  " + TimeText(recordLap(setupTrack, setupClass))
		ShadowText(SCREEN_W - 20 - StringWidth(best), 64, best, False)
	EndIf

	; Speed and energy at the bottom left.
	SetFont hudFont
	ShadowText(20, SCREEN_H - 84, Int(player\spd * 200) + " km/h", False)
	; The bar is as long as the craft's energy can be, so a tougher craft has a longer bar.
	Local barW = 40 + Int(player\maxEnergy * 1.6), x = 20, y = SCREEN_H - 44, filled = Int(barW * player\energy / player\maxEnergy)
	Local part# = player\energy / player\maxEnergy
	Color 20, 16, 36
	Rect x - 2, y - 2, barW + 4, 18, 1
	If part > 0.4
		Color 90, 230, 160
	ElseIf part > 0.15 Or frame Mod 20 < 10
		Color 255, 120, 80
	Else
		Color 120, 50, 40
	EndIf
	Rect x, y, filled, 14, 1
	Color 200, 200, 230
	Rect x - 2, y - 2, barW + 4, 18, 0
	SetFont smallFont
	ShadowText(x + barW + 12, y - 1, "Energy", False)

	DrawMinimap()
	If raceWeapons Then DrawWeaponHud()

	; Messages in the middle.
	If messageTimer > 0
		SetFont hudFont
		ShadowText(SCREEN_W / 2, 130, messageText, True)
	EndIf
	If player\respawn = 0 And Abs(player\vang) > 110 And player\spd > 0.2 And frame Mod 40 < 28
		SetFont hudFont
		Color 255, 80, 80
		Text SCREEN_W / 2, 170, "Wrong way", True, True
	EndIf
	If player\padTimer > 0 Or player\boostTimer > 0
		SetFont smallFont
		ShadowText(20, SCREEN_H - 108, "Boost", False)
	EndIf
	SetFont 0
End Function

Function DrawMinimap()
	Local x0 = SCREEN_W - MINIMAP - 12, y0 = SCREEN_H - MINIMAP - 12
	DrawImage minimapImage, x0, y0
	Local c.Craft
	For c = Each Craft
		If c <> player Then DrawMapDot(c, x0, y0, 3)
	Next
	DrawMapDot(player, x0, y0, 4)
End Function

Function DrawMapDot(c.Craft, x0, y0, size)
	TrackPoint(c\d, c\lat, 0)
	Color 0, 0, 0
	Oval x0 + MapX(gX) - size - 1, y0 + MapY(gZ) - size - 1, size * 2 + 2, size * 2 + 2, 1
	Color c\r, c\g, c\b
	Oval x0 + MapX(gX) - size, y0 + MapY(gZ) - size, size * 2, size * 2, 1
End Function

Global mapMinX#, mapMinZ#, mapScale#
Function MapX(x#)
	Return Int(8 + (x - mapMinX) * mapScale)
End Function

Function MapY(z#)
	Return Int(MINIMAP - 8 - (z - mapMinZ) * mapScale)
End Function

; The track seen from above, drawn once into a picture. Higher parts are drawn lighter, and last, so they cross over.
Function MakeMinimap()
	Local i, maxX# = -100000, maxZ# = -100000, minY# = 100000, maxY# = -100000
	mapMinX = 100000 : mapMinZ = 100000
	For i = 0 To slices - 1
		mapMinX = Min(mapMinX, tX(i)) : maxX = Max(maxX, tX(i))
		mapMinZ = Min(mapMinZ, tZ(i)) : maxZ = Max(maxZ, tZ(i))
		minY = Min(minY, tY(i)) : maxY = Max(maxY, tY(i))
	Next
	mapScale = (MINIMAP - 16) / Max(maxX - mapMinX, maxZ - mapMinZ)
	; Centre the shorter side.
	mapMinX = mapMinX - ((MINIMAP - 16) / mapScale - (maxX - mapMinX)) / 2
	mapMinZ = mapMinZ - ((MINIMAP - 16) / mapScale - (maxZ - mapMinZ)) / 2

	If minimapImage <> 0 Then FreeImage minimapImage
	minimapImage = CreateImage(MINIMAP, MINIMAP)
	SetBuffer ImageBuffer(minimapImage)
	ClsColor 0, 0, 0
	Cls
	Local pass, n, dx, dy, light#, x1, y1, x2, y2
	For pass = 0 To 1
		For i = 0 To slices - 1
			n = (i + 1) Mod slices
			light = (tY(i) - minY) / Max(1, maxY - minY)
			If (light > 0.5) = (pass = 1) And HasRoad(i)
				x1 = MapX(tX(i)) : y1 = MapY(tZ(i)) : x2 = MapX(tX(n)) : y2 = MapY(tZ(n))
				Color 10, 8, 20
				For dx = -2 To 2
					For dy = -2 To 2
						Line x1 + dx, y1 + dy, x2 + dx, y2 + dy
					Next
				Next
				Color Int(110 + light * 130), Int(100 + light * 130), Int(170 + light * 80)
				For dx = -1 To 1
					Line x1 + dx, y1, x2 + dx, y2
					Line x1, y1 + dx, x2, y2 + dx
				Next
			EndIf
		Next
	Next
	Color 255, 255, 255
	Rect MapX(tX(0)) - 1, MapY(tZ(0)) - 1, 3, 3, 1
	SetBuffer BackBuffer()
End Function

; The four strengths of the chosen craft, as bars of 8 blocks.
Function DrawShipStats(y)
	Local k, block, x, value
	SetFont smallFont
	For k = 0 To 3
		x = SCREEN_W / 2 - 200 + (k Mod 2) * 210
		Local rowY = y + (k / 2) * 26
		Select k
			Case 0 : value = shipAccel(setupShip) : ShadowText(x, rowY, "Acceleration", False)
			Case 1 : value = shipSpeed(setupShip) : ShadowText(x, rowY, "Top speed", False)
			Case 2 : value = shipEnergy(setupShip) : ShadowText(x, rowY, "Energy", False)
			Default : value = shipBrake(setupShip) : ShadowText(x, rowY, "Brakes", False)
		End Select
		For block = 0 To 7
			If block < value Then Color 255, 150, 90 Else Color 50, 40, 80
			Rect x + 104 + block * 11, rowY + 3, 9, 12, 1
		Next
	Next
	SetFont 0
End Function

Function DrawRecords(y)
	Local lap$ = "--", race$ = "--"
	If recordLap(setupTrack, setupClass) > 0 Then lap = TimeText(recordLap(setupTrack, setupClass))
	If recordRace(setupTrack, setupLaps, setupClass) > 0 Then race = TimeText(recordRace(setupTrack, setupLaps, setupClass))
	SmallText(SCREEN_W / 2, y, "Best " + classNames(setupClass) + " lap on this track:  " + lap)
	If raceMode = MODE_RACE Then SmallText(SCREEN_W / 2, y + 22, "Best " + lapChoices(setupLaps) + " lap race:  " + race)
End Function

Function DrawResults()
	DrawTitle("Results", 110)
	SetFont menuFont
	Local i, y, c.Craft, best$
	Color 180, 170, 220
	Text 190, 180, "Place"
	Text 290, 180, "Pilot"
	Text 420, 180, "Time"
	Text 530, 180, "Best lap"
	For i = 0 To CraftCount() - 1
		c = order(i)
		y = 214 + i * 34
		If c = player
			Color 70, 50, 110
			Rect 170, y - 6, 460, 30, 1
		EndIf
		Color c\r, c\g, c\b
