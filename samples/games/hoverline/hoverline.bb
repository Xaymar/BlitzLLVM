Global engineChannel

; A timer keeps the game at 60 updates per second on every computer.
Global timer = CreateTimer(60)

GoToMenu()
Local quit = False
While Not quit
	WaitTimer timer
	frame = frame + 1
	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_SETUP
			UpdateSetup()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_HELP
			UpdateDemo()
			If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Or MouseHit(1) Then GoToMenu() : menuSelected = 3
		Case STATE_COUNTDOWN
			UpdateCountdown()
		Case STATE_RACE
			UpdateRace()
			If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_P) Then GoToPause()
		Case STATE_PAUSED
			UpdatePause()
		Case STATE_FINISHED
			UpdateRace()
			finishTimer = finishTimer - 1
			If finishTimer <= 0 Or KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Then GoToResults()
		Case STATE_RESULTS
			UpdateResults()
	End Select

	UpdateSparks()
	If messageTimer > 0 Then messageTimer = messageTimer - 1
	PositionTexture padTex, 0, -frame * 0.04
	PositionTexture chargeTex, 0, -frame * 0.02
	PositionTexture fieldTex, frame * 0.01, 0
	DrawGame()
	Flip 0 ; The timer already paces the game, so Flip does not have to wait as well.
Wend

SaveSettings()
End

; --- Screen and settings ---------------------------------------------------------------------------------------------

; Opens the window or full screen, as the option says. Graphics3D frees every entity, texture and image, so all of
; them are made again here, and the crafts get new meshes.
Function OpenScreen()
	If optFullscreen Then Graphics3D SCREEN_W, SCREEN_H, 0, 1 Else Graphics3D SCREEN_W, SCREEN_H, 0, 2
	AppTitle "Hoverline"
	SetBuffer BackBuffer()
	SeedRnd MilliSecs()

	camera = CreateCamera()
	CameraRange camera, 0.5, 1200
	CameraFogMode camera, 1
	CameraFogColor camera, SKY_R, SKY_G, SKY_B
	CameraFogRange camera, 250, 900
	; The sky is drawn by Cls before RenderWorld (with the watermark on it), so the camera only clears depth.
	CameraClsMode camera, False, True
	ApplyCameraOptions()
	camReset = True

	sun = CreateLight()
	RotateEntity sun, 40, -60, 0
	LightColor sun, 255, 220, 200
	AmbientLight 110, 100, 140

	titleFont = LoadFont("Arial", 64, True, True)
	menuFont = LoadFont("Arial", 18, True)
	hudFont = LoadFont("Arial", 26, True)
	bigFont = LoadFont("Arial", 96, True)
	smallFont = LoadFont("Arial", 16)

	MakeTextures()
	sparkTemplate = CreateSprite()
	EntityTexture sparkTemplate, glowTex
	EntityBlend sparkTemplate, 3
	EntityFX sparkTemplate, 1 + 8
	HideEntity sparkTemplate
	mountains = MakeMountains()

	Local ground = CreatePlane()
	EntityTexture ground, gridTex
	EntityFX ground, 1

	trackRoot = 0
	minimapImage = 0
	BuildTrack(setupTrack)

	MakeWeaponTemplates()
	Local c.Craft
	For c = Each Craft
		MakeCraftMesh(c)
	Next
	Local s.Spark
	For s = Each Spark
		Delete s
	Next
	Local sh.Shot, wv.Wave, pl.Pulse
	For sh = Each Shot
		Delete sh
	Next
	For wv = Each Wave
		Delete wv
	Next
	For pl = Each Pulse
		Delete pl
	Next
	watermark = 0
	shadeImage = 0
End Function

Function ApplyCameraOptions()
	If optFov = 1 Then CameraZoom camera, 0.8 Else CameraZoom camera, 1.0
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	Local t, l, k, version = ReadInt(file) ; A version number, so a changed file format can be recognised.
	If version >= 1 And version <= 3
		optCamera = ReadInt(file)
		optFov = ReadInt(file)
		optVolume = ReadInt(file)
		optEngine = ReadInt(file)
		optFullscreen = ReadInt(file)
		setupTrack = ReadInt(file)
		setupLaps = ReadInt(file)
		setupRivals = ReadInt(file)
		If version = 1
			; Before the classes and craft designs: every record was set in the slowest class.
			For t = 0 To TRACKS - 1
				recordLap(t, 0) = ReadInt(file)
				For l = 0 To 2
					recordRace(t, l, 0) = ReadInt(file)
				Next
			Next
		Else
			setupClass = ReadInt(file)
			setupShip = ReadInt(file)
			If version >= 3 Then setupWeapons = ReadInt(file) <> 0
			For k = 0 To CLASSES - 1
				For t = 0 To TRACKS - 1
					recordLap(t, k) = ReadInt(file)
					For l = 0 To 2
						recordRace(t, l, k) = ReadInt(file)
					Next
				Next
			Next
		EndIf
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optCamera < 0 Or optCamera > 1 Then optCamera = 0
	If optFov < 0 Or optFov > 1 Then optFov = 0
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
	If setupTrack < 0 Or setupTrack >= TRACKS Then setupTrack = 0
	If setupLaps < 0 Or setupLaps > 2 Then setupLaps = 0
	If setupRivals < 0 Or setupRivals > 2 Then setupRivals = 1
	If setupClass < 0 Or setupClass >= CLASSES Then setupClass = 0
	If setupShip < 0 Or setupShip >= SHIPS Then setupShip = 0
	For k = 0 To CLASSES - 1
		For t = 0 To TRACKS - 1
			If recordLap(t, k) < 0 Then recordLap(t, k) = 0
			For l = 0 To 2
				If recordRace(t, l, k) < 0 Then recordRace(t, l, k) = 0
			Next
		Next
	Next
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets the options.
	WriteInt file, 3
	WriteInt file, optCamera
	WriteInt file, optFov
	WriteInt file, optVolume
	WriteInt file, optEngine
	WriteInt file, optFullscreen
	WriteInt file, setupTrack
	WriteInt file, setupLaps
	WriteInt file, setupRivals
	WriteInt file, setupClass
	WriteInt file, setupShip
	WriteInt file, setupWeapons
	Local t, l, k
	For k = 0 To CLASSES - 1
		For t = 0 To TRACKS - 1
			WriteInt file, recordLap(t, k)
			For l = 0 To 2
				WriteInt file, recordRace(t, l, k)
			Next
		Next
	Next
	CloseFile file
End Function

; Every sound goes through here, so the volume option works everywhere.
