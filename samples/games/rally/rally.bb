; Rally: a two-paddle ball game for one or two players.
;
; Every picture and sound in this game is made by the code itself, so there are no files to ship with it.
;
; Controls:
;   Menus:         Up/Down or the mouse choose, Enter/Space or a click select, Left/Right change an option
;   Left paddle:   the mouse, or W and S
;   Right paddle:  Up and Down (two players only)
;   P pauses, Escape goes back to the menu.
;
; The options are saved in rally.cfg next to the program.

Const SCREEN_W = 800, SCREEN_H = 600
Const COURT_TOP = 60, COURT_BOTTOM = 580
Const PADDLE_W = 12, PADDLE_H = 84, PADDLE_SPEED# = 7.0, PADDLE_MARGIN = 32
Const MOUSE_SPEED# = 16.0 ; How far the paddle can follow the mouse in one update: fast, but not a jump.
Const BALL_SIZE = 12, BALL_START_SPEED# = 6.0, BALL_MAX_SPEED# = 15.0, BALL_SPEEDUP# = 0.45
Const TRAIL_LENGTH = 14

; The states the game can be in. The main loop asks the current state what to do.
Const STATE_MENU = 0, STATE_OPTIONS = 1, STATE_HELP = 2, STATE_SERVE = 3, STATE_PLAY = 4, STATE_PAUSED = 5
Const STATE_OVER = 6

; Scan codes of the keys we use.
Const KEY_ESCAPE = 1, KEY_W = 17, KEY_P = 25, KEY_S = 31, KEY_ENTER = 28, KEY_SPACE = 57
Const KEY_UP = 200, KEY_DOWN = 208, KEY_LEFT = 203, KEY_RIGHT = 205

Type Paddle
	Field x#, y#        ; Top left corner.
	Field speed#        ; How far it moved this frame, which puts spin on the ball.
	Field score
	Field computer      ; True if the computer plays this paddle.
	Field guess#        ; The computer's aiming error for the ball that is coming.
	Field r, g, b
End Type

Type Spark
	Field x#, y#, vx#, vy#
	Field life#
	Field r, g, b
End Type

; --- Options -----------------------------------------------------------------------------------------------------
Global optSkill = 2        ; 1 to 3: how well the computer plays.
Global optPoints = 1       ; Index into pointsToWin below.
Global optVolume = 4       ; 0 to 4, in quarters.
Global optShake = True     ; Shake the screen when a point is scored.
Global optFullscreen = False
Global optMouse = True     ; The mouse moves the left paddle.
Global mouseTarget# = -1   ; Where the mouse wants the left paddle, or -1 while the keys are in charge.
Dim pointsToWin(2)
pointsToWin(0) = 5 : pointsToWin(1) = 7 : pointsToWin(2) = 11

Global settingsPath$ = SystemProperty$("appdir")
If settingsPath <> "" And Right(settingsPath, 1) <> "\" And Right(settingsPath, 1) <> "/" Then settingsPath = settingsPath + "/"
settingsPath = settingsPath + "rally.cfg"
LoadSettings()

; --- Game ----------------------------------------------------------------------------------------------------------
Global state = STATE_MENU
Global twoPlayers = False
Global serveTimer = 0, serveDirection = 1
Global shake# = 0
Global flashTimer = 0
Global winner.Paddle

Global ballX#, ballY#, ballVX#, ballVY#, ballSpeed#, rallyHits
Dim trailX#(TRAIL_LENGTH - 1), trailY#(TRAIL_LENGTH - 1)

Global leftPaddle.Paddle = New Paddle
leftPaddle\x = Float(PADDLE_MARGIN)
leftPaddle\r = 90 : leftPaddle\g = 200 : leftPaddle\b = 255
Global rightPaddle.Paddle = New Paddle
rightPaddle\x = Float(SCREEN_W - PADDLE_MARGIN - PADDLE_W)
rightPaddle\r = 255 : rightPaddle\g = 140 : rightPaddle\b = 80

; --- Menus ---------------------------------------------------------------------------------------------------------
Dim menuText$(7)
Global menuCount, menuSelected, menuTop

OpenScreen()

; --- Sounds ----------------------------------------------------------------------------------------------------------
Const WAVE_SQUARE = 0, WAVE_SINE = 1, WAVE_NOISE = 2
Global soundPaddle = MakeSound(440, 880, 60, WAVE_SQUARE, 0.25)
Global soundWall = MakeSound(330, 330, 40, WAVE_SQUARE, 0.2)
Global soundScore = MakeSound(660, 165, 420, WAVE_SINE, 0.4)
Global soundServe = MakeSound(520, 780, 90, WAVE_SINE, 0.3)
Global soundWin = MakeSound(262, 1046, 900, WAVE_SQUARE, 0.25)
Global soundSelect = MakeSound(700, 700, 50, WAVE_SQUARE, 0.2)

; A timer keeps the game at 60 updates per second on every computer.
Local timer = CreateTimer(60)

GoToMenu()
Local quit = False
While Not quit
	WaitTimer timer
	Select state
		Case STATE_MENU
			quit = UpdateMenu()
		Case STATE_OPTIONS
			UpdateOptions()
		Case STATE_HELP
			If KeyHit(KEY_ESCAPE) Or KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Or MouseHit(1) Then GoToMenu()
		Case STATE_SERVE
			UpdatePaddles()
			UpdateServe()
		Case STATE_PLAY
			UpdatePaddles()
			UpdateBall()
		Case STATE_PAUSED
			If KeyHit(KEY_P) Then state = STATE_PLAY
		Case STATE_OVER
			If KeyHit(KEY_SPACE) Or KeyHit(KEY_ENTER) Or MouseHit(1) Then GoToMenu()
	End Select

	If state >= STATE_SERVE
		If KeyHit(KEY_ESCAPE) Then GoToMenu()
		If state = STATE_PLAY And KeyHit(KEY_P) Then state = STATE_PAUSED
	EndIf

	UpdateSparks()
	DrawGame()
	Flip 0 ; The timer already paces the game, so Flip does not have to wait as well.
Wend

End

; --- Screen and settings -------------------------------------------------------------------------------------------

; Opens the window or full screen, as the option says. Graphics frees all images, so the watermark is made again.
Function OpenScreen()
	If optFullscreen Then Graphics SCREEN_W, SCREEN_H, 0, 1 Else Graphics SCREEN_W, SCREEN_H, 0, 2
	AppTitle "Rally"
	SetBuffer BackBuffer()
	SeedRnd MilliSecs()
	watermark = 0
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	Local version = ReadInt(file) ; A version number, so a changed file format can be recognised later.
	If version = 1 Or version = 2
		optSkill = ReadInt(file)
		optPoints = ReadInt(file)
		optVolume = ReadInt(file)
		optShake = ReadInt(file)
		optFullscreen = ReadInt(file)
	EndIf
	If version = 2 Then optMouse = ReadInt(file) ; Version 1 files are older than the mouse option.
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optSkill < 1 Or optSkill > 3 Then optSkill = 2
	If optPoints < 0 Or optPoints > 2 Then optPoints = 1
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets the options.
	WriteInt file, 2
	WriteInt file, optSkill
	WriteInt file, optPoints
	WriteInt file, optVolume
	WriteInt file, optShake
	WriteInt file, optFullscreen
	WriteInt file, optMouse
	CloseFile file
End Function

; Every sound goes through here, so the volume option works everywhere.
Function PlaySfx(sound)
	If sound = 0 Or optVolume = 0 Then Return
	Local channel = PlaySound(sound)
	ChannelVolume channel, optVolume / 4.0
End Function

; --- Menus ---------------------------------------------------------------------------------------------------------
; A menu is a list of lines and the number of the selected one. The keyboard moves the selection, the mouse selects
; the line it is over. MenuInput gives back the line chosen with Enter, Space or a click, or -1.

Function MenuInput()
	If KeyHit(KEY_UP) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount : PlaySfx(soundSelect)
	If KeyHit(KEY_DOWN) Then menuSelected = (menuSelected + 1) Mod menuCount : PlaySfx(soundSelect)

	Local line = MenuLineAt(MouseX(), MouseY())
	If line >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = line

	If KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Then Return menuSelected
	If MouseHit(1) And line >= 0
		menuSelected = line
		Return line
	EndIf
	Return -1
End Function

; Which line is at a screen position, or -1. Lines are 30 pixels apart and 360 wide.
Function MenuLineAt(x, y)
	If x < SCREEN_W / 2 - 180 Or x >= SCREEN_W / 2 + 180 Or y < menuTop Then Return -1
	Local line = (y - menuTop) / 30
	If line >= menuCount Then Return -1
	Return line
End Function

Function DrawMenu()
	Local i, y
	For i = 0 To menuCount - 1
		y = menuTop + i * 30
		If i = menuSelected
			Color 70, 60, 130
			Rect SCREEN_W / 2 - 180, y, 360, 26, 1
			Color 255, 230, 140
		Else
			Color 200, 200, 220
		EndIf
		Text SCREEN_W / 2, y + 13, menuText(i), True, True
	Next
End Function

Function GoToMenu()
	state = STATE_MENU
	menuCount = 5
	menuSelected = 0
	menuTop = 280
	menuText(0) = "Play against the computer"
	menuText(1) = "Two players"
	menuText(2) = "Options"
	menuText(3) = "How to play"
	menuText(4) = "Quit"
	ResetTrail() ; The ball's trail would otherwise stay frozen in the air.
	; Forget keys pressed during a match, so they do not act on the menu too.
	FlushKeys
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
	ShowPointer
End Function

; Gives back True when the player chose Quit.
Function UpdateMenu()
	If KeyHit(KEY_ESCAPE) Then Return True
	Select MenuInput()
		Case 0 : StartMatch(False)
		Case 1 : StartMatch(True)
		Case 2 : GoToOptions()
		Case 3
			state = STATE_HELP
			FlushKeys
			FlushMouse
		Case 4 : Return True
	End Select
	Return False
End Function

Function GoToOptions()
	state = STATE_OPTIONS
	menuCount = 7
	menuTop = 225
	menuSelected = 0
	RefreshOptionsText()
	PlaySfx(soundSelect)
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over the menu does not pick a line.
	MouseYSpeed()
End Function

Function RefreshOptionsText()
	Select optSkill
		Case 1 : menuText(0) = "Computer: Relaxed"
		Case 2 : menuText(0) = "Computer: Fair"
		Case 3 : menuText(0) = "Computer: Sharp"
	End Select
	menuText(1) = "Points to win: " + pointsToWin(optPoints)
	menuText(2) = "Sound volume: " + (optVolume * 25) + "%"
	If optShake Then menuText(3) = "Screen shake: on" Else menuText(3) = "Screen shake: off"
	If optFullscreen Then menuText(4) = "Display: full screen" Else menuText(4) = "Display: window"
	If optMouse Then menuText(5) = "Left paddle: mouse and keys" Else menuText(5) = "Left paddle: keys only"
	menuText(6) = "Back"
End Function

Function UpdateOptions()
	Local change = 0
	If KeyHit(KEY_LEFT) Then change = -1
	If KeyHit(KEY_RIGHT) Then change = 1
	Local chosen = MenuInput()
	If chosen >= 0 Then change = 1 ; Enter or a click steps to the next value.

	If KeyHit(KEY_ESCAPE) Or chosen = 6
		SaveSettings()
		GoToMenu()
		menuSelected = 2 ; Back on "Options".
		PlaySfx(soundSelect)
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optSkill = (optSkill - 1 + change + 3) Mod 3 + 1
		Case 1 : optPoints = (optPoints + change + 3) Mod 3
		Case 2 : optVolume = (optVolume + change + 5) Mod 5
		Case 3 : optShake = Not optShake
		Case 4
			optFullscreen = Not optFullscreen
			OpenScreen()
		Case 5 : optMouse = Not optMouse
	End Select
	PlaySfx(soundSelect)
	RefreshOptionsText()
End Function

; --- Game flow -------------------------------------------------------------------------------------------------------

Function StartMatch(players2)
	twoPlayers = players2
	leftPaddle\score = 0
	rightPaddle\score = 0
	leftPaddle\computer = False
	rightPaddle\computer = Not twoPlayers
	leftPaddle\y = Float((COURT_TOP + COURT_BOTTOM - PADDLE_H) / 2)
	rightPaddle\y = leftPaddle\y
	FlushKeys
	FlushMouse
	MouseYSpeed() ; Only mouse movement from now on moves the paddle.
	mouseTarget = -1
	HidePointer
	serveDirection = 1 - 2 * Rand(0, 1) ; Either 1 or -1.
	PrepareServe()
	PlaySfx(soundSelect)
End Function

; Puts the ball in the middle and waits a moment before it starts moving.
Function PrepareServe()
	ballX = Float((SCREEN_W - BALL_SIZE) / 2)
	ballY = Float((COURT_TOP + COURT_BOTTOM - BALL_SIZE) / 2)
	ballVX = 0 : ballVY = 0
	ResetTrail()
	serveTimer = 60
	rallyHits = 0
	state = STATE_SERVE
End Function

Function UpdateServe()
	serveTimer = serveTimer - 1
	If serveTimer > 0 Then Return

	; Serve at a random angle of up to 30 degrees, towards the player who lost the last point.
	Local angle# = Rnd(-30, 30)
	ballSpeed = BALL_START_SPEED
	ballVX = Cos(angle) * ballSpeed * serveDirection
	ballVY = Sin(angle) * ballSpeed
	PlaySfx(soundServe)
	state = STATE_PLAY
End Function

Function ScorePoint(scorer.Paddle)
	scorer\score = scorer\score + 1
	If optShake Then shake = 12
	flashTimer = 10
	BurstSparks(ballX + BALL_SIZE / 2, ballY + BALL_SIZE / 2, 60, scorer\r, scorer\g, scorer\b)
	If scorer = leftPaddle Then serveDirection = 1 Else serveDirection = -1

	If scorer\score >= pointsToWin(optPoints)
		winner = scorer
		state = STATE_OVER
		ResetTrail()
		PlaySfx(soundWin)
	Else
		PlaySfx(soundScore)
		PrepareServe()
	EndIf
End Function

; --- Paddles ---------------------------------------------------------------------------------------------------------

Function UpdatePaddles()
	Local oldY#

	; The left paddle follows the keys while they are held, and otherwise the mouse: its middle goes to the height of
	; the mouse, as fast as MOUSE_SPEED allows. Touching a key hands the paddle back to the keys until the mouse moves.
	oldY = leftPaddle\y
	Local keys = KeyDown(KEY_S) - KeyDown(KEY_W)
	If keys <> 0
		leftPaddle\y = leftPaddle\y + keys * PADDLE_SPEED
		mouseTarget = -1
	ElseIf optMouse
		If MouseYSpeed() <> 0 Then mouseTarget = Float(MouseY() - PADDLE_H / 2)
		If mouseTarget >= 0 Then leftPaddle\y = leftPaddle\y + Clamp(mouseTarget - leftPaddle\y, -MOUSE_SPEED, MOUSE_SPEED)
	EndIf
	leftPaddle\y = Clamp(leftPaddle\y, Float(COURT_TOP), Float(COURT_BOTTOM - PADDLE_H))
	leftPaddle\speed = leftPaddle\y - oldY

	oldY = rightPaddle\y
	If rightPaddle\computer
		ComputerMove(rightPaddle)
	Else
		rightPaddle\y = rightPaddle\y + (KeyDown(KEY_DOWN) - KeyDown(KEY_UP)) * PADDLE_SPEED
	EndIf
	rightPaddle\y = Clamp(rightPaddle\y, Float(COURT_TOP), Float(COURT_BOTTOM - PADDLE_H))
	rightPaddle\speed = rightPaddle\y - oldY
End Function

; The computer works out where the ball will cross its side, bounces included, and moves there. To make it beatable
; it makes a mistake in that guess: picked once for every ball that comes its way, bigger for a fast ball and for a
; lower skill. Lower skill also makes it slower, and Relaxed and Fair only react once the ball crosses the middle.
Function ComputerMove(p.Paddle)
	Local targetY# = Float((COURT_TOP + COURT_BOTTOM - PADDLE_H) / 2) ; Wait in the middle by default.
	Local maxSpeed#, reactDistance#, mistake#
	Select optSkill
		Case 1 : maxSpeed = 0.5 : reactDistance = 0.5 : mistake = 1.2
		Case 2 : maxSpeed = 0.7 : reactDistance = 0.5 : mistake = 0.9
		Case 3 : maxSpeed = 0.9 : reactDistance = 0.8 : mistake = 0.7
	End Select
	maxSpeed = maxSpeed * PADDLE_SPEED
	reactDistance = reactDistance * SCREEN_W

	Local towards = (ballVX > 0 And p\x > ballX) Or (ballVX < 0 And p\x < ballX)
	If Not towards
		p\guess = 9999 ; 9999 means "no guess yet": the next ball that comes gets a new mistake.
	ElseIf Abs(p\x - ballX) < reactDistance
		If p\guess = 9999 Then p\guess = Rnd(-1, 1) * mistake * PADDLE_H * (0.15 + 0.85 * ballSpeed / BALL_MAX_SPEED)
		; Follow the ball's path forward, folding it back at the walls like the ball itself will.
		Local frames# = Abs((p\x - ballX) / ballVX)
		Local height# = Float(COURT_BOTTOM - COURT_TOP - BALL_SIZE)
		Local y# = (ballY - COURT_TOP) + ballVY * frames
		y = y - Floor(y / (2 * height)) * (2 * height)
		If y > height Then y = 2 * height - y
		targetY = COURT_TOP + y + BALL_SIZE / 2 - PADDLE_H / 2 + p\guess
	EndIf

	Local diff# = targetY - p\y
	If Abs(diff) > maxSpeed Then diff = Sgn(diff) * maxSpeed
	p\y = p\y + diff
End Function

; --- Ball ------------------------------------------------------------------------------------------------------------

Function UpdateBall()
	; Remember where the ball was, for the trail behind it.
	Local i%
	For i = TRAIL_LENGTH - 1 To 1 Step -1
		trailX(i) = trailX(i - 1)
		trailY(i) = trailY(i - 1)
	Next
	trailX(0) = ballX : trailY(0) = ballY

	; Fast balls could jump through a paddle in one step, so move in small steps and check each one.
	Local steps = Int(Ceil(ballSpeed / 4))
	Local s%
	For s = 1 To steps
		ballX = ballX + ballVX / steps
		ballY = ballY + ballVY / steps

		; Top and bottom walls.
		If ballY < COURT_TOP
			ballY = Float(COURT_TOP)
			ballVY = Abs(ballVY)
			PlaySfx(soundWall)
		ElseIf ballY > COURT_BOTTOM - BALL_SIZE
			ballY = Float(COURT_BOTTOM - BALL_SIZE)
			ballVY = -Abs(ballVY)
			PlaySfx(soundWall)
		EndIf

		If ballVX < 0 Then CheckPaddleHit(leftPaddle, 1)
		If ballVX > 0 Then CheckPaddleHit(rightPaddle, -1)

		; Past a paddle: the other side scores.
		If ballX < -BALL_SIZE
			ScorePoint(rightPaddle)
			Return
		ElseIf ballX > SCREEN_W
			ScorePoint(leftPaddle)
			Return
		EndIf
	Next
End Function

; direction is the way the ball should travel after hitting this paddle: 1 for right, -1 for left.
Function CheckPaddleHit(p.Paddle, direction)
	; RectsOverlap is built in: it tells whether two rectangles touch.
	If Not RectsOverlap(Int(ballX), Int(ballY), BALL_SIZE, BALL_SIZE, Int(p\x), Int(p\y), PADDLE_W, PADDLE_H) Then Return

	; Where on the paddle did it hit? -1 is the top end, 0 the middle, 1 the bottom end. Hits near the ends send the
	; ball away at a steep angle, which is how players aim.
	Local offset# = ((ballY + BALL_SIZE / 2) - (p\y + PADDLE_H / 2)) / (PADDLE_H / 2)
	offset = Clamp(offset, -1, 1)
	Local angle# = offset * 55 + p\speed * 2.5 ; A moving paddle adds spin.
	angle = Clamp(angle, -60, 60)

	rallyHits = rallyHits + 1
	ballSpeed = ballSpeed + BALL_SPEEDUP
	If ballSpeed > BALL_MAX_SPEED Then ballSpeed = BALL_MAX_SPEED
	ballVX = Cos(angle) * ballSpeed * direction
	ballVY = Sin(angle) * ballSpeed

	; Put the ball just outside the paddle so it cannot hit it twice.
	If direction = 1 Then ballX = p\x + PADDLE_W Else ballX = p\x - BALL_SIZE

	BurstSparks(ballX + BALL_SIZE / 2, ballY + BALL_SIZE / 2, 14, p\r, p\g, p\b)
	PlaySfx(soundPaddle)
End Function

Function ResetTrail()
	Local i%
	For i = 0 To TRAIL_LENGTH - 1
		trailX(i) = ballX : trailY(i) = ballY
	Next
End Function

; --- Sparks ----------------------------------------------------------------------------------------------------------

Function BurstSparks(x#, y#, count, r, g, b)
	Local i%
	For i = 1 To count
		Local s.Spark = New Spark
		Local angle# = Rnd(360)
		Local speed# = Rnd(1, 6)
		s\x = x : s\y = y
		s\vx = Cos(angle) * speed
		s\vy = Sin(angle) * speed
		s\life = Rnd(0.6, 1.0)
		s\r = r : s\g = g : s\b = b
	Next
End Function

Function UpdateSparks()
	Local s.Spark
	For s.Spark = Each Spark
		s\x = s\x + s\vx
		s\y = s\y + s\vy
		s\vx = s\vx * 0.94
		s\vy = s\vy * 0.94
		s\life = s\life - 0.025
		If s\life <= 0 Then Delete s
	Next
	If shake > 0 Then shake = shake * 0.85 - 0.1
	If flashTimer > 0 Then flashTimer = flashTimer - 1
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	; Shake everything by moving the drawing origin a little.
	Local ox = 0, oy = 0
	If shake > 0 Then ox = Rand(Int(-shake), Int(shake)) : oy = Rand(Int(-shake), Int(shake))
	Origin ox, oy

	; Background, brighter for a moment after a point.
	If flashTimer > 0
		ClsColor 40 + flashTimer * 4, 30, 60
		Cls
	Else
		ClsColor 14, 12, 28
		Cls
		DrawWatermark(14, 12, 28)
	EndIf

	DrawCourt(state > STATE_HELP) ; No net behind the menus, it would cross the text.

	If state <= STATE_HELP
		DrawTitle()
		Origin 0, 0
		Return
	EndIf

	DrawPaddle(leftPaddle)
	DrawPaddle(rightPaddle)
	DrawBall()
	DrawSparks()

	; Scores in big digits, built from rectangles.
	Color leftPaddle\r, leftPaddle\g, leftPaddle\b
	DrawNumber(leftPaddle\score, SCREEN_W / 2 - 90, 8, 6)
	Color rightPaddle\r, rightPaddle\g, rightPaddle\b
	DrawNumber(rightPaddle\score, SCREEN_W / 2 + 60, 8, 6)

	Origin 0, 0
	Color 200, 200, 220
	If state = STATE_SERVE
		If rallyHits = 0 And leftPaddle\score + rightPaddle\score = 0 Then CenterText(SCREEN_H / 2 - 60, "Get ready")
	ElseIf state = STATE_PAUSED
		CenterText(SCREEN_H / 2 - 60, "Paused - press P")
	ElseIf state = STATE_OVER
		Color winner\r, winner\g, winner\b
		If twoPlayers
			If winner = leftPaddle
				CenterText(SCREEN_H / 2 - 60, "Left player wins!")
			Else
				CenterText(SCREEN_H / 2 - 60, "Right player wins!")
			EndIf
		Else
			If winner = leftPaddle
				CenterText(SCREEN_H / 2 - 60, "You win!")
			Else
				CenterText(SCREEN_H / 2 - 60, "The computer wins.")
			EndIf
		EndIf
		Color 200, 200, 220
		CenterText(SCREEN_H / 2 + 50, "Press Space")
	EndIf
	If state = STATE_PLAY And rallyHits >= 10
		Color 255, 230, 120
		CenterText(COURT_BOTTOM - 30, "Rally of " + rallyHits + "!")
	EndIf
End Function

Function DrawCourt(withNet)
	Color 60, 60, 100
	Rect 0, COURT_TOP - 6, SCREEN_W, 6, 1
	Rect 0, COURT_BOTTOM, SCREEN_W, 6, 1
	If Not withNet Then Return
	Local y%
	For y = COURT_TOP + 8 To COURT_BOTTOM - 16 Step 24
		Rect SCREEN_W / 2 - 2, y, 4, 12, 1
	Next
End Function

Function DrawPaddle(p.Paddle)
	; A darker outline and a bright core make the paddle look lit.
	Color p\r / 3, p\g / 3, p\b / 3
	Rect Int(p\x - 2), Int(p\y - 2), PADDLE_W + 4, PADDLE_H + 4, 1
	Color p\r, p\g, p\b
	Rect Int(p\x), Int(p\y), PADDLE_W, PADDLE_H, 1
	Color 255, 255, 255
	Rect Int(p\x + PADDLE_W / 2 - 1), Int(p\y + 6), 2, PADDLE_H - 12, 1
End Function

Function DrawBall()
	; The trail fades out from the ball, older positions are darker and smaller.
	Local i%
	For i = TRAIL_LENGTH - 1 To 0 Step -1
		Local f# = 1.0 - Float(i + 1) / (TRAIL_LENGTH + 1)
		Local size = Int(BALL_SIZE * (0.3 + 0.7 * f))
		Color Int(255 * f * 0.8), Int(230 * f * 0.8), Int(160 * f * 0.8)
		Oval Int(trailX(i) + (BALL_SIZE - size) / 2), Int(trailY(i) + (BALL_SIZE - size) / 2), size, size, 1
	Next
	Color 255, 250, 220
	Oval Int(ballX), Int(ballY), BALL_SIZE, BALL_SIZE, 1
End Function

Function DrawSparks()
	Local s.Spark
	For s.Spark = Each Spark
		Color Int(s\r * s\life), Int(s\g * s\life), Int(s\b * s\life)
		Rect Int(s\x), Int(s\y), 3, 3, 1
	Next
End Function

Function DrawTitle()
	; A ball drifts around behind the title.
	Color 255, 250, 220
	Local t# = MilliSecs() / 10.0
	Local x# = SCREEN_W / 2 + Sin(t) * 300
	Local y# = SCREEN_H / 2 + 200 + Sin(t * 2.3) * 40
	Oval Int(x - BALL_SIZE / 2), Int(y - BALL_SIZE / 2), BALL_SIZE, BALL_SIZE, 1

	Color 255, 200, 90
	DrawWord("RALLY", SCREEN_W / 2 - 119, 110, 10) ; Five letters, 52 pixels apart and 30 wide: 238 pixels in all.
	Color 120, 120, 150
	CenterText(SCREEN_H - 50, "A BlitzLLVM sample game")

	Select state
		Case STATE_MENU
			DrawMenu()
			Color 120, 120, 150
			CenterText(450, "Up / Down or the mouse to choose, Enter or a click to select.")
		Case STATE_OPTIONS
			DrawMenu()
			Color 120, 120, 150
			CenterText(450, "Left / Right or a click change the option, Escape goes back.")
		Case STATE_HELP
			Color 200, 200, 220
			CenterText(250, "Hit the ball past the other paddle to score.")
			CenterText(275, "First to " + pointsToWin(optPoints) + " points wins the match.")
			CenterText(310, "Hit the ball with the end of the paddle to send it off at a steep angle,")
			CenterText(330, "or move the paddle while it hits to add spin.")
			CenterText(365, "Left paddle: the mouse, or W and S.   Right paddle: Up and Down.")
			CenterText(385, "P pauses, Escape goes back to the menu.")
			Color 120, 120, 150
			CenterText(450, "Press Enter or click to go back.")
	End Select
End Function

Function CenterText(y, message$)
	Text SCREEN_W / 2, y, message, True, False
End Function

; --- Block font ------------------------------------------------------------------------------------------------------
; Big letters and digits drawn from a 3x5 grid of blocks. Each character is 15 bits, one per block, row by row from
; the top left. A 1 bit draws a block.

Function DrawNumber(n, x, y, blockSize)
	Local digits$ = Str(n)
	Local i%
	For i = 1 To Len(digits)
		DrawGlyph(GlyphBits(Mid(digits, i, 1)), x + (i - 1) * blockSize * 4, y, blockSize)
	Next
End Function

Function DrawWord(word$, x, y, blockSize)
	Local i%
	For i = 1 To Len(word)
		DrawGlyph(GlyphBits(Mid(word, i, 1)), Int(x + (i - 1) * blockSize * 5.2), y, blockSize)
	Next
End Function

Function DrawGlyph(bits, x, y, blockSize)
	Local row%
	Local column%
	For row = 0 To 4
		For column = 0 To 2
			If bits And (1 Shl (14 - (row * 3 + column)))
				Rect x + column * blockSize, y + row * blockSize, blockSize - 1, blockSize - 1, 1
			EndIf
		Next
	Next
End Function

Function GlyphBits(c$)
	Select c
		Case "0" : Return %111101101101111
		Case "1" : Return %010110010010111
		Case "2" : Return %111001111100111
		Case "3" : Return %111001111001111
		Case "4" : Return %101101111001001
		Case "5" : Return %111100111001111
		Case "6" : Return %111100111101111
		Case "7" : Return %111001010010010
		Case "8" : Return %111101111101111
		Case "9" : Return %111101111001111
		Case "R" : Return %110101110101101
		Case "A" : Return %010101111101101
		Case "L" : Return %100100100100111
		Case "Y" : Return %101101010010010
	End Select
	Return 0
End Function

; --- Watermark -------------------------------------------------------------------------------------------------------
; Every frame carries a faint pattern that nobody can see: some background pixels are one step bluer than the rest.
; A program can find the pattern again in a screenshot, which shows that the picture came from this sample game.
; The pattern is drawn as a masked image just after Cls, so everything else is drawn over it.

Global watermark, watermarkColor ; DrawWatermark makes the image the first time it is needed.

Function DrawWatermark(r, g, b)
	Local rgb = (r Shl 16) Or (g Shl 8) Or b
	If watermark = 0 Or rgb <> watermarkColor
		If watermark <> 0 Then FreeImage watermark
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		watermarkColor = rgb
		Local marked = b + 1
		If b = 255 Then marked = 254
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				; Black is the mask colour, so only the marked pixels are drawn.
				If (x * 7 + y * 13) Mod 29 < 3
					WritePixelFast x, y, (r Shl 16) Or (g Shl 8) Or marked, buffer
				Else
					WritePixelFast x, y, 0, buffer
				EndIf
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function

; --- Helpers ---------------------------------------------------------------------------------------------------------

Function Clamp#(value#, low#, high#)
	If value < low Then Return low
	If value > high Then Return high
	Return value
End Function

; Makes a short sound effect without any sound file: it writes a WAV file into a bank, saves it to the temporary
; folder, loads it and deletes the file again. The pitch slides from startHz to endHz.
Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0
	Local i%
	For i = 0 To samples - 1
		Local t# = Float(i) / samples
		Local hz# = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Local v#
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1
			Case WAVE_SINE
				v = Sin(phase)
			Default
				v = Rnd(-1, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		Local envelope# = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.6 Then envelope = envelope * (1.0 - t) / 0.4
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "rally-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i%
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function
