; Rally: a two-paddle ball game for one or two players.
;
; Every picture and sound in this game is made by the code itself, so there are no files to ship with it.
;
; Controls:
;   Title screen:  1 = play against the computer, 2 = two players, Left/Right = computer skill, Escape = quit
;   Left paddle:   W and S
;   Right paddle:  Up and Down (two players only)
;   P pauses, Escape goes back to the title screen.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Const SCREEN_W = 800, SCREEN_H = 600
Const COURT_TOP = 60, COURT_BOTTOM = 580
Const PADDLE_W = 12, PADDLE_H = 84, PADDLE_SPEED# = 7.0, PADDLE_MARGIN = 32
Const BALL_SIZE = 12, BALL_START_SPEED# = 6.0, BALL_MAX_SPEED# = 15.0, BALL_SPEEDUP# = 0.45
Const WINNING_SCORE = 7
Const TRAIL_LENGTH = 14

; The states the game can be in. The main loop asks the current state what to do.
Const STATE_TITLE = 0, STATE_SERVE = 1, STATE_PLAY = 2, STATE_PAUSED = 3, STATE_OVER = 4

; Scan codes of the keys we use.
Const KEY_ESCAPE = 1, KEY_1 = 2, KEY_2 = 3, KEY_W = 17, KEY_P = 25, KEY_S = 31, KEY_SPACE = 57
Const KEY_UP = 200, KEY_DOWN = 208, KEY_LEFT = 203, KEY_RIGHT = 205

Type Paddle
	Field x#, y#        ; Top left corner.
	Field speed#        ; How far it moved this frame, which puts spin on the ball.
	Field score
	Field computer      ; True if the computer plays this paddle.
	Field r, g, b
End Type

Type Spark
	Field x#, y#, vx#, vy#
	Field life#
	Field r, g, b
End Type

Global state = STATE_TITLE
Global twoPlayers = False
Global skill = 2 ; 1 to 3: how well the computer plays.
Global serveTimer = 0, serveDirection = 1
Global shake# = 0
Global flashTimer = 0
Global winner.Paddle

Global ballX#, ballY#, ballVX#, ballVY#, ballSpeed#, rallyHits
Dim trailX#(TRAIL_LENGTH - 1), trailY#(TRAIL_LENGTH - 1)

Global leftPaddle.Paddle = New Paddle
leftPaddle\x = Float(PADDLE_MARGIN)
leftPaddle\r = 90 : leftPaddle\g = 200 : leftPaddle\b = 255
Global rightPaddle.Paddle = New Paddle
rightPaddle\x = Float(SCREEN_W - PADDLE_MARGIN - PADDLE_W)
rightPaddle\r = 255 : rightPaddle\g = 140 : rightPaddle\b = 80

Graphics SCREEN_W, SCREEN_H, 0, 2
AppTitle "Rally"
SetBuffer BackBuffer()
SeedRnd MilliSecs()

; --- Sounds ----------------------------------------------------------------------------------------------------------
Const WAVE_SQUARE = 0, WAVE_SINE = 1, WAVE_NOISE = 2
Global soundPaddle = MakeSound(440, 880, 60, WAVE_SQUARE, 0.25)
Global soundWall = MakeSound(330, 330, 40, WAVE_SQUARE, 0.2)
Global soundScore = MakeSound(660, 165, 420, WAVE_SINE, 0.4)
Global soundServe = MakeSound(520, 780, 90, WAVE_SINE, 0.3)
Global soundWin = MakeSound(262, 1046, 900, WAVE_SQUARE, 0.25)
Global soundSelect = MakeSound(700, 700, 50, WAVE_SQUARE, 0.2)

; A timer keeps the game at 60 updates per second on every computer.
Local timer = CreateTimer(60)

Local quit = False
While Not quit
	WaitTimer timer
	Select state
		Case STATE_TITLE
			UpdateTitle()
		Case STATE_SERVE
			UpdatePaddles()
			UpdateServe()
		Case STATE_PLAY
			UpdatePaddles()
			UpdateBall()
		Case STATE_PAUSED
			If KeyHit(KEY_P) Then state = STATE_PLAY
		Case STATE_OVER
			If KeyHit(KEY_SPACE) Then state = STATE_TITLE : PlaySound soundSelect
	End Select

	If state <> STATE_TITLE
		If KeyHit(KEY_ESCAPE) Then state = STATE_TITLE : PlaySound soundSelect
		If state = STATE_PLAY And KeyHit(KEY_P) Then state = STATE_PAUSED
	Else
		If KeyHit(KEY_ESCAPE) Then quit = True
	EndIf

	UpdateSparks()
	DrawGame()
	Flip 0 ; The timer already paces the game, so Flip does not have to wait as well.
Wend

End

; --- Game flow -------------------------------------------------------------------------------------------------------

Function UpdateTitle()
	If KeyHit(KEY_LEFT) And skill > 1 Then skill = skill - 1 : PlaySound soundSelect
	If KeyHit(KEY_RIGHT) And skill < 3 Then skill = skill + 1 : PlaySound soundSelect
	If KeyHit(KEY_1) Then StartMatch(False)
	If KeyHit(KEY_2) Then StartMatch(True)
End Function

Function StartMatch(players2)
	twoPlayers = players2
	leftPaddle\score = 0
	rightPaddle\score = 0
	leftPaddle\computer = False
	rightPaddle\computer = Not twoPlayers
	leftPaddle\y = Float((COURT_TOP + COURT_BOTTOM - PADDLE_H) / 2)
	rightPaddle\y = leftPaddle\y
	FlushKeys
	serveDirection = 1 - 2 * Rand(0, 1) ; Either 1 or -1.
	PrepareServe()
	PlaySound soundSelect
End Function

; Puts the ball in the middle and waits a moment before it starts moving.
Function PrepareServe()
	ballX = Float((SCREEN_W - BALL_SIZE) / 2)
	ballY = Float((COURT_TOP + COURT_BOTTOM - BALL_SIZE) / 2)
	ballVX = 0 : ballVY = 0
	ResetTrail()
	serveTimer = 60
	rallyHits = 0
	state = STATE_SERVE
End Function

Function UpdateServe()
	serveTimer = serveTimer - 1
	If serveTimer > 0 Then Return

	; Serve at a random angle of up to 30 degrees, towards the player who lost the last point.
	Local angle# = Rnd(-30.0, 30)
	ballSpeed = BALL_START_SPEED
	ballVX = Cos(angle) * ballSpeed * serveDirection
	ballVY = Sin(angle) * ballSpeed
	PlaySound soundServe
	state = STATE_PLAY
End Function

Function ScorePoint(scorer.Paddle)
	scorer\score = scorer\score + 1
	shake = 12
	flashTimer = 10
	BurstSparks(ballX + BALL_SIZE / 2, ballY + BALL_SIZE / 2, 60, scorer\r, scorer\g, scorer\b)
	If scorer = leftPaddle Then serveDirection = 1 Else serveDirection = -1

	If scorer\score >= WINNING_SCORE
		winner = scorer
		state = STATE_OVER
		PlaySound soundWin
	Else
		PlaySound soundScore
		PrepareServe()
	EndIf
End Function

; --- Paddles ---------------------------------------------------------------------------------------------------------

Function UpdatePaddles()
	Local oldY#

	oldY = leftPaddle\y
	leftPaddle\y = leftPaddle\y + (KeyDown(KEY_S) - KeyDown(KEY_W)) * PADDLE_SPEED
	leftPaddle\y = Clamp(leftPaddle\y, Float(COURT_TOP), Float(COURT_BOTTOM - PADDLE_H))
	leftPaddle\speed = leftPaddle\y - oldY

	oldY = rightPaddle\y
	If rightPaddle\computer
		ComputerMove(rightPaddle)
	Else
		rightPaddle\y = rightPaddle\y + (KeyDown(KEY_DOWN) - KeyDown(KEY_UP)) * PADDLE_SPEED
	EndIf
	rightPaddle\y = Clamp(rightPaddle\y, Float(COURT_TOP), Float(COURT_BOTTOM - PADDLE_H))
	rightPaddle\speed = rightPaddle\y - oldY
End Function

; The computer guesses where the ball will cross its side, bounces included, and moves there. Lower skill makes
; it slower, makes it react later and adds an error to its guess.
Function ComputerMove(p.Paddle)
	Local targetY# = Float((COURT_TOP + COURT_BOTTOM - PADDLE_H) / 2) ; Wait in the middle by default.
	Local maxSpeed# = PADDLE_SPEED * (0.45 + 0.2 * skill)

	Local towards = (ballVX > 0 And p\x > ballX) Or (ballVX < 0 And p\x < ballX)
	Local reactDistance# = SCREEN_W * (0.35 + 0.2 * skill)
	If towards And Abs(p\x - ballX) < reactDistance
		; Follow the ball's path forward, folding it back at the walls like the ball itself will.
		Local frames# = Abs((p\x - ballX) / ballVX)
		Local height# = Float(COURT_BOTTOM - COURT_TOP - BALL_SIZE)
		Local y# = (ballY - COURT_TOP) + ballVY * frames
		y = y - Floor(y / (2 * height)) * (2 * height)
		If y > height Then y = 2 * height - y
		Local wobble# = (3 - skill) * 18 * Sin(MilliSecs() / 7.0)
		targetY = COURT_TOP + y + BALL_SIZE / 2 - PADDLE_H / 2 + wobble
	EndIf

	Local diff# = targetY - p\y
	If Abs(diff) > maxSpeed Then diff = Sgn(diff) * maxSpeed
	p\y = p\y + diff
End Function

; --- Ball ------------------------------------------------------------------------------------------------------------

Function UpdateBall()
	; Remember where the ball was, for the trail behind it.
	Local i%
	For i = TRAIL_LENGTH - 1 To 1 Step -1
		trailX(i) = trailX(i - 1)
		trailY(i) = trailY(i - 1)
	Next
	trailX(0) = ballX : trailY(0) = ballY

	; Fast balls could jump through a paddle in one step, so move in small steps and check each one.
	Local steps = Int(Ceil(ballSpeed / 4))
	Local s%
	For s = 1 To steps
		ballX = ballX + ballVX / steps
		ballY = ballY + ballVY / steps

		; Top and bottom walls.
		If ballY < COURT_TOP
			ballY = Float(COURT_TOP)
			ballVY = Abs(ballVY)
			PlaySound soundWall
		ElseIf ballY > COURT_BOTTOM - BALL_SIZE
			ballY = Float(COURT_BOTTOM - BALL_SIZE)
			ballVY = -Abs(ballVY)
			PlaySound soundWall
		EndIf

		If ballVX < 0 Then CheckPaddleHit(leftPaddle, 1)
		If ballVX > 0 Then CheckPaddleHit(rightPaddle, -1)

		; Past a paddle: the other side scores.
		If ballX < -BALL_SIZE
			ScorePoint(rightPaddle)
			Return
		ElseIf ballX > SCREEN_W
			ScorePoint(leftPaddle)
			Return
		EndIf
	Next
End Function

; direction is the way the ball should travel after hitting this paddle: 1 for right, -1 for left.
Function CheckPaddleHit(p.Paddle, direction)
	; RectsOverlap is built in: it tells whether two rectangles touch.
	If Not RectsOverlap(Int(ballX), Int(ballY), BALL_SIZE, BALL_SIZE, Int(p\x), Int(p\y), PADDLE_W, PADDLE_H) Then Return

	; Where on the paddle did it hit? -1 is the top end, 0 the middle, 1 the bottom end. Hits near the ends send the
	; ball away at a steep angle, which is how players aim.
	Local offset# = ((ballY + BALL_SIZE / 2) - (p\y + PADDLE_H / 2)) / (PADDLE_H / 2)
	offset = Clamp(offset, -1.0, 1)
	Local angle# = offset * 55 + p\speed * 2.5 ; A moving paddle adds spin.
	angle = Clamp(angle, -60.0, 60)

	rallyHits = rallyHits + 1
	ballSpeed = ballSpeed + BALL_SPEEDUP
	If ballSpeed > BALL_MAX_SPEED Then ballSpeed = BALL_MAX_SPEED
	ballVX = Cos(angle) * ballSpeed * direction
	ballVY = Sin(angle) * ballSpeed

	; Put the ball just outside the paddle so it cannot hit it twice.
	If direction = 1 Then ballX = p\x + PADDLE_W Else ballX = p\x - BALL_SIZE

	shake = 2 + ballSpeed / 4
	BurstSparks(ballX + BALL_SIZE / 2, ballY + BALL_SIZE / 2, 14, p\r, p\g, p\b)
	PlaySound soundPaddle
End Function

Function ResetTrail()
	Local i%
	For i = 0 To TRAIL_LENGTH - 1
		trailX(i) = ballX : trailY(i) = ballY
	Next
End Function

; --- Sparks ----------------------------------------------------------------------------------------------------------

Function BurstSparks(x#, y#, count, r, g, b)
	Local i%
	For i = 1 To count
		Local s.Spark = New Spark
		Local angle# = Rnd(360)
		Local speed# = Rnd(1, 6)
		s\x = x : s\y = y
		s\vx = Cos(angle) * speed
		s\vy = Sin(angle) * speed
		s\life = Rnd(0.6, 1.0)
		s\r = r : s\g = g : s\b = b
	Next
End Function

Function UpdateSparks()
	Local s.Spark
	For s.Spark = Each Spark
		s\x = s\x + s\vx
		s\y = s\y + s\vy
		s\vx = s\vx * 0.94
		s\vy = s\vy * 0.94
		s\life = s\life - 0.025
		If s\life <= 0 Then Delete s
	Next
	If shake > 0 Then shake = shake * 0.85 - 0.1
	If flashTimer > 0 Then flashTimer = flashTimer - 1
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	; Shake everything by moving the drawing origin a little.
	Local ox = 0, oy = 0
	If shake > 0 Then ox = Rand(Int(-shake), Int(shake)) : oy = Rand(Int(-shake), Int(shake))
	Origin ox, oy

	; Background, brighter for a moment after a point.
	If flashTimer > 0 Then ClsColor 40 + flashTimer * 4, 30, 60 Else ClsColor 14, 12, 28
	Cls

	DrawCourt()

	If state = STATE_TITLE
		DrawTitle()
		Origin 0, 0
		Return
	EndIf

	DrawPaddle(leftPaddle)
	DrawPaddle(rightPaddle)
	DrawBall()
	DrawSparks()

	; Scores in big digits, built from rectangles.
	Color leftPaddle\r, leftPaddle\g, leftPaddle\b
	DrawNumber(leftPaddle\score, SCREEN_W / 2 - 90, 8, 6)
	Color rightPaddle\r, rightPaddle\g, rightPaddle\b
	DrawNumber(rightPaddle\score, SCREEN_W / 2 + 60, 8, 6)

	Origin 0, 0
	Color 200, 200, 220
	If state = STATE_SERVE
		If rallyHits = 0 And leftPaddle\score + rightPaddle\score = 0 Then CenterText(SCREEN_H / 2 - 60, "Get ready")
	ElseIf state = STATE_PAUSED
		CenterText(SCREEN_H / 2 - 60, "Paused - press P")
	ElseIf state = STATE_OVER
		Color winner\r, winner\g, winner\b
		If twoPlayers
			If winner = leftPaddle
				CenterText(SCREEN_H / 2 - 60, "Left player wins!")
			Else
				CenterText(SCREEN_H / 2 - 60, "Right player wins!")
			EndIf
		Else
			If winner = leftPaddle
				CenterText(SCREEN_H / 2 - 60, "You win!")
			Else
				CenterText(SCREEN_H / 2 - 60, "The computer wins.")
			EndIf
		EndIf
		Color 200, 200, 220
		CenterText(SCREEN_H / 2 + 50, "Press Space")
	EndIf
	If state = STATE_PLAY And rallyHits >= 10
		Color 255, 230, 120
		CenterText(COURT_BOTTOM - 30, "Rally of " + rallyHits + "!")
	EndIf
End Function

Function DrawCourt()
	Color 60, 60, 100
	Rect 0, COURT_TOP - 6, SCREEN_W, 6, 1
	Rect 0, COURT_BOTTOM, SCREEN_W, 6, 1
	Local y%
	For y = COURT_TOP + 8 To COURT_BOTTOM - 16 Step 24
		Rect SCREEN_W / 2 - 2, y, 4, 12, 1
	Next
End Function

Function DrawPaddle(p.Paddle)
	; A darker outline and a bright core make the paddle look lit.
	Color p\r / 3, p\g / 3, p\b / 3
	Rect Int(p\x - 2), Int(p\y - 2), PADDLE_W + 4, PADDLE_H + 4, 1
	Color p\r, p\g, p\b
	Rect Int(p\x), Int(p\y), PADDLE_W, PADDLE_H, 1
	Color 255, 255, 255
	Rect Int(p\x + PADDLE_W / 2 - 1), Int(p\y + 6), 2, PADDLE_H - 12, 1
End Function

Function DrawBall()
	; The trail fades out from the ball, older positions are darker and smaller.
	Local i%
	For i = TRAIL_LENGTH - 1 To 0 Step -1
		Local f# = 1.0 - Float(i + 1) / (TRAIL_LENGTH + 1)
		Local size = Int(BALL_SIZE * (0.3 + 0.7 * f))
		Color Int(255 * f * 0.8), Int(230 * f * 0.8), Int(160 * f * 0.8)
		Oval Int(trailX(i) + (BALL_SIZE - size) / 2), Int(trailY(i) + (BALL_SIZE - size) / 2), size, size, 1
	Next
	Color 255, 250, 220
	Oval Int(ballX), Int(ballY), BALL_SIZE, BALL_SIZE, 1
End Function

Function DrawSparks()
	Local s.Spark
	For s.Spark = Each Spark
		Color Int(s\r * s\life), Int(s\g * s\life), Int(s\b * s\life)
		Rect Int(s\x), Int(s\y), 3, 3, 1
	Next
End Function

Function DrawTitle()
	; A ball drifts around behind the title.
	Color 255, 250, 220
	Local t# = MilliSecs() / 10.0
	Local x# = SCREEN_W / 2 + Sin(t) * 300
	Local y# = SCREEN_H / 2 + 120 + Sin(t * 2.3) * 60
	Oval Int(x - BALL_SIZE / 2), Int(y - BALL_SIZE / 2), BALL_SIZE, BALL_SIZE, 1

	Color 255, 200, 90
	DrawWord("RALLY", SCREEN_W / 2 - 119, 130, 10) ; Five letters, 52 pixels apart and 30 wide: 238 pixels in all.

	Color 200, 200, 220
	CenterText(300, "1 - Play against the computer")
	CenterText(325, "2 - Two players")
	Local skillName$
	Select skill
		Case 1 : skillName = "Relaxed"
		Case 2 : skillName = "Fair"
		Case 3 : skillName = "Sharp"
	End Select
	CenterText(365, "< Computer skill: " + skillName + " >")
	Color 120, 120, 150
	CenterText(420, "Left: W / S     Right: Up / Down     P: pause     Esc: back")
	CenterText(440, "First to " + WINNING_SCORE + " points wins.")
End Function

Function CenterText(y, message$)
	Text SCREEN_W / 2, y, message, True, False
End Function

; --- Block font ------------------------------------------------------------------------------------------------------
; Big letters and digits drawn from a 3x5 grid of blocks. Each character is 15 bits, one per block, row by row from
; the top left. A 1 bit draws a block.

Function DrawNumber(n, x, y, blockSize)
	Local digits$ = Str(n)
	Local i%
	For i = 1 To Len(digits)
		DrawGlyph(GlyphBits(Mid(digits, i, 1)), x + (i - 1) * blockSize * 4, y, blockSize)
	Next
End Function

Function DrawWord(word$, x, y, blockSize)
	Local i%
	For i = 1 To Len(word)
		DrawGlyph(GlyphBits(Mid(word, i, 1)), Int(x + (i - 1) * blockSize * 5.2), y, blockSize)
	Next
End Function

Function DrawGlyph(bits, x, y, blockSize)
	Local row%
	Local column%
	For row = 0 To 4
		For column = 0 To 2
			If bits And (1 Shl (14 - (row * 3 + column)))
				Rect x + column * blockSize, y + row * blockSize, blockSize - 1, blockSize - 1, 1
			EndIf
		Next
	Next
End Function

Function GlyphBits(c$)
	Select c
		Case "0" : Return %111101101101111
		Case "1" : Return %010110010010111
		Case "2" : Return %111001111100111
		Case "3" : Return %111001111001111
		Case "4" : Return %101101111001001
		Case "5" : Return %111100111001111
		Case "6" : Return %111100111101111
		Case "7" : Return %111001010010010
		Case "8" : Return %111101111101111
		Case "9" : Return %111101111001111
		Case "R" : Return %110101110101101
		Case "A" : Return %010101111101101
		Case "L" : Return %100100100100111
		Case "Y" : Return %101101010010010
	End Select
	Return 0
End Function

; --- Helpers ---------------------------------------------------------------------------------------------------------

Function Clamp#(value#, low#, high#)
	If value < low Then Return low
	If value > high Then Return high
	Return value
End Function

; Makes a short sound effect without any sound file: it writes a WAV file into a bank, saves it to the temporary
; folder, loads it and deletes the file again. The pitch slides from startHz to endHz.
Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0
	Local i%
	For i = 0 To samples - 1
		Local t# = Float(i) / samples
		Local hz# = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Local v#
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1.0
			Case WAVE_SINE
				v = Sin(phase)
			Default
				v = Rnd(-1.0, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		Local envelope# = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.6 Then envelope = envelope * (1.0 - t) / 0.4
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "rally-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i%
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function
