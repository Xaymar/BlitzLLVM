; Panewalk: a puzzle game where the windows on the desktop are the level.
;
; Pip lives inside the windows of this game, and the windows are rooms. Where two rooms overlap, Pip can walk from one
; into the other. Everywhere else the edges of a room are walls. Move and resize the rooms with the mouse, the way any
; window is moved, to build a way from the start to the door.
;
;   Grey rooms have no title bar and stay where they are.
;   Blue rooms can be dragged by their title bar or from anywhere inside, and carry Pip along when Pip is in them.
;   Green rooms can also be resized, by an edge or the grip in their corner, between a smallest and a largest size.
;   Red windows are the void: Pip must never touch them.
;
; This is a BlitzPlus program: it opens no Graphics window. Every room is a window of the computer with a canvas in
; it, and every canvas shows its part of one world that is laid out over the whole desktop. Every picture and sound in
; the game is made by the code itself, so there are no files to ship with it.
;
; Controls (in the Panewalk window):
;   The mouse clicks the buttons. Up/Down choose, Enter/Space select, Left/Right change an option.
;   Space starts Pip, or pauses and resumes. R restarts the level, H shows or hides the hint, Escape goes to the menu.
;
; The options and the progress are saved in panewalk.cfg next to the program.

Const EVENT_KEY_DOWN = $101, EVENT_MOUSE_DOWN = $201, EVENT_MOUSE_UP = $202, EVENT_MOUSE_MOVE = $203
Const EVENT_WINDOW_CLOSE = $803, EVENT_TIMER = $4001

; Scan codes of the keys we use.
Const KEY_ESCAPE = 1, KEY_R = 19, KEY_P = 25, KEY_H = 35, KEY_ENTER = 28, KEY_SPACE = 57
Const KEY_UP = 200, KEY_DOWN = 208, KEY_LEFT = 203, KEY_RIGHT = 205

; The levels are laid out on a board of this size, in the middle of the desktop. The Panewalk window sits in its top
; left corner while a level is played, so no room starts there.
Const BOARD_W = 1000, BOARD_H = 640
Const PANEL_SMALL_W = 380, PANEL_SMALL_H = 150
Const PANEL_BIG_W = 520, PANEL_BIG_H = 420

; Pip: a box of PIP_W by PIP_H pixels, standing on its feet. Pip climbs steps up to STEP_UP pixels high.
Const PIP_W = 12, PIP_H = 18, STEP_UP = 8
Const GRAVITY# = 0.35, FALL_MAX# = 8.0, SPRING_SPEED# = 12.0

Const LEVEL_COUNT = 8

Const ROOM_FIXED = 0, ROOM_FREE = 1, ROOM_STRETCH = 2, ROOM_VOID = 3
Const THING_BLOCK = 0, THING_SPIKES = 1, THING_SPRING = 2, THING_KEY = 3, THING_LOCK = 4, THING_EXIT = 5
Const THING_START = 6

; What the Panewalk window shows.
Const STATE_MENU = 0, STATE_LEVELS = 1, STATE_OPTIONS = 2, STATE_HELP = 3, STATE_PLAY = 4

; What Pip is doing.
Const PIP_WAITING = 0, PIP_WALKING = 1, PIP_LOST = 2, PIP_HOME = 3

; The buttons of the Panewalk window.
Const BUTTON_PLAY = 1, BUTTON_LEVELS = 2, BUTTON_OPTIONS = 3, BUTTON_HELP = 4, BUTTON_QUIT = 5, BUTTON_BACK = 6
Const BUTTON_SPEED = 10, BUTTON_VOLUME = 11, BUTTON_HINTS = 12, BUTTON_GUIDES = 13
Const BUTTON_GO = 20, BUTTON_RESTART = 21, BUTTON_MENU = 22, BUTTON_NEXT = 23
Const BUTTON_LEVEL = 100 ; BUTTON_LEVEL + n is the button of level n.

; The colour of the sky inside the rooms, which the watermark is hidden in.
Const SKY_R = 30, SKY_G = 38, SKY_B = 62
; The background of the Panewalk window, which has a watermark of its own.
Const PANEL_R = 24, PANEL_G = 26, PANEL_B = 40

Type Room
	Field win, canvas
	Field kind
	Field title$
	Field x, y, w, h             ; Where the inside of the window is on the desktop, as it is now.
	Field homeX, homeY, homeW, homeH ; Where it was put when the level started.
	Field lastX, lastY           ; Where it was one tick ago, to see how far it moved.
	Field minW, minH, maxW, maxH ; The sizes a green room may have.
End Type

Type Thing
	Field room.Room
	Field kind
	Field x, y, w, h ; Inside its room. A width or height of 0 or less reaches to the far side of the room.
	Field taken      ; A key that Pip has picked up.
End Type

; --- Options and progress ----------------------------------------------------------------------------------------
Global optSpeed = 1     ; 0 slow, 1 normal, 2 fast.
Global optVolume = 4    ; 0 to 4, in quarters.
Global optHints = True  ; Show the hint of each level.
Global optGuides = True ; Mark the edges of a room where Pip can walk into another one.
Global unlocked = 1     ; How many levels can be chosen.
Dim bestTicks(LEVEL_COUNT) ; The best time of each level in ticks, 0 for none yet.
Dim speedName$(2)
speedName(0) = "Slow" : speedName(1) = "Normal" : speedName(2) = "Fast"
Dim speedValue#(2)
speedValue(0) = 1.0 : speedValue(1) = 1.5 : speedValue(2) = 2.2

Global settingsPath$ = SystemProperty$("appdir")
If settingsPath <> "" And Right(settingsPath, 1) <> "\" And Right(settingsPath, 1) <> "/" Then settingsPath = settingsPath + "/"
settingsPath = settingsPath + "panewalk.cfg"
LoadSettings()

; --- The board and the Panewalk window ---------------------------------------------------------------------------
Global desktopW = ClientWidth(Desktop()), desktopH = ClientHeight(Desktop())
Global boardX = Max((desktopW - BOARD_W) / 2, 0), boardY = Max((desktopH - BOARD_H) / 2, 0)

AppTitle "Panewalk"
Global panel = CreateWindow("Panewalk", (desktopW - PANEL_BIG_W) / 2, (desktopH - PANEL_BIG_H) / 2, PANEL_BIG_W, PANEL_BIG_H, Desktop(), 1)
If panel = 0
	Notify "Panewalk needs windows of its own, and none could be made here.", True
	End
EndIf
Global screen = CreateCanvas(0, 0, ClientWidth(panel), ClientHeight(panel), panel)
SetGadgetLayout screen, 1, 1, 1, 1
ActivateGadget screen

; --- Game --------------------------------------------------------------------------------------------------------
Global state = STATE_MENU
Global level = 1, levelName$, levelHint$
Global pipState, pipX, pipY, pipVY#, pipDir, pipStep#, pipOnGround, pipAnim, pipFloat
Global paused = False, ticks, lostTimer, lostReason$
Global keysTotal, keysTaken
Global startRoom.Room, startX, startY ; Where Pip starts, inside its room.
Global newBest ; The level was done faster than ever before.
Global showHint = True
Global frame ; Counts every tick, for things that bob and blink.

; A room that is dragged from inside: where in its canvas it was grabbed, and whether its corner grip was grabbed.
Global dragRoom.Room, grabX, grabY, grabResize
Const GRIP_SIZE = 18 ; The grip of a green room, in its bottom right corner.

; The buttons of what the Panewalk window shows.
Dim buttonX(15), buttonY(15), buttonW(15), buttonH(15), buttonId(15), buttonText$(15)
Global buttonCount, buttonSelected = -1, buttonHover = -1

Global watermark = MakeWatermark(SKY_R, SKY_G, SKY_B)
Global panelWatermark = MakeWatermark(PANEL_R, PANEL_G, PANEL_B)
Global titleImage = MakeBigText("Panewalk", 6)

; --- Sounds ------------------------------------------------------------------------------------------------------
Const WAVE_SQUARE = 0, WAVE_SINE = 1, WAVE_NOISE = 2
Global soundClick = MakeSound(700, 700, 40, WAVE_SQUARE, 0.15)
Global soundGo = MakeSound(400, 800, 140, WAVE_SINE, 0.3)
Global soundKey = MakeSound(900, 1500, 160, WAVE_SINE, 0.3)
Global soundSpring = MakeSound(200, 700, 180, WAVE_SQUARE, 0.2)
Global soundLost = MakeSound(500, 90, 500, WAVE_SQUARE, 0.25)
Global soundHome = MakeSound(523, 1046, 600, WAVE_SINE, 0.35)

GoToMenu()

; A timer moves the game on 60 times a second. Its ticks are events, like everything else in a BlitzPlus program.
Local timer = CreateTimer(60)
Local quit = False
Repeat
	Select WaitEvent()
		Case EVENT_TIMER
			Tick()
		Case EVENT_MOUSE_DOWN
			If EventSource() = screen
				Local hit = ButtonAt(EventX(), EventY())
				If hit >= 0
					buttonSelected = hit
					quit = Press(buttonId(hit), EventData() = 2)
				EndIf
			ElseIf EventData() = 1
				StartDrag(EventSource(), EventX(), EventY())
			EndIf
		Case EVENT_MOUSE_MOVE
			If EventSource() = screen
				buttonHover = ButtonAt(EventX(), EventY())
			ElseIf dragRoom <> Null
				If EventSource() = dragRoom\canvas Then Drag(EventX(), EventY())
			EndIf
		Case EVENT_MOUSE_UP
			dragRoom = Null
		Case EVENT_KEY_DOWN
			quit = KeyDown(EventData())
		Case EVENT_WINDOW_CLOSE
			; The close box of the Panewalk window leaves a level, or the game. The rooms cannot be closed.
			If EventSource() = panel
				If state = STATE_PLAY Then GoToMenu() Else quit = True
			EndIf
	End Select
Until quit

CloseLevel()
SaveSettings()
End

; --- One tick of the game ----------------------------------------------------------------------------------------

Function Tick()
	frame = frame + 1
	If state = STATE_PLAY
		ReadRooms()
		If Not paused
			Select pipState
				Case PIP_WAITING
					CarryPip()
				Case PIP_WALKING
					ticks = ticks + 1
					CarryPip()
					MovePip()
				Case PIP_LOST
					lostTimer = lostTimer - 1
					If lostTimer <= 0 Then ResetPip()
			End Select
		EndIf
		DrawRooms()
	EndIf
	DrawPanel()
End Function

; Reads where every room is now. Grey rooms and the void go back to where they belong if the computer moved them anyway,
; and green rooms are kept between their smallest and largest size.
Function ReadRooms()
	Local r.Room
	For r = Each Room
		r\lastX = r\x : r\lastY = r\y
		r\x = GadgetX(r\win) : r\y = GadgetY(r\win)
		r\w = ClientWidth(r\win) : r\h = ClientHeight(r\win)
		Select r\kind
			Case ROOM_FIXED, ROOM_VOID
				If r\x <> r\homeX Or r\y <> r\homeY Or r\w <> r\homeW Or r\h <> r\homeH
					SetGadgetShape r\win, r\homeX, r\homeY, r\homeW, r\homeH
					r\x = r\homeX : r\y = r\homeY : r\w = r\homeW : r\h = r\homeH
				EndIf
			Case ROOM_FREE
				If r\w <> r\homeW Or r\h <> r\homeH
					SetGadgetShape r\win, r\x, r\y, r\homeW, r\homeH
					r\w = r\homeW : r\h = r\homeH
				EndIf
			Case ROOM_STRETCH
				; A green room stays where it is and only changes its size.
				Local w = Min(Max(r\w, r\minW), r\maxW), h = Min(Max(r\h, r\minH), r\maxH)
				If r\x <> r\homeX Or r\y <> r\homeY Or w <> r\w Or h <> r\h
					SetGadgetShape r\win, r\homeX, r\homeY, w, h
					r\x = r\homeX : r\y = r\homeY : r\w = w : r\h = h
				EndIf
		End Select
		If GadgetWidth(r\canvas) <> r\w Or GadgetHeight(r\canvas) <> r\h Then SetGadgetShape r\canvas, 0, 0, r\w, r\h
	Next
End Function

; --- The world ---------------------------------------------------------------------------------------------------
; The world is everything inside the rooms. A point is space when a room that is not the void holds it, and nothing
; solid is there. Outside of every room is solid, which makes the edges of the rooms walls, except where another room
; goes on.

Function InRoom(x, y)
	Local r.Room
	For r = Each Room
		If r\kind <> ROOM_VOID
			If x >= r\x And x < r\x + r\w And y >= r\y And y < r\y + r\h Then Return True
		EndIf
	Next
	Return False
End Function

Function InVoid(x, y)
	Local r.Room
	For r = Each Room
		If r\kind = ROOM_VOID
			If x >= r\x And x < r\x + r\w And y >= r\y And y < r\y + r\h Then Return True
		EndIf
	Next
	Return False
End Function

; A thing of a room exists only inside that room. True if the point is on the thing.
Function OnThing(t.Thing, x, y)
	Local r.Room = t\room
	If x < r\x Or x >= r\x + r\w Or y < r\y Or y >= r\y + r\h Then Return False
	Local tx = r\x + t\x, ty = r\y + t\y
	Return x >= tx And x < tx + ThingW(t) And y >= ty And y < ty + ThingH(t)
End Function

Function ThingW(t.Thing)
	If t\w <= 0 Then Return t\room\w - t\x
	Return t\w
End Function

Function ThingH(t.Thing)
	If t\h <= 0 Then Return t\room\h - t\y
	Return t\h
End Function

Function Solid(x, y)
	If Not InRoom(x, y) Then Return True
	Local t.Thing
	For t = Each Thing
		If t\kind = THING_BLOCK Or (t\kind = THING_LOCK And keysTaken < keysTotal)
			If OnThing(t, x, y) Then Return True
		EndIf
	Next
	Return False
End Function

; True if Pip fits with the feet at x, y. The box is tested at points a few pixels apart, which is closer than any wall
; is thin.
Function PipFits(x, y)
	Local left = x - PIP_W / 2, right = left + PIP_W - 1, bottom = y - 1, top = y - PIP_H
	Local px, py = top
	Repeat
		px = left
		Repeat
			If Solid(px, py) Then Return False
			If px = right Then Exit
			px = Min(px + 4, right)
		Forever
		If py = bottom Then Exit
		py = Min(py + 6, bottom)
	Forever
	Return True
End Function

; True if any part of Pip touches a thing.
Function PipTouches(t.Thing, shrink)
	Local left = pipX - PIP_W / 2 + shrink, right = pipX + PIP_W / 2 - 1 - shrink
	Local top = pipY - PIP_H + shrink, bottom = pipY - 1
	Local r.Room = t\room
	Local tx = r\x + t\x, ty = r\y + t\y
	; The part of the thing inside its room.
	Local x1 = Max(tx, r\x), y1 = Max(ty, r\y)
	Local x2 = Min(tx + ThingW(t), r\x + r\w) - 1, y2 = Min(ty + ThingH(t), r\y + r\h) - 1
	Return right >= x1 And left <= x2 And bottom >= y1 And top <= y2
End Function

Function PipInVoid()
	Local left = pipX - PIP_W / 2, top = pipY - PIP_H
	Local x, y
	For y = top To top + PIP_H - 1 Step 6
		For x = left To left + PIP_W - 1 Step 4
			If InVoid(x, y) Then Return True
		Next
	Next
	Return InVoid(left + PIP_W - 1, top + PIP_H - 1)
End Function

; --- Pip ---------------------------------------------------------------------------------------------------------

; A room that moves carries Pip along when Pip is inside it. A room that is moved too far in one go may put Pip into a
; wall; Pip then stays where it was.
Function CarryPip()
	Local r.Room, cx = pipX, cy = pipY - PIP_H / 2
	; A grey room holds on to Pip, so a blue room never carries Pip around inside one.
	If InFixedRoom(cx, cy) Then CheckPip() : Return
	For r = Each Room
		If r\kind = ROOM_FREE
			If r\x <> r\lastX Or r\y <> r\lastY
				If cx >= r\lastX And cx < r\lastX + r\w And cy >= r\lastY And cy < r\lastY + r\h
					; A room going up lifts Pip, it does not throw. Pip floats for a moment after that, so a room
					; that is dragged up in small jerks lifts Pip all the way, even where another room is below.
					If r\y < r\lastY Then pipVY = 0 : pipFloat = 12
					CarryPipWith(r)
					Exit
				EndIf
			EndIf
		EndIf
	Next
	CheckPip()
End Function

; Moves the room and Pip back to where they were and then along again a pixel at a time, so a room that is dragged
; fast can not take Pip through a wall or over the void. Pip stays behind at a wall, and is let go as soon as it is
; inside a grey room.
Function CarryPipWith(r.Room)
	Local tx = r\x, ty = r\y, dx = r\x - r\lastX, dy = r\y - r\lastY
	Local steps = Max(Abs(dx), Abs(dy)), i, x0 = pipX, y0 = pipY
	For i = 1 To steps
		r\x = r\lastX + dx * i / steps : r\y = r\lastY + dy * i / steps
		Local nx = x0 + dx * i / steps, ny = y0 + dy * i / steps
		If Not PipFits(nx, ny)
			; Sliding along the wall when only one direction is blocked.
			If PipFits(nx, pipY)
				ny = pipY
			ElseIf PipFits(pipX, ny)
				nx = pipX
			Else
				Exit
			EndIf
		EndIf
		pipX = nx : pipY = ny
		If PipInVoid() Or InFixedRoom(pipX, pipY - PIP_H / 2) Then Exit
	Next
	r\x = tx : r\y = ty
End Function

Function InFixedRoom(x, y)
	Local r.Room
	For r = Each Room
		If r\kind = ROOM_FIXED
			If x >= r\x And x < r\x + r\w And y >= r\y And y < r\y + r\h Then Return True
		EndIf
	Next
	Return False
End Function

Function MovePip()
	Local k, i

	; Falling, a pixel at a time so Pip lands exactly on the floor.
	If pipFloat > 0
		pipFloat = pipFloat - 1
	Else
		pipVY = Min(pipVY + GRAVITY, FALL_MAX)
	EndIf
	Local fall = Abs(Int(pipVY)), dirY = Int(Sgn(pipVY))
	For i = 1 To fall
		If PipFits(pipX, pipY + dirY)
			pipY = pipY + dirY
		Else
			pipVY = 0
			Exit
		EndIf
	Next
	pipOnGround = Not PipFits(pipX, pipY + 1)
	If pipOnGround Then SpringUnderPip()

	; Walking. Pip steps up onto anything low enough, and turns around at walls.
	pipStep = pipStep + speedValue(optSpeed)
	While pipStep >= 1.0
		pipStep = pipStep - 1.0
		pipAnim = pipAnim + 1
		If PipFits(pipX + pipDir, pipY)
			pipX = pipX + pipDir
		Else
			Local climbed = False
			If pipOnGround
				For k = 1 To STEP_UP
					If PipFits(pipX + pipDir, pipY - k)
						pipX = pipX + pipDir
						pipY = pipY - k
						climbed = True
						Exit
					EndIf
				Next
			EndIf
			; On the ground Pip turns around at a wall. In the air Pip keeps pressing against it, so a jump next to a
			; wall goes over its top.
			If (Not climbed) And pipOnGround Then pipDir = -pipDir
		EndIf
	Wend

	CheckPip()
	If pipState <> PIP_WALKING Then Return

	; What Pip touches.
	Local t.Thing
	For t = Each Thing
		Select t\kind
			Case THING_SPIKES
				If PipTouches(t, 2) Then LosePip("Pip stepped on spikes.") : Return
			Case THING_KEY
				If (Not t\taken) And PipTouches(t, 0)
					t\taken = True
					keysTaken = keysTaken + 1
					PlaySfx(soundKey)
				EndIf
			Case THING_EXIT
				If keysTaken >= keysTotal And PipTouches(t, 4) Then PipHome() : Return
		End Select
	Next
End Function

; A spring under Pip's feet throws Pip up.
Function SpringUnderPip()
	Local t.Thing
	For t = Each Thing
		If t\kind = THING_SPRING
			If OnThing(t, pipX, pipY - 1) Or OnThing(t, pipX - 4, pipY - 1) Or OnThing(t, pipX + 4, pipY - 1)
				pipVY = -SPRING_SPEED
				pipOnGround = False
				PlaySfx(soundSpring)
				Return
			EndIf
		EndIf
	Next
End Function

; After the rooms or Pip moved: Pip may have fallen out of every room, touched the void, or be stuck in a wall that
; came along with a room. A small push frees Pip from a wall, a big one is not possible.
Function CheckPip()
	If Not InRoom(pipX, pipY - PIP_H / 2) Then LosePip("Pip fell out of the rooms.") : Return
	If PipInVoid() Then LosePip("Pip touched the void.") : Return
	If PipFits(pipX, pipY) Then Return
	Local d, s
	For d = 1 To 12
		If PipFits(pipX, pipY - d) Then pipY = pipY - d : Return
		For s = -1 To 1 Step 2
			If PipFits(pipX + d * s, pipY) Then pipX = pipX + d * s : Return
		Next
		If PipFits(pipX, pipY + d) Then pipY = pipY + d : Return
	Next
	LosePip("Pip was squashed by a wall.")
End Function

Function LosePip(reason$)
	If pipState = PIP_LOST Or pipState = PIP_HOME Then Return
	pipState = PIP_LOST
	lostReason = reason
	lostTimer = 120
	PlaySfx(soundLost)
End Function

Function PipHome()
	pipState = PIP_HOME
	PlaySfx(soundHome)
	newBest = bestTicks(level) > 0 And ticks < bestTicks(level)
	If bestTicks(level) = 0 Or ticks < bestTicks(level) Then bestTicks(level) = ticks
	If level < LEVEL_COUNT And unlocked < level + 1 Then unlocked = level + 1
	SaveSettings()
	BuildPlayButtons()
End Function

;--- Dragging the rooms from inside -------------------------------------------------------------------------------
; Blue and green rooms can be moved by their title bar like any window, but a small window has little title bar left
; next to its buttons. So they can also be dragged from anywhere inside, and a green room resized by the grip in its
; bottom right corner. The window follows the mouse, which stays over the same point of the canvas while it moves.

Function StartDrag(canvas, x, y)
	Local r.Room
	For r = Each Room
		If r\canvas = canvas And (r\kind = ROOM_FREE Or r\kind = ROOM_STRETCH)
			grabResize = r\kind = ROOM_STRETCH
			; Green rooms do not move, so only their grip can be dragged.
			If grabResize And (x < r\w - GRIP_SIZE Or y < r\h - GRIP_SIZE) Then Return
			dragRoom = r
			If grabResize
				; How far the mouse is from the bottom right corner, which stays the same while resizing.
				grabX = r\w - x : grabY = r\h - y
			Else
				grabX = x : grabY = y
			EndIf
			Return
		EndIf
	Next
End Function

Function Drag(x, y)
	; The button may have come up outside of every window of the game, where no event tells about it.
	If Not MouseDown(1)
		dragRoom = Null
		Return
	EndIf
	Local r.Room = dragRoom
	Local wx = GadgetX(r\win), wy = GadgetY(r\win), w = ClientWidth(r\win), h = ClientHeight(r\win)
	If grabResize
		; The size is kept between the smallest and the largest before the window gets it.
		Local nw = Min(Max(x + grabX, r\minW), r\maxW), nh = Min(Max(y + grabY, r\minH), r\maxH)
		If nw <> w Or nh <> h Then SetGadgetShape r\win, wx, wy, nw, nh
	ElseIf x <> grabX Or y <> grabY
		SetGadgetShape r\win, wx + x - grabX, wy + y - grabY, w, h
	EndIf
End Function

; --- Levels ------------------------------------------------------------------------------------------------------

Function StartLevel(n)
	CloseLevel()
	level = n
	state = STATE_PLAY
	paused = False
	ticks = 0
	keysTotal = 0 : keysTaken = 0
	pipState = PIP_WAITING

	; The Panewalk window gets small and goes to the top left corner of the board.
	SetGadgetShape panel, boardX, boardY + 30, PANEL_SMALL_W, PANEL_SMALL_H
	SetGadgetShape screen, 0, 0, PANEL_SMALL_W, PANEL_SMALL_H

	Select n
		Case 1 : Restore Level1
		Case 2 : Restore Level2
		Case 3 : Restore Level3
		Case 4 : Restore Level4
		Case 5 : Restore Level5
		Case 6 : Restore Level6
		Case 7 : Restore Level7
		Default : Restore Level8
	End Select
	Read levelName, levelHint
	Local rooms, i, j, count
	Read rooms
	For i = 1 To rooms
		Local r.Room = New Room
		Read r\kind, r\title, r\homeX, r\homeY, r\homeW, r\homeH, r\minW, r\minH, r\maxW, r\maxH, count
		r\homeX = r\homeX + boardX : r\homeY = r\homeY + boardY
		r\x = r\homeX : r\y = r\homeY : r\w = r\homeW : r\h = r\homeH
		r\lastX = r\x : r\lastY = r\y
		For j = 1 To count
			Local t.Thing = New Thing
			t\room = r
			Read t\kind, t\x, t\y, t\w, t\h
			If t\kind = THING_START
				startRoom = r : startX = t\x : startY = t\y
				Delete t
			ElseIf t\kind = THING_KEY
				keysTotal = keysTotal + 1
			EndIf
		Next
		OpenRoom(r)
	Next
	; The Panewalk window stays on top, so its buttons can always be reached.
	ActivateWindow panel
	ActivateGadget screen
	ResetPip()
	BuildPlayButtons()
	PlaySfx(soundClick)
End Function

; Every room is a window with a canvas that fills it. Grey rooms and the void have no title bar, so they cannot be
; moved; blue rooms have one; green ones can also be resized.
Function OpenRoom(r.Room)
	Local style = 0
	If r\kind = ROOM_FREE Then style = 1
	If r\kind = ROOM_STRETCH Then style = 1 + 2
	r\win = CreateWindow(r\title, r\x, r\y, r\w, r\h, Desktop(), style)
	If r\win = 0 Then RuntimeError "Could not open the window of the room " + r\title + "."
	If r\kind = ROOM_STRETCH Then SetMinWindowSize r\win, r\minW, r\minH
	r\canvas = CreateCanvas(0, 0, r\w, r\h, r\win)
	SetGadgetLayout r\canvas, 1, 1, 1, 1
	; The computer may have put the window somewhere else than asked: it goes where the level says.
	If GadgetX(r\win) <> r\x Or GadgetY(r\win) <> r\y Then SetGadgetShape r\win, r\x, r\y, r\w, r\h
	; The computer may also keep a window bigger than asked, as a window with a title bar has a smallest width of its
	; own. The room then keeps the size that it got, instead of fighting the computer over it.
	r\w = ClientWidth(r\win) : r\h = ClientHeight(r\win)
	r\homeW = r\w : r\homeH = r\h
	If r\kind = ROOM_STRETCH
		r\minW = Min(r\minW, r\w) : r\minH = Min(r\minH, r\h)
		r\maxW = Max(r\maxW, r\w) : r\maxH = Max(r\maxH, r\h)
	EndIf
End Function

Function CloseLevel()
	dragRoom = Null
	Local r.Room
	For r = Each Room
		FreeGadget r\win
	Next
	Delete Each Room
	Delete Each Thing
End Function

; Puts the rooms back where they started and Pip at the start, without opening the windows again.
Function RestartLevel()
	Local r.Room
	For r = Each Room
		r\x = r\homeX : r\y = r\homeY : r\w = r\homeW : r\h = r\homeH
		r\lastX = r\x : r\lastY = r\y
		SetGadgetShape r\win, r\x, r\y, r\w, r\h
	Next
	ResetPip()
	pipState = PIP_WAITING
	paused = False
	ticks = 0
	BuildPlayButtons()
	PlaySfx(soundClick)
End Function

; Pip goes back to the start, and the keys back to where they were. The rooms stay where the player put them, so a
; plan that almost worked does not have to be built again.
Function ResetPip()
	pipX = startRoom\x + startX : pipY = startRoom\y + startY
	pipVY = 0 : pipDir = 1 : pipStep = 0 : pipAnim = 0 : pipFloat = 0
	If pipState = PIP_LOST
		pipState = PIP_WAITING
		BuildPlayButtons()
	EndIf
	keysTaken = 0
	Local t.Thing
	For t = Each Thing
		t\taken = False
	Next
End Function

; --- Drawing the rooms -------------------------------------------------------------------------------------------

Function DrawRooms()
	Local r.Room
	For r = Each Room
		DrawRoom(r)
	Next
End Function

; Each canvas shows the part of the world that its room covers: the sky, the walls of its own edges, the things of
; every room that reach into it, the void, and Pip.
Function DrawRoom(r.Room)
	SetBuffer CanvasBuffer(r\canvas)
	Viewport 0, 0, r\w, r\h
	ClsColor SKY_R, SKY_G, SKY_B
	Cls
	DrawImage watermark, 0, 0

	; A grid that is fixed to the desktop: it slides through a room as the room moves, so it is clear that the rooms
	; are windows onto one world.
	Color SKY_R + 10, SKY_G + 12, SKY_B + 18
	Local gx = 40 - Mod2(r\x - boardX, 40), gy = 40 - Mod2(r\y - boardY, 40)
	While gx < r\w
		Line gx, 0, gx, r\h - 1
		gx = gx + 40
	Wend
	While gy < r\h
		Line 0, gy, r\w - 1, gy
		gy = gy + 40
	Wend

	; The things of every room that overlaps this one, clipped to their own room.
	Local t.Thing, q.Room
	For t = Each Thing
		q = t\room
		If q\x < r\x + r\w And q\x + q\w > r\x And q\y < r\y + r\h And q\y + q\h > r\y
			Local vx = Max(q\x, r\x) - r\x, vy = Max(q\y, r\y) - r\y
			Local vw = Min(q\x + q\w, r\x + r\w) - r\x - vx, vh = Min(q\y + q\h, r\y + r\h) - r\y - vy
			Viewport vx, vy, vw, vh
			DrawThing(t, q\x + t\x - r\x, q\y + t\y - r\y)
		EndIf
	Next

	; The void, wherever it reaches into this room.
	For q = Each Room
		If q\kind = ROOM_VOID
			If q\x < r\x + r\w And q\x + q\w > r\x And q\y < r\y + r\h And q\y + q\h > r\y
				DrawVoid(r, q)
			EndIf
		EndIf
	Next
	Viewport 0, 0, r\w, r\h

	If r\kind <> ROOM_VOID
		DrawPip(pipX - r\x, pipY - r\y)
		DrawEdges(r)
	EndIf
	If r\kind = ROOM_FIXED
		Color 150, 156, 172
		Text 8, 6, r\title
	EndIf
	FlipCanvas r\canvas
End Function

; Mod that is never negative, for the grid.
Function Mod2(a, b)
	Local m = a Mod b
	If m < 0 Then m = m + b
	Return m
End Function

; The edges of a room are walls, except where another room goes on: there the guides show a dashed line.
Function DrawEdges(r.Room)
	Local i
	Select r\kind
		Case ROOM_FIXED : Color 120, 126, 140
		Case ROOM_FREE : Color 80, 140, 230
		Default : Color 90, 190, 110
	End Select
	Local wallR = ColorRed(), wallG = ColorGreen(), wallB = ColorBlue()
	For i = 0 To r\w - 1 Step 6
		EdgePiece(i, 0, Min(6, r\w - i), 3, InSpace(r\x + i + 3, r\y - 1), wallR, wallG, wallB)
		EdgePiece(i, r\h - 3, Min(6, r\w - i), 3, InSpace(r\x + i + 3, r\y + r\h), wallR, wallG, wallB)
	Next
	For i = 0 To r\h - 1 Step 6
		EdgePiece(0, i, 3, Min(6, r\h - i), InSpace(r\x - 1, r\y + i + 3), wallR, wallG, wallB)
		EdgePiece(r\w - 3, i, 3, Min(6, r\h - i), InSpace(r\x + r\w, r\y + i + 3), wallR, wallG, wallB)
	Next
	; The grip in the corner of a green room, which resizes it.
	If r\kind = ROOM_STRETCH
		Color wallR, wallG, wallB
		For i = 0 To 3
			Line r\w - 4 - i * 4, r\h - 4, r\w - 4, r\h - 4 - i * 4
			Line r\w - 5 - i * 4, r\h - 4, r\w - 4, r\h - 5 - i * 4
		Next
	EndIf
End Function

Function EdgePiece(x, y, w, h, open, r, g, b)
	If open
		If Not optGuides Then Return
		If ((x + y) / 6) Mod 2 = 0 Then Return
		Color 250, 220, 120
		Rect x + (w > 3), y + (h > 3), w - (w > 3), h - (h > 3), True
	Else
		Color r, g, b
		Rect x, y, w, h, True
	EndIf
End Function

Function InSpace(x, y)
	Return InRoom(x, y) And Not InVoid(x, y)
End Function

Function DrawThing(t.Thing, x, y)
	Local w = ThingW(t), h = ThingH(t), i
	Select t\kind
		Case THING_BLOCK
			Color 92, 74, 64
			Rect x, y, w, h, True
			Color 150, 120, 96
			Rect x, y, w, 3, True
			Color 70, 56, 48
			For i = 8 To w - 1 Step 16
				Line x + i, y + 4, x + i, y + h - 1
			Next

		Case THING_SPIKES
			Color 70, 70, 80
			Rect x, y + h - 3, w, 3, True
			Color 210, 214, 226
			For i = 0 To w - 1 Step 8
				Local k
				For k = 0 To 3
					Line x + i + k, y + h - 3, x + i + 4, y
					Line x + i + 8 - k, y + h - 3, x + i + 4, y
				Next
			Next

		Case THING_SPRING
			Color 90, 90, 100
			Rect x, y + h - 3, w, 3, True
			Color 240, 200, 60
			For i = 0 To 2
				Line x + 4, y + h - 3 - i * 2, x + w - 4, y + h - 4 - i * 2
			Next
			Color 230, 80, 60
			Rect x, y, w, 3, True

		Case THING_KEY
			If t\taken Then Return
			Local bob = Int(Sin(frame * 6.0) * 3.0)
			Color 250, 210, 70
			Oval x, y + bob, 10, 10, False
			Oval x + 1, y + 1 + bob, 8, 8, False
			Rect x + 4, y + 10 + bob, 3, 12, True
			Rect x + 7, y + 16 + bob, 4, 2, True
			Rect x + 7, y + 20 + bob, 4, 2, True

		Case THING_LOCK
			If keysTaken >= keysTotal Then Return
			Color 150, 120, 40
			Rect x, y, w, h, True
			Color 220, 180, 70
			Rect x, y, w, h, False
			Color 40, 30, 20
			Oval x + w / 2 - 3, y + h / 2 - 6, 6, 6, True
			Rect x + w / 2 - 1, y + h / 2 - 2, 3, 8, True

		Case THING_EXIT
			If keysTaken >= keysTotal
				Color 80, 200, 120
			Else
				Color 200, 80, 80
			EndIf
			Rect x, y + 8, w, h - 8, True
			Oval x, y, w, 16, True
			Color 20, 30, 40
			Rect x + 4, y + 10, w - 8, h - 10, True
			Oval x + 4, y + 4, w - 8, 14, True
			If keysTaken >= keysTotal
				Color 140, 255, 170
				Local glow = (frame / 4) Mod (h - 10)
				Line x + 5, y + h - 1 - glow, x + w - 6, y + h - 1 - glow
			Else
				Color 250, 210, 70
				Oval x + w / 2 - 3, y + h / 2, 6, 6, True
			EndIf
	End Select
End Function

; The void: dark red, with stripes that are fixed to the desktop like the grid.
Function DrawVoid(r.Room, q.Room)
	Local vx = Max(q\x, r\x) - r\x, vy = Max(q\y, r\y) - r\y
	Local vw = Min(q\x + q\w, r\x + r\w) - r\x - vx, vh = Min(q\y + q\h, r\y + r\h) - r\y - vy
	Viewport vx, vy, vw, vh
	Color 60, 8, 16
	Rect vx, vy, vw, vh, True
	Color 120, 20, 36
	Local s, shift = Mod2(r\x + r\y + frame, 24)
	For s = -vh - 24 + shift To vw Step 24
		Line vx + s, vy + vh, vx + s + vh, vy
		Line vx + s + 1, vy + vh, vx + s + vh + 1, vy
	Next
	If q = r
		Color 255, 120, 120
		Text r\w / 2, 16, "VOID", True, True
	EndIf
End Function

; Pip: a round orange body with two eyes that look where Pip walks, and two legs that move.
Function DrawPip(x, y)
	Local left = x - PIP_W / 2, top = y - PIP_H
	Local legs = 0
	If pipState = PIP_WALKING And pipOnGround Then legs = ((pipAnim / 6) Mod 2) * 2
	Color 60, 30, 20
	Rect left + 2 + legs, y - 5, 3, 5, True
	Rect left + PIP_W - 5 - legs, y - 5, 3, 5, True
	If pipState = PIP_LOST
		Color 140, 120, 120
	Else
		Color 250, 150, 60
	EndIf
	Oval left, top, PIP_W, PIP_H - 3, True
	Color 255, 200, 120
	Oval left + 2, top + 2, 4, 4, True
	Local look = pipDir * 2
	If pipState = PIP_LOST
		Color 30, 20, 20
		Line left + 3, top + 5, left + 6, top + 8
		Line left + 6, top + 5, left + 3, top + 8
		Line left + 7, top + 5, left + 10, top + 8
		Line left + 10, top + 5, left + 7, top + 8
	Else
		Color 255, 255, 255
		Oval left + 2 + look / 2, top + 4, 4, 5, True
		Oval left + 6 + look / 2, top + 4, 4, 5, True
		Color 20, 20, 30
		Rect left + 3 + look / 2 + pipDir, top + 6, 2, 2, True
		Rect left + 7 + look / 2 + pipDir, top + 6, 2, 2, True
	EndIf
End Function

; --- The Panewalk window -----------------------------------------------------------------------------------------

Function DrawPanel()
	SetBuffer CanvasBuffer(screen)
	Local w = GadgetWidth(screen), h = GadgetHeight(screen)
	Viewport 0, 0, w, h
	ClsColor PANEL_R, PANEL_G, PANEL_B
	Cls
	DrawImage panelWatermark, 0, 0
	Local y, line$

	Select state
		Case STATE_MENU
			DrawPipParade(w)
			DrawImage titleImage, (w - ImageWidth(titleImage)) / 2, 40
			Color 170, 180, 210
			Text w / 2, 104, "A puzzle where the windows are the level", True, True
			DrawButtons()
			Color 110, 116, 150
			Text w / 2, h - 18, "A BlitzLLVM sample game", True, True

		Case STATE_LEVELS
			Color 255, 230, 140
			Text w / 2, 30, "Choose a level", True, True
			DrawButtons()

		Case STATE_OPTIONS
			Color 255, 230, 140
			Text w / 2, 30, "Options", True, True
			DrawButtons()
			Color 130, 136, 170
			Text w / 2, h - 46, "Left/Right or the right mouse button go the other way.", True, True

		Case STATE_HELP
			Color 255, 230, 140
			Text w / 2, 24, "How to play", True, True
			Color 210, 214, 230
			Restore HelpText
			y = 50
			Repeat
				Read line
				If line = "-" Then Exit
				Text 24, y, line
				y = y + 16
			Forever
			DrawButtons()

		Case STATE_PLAY
			Color 255, 230, 140
			Text 10, 8, "Level " + level + ": " + levelName
			Color 170, 180, 210
			Text w - 10 - StringWidth(TimeText(ticks)), 8, TimeText(ticks)
			Color 210, 214, 230
			Select pipState
				Case PIP_WAITING
					line = "Arrange the rooms, then press Go."
				Case PIP_WALKING
					If paused Then line = "Paused." Else line = "Pip is walking."
					If keysTotal > 0 Then line = line + "  Keys: " + keysTaken + " of " + keysTotal
				Case PIP_LOST
					Color 255, 140, 140
					line = lostReason + " Back to the start."
				Case PIP_HOME
					Color 140, 255, 170
					line = "Pip is home, in " + TimeText(ticks) + "!"
					If newBest Then line = line + " A new best!"
			End Select
			Text 10, 28, line
			If showHint And optHints
				Color 150, 160, 190
				WrapText(levelHint, 10, 48, w - 20)
			EndIf
			DrawButtons()
	End Select
	FlipCanvas screen
End Function

; Pip walks along the bottom of the title screen.
Function DrawPipParade(w)
	Local saveX = pipX, saveY = pipY, saveDir = pipDir, saveState = pipState, saveAnim = pipAnim
	pipState = PIP_WALKING : pipOnGround = True
	pipAnim = frame
	pipDir = 1
	DrawPip(Mod2(frame, w + 40) - 20, GadgetHeight(screen) - 34)
	pipX = saveX : pipY = saveY : pipDir = saveDir : pipState = saveState : pipAnim = saveAnim
	Color 60, 66, 96
	Line 0, GadgetHeight(screen) - 34, w, GadgetHeight(screen) - 34
End Function

Function TimeText$(t)
	Local tenths = t * 10 / 60
	Return (tenths / 10) + "." + (tenths Mod 10) + " s"
End Function

; Writes text over as many lines as it needs, breaking it between words.
Function WrapText(text$, x, y, width)
	Local line$ = "", word$, i, c$
	text = text + " "
	For i = 1 To Len(text)
		c = Mid(text, i, 1)
		If c = " "
			If line <> "" And StringWidth(line + " " + word) > width
				Text x, y, line
				y = y + 15
				line = word
			ElseIf line = ""
				line = word
			Else
				line = line + " " + word
			EndIf
			word = ""
		Else
			word = word + c
		EndIf
	Next
	If line <> "" Then Text x, y, line
End Function

Function AddButton(id, x, y, w, h, text$)
	buttonX(buttonCount) = x : buttonY(buttonCount) = y
	buttonW(buttonCount) = w : buttonH(buttonCount) = h
	buttonId(buttonCount) = id : buttonText(buttonCount) = text
	buttonCount = buttonCount + 1
End Function

Function ButtonAt(x, y)
	Local i
	For i = 0 To buttonCount - 1
		If x >= buttonX(i) And x < buttonX(i) + buttonW(i) And y >= buttonY(i) And y < buttonY(i) + buttonH(i) Then Return i
	Next
	Return -1
End Function

Function DrawButtons()
	Local i
	For i = 0 To buttonCount - 1
		Local locked = buttonId(i) >= BUTTON_LEVEL And buttonId(i) - BUTTON_LEVEL > unlocked
		If locked
			Color 40, 42, 56
		ElseIf i = buttonSelected Or i = buttonHover
			Color 70, 60, 130
		Else
			Color 46, 50, 76
		EndIf
		Rect buttonX(i), buttonY(i), buttonW(i), buttonH(i), True
		If i = buttonSelected Then Color 255, 230, 140 Else Color 80, 86, 120
		Rect buttonX(i), buttonY(i), buttonW(i), buttonH(i), False
		If locked
			Color 100, 100, 120
		ElseIf i = buttonSelected Or i = buttonHover
			Color 255, 230, 140
		Else
			Color 210, 214, 230
		EndIf
		Text buttonX(i) + buttonW(i) / 2, buttonY(i) + buttonH(i) / 2, buttonText(i), True, True
	Next
End Function

; --- Screens of the Panewalk window ------------------------------------------------------------------------------

Function BigPanel()
	SetGadgetShape panel, (desktopW - PANEL_BIG_W) / 2, (desktopH - PANEL_BIG_H) / 2, PANEL_BIG_W, PANEL_BIG_H
	SetGadgetShape screen, 0, 0, PANEL_BIG_W, PANEL_BIG_H
	buttonCount = 0
	buttonSelected = 0
	buttonHover = -1
End Function

Function GoToMenu()
	CloseLevel()
	state = STATE_MENU
	BigPanel()
	Local x = PANEL_BIG_W / 2 - 120
	If unlocked > 1 And bestTicks(1) > 0 Then AddButton(BUTTON_PLAY, x, 140, 240, 32, "Continue") Else AddButton(BUTTON_PLAY, x, 140, 240, 32, "Play")
	AddButton(BUTTON_LEVELS, x, 180, 240, 32, "Choose a level")
	AddButton(BUTTON_OPTIONS, x, 220, 240, 32, "Options")
	AddButton(BUTTON_HELP, x, 260, 240, 32, "How to play")
	AddButton(BUTTON_QUIT, x, 300, 240, 32, "Quit")
End Function

Function GoToLevels()
	state = STATE_LEVELS
	BigPanel()
	Local i, text$
	For i = 1 To LEVEL_COUNT
		Restore LevelNames
		Local k, name$
		For k = 1 To i
			Read name
		Next
		text = i + ". " + name
		If i > unlocked
			text = i + ". (locked)"
		ElseIf bestTicks(i) > 0
			text = text + "  " + TimeText(bestTicks(i))
		EndIf
		AddButton(BUTTON_LEVEL + i, 40 + ((i - 1) Mod 2) * 225, 60 + ((i - 1) / 2) * 56, 215, 44, text)
	Next
	AddButton(BUTTON_BACK, PANEL_BIG_W / 2 - 80, 300, 160, 32, "Back")
End Function

Function GoToOptions()
	state = STATE_OPTIONS
	BigPanel()
	Local x = PANEL_BIG_W / 2 - 150
	AddButton(BUTTON_SPEED, x, 80, 300, 32, "")
	AddButton(BUTTON_VOLUME, x, 120, 300, 32, "")
	AddButton(BUTTON_HINTS, x, 160, 300, 32, "")
	AddButton(BUTTON_GUIDES, x, 200, 300, 32, "")
	AddButton(BUTTON_BACK, PANEL_BIG_W / 2 - 80, 260, 160, 32, "Back")
	RefreshOptions()
End Function

Function RefreshOptions()
	buttonText(0) = "Pip's speed: " + speedName(optSpeed)
	buttonText(1) = "Sound volume: " + (optVolume * 25) + "%"
	If optHints Then buttonText(2) = "Hints: shown" Else buttonText(2) = "Hints: hidden"
	If optGuides Then buttonText(3) = "Open edges: marked" Else buttonText(3) = "Open edges: not marked"
End Function

Function GoToHelp()
	state = STATE_HELP
	BigPanel()
	AddButton(BUTTON_BACK, PANEL_BIG_W / 2 - 80, PANEL_BIG_H - 50, 160, 32, "Back")
End Function

; The buttons under the status lines while a level is played.
Function BuildPlayButtons()
	buttonCount = 0
	buttonHover = -1
	Local y = PANEL_SMALL_H - 36
	If pipState = PIP_HOME
		If level < LEVEL_COUNT Then AddButton(BUTTON_NEXT, 10, y, 116, 28, "Next level") Else AddButton(BUTTON_MENU, 10, y, 116, 28, "All done!")
		AddButton(BUTTON_RESTART, 132, y, 116, 28, "Again")
		AddButton(BUTTON_MENU, 254, y, 116, 28, "Menu")
	Else
		If pipState = PIP_WAITING
			AddButton(BUTTON_GO, 10, y, 116, 28, "Go")
		ElseIf paused
			AddButton(BUTTON_GO, 10, y, 116, 28, "Resume")
		Else
			AddButton(BUTTON_GO, 10, y, 116, 28, "Pause")
		EndIf
		AddButton(BUTTON_RESTART, 132, y, 116, 28, "Restart")
		AddButton(BUTTON_MENU, 254, y, 116, 28, "Menu")
	EndIf
	buttonSelected = 0
End Function

; A button was pressed. backwards is True for the right mouse button or Left, which turn options the other way.
; Gives back True when the game should end.
Function Press(id, backwards)
	Local change = 1
	If backwards Then change = -1
	PlaySfx(soundClick)
	Select id
		Case BUTTON_PLAY
			Local startAt = 1
			While startAt < unlocked And bestTicks(startAt) > 0
				startAt = startAt + 1
			Wend
			StartLevel(startAt)
		Case BUTTON_LEVELS : GoToLevels()
		Case BUTTON_OPTIONS : GoToOptions()
		Case BUTTON_HELP : GoToHelp()
		Case BUTTON_QUIT : Return True
		Case BUTTON_BACK
			If state = STATE_OPTIONS Then SaveSettings()
			GoToMenu()
		Case BUTTON_SPEED
			optSpeed = (optSpeed + change + 3) Mod 3
			RefreshOptions()
		Case BUTTON_VOLUME
			optVolume = (optVolume + change + 5) Mod 5
			RefreshOptions()
			PlaySfx(soundClick)
		Case BUTTON_HINTS
			optHints = Not optHints
			RefreshOptions()
		Case BUTTON_GUIDES
			optGuides = Not optGuides
			RefreshOptions()
		Case BUTTON_GO
			If pipState = PIP_WAITING
				pipState = PIP_WALKING
				PlaySfx(soundGo)
			ElseIf pipState = PIP_WALKING
				paused = Not paused
			EndIf
			BuildPlayButtons()
		Case BUTTON_RESTART : RestartLevel()
		Case BUTTON_MENU : GoToMenu()
		Case BUTTON_NEXT : StartLevel(level + 1)
		Default
			If id > BUTTON_LEVEL And id - BUTTON_LEVEL <= unlocked Then StartLevel(id - BUTTON_LEVEL)
	End Select
	ActivateGadget screen
	Return False
End Function

; A key went down in the Panewalk window. Gives back True when the game should end.
Function KeyDown(key)
	Select key
		Case KEY_UP
			If buttonCount > 0 Then buttonSelected = (buttonSelected + buttonCount - 1) Mod buttonCount
		Case KEY_DOWN
			If buttonCount > 0 Then buttonSelected = (buttonSelected + 1) Mod buttonCount
		Case KEY_LEFT, KEY_RIGHT
			If state = STATE_OPTIONS And buttonSelected >= 0 And buttonSelected < buttonCount
				If buttonId(buttonSelected) <> BUTTON_BACK Then Return Press(buttonId(buttonSelected), key = KEY_LEFT)
			ElseIf buttonCount > 0
				If key = KEY_LEFT Then buttonSelected = (buttonSelected + buttonCount - 1) Mod buttonCount Else buttonSelected = (buttonSelected + 1) Mod buttonCount
			EndIf
		Case KEY_ENTER
			If buttonSelected >= 0 And buttonSelected < buttonCount Then Return Press(buttonId(buttonSelected), False)
		Case KEY_SPACE
			If state = STATE_PLAY
				If pipState = PIP_HOME Then Return Press(buttonId(0), False)
				Return Press(BUTTON_GO, False)
			EndIf
			If buttonSelected >= 0 And buttonSelected < buttonCount Then Return Press(buttonId(buttonSelected), False)
		Case KEY_P
			If state = STATE_PLAY And pipState = PIP_WALKING Then Return Press(BUTTON_GO, False)
		Case KEY_R
			If state = STATE_PLAY Then RestartLevel()
		Case KEY_H
			showHint = Not showHint
		Case KEY_ESCAPE
			If state = STATE_MENU Then Return True
			If state = STATE_OPTIONS Then SaveSettings()
			GoToMenu()
	End Select
	Return False
End Function

; --- Settings ----------------------------------------------------------------------------------------------------

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	If ReadInt(file) = 1 ; A version number, so a changed file format can be recognised later.
		optSpeed = ReadInt(file)
		optVolume = ReadInt(file)
		optHints = ReadInt(file)
		optGuides = ReadInt(file)
		unlocked = ReadInt(file)
		Local i
		For i = 1 To LEVEL_COUNT
			bestTicks(i) = ReadInt(file)
		Next
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optSpeed < 0 Or optSpeed > 2 Then optSpeed = 1
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
	If unlocked < 1 Or unlocked > LEVEL_COUNT Then unlocked = 1
	For i = 1 To LEVEL_COUNT
		If bestTicks(i) < 0 Then bestTicks(i) = 0
	Next
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets.
	WriteInt file, 1
	WriteInt file, optSpeed
	WriteInt file, optVolume
	WriteInt file, optHints
	WriteInt file, optGuides
	WriteInt file, unlocked
	Local i
	For i = 1 To LEVEL_COUNT
		WriteInt file, bestTicks(i)
	Next
	CloseFile file
End Function

; --- Pictures ----------------------------------------------------------------------------------------------------

; Every picture carries a faint pattern that nobody can see: some sky pixels are one step bluer than the rest. A
; program can find the pattern again in a screenshot, which shows that the picture came from this sample game. It is
; a masked image drawn just after Cls, so everything else is drawn over it. There is one for the sky of the rooms and
; one for the background of the Panewalk window, each as big as the biggest window that it is drawn in.
Function MakeWatermark(r, g, b)
	Local w = 1024, h = 768
	Local image = CreateImage(w, h), x, y, buffer = ImageBuffer(image)
	LockBuffer buffer
	For y = 0 To h - 1
		For x = 0 To w - 1
			; Black is the mask colour, so only the marked pixels are drawn.
			If (x * 7 + y * 13) Mod 29 < 3
				WritePixelFast x, y, (r Shl 16) Or (g Shl 8) Or (b + 1), buffer
			Else
				WritePixelFast x, y, 0, buffer
			EndIf
		Next
	Next
	UnlockBuffer buffer
	Return image
End Function

; Big blocky letters for the title: the text is written small, and every pixel of it becomes a square.
Function MakeBigText(text$, size)
	Local small = CreateImage(StringWidth(text), FontHeight())
	SetBuffer ImageBuffer(small)
	ClsColor 0, 0, 0
	Cls
	Color 255, 255, 255
	Text 0, 0, text
	Local w = ImageWidth(small), h = ImageHeight(small)
	Local big = CreateImage(w * size + 4, h * size + 4), x, y
	SetBuffer ImageBuffer(big)
	ClsColor 0, 0, 0
	Cls
	LockBuffer ImageBuffer(small)
	For y = 0 To h - 1
		For x = 0 To w - 1
			If (ReadPixelFast(x, y, ImageBuffer(small)) And $FF) > 128
				; A shadow first, then the letter, in colours that run from orange at the top to yellow below.
				Color 90, 40, 20
				Rect x * size + 4, y * size + 4, size, size, True
				Color 250, 140 + y * 100 / h, 60 + y * 60 / h
				Rect x * size, y * size, size - 1, size - 1, True
			EndIf
		Next
	Next
	UnlockBuffer ImageBuffer(small)
	FreeImage small
	Return big
End Function

; --- Sounds ------------------------------------------------------------------------------------------------------

; Every sound goes through here, so the volume option works everywhere.
Function PlaySfx(sound)
	If sound = 0 Or optVolume = 0 Then Return
	Local channel = PlaySound(sound)
	ChannelVolume channel, optVolume / 4.0
End Function

; Makes a short sound that glides from one pitch to another, writes it as a WAV file and loads it.
Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0, i, v#
	For i = 0 To samples - 1
		Local t# = Float(i) / samples
		phase = phase + 360.0 * (startHz + (endHz - startHz) * t) / rate
		If phase >= 360 Then phase = phase - 360
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1
			Case WAVE_SINE
				v = Sin(phase)
			Default
				v = Rnd(-1, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		Local envelope# = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.6 Then envelope = envelope * (1.0 - t) / 0.4
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "panewalk-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If Not file
		FreeBank bank
		Return 0
	EndIf
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank
	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

