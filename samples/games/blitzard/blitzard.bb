; --- Battle ----------------------------------------------------------------------------------------------------------------

Function DrawBattle()
	Local skyR, skyG, skyB, groundR, groundG, groundB
	Select battleRegion
		Case REGION_MEADOW : skyR = 150 : skyG = 200 : skyB = 245 : groundR = 120 : groundG = 190 : groundB = 90
		Case REGION_MARSH : skyR = 160 : skyG = 196 : skyB = 200 : groundR = 86 : groundG = 140 : groundB = 116
		Case REGION_CAVE : skyR = 44 : skyG = 34 : skyB = 44 : groundR = 84 : groundG = 66 : groundB = 60
		Default : skyR = 70 : skyG = 78 : skyB = 140 : groundR = 150 : groundG = 152 : groundB = 170
	End Select
	ClsColor skyR, skyG, skyB
	Cls
	DrawWatermark(skyR, skyG, skyB)
	Local shakeX = 0
	If battleShake > 0 Then shakeX = Rand(-Int(battleShake), Int(battleShake))
	Origin shakeX, 0

	; The scenery: clouds or rocks above, the ground below.
	Local i, cx, cy
	SeedRnd battleRegion + 3
	For i = 0 To 5
		cx = (Rand(0, SCREEN_W) + frame / (3 + i)) Mod (SCREEN_W + 200) - 100
		cy = Rand(20, 130)
		If battleRegion = REGION_CAVE
			Color skyR + 14, skyG + 10, skyB + 12
			Oval Rand(-50, SCREEN_W), Rand(-60, 0), Rand(80, 200), Rand(80, 140), 1
		Else
			Color Min(255, skyR + 50), Min(255, skyG + 40), Min(255, skyB + 10)
			Oval cx, cy, 120, 30, 1
			Oval cx + 30, cy - 14, 70, 34, 1
		EndIf
	Next
	SeedRnd MilliSecs() + frame
	Color groundR, groundG, groundB
	Rect -20, 190, SCREEN_W + 40, SCREEN_H, 1
	Color groundR + 10, groundG + 10, groundB + 10
	Rect -20, 190, SCREEN_W + 40, 6, 1
	Color groundR - 20, groundG - 20, groundB - 20
	Oval FoeSpotX() - 130, FoeSpotY() - 28, 260, 56, 1
	Oval PlayerSpotX() - 150, PlayerSpotY() - 32, 300, 64, 1

	DrawBattler(1)
	DrawBattler(0)
	If orbVisible
		Local orb = imageOrb
		If pendingItem = ITEM_GREAT_ORB Then orb = imageGreatOrb
		DrawImage orb, Int(orbX + orbWobble) - 12, Int(orbY) - 12
	EndIf
	If currentStep <> Null
		If currentStep\kind = STEP_ATTACK And currentStep\a = ELEM_VOLT And optAnimations Then DrawLightning(1 - currentStep\side)
	EndIf
	DrawParticles()
	Origin 0, 0

	If shownVisible(1) Then DrawInfoBox(1, 40, 40)
	If shownVisible(0) Then DrawInfoBox(0, SCREEN_W - 370, 330)

	DrawPanel(10, SCREEN_H - 130, SCREEN_W - 20, 120)
	If battlePhase = PHASE_STEPS
		If currentStep <> Null
			If currentStep\kind = STEP_TEXT
				SetFont fontText
				Color 245, 245, 255
				DrawWrapped(currentStep\text, 34, SCREEN_H - 110, SCREEN_W - 70, 28, Int(stepTyped))
			EndIf
		EndIf
	ElseIf battlePhase = PHASE_ACTION And state = STATE_BATTLE
		SetFont fontText
		Color 245, 245, 255
		Text 34, SCREEN_H - 110, "What will " + speciesName(team(playerActive)\species) + " do?"
		DrawMenu(False)
	ElseIf battlePhase = PHASE_MOVE And state = STATE_BATTLE
		DrawMenu(False)
		Local m = team(playerActive)\move[menuSelected]
		If m >= 0
			DrawElementTag(320, SCREEN_H - 112, moveElement(m))
			SetFont fontText
			Color 245, 245, 255
			Text 320, SCREEN_H - 80, MoveInfo(m)
			Local foeSpecies = shownSpecies(1)
			If movePower(m) > 0 And foeSpecies > 0
				Local percent = effectiveness(moveElement(m), speciesElement(foeSpecies))
				If percent > 100 Then Color 120, 255, 140 : Text 320, SCREEN_H - 52, "Super effective"
				If percent < 100 Then Color 255, 160, 140 : Text 320, SCREEN_H - 52, "Not very effective"
			EndIf
		EndIf
	EndIf
End Function

; Draws one side's blitzling, growing in when sent out, sinking when it faints and flashing when hit.
Function DrawBattler(side)
	If Not shownVisible(side) Then Return
	If shownFlash(side) > 0 And (shownFlash(side) / 4) Mod 2 = 0 Then Return
	Local image, x, y
	If side = 1
		image = creatureFront(shownSpecies(1)) : x = FoeSpotX() : y = FoeSpotY() + 14
	Else
		image = creatureBack(shownSpecies(0)) : x = PlayerSpotX() : y = PlayerSpotY() + 14
	EndIf
	Local w = ImageWidth(image), h = ImageHeight(image)
	Local grow# = shownGrow(side)
	If grow < 1
		; Growing in, or shrinking into an orb: only the bottom part of the picture shows.
		If grow <= 0 Then Return
		Local part = Int(h * grow)
		DrawImageRect image, x - w / 2, y - part, 0, h - part, w, part
		Return
	EndIf
	Local drop = Int(shownDrop(side) * h)
	If drop > 0
		; Fainting: the picture sinks into the ground.
		If drop >= h Then Return
		DrawImageRect image, x - w / 2, y - h + drop, 0, 0, w, h - drop
		Return
	EndIf
	Local bob = Int(Sin(Float(frame * 3 + side * 90)) * 2)
	DrawImage image, x - w / 2, y - h + bob
End Function

Function DrawInfoBox(side, x, y)
	Local h = 80
	If side = 0 Then h = 104
	DrawPanel(x, y, 330, h)
	SetFont fontText
	Color 255, 255, 255
	Text x + 16, y + 12, speciesName(shownSpecies(side))
	Text x + 310 - StringWidth("Lv " + shownLevel(side)), y + 12, "Lv " + shownLevel(side)
	If side = 1 And battleTamer = Null And shownCaughtMark
		; A small mark shows that this kind is already in the journal.
		Color 255, 214, 90
		Oval x + 24 + StringWidth(speciesName(shownSpecies(1))), y + 18, 10, 10, 1
	EndIf
	SetFont fontSmall
	Color 255, 214, 90
	Text x + 16, y + 44, "HP"
	DrawHealthBar(x + 46, y + 48, 266, shownHP(side), shownMaxHP(side))
	If side = 0
		Color 235, 240, 255
		Local hpText$ = Int(Ceil(shownHP(0))) + " / " + shownMaxHP(0)
		Text x + 312 - StringWidth(hpText), y + 62, hpText
		Color 30, 30, 40
		Rect x + 16, y + 86, 298, 8, 1
		Color 90, 170, 255
		Rect x + 18, y + 88, Int(294 * shownXP(0)), 4, 1
	EndIf
End Function

; A jagged bolt from the sky onto a side.
Function DrawLightning(side)
	Local x, y
	If side = 1 Then x = FoeSpotX() : y = FoeSpotY() - 60 Else x = PlayerSpotX() : y = PlayerSpotY() - 70
	Local i, fromX = x + Rand(-20, 20), fromY = -10, toX, toY
	Color 255, 250, 180
	For i = 1 To 8
		toX = x + Rand(-24, 24)
		toY = fromY + (y - fromY + 10) / (9 - i)
		Line fromX, fromY, toX, toY
		Line fromX + 1, fromY, toX + 1, toY
		Line fromX + 2, fromY, toX + 2, toY
		fromX = toX : fromY = toY
	Next
End Function

; Particles for each kind of attack. Called every frame while the attack step runs.
Function AttackEffect(side, element, t)
	Local fromX = PlayerSpotX(), fromY = PlayerSpotY() - 60, toX = FoeSpotX(), toY = FoeSpotY() - 50
	If side = 1 Then fromX = FoeSpotX() : fromY = FoeSpotY() - 50 : toX = PlayerSpotX() : toY = PlayerSpotY() - 60
	Local r = elementR(element), g = elementG(element), b = elementB(element), i, p.Particle
	Select element
		Case ELEM_EMBER, ELEM_TIDE, ELEM_BLOOM, ELEM_GALE
			; A stream of particles from the attacker to the target.
			If t < 22
				For i = 1 To 3
					p = AddParticle(fromX + Rnd(-10, 10), fromY + Rnd(-10, 10), (toX - fromX) / 20.0 + Rnd(-1, 1), (toY - fromY) / 20.0 + Rnd(-2, 0), 0.045, r, g, b, Rnd(4, 9))
					If element = ELEM_GALE Then p\vy = p\vy + Sin(Float(t * 30 + i * 120)) * 3
				Next
			EndIf
			If t = 22 Then BattleBurst(toX, toY, r, g, b, 24)
		Case ELEM_STONE
			If t Mod 3 = 0 And t < 24 Then AddParticle(toX + Rnd(-50, 50), Float(toY - 160), Rnd(-0.5, 0.5), Rnd(6, 9), 0.035, r, g, b, Rnd(8, 14))
		Case ELEM_VOLT
			If t Mod 6 = 0 Then BattleBurst(toX, toY, r, g, b, 8)
		Default
			If t = 6 Then BattleBurst(toX, toY, 255, 255, 255, 20)
	End Select
End Function

; Rising or falling sparkles around a side when a stat changes.
Function StatSparkles(side, rising)
	If Not optAnimations Then Return
	Local x = FoeSpotX(), y = FoeSpotY() - 50, i
	If side = 0 Then x = PlayerSpotX() : y = PlayerSpotY() - 60
	For i = 1 To 24
		If rising
			AddParticle(x + Rnd(-50, 50), y + Rnd(0, 60), 0, Rnd(-3, -1.5), 0.03, 255, 230, 120, 4)
		Else
			AddParticle(x + Rnd(-50, 50), y + Rnd(-60, 0), 0, Rnd(1.5, 3), 0.03, 120, 150, 255, 4)
		EndIf
	Next
End Function

Function BattleBurst(x, y, r, g, b, count)
	Local i, angle#, speed#
	For i = 1 To count
		angle = Rnd(360)
		speed = Rnd(1, 5)
		AddParticle(Float(x), Float(y), Cos(angle) * speed, Sin(angle) * speed, 0.04, r, g, b, Rnd(3, 7))
	Next
End Function

Function AddParticle.Particle(x#, y#, vx#, vy#, fade#, r, g, b, size#)
	Local p.Particle = New Particle
	p\x = x : p\y = y : p\vx = vx : p\vy = vy
	p\life = 1 : p\fade = fade
	p\r = r : p\g = g : p\b = b
	p\size = size
	Return p
End Function

Function UpdateParticles()
	Local p.Particle
	For p = Each Particle
		p\x = p\x + p\vx
		p\y = p\y + p\vy
		p\life = p\life - p\fade
		If p\life <= 0 Then Delete p
	Next
End Function

Function DrawParticles()
	Local p.Particle, s
	For p = Each Particle
		s = Max(1, Int(p\size * p\life))
		Color Int(p\r * (0.4 + 0.6 * p\life)), Int(p\g * (0.4 + 0.6 * p\life)), Int(p\b * (0.4 + 0.6 * p\life))
		Oval Int(p\x) - s / 2, Int(p\y) - s / 2, s, s, 1
	Next
End Function

; --- Evolution and credits ---------------------------------------------------------------------------------------------------

Function DrawEvolve()
	ClsColor 20, 16, 40
	Cls
	DrawWatermark(20, 16, 40)
	Local i
	For i = 0 To 11
		Color 30 + i * 3, 24 + i * 2, 56 + i * 5
		Oval SCREEN_W / 2 - 300 + i * 25, 260 - 200 + i * 17, 600 - i * 50, 400 - i * 34, 1
	Next
	Local species = evolveFrom
	If evolveTimer >= 200
		species = evolveTo
	ElseIf evolveTimer > 40
		; Flicker between the old and the new form, faster and faster.
		Local period = Max(4, 40 - (evolveTimer - 40) / 5)
		If (evolveTimer / period) Mod 2 = 1 Then species = evolveTo
	EndIf
	Local image = creatureFront(species)
	DrawImage image, SCREEN_W / 2 - ImageWidth(image) / 2, 260 - ImageHeight(image) / 2
	If evolveTimer > 170 And evolveTimer < 200
		Color 255, 255, 255
		Rect 0, 0, SCREEN_W, SCREEN_H, 1
	EndIf
	If evolveTimer Mod 5 = 0 And evolveTimer < 200 Then BattleBurst(SCREEN_W / 2 + Rand(-80, 80), 260 + Rand(-80, 80), 255, 250, 200, 3)
	DrawParticles()
	DrawPanel(10, SCREEN_H - 130, SCREEN_W - 20, 120)
	SetFont fontText
	Color 245, 245, 255
	If evolveTimer < 200
		Text 34, SCREEN_H - 110, "What? " + speciesName(evolveFrom) + " is evolving!"
	Else
		Text 34, SCREEN_H - 110, "Congratulations! " + speciesName(evolveFrom) + " evolved into " + speciesName(evolveTo) + "!"
	EndIf
End Function

