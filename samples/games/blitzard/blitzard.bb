; A short description of what a move does.
Function MoveInfo$(m)
	Select moveEffect(m)
		Case EFFECT_DAMAGE
			Local text$ = "Power " + movePower(m) + ", aim " + moveAccuracy(m) + "%"
			If moveFirst(m) Then text = text + ", strikes first"
			Return text
		Case EFFECT_ATK_UP : Return "Raises its attack"
		Case EFFECT_DEF_UP : Return "Raises its defence"
		Case EFFECT_SPD_UP : Return "Raises its speed a lot"
		Case EFFECT_FOE_ATK_DOWN : Return "Lowers the foe's attack"
		Case EFFECT_FOE_DEF_DOWN : Return "Lowers the foe's defence"
		Case EFFECT_HEAL : Return "Heals half its health"
	End Select
	Return ""
End Function

