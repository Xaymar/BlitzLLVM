	Select state
		Case STATE_TITLE : quit = UpdateTitle()
		Case STATE_OPTIONS : UpdateOptions()
		Case STATE_HELP : UpdateHelp()
		Case STATE_STARTER : UpdateStarter()
		Case STATE_FIELD : UpdateField()
		Case STATE_DIALOG : UpdateDialog()
		Case STATE_APPROACH : UpdateApproach()
		Case STATE_FIELD_MENU : quit = UpdateFieldMenu()
		Case STATE_TEAM : UpdateTeam()
		Case STATE_SUMMARY : UpdateSummary()
		Case STATE_BAG : UpdateBag()
		Case STATE_JOURNAL : UpdateJournal()
		Case STATE_SHOP : UpdateShop()
		Case STATE_CHOICE : UpdateChoice()
		Case STATE_DEN : UpdateDen()
		Case STATE_TRANSITION : UpdateTransition()
		Case STATE_BATTLE : UpdateBattle()
		Case STATE_EVOLVE : UpdateEvolve()
		Case STATE_CREDITS : UpdateCredits()
	End Select
	If state >= STATE_FIELD And state <> STATE_CREDITS Then playFrames = playFrames + 1

	UpdateParticles()
	DrawScreen()
	Flip 0
Wend

End

; --- Tables ------------------------------------------------------------------------------------------------------------

Function LoadTables()
	Local i, j

	Restore elementData
	For i = 0 To ELEMENT_COUNT - 1
		Read elementName(i), elementR(i), elementG(i), elementB(i)
		For j = 0 To ELEMENT_COUNT - 1
			Read effectiveness(i, j)
		Next
	Next

	Restore moveData
	For i = 0 To MOVE_COUNT - 1
		Read moveName(i), moveElement(i), movePower(i), moveAccuracy(i), moveEffect(i), moveFirst(i)
	Next

	Restore speciesData
	For i = 1 To SPECIES_COUNT
		Read speciesName(i), speciesElement(i), baseHP(i), baseAtk(i), baseDef(i), baseSpd(i)
		Read catchRate(i), baseXP(i), evolveInto(i), evolveLevel(i)
		Read speciesShape(i), speciesParts(i), bodyR(i), bodyG(i), bodyB(i), accentR(i), accentG(i), accentB(i)
		Read learnset(i), journalText(i)
	Next

	Restore itemData
	For i = 0 To ITEM_COUNT - 1
		Read itemName(i), itemPrice(i), itemText(i)
	Next

	Restore encounterData
	For i = 0 To 2
		Read encounterCount(i)
		For j = 0 To encounterCount(i) - 1
			Read encounterSpecies(i, j), encounterMin(i, j), encounterMax(i, j), encounterWeight(i, j)
		Next
	Next

	Restore mapData
	Local row$, x, y
	For y = 0 To MAP_H - 1
		Read row
		For x = 0 To MAP_W - 1
			mapTile(x, y) = Mid(row, x + 1, 1)
		Next
	Next
End Function

