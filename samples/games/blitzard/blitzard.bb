	i = journalCursor
	SetFont fontBig
	Color 255, 255, 255
	If seen(i)
		Text 590, 136, speciesName(i), True, True
		DrawImage creatureFront(i), 590 - 75, 160
		DrawElementTag(440, 320, speciesElement(i))
		SetFont fontSmall
		Color 210, 220, 245
		If caught(i)
			DrawWrapped(journalText(i), 440, 352, 300, 18, 10000)
		Else
			Text 440, 352, "Seen, but not caught yet."
		EndIf
	Else
		Text 590, 136, "Unknown", True, True
		SetFont fontSmall
		Color 210, 220, 245
		Text 590, 300, "Not seen yet.", True, True
	EndIf
	DrawHint("Arrow keys choose. Escape goes back.")
End Function

Function DrawDen()
	DrawMenuBackground()
	DrawHeading("Den")
	SetFont fontText
	Color 255, 214, 90
	Text 40, 86, "Your team"
	Text SCREEN_W / 2 + 20, 86, "In the den (" + denCount + " / " + DEN_SIZE + ")"
	Local i, y, c.Creature
	For i = 0 To teamCount - 1
		y = 120 + i * 44
		If i = teamPick
			If denColumn = 0 Then Color 255, 214, 90 Else Color 120, 140, 200
			Rect 26, y - 2, SCREEN_W / 2 - 42, 44, 1
		EndIf
		DrawPanel(30, y, SCREEN_W / 2 - 50, 40)
		DrawSmallRow(team(i), 40, y)
	Next
	Local scroll = DenScroll()
	For i = scroll To Min(denCount - 1, scroll + 11)
		c = den(i)
		y = 120 + (i - scroll) * 32
		If i = denCursor And denColumn = 1
			Color 255, 214, 90
			Rect SCREEN_W / 2 + 6, y - 2, SCREEN_W / 2 - 32, 32, 1
		EndIf
		DrawPanel(SCREEN_W / 2 + 10, y, SCREEN_W / 2 - 40, 28)
		SetFont fontSmall
		Color 255, 255, 255
		Text SCREEN_W / 2 + 24, y + 6, speciesName(c\species)
		Color 210, 220, 245
		Text SCREEN_W / 2 + 160, y + 6, "Level " + c\level
		Local e = speciesElement(c\species)
		Color elementR(e), elementG(e), elementB(e)
		Text SCREEN_W / 2 + 250, y + 6, elementName(e)
	Next
	If denCount = 0
		SetFont fontSmall
		Color 190, 200, 235
		Text SCREEN_W * 3 / 4, 160, "Nobody is here yet.", True, True
	EndIf
