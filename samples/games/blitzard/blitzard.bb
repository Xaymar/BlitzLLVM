Function DrawScreen()
	Local shown = state
	If state = STATE_CHOICE Then shown = choiceReturn
	Select shown
		Case STATE_TITLE, STATE_OPTIONS, STATE_HELP
			DrawTitleBackground()
			If shown = STATE_TITLE Then DrawTitle()
			If shown = STATE_OPTIONS Then DrawOptions()
			If shown = STATE_HELP Then DrawHelp()
		Case STATE_STARTER : DrawStarter()
		Case STATE_FIELD, STATE_DIALOG, STATE_APPROACH, STATE_FIELD_MENU, STATE_SHOP
			DrawField()
			If shown = STATE_DIALOG Then DrawDialog()
			If shown = STATE_FIELD_MENU And state <> STATE_CHOICE Then DrawFieldMenu()
			If shown = STATE_SHOP Then DrawShop()
		Case STATE_TEAM : DrawTeam()
		Case STATE_SUMMARY : DrawSummary()
		Case STATE_BAG : DrawBag()
		Case STATE_JOURNAL : DrawJournal()
		Case STATE_DEN : DrawDen()
		Case STATE_TRANSITION : DrawField() : DrawTransition()
		Case STATE_BATTLE : DrawBattle()
		Case STATE_EVOLVE : DrawEvolve()
		Case STATE_CREDITS : DrawCredits()
	End Select
	If state = STATE_CHOICE
		; The choice box sits on top of the screen it came from.
		If choiceKind = CHOICE_TITLE_NEW
			DrawPanel(menuX - 30, menuTop - 70, menuW + 60, menuCount * menuLineH + 90)
			SetFont fontText
			Color 235, 240, 255
			Text SCREEN_W / 2, menuTop - 50, "Start over? Saving will replace", True, True
			Text SCREEN_W / 2, menuTop - 26, "the game saved now.", True, True
		Else
			DrawPanel(menuX - 10, menuTop - 10, menuW + 20, menuCount * menuLineH + 20)
		EndIf
		DrawMenu(False)
	EndIf
	If noticeTimer > 0
		SetFont fontText
		Local w = StringWidth(noticeText) + 40
		DrawPanel(SCREEN_W / 2 - w / 2, 12, w, 40)
		Color 255, 240, 200
		Text SCREEN_W / 2, 32, noticeText, True, True
