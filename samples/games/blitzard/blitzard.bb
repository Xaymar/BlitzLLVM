; --- Screen, settings and saving ------------------------------------------------------------------------------------

; Opens the window or full screen, as the option says. Graphics frees all images and fonts, so they are made again.
Function OpenScreen()
	If optFullscreen Then Graphics SCREEN_W, SCREEN_H, 0, 1 Else Graphics SCREEN_W, SCREEN_H, 0, 2
	AppTitle "Blitzard"
	SetBuffer BackBuffer()
	SeedRnd MilliSecs()
	fontTitle = LoadFont("Arial", 72, True)
	fontBig = LoadFont("Arial", 26, True)
	fontText = LoadFont("Arial", 20)
	fontSmall = LoadFont("Arial", 15)
	MakeTileImages()
	MakePersonImages()
	Local i
	For i = 1 To SPECIES_COUNT
		creatureFront(i) = MakeCreatureImage(i, 150, False)
		creatureBack(i) = MakeCreatureImage(i, 170, True)
		creatureIcon(i) = MakeCreatureImage(i, 40, True)
	Next
	imageOrb = MakeOrbImage(24, 70, 200, 210)
	imageGreatOrb = MakeOrbImage(24, 150, 90, 230)
	imageBubble = MakeBubbleImage()
	SetBuffer BackBuffer()
	watermark = 0
End Function

Function LoadSettings()
	If FileType(settingsPath) <> 1 Then Return
	Local file = ReadFile(settingsPath)
	If Not file Then Return
	If ReadInt(file) = 1 ; A version number, so a changed file format can be recognised later.
		optTextSpeed = ReadInt(file)
		optVolume = ReadInt(file)
		optAnimations = ReadInt(file)
		optDifficulty = ReadInt(file)
		optEncounters = ReadInt(file)
		optFullscreen = ReadInt(file)
	EndIf
	CloseFile file
	; Never trust a file: someone may have edited it.
	If optTextSpeed < 0 Or optTextSpeed > 3 Then optTextSpeed = 2
	If optVolume < 0 Or optVolume > 4 Then optVolume = 4
	If optDifficulty < 0 Or optDifficulty > 2 Then optDifficulty = 1
	If optEncounters < 0 Or optEncounters > 2 Then optEncounters = 1
End Function

Function SaveSettings()
	Local file = WriteFile(settingsPath)
	If Not file Then Return ; A read-only folder: the game still works, it just forgets the options.
	WriteInt file, 1
	WriteInt file, optTextSpeed
	WriteInt file, optVolume
	WriteInt file, optAnimations
	WriteInt file, optDifficulty
	WriteInt file, optEncounters
	WriteInt file, optFullscreen
	CloseFile file
End Function

Function SaveGame()
	Local file = WriteFile(savePath)
	If Not file Then Return False
	WriteInt file, SAVE_VERSION
	WriteInt file, playerX : WriteInt file, playerY : WriteInt file, playerFacing
	WriteInt file, respawnX : WriteInt file, respawnY
	WriteInt file, money : WriteInt file, playFrames : WriteInt file, champion
	Local i
	For i = 0 To ITEM_COUNT - 1
		WriteInt file, itemCount(i)
	Next
	For i = 1 To SPECIES_COUNT
		WriteByte file, seen(i)
		WriteByte file, caught(i)
	Next
	Local n.Npc
	For n = Each Npc
		WriteByte file, n\beaten
	Next
	WriteInt file, teamCount
	For i = 0 To teamCount - 1
		WriteCreature(file, team(i))
	Next
	WriteInt file, denCount
	For i = 0 To denCount - 1
		WriteCreature(file, den(i))
	Next
	CloseFile file
	Return True
End Function

Function WriteCreature(file, c.Creature)
	WriteInt file, c\species
	WriteInt file, c\level
	WriteInt file, c\xp
	WriteInt file, c\hp
	Local i
	For i = 0 To 3
		WriteInt file, c\move[i]
	Next
End Function

Function LoadGame()
	If FileType(savePath) <> 1 Then Return False
	Local file = ReadFile(savePath)
	If Not file Then Return False
	If ReadInt(file) <> SAVE_VERSION Then CloseFile file : Return False
	NewWorld()
	playerX = ReadInt(file) : playerY = ReadInt(file) : playerFacing = ReadInt(file) And 3
	respawnX = ReadInt(file) : respawnY = ReadInt(file)
	money = ReadInt(file) : playFrames = ReadInt(file) : champion = ReadInt(file)
	Local i
	For i = 0 To ITEM_COUNT - 1
		itemCount(i) = Max(0, Min(99, ReadInt(file)))
	Next
	For i = 1 To SPECIES_COUNT
		seen(i) = ReadByte(file)
		caught(i) = ReadByte(file)
	Next
	Local n.Npc
	For n = Each Npc
		n\beaten = ReadByte(file)
	Next
	teamCount = Min(TEAM_SIZE, Max(0, ReadInt(file)))
	For i = 0 To teamCount - 1
		team(i) = ReadCreature(file)
	Next
	denCount = Min(DEN_SIZE, Max(0, ReadInt(file)))
	For i = 0 To denCount - 1
		den(i) = ReadCreature(file)
	Next
	CloseFile file
	; A damaged file could put the player into a tree or leave an empty team: start over instead.
	If teamCount = 0 Or Not Walkable(playerX, playerY) Then Return False
	If Not Walkable(respawnX, respawnY) Then respawnX = 28 : respawnY = 58
	Return True
End Function

Function ReadCreature.Creature(file)
	Local species = ReadInt(file)
	If species < 1 Or species > SPECIES_COUNT Then species = 11
	Local level = Min(60, Max(1, ReadInt(file)))
	Local c.Creature = NewCreature(species, level)
	c\xp = Max(XPForLevel(level), ReadInt(file))
	c\hp = Min(c\maxHP, Max(0, ReadInt(file)))
	Local i, m
	For i = 0 To 3
		m = ReadInt(file)
		If m < -1 Or m >= MOVE_COUNT Then m = -1
		c\move[i] = m
	Next
	If c\move[0] = -1 Then c\move[0] = 0
	Return c
End Function

; Clears everything that belongs to one playthrough and puts the people back into the world.
Function NewWorld()
	Local i
	Delete Each Creature
	Delete Each Npc
	For i = 0 To TEAM_SIZE - 1
		team(i) = Null
	Next
	For i = 0 To DEN_SIZE - 1
		den(i) = Null
	Next
	For i = 0 To TEAM_SIZE - 1
		foe(i) = Null
	Next
	teamCount = 0 : denCount = 0
	For i = 1 To SPECIES_COUNT
		seen(i) = False
		caught(i) = False
	Next
	For i = 0 To ITEM_COUNT - 1
		itemCount(i) = 0
	Next
	itemCount(ITEM_ORB) = 5
	itemCount(ITEM_TONIC) = 2
	money = 1000
	playFrames = 0
	champion = False
	playerX = 8 : playerY = 58 : playerFacing = DIR_DOWN : playerStep = 0
	respawnX = 8 : respawnY = 58

	Restore npcData
	Local n.Npc, id
	Repeat
		Read id
		If id = 0 Then Exit
		n = New Npc
		n\id = id
		Read n\kind, n\name, n\x, n\y, n\facing, n\sight, n\look, n\reward, n\team, n\talk, n\after
	Forever
End Function

; Every sound goes through here, so the volume option works everywhere.
Function PlaySfx(sound)
	If sound = 0 Or optVolume = 0 Then Return
	Local channel = PlaySound(sound)
	ChannelVolume channel, optVolume / 4.0
End Function

Function Notice(text$)
	noticeText = text
	noticeTimer = 150
End Function

; --- Blitzlings ----------------------------------------------------------------------------------------------------------

Function NewCreature.Creature(species, level)
	Local c.Creature = New Creature
	c\species = species
	c\level = level
	c\xp = XPForLevel(level)
	Local i
	For i = 0 To 3
		c\move[i] = -1
	Next
	; Learn every move up to this level in order. LearnMove drops the weakest move once all four slots are used.
	Local lv
	For lv = 1 To level
		LearnMovesAt(c, lv, False)
	Next
	CalcStats(c)
	c\hp = c\maxHP
	Return c
End Function

Function CalcStats(c.Creature)
	Local s = c\species
	Local oldMax = c\maxHP
	c\maxHP = baseHP(s) * 2 * c\level / 100 + c\level + 10
	c\atk = baseAtk(s) * 2 * c\level / 100 + 5
	c\def = baseDef(s) * 2 * c\level / 100 + 5
	c\spd = baseSpd(s) * 2 * c\level / 100 + 5
	; Growing keeps the damage already taken, like a cup that got bigger.
	If oldMax > 0 And c\hp > 0 Then c\hp = Min(c\maxHP, c\hp + c\maxHP - oldMax)
End Function

; Total experience needed to reach a level. Half of level cubed, so a playthrough needs little grinding.
Function XPForLevel(level)
	Return level * level * level / 2
End Function

; How far a blitzling is towards its next level, from 0 to 1.
Function XPFraction#(c.Creature)
	If c\level >= 60 Then Return 0
	Local low = XPForLevel(c\level), high = XPForLevel(c\level + 1)
	Return Float(c\xp - low) / (high - low)
End Function

; Learns the moves of the species for one level. Gives back the text to show, or "" if nothing was learned.
Function LearnMovesAt$(c.Creature, level, wantText)
	Local list$ = learnset(c\species), result$ = ""
	While list <> ""
		Local comma = Instr(list, ",")
		Local entry$
		If comma = 0 Then entry = list : list = "" Else entry = Left(list, comma - 1) : list = Mid(list, comma + 1)
		Local colon = Instr(entry, ":")
		If Int(Left(entry, colon - 1)) = level
			Local text$ = LearnMove(c, Int(Mid(entry, colon + 1)))
			If wantText And text <> ""
				If result <> "" Then result = result + "|"
				result = result + text
			EndIf
		EndIf
	Wend
	Return result
End Function

; Puts a move into a free slot, or in place of the weakest move. Moves without damage count as power 50.
Function LearnMove$(c.Creature, m)
	Local i
	For i = 0 To 3
		If c\move[i] = m Then Return ""
	Next
	Local name$ = speciesName(c\species)
	For i = 0 To 3
		If c\move[i] = -1
			c\move[i] = m
			Return name + " learned " + moveName(m) + "!"
		EndIf
	Next
	Local weakest = 0, weakestPower = 1000, p
	For i = 0 To 3
		p = movePower(c\move[i])
		If p = 0 Then p = 50
		If p < weakestPower Then weakest = i : weakestPower = p
	Next
	Local old = c\move[weakest]
	c\move[weakest] = m
	Return name + " forgot " + moveName(old) + " and learned " + moveName(m) + "!"
End Function

; Adds a caught blitzling to the team, or to the den when the team is full.
Function AddToTeam(c.Creature)
	If teamCount < TEAM_SIZE
		team(teamCount) = c
		teamCount = teamCount + 1
		Return True
	EndIf
	If denCount < DEN_SIZE
		den(denCount) = c
		denCount = denCount + 1
	EndIf
	Return False
End Function

Function HealTeam()
	Local i
	For i = 0 To teamCount - 1
		team(i)\hp = team(i)\maxHP
	Next
End Function

Function AliveCount()
	Local i, n = 0
	For i = 0 To teamCount - 1
		If team(i)\hp > 0 Then n = n + 1
	Next
	Return n
End Function

Function FirstAlive()
	Local i
	For i = 0 To teamCount - 1
		If team(i)\hp > 0 Then Return i
	Next
	Return -1
End Function

; Makes a team from "species:level,..." for a tamer. The difficulty moves the levels.
Function MakeFoeTeam(spec$)
	Local i
	For i = 0 To TEAM_SIZE - 1
		If foe(i) <> Null Then Delete foe(i)
		foe(i) = Null
	Next
	foeCount = 0
	While spec <> "" And foeCount < TEAM_SIZE
		Local comma = Instr(spec, ",")
		Local entry$
		If comma = 0 Then entry = spec : spec = "" Else entry = Left(spec, comma - 1) : spec = Mid(spec, comma + 1)
		Local colon = Instr(entry, ":")
		Local level = Int(Mid(entry, colon + 1)) + (optDifficulty - 1) * 2
		foe(foeCount) = NewCreature(Int(Left(entry, colon - 1)), Max(2, level))
		foeCount = foeCount + 1
	Wend
End Function

; --- Menus ---------------------------------------------------------------------------------------------------------
; A menu is a list of lines and the number of the selected one. The keyboard moves the selection, the mouse selects
; the line it is over. MenuInput gives back the line chosen with Enter, Space, Z or a click, -2 for back, or -1.

Function SetMenu(count, x, top, w, lineH)
	menuCount = count
	menuX = x : menuTop = top : menuW = w : menuLineH = lineH
	menuSelected = 0
	ForgetInput()
End Function

; Forgets keys and clicks made on the last screen, so they do not act on the new one too.
Function ForgetInput()
	FlushKeys
	FlushMouse
	MouseXSpeed() ; Forget old mouse movement, so a mouse resting over a menu does not pick a line.
	MouseYSpeed()
End Function

Function ConfirmHit()
	Return KeyHit(KEY_ENTER) Or KeyHit(KEY_SPACE) Or KeyHit(KEY_Z)
End Function

Function BackHit()
	Return KeyHit(KEY_ESCAPE) Or KeyHit(KEY_BACKSPACE) Or KeyHit(KEY_X) Or MouseHit(2)
End Function

Function MenuInput()
	If menuCount = 0 Then Return -1
	If KeyHit(KEY_UP) Or KeyHit(KEY_W) Then menuSelected = (menuSelected + menuCount - 1) Mod menuCount : PlaySfx(soundMove)
	If KeyHit(KEY_DOWN) Or KeyHit(KEY_S) Then menuSelected = (menuSelected + 1) Mod menuCount : PlaySfx(soundMove)

	Local line = MenuLineAt(MouseX(), MouseY())
	If line >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then menuSelected = line

	If BackHit() Then Return -2
	If ConfirmHit() Then PlaySfx(soundSelect) : Return menuSelected
	If MouseHit(1) And line >= 0
		menuSelected = line
		PlaySfx(soundSelect)
		Return line
	EndIf
	Return -1
End Function

Function MenuLineAt(x, y)
	If x < menuX Or x >= menuX + menuW Or y < menuTop Then Return -1
	Local line = (y - menuTop) / menuLineH
	If line >= menuCount Then Return -1
	Return line
End Function

; Draws the menu lines centred, or left-aligned with a small margin.
Function DrawMenu(centred)
	Local i, y
	SetFont fontText
	For i = 0 To menuCount - 1
		y = menuTop + i * menuLineH
		If i = menuSelected
			Color 255, 214, 90
			Rect menuX, y + 1, menuW, menuLineH - 2, 1
			Color 40, 30, 20
		Else
			Color 245, 245, 250
		EndIf
		If centred
			Text menuX + menuW / 2, y + menuLineH / 2, menuText(i), True, True
		Else
			Text menuX + 14, y + menuLineH / 2, menuText(i), False, True
		EndIf
	Next
End Function

; --- Title screen ------------------------------------------------------------------------------------------------------

Function GoToTitle()
	state = STATE_TITLE
	titleHasSave = (FileType(savePath) = 1)
	Local i = 0
	If titleHasSave Then menuText(i) = "Continue" : i = i + 1
	menuText(i) = "New game" : i = i + 1
	menuText(i) = "Options" : i = i + 1
	menuText(i) = "How to play" : i = i + 1
	menuText(i) = "Quit"
	SetMenu(i + 1, SCREEN_W / 2 - 150, 330, 300, 40)
End Function

; Gives back True when the player chose Quit.
Function UpdateTitle()
	Local chosen = MenuInput()
	If chosen = -2 Then Return True
	If chosen < 0 Then Return False
	If Not titleHasSave Then chosen = chosen + 1 ; Without a save the lines start at "New game".
	Select chosen
		Case 0
			If LoadGame()
				EnterField()
			Else
				titleHasSave = False
				Notice("The saved game could not be read.")
				GoToTitle()
			EndIf
		Case 1
			If titleHasSave
				OpenChoice(CHOICE_TITLE_NEW, STATE_TITLE)
			Else
				StartNewGame()
			EndIf
		Case 2 : GoToOptions(STATE_TITLE)
		Case 3 : GoToHelp(STATE_TITLE)
		Case 4 : Return True
	End Select
	Return False
End Function

Function StartNewGame()
	NewWorld()
	state = STATE_STARTER
	starterCursor = 0
	ForgetInput()
End Function

; --- Options and help ----------------------------------------------------------------------------------------------------

Function GoToOptions(from)
	returnState = from
	state = STATE_OPTIONS
	SetMenu(7, SCREEN_W / 2 - 200, 200, 400, 40)
	RefreshOptionsText()
End Function

Function RefreshOptionsText()
	menuText(0) = "Text speed: " + textSpeedName(optTextSpeed)
	menuText(1) = "Sound volume: " + (optVolume * 25) + "%"
	If optAnimations Then menuText(2) = "Battle animations: on" Else menuText(2) = "Battle animations: off"
	menuText(3) = "Difficulty: " + difficultyName(optDifficulty)
	menuText(4) = "Wild encounters: " + encounterName(optEncounters)
	If optFullscreen Then menuText(5) = "Display: full screen" Else menuText(5) = "Display: window"
	menuText(6) = "Back"
End Function

Function UpdateOptions()
	Local change = 0
	If KeyHit(KEY_LEFT) Or KeyHit(KEY_A) Then change = -1
	If KeyHit(KEY_RIGHT) Or KeyHit(KEY_D) Then change = 1
	Local chosen = MenuInput()
	If chosen >= 0 Then change = 1 ; Enter or a click steps to the next value.

	If chosen = -2 Or chosen = 6
		SaveSettings()
		LeaveOptions()
		Return
	EndIf
	If change = 0 Then Return

	Select menuSelected
		Case 0 : optTextSpeed = (optTextSpeed + change + 4) Mod 4
		Case 1 : optVolume = (optVolume + change + 5) Mod 5
		Case 2 : optAnimations = Not optAnimations
		Case 3 : optDifficulty = (optDifficulty + change + 3) Mod 3
		Case 4 : optEncounters = (optEncounters + change + 3) Mod 3
		Case 5
			optFullscreen = Not optFullscreen
			OpenScreen()
	End Select
	If chosen < 0 Then PlaySfx(soundMove)
	RefreshOptionsText()
End Function

Function LeaveOptions()
	If returnState = STATE_TITLE
		GoToTitle()
		menuSelected = 1 + titleHasSave ; Back on "Options".
	Else
		OpenFieldMenu()
		menuSelected = 5
	EndIf
End Function

Function GoToHelp(from)
	returnState = from
	state = STATE_HELP
	ForgetInput()
End Function

Function UpdateHelp()
	If BackHit() Or ConfirmHit() Or MouseHit(1)
		PlaySfx(soundSelect)
		If returnState = STATE_TITLE
			GoToTitle()
			menuSelected = 2 + titleHasSave
		Else
			OpenFieldMenu()
			menuSelected = 6
		EndIf
	EndIf
End Function

; --- Choosing the first blitzling ----------------------------------------------------------------------------------------

Function UpdateStarter()
	If KeyHit(KEY_LEFT) Or KeyHit(KEY_A) Then starterCursor = (starterCursor + 2) Mod 3 : PlaySfx(soundMove)
	If KeyHit(KEY_RIGHT) Or KeyHit(KEY_D) Then starterCursor = (starterCursor + 1) Mod 3 : PlaySfx(soundMove)
	Local i, over = -1
	For i = 0 To 2
		If MouseX() >= 70 + i * 230 And MouseX() < 70 + i * 230 + 200 And MouseY() >= 140 And MouseY() < 470 Then over = i
	Next
	If over >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then starterCursor = over
	If BackHit() Then GoToTitle() : Return
	Local chosen = False
	If ConfirmHit() Then chosen = True
	If MouseHit(1) And over >= 0 Then starterCursor = over : chosen = True
	If Not chosen Then Return

	PlaySfx(soundSelect)
	Local species = 1 + starterCursor * 2
	AddToTeam(NewCreature(species, 5))
	seen(species) = True
	caught(species) = True
	EnterField()
	OpenDialog("Mom: " + speciesName(species) + " suits you! Take these Blitz Orbs and Tonics too.|Mom: Walk north through the tall grass. Wild blitzlings hide there.|Mom: Press Escape any time to open your menu. And save your game now and then!", ACTION_NONE, Null)
End Function

; --- The field ---------------------------------------------------------------------------------------------------------

Function EnterField()
	state = STATE_FIELD
	areaName = AreaName(playerY)
	ForgetInput()
End Function

Function AreaName$(y)
	If y <= 10 Then Return "Blitzard Peak"
	If y <= 26 Then Return "Ashpeak Cave"
	If y <= 39 Then Return "Mirelake"
	If y <= 52 Then Return "Meadow Path"
	Return "Hollowmere"
End Function

Function TileAt$(x, y)
	If x < 0 Or y < 0 Or x >= MAP_W Or y >= MAP_H Then Return "#"
	Return mapTile(x, y)
End Function

; Ground you can stand on, people aside.
Function OpenGround(x, y)
	Return Instr(".,;=bf+c", TileAt(x, y)) > 0
End Function

Function NpcAt.Npc(x, y)
	Local n.Npc
	For n = Each Npc
		If n\x = x And n\y = y Then Return n
	Next
	Return Null
End Function

Function Walkable(x, y)
	If Not OpenGround(x, y) Then Return False
	Return NpcAt(x, y) = Null
End Function

Function DirX(d)
	If d = DIR_LEFT Then Return -1
	If d = DIR_RIGHT Then Return 1
	Return 0
End Function

Function DirY(d)
	If d = DIR_UP Then Return -1
	If d = DIR_DOWN Then Return 1
	Return 0
End Function

Function DirectionDown(d)
	Select d
		Case DIR_UP : Return KeyDown(KEY_UP) Or KeyDown(KEY_W)
		Case DIR_DOWN : Return KeyDown(KEY_DOWN) Or KeyDown(KEY_S)
		Case DIR_LEFT : Return KeyDown(KEY_LEFT) Or KeyDown(KEY_A)
	End Select
	Return KeyDown(KEY_RIGHT) Or KeyDown(KEY_D)
End Function

; Called every field frame. A newly pressed key takes over from one that is still held, and a tap shorter
; than a frame still counts.
Function HeldDirection()
	Local hit = -1
	If KeyHit(KEY_UP) Or KeyHit(KEY_W) Then hit = DIR_UP
	If KeyHit(KEY_DOWN) Or KeyHit(KEY_S) Then hit = DIR_DOWN
	If KeyHit(KEY_LEFT) Or KeyHit(KEY_A) Then hit = DIR_LEFT
	If KeyHit(KEY_RIGHT) Or KeyHit(KEY_D) Then hit = DIR_RIGHT
	If hit >= 0 Then lastDirection = hit : Return hit
	If lastDirection >= 0 And DirectionDown(lastDirection) Then Return lastDirection
	lastDirection = -1
	Local d
	For d = DIR_DOWN To DIR_RIGHT
		If DirectionDown(d) Then Return d
	Next
	Return -1
End Function

Global bumpTimer

Function UpdateField()
	Local d = HeldDirection()
	If playerStep > 0
		; Walking into the next tile. playerStep counts the pixels left; the position is already the new tile.
		playerStep = playerStep - stepLength
		If playerStep > 0.01 Then Return
		playerStep = 0
		ArriveOnTile()
		; Keep walking in the same frame when nothing happened on arrival, so held keys never pause between tiles.
		If state <> STATE_FIELD Then Return
	EndIf

	If BackHit() Then PlaySfx(soundSelect) : OpenFieldMenu() : Return
	If ConfirmHit() Then Interact() : Return

	If d < 0 Then Return
	playerFacing = d
	Local nx = playerX + DirX(d), ny = playerY + DirY(d)
	If Walkable(nx, ny)
		playerX = nx : playerY = ny
		playerStep = TILE
		If KeyDown(KEY_LSHIFT) Or KeyDown(KEY_RSHIFT) Then stepLength = TILE / 6.0 Else stepLength = TILE / 11.0
		walkFrame = 1 - walkFrame
	Else
		bumpTimer = bumpTimer - 1
		If bumpTimer <= 0 Then PlaySfx(soundBump) : bumpTimer = 20
	EndIf
End Function

Function ArriveOnTile()
	Local area$ = AreaName(playerY)
	If area <> areaName Then areaName = area : areaTimer = 150

	; A tamer who sees you comes over first.
	Local n.Npc
	For n = Each Npc
		If n\kind = NPC_TAMER And (Not n\beaten) And Sees(n)
			approachNpc = n
			approachTimer = 50
			state = STATE_APPROACH
			PlaySfx(soundSpotted)
			Return
		EndIf
	Next

	Local region = -1, chance = 10
	Select TileAt(playerX, playerY)
		Case "," : region = REGION_MEADOW
		Case ";" : region = REGION_MARSH
		Case "c" : region = REGION_CAVE : chance = 14
	End Select
	If region < 0 Then Return
	If optEncounters = 0 Then chance = chance * 2
	If optEncounters = 2 Then chance = chance * 3 / 5
	If Rand(1, chance) = 1 Then StartWildBattle(region)
End Function

; True when the player stands in a tamer's line of sight, with nothing in between.
Function Sees(n.Npc)
	Local i, x, y
	For i = 1 To n\sight
		x = n\x + DirX(n\facing) * i
		y = n\y + DirY(n\facing) * i
		If x = playerX And y = playerY Then Return True
		If Not Walkable(x, y) Then Return False
	Next
	Return False
End Function

; A tamer who spotted the player shows a bubble, walks up and starts talking.
Function UpdateApproach()
	Local n.Npc = approachNpc
	If approachTimer > 0 Then approachTimer = approachTimer - 1 : Return
	If n\offset > 0
		n\offset = n\offset - 2
		Return
	EndIf
	Local nx = n\x + DirX(n\facing), ny = n\y + DirY(n\facing)
	If nx = playerX And ny = playerY
		playerFacing = Opposite(n\facing)
		OpenDialog(n\talk, ACTION_BATTLE, n)
		Return
	EndIf
	n\x = nx : n\y = ny
	n\offset = TILE
End Function

Function Opposite(d)
	Select d
		Case DIR_UP : Return DIR_DOWN
		Case DIR_DOWN : Return DIR_UP
		Case DIR_LEFT : Return DIR_RIGHT
	End Select
	Return DIR_LEFT
End Function

; Talks to whoever or whatever is in front of the player.
Function Interact()
	Local fx = playerX + DirX(playerFacing), fy = playerY + DirY(playerFacing)
	Local n.Npc = NpcAt(fx, fy)
	If n <> Null
		n\facing = Opposite(playerFacing)
		If n\kind = NPC_TAMER
			If n\beaten Then OpenDialog(n\after, ACTION_NONE, n) Else OpenDialog(n\talk, ACTION_BATTLE, n)
		Else
			OpenDialog(n\talk, ACTION_NONE, n)
		EndIf
		Return
	EndIf
	Select TileAt(fx, fy)
		Case "D"
			respawnX = 8 : respawnY = 58
			OpenDialog("Mom: Welcome home! Have a rest.|Your blitzlings are fully healed.", ACTION_HEAL, Null)
		Case "H"
			PlaySfx(soundSelect)
			OpenChoice(CHOICE_SHRINE, STATE_FIELD)
		Case "M"
			OpenDialog("Shopkeeper: Welcome! What can I get you?", ACTION_SHOP, Null)
		Case "i"
			OpenDialog("Hollowmere village. North: Meadow Path, Mirelake, Ashpeak Cave and Blitzard Peak.", ACTION_NONE, Null)
		Case "h"
			respawnX = 20 : respawnY = 10
			OpenDialog("The warm stone glows softly.|Your blitzlings are fully healed.", ACTION_FIELD_HEAL, Null)
		Case "A"
			OpenDialog("An old altar. Storm clouds and a great winged blitzling are carved into the stone.", ACTION_NONE, Null)
		Case "~"
			OpenDialog("The water is deep and cold. Better stay on dry land.", ACTION_NONE, Null)
	End Select
End Function

; After losing every battle-ready blitzling the player wakes up at the last place that healed the team.
Function BlackOut()
	money = money / 2
	HealTeam()
	playerX = respawnX : playerY = respawnY : playerFacing = DIR_DOWN : playerStep = 0
	EnterField()
	OpenDialog("You hurried back to safety and nursed your team back to health.|You dropped half of your coins on the way.", ACTION_NONE, Null)
End Function

; --- Dialog --------------------------------------------------------------------------------------------------------------

; Shows pages of text split by "|". The action runs after the last page.
Function OpenDialog(pages$, action, n.Npc)
	dialogCount = 0
	While pages <> "" And dialogCount < 16
		Local bar = Instr(pages, "|")
		If bar = 0
			dialogPage(dialogCount) = pages : pages = ""
		Else
			dialogPage(dialogCount) = Left(pages, bar - 1) : pages = Mid(pages, bar + 1)
		EndIf
		dialogCount = dialogCount + 1
	Wend
	dialogIndex = 0
	dialogTyped = 0
	dialogAction = action
	dialogNpc = n
	If n <> Null Then dialogName = n\name Else dialogName = ""
	state = STATE_DIALOG
	ForgetInput()
End Function

Function TextSpeed#()
	Select optTextSpeed
		Case 0 : Return 0.6
		Case 1 : Return 1.2
		Case 2 : Return 2.5
	End Select
	Return 1000
End Function

Function UpdateDialog()
	Local length = Len(dialogPage(dialogIndex))
	dialogTyped = dialogTyped + TextSpeed()
	Local pressed = ConfirmHit() Or MouseHit(1) Or BackHit()
	If Not pressed Then Return
	If dialogTyped < length Then dialogTyped = Float(length) : Return ; The first press shows the whole page.
	PlaySfx(soundMove)
	dialogIndex = dialogIndex + 1
	dialogTyped = 0
	If dialogIndex < dialogCount Then Return

	EnterField()
	Select dialogAction
		Case ACTION_BATTLE : StartTamerBattle(dialogNpc)
		Case ACTION_HEAL, ACTION_FIELD_HEAL : HealTeam() : PlaySfx(soundHeal)
		Case ACTION_SHOP : OpenShop()
	End Select
End Function

; --- Choices ---------------------------------------------------------------------------------------------------------------

Function OpenChoice(kind, from)
	choiceKind = kind
	choiceReturn = from
	state = STATE_CHOICE
	Select kind
		Case CHOICE_SHRINE
			menuText(0) = "Heal my team" : menuText(1) = "Open the den" : menuText(2) = "Leave"
			SetMenu(3, SCREEN_W - 300, SCREEN_H - 290, 260, 36)
		Case CHOICE_TEAM
			If teamMode = TEAM_SWITCH Or teamMode = TEAM_FORCED
				menuText(0) = "Send out"
			Else
				menuText(0) = "Move in the team"
			EndIf
			menuText(1) = "Summary" : menuText(2) = "Cancel"
			SetMenu(3, SCREEN_W - 300, SCREEN_H - 170, 260, 36)
		Case CHOICE_QUIT
			menuText(0) = "Back to the title screen" : menuText(1) = "Keep playing"
			SetMenu(2, SCREEN_W / 2 - 180, 300, 360, 36)
		Case CHOICE_TITLE_NEW
			menuText(0) = "Start a new game" : menuText(1) = "Back"
			SetMenu(2, SCREEN_W / 2 - 180, 330, 360, 36)
	End Select
End Function

Function UpdateChoice()
	Local chosen = MenuInput()
	If chosen = -1 Then Return
	Select choiceKind
		Case CHOICE_SHRINE
			EnterField()
			If chosen = 0
				respawnX = 28 : respawnY = 58
				OpenDialog("Shrine keeper: Rest here, little ones.|Your blitzlings are fully healed.", ACTION_HEAL, Null)
			ElseIf chosen = 1
				OpenDen()
			EndIf
		Case CHOICE_TEAM
			state = STATE_TEAM
			If chosen = 0
				If teamMode = TEAM_VIEW
					swapFrom = teamPick ; Choose where to move it next.
				Else
					TeamSendOut()
				EndIf
			ElseIf chosen = 1
				summaryCreature = team(teamPick)
				state = STATE_SUMMARY
				ForgetInput()
			EndIf
		Case CHOICE_QUIT
			If chosen = 0 Then GoToTitle() Else OpenFieldMenu() : menuSelected = 7
		Case CHOICE_TITLE_NEW
			If chosen = 0 Then StartNewGame() Else GoToTitle()
	End Select
End Function

; --- The field menu (also the pause menu) ------------------------------------------------------------------------------

Function OpenFieldMenu()
	state = STATE_FIELD_MENU
	menuText(0) = "Team"
	menuText(1) = "Bag"
	menuText(2) = "Journal"
	menuText(3) = "Save the game"
	menuText(4) = "Resume"
	menuText(5) = "Options"
	menuText(6) = "How to play"
	menuText(7) = "Title screen"
	SetMenu(8, SCREEN_W - 270, 120, 230, 38)
End Function

Function UpdateFieldMenu()
	Select MenuInput()
		Case -2, 4 : EnterField()
		Case 0 : OpenTeam(TEAM_VIEW, STATE_FIELD_MENU)
		Case 1 : OpenBag(BAG_FIELD)
		Case 2 : journalCursor = 1 : state = STATE_JOURNAL : ForgetInput()
		Case 3
			If SaveGame() Then Notice("The game was saved.") Else Notice("The game could not be saved here.")
			EnterField()
		Case 5 : GoToOptions(STATE_FIELD_MENU)
		Case 6 : GoToHelp(STATE_FIELD_MENU)
		Case 7 : OpenChoice(CHOICE_QUIT, STATE_FIELD_MENU)
	End Select
	Return False
End Function

; --- Team screen -----------------------------------------------------------------------------------------------------------

Function OpenTeam(mode, from)
	teamMode = mode
	returnState = from
	state = STATE_TEAM
	swapFrom = -1
	If mode = TEAM_FORCED
		teamPick = FirstAlive()
	ElseIf mode = TEAM_SWITCH
		teamPick = playerActive
	Else
		teamPick = 0
	EndIf
	ForgetInput()
End Function

; The rows of the team screen: 6 rows of 70 pixels from y = 90.
Function TeamRowAt(x, y)
	If x < 60 Or x >= SCREEN_W - 60 Or y < 90 Then Return -1
	Local row = (y - 90) / 70
	If row >= teamCount Then Return -1
	Return row
End Function

Function UpdateTeam()
	If KeyHit(KEY_UP) Or KeyHit(KEY_W) Then teamPick = (teamPick + teamCount - 1) Mod teamCount : PlaySfx(soundMove)
	If KeyHit(KEY_DOWN) Or KeyHit(KEY_S) Then teamPick = (teamPick + 1) Mod teamCount : PlaySfx(soundMove)
	Local over = TeamRowAt(MouseX(), MouseY())
	If over >= 0 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0) Then teamPick = over

	If BackHit()
		If swapFrom >= 0 Then swapFrom = -1 : Return
		Select teamMode
			Case TEAM_VIEW : OpenFieldMenu()
			Case TEAM_ITEM : If returnState = STATE_BATTLE Then OpenBag(BAG_BATTLE) Else OpenBag(BAG_FIELD)
			Case TEAM_SWITCH : state = STATE_BATTLE : OpenActionMenu() : menuSelected = 2
			Case TEAM_FORCED : Notice("Choose a blitzling to send out.")
		End Select
		Return
	EndIf

	Local chosen = ConfirmHit()
	If MouseHit(1) And over >= 0 Then teamPick = over : chosen = True
	If Not chosen Then Return
	PlaySfx(soundSelect)

	If swapFrom >= 0
		Local c.Creature = team(swapFrom)
		team(swapFrom) = team(teamPick)
		team(teamPick) = c
		swapFrom = -1
		Return
	EndIf
	If teamMode = TEAM_ITEM
		UseItemOn(team(teamPick))
	Else
		OpenChoice(CHOICE_TEAM, STATE_TEAM)
	EndIf
End Function

; Sends the chosen team member into battle, from the switch or forced-switch screen.
Function TeamSendOut()
	Local c.Creature = team(teamPick)
	If c\hp <= 0 Then Notice(speciesName(c\species) + " has no strength left to battle.") : Return
	If teamPick = playerActive And teamMode = TEAM_SWITCH Then Notice(speciesName(c\species) + " is already battling.") : Return
	state = STATE_BATTLE
	ForgetInput()
	If teamMode = TEAM_FORCED
		BeginSteps()
		SwitchIn(teamPick)
		battleAfter = AFTER_ACTION
	Else
		PlayerTurn(1, teamPick)
	EndIf
End Function

Function UpdateSummary()
	If BackHit() Or ConfirmHit() Or MouseHit(1)
		PlaySfx(soundSelect)
		state = STATE_TEAM
		ForgetInput()
	EndIf
End Function

; --- Bag -----------------------------------------------------------------------------------------------------------------------

Function OpenBag(mode)
	bagMode = mode
	state = STATE_BAG
	Local i
	For i = 0 To ITEM_COUNT - 1
		menuText(i) = itemName(i) + "   x" + itemCount(i)
	Next
	menuText(ITEM_COUNT) = "Back"
	SetMenu(ITEM_COUNT + 1, 80, 130, 400, 44)
End Function

Function UpdateBag()
	Local chosen = MenuInput()
	If chosen = -1 Then Return
	If chosen = -2 Or chosen = ITEM_COUNT
		If bagMode = BAG_FIELD Then OpenFieldMenu() : menuSelected = 1 Else state = STATE_BATTLE : OpenActionMenu() : menuSelected = 1
		Return
	EndIf
	If itemCount(chosen) <= 0 Then Notice("You have no " + itemName(chosen) + " left.") : Return
	pendingItem = chosen
	If chosen = ITEM_ORB Or chosen = ITEM_GREAT_ORB
		If bagMode = BAG_FIELD Then Notice("Orbs are thrown at wild blitzlings in battle.") : Return
		If battleTamer <> Null Then Notice("You can't catch a tamer's blitzling!") : Return
		If teamCount >= TEAM_SIZE And denCount >= DEN_SIZE Then Notice("Your team and the den are both full.") : Return
		state = STATE_BATTLE
		ForgetInput()
		PlayerTurn(2, chosen)
		Return
	EndIf
	If bagMode = BAG_FIELD Then OpenTeam(TEAM_ITEM, STATE_BAG) Else OpenTeam(TEAM_ITEM, STATE_BATTLE)
End Function

; Uses a tonic or revive seed on a team member from the team screen.
Function UseItemOn(c.Creature)
	Local name$ = speciesName(c\species)
	If pendingItem = ITEM_TONIC
		If c\hp <= 0 Then Notice(name + " has fainted. A Revive Seed would help.") : Return
		If c\hp >= c\maxHP Then Notice(name + " is already healthy.") : Return
	ElseIf pendingItem = ITEM_REVIVE
		If c\hp > 0 Then Notice(name + " has not fainted.") : Return
	EndIf
	If returnState = STATE_BATTLE
		state = STATE_BATTLE
		ForgetInput()
		PlayerTurn(3, teamPick)
		Return
	EndIf
	Notice(ApplyItem(c))
	PlaySfx(soundHeal)
	OpenBag(BAG_FIELD)
	menuSelected = pendingItem
End Function

; Uses up the pending item on a blitzling and gives back what happened.
Function ApplyItem$(c.Creature)
	itemCount(pendingItem) = itemCount(pendingItem) - 1
	Local name$ = speciesName(c\species), oldHP = c\hp
	If pendingItem = ITEM_TONIC
		c\hp = Min(c\maxHP, c\hp + 50)
		Return name + " got back " + (c\hp - oldHP) + " health."
	EndIf
	c\hp = Max(1, c\maxHP / 2)
	Return name + " is awake again!"
End Function

; --- Journal ---------------------------------------------------------------------------------------------------------------

Function UpdateJournal()
	If KeyHit(KEY_LEFT) Or KeyHit(KEY_A) Then journalCursor = journalCursor - 1 : PlaySfx(soundMove)
	If KeyHit(KEY_RIGHT) Or KeyHit(KEY_D) Then journalCursor = journalCursor + 1 : PlaySfx(soundMove)
	If KeyHit(KEY_UP) Or KeyHit(KEY_W) Then journalCursor = journalCursor - 4 : PlaySfx(soundMove)
	If KeyHit(KEY_DOWN) Or KeyHit(KEY_S) Then journalCursor = journalCursor + 4 : PlaySfx(soundMove)
	journalCursor = (journalCursor - 1 + SPECIES_COUNT) Mod SPECIES_COUNT + 1
	Local mx = MouseX() - 40, my = MouseY() - 110
	If mx >= 0 And mx < 4 * 90 And my >= 0 And my < 4 * 100 And (MouseXSpeed() <> 0 Or MouseYSpeed() <> 0)
		journalCursor = 1 + (my / 100) * 4 + mx / 90
	EndIf
	If BackHit() Or ConfirmHit() Or MouseHit(1) Then PlaySfx(soundSelect) : OpenFieldMenu() : menuSelected = 2
End Function

; --- Shop --------------------------------------------------------------------------------------------------------------------

Function OpenShop()
	state = STATE_SHOP
	RefreshShop()
	SetMenu(ITEM_COUNT + 1, 80, 150, 460, 44)
End Function

Function RefreshShop()
	Local i
	For i = 0 To ITEM_COUNT - 1
		menuText(i) = itemName(i) + "  -  " + itemPrice(i) + " coins"
	Next
	menuText(ITEM_COUNT) = "Leave"
End Function

Function UpdateShop()
	Local chosen = MenuInput()
	If chosen = -1 Then Return
	If chosen = -2 Or chosen = ITEM_COUNT
		EnterField()
		OpenDialog("Shopkeeper: Thank you, come again!", ACTION_NONE, Null)
		Return
	EndIf
	If money < itemPrice(chosen) Then Notice("You don't have enough coins.") : Return
	If itemCount(chosen) >= 99 Then Notice("Your bag can't hold more of those.") : Return
	money = money - itemPrice(chosen)
	itemCount(chosen) = itemCount(chosen) + 1
	PlaySfx(soundBuy)
	Notice("You bought a " + itemName(chosen) + ".")
End Function

; --- Den -----------------------------------------------------------------------------------------------------------------------
; The team is on the left, the den on the right. Left and Right switch sides.

Function OpenDen()
	state = STATE_DEN
	denColumn = 0
	teamPick = 0
	denCursor = 0
	ForgetInput()
End Function

Function UpdateDen()
	Local count = teamCount
	If denColumn = 1 Then count = Max(1, denCount)
	Local cursor = teamPick
	If denColumn = 1 Then cursor = denCursor
	If KeyHit(KEY_UP) Or KeyHit(KEY_W) Then cursor = (cursor + count - 1) Mod count : PlaySfx(soundMove)
	If KeyHit(KEY_DOWN) Or KeyHit(KEY_S) Then cursor = (cursor + 1) Mod count : PlaySfx(soundMove)
	If KeyHit(KEY_LEFT) Or KeyHit(KEY_A) Or KeyHit(KEY_RIGHT) Or KeyHit(KEY_D)
		denColumn = 1 - denColumn
		PlaySfx(soundMove)
		If denColumn = 1 Then cursor = denCursor Else cursor = teamPick
	EndIf
	; The mouse: team rows are 44 pixels from y = 120 on the left, den rows 32 pixels on the right.
	If MouseXSpeed() <> 0 Or MouseYSpeed() <> 0
		Local row
		If MouseX() < SCREEN_W / 2
			row = (MouseY() - 120) / 44
			If MouseY() >= 120 And row < teamCount Then denColumn = 0 : cursor = row
		Else
			row = (MouseY() - 120) / 32 + DenScroll()
			If MouseY() >= 120 And MouseY() < 120 + 12 * 32 And row < denCount Then denColumn = 1 : cursor = row
		EndIf
	EndIf
	If denColumn = 0 Then teamPick = Min(cursor, teamCount - 1) Else denCursor = cursor

	If BackHit() Then PlaySfx(soundSelect) : EnterField() : Return
	If Not (ConfirmHit() Or MouseHit(1)) Then Return

	Local i, c.Creature
	If denColumn = 0
		If teamCount <= 1 Then Notice("You need at least one blitzling with you.") : Return
		If denCount >= DEN_SIZE Then Notice("The den is full.") : Return
		c = team(teamPick)
		For i = teamPick To teamCount - 2
			team(i) = team(i + 1)
		Next
		teamCount = teamCount - 1
		team(teamCount) = Null
		c\hp = c\maxHP ; The den heals.
		den(denCount) = c
		denCount = denCount + 1
		teamPick = Min(teamPick, teamCount - 1)
		PlaySfx(soundSelect)
		Notice(speciesName(c\species) + " went into the den.")
	Else
		If denCount = 0 Then Return
		c = den(denCursor)
		c\hp = c\maxHP
		If teamCount < TEAM_SIZE
			For i = denCursor To denCount - 2
				den(i) = den(i + 1)
			Next
			denCount = denCount - 1
			den(denCount) = Null
			team(teamCount) = c
			teamCount = teamCount + 1
			denCursor = Max(0, Min(denCursor, denCount - 1))
			Notice(speciesName(c\species) + " joined your team.")
		Else
			; A full team: swap with the team member marked on the left.
			den(denCursor) = team(teamPick)
			den(denCursor)\hp = den(denCursor)\maxHP
			team(teamPick) = c
			Notice(speciesName(c\species) + " swapped places with " + speciesName(den(denCursor)\species) + ".")
		EndIf
		PlaySfx(soundSelect)
	EndIf
End Function

; The first den row shown, so the cursor stays on screen.
Function DenScroll()
	Return Max(0, Min(denCursor - 6, denCount - 12))
End Function

; --- Starting a battle ---------------------------------------------------------------------------------------------------

; The battle background depends on where the player stands.
Function RegionAt(y)
	If y <= 10 Then Return REGION_SUMMIT
	If y <= 26 Then Return REGION_CAVE
	If y <= 39 Then Return REGION_MARSH
	Return REGION_MEADOW
End Function

Function ClearFoes()
	Local i
	For i = 0 To TEAM_SIZE - 1
		If foe(i) <> Null Then Delete foe(i)
		foe(i) = Null
	Next
	foeCount = 0
End Function

Function StartWildBattle(region)
	Local total = 0, i
	For i = 0 To encounterCount(region) - 1
		total = total + encounterWeight(region, i)
	Next
	Local pick = Rand(1, total)
	i = 0
	While pick > encounterWeight(region, i)
		pick = pick - encounterWeight(region, i)
		i = i + 1
	Wend
	Local level = Rand(encounterMin(region, i), encounterMax(region, i)) + optDifficulty - 1
	ClearFoes()
	foe(0) = NewCreature(encounterSpecies(region, i), Max(2, level))
	foeCount = 1
	battleTamer = Null
	battleRegion = region
	StartTransition()
End Function

Function StartTamerBattle(n.Npc)
	ClearFoes()
	MakeFoeTeam(n\team)
	battleTamer = n
	battleRegion = RegionAt(playerY)
	StartTransition()
End Function

Function StartTransition()
	state = STATE_TRANSITION
	transitionTimer = 70
	PlaySfx(soundEncounter)
End Function

Function UpdateTransition()
	transitionTimer = transitionTimer - 1
	If transitionTimer <= 0 Then BeginBattle()
End Function

; The owner's name for messages, such as "Pip's Fluffen" or "Wild Fluffen".
Function FoeName$()
	Local c.Creature = foe(foeActive)
	If battleTamer = Null Then Return "Wild " + speciesName(c\species)
	Return TamerShortName(battleTamer) + "'s " + speciesName(c\species)
End Function

Function TamerShortName$(n.Npc)
	Local name$ = n\name, i
	For i = Len(name) To 1 Step -1
		If Mid(name, i, 1) = " " Then Return Mid(name, i + 1)
	Next
	Return name
End Function

Function SideName$(side)
	If side = 1 Then Return FoeName()
	Return speciesName(team(playerActive)\species)
End Function

Function Fighter.Creature(side)
	If side = 0 Then Return team(playerActive)
	Return foe(foeActive)
End Function

Function BeginBattle()
	state = STATE_BATTLE
	Local i
	For i = 0 To 1
		stageAtk(i) = 0 : stageDef(i) = 0 : stageSpd(i) = 0
		shownVisible(i) = False
	Next
	For i = 0 To TEAM_SIZE - 1
		joined(i) = False
	Next
	foeActive = 0
	playerActive = FirstAlive()
	joined(playerActive) = True
	runAttempts = 0
	battleWon = False
	orbVisible = False
	BeginSteps()
	Local c.Creature = foe(0)
	seen(c\species) = True
	If battleTamer = Null
		AddShowStep(STEP_SEND, 1, c)
		AddText("A wild " + speciesName(c\species) + " appeared!", False)
	Else
		AddText(battleTamer\name + " wants to battle!", False)
		AddShowStep(STEP_SEND, 1, c)
		AddText(battleTamer\name + " sent out " + speciesName(c\species) + "!", False)
	EndIf
	AddShowStep(STEP_SEND, 0, team(playerActive))
	AddText("Go, " + speciesName(team(playerActive)\species) + "!", False)
	battleAfter = AFTER_ACTION
	ForgetInput()
End Function

; --- The queue of battle steps --------------------------------------------------------------------------------------------

Function BeginSteps()
	Delete Each BattleStep
	currentStep = Null
	battlePhase = PHASE_STEPS
End Function

; A line of text. Lines that matter wait for a key; the others also move on by themselves after a moment.
Function AddText(text$, waitForKey)
	Local s.BattleStep = New BattleStep
	s\kind = STEP_TEXT
	s\text = text
	s\a = waitForKey
End Function

Function AddStep(kind, side, a)
	Local s.BattleStep = New BattleStep
	s\kind = kind
	s\side = side
	s\a = a
End Function

; Shows a blitzling's current state on its side: STEP_SHOW moves the bars, STEP_SEND makes it appear.
Function AddShowStep(kind, side, c.Creature)
	Local s.BattleStep = New BattleStep
	s\kind = kind
	s\side = side
	s\a = c\species
	s\b = c\level
	s\c = c\hp
	s\d = c\maxHP
	s\f = XPFraction(c)
End Function

Function AddLevelStep(c.Creature, level, xp#)
	Local s.BattleStep = New BattleStep
	s\kind = STEP_SHOW
	s\side = 0
	s\a = c\species
	s\b = level
	s\c = c\hp
	s\d = c\maxHP
	s\f = xp
End Function

Function UpdateBattle()
	Select battlePhase
		Case PHASE_ACTION : UpdateActionMenu()
		Case PHASE_MOVE : UpdateMoveMenu()
		Case PHASE_STEPS : UpdateSteps()
	End Select
	; The bars and the sprites move smoothly towards what the steps last set.
	Local side
	For side = 0 To 1
		Local speed# = Max(0.35, shownMaxHP(side) / 70.0)
		If shownHP(side) > shownTargetHP(side) Then shownHP(side) = Max(shownTargetHP(side), shownHP(side) - speed)
		If shownHP(side) < shownTargetHP(side) Then shownHP(side) = Min(shownTargetHP(side), shownHP(side) + speed)
		If shownXP(side) < shownTargetXP(side) Then shownXP(side) = Min(shownTargetXP(side), shownXP(side) + 0.015)
		If shownXP(side) > shownTargetXP(side) Then shownXP(side) = shownTargetXP(side)
		If shownFlash(side) > 0 Then shownFlash(side) = shownFlash(side) - 1
	Next
	If battleShake > 0 Then battleShake = battleShake * 0.85 - 0.1
End Function

Function UpdateSteps()
	If currentStep = Null
		currentStep = First BattleStep
		If currentStep = Null
			Select battleAfter
				Case AFTER_ACTION : OpenActionMenu()
				Case AFTER_FORCED_SWITCH : OpenTeam(TEAM_FORCED, STATE_BATTLE)
				Case AFTER_END : EndBattle()
			End Select
			Return
		EndIf
		StartStep(currentStep)
	EndIf
	If RunStep(currentStep)
		Delete currentStep
		currentStep = Null
	EndIf
End Function

Function StartStep(s.BattleStep)
	stepTimer = 0
	stepTyped = 0
	Local side = s\side
	Select s\kind
		Case STEP_SEND
			shownSpecies(side) = s\a : shownLevel(side) = s\b : shownMaxHP(side) = s\d
			shownHP(side) = Float(s\c) : shownTargetHP(side) = s\c
			shownXP(side) = s\f : shownTargetXP(side) = s\f
			shownVisible(side) = True
			shownDrop(side) = 0
			shownGrow(side) = 0
			If side = 1 Then shownCaughtMark = caught(s\a)
			PlaySfx(soundSelect)
		Case STEP_SHOW
			shownSpecies(side) = s\a : shownMaxHP(side) = s\d
			shownTargetHP(side) = s\c
			If s\b <> shownLevel(side) Then shownLevel(side) = s\b : shownXP(side) = 0
			shownTargetXP(side) = s\f
		Case STEP_FAINT
			PlaySfx(soundFaint)
		Case STEP_ATTACK
			attackSide = side
			attackElement = s\a
		Case STEP_HIT
			shownFlash(side) = 24
			Select s\a
				Case 1 : PlaySfx(soundStrongHit)
				Case 2 : PlaySfx(soundWeakHit)
				Default : PlaySfx(soundHit)
			End Select
			If optAnimations Then battleShake = Float(6 + s\a * 3)
		Case STEP_STAT
			If s\a > 0 Then PlaySfx(soundStat) Else PlaySfx(soundStatDown)
			StatSparkles(side, s\a > 0)
		Case STEP_THROW
			orbVisible = True
			orbWobble = 0
			pendingItem = s\a
			PlaySfx(soundThrow)
		Case STEP_WOBBLE
			PlaySfx(soundWobble)
		Case STEP_BREAK_FREE
			orbVisible = False
			PlaySfx(soundHit)
		Case STEP_CAUGHT
			PlaySfx(soundCaught)
			BattleBurst(FoeSpotX(), FoeSpotY() + 40, 255, 230, 120, 40)
		Case STEP_SOUND
			PlaySfx(s\a)
	End Select
End Function

; Plays one step. Gives back True when it is finished.
Function RunStep(s.BattleStep)
	stepTimer = stepTimer + 1
	Local side = s\side
	Select s\kind
		Case STEP_TEXT
			stepTyped = stepTyped + TextSpeed()
			Local pressed = ConfirmHit() Or MouseHit(1)
			If stepTyped < Len(s\text)
				If pressed Then stepTyped = Float(Len(s\text))
				Return False
			EndIf
			If pressed Then PlaySfx(soundMove) : Return True
			If (Not s\a) And stepTimer > Len(s\text) / TextSpeed() + 55 Then Return True
			Return False
		Case STEP_SEND
			shownGrow(side) = Min(1, stepTimer / 18.0)
			Return stepTimer >= 18
		Case STEP_SHOW
			Return Abs(shownHP(side) - shownTargetHP(side)) < 0.01 And Abs(shownXP(side) - shownTargetXP(side)) < 0.001
		Case STEP_FAINT
			shownDrop(side) = Min(1, stepTimer / 30.0)
			If stepTimer >= 30 Then shownVisible(side) = False : Return True
			Return False
		Case STEP_ATTACK
			If Not optAnimations Then Return True
			AttackEffect(side, s\a, stepTimer)
			Return stepTimer >= 34
		Case STEP_HIT, STEP_STAT
			Return stepTimer >= 24 Or (Not optAnimations)
		Case STEP_THROW
			; The orb flies in an arc onto the blitzling, which then shrinks into it.
			Local t# = Min(1, stepTimer / 30.0)
			orbX = 150 + (FoeSpotX() - 150) * t
			orbY = 430 + (FoeSpotY() + 40 - 430) * t - Sin(t * 180) * 160
			If stepTimer > 30 Then shownGrow(1) = Max(0, 1 - (stepTimer - 30) / 14.0)
			Return stepTimer >= 46
		Case STEP_WOBBLE
			orbWobble = Sin(Float(stepTimer * 18)) * 18 * (1 - stepTimer / 40.0)
			If stepTimer >= 40 Then orbWobble = 0 : Return True
			Return False
		Case STEP_BREAK_FREE
			shownGrow(1) = Min(1, stepTimer / 14.0)
			Return stepTimer >= 14
		Case STEP_CAUGHT
			Return stepTimer >= 40
	End Select
	Return True
End Function

; Where the foe and the player's blitzling stand on the screen (the middle of their feet).
Function FoeSpotX()
	Return 590
End Function

Function FoeSpotY()
	Return 250
End Function

Function PlayerSpotX()
	Return 210
End Function

Function PlayerSpotY()
	Return 425
End Function

; --- Choosing what to do -----------------------------------------------------------------------------------------------------

Function OpenActionMenu()
	battlePhase = PHASE_ACTION
	menuText(0) = "Fight" : menuText(1) = "Bag" : menuText(2) = "Team" : menuText(3) = "Run"
	SetMenu(4, SCREEN_W - 230, SCREEN_H - 122, 200, 27)
End Function

Function UpdateActionMenu()
	Select MenuInput()
		Case 0 : OpenMoveMenu()
		Case 1 : OpenBag(BAG_BATTLE)
		Case 2 : OpenTeam(TEAM_SWITCH, STATE_BATTLE)
		Case 3
			If battleTamer <> Null
				Notice("You can't run from a tamer battle!")
			Else
				PlayerTurn(4, 0)
			EndIf
	End Select
End Function

Function OpenMoveMenu()
	battlePhase = PHASE_MOVE
	Local c.Creature = team(playerActive), i, n = 0
	For i = 0 To 3
		If c\move[i] >= 0 Then menuText(n) = moveName(c\move[i]) : n = n + 1
	Next
	SetMenu(n, 24, SCREEN_H - 122, 260, 27)
End Function

Function UpdateMoveMenu()
	Local chosen = MenuInput()
	If chosen = -2 Then OpenActionMenu() : menuSelected = 0 : Return
	If chosen >= 0 Then PlayerTurn(0, team(playerActive)\move[chosen])
End Function

; --- Playing a turn ---------------------------------------------------------------------------------------------------------
; kind 0: use move arg, 1: switch to team member arg, 2: throw orb item arg, 3: use the pending item on team member arg,
; 4: run away. The foe answers unless the battle ended.

Function PlayerTurn(kind, arg)
	BeginSteps()
	battleAfter = AFTER_ACTION
	Local foeMove = FoeChooseMove()
	If kind = 0
		Local playerFirst
		If moveFirst(arg) <> moveFirst(foeMove)
			playerFirst = moveFirst(arg) > moveFirst(foeMove)
		Else
			Local mySpeed# = team(playerActive)\spd * StageFactor(stageSpd(0))
			Local foeSpeed# = foe(foeActive)\spd * StageFactor(stageSpd(1))
			playerFirst = mySpeed > foeSpeed Or (mySpeed = foeSpeed And Rand(0, 1) = 0)
		EndIf
		If playerFirst
			If Not DoMove(0, arg) Then DoMove(1, foeMove)
		Else
			If Not DoMove(1, foeMove) Then DoMove(0, arg)
		EndIf
		Return
	EndIf

	Local ended = False
	Select kind
		Case 1 : SwitchIn(arg)
		Case 2 : ended = ThrowOrb(arg)
		Case 3
			Local c.Creature = team(arg)
			AddText("You used a " + itemName(pendingItem) + " on " + speciesName(c\species) + ".", False)
			AddStep(STEP_SOUND, 0, soundHeal)
			AddText(ApplyItem(c), False)
			If arg = playerActive Then AddShowStep(STEP_SHOW, 0, c)
		Case 4 : ended = TryRun()
	End Select
	If Not ended Then DoMove(1, foeMove)
End Function

Function SwitchIn(index)
	If shownVisible(0)
		AddText("Come back, " + speciesName(team(playerActive)\species) + "!", False)
		AddStep(STEP_FAINT, 0, 0)
	EndIf
	playerActive = index
	joined(index) = True
	stageAtk(0) = 0 : stageDef(0) = 0 : stageSpd(0) = 0
	AddShowStep(STEP_SEND, 0, team(index))
	AddText("Go, " + speciesName(team(index)\species) + "!", False)
End Function

Function StageFactor#(stage)
	If stage >= 0 Then Return (2 + stage) / 2.0
	Return 2.0 / (2 - stage)
End Function

; Plays one move. Gives back True when the target fainted, which ends the turn.
Function DoMove(side, m)
	Local attacker.Creature = Fighter(side), target.Creature = Fighter(1 - side)
	Local attackerName$ = SideName(side), targetName$ = SideName(1 - side)
	AddText(attackerName + " used " + moveName(m) + "!", False)
	AddStep(STEP_ATTACK, side, moveElement(m))

	If Rand(1, 100) > moveAccuracy(m)
		AddText("But it missed!", False)
		Return False
	EndIf

	Select moveEffect(m)
		Case EFFECT_DAMAGE
			Local percent = effectiveness(moveElement(m), speciesElement(target\species))
			Local power# = ((2.0 * attacker\level / 5 + 2) * movePower(m) * (attacker\atk * StageFactor(stageAtk(side))) / (target\def * StageFactor(stageDef(1 - side)))) / 50 + 2
			If moveElement(m) = speciesElement(attacker\species) And moveElement(m) <> ELEM_PLAIN Then power = power * 1.5
			power = power * percent / 100.0 * Rnd(0.85, 1.0)
			Local critical = (Rand(1, 16) = 1)
			If critical Then power = power * 1.5
			Local damage = Max(1, Int(power))
			target\hp = Max(0, target\hp - damage)
			If percent > 100
				AddStep(STEP_HIT, 1 - side, 1)
			ElseIf percent < 100
				AddStep(STEP_HIT, 1 - side, 2)
			Else
				AddStep(STEP_HIT, 1 - side, 0)
			EndIf
			AddShowStep(STEP_SHOW, 1 - side, target)
			If critical Then AddText("A critical hit!", False)
			If percent > 100 Then AddText("It's super effective!", False)
			If percent < 100 Then AddText("It's not very effective...", False)
		Case EFFECT_ATK_UP : ChangeStage(side, 0, 1)
		Case EFFECT_DEF_UP : ChangeStage(side, 1, 1)
		Case EFFECT_SPD_UP : ChangeStage(side, 2, 2)
		Case EFFECT_FOE_ATK_DOWN : ChangeStage(1 - side, 0, -1)
		Case EFFECT_FOE_DEF_DOWN : ChangeStage(1 - side, 1, -1)
		Case EFFECT_HEAL
			If attacker\hp >= attacker\maxHP
				AddText(attackerName + "'s health is already full!", False)
			Else
				attacker\hp = Min(attacker\maxHP, attacker\hp + attacker\maxHP / 2)
				AddStep(STEP_SOUND, side, soundHeal)
				AddShowStep(STEP_SHOW, side, attacker)
				AddText(attackerName + " recovered health!", False)
			EndIf
	End Select

	If target\hp > 0 Then Return False
	Fainted(1 - side)
	Return True
End Function

; Raises or lowers attack (0), defence (1) or speed (2) of a side by some stages.
Function ChangeStage(side, stat, amount)
	Local name$ = SideName(side), statName$, now
	Select stat
		Case 0 : statName = "attack" : now = stageAtk(side)
		Case 1 : statName = "defence" : now = stageDef(side)
		Default : statName = "speed" : now = stageSpd(side)
	End Select
	Local wanted = Max(-3, Min(3, now + amount))
	If wanted = now
		If amount > 0 Then AddText(name + "'s " + statName + " won't go any higher!", False) Else AddText(name + "'s " + statName + " won't go any lower!", False)
		Return
	EndIf
	Select stat
		Case 0 : stageAtk(side) = wanted
		Case 1 : stageDef(side) = wanted
		Default : stageSpd(side) = wanted
	End Select
	AddStep(STEP_STAT, side, amount)
	If amount > 1
		AddText(name + "'s " + statName + " rose sharply!", False)
	ElseIf amount > 0
		AddText(name + "'s " + statName + " rose!", False)
	Else
		AddText(name + "'s " + statName + " fell!", False)
	EndIf
End Function

; Handles a fainted blitzling: experience for the winners, the next foe, or the end of the battle.
Function Fainted(side)
	AddStep(STEP_FAINT, side, 0)
	AddText(SideName(side) + " fainted!", False)
	If side = 1
		AwardExperience(foe(foeActive))
		stageAtk(1) = 0 : stageDef(1) = 0 : stageSpd(1) = 0
		Local i, nextFoe = -1
		For i = 0 To foeCount - 1
			If foe(i)\hp > 0 Then nextFoe = i : Exit
		Next
		If nextFoe >= 0
			foeActive = nextFoe
			seen(foe(nextFoe)\species) = True
			AddText(battleTamer\name + " sent out " + speciesName(foe(nextFoe)\species) + "!", False)
			AddShowStep(STEP_SEND, 1, foe(nextFoe))
			For i = 0 To TEAM_SIZE - 1
				joined(i) = False
			Next
			joined(playerActive) = True
			Return
		EndIf
		battleWon = True
		battleAfter = AFTER_END
		If battleTamer <> Null
			AddText("You beat " + battleTamer\name + "!", True)
			money = money + battleTamer\reward
			AddText("You received " + battleTamer\reward + " coins.", True)
		EndIf
		Return
	EndIf
	If AliveCount() > 0
		battleAfter = AFTER_FORCED_SWITCH
		Return
	EndIf
	battleWon = False
	battleAfter = AFTER_END
	AddText("You have no blitzlings left that can battle...", True)
End Function

; Every team member that joined the fight against this foe, and is still standing, gets experience.
Function AwardExperience(defeated.Creature)
	Local amount# = baseXP(defeated\species) * defeated\level / 6.0
	If battleTamer <> Null Then amount = amount * 1.5
	If optDifficulty = 0 Then amount = amount * 1.5
	Local i, c.Creature, gained = Max(1, Int(amount))
	For i = 0 To teamCount - 1
		c = team(i)
		If joined(i) And c\hp > 0 And c\level < 60
			AddText(speciesName(c\species) + " gained " + gained + " experience!", False)
			c\xp = c\xp + gained
			While c\level < 60 And c\xp >= XPForLevel(c\level + 1)
				If i = playerActive Then AddLevelStep(c, c\level, 1.0)
				c\level = c\level + 1
				CalcStats(c)
				If i = playerActive Then AddLevelStep(c, c\level, 0.0)
				AddStep(STEP_SOUND, 0, soundLevel)
				AddText(speciesName(c\species) + " grew to level " + c\level + "!", True)
				Local learned$ = LearnMovesAt(c, c\level, True)
				While learned <> ""
					Local bar = Instr(learned, "|")
					If bar = 0 Then AddText(learned, True) : learned = "" Else AddText(Left(learned, bar - 1), True) : learned = Mid(learned, bar + 1)
				Wend
				If evolveInto(c\species) > 0 And c\level >= evolveLevel(c\species) Then c\evolvePending = True
			Wend
			If i = playerActive Then AddShowStep(STEP_SHOW, 0, c)
		EndIf
	Next
End Function

; Throws an orb. Gives back True when the blitzling was caught.
Function ThrowOrb(item)
	itemCount(item) = itemCount(item) - 1
	AddText("You threw a " + itemName(item) + "!", False)
	AddStep(STEP_THROW, 1, item)
	Local c.Creature = foe(foeActive)
	Local bonus# = 1.0
	If item = ITEM_GREAT_ORB Then bonus = 1.75
	Local chance# = (3.0 * c\maxHP - 2.0 * c\hp) * catchRate(c\species) * bonus / (3.0 * c\maxHP) / 255.0
	chance = Max(0.01, Min(1.0, chance))
	; Four checks in a row must pass, each with the fourth root of the chance. Every passed check is one wobble.
	Local perCheck# = chance ^ 0.25, passed = 0
	While passed < 4 And Rnd(0, 1) < perCheck
		passed = passed + 1
	Wend
	Local i
	For i = 1 To Min(3, passed)
		AddStep(STEP_WOBBLE, 1, 0)
	Next
	If passed = 4
		AddStep(STEP_CAUGHT, 1, 0)
		AddText("Gotcha! " + speciesName(c\species) + " was caught!", True)
		If Not caught(c\species) Then AddText(speciesName(c\species) + "'s page was added to your journal.", True)
		caught(c\species) = True
		foe(foeActive) = Null ; It belongs to the player now, so ClearFoes must not delete it.
		If Not AddToTeam(c) Then AddText(speciesName(c\species) + " was sent to the den at the shrine.", True)
		battleWon = True
		battleAfter = AFTER_END
		Return True
	EndIf
	AddStep(STEP_BREAK_FREE, 1, 0)
	Select passed
		Case 0 : AddText("Oh no! It broke free!", False)
		Case 1 : AddText("Aww! It almost looked caught!", False)
		Case 2 : AddText("Argh! So close!", False)
		Default : AddText("Shoot! It was so close too!", False)
	End Select
	Return False
End Function

Function TryRun()
	runAttempts = runAttempts + 1
	Local mine = team(playerActive)\spd, theirs = Max(1, foe(foeActive)\spd)
	If mine >= theirs Or Rand(0, 255) < mine * 128 / theirs + 30 * runAttempts
		AddText("You got away safely!", False)
		battleAfter = AFTER_END
		Return True
	EndIf
	AddText("You couldn't get away!", False)
	Return False
End Function

; The foe's choice. Wild blitzlings pick at random; tamers pick the move that seems to do the most.
Function FoeChooseMove()
	Local c.Creature = foe(foeActive), target.Creature = team(playerActive)
	Local i, count = 0, best = -1, bestScore# = -1, m, score#
	For i = 0 To 3
		m = c\move[i]
		If m >= 0
			count = count + 1
			If movePower(m) > 0
				score = movePower(m) * effectiveness(moveElement(m), speciesElement(target\species)) / 100.0 * moveAccuracy(m) / 100.0
				If moveElement(m) = speciesElement(c\species) And moveElement(m) <> ELEM_PLAIN Then score = score * 1.5
			ElseIf moveEffect(m) = EFFECT_HEAL
				If c\hp < c\maxHP / 3 Then score = 90 Else score = 0
			Else
				score = 25 + Rnd(0, 10)
			EndIf
			If score > bestScore Then bestScore = score : best = m
		EndIf
	Next
	Local smart = 0
	If battleTamer <> Null Then smart = 60 + optDifficulty * 20
	If Rand(1, 100) <= smart Then Return best
	; Pick any known move.
	Local pick = Rand(1, count)
	For i = 0 To 3
		If c\move[i] >= 0
			pick = pick - 1
			If pick = 0 Then Return c\move[i]
		EndIf
	Next
	Return c\move[0]
End Function

; --- After the battle ----------------------------------------------------------------------------------------------------------

Global creditsAfterEvolving

Function EndBattle()
	BeginSteps()
	Delete Each Particle
	orbVisible = False
	ClearFoes()
	creditsAfterEvolving = False
	If AliveCount() = 0
		BlackOut()
		Return
	EndIf
	If battleWon And battleTamer <> Null
		battleTamer\beaten = True
		If battleTamer\id = 10 And Not champion
			champion = True
			creditsAfterEvolving = True
		EndIf
	EndIf
	battleTamer = Null
	EnterField()
	NextEvolution()
End Function

; Evolves the next team member that reached its level, one after the other.
Function NextEvolution()
	Local i
	For i = 0 To teamCount - 1
		If team(i)\evolvePending
			evolveIndex = i
			evolveFrom = team(i)\species
			evolveTo = evolveInto(evolveFrom)
			evolveTimer = 0
			state = STATE_EVOLVE
			ForgetInput()
			Return
		EndIf
	Next
	If creditsAfterEvolving
		creditsAfterEvolving = False
		state = STATE_CREDITS
		creditsTimer = 0
		ForgetInput()
	EndIf
End Function

Function UpdateEvolve()
	evolveTimer = evolveTimer + 1
	If evolveTimer = 200
		Local c.Creature = team(evolveIndex)
		c\species = evolveTo
		CalcStats(c)
		LearnMovesAt(c, c\level, False)
		seen(evolveTo) = True
		caught(evolveTo) = True
		PlaySfx(soundCaught)
		ForgetInput()
	EndIf
	If evolveTimer > 200 And (ConfirmHit() Or MouseHit(1) Or BackHit())
		team(evolveIndex)\evolvePending = False
		EnterField()
		NextEvolution()
	EndIf
End Function

Function UpdateCredits()
	creditsTimer = creditsTimer + 1
	If creditsTimer > 120 And (ConfirmHit() Or MouseHit(1) Or BackHit())
		SaveGame()
		EnterField()
		Notice("The game was saved.")
	EndIf
End Function

