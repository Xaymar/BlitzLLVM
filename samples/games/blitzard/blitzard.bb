; Black bars close in from both sides after the screen flashes.
Function DrawTransition()
	Local t = 70 - transitionTimer
	If t < 24 And (t / 4) Mod 2 = 0
		Color 255, 255, 255
		Rect 0, 0, SCREEN_W, SCREEN_H, 1
	EndIf
	If t >= 24
		Local cover = (t - 24) * SCREEN_W / 40, i
		Color 8, 8, 14
		For i = 0 To SCREEN_H / 40
			If i Mod 2 = 0 Then Rect 0, i * 40, cover, 40, 1 Else Rect SCREEN_W - cover, i * 40, cover, 40, 1
		Next
	EndIf
End Function

