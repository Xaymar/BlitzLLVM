; --- Field ---------------------------------------------------------------------------------------------------------------

Function DrawField()
	; Plain and tall grass are drawn with see-through gaps over the grass colour, which holds the watermark.
	ClsColor GRASS_R, GRASS_G, GRASS_B
	Cls
	DrawWatermark(GRASS_R, GRASS_G, GRASS_B)

	Local px = playerX * TILE - DirX(playerFacing) * Int(playerStep)
	Local py = playerY * TILE - DirY(playerFacing) * Int(playerStep)
	cameraX = Max(0, Min(MAP_W * TILE - SCREEN_W, px + TILE / 2 - SCREEN_W / 2))
	cameraY = Max(0, Min(MAP_H * TILE - SCREEN_H, py + TILE / 2 - SCREEN_H / 2))

	Local waterFrame = (frame / 30) Mod 2
	Local tx, ty
	For ty = cameraY / TILE To Min(MAP_H - 1, (cameraY + SCREEN_H) / TILE)
		For tx = cameraX / TILE To Min(MAP_W - 1, (cameraX + SCREEN_W) / TILE)
			DrawImage tileImage(Asc(mapTile(tx, ty)), waterFrame), tx * TILE - cameraX, ty * TILE - cameraY
		Next
	Next

	; People, from the top of the screen down, so nearer ones are drawn in front.
	Local n.Npc, nx, ny, npcFrame
	For ty = Max(0, cameraY / TILE - 1) To Min(MAP_H - 1, (cameraY + SCREEN_H) / TILE + 1)
		For n = Each Npc
			If n\y = ty
				nx = n\x * TILE - DirX(n\facing) * n\offset - cameraX
				ny = n\y * TILE - DirY(n\facing) * n\offset - cameraY
				npcFrame = 0
				If n\offset > 0 Then npcFrame = 1 + (n\offset / 8) Mod 2
				DrawImage personImage(n\look, n\facing, npcFrame), nx, ny - 8
				If state = STATE_APPROACH And n = approachNpc And approachTimer > 0 Then DrawImage imageBubble, nx + 4, ny - 40
			EndIf
		Next
		If ty = playerY
			Local playerFrame = 0
			If playerStep > 0 And playerStep < TILE * 3 / 4 Then playerFrame = 1 + walkFrame
			DrawImage personImage(6, playerFacing, playerFrame), px - cameraX, py - cameraY - 8
			; Standing in tall grass hides the feet.
			If playerStep = 0 And Instr(",;", mapTile(playerX, playerY)) > 0
				DrawImageRect tileImage(Asc(mapTile(playerX, playerY)), 0), px - cameraX, py - cameraY + 20, 0, 20, TILE, TILE - 20
			EndIf
		EndIf
	Next

	If areaTimer > 0
		SetFont fontText
		Local w = StringWidth(areaName) + 40, slide = Min(0, -50 + (150 - areaTimer) * 4)
		If areaTimer < 20 Then slide = -(20 - areaTimer) * 3
		DrawPanel(14, 14 + slide, w, 38)
		Color 255, 240, 200
		Text 14 + w / 2, 33 + slide, areaName, True, True
	EndIf
End Function

