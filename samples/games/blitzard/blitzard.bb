Function TimeText$(frames)
	Local minutes = frames / 3600
	Local text$ = (minutes / 60) + ":"
	If minutes Mod 60 < 10 Then text = text + "0"
	Return text + (minutes Mod 60)
End Function

Function CountFlags(which)
	Local i, n = 0
	For i = 1 To SPECIES_COUNT
		If which = 0 And seen(i) Then n = n + 1
		If which = 1 And caught(i) Then n = n + 1
	Next
	Return n
End Function

