; --- Types -----------------------------------------------------------------------------------------------------------

; One blitzling, in the team, the den or on the other side of a battle.
Type Creature
	Field species
	Field level, xp
	Field hp, maxHP, atk, def, spd
	Field move[3]          ; Move numbers, -1 for an empty slot.
	Field evolvePending    ; Set on a level up that reaches the evolution level, handled after the battle.
End Type

; People in the world. Tamers battle you once; the others only talk.
Type Npc
	Field id
	Field kind
	Field name$
	Field x, y, facing
	Field sight            ; How many tiles a tamer can see along the way it faces.
	Field look             ; Picks the colours of the sprite.
	Field reward
	Field team$            ; "species:level,species:level,..." for tamers.
	Field talk$            ; Pages split by "|".
	Field after$           ; What a beaten tamer says.
	Field beaten
	Field offset           ; Pixels still to walk into the current tile, while walking.
End Type

; One step of a battle as the player sees it: a line of text, an animation or an update of a health bar.
; The rules of a turn are worked out at once, and the steps are queued so the screen can show them one by one.
Type BattleStep
	Field kind
	Field text$
	Field side
	Field a, b, c, d
	Field f#
End Type

Type Particle
	Field x#, y#, vx#, vy#
	Field life#, fade#
	Field r, g, b
	Field size#
End Type

