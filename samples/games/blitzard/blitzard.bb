		DrawHint("Enter leaves the marked team member in the den. Left/Right switch sides. Escape leaves.")
	ElseIf teamCount < TEAM_SIZE
		DrawHint("Enter brings this blitzling to your team. Left/Right switch sides. Escape leaves.")
	Else
		DrawHint("Your team is full: Enter swaps it with the team member marked on the left.")
	EndIf
End Function

