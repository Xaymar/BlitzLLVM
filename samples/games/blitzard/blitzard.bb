; --- Pictures made in code --------------------------------------------------------------------------------------------------
; Black is the mask colour of images, so dark outlines use (14, 12, 20) instead.

; Fills a triangle line by line.
Function FillTriangle(x1#, y1#, x2#, y2#, x3#, y3#)
	Local t#
	; Sort the corners from top to bottom.
	If y2 < y1 Then t = x1 : x1 = x2 : x2 = t : t = y1 : y1 = y2 : y2 = t
	If y3 < y1 Then t = x1 : x1 = x3 : x3 = t : t = y1 : y1 = y3 : y3 = t
	If y3 < y2 Then t = x2 : x2 = x3 : x3 = t : t = y2 : y2 = y3 : y3 = t
	Local y, xa#, xb#
	For y = Int(y1) To Int(y3)
		If y3 = y1 Then Return
		xa = x1 + (x3 - x1) * (y - y1) / (y3 - y1)
		If y < y2
			If y2 = y1 Then xb = x2 Else xb = x1 + (x2 - x1) * (y - y1) / (y2 - y1)
		Else
			If y3 = y2 Then xb = x2 Else xb = x2 + (x3 - x2) * (y - y2) / (y3 - y2)
		EndIf
		Line Int(xa), y, Int(xb), y
	Next
End Function

; Turns the see-through pixels that touch the picture into a dark outline.
Function OutlineImage(image)
	Local w = ImageWidth(image), h = ImageHeight(image), x, y
	Local buffer = ImageBuffer(image)
	LockBuffer buffer
	For y = 0 To h - 1
		For x = 0 To w - 1
			outlinePixel(x, y) = ReadPixelFast(x, y, buffer) And $FFFFFF
		Next
	Next
	For y = 0 To h - 1
		For x = 0 To w - 1
			If outlinePixel(x, y) = 0
				Local near = False
				If x > 0 Then If outlinePixel(x - 1, y) <> 0 Then near = True
				If x < w - 1 Then If outlinePixel(x + 1, y) <> 0 Then near = True
				If y > 0 Then If outlinePixel(x, y - 1) <> 0 Then near = True
				If y < h - 1 Then If outlinePixel(x, y + 1) <> 0 Then near = True
				If near Then WritePixelFast x, y, $FF0E0C14, buffer
			EndIf
		Next
	Next
	UnlockBuffer buffer
End Function

; --- Tiles ---

Function MakeTileImages()
	Local chars$ = ".,;=bf+cC#^~RTQWDHMiAh", i, f
	For i = 1 To Len(chars)
		For f = 0 To 1
			Local code = Asc(Mid(chars, i, 1))
			If tileImage(code, f) <> 0 Then FreeImage tileImage(code, f)
			tileImage(code, f) = MakeTile(Mid(chars, i, 1), f)
		Next
	Next
	SeedRnd MilliSecs()
End Function

Function MakeTile(ch$, f)
	Local image = CreateImage(TILE, TILE)
	SetBuffer ImageBuffer(image)
	ClsColor 0, 0, 0
	Cls
	SeedRnd Asc(ch) * 31 + 5
	Local i, x, y
	Select ch
		Case "."
			; See-through grass: only a few darker blades over the grass colour behind.
			Color GRASS_R - 22, GRASS_G - 26, GRASS_B - 16
			For i = 1 To 6
				x = Rand(2, 29) : y = Rand(4, 29)
				Line x, y, x - 1, y - 3
				Line x + 2, y, x + 3, y - 3
			Next
		Case ","
			; Tall grass: dense blades in two greens.
			For i = 1 To 40
				x = Rand(0, 31) : y = Rand(6, 31)
				If i Mod 2 Then Color 50, 128, 46 Else Color 76, 158, 58
				Line x, y, x + Rand(-2, 2), y - Rand(6, 10)
			Next
		Case ";"
			Color 70, 122, 86 : Rect 0, 0, TILE, TILE, 1
			For i = 1 To 22
				x = Rand(0, 31) : y = Rand(8, 31)
				Color 120, 150, 70
				Line x, y, x + Rand(-1, 1), y - Rand(10, 16)
				Color 110, 80, 50
				Rect x - 1, y - Rand(12, 16), 2, 4, 1
			Next
		Case "="
			Color 196, 170, 118 : Rect 0, 0, TILE, TILE, 1
			For i = 1 To 14
				Color 176, 150, 100
				Rect Rand(0, 30), Rand(0, 30), 2, 2, 1
			Next
		Case "b"
			MakeWater(f)
			Color 140, 96, 56 : Rect 0, 0, TILE, TILE, 1
			For y = 0 To TILE - 1 Step 8
				Color 168, 120, 72 : Rect 0, y + 1, TILE, 6, 1
				Color 100, 66, 40 : Rect 4, y + 3, 2, 2, 1 : Rect 26, y + 3, 2, 2, 1
			Next
		Case "f"
			For i = 1 To 6
				x = Rand(3, 28) : y = Rand(3, 28)
				Select i Mod 3
					Case 0 : Color 250, 240, 120
					Case 1 : Color 250, 130, 160
					Default : Color 250, 250, 250
				End Select
				Rect x - 1, y, 3, 1, 1 : Rect x, y - 1, 1, 3, 1
				Color 250, 200, 60 : Rect x, y, 1, 1, 1
			Next
		Case "+"
			Color 168, 168, 184 : Rect 0, 0, TILE, TILE, 1
			Color 150, 150, 166 : Rect 0, 15, TILE, 2, 1 : Rect 15, 0, 2, 15, 1 : Rect 7, 17, 2, 15, 1 : Rect 23, 17, 2, 15, 1
			Color 190, 190, 205 : Rect 1, 1, 13, 1, 1 : Rect 18, 1, 13, 1, 1
		Case "c"
			Color 92, 76, 70 : Rect 0, 0, TILE, TILE, 1
			For i = 1 To 16
				Color 80, 64, 60
				Rect Rand(0, 30), Rand(0, 30), 3, 2, 1
			Next
		Case "C"
			Color 46, 36, 38 : Rect 0, 0, TILE, TILE, 1
			For i = 1 To 6
				Color 62, 50, 50
				Oval Rand(-6, 24), Rand(-6, 24), Rand(8, 16), Rand(6, 12), 1
			Next
		Case "#"
			Color GRASS_R, GRASS_G, GRASS_B : Rect 0, 0, TILE, TILE, 1
			Color 110, 74, 44 : Rect 13, 20, 6, 12, 1
			Color 30, 96, 44 : Oval 1, 1, 30, 26, 1
			Color 44, 120, 54 : Oval 4, 2, 22, 18, 1
			Color 70, 150, 70 : Oval 8, 4, 10, 8, 1
		Case "^"
			Color 120, 122, 140 : Rect 0, 0, TILE, TILE, 1
			Color 100, 100, 118 : FillTriangle(0, 31, 16, 6, 31, 31)
			Color 140, 142, 160 : FillTriangle(6, 31, 16, 8, 16, 31)
			Color 220, 225, 240 : FillTriangle(13, 11, 16, 6, 19, 11)
		Case "~"
			MakeWater(f)
		Case "R", "T", "Q"
			Local r = 70, g = 100, b = 200
			If ch = "T" Then r = 200 : g = 70 : b = 70
			If ch = "Q" Then r = 70 : g = 160 : b = 110
			Color r, g, b : Rect 0, 0, TILE, TILE, 1
			For y = 0 To TILE - 1 Step 8
				Color r * 3 / 4, g * 3 / 4, b * 3 / 4 : Rect 0, y + 6, TILE, 2, 1
				For x = 0 To TILE Step 8
					Rect x + (y / 8 Mod 2) * 4, y, 1, 6, 1
				Next
			Next
		Case "W", "D", "H", "M"
			Color 232, 220, 196 : Rect 0, 0, TILE, TILE, 1
			Color 200, 186, 160 : Rect 0, 0, TILE, 3, 1
			If ch = "W"
				Color 90, 70, 50 : Rect 8, 8, 16, 14, 1
				Color 150, 200, 240 : Rect 10, 10, 12, 10, 1
				Color 90, 70, 50 : Rect 15, 10, 2, 10, 1
			Else
				Color 110, 74, 44 : Rect 6, 6, 20, 26, 1
				Color 140, 96, 56 : Rect 8, 8, 16, 24, 1
				Color 230, 200, 90 : Rect 20, 19, 2, 2, 1
				If ch = "H"
					; A star over the shrine door.
					Color 255, 220, 80 : FillTriangle(16, 9, 12, 17, 20, 17) : FillTriangle(16, 19, 12, 12, 20, 12)
				EndIf
				If ch = "M"
					Color 80, 170, 120 : Oval 11, 10, 10, 10, 1
					Color 240, 240, 240 : Rect 15, 12, 2, 6, 1
				EndIf
			EndIf
		Case "i"
			Color 110, 74, 44 : Rect 14, 16, 4, 16, 1
			Color 170, 122, 72 : Rect 4, 4, 24, 14, 1
			Color 120, 84, 50 : Rect 7, 8, 18, 1, 1 : Rect 7, 12, 14, 1, 1
		Case "A"
			Color 168, 168, 184 : Rect 0, 0, TILE, TILE, 1
			Color 110, 110, 130 : Rect 4, 8, 24, 22, 1
			Color 140, 140, 160 : Rect 2, 4, 28, 6, 1
			Color 120, 230, 220 : Oval 12, 14, 8, 8, 1
		Case "h"
			Color 168, 168, 184 : Rect 0, 0, TILE, TILE, 1
			Color 160, 90, 60 : Oval 3, 6, 26, 24, 1
			Color 230, 140, 70 : Oval 7, 9, 16, 14, 1
			Color 255, 210, 120 : Oval 11, 12, 6, 5, 1
	End Select
	SetBuffer BackBuffer()
	MaskImage image, 0, 0, 0
	Return image
End Function

; Water with ripples that move between the two frames.
Function MakeWater(f)
	Color 50, 110, 200 : Rect 0, 0, TILE, TILE, 1
	Local y
	Color 90, 150, 230
	For y = 4 + f * 4 To TILE - 1 Step 8
		Line 3 + f * 6, y, 10 + f * 6, y
		Line 18 - f * 6, y + 3, 26 - f * 6, y + 3
	Next
End Function

; --- People ---

Function MakePersonImages()
	Local look, d, f
	For look = 0 To 6
		For d = 0 To 3
			For f = 0 To 2
				If personImage(look, d, f) <> 0 Then FreeImage personImage(look, d, f)
				personImage(look, d, f) = MakePerson(look, d, f)
			Next
		Next
	Next
End Function

; A small person, 32 x 40 pixels: the bottom 32 stand on the tile, the head sticks out above.
Function MakePerson(look, d, f)
	Local shirtR, shirtG, shirtB, hatR, hatG, hatB, pantsR = 60, pantsG = 60, pantsB = 90, hat = True
	Select look
		Case 0 : shirtR = 120 : shirtG = 60 : shirtB = 170 : hatR = 235 : hatG = 235 : hatB = 245 : hat = False
		Case 1 : shirtR = 60 : shirtG = 150 : shirtB = 80 : hatR = 200 : hatG = 60 : hatB = 50
		Case 2 : shirtR = 230 : shirtG = 130 : shirtB = 40 : hatR = 90 : hatG = 60 : hatB = 30 : hat = False
		Case 3 : shirtR = 140 : shirtG = 140 : shirtB = 150 : hatR = 220 : hatG = 220 : hatB = 220 : hat = False
		Case 4 : shirtR = 240 : shirtG = 210 : shirtB = 60 : hatR = 60 : hatG = 40 : hatB = 30 : hat = False
		Case 5 : shirtR = 80 : shirtG = 110 : shirtB = 160 : hatR = 150 : hatG = 120 : hatB = 70
		Default : shirtR = 50 : shirtG = 90 : shirtB = 210 : hatR = 220 : hatG = 50 : hatB = 50 : pantsR = 50 : pantsG = 50 : pantsB = 60
	End Select
	Local image = CreateImage(32, 40)
	SetBuffer ImageBuffer(image)
	ClsColor 0, 0, 0
	Cls
	; Shadow.
	Color 40, 70, 36 : Oval 7, 34, 18, 6, 1
	; Legs: one steps forward in walking frames.
	Local step1 = 0, step2 = 0
	If f = 1 Then step1 = -2 : step2 = 1
	If f = 2 Then step1 = 1 : step2 = -2
	Color pantsR, pantsG, pantsB
	If d = DIR_LEFT Or d = DIR_RIGHT
		Rect 12 + step1 * 2, 28, 4, 9, 1
		Rect 16 + step2 * 2, 28, 4, 9, 1
	Else
		Rect 11, 28 + step1, 4, 9 - step1, 1
		Rect 17, 28 + step2, 4, 9 - step2, 1
	EndIf
	; Body and arms.
	Color shirtR, shirtG, shirtB
	Rect 9, 17, 14, 13, 1
	Color shirtR * 3 / 4, shirtG * 3 / 4, shirtB * 3 / 4
	If d = DIR_LEFT Or d = DIR_RIGHT
		Rect 14 - step1, 18, 4, 10, 1
	Else
		Rect 6, 18 + step2, 3, 10, 1
		Rect 23, 18 + step1, 3, 10, 1
	EndIf
	; Head.
	Color 240, 200, 160
	Oval 8, 3, 16, 16, 1
	Color hatR, hatG, hatB
	Select d
		Case DIR_DOWN
			If hat Then Rect 8, 3, 16, 5, 1 : Rect 7, 7, 18, 2, 1 Else Rect 8, 3, 16, 4, 1 : Rect 8, 3, 3, 9, 1 : Rect 21, 3, 3, 9, 1
			Color 30, 30, 40 : Rect 12, 11, 2, 3, 1 : Rect 18, 11, 2, 3, 1
		Case DIR_UP
			Oval 8, 3, 16, 13, 1
		Case DIR_LEFT
			Rect 8, 3, 16, 5, 1 : Rect 16, 3, 8, 11, 1
			If hat Then Rect 5, 7, 8, 2, 1
			Color 30, 30, 40 : Rect 11, 11, 2, 3, 1
		Default
			Rect 8, 3, 16, 5, 1 : Rect 8, 3, 8, 11, 1
			If hat Then Rect 19, 7, 8, 2, 1
			Color 30, 30, 40 : Rect 19, 11, 2, 3, 1
	End Select
	SetBuffer BackBuffer()
	OutlineImage(image)
	Return image
End Function

Function MakeBubbleImage()
	Local image = CreateImage(24, 30)
	SetBuffer ImageBuffer(image)
	ClsColor 0, 0, 0
	Cls
	Color 250, 250, 250
	Oval 0, 0, 24, 24, 1
	FillTriangle(8, 20, 16, 20, 10, 29)
	Color 220, 40, 40
	Rect 10, 4, 4, 10, 1
	Rect 10, 16, 4, 4, 1
	SetBuffer BackBuffer()
	OutlineImage(image)
	Return image
End Function

; An orb is a glass ball with a glowing bolt inside: rings of colour that get lighter towards the top left.
Function MakeOrbImage(size, r, g, b)
	Local image = CreateImage(size, size)
	SetBuffer ImageBuffer(image)
	ClsColor 0, 0, 0
	Cls
	Local i, f#
	For i = 0 To 5
		f = i / 5.0
		Color Min(255, Int(r * (0.55 + f * 0.6))), Min(255, Int(g * (0.55 + f * 0.6))), Min(255, Int(b * (0.55 + f * 0.6)))
		Local d = size - i * size / 7
		Oval (size - d) / 2 - i, (size - d) / 2 - i, d, d, 1
	Next
	Color 255, 236, 90
	FillTriangle(size * 0.55, size * 0.18, size * 0.3, size * 0.55, size * 0.52, size * 0.55)
	FillTriangle(size * 0.48, size * 0.45, size * 0.7, size * 0.45, size * 0.42, size * 0.84)
	Color 255, 255, 255
	Oval size / 4, size / 6, size / 5, size / 7, 1
	SetBuffer BackBuffer()
	OutlineImage(image)
	Return image
End Function

; --- Blitzlings ---
; Each picture is drawn in a 100 x 100 space, scaled to the image size. The plain picture looks to the left;
; facingRight mirrors it, for the player's side of a battle.

Global artScale#, artFlip

Function AX(x#)
	If artFlip Then Return Int((100 - x) * artScale)
	Return Int(x * artScale)
End Function

Function AY(y#)
	Return Int(y * artScale)
End Function

Function ArtOval(cx#, cy#, rx#, ry#)
	Local x1 = AX(cx - rx), x2 = AX(cx + rx)
	If x2 < x1 Then Local t = x1 : x1 = x2 : x2 = t
	Oval x1, AY(cy - ry), Max(1, x2 - x1), Max(1, AY(cy + ry) - AY(cy - ry)), 1
End Function

Function ArtTriangle(x1#, y1#, x2#, y2#, x3#, y3#)
	FillTriangle(Float(AX(x1)), Float(AY(y1)), Float(AX(x2)), Float(AY(y2)), Float(AX(x3)), Float(AY(y3)))
End Function

Function ArtLine(x1#, y1#, x2#, y2#, thickness)
	Local i
	For i = 0 To thickness - 1
		Line AX(x1) + i, AY(y1), AX(x2) + i, AY(y2)
		Line AX(x1), AY(y1) + i, AX(x2), AY(y2) + i
	Next
End Function

Function MakeCreatureImage(s, size, facingRight)
	Local image = CreateImage(size, size)
	SetBuffer ImageBuffer(image)
	ClsColor 0, 0, 0
	Cls
	artScale = size / 100.0
	artFlip = facingRight
	Local parts = speciesParts(s)
	Local r = bodyR(s), g = bodyG(s), b = bodyB(s)
	Local ar = accentR(s), ag = accentG(s), ab = accentB(s)
	Local dr = r * 2 / 3, dg = g * 2 / 3, db = b * 2 / 3   ; A darker body colour for far legs and shading.
	Local lr = Min(255, r + 50), lg = Min(255, g + 50), lb = Min(255, b + 50)

	; Where the head is, for the parts that sit on it, and where the body is.
	Local headX#, headY#, headR#, bodyX#, bodyY#, bodyRX#, bodyRY#, tailX#, tailY#
	Select speciesShape(s)
		Case SHAPE_BLOB : bodyX = 52 : bodyY = 64 : bodyRX = 32 : bodyRY = 28 : headX = 44 : headY = 50 : headR = 22 : tailX = 82 : tailY = 70
		Case SHAPE_FOUR_LEGS : bodyX = 58 : bodyY = 60 : bodyRX = 28 : bodyRY = 17 : headX = 30 : headY = 42 : headR = 17 : tailX = 84 : tailY = 52
		Case SHAPE_UPRIGHT : bodyX = 52 : bodyY = 64 : bodyRX = 22 : bodyRY = 26 : headX = 48 : headY = 30 : headR = 18 : tailX = 72 : tailY = 76
		Case SHAPE_FISH : bodyX = 50 : bodyY = 54 : bodyRX = 34 : bodyRY = 19 : headX = 34 : headY = 50 : headR = 16 : tailX = 84 : tailY = 54
		Default : bodyX = 56 : bodyY = 60 : bodyRX = 25 : bodyRY = 23 : headX = 34 : headY = 38 : headR = 15 : tailX = 80 : tailY = 62
	End Select

	; Parts behind the body.
	If parts And PART_TAIL
		Local i
		For i = 0 To 6
			Color ar, ag, ab
			ArtOval(tailX + i * 2.4, tailY - i * 4.5, 6 - i * 0.6, 6 - i * 0.6)
		Next
	EndIf
	If parts And PART_BOLT
		Color ar, ag, ab
		ArtTriangle(tailX - 4, tailY, tailX + 10, tailY - 10, tailX + 2, tailY - 12)
		ArtTriangle(tailX + 2, tailY - 12, tailX + 14, tailY - 14, tailX + 6, tailY - 26)
		ArtTriangle(tailX + 6, tailY - 26, tailX + 16, tailY - 22, tailX + 18, tailY - 38)
	EndIf
	If parts And PART_FLAME
		Color 230, 80, 30 : ArtOval(tailX + 6, tailY - 10, 9, 13)
		Color 255, 160, 40 : ArtOval(tailX + 6, tailY - 8, 6, 9)
		Color 255, 235, 120 : ArtOval(tailX + 6, tailY - 5, 3, 5)
	EndIf
	If parts And PART_WINGS
		Color dr, dg, db
		ArtOval(bodyX + 8, bodyY - 18, 18, 10)
	EndIf
	If parts And PART_MANE
		Color ar, ag, ab
		For i = 0 To 7
			ArtOval(headX + Cos(Float(i * 45)) * headR * 0.9, headY + Sin(Float(i * 45)) * headR * 0.9, headR * 0.5, headR * 0.5)
		Next
	EndIf
	If parts And PART_SPIKES
		Color ar, ag, ab
		For i = -1 To 1
			Local sx# = bodyX + i * bodyRX * 0.5
			ArtTriangle(sx - 6, bodyY - bodyRY * 0.8, sx + 6, bodyY - bodyRY * 0.8, sx + 2, bodyY - bodyRY - 12)
		Next
	EndIf

	; Legs and feet.
	Select speciesShape(s)
		Case SHAPE_FOUR_LEGS
			Color dr, dg, db
			ArtOval(bodyX - 12, 82, 5, 12) : ArtOval(bodyX + 20, 82, 5, 12)
			Color r, g, b
			ArtOval(bodyX - 18, 84, 5, 11) : ArtOval(bodyX + 14, 84, 5, 11)
		Case SHAPE_BLOB, SHAPE_UPRIGHT
			Color dr, dg, db
			ArtOval(bodyX - 14, 91, 9, 5) : ArtOval(bodyX + 12, 91, 9, 5)
		Case SHAPE_BIRD
			Color 230, 170, 60
			ArtLine(bodyX - 6, 80, bodyX - 8, 94, 2) : ArtLine(bodyX + 6, 80, bodyX + 4, 94, 2)
	End Select
	If speciesShape(s) = SHAPE_FISH
		; A fish floats: its tail fin, and a shadow below.
		Color 30, 30, 40 : ArtOval(50, 92, 26, 4)
		Color ar, ag, ab
		ArtTriangle(bodyX + bodyRX - 6, bodyY, 98, bodyY - 18, 98, bodyY + 18)
	EndIf

	; The body with a lighter belly, then the head.
	If parts And PART_SHELL
		Color ar, ag, ab
		ArtOval(bodyX + 8, bodyY - 6, bodyRX * 0.85, bodyRY * 0.95)
	EndIf
	Color r, g, b
	ArtOval(bodyX, bodyY, bodyRX, bodyRY)
	Color lr, lg, lb
	ArtOval(bodyX - bodyRX * 0.25, bodyY + bodyRY * 0.3, bodyRX * 0.55, bodyRY * 0.5)
	If parts And PART_SHELL
		; The shell sits on top of the back, with a spiral.
		Color ar, ag, ab
		ArtOval(bodyX + 10, bodyY - 10, bodyRX * 0.7, bodyRY * 0.75)
		Color ar * 3 / 4, ag * 3 / 4, ab * 3 / 4
		ArtOval(bodyX + 12, bodyY - 10, bodyRX * 0.45, bodyRY * 0.5)
		Color ar, ag, ab
		ArtOval(bodyX + 14, bodyY - 10, bodyRX * 0.25, bodyRY * 0.28)
	EndIf
	If speciesShape(s) <> SHAPE_BLOB
		If parts And PART_EARS
			Color r, g, b
			ArtTriangle(headX - headR * 0.8, headY - headR * 0.3, headX - headR * 0.2, headY - headR * 0.6, headX - headR * 0.7, headY - headR * 1.5)
			ArtTriangle(headX + headR * 0.1, headY - headR * 0.6, headX + headR * 0.8, headY - headR * 0.3, headX + headR * 0.6, headY - headR * 1.5)
			Color ar, ag, ab
			ArtTriangle(headX - headR * 0.65, headY - headR * 0.45, headX - headR * 0.35, headY - headR * 0.6, headX - headR * 0.65, headY - headR * 1.15)
		EndIf
		Color r, g, b
		ArtOval(headX, headY, headR, headR * 0.92)
		If speciesShape(s) = SHAPE_FOUR_LEGS
			Color lr, lg, lb
			ArtOval(headX - headR * 0.6, headY + headR * 0.3, headR * 0.55, headR * 0.4) ; The snout.
		EndIf
	ElseIf parts And PART_EARS
		Color r, g, b
		ArtTriangle(bodyX - 22, bodyY - 18, bodyX - 8, bodyY - 26, bodyX - 22, bodyY - 42)
		ArtTriangle(bodyX + 4, bodyY - 27, bodyX + 18, bodyY - 20, bodyX + 12, bodyY - 42)
	EndIf
	If speciesShape(s) = SHAPE_BIRD
		Color 240, 180, 60
		ArtTriangle(headX - headR * 0.8, headY - 3, headX - headR * 0.8, headY + 5, headX - headR * 1.7, headY + 2)
	EndIf
	If speciesShape(s) = SHAPE_UPRIGHT
		Color dr, dg, db
		ArtOval(bodyX - bodyRX * 0.9, bodyY - 4, 6, 10)
	EndIf

	; Parts on the head.
	Local topX# = headX, topY# = headY - headR * 0.9
	If speciesShape(s) = SHAPE_BLOB Then topY = bodyY - bodyRY
	If parts And PART_HORNS
		Color 240, 230, 200
		ArtTriangle(topX - 8, topY + 4, topX - 2, topY + 2, topX - 12, topY - 14)
		ArtTriangle(topX + 2, topY + 2, topX + 8, topY + 4, topX + 10, topY - 14)
	EndIf
	If parts And PART_LEAF
		Color 60, 130, 40
		ArtLine(topX, topY + 2, topX + 2, topY - 10, 2)
		Color 110, 210, 80
		ArtOval(topX - 6, topY - 12, 8, 4)
		ArtOval(topX + 9, topY - 14, 8, 4)
	EndIf
	If parts And PART_CREST
		Color ar, ag, ab
		ArtTriangle(topX - 4, topY + 4, topX + 4, topY + 4, topX - 6, topY - 14)
		ArtTriangle(topX, topY + 4, topX + 8, topY + 4, topX + 6, topY - 16)
		ArtTriangle(topX + 4, topY + 4, topX + 12, topY + 6, topX + 16, topY - 10)
	EndIf
	If parts And PART_ANTENNA
		Color dr, dg, db
		ArtLine(topX, topY + 2, topX - 6, topY - 14, 2)
		Color ar, ag, ab
		ArtOval(topX - 6, topY - 16, 5, 5)
		Color 255, 255, 230
		ArtOval(topX - 7, topY - 17, 2, 2)
	EndIf
	If parts And PART_GEM
		Color ar, ag, ab
		ArtTriangle(headX - 4, headY - headR * 0.45, headX + 4, headY - headR * 0.45, headX, headY - headR * 0.85)
		ArtTriangle(headX - 4, headY - headR * 0.45, headX + 4, headY - headR * 0.45, headX, headY - headR * 0.1)
	EndIf
	If parts And PART_FINS
		Color ar, ag, ab
		ArtTriangle(bodyX - 6, bodyY - bodyRY * 0.85, bodyX + 14, bodyY - bodyRY * 0.85, bodyX + 12, bodyY - bodyRY - 14)
		ArtTriangle(bodyX - 6, bodyY + 2, bodyX + 6, bodyY + 4, bodyX + 4, bodyY + 16)
	EndIf
	If parts And PART_WINGS
		Color ar, ag, ab
		ArtOval(bodyX + 4, bodyY - 4, 16, 11)
		Color ar * 3 / 4, ag * 3 / 4, ab * 3 / 4
		ArtLine(bodyX - 4, bodyY - 2, bodyX + 16, bodyY + 2, 1)
		ArtLine(bodyX - 2, bodyY + 3, bodyX + 14, bodyY + 7, 1)
	EndIf

	; The eye looks forward, with a shine in it.
	Local eyeX# = headX - headR * 0.4, eyeY# = headY - headR * 0.1, eyeR# = Max(4, headR * 0.28)
	If speciesShape(s) = SHAPE_BLOB Then eyeX = bodyX - 14 : eyeY = bodyY - 8 : eyeR = 6
	Color 250, 250, 250
	ArtOval(eyeX, eyeY, eyeR, eyeR * 1.15)
	Color 24, 22, 34
	ArtOval(eyeX - eyeR * 0.35, eyeY + eyeR * 0.1, eyeR * 0.62, eyeR * 0.8)
	Color 255, 255, 255
	ArtOval(eyeX - eyeR * 0.5, eyeY - eyeR * 0.3, eyeR * 0.25, eyeR * 0.25)
	If speciesShape(s) = SHAPE_BLOB
		; Blobs have a second eye and a small mouth.
		Color 250, 250, 250
		ArtOval(eyeX + 16, eyeY, eyeR * 0.9, eyeR * 1.05)
		Color 24, 22, 34
		ArtOval(eyeX + 16 - eyeR * 0.3, eyeY + eyeR * 0.1, eyeR * 0.55, eyeR * 0.75)
		ArtLine(eyeX + 4, eyeY + 12, eyeX + 10, eyeY + 13, 1)
	EndIf

	SetBuffer BackBuffer()
	OutlineImage(image)
	Return image
End Function

; --- Sounds ---

; Makes a short sound effect without any sound file: it writes a WAV file into a bank, saves it to the temporary
; folder, loads it and deletes the file again.
Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0
	Local i%
	For i = 0 To samples - 1
		Local t# = Float(i) / samples
		Local hz# = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Local v#
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1
			Case WAVE_SINE
				v = Sin(phase)
			Case WAVE_TRIANGLE
				v = 1 - Abs(phase - 180) / 90.0
			Default
				v = Rnd(-1, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		Local envelope# = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.6 Then envelope = envelope * (1.0 - t) / 0.4
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "blitzard-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i%
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

; --- Watermark ---
; Every pixel where (x * 7 + y * 13) Mod 29 is below 3 gets the background colour with one more blue. Nobody can see
; it, but a program can find the pattern again in a screenshot, which shows that the picture came from this sample
; game. The pattern is drawn as a masked image just after Cls, so everything else is drawn over it.

Function DrawWatermark(r, g, b)
	Local rgb = (r Shl 16) Or (g Shl 8) Or b
	If watermark = 0 Or rgb <> watermarkColor
		If watermark <> 0 Then FreeImage watermark
		watermark = CreateImage(SCREEN_W, SCREEN_H)
		watermarkColor = rgb
		Local marked = b + 1
		If b = 255 Then marked = 254
		Local x, y, buffer = ImageBuffer(watermark)
		LockBuffer buffer
		For y = 0 To SCREEN_H - 1
			For x = 0 To SCREEN_W - 1
				; Black is the mask colour, so only the marked pixels are drawn.
				If (x * 7 + y * 13) Mod 29 < 3
					WritePixelFast x, y, (r Shl 16) Or (g Shl 8) Or marked, buffer
				Else
					WritePixelFast x, y, 0, buffer
				EndIf
			Next
		Next
		UnlockBuffer buffer
	EndIf
	DrawImage watermark, 0, 0
End Function
