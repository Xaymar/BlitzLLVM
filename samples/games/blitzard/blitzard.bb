; Splits text into lines that fit a width. The lines go into wrapLine and the count is given back.
Function WrapText(text$, width)
	Local count = 0, line$ = "", word$
	text = text + " "
	While text <> "" And count < 15
		Local space = Instr(text, " ")
		word = Left(text, space - 1)
		text = Mid(text, space + 1)
		If line = ""
			line = word
		ElseIf StringWidth(line + " " + word) <= width
			line = line + " " + word
		Else
			wrapLine(count) = line
			count = count + 1
			line = word
		EndIf
	Wend
	If line <> "" Then wrapLine(count) = line : count = count + 1
	Return count
End Function

; Draws wrapped text, showing only the first "visible" characters for the typewriter effect.
Function DrawWrapped(text$, x, y, width, lineH, visible)
	Local count = WrapText(text, width), i, shownChars = visible
	For i = 0 To count - 1
		If shownChars <= 0 Then Return
		Text x, y + i * lineH, Left(wrapLine(i), shownChars)
		shownChars = shownChars - Len(wrapLine(i)) - 1
	Next
End Function

