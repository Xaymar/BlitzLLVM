; Ion Tide: a side-scrolling shooter through a glowing cavern.
;
; Every picture and sound in this game is made by the code itself, so there are no files to ship with it.
;
; Controls:
;   Arrow keys or W A S D   fly
;   Space or Left Ctrl      fire (hold it down)
;   P                       pause
;   Escape                  back to the title screen, or quit from there
;
; Orange orbs make your gun stronger, up to five levels. Blue orbs repair the shield. Touching the cavern walls or
; an enemy costs shield, and a ship without shield is lost. Survive the waves to meet the guardian at the end.
;
; Works on: the original Blitz3D and BlitzPlus, and BlitzLLVM.

Const SCREEN_W = 800, SCREEN_H = 600
Const SCROLL_SPEED# = 2.0
Const WALL_SEGMENT = 16                       ; The cavern is made of strips this wide.
Const WALL_SEGMENTS = SCREEN_W / WALL_SEGMENT + 2
Const PLAYER_SPEED# = 4.5, PLAYER_MAX_SHIELD = 5, START_LIVES = 3
Const FIRE_DELAY = 7                          ; Frames between shots.

Const STATE_TITLE = 0, STATE_PLAY = 1, STATE_PAUSED = 2, STATE_DEAD = 3, STATE_OVER = 4, STATE_WON = 5

Const KEY_ESCAPE = 1, KEY_W = 17, KEY_P = 25, KEY_A = 30, KEY_S = 31, KEY_D = 32, KEY_CTRL = 29, KEY_SPACE = 57
Const KEY_UP = 200, KEY_DOWN = 208, KEY_LEFT = 203, KEY_RIGHT = 205

Const ENEMY_DRIFTER = 1, ENEMY_GUNNER = 2, ENEMY_DIVER = 3, ENEMY_MINE = 4, ENEMY_GUARDIAN = 5
Const ORB_POWER = 1, ORB_SHIELD = 2

Type Bullet
	Field x#, y#, vx#, vy#
	Field friendly       ; True for the player's shots.
End Type

Type Enemy
	Field kind
	Field x#, y#, vx#, vy#
	Field baseY#         ; For enemies that wave up and down around a line.
	Field age
	Field health
	Field flash          ; Frames left of the white "hit" flash.
	Field image
End Type

Type Orb
	Field x#, y#
	Field kind
	Field age
End Type

Type Particle
	Field x#, y#, vx#, vy#
	Field life#, fade#
	Field r, g, b
	Field size
End Type

Type Star
	Field x#, y#
	Field speed#
	Field brightness
End Type

; The cavern ceiling and floor heights, one per strip. wallStart is the strip at the left edge of the screen.
Dim ceilingY#(WALL_SEGMENTS - 1), floorY#(WALL_SEGMENTS - 1)
Global wallStart, wallOffset#, wallTime#, wallNarrow#

Global state = STATE_TITLE
Global playerX#, playerY#, shield, lives, gunLevel, fireTimer, invulnerable
Global score, highScore
Global frame, waveTimer, nextWave, guardianAlive, guardianMaxHealth
Global shake#, deadTimer

Graphics SCREEN_W, SCREEN_H, 0, 2
AppTitle "Ion Tide"
SetBuffer BackBuffer()
SeedRnd MilliSecs()

; --- Pictures made in code ------------------------------------------------------------------------------------------
; Each picture is drawn into an image once at the start. MaskImage makes black see-through, and MidHandle puts the
; image's handle in its middle, so positions are the centre of each ship.
Global imagePlayer = MakeShipImage(48, 24, 80, 200, 255, True)
Global imageDrifter = MakeShipImage(36, 22, 255, 120, 80, False)
Global imageGunner = MakeShipImage(44, 30, 220, 90, 220, False)
Global imageDiver = MakeShipImage(30, 18, 255, 220, 70, False)
Global imageMine = MakeMineImage(26)
Global imageGuardian = MakeGuardianImage(150, 120)
Global imageShot = MakeGlowImage(14, 6, 150, 255, 255)
Global imageEnemyShot = MakeGlowImage(10, 10, 255, 110, 90)

Const WAVE_SQUARE = 0, WAVE_SINE = 1, WAVE_NOISE = 2
Global soundShot = MakeSound(1400, 700, 50, WAVE_SQUARE, 0.12)
Global soundEnemyShot = MakeSound(500, 300, 80, WAVE_SQUARE, 0.12)
Global soundHit = MakeSound(300, 200, 40, WAVE_NOISE, 0.2)
Global soundBoom = MakeSound(220, 40, 500, WAVE_NOISE, 0.35)
Global soundBigBoom = MakeSound(120, 20, 1500, WAVE_NOISE, 0.45)
Global soundOrb = MakeSound(600, 1800, 200, WAVE_SINE, 0.3)
Global soundHurt = MakeSound(200, 90, 300, WAVE_SQUARE, 0.25)

Local i, s.Star
For i = 1 To 140
	s = New Star
	s\x = Rnd(Float(SCREEN_W)) : s\y = Rnd(Float(SCREEN_H))
	s\speed = Rnd(0.2, 1.6)
	s\brightness = Int(60 + s\speed * 110)
Next

ResetCavern()
Local timer = CreateTimer(60)

Local quit = False
While Not quit
	WaitTimer timer
	frame = frame + 1

	Select state
		Case STATE_TITLE
			ScrollCavern()
			If KeyHit(KEY_SPACE) Then StartGame()
			If KeyHit(KEY_ESCAPE) Then quit = True
		Case STATE_PLAY
			ScrollCavern()
			UpdatePlayer()
			UpdateWaves()
			UpdateEnemies()
			UpdateBullets()
			UpdateOrbs()
			If KeyHit(KEY_P) Then state = STATE_PAUSED
		Case STATE_PAUSED
			If KeyHit(KEY_P) Then state = STATE_PLAY
		Case STATE_DEAD
			; Keep the world moving for a moment after the ship is lost.
			ScrollCavern()
			UpdateEnemies()
			UpdateBullets()
			deadTimer = deadTimer - 1
			If deadTimer <= 0
				If lives > 0
					RespawnPlayer()
				Else
					EndGame(STATE_OVER)
				EndIf
			EndIf
		Case STATE_OVER, STATE_WON
			ScrollCavern()
			If KeyHit(KEY_SPACE) Then state = STATE_TITLE
	End Select
	If state <> STATE_TITLE And KeyHit(KEY_ESCAPE) Then state = STATE_TITLE : ClearWorld()

	UpdateStars()
	UpdateParticles()
	DrawGame()
	Flip 0
Wend

End

; --- Game flow -------------------------------------------------------------------------------------------------------

Function StartGame()
	ClearWorld()
	score = 0
	lives = START_LIVES
	gunLevel = 1
	nextWave = 0
	waveTimer = 120
	guardianAlive = False
	ResetCavern()
	RespawnPlayer()
	FlushKeys
End Function

Function RespawnPlayer()
	playerX = 120
	playerY = Float(SCREEN_H / 2)
	shield = PLAYER_MAX_SHIELD
	invulnerable = 120
	Delete Each Bullet
	state = STATE_PLAY
End Function

Function EndGame(newState)
	If score > highScore Then highScore = score
	state = newState
End Function

Function ClearWorld()
	Delete Each Enemy
	Delete Each Bullet
	Delete Each Orb
End Function

Function DamagePlayer(amount)
	If invulnerable > 0 Then Return
	shield = shield - amount
	invulnerable = 45
	shake = 8
	PlaySound soundHurt
	If shield <= 0
		lives = lives - 1
		Explode(playerX, playerY, 80, 120, 220, 255)
		PlaySound soundBigBoom
		shake = 20
		If gunLevel > 1 Then gunLevel = gunLevel - 1 ; Losing a ship costs one gun level.
		deadTimer = 120
		state = STATE_DEAD
	EndIf
End Function

; --- Cavern ----------------------------------------------------------------------------------------------------------
; The walls come from adding a few sine waves of different lengths. That gives smooth, never repeating shapes
; without any stored level. The gap narrows slowly as the game goes on.

Function ResetCavern()
	wallTime = 0
	wallNarrow = 0
	wallOffset = 0
	wallStart = 0
	Local i%
	For i = 0 To WALL_SEGMENTS - 1
		ComputeWall(i)
	Next
End Function

Function ComputeWall(i)
	wallTime = wallTime + 1
	Local t# = wallTime
	; Move the narrowing a little towards its goal for each strip, so the walls never jump.
	Local goal# = 0
	If state = STATE_PLAY Then goal = Float(nextWave * 4)
	If goal > 60 Then goal = 60
	If wallNarrow < goal Then wallNarrow = wallNarrow + 0.25
	If wallNarrow > goal Then wallNarrow = wallNarrow - 0.25
	ceilingY(i) = 70 + wallNarrow + 35 * Sin(t * 3.1) + 20 * Sin(t * 7.3 + 40) + 10 * Sin(t * 17.0)
	floorY(i) = SCREEN_H - 70 - wallNarrow + 35 * Sin(t * 2.3 + 90) + 20 * Sin(t * 6.1 + 10) + 10 * Sin(t * 15.0 + 5)
End Function

Function ScrollCavern()
	wallOffset = wallOffset + SCROLL_SPEED
	While wallOffset >= WALL_SEGMENT
		wallOffset = wallOffset - WALL_SEGMENT
		; The strip that left the screen is reused for a new one on the right: the array works like a ring.
		ComputeWall(wallStart)
		wallStart = (wallStart + 1) Mod WALL_SEGMENTS
	Wend
End Function

; Gives the ceiling (wantFloor False) or floor height at a screen x position, blending between strips.
Function WallAt#(x#, wantFloor)
	Local position# = (x + wallOffset) / WALL_SEGMENT
	Local index = Int(Floor(position))
	If index < 0 Then index = 0
	If index > WALL_SEGMENTS - 2 Then index = WALL_SEGMENTS - 2
	Local f# = position - index
	Local a = (wallStart + index) Mod WALL_SEGMENTS
	Local b = (wallStart + index + 1) Mod WALL_SEGMENTS
	If wantFloor Then Return floorY(a) + (floorY(b) - floorY(a)) * f
	Return ceilingY(a) + (ceilingY(b) - ceilingY(a)) * f
End Function

; --- Player ----------------------------------------------------------------------------------------------------------

Function UpdatePlayer()
	Local dx# = Float((KeyDown(KEY_RIGHT) Or KeyDown(KEY_D)) - (KeyDown(KEY_LEFT) Or KeyDown(KEY_A)))
	Local dy# = Float((KeyDown(KEY_DOWN) Or KeyDown(KEY_S)) - (KeyDown(KEY_UP) Or KeyDown(KEY_W)))
	; Moving diagonally should not be faster than moving straight.
	If dx <> 0 And dy <> 0 Then dx = dx * 0.7071 : dy = dy * 0.7071
	playerX = playerX + dx * PLAYER_SPEED
	playerY = playerY + dy * PLAYER_SPEED
	If playerX < 30 Then playerX = 30
	If playerX > SCREEN_W - 200 Then playerX = Float(SCREEN_W - 200)
	If playerY < 20 Then playerY = 20
	If playerY > SCREEN_H - 20 Then playerY = Float(SCREEN_H - 20)

	If invulnerable > 0 Then invulnerable = invulnerable - 1

	; Exhaust flame behind the ship.
	If frame Mod 2 = 0 Then AddParticle(playerX - 24, playerY + Rnd(-3.0, 3), Rnd(-4.0, -2.0), Rnd(-0.3, 0.3), 0.06, 120, 200, 255, 3)

	; Scraping the cavern walls hurts.
	If playerY - 10 < WallAt(playerX, False) Or playerY + 10 > WallAt(playerX, True)
		DamagePlayer(1)
		If playerY - 10 < WallAt(playerX, False) Then playerY = WallAt(playerX, False) + 12 Else playerY = WallAt(playerX, True) - 12
	EndIf

	If fireTimer > 0 Then fireTimer = fireTimer - 1
	If (KeyDown(KEY_SPACE) Or KeyDown(KEY_CTRL)) And fireTimer = 0
		FireGun()
		fireTimer = FIRE_DELAY
	EndIf
End Function

; Each gun level adds shots. Level 1 is a single shot, level 5 a wide spread.
Function FireGun()
	PlaySound soundShot
	FireShot(playerX + 24, playerY, 11, 0)
	If gunLevel >= 2 Then FireShot(playerX + 18, playerY - 8, 11, 0) : FireShot(playerX + 18, playerY + 8, 11, 0)
	If gunLevel >= 3 Then FireShot(playerX + 16, playerY - 4, 10.5, -1.6) : FireShot(playerX + 16, playerY + 4, 10.5, 1.6)
	If gunLevel >= 4 Then FireShot(playerX, playerY - 10, -9.0, -1.0) : FireShot(playerX, playerY + 10, -9.0, 1) ; Rear guns.
	If gunLevel >= 5 Then FireShot(playerX + 16, playerY, 10, -3.2) : FireShot(playerX + 16, playerY, 10, 3.2)
End Function

Function FireShot(x#, y#, vx#, vy#)
	Local b.Bullet = New Bullet
	b\x = x : b\y = y
	b\vx = vx : b\vy = vy
	b\friendly = True
End Function

; --- Waves -----------------------------------------------------------------------------------------------------------
; Waves are stored in Data lines at the bottom: kind, how many, the gap between them in frames, the height to come
; in at (0 means random), and the pause after the wave. A kind of 0 ends the list.

Function UpdateWaves()
	If guardianAlive Then Return
	waveTimer = waveTimer - 1
	If waveTimer > 0 Then Return

	Local kind, count, gap, height, pause
	Restore waves
	Local i%
	For i = 0 To nextWave
		Read kind, count, gap, height, pause
	Next
	If kind = 0
		; All waves done: the guardian arrives.
		SpawnEnemy(ENEMY_GUARDIAN, Float(SCREEN_W + 100), Float(SCREEN_H / 2), 0)
		guardianAlive = True
		Return
	EndIf

	For i = 0 To count - 1
		Local y# = Float(height)
		If y = 0 Then y = Rnd(160, Float(SCREEN_H - 160))
		SpawnEnemy(kind, SCREEN_W + 30 + i * gap * SCROLL_SPEED, y, i)
	Next
	nextWave = nextWave + 1
	waveTimer = pause
End Function

Function SpawnEnemy(kind, x#, y#, index)
	Local e.Enemy = New Enemy
	e\kind = kind
	e\x = x : e\y = y : e\baseY = y
	e\age = -index * 10 ; Members of a wave are a little out of step, so they move like a snake.
	Select kind
		Case ENEMY_DRIFTER : e\health = 2 : e\image = imageDrifter : e\vx = -2.6
		Case ENEMY_GUNNER : e\health = 6 : e\image = imageGunner : e\vx = -1.4
		Case ENEMY_DIVER : e\health = 2 : e\image = imageDiver : e\vx = -4.5
		Case ENEMY_MINE : e\health = 4 : e\image = imageMine : e\vx = -SCROLL_SPEED
		Case ENEMY_GUARDIAN : e\health = 300 : e\image = imageGuardian : e\vx = -1.0
	End Select
	If kind = ENEMY_GUARDIAN Then guardianMaxHealth = e\health
End Function

; --- Enemies ---------------------------------------------------------------------------------------------------------

Function UpdateEnemies()
	Local e.Enemy
	For e.Enemy = Each Enemy
		e\age = e\age + 1
		If e\flash > 0 Then e\flash = e\flash - 1
		Select e\kind
			Case ENEMY_DRIFTER
				; Weaves up and down on a sine wave.
				e\x = e\x + e\vx
				e\y = e\baseY + Sin(Float(e\age * 4)) * 60
			Case ENEMY_GUNNER
				; Slows down on screen and shoots at the player now and then.
				If e\x < SCREEN_W - 120 Then e\vx = e\vx * 0.98 - 0.006
				e\x = e\x + e\vx
				e\y = e\y + (playerY - e\y) * 0.01
				If e\age > 0 And e\age Mod 70 = 0 And state = STATE_PLAY Then AimShot(e\x - 20, e\y, 4.5)
			Case ENEMY_DIVER
				; Flies in fast, then swoops towards the player's height.
				e\x = e\x + e\vx
				If e\x < SCREEN_W - 100 Then e\vy = e\vy + Sgn(playerY - e\y) * 0.25
				e\vy = e\vy * 0.95
				e\y = e\y + e\vy
			Case ENEMY_MINE
				; Floats with the cavern and spins slowly.
				e\x = e\x + e\vx
				e\y = e\baseY + Sin(Float(e\age * 2)) * 10
			Case ENEMY_GUARDIAN
				UpdateGuardian(e)
		End Select

		; Touching an enemy hurts the player. Enemies other than the guardian blow up when they touch.
		If state = STATE_PLAY
			If ImagesCollide(imagePlayer, Int(playerX), Int(playerY), 0, e\image, Int(e\x), Int(e\y), 0)
				DamagePlayer(1)
				If e\kind <> ENEMY_GUARDIAN Then e\health = 0
			EndIf
		EndIf

		If e\health <= 0
			KillEnemy(e)
		ElseIf e\x < -120
			Delete e
		EndIf
	Next
End Function

Function UpdateGuardian(e.Enemy)
	; Moves in, then hovers on the right and fires patterns that get faster as it weakens.
	If e\x > SCREEN_W - 140 Then e\x = e\x + e\vx Else e\x = SCREEN_W - 140 + Sin(e\age * 0.7) * 20
	e\y = SCREEN_H / 2 + Sin(e\age * 1.1) * 120
	If e\x > SCREEN_W - 10 Then Return

	Local anger# = 1.0 - Float(e\health) / guardianMaxHealth
	Local rate = Int(50 - anger * 30)
	Local a%
	If e\age Mod rate = 0
		; A fan of shots.
		For a = -30 To 30 Step 15
			EnemyShot(e\x - 60, e\y, -4 * Cos(Float(a)), 4 * Sin(Float(a)))
		Next
	EndIf
	If e\age Mod 90 = 45 Then AimShot(e\x - 60, e\y - 40, 5) : AimShot(e\x - 60, e\y + 40, 5)
End Function

Function KillEnemy(e.Enemy)
	Select e\kind
		Case ENEMY_DRIFTER : score = score + 100
		Case ENEMY_GUNNER : score = score + 300
		Case ENEMY_DIVER : score = score + 150
		Case ENEMY_MINE : score = score + 120
		Case ENEMY_GUARDIAN : score = score + 10000
	End Select

	Local i%
	If e\kind = ENEMY_GUARDIAN
		For i = 1 To 8
			Explode(e\x + Rnd(-60.0, 60), e\y + Rnd(-50.0, 50), 60, 255, Rand(120, 220), 80)
		Next
		PlaySound soundBigBoom
		shake = 30
		guardianAlive = False
		Delete Each Bullet
		Delete e
		EndGame(STATE_WON)
		Return
	EndIf

	Explode(e\x, e\y, 40, 255, 170, 80)
	PlaySound soundBoom
	shake = shake + 3
	; Sometimes an orb is left behind. Gunners always leave one.
	If e\kind = ENEMY_GUNNER Or Rand(1, 8) = 1
		Local o.Orb = New Orb
		o\x = e\x : o\y = e\y
		If Rand(1, 3) = 1 Then o\kind = ORB_SHIELD Else o\kind = ORB_POWER
	EndIf
	Delete e
End Function

Function EnemyShot(x#, y#, vx#, vy#)
	Local b.Bullet = New Bullet
	b\x = x : b\y = y
	b\vx = vx : b\vy = vy
	b\friendly = False
End Function

Function AimShot(x#, y#, speed#)
	Local angle# = ATan2(playerY - y, playerX - x)
	EnemyShot(x, y, Cos(angle) * speed, Sin(angle) * speed)
	PlaySound soundEnemyShot
End Function

; --- Bullets and orbs ------------------------------------------------------------------------------------------------

Function UpdateBullets()
	Local b.Bullet
	Local e.Enemy
	For b.Bullet = Each Bullet
		b\x = b\x + b\vx
		b\y = b\y + b\vy
		Local gone = b\x < -20 Or b\x > SCREEN_W + 20 Or b\y < -20 Or b\y > SCREEN_H + 20

		; Shots stop at the cavern walls.
		If Not gone
			If b\y < WallAt(b\x, False) Or b\y > WallAt(b\x, True)
				AddParticle(b\x, b\y, Rnd(-1.0, 1), Rnd(-1.0, 1), 0.08, 200, 200, 255, 2)
				gone = True
			EndIf
		EndIf

		If Not gone
			If b\friendly
				For e.Enemy = Each Enemy
					If ImageRectCollide(e\image, Int(e\x), Int(e\y), 0, Int(b\x - 6), Int(b\y - 2), 12, 4)
						e\health = e\health - 1
						e\flash = 3
						score = score + 5
						PlaySound soundHit
						AddParticle(b\x, b\y, Rnd(-2.0, 0), Rnd(-2.0, 2), 0.06, 255, 255, 200, 2)
						gone = True
						Exit
					EndIf
				Next
			ElseIf state = STATE_PLAY
				If ImageRectCollide(imagePlayer, Int(playerX), Int(playerY), 0, Int(b\x - 4), Int(b\y - 4), 8, 8)
					DamagePlayer(1)
					gone = True
				EndIf
			EndIf
		EndIf

		If gone Then Delete b
	Next
End Function

Function UpdateOrbs()
	Local o.Orb
	For o.Orb = Each Orb
		o\age = o\age + 1
		o\x = o\x - SCROLL_SPEED * 0.6
		o\y = o\y + Sin(Float(o\age * 5)) * 0.8
		If Abs(o\x - playerX) < 26 And Abs(o\y - playerY) < 22
			PlaySound soundOrb
			score = score + 250
			If o\kind = ORB_POWER
				If gunLevel < 5 Then gunLevel = gunLevel + 1
			Else
				shield = PLAYER_MAX_SHIELD
			EndIf
			Delete o
		ElseIf o\x < -20
			Delete o
		EndIf
	Next
End Function

; --- Effects ---------------------------------------------------------------------------------------------------------

Function Explode(x#, y#, count, r, g, b)
	Local i%
	For i = 1 To count
		Local angle# = Rnd(360), speed# = Rnd(0.5, 5)
		AddParticle(x, y, Cos(angle) * speed, Sin(angle) * speed, Rnd(0.01, 0.03), r, g, b, Rand(2, 4))
	Next
	; A few white-hot sparks in the middle.
	For i = 1 To count / 4
		angle = Rnd(360) : speed = Rnd(0.5, 2)
		AddParticle(x, y, Cos(angle) * speed, Sin(angle) * speed, 0.05, 255, 255, 255, 3)
	Next
End Function

Function AddParticle(x#, y#, vx#, vy#, fade#, r, g, b, size)
	Local p.Particle = New Particle
	p\x = x : p\y = y : p\vx = vx : p\vy = vy
	p\life = 1 : p\fade = fade
	p\r = r : p\g = g : p\b = b
	p\size = size
End Function

Function UpdateParticles()
	Local p.Particle
	For p.Particle = Each Particle
		p\x = p\x + p\vx - SCROLL_SPEED * 0.3
		p\y = p\y + p\vy
		p\vx = p\vx * 0.97 : p\vy = p\vy * 0.97
		p\life = p\life - p\fade
		If p\life <= 0 Then Delete p
	Next
	If shake > 0 Then shake = shake * 0.88 - 0.1
End Function

Function UpdateStars()
	Local s.Star
	For s.Star = Each Star
		s\x = s\x - s\speed * SCROLL_SPEED
		If s\x < 0 Then s\x = s\x + SCREEN_W : s\y = Rnd(Float(SCREEN_H))
	Next
End Function

; --- Drawing ---------------------------------------------------------------------------------------------------------

Function DrawGame()
	Local ox = 0, oy = 0
	If shake > 0 Then ox = Rand(Int(-shake), Int(shake)) : oy = Rand(Int(-shake), Int(shake))
	Origin ox, oy

	ClsColor 4, 4, 14
	Cls

	; Far away stars move slowly, close ones quickly. That difference makes the scene look deep.
	Local s.Star
	For s.Star = Each Star
		Color s\brightness / 2, s\brightness / 2, s\brightness
		Rect Int(s\x), Int(s\y), 1 + (s\speed > 1), 1, 1
	Next

	DrawCavern()

	Local o.Orb
	For o.Orb = Each Orb
		Local pulse = Int(3 * Sin(Float(o\age * 8)))
		If o\kind = ORB_POWER Then Color 255, 150, 40 Else Color 60, 160, 255
		Oval Int(o\x - 10 - pulse), Int(o\y - 10 - pulse), 20 + pulse * 2, 20 + pulse * 2, 1
		Color 255, 255, 255
		Oval Int(o\x - 4), Int(o\y - 4), 8, 8, 1
	Next

	Local e.Enemy
	For e.Enemy = Each Enemy
		DrawImage e\image, Int(e\x), Int(e\y)
		If e\flash > 0
			Color 255, 255, 255
			Oval Int(e\x - 6), Int(e\y - 6), 12, 12, 1
		EndIf
	Next

	Local b.Bullet
	For b.Bullet = Each Bullet
		If b\friendly
			DrawImage imageShot, Int(b\x), Int(b\y)
		Else
			DrawImage imageEnemyShot, Int(b\x), Int(b\y)
		EndIf
	Next

	; The ship blinks while it cannot be hurt.
	If state = STATE_PLAY Or state = STATE_PAUSED
		If invulnerable = 0 Or (frame / 4) Mod 2 = 0 Then DrawImage imagePlayer, Int(playerX), Int(playerY)
	EndIf

	Local p.Particle
	For p.Particle = Each Particle
		Color Int(p\r * p\life), Int(p\g * p\life), Int(p\b * p\life)
		Rect Int(p\x), Int(p\y), p\size, p\size, 1
	Next

	Origin 0, 0
	DrawHud()
End Function

Function DrawCavern()
	; Each strip of wall is a filled rectangle from the edge of the screen to the wall height, with a bright rim.
	Local glow# = 0.5 + 0.5 * Sin(Float(frame * 2))
	Local i%
	For i = 0 To WALL_SEGMENTS - 2
		Local x = Int(i * WALL_SEGMENT - wallOffset)
		Local a = (wallStart + i) Mod WALL_SEGMENTS
		Color 20, 30, 60
		Rect x, 0, WALL_SEGMENT, Int(ceilingY(a)), 1
		Rect x, Int(floorY(a)), WALL_SEGMENT, Int(SCREEN_H - floorY(a)), 1
		Local b = (wallStart + i + 1) Mod WALL_SEGMENTS
		Color Int(60 + 60 * glow), Int(120 + 80 * glow), 255
		Line x, Int(ceilingY(a)), x + WALL_SEGMENT, Int(ceilingY(b))
		Line x, Int(floorY(a)), x + WALL_SEGMENT, Int(floorY(b))
		Color 40, 70, 140
		Line x, Int(ceilingY(a) - 3), x + WALL_SEGMENT, Int(ceilingY(b) - 3)
		Line x, Int(floorY(a) + 3), x + WALL_SEGMENT, Int(floorY(b) + 3)
	Next
End Function

Function DrawHud()
	Color 220, 230, 255
	Text 16, 10, "Score " + score
	Text SCREEN_W - 16 - StringWidth("Best " + highScore), 10, "Best " + highScore

	Local i%
	If state <> STATE_TITLE
		Text 16, SCREEN_H - 24, "Shield"
		For i = 1 To PLAYER_MAX_SHIELD
			If i <= shield Then Color 60, 160, 255 Else Color 30, 40, 70
			Rect 70 + i * 18, SCREEN_H - 22, 14, 10, 1
		Next
		Color 255, 160, 60
		Text 220, SCREEN_H - 24, "Gun " + gunLevel
		Color 220, 230, 255
		Text 300, SCREEN_H - 24, "Ships " + lives
	EndIf

	Local e.Enemy
	If guardianAlive
		For e.Enemy = Each Enemy
			If e\kind = ENEMY_GUARDIAN
				Color 80, 20, 20
				Rect 200, 30, 400, 8, 1
				Color 255, 70, 60
				Rect 200, 30, 400 * e\health / guardianMaxHealth, 8, 1
			EndIf
		Next
	EndIf

	Color 255, 240, 200
	Select state
		Case STATE_TITLE
			DrawImage imageGuardian, SCREEN_W / 2, Int(200 + Sin(Float(frame)) * 10)
			Color 150, 230, 255
			Text SCREEN_W / 2, 300, "I O N   T I D E", True, False
			Color 220, 230, 255
			Text SCREEN_W / 2, 340, "Arrows or WASD fly, Space or Ctrl fires.", True, False
			Text SCREEN_W / 2, 360, "Orange orbs power up the gun, blue orbs repair the shield.", True, False
			Text SCREEN_W / 2, 410, "Press Space to launch", True, False
		Case STATE_PAUSED
			Text SCREEN_W / 2, SCREEN_H / 2, "Paused - press P", True, True
		Case STATE_OVER
			Text SCREEN_W / 2, SCREEN_H / 2, "All ships lost. Press Space", True, True
		Case STATE_WON
			Text SCREEN_W / 2, SCREEN_H / 2, "The guardian is destroyed! Score " + score + ". Press Space", True, True
	End Select
End Function

; --- Pictures --------------------------------------------------------------------------------------------------------

; Draws a pointed ship into an image. Ships of the player point right, enemy ships point left.
Function MakeShipImage(w, h, r, g, b, facesRight)
	Local image = CreateImage(w, h)
	SetBuffer ImageBuffer(image)
	ClsColor 0, 0, 0
	Cls
	; The body is a stack of lines that get shorter towards the edges, which draws a filled wedge.
	Local y%
	For y = 0 To h - 1
		Local fromMiddle# = Abs(y - h / 2.0) / (h / 2.0)
		Local length = Int(w * (1.0 - fromMiddle * 0.85))
		Local shade# = 1.0 - fromMiddle * 0.6
		Color Int(r * shade), Int(g * shade), Int(b * shade)
		If facesRight Then Line 0, y, length, y Else Line w - 1, y, w - length, y
	Next
	; A cockpit and an engine glow.
	Color 255, 255, 255
	If facesRight
		Oval w / 2 - 2, h / 2 - 3, 8, 6, 1
		Color 255, 200, 80
		Rect 0, h / 2 - 2, 4, 4, 1
	Else
		Oval w / 2 - 6, h / 2 - 3, 8, 6, 1
		Color 255, 255, 120
		Rect w - 4, h / 2 - 2, 4, 4, 1
	EndIf
	SetBuffer BackBuffer()
	MaskImage image, 0, 0, 0
	MidHandle image
	Return image
End Function

Function MakeMineImage(size)
	Local image = CreateImage(size, size)
	SetBuffer ImageBuffer(image)
	ClsColor 0, 0, 0
	Cls
	Color 200, 60, 60
	Local a%
	For a = 0 To 315 Step 45
		Line size / 2, size / 2, Int(size / 2 + Cos(Float(a)) * size / 2), Int(size / 2 + Sin(Float(a)) * size / 2)
	Next
	Color 140, 40, 50
	Oval size / 4, size / 4, size / 2, size / 2, 1
	Color 255, 120, 100
	Oval size / 2 - 3, size / 2 - 3, 6, 6, 1
	SetBuffer BackBuffer()
	MaskImage image, 0, 0, 0
	MidHandle image
	Return image
End Function

Function MakeGuardianImage(w, h)
	Local image = CreateImage(w, h)
	SetBuffer ImageBuffer(image)
	ClsColor 0, 0, 0
	Cls
	; A large armoured shell made of layered ovals, with a glowing eye on the left side that faces the player.
	Local i%
	For i = 0 To 5
		Local shade# = 0.4 + i * 0.1
		Color Int(120 * shade), Int(60 * shade), Int(160 * shade)
		Oval i * 6, i * 5, w - i * 12, h - i * 10, 1
	Next
	Color 60, 30, 80
	For i = 1 To 5
		Line w / 2 + i * 8, 10, w / 2 + i * 8, h - 10
	Next
	Color 255, 80, 60
	Oval 12, h / 2 - 14, 28, 28, 1
	Color 255, 220, 160
	Oval 20, h / 2 - 6, 12, 12, 1
	SetBuffer BackBuffer()
	MaskImage image, 0, 0, 0
	MidHandle image
	Return image
End Function

Function MakeGlowImage(w, h, r, g, b)
	Local image = CreateImage(w, h)
	SetBuffer ImageBuffer(image)
	ClsColor 0, 0, 0
	Cls
	Color r / 3, g / 3, b / 3
	Oval 0, 0, w, h, 1
	Color r, g, b
	Oval w / 4, h / 4, w / 2, h / 2, 1
	SetBuffer BackBuffer()
	MaskImage image, 0, 0, 0
	MidHandle image
	Return image
End Function

; Makes a short sound effect without any sound file: it writes a WAV file into a bank, saves it to the temporary
; folder, loads it and deletes the file again. The pitch slides from startHz to endHz.
Function MakeSound(startHz#, endHz#, lengthMs, wave, volume#)
	Local rate = 22050
	Local samples = rate * lengthMs / 1000
	Local bank = CreateBank(44 + samples * 2)

	; The WAV header: a "RIFF" file holding one block of 16-bit mono sound.
	PokeAscii(bank, 0, "RIFF")
	PokeInt bank, 4, 36 + samples * 2
	PokeAscii(bank, 8, "WAVEfmt ")
	PokeInt bank, 16, 16        ; Size of the format block.
	PokeShort bank, 20, 1       ; Plain, uncompressed samples.
	PokeShort bank, 22, 1       ; One channel.
	PokeInt bank, 24, rate
	PokeInt bank, 28, rate * 2  ; Bytes per second.
	PokeShort bank, 32, 2       ; Bytes per sample.
	PokeShort bank, 34, 16      ; Bits per sample.
	PokeAscii(bank, 36, "data")
	PokeInt bank, 40, samples * 2

	Local phase# = 0
	Local i%
	For i = 0 To samples - 1
		Local t# = Float(i) / samples
		Local hz# = startHz + (endHz - startHz) * t
		phase = phase + 360.0 * hz / rate
		If phase >= 360 Then phase = phase - 360
		Local v#
		Select wave
			Case WAVE_SQUARE
				If phase < 180 Then v = 1 Else v = -1.0
			Case WAVE_SINE
				v = Sin(phase)
			Default
				v = Rnd(-1.0, 1)
		End Select
		; Fade in very quickly and fade out towards the end, so the sound does not click.
		Local envelope# = 1.0
		If i < 64 Then envelope = i / 64.0
		If t > 0.6 Then envelope = envelope * (1.0 - t) / 0.4
		PokeShort bank, 44 + i * 2, Int(v * envelope * volume * 32000) And $FFFF
	Next

	Local path$ = SystemProperty$("tempdir")
	If path <> "" And Right(path, 1) <> "\" And Right(path, 1) <> "/" Then path = path + "/"
	path = path + "ion-tide-sound-" + MilliSecs() + "-" + Rand(100000) + ".wav"
	Local file = WriteFile(path)
	If file = 0 Then FreeBank bank : Return 0 ; No sound, but the game still works.
	WriteBytes bank, file, 0, BankSize(bank)
	CloseFile file
	FreeBank bank

	Local sound = LoadSound(path)
	DeleteFile path
	Return sound
End Function

Function PokeAscii(bank, offset, text$)
	Local i%
	For i = 1 To Len(text)
		PokeByte bank, offset + i - 1, Asc(Mid(text, i, 1))
	Next
End Function

