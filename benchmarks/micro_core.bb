; Per object: First and After over 1000 objects.
Function Types_FirstAfter()
	If Not MicroCase("types/first-after-per-object") Then Return
	MicroPer = 1000
	MicroMakeItems 1000
	s = 0
	While MicroRun()
		For i = 1 To MicroN
