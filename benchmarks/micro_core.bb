		For i = 1 To MicroN
			o.MicroItem = Object.MicroItem(h)
			s = s + o\value
		Next
	Wend
	MicroSinkI = MicroSinkI + s
	Delete Each MicroItem
End Function

; Banks --------------------------------------------------------------------------------------------------------------------------

; CreateBank and FreeBank right after each other. A bank of size bytes takes size + 1 bytes of the allocator (BlitzLLVM), so 1023 is
; the 1024 byte size class.
Function Banks_CreateFree(size)
	If Not MicroCase("banks/create-free-" + size) Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			bank = CreateBank(size)
			s = s + bank
			FreeBank bank
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

; Per bank: 4096 banks are made, then all of them freed: the allocator takes and gives back many blocks of one size class in a row.
Function Banks_Many(size)
	If Not MicroCase("banks/create-4096-then-free-" + size) Then Return
	MicroPer = 4096
	While MicroRun()
		For i = 1 To MicroN
			For j = 0 To 4095
				MicroBanks(j) = CreateBank(size)
			Next
			For j = 0 To 4095
				FreeBank MicroBanks(j)
			Next
		Next
	Wend
End Function

Function Banks_PeekByte()
	If Not MicroCase("banks/peekbyte") Then Return
	bank = CreateBank(4096)
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + PeekByte(bank, i And 4095)
		Next
	Wend
	FreeBank bank
	MicroSinkI = MicroSinkI + s
End Function

