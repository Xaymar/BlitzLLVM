; The language -------------------------------------------------------------------------------------------------------------------

Function MicroTwice(value)
	Return value + value
End Function

Function Lang_Call()
	If Not MicroCase("lang/call") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + MicroTwice(i)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Lang_ArrayRead()
	If Not MicroCase("lang/dim-read") Then Return
	For i = 0 To 4095
		MicroArray(i) = i
	Next
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + MicroArray((i * 7) And 4095)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Lang_ArrayWrite()
	If Not MicroCase("lang/dim-write") Then Return
	While MicroRun()
		For i = 1 To MicroN
			MicroArray((i * 7) And 4095) = i
		Next
	Wend
	MicroSinkI = MicroSinkI + MicroArray(7)
End Function

Function Lang_Select()
	If Not MicroCase("lang/select") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			Select i And 7
				Case 0: s = s + 3
				Case 1: s = s + 5
				Case 2: s = s + 7
				Case 3: s = s + 11
				Default: s = s + 1
			End Select
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Lang_CallStays()
	If Not MicroCase("lang/call-not-inlined") Then Return
	While MicroRun()
		For i = 1 To MicroN
			MicroCallValue = i
			MicroStep()
		Next
	Wend
	MicroSinkI = MicroSinkI + MicroCallValue
End Function

; A user function that changes a global, which the compiler may or may not inline: the cost of a call that writes memory.
Function MicroStep()
	MicroCallValue = (MicroCallValue * 3) Xor (MicroCallValue Shr 2)
	If MicroCallValue And 1 Then MicroCallValue = MicroCallValue + MicroOne
End Function

