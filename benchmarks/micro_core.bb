Function Banks_Copy()
	If Not MicroCase("banks/copybank-256") Then Return
	a = CreateBank(4096)
	b = CreateBank(4096)
	While MicroRun()
		For i = 1 To MicroN
			CopyBank a, (i And 15) * 256, b, 256 * ((i Shr 4) And 15), 256
		Next
	Wend
	FreeBank a
	FreeBank b
End Function

Function Banks_Resize()
	If Not MicroCase("banks/resizebank-grow-shrink") Then Return
	bank = CreateBank(64)
	While MicroRun()
		For i = 1 To MicroN
			ResizeBank bank, 64 + (i And 1) * 4032
		Next
	Wend
	FreeBank bank
End Function

; Per access: the first word of each of 4096 banks of size bytes, one bank after the other.
Function Stride_Banks(size)
	If Not MicroCase("stride/banks-" + size) Then Return
	For j = 0 To 4095
		MicroBanks(j) = CreateBank(size)
		PokeInt MicroBanks(j), 0, j
	Next
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + PeekInt(MicroBanks(i And 4095), 0)
		Next
	Wend
	For j = 0 To 4095
		FreeBank MicroBanks(j)
	Next
	MicroSinkI = MicroSinkI + s
End Function

; Time ---------------------------------------------------------------------------------------------------------------------------

Function Time_MilliSecs()
	If Not MicroCase("time/millisecs") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + MilliSecs()
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

; Files --------------------------------------------------------------------------------------------------------------------------

Function Files_WriteInt()
	If Not MicroCase("files/writeint") Then Return
	file = WriteFile(MicroPath$)
	written = 0
	While MicroRun()
		For i = 1 To MicroN
			; Starts over every 1 MiB, so that the file stays small.
			If written = 262144 Then
				SeekFile file, 0
				written = 0
			EndIf
			WriteInt file, i
			written = written + 1
		Next
	Wend
	CloseFile file
End Function

Function Files_ReadInt()
	If Not MicroCase("files/readint") Then Return
	file = WriteFile(MicroPath$)
	For i = 1 To 262144
		WriteInt file, i
	Next
	CloseFile file
	file = ReadFile(MicroPath$)
	s = 0
	done = 0
	While MicroRun()
		For i = 1 To MicroN
			If done = 262144 Then
				SeekFile file, 0
				done = 0
			EndIf
			s = s + ReadInt(file)
			done = done + 1
		Next
	Wend
	CloseFile file
	MicroSinkI = MicroSinkI + s
End Function

Function Files_WriteLine()
	If Not MicroCase("files/writeline") Then Return
	file = WriteFile(MicroPath$)
	written = 0
	While MicroRun()
		For i = 1 To MicroN
			If written = 16384 Then
				SeekFile file, 0
				written = 0
			EndIf
			WriteLine file, MicroText$
			written = written + 1
		Next
	Wend
	CloseFile file
End Function

Function Files_ReadLine()
	If Not MicroCase("files/readline") Then Return
	file = WriteFile(MicroPath$)
	For i = 1 To 16384
		WriteLine file, MicroText$
	Next
	CloseFile file
	file = ReadFile(MicroPath$)
	s = 0
	done = 0
	While MicroRun()
		For i = 1 To MicroN
			If done = 16384 Then
				SeekFile file, 0
				done = 0
			EndIf
			s = s + Len(ReadLine$(file))
			done = done + 1
		Next
	Wend
	CloseFile file
	MicroSinkI = MicroSinkI + s
End Function

Function Files_FileType()
	If Not MicroCase("files/filetype") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + FileType(MicroPath$)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function
