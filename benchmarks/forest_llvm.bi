; BlitzLLVM side of the forest benchmark: a microsecond timer and the draw counters of Stats3D.

Global BenchBase:UInt64 = Microseconds()

; Microseconds since the start. Only differences are used, so a wrap after 35 minutes does no harm.
Function BenchMicros()
	Return Int(Microseconds() - BenchBase)
End Function

Function BenchDraws()
	Return Stats3D(1000)
End Function

Function BenchPipelines()
	Return Stats3D(1001)
End Function

Function BenchTextures()
	Return Stats3D(1002)
End Function

Function BenchBuffers()
	Return Stats3D(1003)
End Function

; Every texture is read through one sampler with 16 times anisotropic filtering, which keeps the textures on slanted ground and on thin branches from shimmering
; where the mip levels change (BlitzLLVM only). A texture whose flags have mip maps (8) uses them; the sampler decides how they are read.
Global BenchSampler = 0

Function BenchFilter(t)
	If BenchSampler = 0 Then
		BenchSampler = CreateSampler()
		SetSamplerAnisotropy BenchSampler, 16
	EndIf
	SetTextureSampler t, BenchSampler
End Function
