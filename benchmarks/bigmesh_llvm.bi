; BlitzLLVM side of the bigmesh benchmark: a microsecond timer, the setting of CameraCulling, and the count of clusters of Stats3D.

Global BenchBase:UInt64 = Microseconds()

Function BenchMicros()
	Return Int(Microseconds() - BenchBase)
End Function

Function BenchCulling(camera)
	mode$ = GetEnv$("BENCH_CULL")
	If mode$ = "" Then mode$ = "3"
	CameraCulling camera, Int(mode$)
End Function

Function BenchClusters()
	Return Stats3D(1004)
End Function

; Shows the frame. Flip 2 syncs the picture with the display without making the program wait, so the time stays the time of the program.
Function BenchFlip()
	Flip 2
End Function
