; BlitzLLVM side of the bigmesh benchmark: the setting of CameraCulling and the count of clusters of Stats3D. The timer, the flip and
; the counters every benchmark has are in bench_llvm.bi.

Function BenchCulling(camera)
	mode$ = GetEnv$("BENCH_CULL")
	If mode$ = "" Then mode$ = "3"
	CameraCulling camera, Int(mode$)
	Return Int(mode$)
End Function

Function BenchClusters()
	Return Stats3D(1004)
End Function
