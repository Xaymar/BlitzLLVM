; Movers (ellipsoids and spheres) that fall onto and slide over meshes with many triangles: a hilly hills and a few large spheres,
; with every response. Every frame the positions are written to a text file (in units of 0.0001), so that two compilers or two collision
; backends (BLITZLLVM_COLLISION_BACKEND=legacy|jolt) can be compared line by line, and the time of UpdateWorld is written last. Works with the
; original Blitz3D compiler and BlitzLLVM.
;
; Environment variables:
;   ORACLE_OUT      output file (default collision_mesh.txt)
;   ORACLE_FRAMES   frames (default 120)
;   ORACLE_MOVERS   movers (default 100)
;   ORACLE_GRID     squares per side of the hills (default 48, two triangles each)
Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

Function F$(v#)
	Return Int(v * 10000 + 0.5 * Sgn(v))
End Function

out$ = Env$("ORACLE_OUT", "collision_mesh.txt")
frames = Int(Env$("ORACLE_FRAMES", "120"))
movers = Int(Env$("ORACLE_MOVERS", "100"))
grid = Int(Env$("ORACLE_GRID", "48"))
SeedRnd 99

; The hills: from formulas, one surface, x and z from -50 to 50.
hills = CreateMesh()
surf = CreateSurface(hills)
For z = 0 To grid
	For x = 0 To grid
		px# = (x - grid / 2.0) * 100.0 / grid
		pz# = (z - grid / 2.0) * 100.0 / grid
		AddVertex surf, px, Sin(px * 9) * 2 + Cos(pz * 11) * 2, pz
	Next
Next
For z = 0 To grid - 1
	For x = 0 To grid - 1
		i = z * (grid + 1) + x
		AddTriangle surf, i, i + grid + 1, i + 1
		AddTriangle surf, i + 1, i + grid + 1, i + grid + 2
	Next
Next
UpdateNormals hills
EntityType hills, 2

Dim ball(4)
For k = 1 To 4
	ball(k) = CreateSphere(24)
	PositionEntity ball(k), -30 + k * 15, 3, Rnd(-30, 30)
	ScaleEntity ball(k), 5, 5, 5
	EntityType ball(k), 2
Next

Dim mover(movers)
For i = 1 To movers
	mover(i) = CreateSphere(4)
	PositionEntity mover(i), Rnd(-45, 45), Rnd(8, 20), Rnd(-45, 45)
	EntityType mover(i), 1
	If (i Mod 2) = 0 Then EntityRadius mover(i), 0.6 Else EntityRadius mover(i), 0.6, 1.2
Next
Collisions 1, 2, 2, 2
file = WriteFile(out$)
total = 0
For f = 1 To frames
	For i = 1 To movers
		TranslateEntity mover(i), Rnd(-0.3, 0.3), -0.25, Rnd(-0.3, 0.3)
	Next
	t = MilliSecs()
	UpdateWorld
	total = total + MilliSecs() - t
	For i = 1 To movers
		line$ = f + " " + i + " " + F(EntityX(mover(i))) + " " + F(EntityY(mover(i))) + " " + F(EntityZ(mover(i)))
		c = CountCollisions(mover(i))
		line$ = line$ + " " + c
		If c > 0 Then line$ = line$ + " " + F(CollisionY(mover(i), 1)) + " " + F(CollisionNY(mover(i), 1)) + " " + CollisionTriangle(mover(i), 1)
		WriteLine file, line$
	Next
Next
WriteLine file, "update_ms_total " + total
CloseFile file
End
