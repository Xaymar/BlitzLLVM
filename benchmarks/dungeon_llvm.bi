; BlitzLLVM side of the dungeon benchmark: a microsecond timer and the draw counters of Stats3D.

Global BenchBase:UInt64 = Microseconds()

; Microseconds since the start. Only differences are used, so a wrap after 35 minutes does no harm.
Function BenchMicros()
	Return Int(Microseconds() - BenchBase)
End Function

Function BenchDraws()
	Return Stats3D(1000)
End Function

Function BenchPipelines()
	Return Stats3D(1001)
End Function

Function BenchTextures()
	Return Stats3D(1002)
End Function

Function BenchBuffers()
	Return Stats3D(1003)
End Function

; A sprite fades out near what is behind it (SpriteDepthFade), which only BlitzLLVM can do.
Function BenchDepthFade(sprite, distance#)
	If distance > 0 Then SpriteDepthFade sprite, distance
End Function

Function BenchMaxSprites()
	Return 1000000000
End Function

; Shows the frame. Flip 2 syncs the picture with the display without making the program wait, so the time stays the time of the program.
Function BenchFlip()
	Flip 2
End Function
