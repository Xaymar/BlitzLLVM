; What audio effects cost (BlitzLLVM only): plays a number of looped sounds for a while with one setup of buses, effects, sends or air
; absorption, and does nothing else. benchmarks/audio_effects.py runs every setup in turn and reads the CPU time of the process, which is
; what mixing cost; the setup "none" is what the same sounds cost without effects.
;
; Environment variables:
;   BENCH_SOUND     the .wav file to play
;   BENCH_SETUP     none, bus-filters, bus-echo, bus-reverb, bus-chain, channel-lowpass, channel-chain, sends-reverb, air
;   BENCH_CHANNELS  how many sounds play at the same time (default 32)
;   BENCH_PLAY_MS   how long they play (default 5000)
Include "<audio.bb>"

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

Function Param(effect, param, value#)
	AudioEffectParam effect, param, value
End Function

setup$   = Env$("BENCH_SETUP", "none")
channels = Int(Env$("BENCH_CHANNELS", 32))
playms   = Int(Env$("BENCH_PLAY_MS", 5000))
sound    = Load3DSound(Env$("BENCH_SOUND", "sound.wav"))
If sound = 0 Then RuntimeError "No sound"
LoopSound sound

bus = CreateAudioBus()
SoundBus sound, bus
Select setup$
	Case "bus-filters"
		Param AddAudioEffect(bus, BB_EFFECT_LOWPASS), BB_EFFECTPARAM_FREQUENCY, 4000
		Param AddAudioEffect(bus, BB_EFFECT_PEAK), BB_EFFECTPARAM_GAIN, 3
		Param AddAudioEffect(bus, BB_EFFECT_HIGHSHELF), BB_EFFECTPARAM_GAIN, -3
	Case "bus-echo"
		AddAudioEffect bus, BB_EFFECT_ECHO
	Case "bus-reverb"
		AddAudioEffect bus, BB_EFFECT_REVERB
	Case "bus-chain"
		Param AddAudioEffect(bus, BB_EFFECT_LOWPASS), BB_EFFECTPARAM_FREQUENCY, 4000
		AddAudioEffect bus, BB_EFFECT_COMPRESSOR
		AddAudioEffect bus, BB_EFFECT_ECHO
		AddAudioEffect bus, BB_EFFECT_REVERB
		AddAudioEffect bus, BB_EFFECT_LIMITER
	Case "sends-reverb"
		hall = CreateAudioBus()
		verb = AddAudioEffect(hall, BB_EFFECT_REVERB)
		Param verb, BB_EFFECTPARAM_MIX, 1
	Case "air"
		ListenerAirAbsorption 1
End Select

listener = CreatePivot()
CreateListener listener, 1, 0, 1
For c = 1 To channels
	source = CreatePivot()
	PositionEntity source, Cos(c * 360.0 / channels) * 500, 0, Sin(c * 360.0 / channels) * 500
	ch = EmitSound(sound, source)
	Select setup$
		Case "channel-lowpass"
			Param AddChannelEffect(ch, BB_EFFECT_LOWPASS), BB_EFFECTPARAM_FREQUENCY, 2000
		Case "channel-chain"
			Param AddChannelEffect(ch, BB_EFFECT_LOWPASS), BB_EFFECTPARAM_FREQUENCY, 2000
			Param AddChannelEffect(ch, BB_EFFECT_PEAK), BB_EFFECTPARAM_GAIN, 3
			Param AddChannelEffect(ch, BB_EFFECT_HIGHPASS), BB_EFFECTPARAM_FREQUENCY, 100
		Case "sends-reverb"
			ChannelSend ch, hall, 0.5
	End Select
Next
Delay playms
Print "RESULT setup=" + setup$ + " channels=" + channels + " play_ms=" + playms
