; The insects: a glowing dot each. They circle in the air above the river, the path and the bridge, 3 to 12 units wide. The ones that
; have a light (the first ones) are around the bridge, where the camera goes.
Dim bug(insects)
Dim bugsprite(insects)
Dim bugx#(insects)
Dim bugy#(insects)
Dim bugz#(insects)
Dim bugr#(insects)
Dim bugs#(insects)
Dim bugp#(insects)
Dim bugq#(insects)
For i = 0 To insects - 1
	If i < insectlights Then
		bx# = BenchRnd(BridgeX - 15, BridgeX + 15)
		bz# = BenchRnd(-8, 8)
	Else
		bz = BenchRnd(-60, 60)
		off# = BenchRnd(-10, 10)
		bx = RiverX(bz) + off
	EndIf
	bugx(i) = bx
	bugz(i) = bz
	bugy(i) = FMax(Height(bx, bz), WATERY) + BenchRnd(0.8, 2.6)
	bugr(i) = BenchRnd(0.8, 3.5)
	bugs(i) = BenchRnd(1.0, 3.0)
	bugp(i) = BenchRnd(0, 360)
	bugq(i) = BenchRnd(0, 360)
	bug(i) = CreatePivot()
	bugsprite(i) = CreateSprite(bug(i))
	EntityTexture bugsprite(i), puff
	EntityBlend bugsprite(i), 3
	EntityFX bugsprite(i), 1
	EntityColor bugsprite(i), 190, 255, 90
	ScaleSprite bugsprite(i), 0.3, 0.3
	If i < insectlights Then
		bl = CreateLight(2, bug(i))
		LightColor bl, 80, 150, 40
		LightRange bl, 4.5
	EndIf
	PositionEntity bug(i), bugx(i), bugy(i), bugz(i)
Next

creation# = (BenchMicros() - creationstart) / 1000.0

target = CreatePivot()
Dim near(63)
Dim times#(frames - 1)
drawsum# = 0 : pipesum# = 0 : texsum# = 0 : bufsum# = 0 : trissum# = 0
total# = 0

For f = 0 To warmup + frames - 1
	t0 = BenchMicros()
	g# = f + startframe

	; The walk: from 38 units before the bridge to 22 after it and back, 1200 frames. Walking east it looks ahead along the path, walking west
	; too, and at the ends it looks at the bridge.
	phase# = g * 360.0 / 1200
	cx# = BridgeX - 8 - 30 * Cos(phase)
	cz# = PathZ(cx)
	ahead# = Sin(phase)
	; Walking east is ahead = +1 moving along +x, walking west -1.
	ex# = cx + 10 * Sgn(ahead)
	lookx# = Lerp(BridgeX, ex, Abs(ahead))
	lookz# = Lerp(0, PathZ(ex), Abs(ahead))
	PositionEntity camera, cx, GroundY(cx, cz) + 1.75 + 0.05 * Sin(g * 14), cz
	looky# = GroundY(lookx, lookz) + 1.8
	PositionEntity target, lookx, looky, lookz
	If viewriver = 2 Then
		PositionEntity camera, TorchX - 2.6, TorchY + 3.0, TorchZ - 1.4
		PositionEntity target, TorchX, TorchY + 3.2, TorchZ
	EndIf
	If viewriver = 1 Then
		PositionEntity camera, BridgeX + 0.8, DECKY + 1.6, 0
		PositionEntity target, RiverX(30), 0.2, 30
	EndIf
	PointEntity camera, target

	PositionEntity sky, cx, 0, cz
	PositionEntity moonsprite, cx + MoonX * 90, MoonY * 90, cz + MoonZ * 90
	; The water: move the streaks, glints and patches (each also drawn one picture higher, so that they wrap), then let the second camera look at them and copy
	; what it sees into the texture of the river.
	For i = 0 To WSTREAK + WGLINT + WBLOB - 1
		v# = wv(i) + g * ws(i)
		v = v - Floor(v)
		wx# = 5000 + (wu(i) - 0.5) * 10 + 0.12 * Sin(g * 3 + i * 40)
		wy# = 5 - v * 10
		PositionEntity wsprite(i), wx, wy, 0
		PositionEntity wcopy(i), wx, wy + 10, 0
		If i >= WSTREAK And i < WSTREAK + WGLINT Then
			a# = 0.5 + 0.5 * Sin(g * (4 + (i Mod 5)) + i * 37)
			EntityAlpha wsprite(i), a * a
			EntityAlpha wcopy(i), a * a
		EndIf
	Next
	CameraProjMode camera, 0
	CameraProjMode watercam, 1
	RenderWorld
	CopyRect 0, 0, 256, 256, 0, 0, BackBuffer(), TextureBuffer(watertex)
	CameraProjMode watercam, 0
	CameraProjMode camera, 1
	RunWater g


	; Insects: each circles around its center, bobbing up and down.
	For i = 0 To insects - 1
		bsp# = g * bugs(i)
		PositionEntity bug(i), bugx(i) + Sin(bsp + bugp(i)) * bugr(i), bugy(i) + 0.5 * Sin(bsp * 1.7 + bugq(i)), bugz(i) + Cos(bsp * 0.8 + bugp(i)) * bugr(i)
	Next

	; The wind moves the tip of every blade (the highest vertex; the rest stays) in the areas near the camera: a sway with gusts that travels across the ground.
	For a = 0 To 63
		ax# = (a Mod 8) * 20 - WORLD + 10 - cx
		az# = (a / 8) * 20 - WORLD + 10 - cz
		near(a) = ((ax * ax + az * az) < 2025)
	Next
	For i = 0 To tufts - 1
		If near(tfarea(i)) Then
			gx# = tfx(i)
			gz# = tfz(i)
			amp# = tfh(i) * (0.04 + 0.03 * Sin(g * 1.7 + gx * 2.3)) * Sin(g * 5.5 + gx * 13 + gz * 9)
			gust# = tfh(i) * 0.07 * Sin(g * 2.1 + gx * 4 - gz * 3)
			VertexCoords tfsurf(i), tftip(i), gx + gust + amp, tfy(i), gz + amp * 0.5
		EndIf
	Next

	; The wind moves the leaves and thin branches of the trees: a slow sway with a flutter on top, a little different for each template.
	For tp = 0 To 8
		ph# = tp * 47.0
		For n = TplFirst(tp) To TplFirst(tp) + TplCount(tp) - 1
			sx# = SwX(n)
			sy# = SwY(n)
			sz2# = SwZ(n)
			w# = SwW(n)
			wdx# = w * (0.07 * Sin(g * 2.2 + ph + sx * 25) + 0.03 * Sin(g * 6.1 + sy * 40 + sz2 * 31))
			wdz# = w * (0.05 * Sin(g * 1.9 + ph * 1.3 + sz2 * 27) + 0.03 * Sin(g * 5.3 + sx * 37))
			wdy# = w * 0.02 * Sin(g * 3.1 + ph + sx * 20)
			VertexCoords SwSurf(n), SwIdx(n), sx + wdx, sy + wdy, sz2 + wdz
		Next
	Next

	; The torch flickers.
	fl# = 0.5 + 0.5 * Sin(g * 23) * Sin(g * 9.1 + 40)
	LightRange torchlight, 14 + 3 * fl
	gi = Int(Floor(g))
	EntityTexture flame, flametex, (gi / 2) Mod 8
	EntityTexture flamecore, flametex, (gi / 2 + 4) Mod 8
	ScaleSprite flame, 0.45 + 0.1 * fl, 0.75 + 0.2 * fl
	ScaleSprite flamecore, 0.32 + 0.06 * fl, 0.55 + 0.12 * fl
	For k = 0 To 5
		life# = (g * 0.02 + k * 0.1667)
		life = life - Floor(life)
		ang# = k * 61 + g * 2
		PositionEntity ember(k), TorchX + Sin(ang) * (0.1 + 0.25 * life), TorchY + 3.1 + life * 2.2, TorchZ + Cos(ang) * (0.1 + 0.25 * life)
		es# = 0.05 * (1 - life) + 0.01
		ScaleSprite ember(k), es, es
		EntityAlpha ember(k), 1 - life
	Next
	updated# = BenchMicros() - t0

	RenderWorld
	scenetris = TrisRendered()
	If bloom Then
		CopyRect 0, 0, scrw, scrh, 0, 0, BackBuffer(), TextureBuffer(screentex)
		CameraProjMode camera, 0
		PositionEntity bloomcam, 6000, 0, -1
		BloomRender bloomcam, bw * 2, bh * 2, atex
		PositionEntity bloomcam, 6100, 0, -1
		BloomRender bloomcam, bw, bh, btex
		For pass = 0 To 1
			PositionEntity bloomcam, 6200, 0, -1
			BloomRender bloomcam, bw, bh, btex
			PositionEntity bloomcam, 6300, 0, -1
			BloomRender bloomcam, bw, bh, btex
		Next
		BloomRender ovcam, scrw, scrh, 0
		CameraProjMode camera, 1
	EndIf
	Flip 0
	elapsed# = BenchMicros() - t0
	If f >= warmup Then
		n = f - warmup
		times(n) = elapsed
		total = total + elapsed
		drawsum = drawsum + BenchDraws()
		pipesum = pipesum + BenchPipelines()
		texsum = texsum + BenchTextures()
		bufsum = bufsum + BenchBuffers()
		trissum = trissum + scenetris
	EndIf
Next

shot$ = GetEnv$("BENCH_SHOT")
If shot$ <> "" Then SaveBuffer BackBuffer(), shot$

; Sorting the times gives the median and the 95th percentile.
Dim srt#(frames - 1)
For i = 0 To frames - 1
	srt(i) = times(i)
Next
gap = frames / 2
While gap > 0
	For i = gap To frames - 1
		v# = srt(i)
		j = i
		; And does not skip the second test, so the index is checked first.
		While j >= gap
			If srt(j - gap) <= v Then Exit
			srt(j) = srt(j - gap)
			j = j - gap
		Wend
		srt(j) = v
	Next
	gap = gap / 2
Wend
p95 = Int(frames * 0.95) : If p95 > frames - 1 Then p95 = frames - 1

timesfile$ = GetEnv$("BENCH_FRAMETIMES")
If timesfile$ <> "" Then
	file = WriteFile(timesfile$)
	If file <> 0 Then
		For i = 0 To frames - 1
			WriteLine file, Int(times(i))
		Next
		CloseFile file
	EndIf
EndIf

avg# = total / frames / 1000
result$ = "RESULT trees=" + trees + " tufts=" + tufts + " pebbles=" + pebbles + " insects=" + insects + " frames=" + frames + " seed=" + seed + " width=" + GraphicsWidth() + " height=" + GraphicsHeight() + " create_ms=" + creation + " ms_avg=" + avg + " ms_min=" + (srt(0) / 1000) + " ms_median=" + (srt(frames / 2) / 1000) + " ms_p95=" + (srt(p95) / 1000) + " ms_max=" + (srt(frames - 1) / 1000) + " fps=" + (1000 / avg) + " tris=" + Int(trissum / frames) + " draws=" + Int(drawsum / frames) + " pipelines=" + Int(pipesum / frames) + " textures=" + Int(texsum / frames) + " buffers=" + Int(bufsum / frames)
DebugLog result$
resultfile$ = GetEnv$("BENCH_RESULT")
If resultfile$ <> "" Then
	file = WriteFile(resultfile$)
	If file <> 0 Then
		WriteLine file, result$
		CloseFile file
	EndIf
EndIf
End
