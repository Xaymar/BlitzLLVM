; Grass and pebbles are merged by area, so that every area is one mesh with all its blades (a new surface when one has 65000 vertices). There is more grass near the river and none on the path or in the water.
Dim grassmesh(63)
Dim grasssurf(63)
Dim tfx#(grasscount)
Dim tfy#(grasscount)
Dim tfz#(grasscount)
Dim tfh#(grasscount)
Dim tfarea(grasscount)
Dim tftip(grasscount)
Dim tfsurf(grasscount)
Dim stonemesh(63)
Dim stonesurf(63)

placed = 0
tries = 0
While placed < grasscount And tries < grasscount * 3
	tries = tries + 1
	; Grass grows where the camera walks and sees it: from 50 units before the bridge to 35 after it, 45 to each side.
	x = BenchRnd(BridgeX - 50, BridgeX + 35)
	z = BenchRnd(-45, 45)
	d = Abs(x - RiverX(z))
	dp = Abs(z - PathZ(x))
	keep# = BenchRnd(0, 1)
	; none at the water, thin on the banks, full at 20 units from the river.
	chance# = 0.55 * Smooth((d - 5.5) / 14.5)
	If d > 5.5 And dp > 2.0 And keep < chance Then
		area = AreaOf(x, z)
		If grassmesh(area) = 0 Then
			grassmesh(area) = CreateMesh()
			grasssurf(area) = CreateSurface(grassmesh(area))
		EndIf
		; A clump of 3 to 6 blades around the place, the first one the tallest. Sizes go from short blades to tall ones, most are short.
		clump = 5 + Int(Floor(BenchRnd(0, 5.99)))
		For j = 1 To clump
			If CountVertices(grasssurf(area)) > 64990 Then grasssurf(area) = CreateSurface(grassmesh(area))
			If placed < grasscount Then
				bx# = x
				bz# = z
				If j > 1 Then
					bx = x + BenchRnd(-0.3, 0.3)
					bz = z + BenchRnd(-0.3, 0.3)
				EndIf
				sz# = BenchRnd(0, 1)
				gh# = 0.08 + sz * sz * sz * 0.65
				If j = 1 Then gh = gh * 1.4
				gw# = 0.012 + 0.02 * gh
				rot# = BenchRnd(0, 180)
				lean# = BenchRnd(0.1, 0.5)
				ldir# = BenchRnd(0, 360)
				tint# = BenchRnd(0.75, 1.2)
				gy# = Height(bx, bz) - 0.03
				tftip(placed) = AddBlade(grasssurf(area), bx, gy, bz, gw, gh, rot, lean, ldir, tint)
				tfx(placed) = bx + Cos(ldir) * lean * gh
				tfy(placed) = gy + gh
				tfz(placed) = bz + Sin(ldir) * lean * gh
				tfh(placed) = gh : tfarea(placed) = area : tfsurf(placed) = grasssurf(area)
				placed = placed + 1
			EndIf
		Next
	EndIf
Wend
tufts = placed

placed = 0
tries = 0
While placed < pebblecount And tries < pebblecount * 6
	tries = tries + 1
	; On the banks and in the bed (a place near the river is picked first), thickest at the edge of the water and none on the path.
	z = BenchRnd(-WORLD + 1, WORLD - 1)
	off# = BenchRnd(-9, 9)
	x = RiverX(z) + off
	d = Abs(x - RiverX(z))
	dp = Abs(z - PathZ(x))
	keep = BenchRnd(0, 1)
	chance = 1 - Smooth((d - 3.4) / 3.8)
	If dp < 2.3 Then chance = 0
	If keep < chance Then
		area = AreaOf(x, z)
		If stonemesh(area) = 0 Then
			stonemesh(area) = CreateMesh()
			stonesurf(area) = CreateSurface(stonemesh(area))
		EndIf
		If CountVertices(stonesurf(area)) < 65000 Then
			size = BenchRnd(0, 1)
			rad# = 0.07 + size * size * 0.1
			If size > 0.93 Then rad = 0.18 + (size - 0.93) * 5
			tone# = BenchRnd(30, 85)
			rot = BenchRnd(0, 72)
			tinted# = BenchRnd(0, 1)
			tint = 0
			If tinted > 0.88 Then tint = 1
			If tinted > 0.94 Then tint = 2
			AddPebble stonesurf(area), x, Height(x, z), z, rad, Int(tone), rot, tint
			placed = placed + 1
		EndIf
	EndIf
Wend
pebbles = placed

