sunaim = CreatePivot()
PointEntity moon, sunaim

creationstart = BenchMicros()

; The torch stands at the near end of the bridge, beside the path (its place is needed for the bump maps).
TorchX = BridgeX - 7.4
TorchZ = 1.9
TorchY = GroundY(TorchX, TorchZ)
torchx# = TorchX
torchz# = TorchZ
torchy# = TorchY

; The bump maps and the pictures that go with them.
NormalGround = MakeNormalMap(0)
NormalBark = MakeNormalMap(1)
NormalPlanks = MakeNormalMap(2)
AlbedoBark = MakeAlbedo(0)
AlbedoBirch = MakeAlbedo(1)
AlbedoChar = MakeAlbedo(3)
AlbedoTorch = MakeAlbedo(4)
AlbedoPlanks = MakeAlbedo(2)

terrain = MakeTerrain()
; Fullbright and vertex colors, because the colors of the vertices are the light.
EntityFX terrain, 1 + 2
EntityTexture terrain, NormalGround, 0, 0
EntityTexture terrain, MakeGroundPicture(), 0, 1
water = MakeWater()
watersurf = GetSurface(water, 1)
EntityColor water, 255, 255, 255
EntityAlpha water, 0.8
EntityShininess water, 0.6
bridge = MakeBridge()

; The torch: a post of bark that leans a little, wider at the foot, with a head of wrapped, charred wood that widens upwards and is tied with three bands, and
; a cap where the flame comes out. Made as bump-mapped tubes like the branches of the trees.
pole = CreateMesh()
s = CreateSurface(pole)
AddBranch s, torchx, torchy - 0.1, torchz, torchx + 0.05, torchy + 0.35, torchz + 0.02, 0.19, 0.11, 8
AddBranch s, torchx + 0.05, torchy + 0.35, torchz + 0.02, torchx + 0.09, torchy + 2.45, torchz + 0.04, 0.11, 0.08, 8
EntityFX pole, 1 + 2
EntityTexture pole, NormalBark, 0, 0
EntityTexture pole, AlbedoTorch, 0, 1
