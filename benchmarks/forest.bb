CameraProjMode watercam, 0
CameraProjMode camera, 1

; Fullscreen bloom with render targets only (no shaders): the picture of the world is copied into a texture, then raised to the fourth power (bright parts stay, dark parts vanish) while
; being shrunk to half and then a quarter of its size, blurred there with seven added, shifted copies of itself (first sideways, then up and down, twice), and
; finally added on top of the picture. All of it is drawn by cameras that look at flat squares far away from the world, like the water. BENCH_BLOOM=0 turns it off,
; BENCH_BLOOM_GAIN is how many times the blur is added (default 1).
bloom = Int(Env$("BENCH_BLOOM", 1))
bloomgain = Int(Env$("BENCH_BLOOM_GAIN", 1))
If bloom Then
	scrw = GraphicsWidth()
	scrh = GraphicsHeight()
	tw = Pow2(scrw)
	th = Pow2(scrh)
	bw = Pow2((scrw + 3) / 4)
	bh = Pow2((scrh + 3) / 4)
	screentex = CreateTexture(tw, th, 1 + 256 + 4096)
	atex = CreateTexture(bw * 2, bh * 2, 1 + 256 + 4096)
	btex = CreateTexture(bw, bh, 1 + 256 + 4096)
	bloomcam = CreateCamera()
	CameraClsColor bloomcam, 0, 0, 0
	CameraRange bloomcam, 0.1, 5
	CameraProjMode bloomcam, 0
	ovcam = CreateCamera()
	CameraClsColor ovcam, 0, 0, 0
	CameraRange ovcam, 0.1, 5
	CameraProjMode ovcam, 0

	; Step 1 (at x = 6000): the picture, and the same picture multiplied onto itself three times, in a texture of half the size of the blur's.
	qscreen = MakeQuadUV(Float(scrw) / tw, Float(scrh) / th)
	EntityTexture qscreen, screentex
	PositionEntity qscreen, 6000, 0, 0
	ScaleEntity qscreen, 1, Float(bh) / bw, 1
	For i = 1 To 3
		qsquare = CopyEntity(qscreen)
		EntityBlend qsquare, 2
		PositionEntity qsquare, 6000, 0, -0.001 * i
	Next

	; Step 2 (x = 6100): half to quarter size.
	qdown = MakeQuadUV(1, 1)
	EntityTexture qdown, atex
	PositionEntity qdown, 6100, 0, 0
	ScaleEntity qdown, 1, Float(bh) / bw, 1

	; Steps 3 and 4 (x = 6200 and 6300): seven taps of a gauss curve, sideways and up and down. A texel is 2 / bw wide on the square.
	wt# = 0
	Dim tapw#(6)
	tapw(0) = 0.0702 : tapw(1) = 0.1311 : tapw(2) = 0.1907 : tapw(3) = 0.2161 : tapw(4) = 0.1907 : tapw(5) = 0.1311 : tapw(6) = 0.0702
	Dim taph(6)
	Dim tapv(6)
	texel# = 2.0 / bw
	For i = 0 To 6
		For k = 0 To 1
			q = MakeQuadUV(1, 1)
			EntityTexture q, btex
			EntityBlend q, 3
			c = Int(tapw(i) * 255)
			EntityColor q, c, c, c
			ScaleEntity q, 1, Float(bh) / bw, 1
			If k = 0 Then
				PositionEntity q, 6200 + (i - 3) * 1.5 * texel, 0, -0.001 * i
				taph(i) = q
			Else
				PositionEntity q, 6300, (i - 3) * 1.5 * texel, -0.001 * i
				tapv(i) = q
			EndIf
		Next
	Next

	; The last step (x = 6400): the picture opaque, with the blur added on top of it as often as the gain says.
	qover = MakeQuadUV(Float(scrw) / tw, Float(scrh) / th)
	EntityTexture qover, screentex
	PositionEntity qover, 6400, 0, 0
	ScaleEntity qover, 1, Float(scrh) / scrw, 1
	Dim qglow(9)
	If bloomgain > 10 Then bloomgain = 10
	For i = 0 To bloomgain - 1
		qglow(i) = MakeQuadUV(1, 1)
		EntityTexture qglow(i), btex
		EntityBlend qglow(i), 3
		PositionEntity qglow(i), 6400, 0, -0.001 * (i + 1)
		ScaleEntity qglow(i), 1, Float(scrh) / scrw, 1
	Next
	PositionEntity bloomcam, 6000, 0, -1
	PositionEntity ovcam, 6400, 0, -1
EndIf
Const WSTREAK = 70
Const WGLINT = 60
Const WBLOB = 12
Dim wsprite(WSTREAK + WGLINT + WBLOB - 1)
Dim wcopy(WSTREAK + WGLINT + WBLOB - 1)
Dim wu#(WSTREAK + WGLINT + WBLOB - 1)
Dim wv#(WSTREAK + WGLINT + WBLOB - 1)
Dim ws#(WSTREAK + WGLINT + WBLOB - 1)
For i = 0 To WSTREAK + WGLINT + WBLOB - 1
	wsprite(i) = CreateSprite()
	wcopy(i) = CreateSprite()
	For k = 0 To 1
		If k = 0 Then sp = wsprite(i) Else sp = wcopy(i)
		If i >= WSTREAK And i < WSTREAK + WGLINT Then EntityTexture sp, puff Else EntityTexture sp, crest
		EntityBlend sp, 3
		EntityFX sp, 1
		If i < WSTREAK Then
			EntityColor sp, 70, 130, 150
		ElseIf i < WSTREAK + WGLINT Then
			EntityColor sp, 190, 225, 240
		Else
			EntityColor sp, 22, 56, 70
		EndIf
	Next
	wu(i) = BenchRnd(0, 1)
	wv(i) = BenchRnd(0, 1)
	If i < WSTREAK Then
		ws(i) = BenchRnd(0.0012, 0.0032)
		sx# = BenchRnd(0.45, 1.3)
		sy# = sx * BenchRnd(0.18, 0.3)
	ElseIf i < WSTREAK + WGLINT Then
		ws(i) = BenchRnd(0.0012, 0.0032)
		sx = BenchRnd(0.04, 0.09)
		sy = sx * BenchRnd(1.0, 2.2)
	Else
		ws(i) = BenchRnd(0.0004, 0.0009)
		sx = BenchRnd(2.0, 4.0)
		sy = sx * BenchRnd(0.2, 0.3)
	EndIf
	ScaleSprite wsprite(i), sx, sy
	ScaleSprite wcopy(i), sx, sy
Next


