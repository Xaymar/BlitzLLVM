; The original Blitz3D side of the benchmarks: the same functions as bench_llvm.bi, with what the original has. The runners copy it
; next to the benchmark as bench_compiler.bi.

Function BenchCompiler$()
	Return "original"
End Function

; The original has only a millisecond timer.
Function BenchMicros()
	Return MilliSecs() * 1000
End Function

; The original has no draw counters.
Function BenchDraws()
	Return 0
End Function

Function BenchPipelines()
	Return 0
End Function

Function BenchTextures()
	Return 0
End Function

Function BenchBuffers()
	Return 0
End Function

Function BenchFlip()
	Flip 0
End Function
