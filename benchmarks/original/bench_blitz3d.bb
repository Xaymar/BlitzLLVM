; Baseline benchmark for 3D: flies a camera through fields of meshes and sprites at fixed sizes and logs how long the frames
; take. It mirrors benchmarks/flythrough.bb (same 16 kinds of entities, same density, same camera path) and uses only commands
; of the original Blitz3D, so it runs unchanged in the original compiler and in BlitzLLVM, and the numbers can be put next to each
; other. See README.adoc.
;
; Open it in the original Blitz3D IDE and run it (a release build, not debug), or build it with blitzcc. Set LABEL below to
; describe the machine, then wait: it writes bench_blitz3d_log.txt next to the program (the current directory) when it is done.
; Escape stops it early, the log then has what was finished.
;
; Three scenes are run at every size:
;   mixed    all 16 kinds (the fly-through)
;   meshes   kinds 0-11, only meshes: cube, sphere, cone, cylinder and an octahedron, lit, textured, flat, vertex colored, alpha, additive, two sided
;   sprites  kinds 12-15, only sprites: textured, alpha, additive and a flat color with a fixed rotation
; The positions come from a generator defined here (not from Rnd) and the camera moves one step per frame, so every run
; sees the same frames.

Const LABEL$ = "unnamed"	; Describe the machine, the GPU and the compiler, for example "RTX 4080 SUPER, Blitz3D 1.107".
Const LOGNAME$ = "bench_blitz3d_log.txt"
Const WIDTH% = 640			; Size of the window, as in benchmarks/flythrough.bb.
Const HEIGHT% = 360
Const GFXMODE% = 2			; Always a window (2). Never run this full screen: the original changes the display settings of the system.
Const WARMUP% = 5			; Frames that are drawn but not counted.
Const SCALES% = 3			; How many of the sizes below are run (1 to 3). A computer that struggles can use 2.
Const PAUSE_AT_END% = 1		; Wait for a key at the end, so that the window does not close.
Const MAXOBJECTS% = 100000	; The largest size below.
Const KINDS% = 16
Const RANGE# = 300			; How far the camera sees.

Global rng%
Global logfile%

Dim scaleobjects%(2)	; How many entities each size has,
Dim scaleframes%(2)		; and how many frames are timed at that size.
scaleobjects(0) = 2000 : scaleframes(0) = 300
scaleobjects(1) = 20000 : scaleframes(1) = 300
scaleobjects(2) = 100000 : scaleframes(2) = 100

Dim ents%(MAXOBJECTS - 1)
Dim times%(299)
Dim textures%(3)
Dim templates%(KINDS - 1)

; Writes a line to the log.
Function LogLine(l$)
	If logfile <> 0 Then WriteLine logfile, l
End Function

; A linear congruential generator that gives the same numbers in every Blitz: 0 up to (but not including) 1.
Function Rnd01#()
	rng = (rng * 1103515245 + 12345) And $7FFFFFFF
	Return (rng Shr 8) / 8388608.0
End Function

Function RndRange#(lo#, hi#)
	Return lo + Rnd01() * (hi - lo)
End Function

; An octahedron whose corners have different colors, which is what vertex colored geometry looks like.
Function MakeGem()
	Local m%, s%
	m = CreateMesh()
	s = CreateSurface(m)
	AddVertex s, 1, 0, 0 : VertexColor s, 0, 255, 60, 60
	AddVertex s, -1, 0, 0 : VertexColor s, 1, 60, 255, 60
	AddVertex s, 0, 1, 0 : VertexColor s, 2, 60, 60, 255
	AddVertex s, 0, -1, 0 : VertexColor s, 3, 255, 255, 60
	AddVertex s, 0, 0, 1 : VertexColor s, 4, 60, 255, 255
	AddVertex s, 0, 0, -1 : VertexColor s, 5, 255, 60, 255
	AddTriangle s, 0, 2, 4 : AddTriangle s, 4, 2, 1 : AddTriangle s, 1, 2, 5 : AddTriangle s, 5, 2, 0
	AddTriangle s, 4, 3, 0 : AddTriangle s, 1, 3, 4 : AddTriangle s, 5, 3, 1 : AddTriangle s, 0, 3, 5
	UpdateNormals m
	Return m
End Function

; The camera path: a loop through the field, one step per frame whatever the speed of the computer is. 1500 frames are one lap.
Function CameraStep(camera%, frame%, side#)
	Local a#, r#
	a = frame * 360.0 / 1500
	r = side * 0.3
	PositionEntity camera, Cos(a) * r, Sin(a * 2) * r * 0.4, Sin(a) * r
	; Looks along the path, with some nodding.
	RotateEntity camera, Sin(a * 3) * 10, -a - 90, 0
End Function

Function MakeTemplates()
	Local t%, k%
	For t = 0 To 3
		textures(t) = CreateTexture(32, 32)
		SetBuffer TextureBuffer(textures(t))
		Color 30 + t * 60, 220 - t * 50, 90 + t * 30
		Rect 0, 0, 32, 32
		Color 255, 255, 255
		Rect 0, 0, 16, 16
		Rect 16, 16, 16, 16
		SetBuffer BackBuffer()
	Next
	templates(0) = CreateCube()
	EntityColor templates(0), 220, 120, 40
	templates(1) = CreateCube()
	EntityTexture templates(1), textures(0)
	templates(2) = CreateSphere(8)
	EntityColor templates(2), 90, 170, 230
	templates(3) = CreateSphere(8)
	EntityColor templates(3), 120, 220, 120
	EntityFX templates(3), 4
	templates(4) = CreateCone(12)
	EntityTexture templates(4), textures(1)
	templates(5) = CreateCylinder(12)
	EntityColor templates(5), 200, 200, 90
	templates(6) = MakeGem()
	EntityFX templates(6), 2
	templates(7) = CreateSphere(8)
	EntityTexture templates(7), textures(2)
	EntityFX templates(7), 1
	templates(8) = CreateCube()
	EntityColor templates(8), 240, 80, 120
	EntityAlpha templates(8), 0.5
	templates(9) = CreateSphere(8)
	EntityColor templates(9), 255, 200, 80
	EntityBlend templates(9), 3
	templates(10) = CreateCube()
	EntityTexture templates(10), textures(3)
	EntityFX templates(10), 16
	; The model of the fly-through is a cube here, so that no file is needed.
	templates(11) = CreateCube()
	ScaleMesh templates(11), 0.7, 0.7, 0.7
	templates(12) = CreateSprite()
	EntityTexture templates(12), textures(0)
	templates(13) = CreateSprite()
	EntityTexture templates(13), textures(1)
	EntityAlpha templates(13), 0.5
	templates(14) = CreateSprite()
	EntityTexture templates(14), textures(2)
	EntityBlend templates(14), 3
	templates(15) = CreateSprite()
	EntityColor templates(15), 250, 250, 250
	SpriteViewMode templates(15), 2
	For k = 0 To KINDS - 1
		HideEntity templates(k)
	Next
End Function

; Sorts the first n of times with a shell sort.
Function SortTimes(n%)
	Local gap%, i%, j%, v%
	gap = n / 2
	While gap > 0
		For i = gap To n - 1
			v = times(i)
			j = i
			; And does not skip the second test, so the index is checked first.
			While j >= gap
				If times(j - gap) <= v Then Exit
				times(j) = times(j - gap)
				j = j - gap
			Wend
			times(j) = v
		Next
		gap = gap / 2
	Wend
End Function

; Makes the field, flies through it, logs the result and frees the field. Returns 0 when the user pressed Escape.
Function RunScene%(scene$, firstkind%, kindcount%, objects%, frames%, camera%)
	Local i%, e%, f%, size#, side#, t0%, t1%, tc0%, total%, trissum%, aborted%, p95%
	Local avg#, fps#, creation%

	AppTitle "Blitz3D benchmark: " + scene + " " + objects
	rng = 1
	; The field is a box with the same density whatever the count: about 3 units per entity along each side. The camera
	; flies through the middle of it, so about the same number of entities are around it at every count.
	side = Float(objects) ^ (1.0 / 3.0) * 3
	tc0 = MilliSecs()
	For i = 0 To objects - 1
		e = CopyEntity(templates(firstkind + (i Mod kindcount)))
		ShowEntity e
		PositionEntity e, RndRange(-side / 2, side / 2), RndRange(-side / 2, side / 2), RndRange(-side / 2, side / 2)
		size = RndRange(0.6, 1.4)
		ScaleEntity e, size, size, size
		If (firstkind + (i Mod kindcount)) < 12 Then RotateEntity e, RndRange(0, 360), RndRange(0, 360), RndRange(0, 360)
		ents(i) = e
	Next
	creation = MilliSecs() - tc0
	tc0 = MilliSecs()

	aborted = 0
	trissum = 0
	For f = 0 To WARMUP + frames - 1
		CameraStep camera, f, side
		t0 = MilliSecs()
		RenderWorld
		Flip False
		t1 = MilliSecs()
		If f >= WARMUP Then
			times(f - WARMUP) = t1 - t0
			trissum = trissum + TrisRendered()
		Else
			; The timed part starts when the last warmup frame ends.
			tc0 = t1
		EndIf
		If KeyHit(1) Then aborted = 1 : Exit
	Next
	total = MilliSecs() - tc0

	If aborted = 0 Then
		SortTimes frames
		avg = Float(total) / Float(frames)
		fps = 0
		If avg > 0 Then fps = 1000.0 / avg
		p95 = Int(frames * 0.95) : If p95 > frames - 1 Then p95 = frames - 1
		; ms_avg is the time of the whole timed part divided by the frames. The single frames are only as exact as MilliSecs,
		; so the min, median, p95 and max are whole milliseconds on a computer where a frame takes just a few.
		LogLine "RESULT bench=blitz3d scene=" + scene + " objects=" + objects + " frames=" + frames + " width=" + GraphicsWidth() + " height=" + GraphicsHeight() + " create_ms=" + creation + " ms_avg=" + avg + " ms_min=" + times(0) + " ms_median=" + times(frames / 2) + " ms_p95=" + times(p95) + " ms_max=" + times(frames - 1) + " fps=" + fps + " tris=" + (trissum / frames)
	EndIf

	For i = 0 To objects - 1
		FreeEntity ents(i)
	Next
	Return 1 - aborted
End Function

; ---------------------------------------------------------------------------------------------------------------------------

Graphics3D WIDTH, HEIGHT, 32, GFXMODE
SetBuffer BackBuffer()

logfile = WriteFile(LOGNAME)
LogLine "# bench=blitz3d version=1"
LogLine "# date=" + CurrentDate$() + " time=" + CurrentTime$()
LogLine "# label=" + LABEL
LogLine "# gfx_driver=" + GfxDriverName$(1)
LogLine "# vidmem_total=" + TotalVidMem() + " vidmem_free=" + AvailVidMem()
LogLine "# width=" + WIDTH + " height=" + HEIGHT + " gfxmode=" + GFXMODE + " warmup=" + WARMUP + " scales=" + SCALES
LogLine "# note=ms_avg is the whole timed part divided by the frames, the other ms_* are single frames in whole milliseconds; a frame is RenderWorld and Flip False; tris is TrisRendered per frame"

camera = CreateCamera()
CameraClsColor camera, 8, 10, 24
CameraRange camera, 0.1, RANGE
light = CreateLight()
RotateEntity light, 45, 30, 0
AmbientLight 60, 60, 60
MakeTemplates

startms% = MilliSecs()
ok% = 1
For s% = 0 To SCALES - 1
	If ok Then ok = RunScene("mixed", 0, 16, scaleobjects(s), scaleframes(s), camera)
	If ok Then ok = RunScene("meshes", 0, 12, scaleobjects(s), scaleframes(s), camera)
	If ok Then ok = RunScene("sprites", 12, 4, scaleobjects(s), scaleframes(s), camera)
Next
If ok = 0 Then LogLine "# aborted=1"
LogLine "SUMMARY bench=blitz3d total_ms=" + (MilliSecs() - startms)
LogLine "# done"
CloseFile logfile

If PAUSE_AT_END Then
	Cls
	Text 10, 10, "Finished. The log is " + LOGNAME
	Text 10, 30, "Press any key to exit."
	Flip
	FlushKeys
	WaitKey
EndIf
End
