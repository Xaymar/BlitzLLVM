; Baseline benchmark for the language itself: loops, arithmetic, arrays, sorting, strings, types, banks and function calls.
; It uses only commands of the original BlitzBasic / Blitz3D, so it runs unchanged in the original compiler and in BlitzLLVM,
; and the numbers can be put next to each other. No graphics are used. See README.adoc.
;
; Open it in the original Blitz IDE and run it (a release build, not debug, or the numbers are meaningless), or build it with
; blitzcc. Set LABEL below to describe the machine, then wait: it prints the progress and writes bench_blitzbasic_log.txt next to
; the program (the current directory) when it is done.
;
; Every workload does the same work on every run: the random numbers come from a generator defined here (not from Rnd), and
; the result of each workload (check) is the same in every Blitz that does the integer math the same way.

Const LABEL$ = "unnamed"	; Describe the machine and the compiler, for example "Ryzen 7 9800X3D, Blitz3D 1.107".
Const RUNS% = 3				; How often every workload is timed. The log has the fastest, the median and the average.
Const LOGNAME$ = "bench_blitzbasic_log.txt"
Const PAUSE_AT_END% = 1		; Wait for a key at the end, so that the window does not close.
Const WORKLOADS% = 13

Type Node
	Field x%
	Field y%
	Field f#
End Type

Global logfile%
Global rng%

; Memory for the array workloads is made once, Dim can not be repeated.
Dim sieve%(2000000)
Dim sortdata%(299999)
Dim grid%(1023, 1023)
Dim ma#(99, 99)
Dim mb#(99, 99)
Dim mc#(99, 99)
Dim times%(RUNS)

If LABEL = "" Then RuntimeError "LABEL must not be empty"

logfile = WriteFile(LOGNAME)
LogLine "# bench=blitzbasic version=1"
LogLine "# date=" + CurrentDate$() + " time=" + CurrentTime$()
LogLine "# label=" + LABEL
LogLine "# runs=" + RUNS
LogLine "# note=ms_* are milliseconds of one workload, mops_per_s is millions of operations per second at ms_min, check must be the same in every Blitz (float workloads may differ in the last digits)"

totalstart% = MilliSecs()
For id% = 1 To WORKLOADS
	RunWorkload id
Next
LogLine "SUMMARY bench=blitzbasic workloads=" + WORKLOADS + " total_ms=" + (MilliSecs() - totalstart)
LogLine "# done"
CloseFile logfile
Print "Log written to " + LOGNAME
If PAUSE_AT_END Then
	Print "Press any key to exit."
	WaitKey
EndIf
End

Function LogLine(l$)
	Print l
	If logfile <> 0 Then WriteLine logfile, l
End Function

; ---------------------------------------------------------------------------------------------------------------------------
; Harness

Function RunWorkload(id%)
	Local r%, t0%, dt%, c%, firstcheck%, ok%, i%, j%, v%, sum%
	Local total#, med%, best%
	ok = 1
	For r = 1 To RUNS
		t0 = MilliSecs()
		c = Work(id)
		dt = MilliSecs() - t0
		times(r) = dt
		If r = 1 Then firstcheck = c
		If c <> firstcheck Then ok = 0
	Next
	; The times are sorted to find the median (insertion sort, RUNS is tiny).
	sum = 0
	For i = 1 To RUNS
		sum = sum + times(i)
	Next
	For i = 2 To RUNS
		v = times(i)
		j = i - 1
		While j >= 1
			If times(j) <= v Then Exit
			times(j + 1) = times(j)
			j = j - 1
		Wend
		times(j + 1) = v
	Next
	best = times(1)
	med = times((RUNS + 1) / 2)
	Local mops#
	mops = 0
	If best > 0 Then mops = Float(WorkOps(id)) / Float(best) / 1000.0
	LogLine "RESULT bench=blitzbasic name=" + WorkName(id) + " ops=" + WorkOps(id) + " runs=" + RUNS + " ms_min=" + best + " ms_median=" + med + " ms_avg=" + (Float(sum) / Float(RUNS)) + " mops_per_s=" + mops + " check=" + firstcheck + " ok=" + ok
End Function

Function WorkName$(id%)
	Select id
		Case 1 : Return "int_loop"
		Case 2 : Return "float_loop"
		Case 3 : Return "branches"
		Case 4 : Return "sieve"
		Case 5 : Return "array2d"
		Case 6 : Return "matmul"
		Case 7 : Return "sort"
		Case 8 : Return "str_concat"
		Case 9 : Return "str_ops"
		Case 10 : Return "types"
		Case 11 : Return "banks"
		Case 12 : Return "calls"
		Case 13 : Return "recursion"
	End Select
	Return "?"
End Function

; How many basic operations (loop iterations, array elements, calls) a workload does, for the rate in the log.
Function WorkOps%(id%)
	Select id
		Case 1 : Return 100000000
		Case 2 : Return 10000000
		Case 3 : Return 50000000
		Case 4 : Return 2000000
		Case 5 : Return 6291456
		Case 6 : Return 20000000
		Case 7 : Return 300000
		Case 8 : Return 30000
		Case 9 : Return 200000
		Case 10 : Return 200000
		Case 11 : Return 4194304
		Case 12 : Return 25000000
		Case 13 : Return 18454929
	End Select
	Return 0
End Function

Function Work%(id%)
	rng = 1
	Select id
		Case 1 : Return WorkIntLoop()
		Case 2 : Return WorkFloatLoop()
		Case 3 : Return WorkBranches()
		Case 4 : Return WorkSieve()
		Case 5 : Return WorkArray2D()
		Case 6 : Return WorkMatMul()
		Case 7 : Return WorkSort()
		Case 8 : Return WorkStrConcat()
		Case 9 : Return WorkStrOps()
		Case 10 : Return WorkTypes()
		Case 11 : Return WorkBanks()
		Case 12 : Return WorkCalls()
		Case 13 : Return Fib(34)
	End Select
	Return 0
End Function

; A linear congruential generator that gives the same numbers in every Blitz, 0 to 2^31-1.
Function Rand31%()
	rng = (rng * 1103515245 + 12345) And $7FFFFFFF
	Return rng
End Function

; ---------------------------------------------------------------------------------------------------------------------------
; Workloads

; Integer arithmetic, bit operations and Mod in a tight loop.
Function WorkIntLoop%()
	Local i%, a%, b%, c%
	a = 12345 : b = 6789 : c = 0
	For i = 1 To 100000000
		a = (a * 31 + i) And $FFFFF
		b = ((b Xor a) + (i Shr 3)) And $FFFFFF
		c = c + (a Mod 7) - (b Mod 5)
	Next
	Return a + b + c
End Function

; Float arithmetic with Sin, Cos and Sqr.
Function WorkFloatLoop%()
	Local i%, x#, y#
	x = 0 : y = 0
	For i = 1 To 10000000
		x = x + Sin(i Mod 360) * Cos((i * 7) Mod 360)
		y = y + Sqr(i) * 0.001
	Next
	Return Int(x + y)
End Function

; If, ElseIf and Select/Case chains.
Function WorkBranches%()
	Local i%, v%, c%
	c = 0
	For i = 1 To 50000000
		v = (i * 7) Mod 10
		Select v
			Case 0 : c = c + 1
			Case 1 : c = c + 2
			Case 2 : c = c - 1
			Case 3 : c = c + 3
			Case 4 : c = c - 2
			Default : c = c + 1
		End Select
		If v < 3 Then
			c = c + 1
		ElseIf v < 6 Then
			c = c - 1
		ElseIf v < 8 Then
			c = c + 2
		Else
			c = c - 2
		EndIf
	Next
	Return c
End Function

; Sieve of Eratosthenes up to 2 million: 148933 primes.
Function WorkSieve%()
	Local i%, j%, count%
	For i = 0 To 2000000
		sieve(i) = 1
	Next
	sieve(0) = 0 : sieve(1) = 0
	For i = 2 To 1414
		If sieve(i) = 1 Then
			For j = i * i To 2000000 Step i
				sieve(j) = 0
			Next
		EndIf
	Next
	count = 0
	For i = 0 To 2000000
		count = count + sieve(i)
	Next
	Return count
End Function

; A 1024 x 1024 array, written and summed row by row and column by column (the second is the cache unfriendly one).
Function WorkArray2D%()
	Local x%, y%, sum%
	For y = 0 To 1023
		For x = 0 To 1023
			grid(x, y) = (x * y) And 255
		Next
	Next
	sum = 0
	For y = 0 To 1023
		For x = 0 To 1023
			sum = sum + grid(x, y)
		Next
	Next
	For x = 0 To 1023
		For y = 0 To 1023
			sum = sum + grid(x, y)
		Next
	Next
	Return sum
End Function

; Twenty multiplications of 100 x 100 float matrices. The values are small whole numbers, so the result is exact.
Function WorkMatMul%()
	Local i%, j%, k%, rep%, sum#
	For i = 0 To 99
		For j = 0 To 99
			ma(i, j) = (i * j) Mod 17
			mb(i, j) = (i + j) Mod 13
		Next
	Next
	sum = 0
	For rep = 1 To 20
		For i = 0 To 99
			For j = 0 To 99
				sum = 0
				For k = 0 To 99
					sum = sum + ma(i, k) * mb(k, j)
				Next
				mc(i, j) = sum
			Next
		Next
		ma(rep, rep) = ma(rep, rep) + 1
	Next
	sum = 0
	For i = 0 To 99
		For j = 0 To 99
			sum = sum + mc(i, j)
		Next
	Next
	Return Int(sum) And $7FFFFFFF
End Function

; Shell sort of 300000 random integers; the result checks the order and a few of the values.
Function WorkSort%()
	Local n%, i%, j%, gap%, v%, bad%
	n = 300000
	For i = 0 To n - 1
		sortdata(i) = Rand31() Mod 1000000
	Next
	gap = n / 2
	While gap > 0
		For i = gap To n - 1
			v = sortdata(i)
			j = i
			; And does not skip the second test, so the index is checked first.
			While j >= gap
				If sortdata(j - gap) <= v Then Exit
				sortdata(j) = sortdata(j - gap)
				j = j - gap
			Wend
			sortdata(j) = v
		Next
		gap = gap / 2
	Wend
	bad = 0
	For i = 1 To n - 1
		If sortdata(i - 1) > sortdata(i) Then bad = bad + 1
	Next
	Return sortdata(0) + sortdata(n / 2) + sortdata(n - 1) + bad * 1000000000
End Function

; A string that grows by one character 30000 times (every append copies the string).
Function WorkStrConcat%()
	Local i%, c%
	Local s$
	s = ""
	For i = 1 To 30000
		s = s + Chr$(65 + (i Mod 26))
	Next
	c = 0
	For i = 1 To Len(s) Step 100
		c = c + Asc(Mid$(s, i, 1))
	Next
	Return Len(s) + c
End Function

; Many short strings: Str$, +, Mid$, Left$, Right$, Upper$, Instr, Len and Asc.
Function WorkStrOps%()
	Local i%, n%
	Local t$, u$
	n = 0
	For i = 1 To 200000
		t = "item" + Str$(i)
		u = Upper$(Mid$(t, 2, 3)) + Left$(t, 2) + Right$(t, 2)
		n = (n + Len(u) + Instr(t, "m") + Asc(Right$(t, 1)) + Instr(u, "TEM")) And $FFFFFF
	Next
	Return n
End Function

; Objects: 200000 are made, walked twice, the odd ones are deleted, and then the rest.
Function WorkTypes%()
	Local i%, sum%, n.Node
	For i = 1 To 200000
		n = New Node
		n\x = i
		n\y = i * 3
		n\f = i * 0.5
	Next
	sum = 0
	For n = Each Node
		sum = (sum + n\x + n\y + Int(n\f)) And $FFFFFF
	Next
	For n = Each Node
		If (n\x And 1) = 1 Then Delete n
	Next
	For n = Each Node
		sum = (sum + n\x - n\y) And $FFFFFF
	Next
	Delete Each Node
	Return sum
End Function

; A 4 MB bank: ints written and read, floats written and read, bytes written, and the bank copied.
Function WorkBanks%()
	Local i%, sum%, b%, c%
	Local f#
	b = CreateBank(4 * 1048576)
	c = CreateBank(4 * 1048576)
	For i = 0 To 1048575
		PokeInt b, i * 4, i * 3
	Next
	sum = 0
	For i = 0 To 1048575
		sum = (sum + PeekInt(b, i * 4)) And $FFFFFFF
	Next
	For i = 0 To 1048575
		PokeFloat b, i * 4, i * 0.25
	Next
	f = 0
	For i = 0 To 1048575
		f = f + PeekFloat(b, i * 4)
	Next
	For i = 0 To 4194303
		PokeByte b, i, i And 255
	Next
	CopyBank b, 0, c, 0, 4 * 1048576
	For i = 0 To 4194303 Step 4093
		sum = (sum + PeekByte(c, i)) And $FFFFFFF
	Next
	FreeBank b
	FreeBank c
	Return sum + (Int(f) And $FFFF)
End Function

Function Add3%(a%, b%, c%)
	Return a + b + c
End Function

; Twenty-five million calls of a small function.
Function WorkCalls%()
	Local i%, c%
	c = 0
	For i = 1 To 25000000
		c = Add3(c, i, 1) And $FFFFFF
	Next
	Return c
End Function

; Recursive Fibonacci: Fib(34) = 5702887 and 18454929 calls.
Function Fib%(n%)
	If n < 2 Then Return n
	Return Fib(n - 1) + Fib(n - 2)
End Function
