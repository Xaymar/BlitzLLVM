; The shared harness of the microbenchmarks (micro_*.bb), for BlitzLLVM and the original Blitz3D alike. A microbenchmark times one
; builtin, or one small piece of work, in a tight loop and gives the time of one iteration in nanoseconds. Changes that are far too
; small for the game benchmarks (forest, spacebattle: about 10% between runs) can be seen there. They only show what that piece of
; code costs, though: whether a change matters in a frame is still for the game benchmarks to tell.
;
; A case is a function that the program calls:
;
;   Function Math_Sin()
;   	If Not MicroCase("math/sin") Then Return
;   	s# = 0
;   	While MicroRun()
;   		For i = 1 To MicroN
;   			s = s + Sin(i)
;   		Next
;   	Wend
;   	MicroSinkF = MicroSinkF + s
;   End Function
;
; MicroCase says whether the case was asked for (MICRO_FILTER). MicroRun times the loop: first it raises MicroN until one pass takes
; MICRO_TARGET_US (calibration, not counted), then it times MICRO_SAMPLES passes of MicroN iterations and writes them to the result
; file. The work adds its results up and hands them to a sink at the end, so that the optimizer cannot leave the work out. Inputs
; that the optimizer could see through (constant strings, constant handles) come from globals that are set at run time.
;
; The time of an iteration includes the loop (about a nanosecond on a desktop CPU), which is the same in A and B.
;
; Drawing commands are collected and sent to the GPU at Flip. A case that draws sets MicroFlip = 1: MicroRun then calls Flip 0 after
; every pass, outside the timed part, so that the collected work does not pile up. The time of such a case is that of the call, not
; of the work that the call leaves for Flip and for the GPU; cases that time a whole frame call Flip in their loop.
;
; Environment variables (python3 benchmarks/micro.py sets them):
;   MICRO_FILTER     cases to run: words separated by commas, a case runs when its name contains one of them (default: all)
;   MICRO_SAMPLES    timed passes per case (default 11)
;   MICRO_TARGET_US  length of one pass in microseconds (default 2000, 50000 with the original's millisecond timer)
;   BENCH_RESULT     the result file: one line per case, "MICRO <name> <iterations> <pieces of work per iteration>
;                    <microseconds of each pass>...", then RESULT

Global MicroFilter$ = Lower$(Env$("MICRO_FILTER", ""))
Global MicroSamples = Int(Env$("MICRO_SAMPLES", 11))
If MicroSamples < 1 Then MicroSamples = 1
Global MicroTargetDefault = 2000
If BenchCompiler$() = "original" Then MicroTargetDefault = 50000
Global MicroTarget = Int(Env$("MICRO_TARGET_US", MicroTargetDefault))
If MicroTarget < 1 Then MicroTarget = 1

; The iterations of one pass, set by MicroRun.
Global MicroN = 1
; How many pieces of work one iteration does (a case that walks over 1000 objects per iteration sets 1000 after MicroCase): the time
; is given per piece.
Global MicroPer = 1
Global MicroName$ = ""
Global MicroStarted = 0
Global MicroCalibrating = 0
Global MicroStart = 0
Global MicroCount = 0
Global MicroTimes$ = ""
Global MicroCases = 0
Global MicroFlip = 0

; Where the work of the cases ends up, so that it is not optimized away. Printed in the RESULT line.
Global MicroSinkI = 0
Global MicroSinkF# = 0
Global MicroSinkS$ = ""

Global MicroFile = 0
Global MicroFileName$ = GetEnv$("BENCH_RESULT")
If MicroFileName$ <> "" Then MicroFile = WriteFile(MicroFileName$)

; Inputs the optimizer cannot see through.
Global MicroText$ = Env$("MICRO_TEXT", "The quick brown fox jumps over the lazy dog")
Global MicroShort$ = Env$("MICRO_SHORT", "fox")
Global MicroNumber$ = Env$("MICRO_NUMBER", "12345")
Global MicroReal$ = Env$("MICRO_REAL", "3.14159")
Global MicroOne = Int(Env$("MICRO_ONE", 1))
Global MicroHalf# = Float(Env$("MICRO_HALF", "0.5"))

; True when the case name$ is to run; then the next MicroRun starts calibrating it.
Function MicroCase(name$)
	MicroName$ = name$
	MicroStarted = 0
	MicroCount = 0
	MicroTimes$ = ""
	MicroN = 1
	MicroPer = 1
	MicroFlip = 0
	If MicroFilter$ <> "" Then
		found = 0
		rest$ = MicroFilter$
		While rest$ <> "" And found = 0
			comma = Instr(rest$, ",")
			If comma = 0 Then
				word$ = rest$
				rest$ = ""
			Else
				word$ = Left$(rest$, comma - 1)
				rest$ = Mid$(rest$, comma + 1)
			EndIf
			word$ = Trim$(word$)
			If word$ <> "" And Instr(Lower$(name$), word$) > 0 Then found = 1
		Wend
		If found = 0 Then Return 0
	EndIf
	MicroCalibrating = 1
	Return 1
End Function

; Call as the condition of the While around the loop of a case: True while there is another pass to run.
Function MicroRun()
	now = BenchMicros()
	If MicroStarted = 0 Then
		MicroStarted = 1
		MicroStart = BenchMicros()
		Return 1
	EndIf
	elapsed = now - MicroStart
	If MicroFlip Then Flip 0
	If MicroCalibrating = 2 Then
		; A second pass with the same MicroN: the first one that was long enough may have paid for page faults or cold caches.
		If elapsed * 2 >= MicroTarget Or MicroN >= 1000000000 Then
			MicroCalibrating = 0
		Else
			MicroCalibrating = 1
			MicroGrow elapsed
		EndIf
	ElseIf MicroCalibrating = 1 Then
		If elapsed >= MicroTarget Or MicroN >= 1000000000 Then
			MicroCalibrating = 2
		Else
			MicroGrow elapsed
		EndIf
	Else
		MicroTimes$ = MicroTimes$ + " " + elapsed
		MicroCount = MicroCount + 1
		If MicroCount >= MicroSamples Then
			MicroWrite "MICRO " + MicroName$ + " " + MicroN + " " + MicroPer + MicroTimes$
			MicroCases = MicroCases + 1
			MicroStarted = 0
			MicroFlip = 0
			Return 0
		EndIf
	EndIf
	MicroStart = BenchMicros()
	Return 1
End Function

; Raises MicroN towards a pass of MicroTarget microseconds, after a pass of elapsed microseconds.
Function MicroGrow(elapsed)
	factor# = 16
	If elapsed > 0 Then factor = 1.2 * MicroTarget / elapsed
	If factor < 2 Then factor = 2
	If factor > 1000 Then factor = 1000
	grown# = MicroN * factor
	If grown > 1000000000 Then grown = 1000000000
	MicroN = Int(grown)
End Function

Function MicroWrite(line$)
	DebugLog line$
	If MicroFile <> 0 Then WriteLine MicroFile, line$
End Function

; Ends the program: writes the RESULT line that the runner waits for.
Function MicroEnd()
	MicroWrite "RESULT cases=" + MicroCases + " samples=" + MicroSamples + " target_us=" + MicroTarget + " sink=" + ((MicroSinkI + Int(MicroSinkF) + Len(MicroSinkS$)) And 1)
	If MicroFile <> 0 Then CloseFile MicroFile
	End
End Function
