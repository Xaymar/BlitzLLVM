; Flies a camera through a field of many meshes and sprites of different kinds and shadings, on a path that is the same on
; every run, and prints how long the frames took and what they cost (draw calls, triangles). Needs a window and a GPU:
; python3 benchmarks/flythrough.py builds and runs it, under xvfb and llvmpipe if there is no display. See README.adoc.
;
; Environment variables:
;   BENCH_OBJECTS  how many entities are made (default 20000, one million is 1000000)
;   BENCH_FRAMES   how many frames are timed (default 300)
;   BENCH_WARMUP   frames that are rendered but not timed, they make the GPU buffers (default 5)
;   BENCH_SEED     seed of the random positions (default 1)
;   BENCH_W, BENCH_H  size of the window (default 640 x 360)
;   BENCH_RANGE    how far the camera sees (default 300)
;   BENCH_MODEL    path of a model for LoadMesh (optional, a cube is used if it is empty or does not load)
;   BENCH_SHOT     file to save the last frame to (optional)
;   BENCH_RESULT   file to write the RESULT line to (optional, it is also in the debug log)
;   BENCH_FRAMETIMES  file to write the time of every frame to, in microseconds, one per line (optional)
;
; The kinds are made in this order, entity i is of kind (i Mod 16), so every kind has the same share:
;   0 cube, lit, one color         1 cube, textured           2 sphere, smooth lit       3 sphere, flat shaded
;   4 cone, lit, textured          5 cylinder, lit            6 octahedron, vertex colors   7 sphere, full-bright, textured
;   8 cube, alpha 0.5              9 sphere, additive blend  10 cube, two sided, textured 11 loaded model (or a cube)
;  12 sprite, textured            13 sprite, alpha            14 sprite, additive        15 sprite, flat color, fixed rotation

; Runs with BlitzLLVM and with the original Blitz3D, so that their speeds can be compared. What the original does not have (a
; microsecond timer, the draw counters) is in flythrough_llvm.bi or flythrough_original.bi, python3 benchmarks/flythrough.py copies
; the right one next to this file as flythrough_counters.bi.
Include "flythrough_counters.bi"

Const KINDS = 16

Graphics3D Int(Env$("BENCH_W", 640)), Int(Env$("BENCH_H", 360)), 32, 2
SetBuffer BackBuffer()

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

; The random numbers come from this generator and not from Rnd, because Rnd gives different numbers in BlitzLLVM and in the
; original Blitz3D, and then the two would not draw the same scene. It is the Park-Miller generator, with Schrage's way of
; multiplying without leaving 31 bits, so it gives the same numbers in both.
Global BenchState = 1

Function BenchSeedRnd(seed)
	BenchState = (seed Mod 2147483646) + 1
	If BenchState < 1 Then BenchState = BenchState + 2147483646
End Function

Function BenchRnd#(low#, high#)
	BenchState = 16807 * (BenchState Mod 127773) - 2836 * (BenchState / 127773)
	If BenchState <= 0 Then BenchState = BenchState + 2147483647
	Return low + (high - low) * (BenchState / 2147483647.0)
End Function

objects = Int(Env$("BENCH_OBJECTS", 20000))
frames = Int(Env$("BENCH_FRAMES", 300))
warmup = Int(Env$("BENCH_WARMUP", 5))
seed = Int(Env$("BENCH_SEED", 1))
viewrange# = Float(Env$("BENCH_RANGE", 300))
If objects < KINDS Then objects = KINDS
If frames < 1 Then frames = 1

BenchSeedRnd seed

camera = CreateCamera()
CameraClsColor camera, 8, 10, 24
CameraRange camera, 0.1, viewrange
light = CreateLight()
RotateEntity light, 45, 30, 0
AmbientLight 60, 60, 60

; Four textures, drawn so that they look different from each other and from the flat colors.
Dim textures(3)
For t = 0 To 3
	textures(t) = CreateTexture(32, 32)
	SetBuffer TextureBuffer(textures(t))
	Color 30 + t * 60, 220 - t * 50, 90 + t * 30
	Rect 0, 0, 32, 32
	Color 255, 255, 255
	Rect 0, 0, 16, 16
	Rect 16, 16, 16, 16
	SetBuffer BackBuffer()
Next

; An octahedron whose corners have different colors, which is what vertex colored geometry looks like.
Function MakeGem()
	m = CreateMesh()
	s = CreateSurface(m)
	AddVertex s, 1, 0, 0 : VertexColor s, 0, 255, 60, 60
	AddVertex s, -1, 0, 0 : VertexColor s, 1, 60, 255, 60
	AddVertex s, 0, 1, 0 : VertexColor s, 2, 60, 60, 255
	AddVertex s, 0, -1, 0 : VertexColor s, 3, 255, 255, 60
	AddVertex s, 0, 0, 1 : VertexColor s, 4, 60, 255, 255
	AddVertex s, 0, 0, -1 : VertexColor s, 5, 255, 60, 255
	AddTriangle s, 0, 2, 4 : AddTriangle s, 4, 2, 1 : AddTriangle s, 1, 2, 5 : AddTriangle s, 5, 2, 0
	AddTriangle s, 4, 3, 0 : AddTriangle s, 1, 3, 4 : AddTriangle s, 5, 3, 1 : AddTriangle s, 0, 3, 5
	UpdateNormals m
	Return m
End Function

Dim templates(KINDS - 1)
templates(0) = CreateCube()
EntityColor templates(0), 220, 120, 40
templates(1) = CreateCube()
EntityTexture templates(1), textures(0)
templates(2) = CreateSphere(8)
EntityColor templates(2), 90, 170, 230
templates(3) = CreateSphere(8)
EntityColor templates(3), 120, 220, 120
EntityFX templates(3), 4
templates(4) = CreateCone(12)
EntityTexture templates(4), textures(1)
templates(5) = CreateCylinder(12)
EntityColor templates(5), 200, 200, 90
templates(6) = MakeGem()
EntityFX templates(6), 2
templates(7) = CreateSphere(8)
EntityTexture templates(7), textures(2)
EntityFX templates(7), 1
templates(8) = CreateCube()
EntityColor templates(8), 240, 80, 120
EntityAlpha templates(8), 0.5
templates(9) = CreateSphere(8)
EntityColor templates(9), 255, 200, 80
EntityBlend templates(9), 3
templates(10) = CreateCube()
EntityTexture templates(10), textures(3)
EntityFX templates(10), 16
modelname$ = GetEnv$("BENCH_MODEL")
templates(11) = 0
If modelname$ <> "" Then templates(11) = LoadMesh(modelname$)
If templates(11) = 0 Then templates(11) = CreateCube()
; Any size of model ends up about as big as the primitives.
extent# = MeshWidth(templates(11))
If MeshHeight(templates(11)) > extent Then extent = MeshHeight(templates(11))
If MeshDepth(templates(11)) > extent Then extent = MeshDepth(templates(11))
If extent > 0 Then ScaleMesh templates(11), 2 / extent, 2 / extent, 2 / extent
templates(12) = CreateSprite()
EntityTexture templates(12), textures(0)
templates(13) = CreateSprite()
EntityTexture templates(13), textures(1)
EntityAlpha templates(13), 0.5
templates(14) = CreateSprite()
EntityTexture templates(14), textures(2)
EntityBlend templates(14), 3
templates(15) = CreateSprite()
EntityColor templates(15), 250, 250, 250
SpriteViewMode templates(15), 2
For k = 0 To KINDS - 1
	HideEntity templates(k)
Next

; The field is a box with the same density whatever the count: about 3 units per entity along each side. The camera
; flies through the middle of it, so about the same number of entities are around it at every count.
side# = Float(objects) ^ (1.0 / 3.0) * 3
creationstart = BenchMicros()
For i = 0 To objects - 1
	e = CopyEntity(templates(i Mod KINDS))
	ShowEntity e
	PositionEntity e, BenchRnd(-side / 2, side / 2), BenchRnd(-side / 2, side / 2), BenchRnd(-side / 2, side / 2)
	size# = BenchRnd(0.6, 1.4)
	ScaleEntity e, size, size, size
	If (i Mod KINDS) < 12 Then RotateEntity e, BenchRnd(0, 360), BenchRnd(0, 360), BenchRnd(0, 360)
Next
creation# = (BenchMicros() - creationstart) / 1000.0

; The camera path: a loop through the field, one step per frame whatever the speed of the computer is.
; 1500 frames are one lap.
Function CameraStep(camera, frame, side#)
	a# = frame * 360.0 / 1500
	r# = side * 0.3
	PositionEntity camera, Cos(a) * r, Sin(a * 2) * r * 0.4, Sin(a) * r
	; Looks along the path, with some nodding.
	RotateEntity camera, Sin(a * 3) * 10, -a - 90, 0
End Function

Dim times#(frames - 1)
drawsum# = 0 : pipesum# = 0 : texsum# = 0 : bufsum# = 0 : trissum# = 0
total# = 0

For f = 0 To warmup + frames - 1
	CameraStep camera, f, side
	t0 = BenchMicros()
	RenderWorld
	Flip 0
	elapsed# = BenchMicros() - t0
	If f >= warmup Then
		n = f - warmup
		times(n) = elapsed
		total = total + elapsed
		drawsum = drawsum + BenchDraws()
		pipesum = pipesum + BenchPipelines()
		texsum = texsum + BenchTextures()
		bufsum = bufsum + BenchBuffers()
		trissum = trissum + TrisRendered()
	EndIf
Next

shot$ = GetEnv$("BENCH_SHOT")
If shot$ <> "" Then SaveBuffer BackBuffer(), shot$

; Sorting the times gives the median and the 95th percentile.
Dim srt#(frames - 1)
For i = 0 To frames - 1
	srt(i) = times(i)
Next
gap = frames / 2
While gap > 0
	For i = gap To frames - 1
		v# = srt(i)
		j = i
		; And does not skip the second test, so the index is checked first.
		While j >= gap
			If srt(j - gap) <= v Then Exit
			srt(j) = srt(j - gap)
			j = j - gap
		Wend
		srt(j) = v
	Next
	gap = gap / 2
Wend
p95 = Int(frames * 0.95) : If p95 > frames - 1 Then p95 = frames - 1

timesfile$ = GetEnv$("BENCH_FRAMETIMES")
If timesfile$ <> "" Then
	file = WriteFile(timesfile$)
	If file <> 0 Then
		For i = 0 To frames - 1
			WriteLine file, Int(times(i))
		Next
		CloseFile file
	EndIf
EndIf

avg# = total / frames / 1000
result$ = "RESULT objects=" + objects + " frames=" + frames + " seed=" + seed + " width=" + GraphicsWidth() + " height=" + GraphicsHeight() + " create_ms=" + creation + " ms_avg=" + avg + " ms_min=" + (srt(0) / 1000) + " ms_median=" + (srt(frames / 2) / 1000) + " ms_p95=" + (srt(p95) / 1000) + " ms_max=" + (srt(frames - 1) / 1000) + " fps=" + (1000 / avg) + " tris=" + Int(trissum / frames) + " draws=" + Int(drawsum / frames) + " pipelines=" + Int(pipesum / frames) + " textures=" + Int(texsum / frames) + " buffers=" + Int(bufsum / frames)
DebugLog result$
resultfile$ = GetEnv$("BENCH_RESULT")
If resultfile$ <> "" Then
	file = WriteFile(resultfile$)
	If file <> 0 Then
		WriteLine file, result$
		CloseFile file
	EndIf
EndIf
End
