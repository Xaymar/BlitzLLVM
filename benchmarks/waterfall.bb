; A river runs over a plateau and falls off a cliff into a pool. The water is nothing but sprites: the river is a stream of
; sprites on the plateau, the waterfall is a sheet of sprites falling from the lip, and a cloud of mist sprites billows at the
; foot. They are all soft, see-through and overlap a lot, so the frame is mostly blending and overdraw, which a field of solid
; meshes (flythrough.bb) does not test. The camera swings in front of the fall on a path that is the same on every run.
; Needs a window and a GPU: python3 benchmarks/waterfall.py builds and runs it, under xvfb and llvmpipe if there is no display.
;
; Environment variables:
;   BENCH_SPRITES  how many water sprites are made (default 5000; 50000 is a heavy fall)
;   BENCH_FRAMES   how many frames are timed (default 300)
;   BENCH_GPU      the graphics driver number for SetGfxDriver (optional, default is the one the program picks)
;   BENCH_DITHER   the Dither level (default 0; 2 needs BlitzLLVM, the original only knows on and off)
;   BENCH_WARMUP   frames that are rendered but not timed, they make the GPU buffers (default 5)
;   BENCH_SEED     seed of the random sprite offsets (default 1)
;   BENCH_W, BENCH_H  size of the window (default 640 x 360)
;   BENCH_STATIC   1 places the sprites once (frame 0), so only the camera moves (default 0: the water flows)
;   BENCH_SHOT     file to save the last frame to (optional)
;   BENCH_RESULT   file to write the RESULT line to (optional, it is also in the debug log)
;   BENCH_FRAMETIMES  file to write the time of every frame to, in microseconds, one per line (optional)
;
; The sprites are split 35% river, 40% waterfall, 25% mist. Where a sprite is depends only on its frame number, so the
; picture is the same on every run and every machine.

; Runs with BlitzLLVM and with the original Blitz3D, so that their speeds can be compared. What the original does not have (a
; microsecond timer, the draw counters) is in waterfall_llvm.bi or waterfall_original.bi, python3 benchmarks/waterfall.py copies
; the right one next to this file as waterfall_counters.bi.
Include "waterfall_counters.bi"

Const PLATEAU# = 30.0
Const SPREAD# = 3.4

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

; The random numbers come from this generator and not from Rnd, because Rnd gives different numbers in BlitzLLVM and in the
; original Blitz3D, and then the two would not draw the same scene. It is the Park-Miller generator, with Schrage's way of
; multiplying without leaving 31 bits, so it gives the same numbers in both.
Global BenchState = 1

Function BenchSeedRnd(seed)
	BenchState = (seed Mod 2147483646) + 1
	If BenchState < 1 Then BenchState = BenchState + 2147483646
End Function

Function BenchRnd#(low#, high#)
	BenchState = 16807 * (BenchState Mod 127773) - 2836 * (BenchState / 127773)
	If BenchState <= 0 Then BenchState = BenchState + 2147483647
	Return low + (high - low) * (BenchState / 2147483647.0)
End Function

If GetEnv$("BENCH_GPU") <> "" Then SetGfxDriver Int(GetEnv$("BENCH_GPU"))
Graphics3D Int(Env$("BENCH_W", 640)), Int(Env$("BENCH_H", 360)), 32, 2
SetBuffer BackBuffer()
Dither Int(Env$("BENCH_DITHER", 0))

count = Int(Env$("BENCH_SPRITES", 5000))
frames = Int(Env$("BENCH_FRAMES", 300))
warmup = Int(Env$("BENCH_WARMUP", 5))
seed = Int(Env$("BENCH_SEED", 1))
still = Int(Env$("BENCH_STATIC", 0))
If count < 20 Then count = 20
If frames < 1 Then frames = 1

BenchSeedRnd seed

; The center line of the river on the plateau. It meanders on the way in and comes straight at the lip (z = 0).
Function RiverX#(z#)
	If z <= 0 Then Return 0
	Return Sin(z * 3) * 6
End Function

Function Smooth#(t#)
	If t < 0 Then t = 0
	If t > 1 Then t = 1
	Return t * t * (3 - 2 * t)
End Function

; Height of the ground. The plateau is at 30 and drops over two units at z = 0 into the basin; the river is cut into the
; plateau and a pool into the basin; the valley walls rise on both sides.
Function Height#(x#, z#)
	s# = Smooth(-z / 2)
	h# = PLATEAU * (1 - s)
	d# = Abs(x - RiverX(z))
	away# = Smooth((d - 3.4) / 4)
	walls# = Abs(x) - 16
	If walls < 0 Then walls = 0
	h = h + walls * 0.5
	h = h + 1.5 * Sin(x * 9) * Cos(z * 7) * away * (1 - s * 0.8)
	If z > -1 Then h = h - 2 * (1 - away)
	px# = x
	pz# = z + 14
	pool# = Sqr(px * px + pz * pz)
	h = h - 2 * (1 - Smooth((pool - 10) / 8)) * s
	Return h
End Function

; The ground: a grid of 1 x 1 units with vertex colors for grass, rock and sand.
Function MakeTerrain()
	m = CreateMesh()
	s = CreateSurface(m)
	x0 = -60 : z0 = -90
	nx = 120 : nz = 180
	For iz = 0 To nz
		For ix = 0 To nx
			x# = x0 + ix
			z# = z0 + iz
			h# = Height(x, z)
			slope# = Abs(Height(x + 1, z) - h) + Abs(Height(x, z + 1) - h)
			shade = 20 * Sin(x * 13 + z * 17)
			If slope > 1.2 Then
				r = 120 + shade : g = 110 + shade : b = 100 + shade
			ElseIf Abs(x - RiverX(z)) < 3.6 And z > 0 Then
				r = 175 + shade : g = 155 + shade : b = 105 + shade
			ElseIf h < 1.5 Then
				r = 150 + shade : g = 140 + shade : b = 100 + shade
			Else
				r = 55 + shade : g = 115 + shade : b = 45 + shade
			EndIf
			AddVertex s, x, h, z
			VertexColor s, iz * (nx + 1) + ix, r, g, b
		Next
	Next
	For iz = 0 To nz - 1
		For ix = 0 To nx - 1
			a = iz * (nx + 1) + ix
			b = a + 1
			c = a + nx + 1
			d = c + 1
			AddTriangle s, a, c, b
			AddTriangle s, b, c, d
		Next
	Next
	UpdateNormals m
	Return m
End Function

; A soft round puff: opaque white in the middle, see-through at the edge.
Function MakePuff()
	t = CreateTexture(32, 32, 3 + 4096)
	SetBuffer TextureBuffer(t)
	LockBuffer TextureBuffer(t)
	For y = 0 To 31
		For x = 0 To 31
			dx# = (x - 15.5) / 15.5
			dy# = (y - 15.5) / 15.5
			r# = Sqr(dx * dx + dy * dy)
			a# = 1 - r
			If a < 0 Then a = 0
			a = a * a * (3 - 2 * a)
			WritePixelFast x, y, (Int(a * 255) Shl 24) Or $FFFFFF, TextureBuffer(t)
		Next
	Next
	UnlockBuffer TextureBuffer(t)
	SetBuffer BackBuffer()
	Return t
End Function

camera = CreateCamera()
CameraClsColor camera, 150, 185, 225
CameraRange camera, 0.5, 250
light = CreateLight()
RotateEntity light, 50, -30, 0
AmbientLight 90, 90, 90

terrain = MakeTerrain()
EntityFX terrain, 2

; The pool at the foot of the fall.
pool = CreateCube()
ScaleEntity pool, 14, 0.05, 26
PositionEntity pool, 0, 0.6, -17
EntityColor pool, 40, 90, 150
EntityAlpha pool, 0.7

; More sprites means thinner ones, so that 50000 sprites look like a denser fall and not like a white wall.
thin# = 1
If count > 5000 Then thin = (5000.0 / count) ^ 0.8

puff = MakePuff()
Dim templates(2)
For k = 0 To 2
	templates(k) = CreateSprite()
	EntityTexture templates(k), puff
Next
EntityColor templates(0), 150, 190, 230
EntityAlpha templates(0), 0.35 * thin
ScaleSprite templates(0), 1.1, 1.1
EntityColor templates(1), 225, 240, 255
EntityAlpha templates(1), 0.4 * thin
EntityColor templates(2), 245, 250, 255
EntityAlpha templates(2), 0.25 * thin
For k = 0 To 2
	HideEntity templates(k)
Next

nriver = count * 35 / 100
nfall = count * 40 / 100
nmist = count - nriver - nfall

Dim spr(count - 1)
Dim phase#(count - 1)
Dim ox#(count - 1)
Dim oy#(count - 1)
Dim oz#(count - 1)
creationstart = BenchMicros()
For i = 0 To count - 1
	If i < nriver Then
		k = 0
	ElseIf i < nriver + nfall Then
		k = 1
	Else
		k = 2
	EndIf
	spr(i) = CopyEntity(templates(k))
	ShowEntity spr(i)
	phase(i) = BenchRnd(0, 1)
	ox(i) = BenchRnd(-1, 1)
	oy(i) = BenchRnd(0, 1)
	oz(i) = BenchRnd(-1, 1)
Next
creation# = (BenchMicros() - creationstart) / 1000.0

Dim times#(frames - 1)
Dim updates#(frames - 1)
drawsum# = 0 : pipesum# = 0 : texsum# = 0 : bufsum# = 0 : trissum# = 0
total# = 0 : updatetotal# = 0

target = CreatePivot()
PositionEntity target, 0, 13, -4

For f = 0 To warmup + frames - 1
	t0 = BenchMicros()

	; The camera swings 45 degrees to each side in front of the fall, drifting in and out and up and down. 1200 frames are one lap.
	a# = Sin(f * 360.0 / 1200) * 45
	r# = 40 + 8 * Sin(f * 360.0 / 600)
	PositionEntity camera, Sin(a) * r, 11 + 4 * Sin(f * 360.0 / 400), -4 - Cos(a) * r
	PointEntity camera, target

	If still = 0 Or f = 0 Then
		; The river: sprites drift along it towards the lip, 600 frames from the start of the river to the lip.
		fl# = f
		For i = 0 To nriver - 1
			u# = phase(i) + fl / 600
			u = u - Floor(u)
			z# = 88 - 88 * u
			PositionEntity spr(i), RiverX(z) + ox(i) * SPREAD, PLATEAU - 0.5 + oy(i) * 0.3, z
		Next
		; The fall: sprites leave the lip, speed up and drop 30 units in 80 frames, spreading as they go.
		For i = nriver To nriver + nfall - 1
			u = phase(i) + fl / 80
			u = u - Floor(u)
			sz# = 0.9 + 0.9 * u
			PositionEntity spr(i), ox(i) * SPREAD * (1 + 0.4 * u), PLATEAU * (1 - u * u) + 0.3, -1 - 3 * u + oz(i) * 0.8
			ScaleSprite spr(i), sz, sz
			EntityAlpha spr(i), (0.5 - 0.25 * u) * thin
		Next
		; The cloud: puffs rise from the foot, grow and thin out. 140 frames from birth to gone.
		For i = nriver + nfall To count - 1
			u = phase(i) + fl / 140
			u = u - Floor(u)
			ang# = (ox(i) + 1) * 180
			rad# = 2 + u * 10 * (0.5 + 0.5 * Abs(oz(i)))
			sz = 2.5 + u * 4.5
			PositionEntity spr(i), Cos(ang) * rad * 1.3, 1 + u * 7 * (0.5 + oy(i)), -5 + Sin(ang) * rad
			ScaleSprite spr(i), sz, sz
			EntityAlpha spr(i), 0.35 * Sin(u * 180) * thin
		Next
	EndIf
	updated# = BenchMicros() - t0

	RenderWorld
	BenchFlip()
	elapsed# = BenchMicros() - t0
	If f >= warmup Then
		n = f - warmup
		times(n) = elapsed
		updates(n) = updated
		total = total + elapsed
		updatetotal = updatetotal + updated
		drawsum = drawsum + BenchDraws()
		pipesum = pipesum + BenchPipelines()
		texsum = texsum + BenchTextures()
		bufsum = bufsum + BenchBuffers()
		trissum = trissum + TrisRendered()
	EndIf
Next

shot$ = GetEnv$("BENCH_SHOT")
If shot$ <> "" Then SaveBuffer BackBuffer(), shot$

; Sorting the times gives the median and the 95th percentile.
Dim srt#(frames - 1)
For i = 0 To frames - 1
	srt(i) = times(i)
Next
gap = frames / 2
While gap > 0
	For i = gap To frames - 1
		v# = srt(i)
		j = i
		; And does not skip the second test, so the index is checked first.
		While j >= gap
			If srt(j - gap) <= v Then Exit
			srt(j) = srt(j - gap)
			j = j - gap
		Wend
		srt(j) = v
	Next
	gap = gap / 2
Wend
p95 = Int(frames * 0.95) : If p95 > frames - 1 Then p95 = frames - 1

timesfile$ = GetEnv$("BENCH_FRAMETIMES")
If timesfile$ <> "" Then
	file = WriteFile(timesfile$)
	If file <> 0 Then
		For i = 0 To frames - 1
			WriteLine file, Int(times(i))
		Next
		CloseFile file
	EndIf
EndIf

avg# = total / frames / 1000
result$ = "RESULT sprites=" + count + " frames=" + frames + " seed=" + seed + " static=" + still + " width=" + GraphicsWidth() + " height=" + GraphicsHeight() + " create_ms=" + creation + " update_ms=" + (updatetotal / frames / 1000) + " ms_avg=" + avg + " ms_min=" + (srt(0) / 1000) + " ms_median=" + (srt(frames / 2) / 1000) + " ms_p95=" + (srt(p95) / 1000) + " ms_max=" + (srt(frames - 1) / 1000) + " fps=" + (1000 / avg) + " tris=" + Int(trissum / frames) + " draws=" + Int(drawsum / frames) + " pipelines=" + Int(pipesum / frames) + " textures=" + Int(texsum / frames) + " buffers=" + Int(bufsum / frames)
DebugLog result$
resultfile$ = GetEnv$("BENCH_RESULT")
If resultfile$ <> "" Then
	file = WriteFile(resultfile$)
	If file <> 0 Then
		WriteLine file, result$
		CloseFile file
	EndIf
EndIf
End
