; A space battle: two fleets of ships fight between their stations, traders fly long routes between the stations and the planets,
; and asteroid belts lie in the way. It is the benchmark for what a game does besides drawing: the code of the ships (a grid of
; neighbours in arrays, finding targets, steering), picking (line of sight with EntityVisible, every shot a LinePick, a CameraPick
; for the aim of the camera), collisions (ships against asteroids and against the stations, in UpdateWorld), creating and freeing
; entities (ships that die come back, laser bolts and debris come and go) and, with BlitzLLVM, physics: the debris of a ship that
; dies are bodies that bump into each other, into the asteroids and into the stations.
; Every step is one frame, not a time, and the random numbers come from the generator below, so a run with the same compiler draws
; the same frames every time. Between compilers the rounding of floats differs a little, and over thousands of frames a fight
; grows from such differences: the counts in the result (kills, shots, picks, collisions) show how far two runs went apart.
; Needs a window and a GPU: python3 benchmarks/spacebattle.py builds and runs it, under xvfb and llvmpipe if there is no display.
;
; Environment variables:
;   BENCH_SHIPS      ships of both fleets together (default 2000), every tenth is a trader
;   BENCH_ASTEROIDS  asteroids in the two belts (default 1500)
;   BENCH_DEBRIS     at most this many pieces of debris at once, the oldest go first (default 2000)
;   BENCH_FRAMES     how many frames are timed (default 3000)
;   BENCH_WARMUP     frames that run but are not timed (default 30)
;   BENCH_SEED       seed of the random numbers (default 1)
;   BENCH_W, BENCH_H size of the window (default 640 x 360)
;   BENCH_DEPTH      colour depth for Graphics3D (0 or unset: the default)
;   BENCH_GPU        graphics driver for SetGfxDriver (0 or unset: the default)
;   BENCH_SHOT       file to save the last frame to (optional)
;   BENCH_RESULT     file to write the RESULT line to (optional, it is also in the debug log)
;   BENCH_FRAMETIMES file to write the time of every frame to, in microseconds, one per line (optional)
;
; The camera rides behind a trader for the first 1000 frames, behind a fighter in the fight for the next 1000, and then circles a
; station; after 3000 frames it starts again.

; Runs with BlitzLLVM and with the original Blitz3D, so that their speeds can be compared. What the original does not have (a
; microsecond timer, the draw counters, physics) is in spacebattle_llvm.bi or spacebattle_original.bi, python3
; benchmarks/spacebattle.py copies the right one next to this file as spacebattle_counters.bi. Without physics the debris of the
; original fly in straight lines.
Include "spacebattle_counters.bi"

Const TEAMS = 2
Const STATIONS = 4               ; per team
Const PLANETS = 5
Const CELL# = 150.0              ; size of a cell of the neighbour grid
Const GRID = 44                  ; cells along x and z, the grid covers -3300 to 3300
Const GRIDHALF# = 3300.0
Const FIGHTER_SPEED# = 3.0
Const TRADER_SPEED# = 6.0
Const RANGE# = 200.0             ; how far a laser reaches
Const BOLT_LIFE = 8
Const DEBRIS_LIFE = 240
Const RESPAWN = 180
Const CAMERA_LAP = 3000

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

; The random numbers come from this generator and not from Rnd, because Rnd gives different numbers in BlitzLLVM and in the
; original Blitz3D, and then the two would not build the same scene. It is the Park-Miller generator, with Schrage's way of
; multiplying without leaving 31 bits, so it gives the same numbers in both.
Global SBState = 1

Function SBSeed(seed)
	SBState = (seed Mod 2147483646) + 1
	If SBState < 1 Then SBState = SBState + 2147483646
End Function

Function SBRnd#(low#, high#)
	SBState = 16807 * (SBState Mod 127773) - 2836 * (SBState / 127773)
	If SBState <= 0 Then SBState = SBState + 2147483647
	Return low + (high - low) * (SBState / 2147483647.0)
End Function

Function SBRndInt(low, high)
	v = Int(Floor(SBRnd(low, high + 1)))
	If v > high Then v = high
	Return v
End Function

gpu = Int(Env$("BENCH_GPU", "0"))
depth = Int(Env$("BENCH_DEPTH", "0"))
If gpu > 0 Then SetGfxDriver gpu
Graphics3D Int(Env$("BENCH_W", "640")), Int(Env$("BENCH_H", "360")), depth, 2
SetBuffer BackBuffer()

Global ships = Int(Env$("BENCH_SHIPS", "2000"))
asteroids = Int(Env$("BENCH_ASTEROIDS", "1500"))
Global debriscap = Int(Env$("BENCH_DEBRIS", "2000"))
frames = Int(Env$("BENCH_FRAMES", "3000"))
warmup = Int(Env$("BENCH_WARMUP", "30"))
seed = Int(Env$("BENCH_SEED", "1"))
If ships < 2 Then ships = 2
If asteroids < 0 Then asteroids = 0
If debriscap < 0 Then debriscap = 0
If frames < 1 Then frames = 1
If warmup < 0 Then warmup = 0

SBSeed seed
creationstart = BenchMicros()

; Collision types: ships slide along asteroids (sphere to sphere) and along stations (sphere to polygon).
Const TYPE_SHIP = 1
Const TYPE_ASTEROID = 2
Const TYPE_STATION = 3
Collisions TYPE_SHIP, TYPE_ASTEROID, 1, 2
Collisions TYPE_SHIP, TYPE_STATION, 2, 2

BenchPhysicsInit()

AmbientLight 50, 50, 60
Global sunlight = CreateLight(1)
LightColor sunlight, 255, 240, 220
PositionEntity sunlight, 0, 800, 4000
PointEntity sunlight, CreatePivot()

Global camera = CreateCamera()
CameraRange camera, 1, 9000
CameraClsColor camera, 2, 2, 8

; ---------------------------------------------------------------------------------------------------------------------------------
; Textures, made here so that the benchmark needs no files.

Function MakeTexture(r, g, b, bands, seed)
	tex = CreateTexture(128, 64)
	buf = TextureBuffer(tex)
	LockBuffer buf
	For y = 0 To 63
		band# = 0.75 + 0.25 * Sin(y * bands * 5.625 + seed * 37)
		For x = 0 To 127
			n# = band * (0.9 + 0.1 * Sin(x * 11.25 + y * 7 + seed * 13) * Cos(y * 17.0 - x * 3))
			cr = r * n : cg = g * n : cb = b * n
			If cr > 255 Then cr = 255
			If cg > 255 Then cg = 255
			If cb > 255 Then cb = 255
			WritePixelFast x, y, $FF000000 Or (cr Shl 16) Or (cg Shl 8) Or cb, buf
		Next
	Next
	UnlockBuffer buf
	Return tex
End Function

; ---------------------------------------------------------------------------------------------------------------------------------
; Sun, planets and stars.

sun = CreateSphere(24)
ScaleEntity sun, 300, 300, 300
PositionEntity sun, 0, 800, 4000
EntityColor sun, 255, 230, 160
EntityFX sun, 1

Dim planetx#(PLANETS - 1), planety#(PLANETS - 1), planetz#(PLANETS - 1), planetr#(PLANETS - 1), planetent(PLANETS - 1)
For p = 0 To PLANETS - 1
	angle# = p * 72 + SBRnd(-15, 15)
	dist# = SBRnd(1800, 2900)
	planetr(p) = SBRnd(140, 380)
	planetx(p) = Sin(angle) * dist
	planety(p) = SBRnd(-200, 200)
	planetz(p) = Cos(angle) * dist
	planetent(p) = CreateSphere(32)
	ScaleEntity planetent(p), planetr(p), planetr(p), planetr(p)
	PositionEntity planetent(p), planetx(p), planety(p), planetz(p)
	TurnEntity planetent(p), SBRnd(-20, 20), 0, SBRnd(-20, 20)
	EntityTexture planetent(p), MakeTexture(SBRndInt(80, 255), SBRndInt(80, 255), SBRndInt(80, 255), SBRndInt(2, 9), p)
	EntityPickMode planetent(p), 1
Next

; The stars are one mesh of small quads far away, so they cost one draw.
stars = CreateMesh()
starsurf = CreateSurface(stars)
For i = 0 To 1499
	yaw# = SBRnd(0, 360) : pitch# = SBRnd(-80, 80)
	sx# = Cos(pitch) * Sin(yaw) * 7000 : sy# = Sin(pitch) * 7000 : sz# = Cos(pitch) * Cos(yaw) * 7000
	s# = SBRnd(6, 14)
	sv = AddVertex(starsurf, sx - s, sy - s, sz)
	AddVertex starsurf, sx + s, sy - s, sz
	AddVertex starsurf, sx + s, sy + s, sz
	AddVertex starsurf, sx - s, sy + s, sz
	AddTriangle starsurf, sv, sv + 1, sv + 2
	AddTriangle starsurf, sv, sv + 2, sv + 3
Next
EntityFX stars, 1 + 16

; ---------------------------------------------------------------------------------------------------------------------------------
; Stations: a hub, a ring of blocks and spokes, made into one mesh so that ships collide with its polygons. They turn slowly.

Function MakeStation()
	station = CreateSphere(16)
	ScaleMesh station, 30, 30, 30
	For k = 0 To 11
		block = CreateCube()
		ScaleMesh block, 8, 5, 20
		PositionMesh block, 0, 0, 75
		RotateMesh block, 0, k * 30, 0
		AddMesh block, station
		FreeEntity block
	Next
	For k = 0 To 3
		; A spoke from the hub (radius 30) to the ring (radius 75).
		spoke = CreateCylinder(8)
		ScaleMesh spoke, 3, 23, 3
		RotateMesh spoke, 90, 0, 0
		PositionMesh spoke, 0, 0, 52
		RotateMesh spoke, 0, k * 90 + 15, 0
		AddMesh spoke, station
		FreeEntity spoke
	Next
	Return station
End Function

Dim stationx#(TEAMS * STATIONS - 1), stationy#(TEAMS * STATIONS - 1), stationz#(TEAMS * STATIONS - 1), stationent(TEAMS * STATIONS - 1)
stationtemplate = MakeStation()
HideEntity stationtemplate
For t = 0 To TEAMS - 1
	For k = 0 To STATIONS - 1
		n = t * STATIONS + k
		side# = 1 - 2 * t
		stationx(n) = -side * SBRnd(650, 800)
		stationy(n) = SBRnd(-120, 120)
		stationz(n) = (k - 1.5) * 300 + SBRnd(-60, 60)
		stationent(n) = CopyEntity(stationtemplate)
		ShowEntity stationent(n)
		PositionEntity stationent(n), stationx(n), stationy(n), stationz(n)
		TurnEntity stationent(n), SBRnd(-10, 10), SBRnd(0, 360), SBRnd(-10, 10)
		If t = 0 Then EntityColor stationent(n), 120, 160, 255 Else EntityColor stationent(n), 255, 140, 110
		EntityType stationent(n), TYPE_STATION
		EntityPickMode stationent(n), 2
		BenchPhysicsStation stationx(n), stationy(n), stationz(n)
	Next
Next

; ---------------------------------------------------------------------------------------------------------------------------------
; Asteroids: four lumpy shapes, copied and scaled, in two belts around the middle of the battle. They turn on the spot.

Function MakeAsteroid(k)
	rock = CreateSphere(6)
	For s = 1 To CountSurfaces(rock)
		surf = GetSurface(rock, s)
		For v = 0 To CountVertices(surf) - 1
			x# = VertexX(surf, v) : y# = VertexY(surf, v) : z# = VertexZ(surf, v)
			; The same point always moves the same way, so the seams of the sphere stay closed.
			f# = 0.8 + 0.2 * Sin(x * 137 + y * 71 + z * 29 + k * 53) + 0.1 * Cos(x * 41 - z * 97 + k * 11)
			VertexCoords surf, v, x * f, y * f * 0.85, z * f
		Next
	Next
	UpdateNormals rock
	EntityColor rock, 120 + k * 10, 110 + k * 5, 100
	HideEntity rock
	Return rock
End Function

Dim rocktemplate(3)
For k = 0 To 3
	rocktemplate(k) = MakeAsteroid(k)
Next
Dim rockent(asteroids), rockspin#(asteroids)
For i = 0 To asteroids - 1
	; Two belts, both on the line between the fleets: one ring around the middle and a smaller one tilted across it.
	If i Mod 3 = 2 Then
		angle# = SBRnd(0, 360) : radius# = SBRnd(150, 300)
		ax# = Sin(angle) * radius * 0.4 : ay# = Cos(angle) * radius : az# = Sin(angle) * radius
	Else
		angle# = SBRnd(0, 360) : radius# = SBRnd(300, 520)
		ax# = Sin(angle) * radius * 0.6 : ay# = SBRnd(-50, 50) : az# = Cos(angle) * radius
	EndIf
	size# = SBRnd(3, 14)
	If i Mod 50 = 0 Then size = SBRnd(25, 40)
	rockent(i) = CopyEntity(rocktemplate(i Mod 4))
	ShowEntity rockent(i)
	PositionEntity rockent(i), ax, ay, az
	RotateEntity rockent(i), SBRnd(0, 360), SBRnd(0, 360), 0
	ScaleEntity rockent(i), size, size, size
	EntityType rockent(i), TYPE_ASTEROID
	EntityRadius rockent(i), size
	EntityPickMode rockent(i), 1
	rockspin(i) = SBRnd(-0.5, 0.5)
	BenchPhysicsAsteroid ax, ay, az, size
Next

; ---------------------------------------------------------------------------------------------------------------------------------
; Ships. Fighters are a cone with wings, traders a long box with a cylinder, in the colour of their team.

Function MakeFighter(r, g, b)
	ship = CreateCone(8)
	RotateMesh ship, 90, 0, 0
	ScaleMesh ship, 1.2, 0.6, 3
	wings = CreateCube()
	ScaleMesh wings, 3.2, 0.15, 0.8
	PositionMesh wings, 0, 0, -1.2
	AddMesh wings, ship
	FreeEntity wings
	EntityColor ship, r, g, b
	HideEntity ship
	Return ship
End Function

Function MakeTrader(r, g, b)
	ship = CreateCube()
	ScaleMesh ship, 2, 2, 5
	tank = CreateCylinder(10)
	RotateMesh tank, 90, 0, 0
	ScaleMesh tank, 1.4, 4, 1.4
	PositionMesh tank, 0, 2.6, -0.5
	AddMesh tank, ship
	FreeEntity tank
	EntityColor ship, r, g, b
	HideEntity ship
	Return ship
End Function

Dim shiptemplate(TEAMS * 2 - 1)
shiptemplate(0) = MakeFighter(110, 170, 255)
shiptemplate(1) = MakeTrader(150, 190, 230)
shiptemplate(2) = MakeFighter(255, 120, 90)
shiptemplate(3) = MakeTrader(230, 180, 140)

Global boltemplate = CreateSprite()
ScaleSprite boltemplate, 1.6, 1.6
EntityFX boltemplate, 1
EntityBlend boltemplate, 3
HideEntity boltemplate

Global debristemplate = CreateCube()
ScaleMesh debristemplate, 0.8, 0.5, 1.2
EntityColor debristemplate, 150, 140, 130
HideEntity debristemplate

; The state of the ships, by index. kind 0 is a fighter, 1 a trader. target is the index of the ship it fights (-1 none) and
; targetgen the generation of that ship when it was chosen, so a target that died and came back is not followed.
Dim shipent(ships - 1), shipteam(ships - 1), shipkind(ships - 1), shiphp(ships - 1), shipgen(ships - 1)
Dim shiptarget(ships - 1), shiptargetgen(ships - 1), shipcool(ships - 1), shipgoal(ships - 1), shipdead(ships - 1)
Dim shipx#(ships - 1), shipy#(ships - 1), shipz#(ships - 1)
; The neighbour grid: gridhead(cell) is the first ship in a cell, gridnext(ship) the next one in the same cell.
Dim gridhead(GRID * GRID - 1), gridnext(ships - 1), shipcell(ships - 1)
; What the ships want picked this frame: line of sight checks and shots, done together after all ships moved.
Dim losship(ships - 1), shotship(ships - 1)
Global loscount = 0, shotcount = 0

; Where traders go: the stations of their team first, then the planets (a point in orbit on the side of the battle).
Const WAYPOINTS = STATIONS + PLANETS
Dim wpx#(TEAMS - 1, WAYPOINTS - 1), wpy#(TEAMS - 1, WAYPOINTS - 1), wpz#(TEAMS - 1, WAYPOINTS - 1)
For t = 0 To TEAMS - 1
	For k = 0 To STATIONS - 1
		n = t * STATIONS + k
		wpx(t, k) = stationx(n) : wpy(t, k) = stationy(n) + 110 : wpz(t, k) = stationz(n)
	Next
	For p = 0 To PLANETS - 1
		d# = Sqr(planetx(p) * planetx(p) + planety(p) * planety(p) + planetz(p) * planetz(p))
		near# = 1 - (planetr(p) + 80) / d
		wpx(t, STATIONS + p) = planetx(p) * near : wpy(t, STATIONS + p) = planety(p) * near + (t * 2 - 1) * 40 : wpz(t, STATIONS + p) = planetz(p) * near
	Next
Next

; Fighters go round: the front in the middle, a station of the enemy, a station of their own. goal 0 to 2 is that step.
Dim frontx#(3), fronty#(3), frontz#(3)
For k = 0 To 3
	frontx(k) = SBRnd(-80, 80) : fronty(k) = SBRnd(-60, 60) : frontz(k) = (k - 1.5) * 260
Next

Function SpawnShip(i, initial)
	t = shipteam(i)
	home = t * STATIONS + ((i / TEAMS) Mod STATIONS)
	e = CopyEntity(shiptemplate(t * 2 + shipkind(i)))
	ShowEntity e
	; Ships start in a cloud on the side of their home station that faces the enemy.
	side# = 1 - 2 * t
	If initial Then
		x# = stationx(home) + side * SBRnd(110, 260) : y# = stationy(home) + SBRnd(-90, 90) : z# = stationz(home) + SBRnd(-130, 130)
	Else
		x# = stationx(home) + side * SBRnd(110, 140) : y# = stationy(home) + SBRnd(-30, 30) : z# = stationz(home) + SBRnd(-30, 30)
	EndIf
	PositionEntity e, x, y, z
	RotateEntity e, 0, 90 * side, 0
	EntityType e, TYPE_SHIP
	EntityRadius e, 2.5 + shipkind(i) * 2
	EntityPickMode e, 1
	NameEntity e, Str(i)
	ResetEntity e
	shipent(i) = e
	shipx(i) = x : shipy(i) = y : shipz(i) = z
	If shipkind(i) = 1 Then shiphp(i) = 5 Else shiphp(i) = 3
	shipgen(i) = shipgen(i) + 1
	shiptarget(i) = -1
	shipcool(i) = SBRndInt(0, 30)
	shipdead(i) = 0
	If shipkind(i) = 1 Then shipgoal(i) = STATIONS + ((i / (TEAMS * 10)) Mod PLANETS) Else shipgoal(i) = 0
End Function

For i = 0 To ships - 1
	shipteam(i) = i Mod TEAMS
	If (i / TEAMS) Mod 10 = 0 Then shipkind(i) = 1 Else shipkind(i) = 0
	SpawnShip i, True
Next

; Laser bolts and debris are short lived objects in lists, as a game has them.
Type Bolt
	Field ent, life
	Field vx#, vy#, vz#
End Type

Type Debris
	Field ent, life
	Field vx#, vy#, vz#, spin#
End Type

Global debriscount = 0

creation# = (BenchMicros() - creationstart) / 1000.0

; ---------------------------------------------------------------------------------------------------------------------------------
; One frame of the game, in parts, each timed on its own.

Global kills = 0, shots = 0, hits = 0, losdone = 0, losblocked = 0, collided = 0, campicks = 0, campicked = 0, respawns = 0
Global debrismade = 0

Function GridCell(x#, z#)
	cx = Int(Floor((x + GRIDHALF) / CELL))
	cz = Int(Floor((z + GRIDHALF) / CELL))
	If cx < 0 Then cx = 0
	If cx > GRID - 1 Then cx = GRID - 1
	If cz < 0 Then cz = 0
	If cz > GRID - 1 Then cz = GRID - 1
	Return cz * GRID + cx
End Function

; The nearest ship of the other team in the 3 x 3 cells around ship i, or -1.
Function FindTarget(i)
	best = -1
	bestd# = RANGE * RANGE * 2.25
	c = shipcell(i)
	cx = c Mod GRID : cz = c / GRID
	team = shipteam(i)
	x# = shipx(i) : y# = shipy(i) : z# = shipz(i)
	For gz = cz - 1 To cz + 1
		If gz >= 0 And gz < GRID Then
			For gx = cx - 1 To cx + 1
				If gx >= 0 And gx < GRID Then
					j = gridhead(gz * GRID + gx)
					While j >= 0
						If shipteam(j) <> team Then
							dx# = shipx(j) - x : dy# = shipy(j) - y : dz# = shipz(j) - z
							d# = dx * dx + dy * dy + dz * dz
							If d < bestd Then
								bestd = d
								best = j
							EndIf
						EndIf
						j = gridnext(j)
					Wend
				EndIf
			Next
		EndIf
	Next
	Return best
End Function

Function UpdateShips(f)
	; The grid is made again from where the ships are.
	For c = 0 To GRID * GRID - 1
		gridhead(c) = -1
	Next
	For i = 0 To ships - 1
		If shipdead(i) = 0 Then
			c = GridCell(shipx(i), shipz(i))
			shipcell(i) = c
			gridnext(i) = gridhead(c)
			gridhead(c) = i
		EndIf
	Next

	loscount = 0
	shotcount = 0
	For i = 0 To ships - 1
		If shipdead(i) = 0 Then
			e = shipent(i)
			t = shipteam(i)
			x# = shipx(i) : y# = shipy(i) : z# = shipz(i)
			If shipkind(i) = 1 Then
				; A trader flies its route and does not fight.
				g = shipgoal(i)
				gx# = wpx(t, g) : gy# = wpy(t, g) : gz# = wpz(t, g)
				dx# = gx - x : dy# = gy - y : dz# = gz - z
				If dx * dx + dy * dy + dz * dz < 60 * 60 Then shipgoal(i) = (g + 1 + ((i / (TEAMS * 10)) Mod 3)) Mod WAYPOINTS
				speed# = TRADER_SPEED
			Else
				; A fighter looks for the nearest enemy every 4th frame, the ships in turns.
				tg = shiptarget(i)
				If tg >= 0 Then
					If shipdead(tg) <> 0 Or shipgen(tg) <> shiptargetgen(i) Then tg = -1
				EndIf
				If (i + f) Mod 4 = 0 Then
					n = FindTarget(i)
					If n >= 0 Then
						tg = n
						shiptargetgen(i) = shipgen(n)
					EndIf
				EndIf
				shiptarget(i) = tg
				If tg >= 0 Then
					; Aims a little ahead of the target and asks for a line of sight check every 8th frame.
					dx# = shipx(tg) - x : dy# = shipy(tg) - y : dz# = shipz(tg) - z
					If (i + f) Mod 8 = 4 Then
						losship(loscount) = i
						loscount = loscount + 1
					EndIf
				Else
					g = shipgoal(i)
					If g = 0 Then
						k = (i / TEAMS) Mod 4
						gx# = frontx(k) + (i Mod 7) * 8 - 24 : gy# = fronty(k) : gz# = frontz(k) + (i Mod 5) * 8 - 16
					Else
						If g = 1 Then home = (1 - t) * STATIONS + ((i / TEAMS) Mod STATIONS) Else home = t * STATIONS + ((i / TEAMS) Mod STATIONS)
						side# = 1 - 2 * t
						If g = 1 Then side = -side
						gx# = stationx(home) + side * 140 : gy# = stationy(home) + 60 : gz# = stationz(home)
					EndIf
					dx# = gx - x : dy# = gy - y : dz# = gz - z
					If dx * dx + dy * dy + dz * dz < 70 * 70 Then shipgoal(i) = (g + 1) Mod 3
				EndIf
				speed# = FIGHTER_SPEED
			EndIf
			AlignToVector e, dx, dy, dz, 3, 0.08
			MoveEntity e, 0, 0, speed

			If shipcool(i) > 0 Then shipcool(i) = shipcool(i) - 1
			If shipkind(i) = 0 And shiptarget(i) >= 0 And shipcool(i) = 0 Then
				d# = dx * dx + dy * dy + dz * dz
				If d < RANGE * RANGE Then
					TFormVector 0, 0, 1, e, 0
					l# = Sqr(d)
					If l > 0.001 Then
						If (TFormedX() * dx + TFormedY() * dy + TFormedZ() * dz) / l > 0.96 Then
							shotship(shotcount) = i
							shotcount = shotcount + 1
							shipcool(i) = 20 + (i Mod 7)
						EndIf
					EndIf
				EndIf
			EndIf
		EndIf
	Next
End Function

; Line of sight checks and shots, a pick each. A shot starts in front of the ship, so it does not hit the ship itself.
Function DoPicks()
	For k = 0 To loscount - 1
		i = losship(k)
		tg = shiptarget(i)
		If tg >= 0 Then
			losdone = losdone + 1
			If EntityVisible(shipent(i), shipent(tg)) = 0 Then
				losblocked = losblocked + 1
				shiptarget(i) = -1
			EndIf
		EndIf
	Next
	For k = 0 To shotcount - 1
		i = shotship(k)
		e = shipent(i)
		TFormVector 0, 0, 1, e, 0
		fx# = TFormedX() : fy# = TFormedY() : fz# = TFormedZ()
		x# = EntityX(e, True) + fx * 4 : y# = EntityY(e, True) + fy * 4 : z# = EntityZ(e, True) + fz * 4
		shots = shots + 1
		hit = LinePick(x, y, z, fx * RANGE, fy * RANGE, fz * RANGE)
		length# = RANGE
		If hit <> 0 Then
			length = Sqr((PickedX() - x) * (PickedX() - x) + (PickedY() - y) * (PickedY() - y) + (PickedZ() - z) * (PickedZ() - z))
			name$ = EntityName$(hit)
			If name$ <> "" Then
				j = Int(name$)
				If j >= 0 And j < ships Then
					If shipent(j) = hit And shipteam(j) <> shipteam(i) And shipdead(j) = 0 Then
						hits = hits + 1
						shiphp(j) = shiphp(j) - 1
					EndIf
				EndIf
			EndIf
		EndIf
		b.Bolt = New Bolt
		b\ent = CopyEntity(boltemplate)
		ShowEntity b\ent
		If shipteam(i) = 0 Then EntityColor b\ent, 120, 200, 255 Else EntityColor b\ent, 255, 160, 80
		PositionEntity b\ent, x, y, z
		b\life = BOLT_LIFE
		b\vx = fx * length / BOLT_LIFE : b\vy = fy * length / BOLT_LIFE : b\vz = fz * length / BOLT_LIFE
	Next
	; What the camera aims at, as a game shows it under the cross hair.
	campicks = campicks + 1
	If CameraPick(camera, GraphicsWidth() / 2, GraphicsHeight() / 2) <> 0 Then campicked = campicked + 1
End Function

Function SpawnDebris(x#, y#, z#)
	For k = 0 To 3
		If debriscap > 0 Then
			If debriscount >= debriscap Then
				old.Debris = First Debris
				FreeEntity old\ent
				Delete old
				debriscount = debriscount - 1
			EndIf
			d.Debris = New Debris
			d\vx = SBRnd(-1.5, 1.5) : d\vy = SBRnd(-1.5, 1.5) : d\vz = SBRnd(-1.5, 1.5)
			d\spin = SBRnd(-8, 8)
			d\life = DEBRIS_LIFE
			d\ent = BenchDebrisCreate(debristemplate, x + d\vx, y + d\vy, z + d\vz, d\vx, d\vy, d\vz)
			debriscount = debriscount + 1
			debrismade = debrismade + 1
		EndIf
	Next
End Function

; Bolts fly, ships that were hit too often die and break apart, dead ships come back at home, debris drift and go.
Function UpdateEffects()
	For b.Bolt = Each Bolt
		b\life = b\life - 1
		If b\life <= 0 Then
			FreeEntity b\ent
			Delete b
		Else
			TranslateEntity b\ent, b\vx, b\vy, b\vz
		EndIf
	Next
	For i = 0 To ships - 1
		If shipdead(i) = 0 Then
			If shiphp(i) <= 0 Then
				kills = kills + 1
				SpawnDebris shipx(i), shipy(i), shipz(i)
				FreeEntity shipent(i)
				shipent(i) = 0
				shipdead(i) = RESPAWN
			EndIf
		Else
			shipdead(i) = shipdead(i) - 1
			If shipdead(i) = 0 Then
				respawns = respawns + 1
				SpawnShip i, False
			EndIf
		EndIf
	Next
	For d.Debris = Each Debris
		d\life = d\life - 1
		If d\life <= 0 Then
			FreeEntity d\ent
			Delete d
			debriscount = debriscount - 1
		Else
			BenchDebrisMove d\ent, d\vx, d\vy, d\vz, d\spin
		EndIf
	Next
End Function

; After UpdateWorld: where the ships ended up, and how many touched something.
Function AfterCollisions()
	For i = 0 To ships - 1
		If shipdead(i) = 0 Then
			e = shipent(i)
			shipx(i) = EntityX(e, True) : shipy(i) = EntityY(e, True) : shipz(i) = EntityZ(e, True)
			If CountCollisions(e) > 0 Then collided = collided + 1
		EndIf
	Next
End Function

Function TurnWorld(asteroids)
	For n = 0 To TEAMS * STATIONS - 1
		TurnEntity stationent(n), 0, 0.15, 0
	Next
	For i = 0 To asteroids - 1
		TurnEntity rockent(i), rockspin(i), rockspin(i) * 0.5, 0
	Next
End Function

Global camtarget = CreatePivot()
Global camx# = 0, camy# = 0, camz# = 0
Global camship = -1

; The camera rides behind a trader, then behind a fighter, then circles a station. When the ship it rides behind dies, it takes
; the next ship of the same kind that is alive.
Function MoveCamera(f)
	phase = f Mod CAMERA_LAP
	If phase < 1000 Then
		kind = 1
	ElseIf phase < 2000 Then
		kind = 0
	Else
		kind = -1
	EndIf
	If kind >= 0 Then
		switch = False
		If camship < 0 Then
			switch = True
		ElseIf shipdead(camship) <> 0 Or shipkind(camship) <> kind Then
			switch = True
		EndIf
		If switch Then
			start = camship + 1
			camship = -1
			For k = 0 To ships - 1
				i = (start + k) Mod ships
				If shipdead(i) = 0 And shipkind(i) = kind And shipteam(i) = 0 Then
					camship = i
					Exit
				EndIf
			Next
		EndIf
		If camship >= 0 Then
			; Further back from a trader, which is bigger.
			If kind = 1 Then TFormPoint 0, 16, -70, shipent(camship), 0 Else TFormPoint 0, 9, -35, shipent(camship), 0
			wx# = TFormedX() : wy# = TFormedY() : wz# = TFormedZ()
			If switch Then
				camx = wx : camy = wy : camz = wz
			Else
				camx = camx + (wx - camx) * 0.15 : camy = camy + (wy - camy) * 0.15 : camz = camz + (wz - camz) * 0.15
			EndIf
			PositionEntity camtarget, shipx(camship), shipy(camship), shipz(camship)
		EndIf
	Else
		a# = (phase - 2000) * 0.36
		camx = stationx(0) + Sin(a) * 260 : camy = stationy(0) + 90 : camz = stationz(0) + Cos(a) * 260
		PositionEntity camtarget, stationx(0), stationy(0), stationz(0)
		camship = -1
	EndIf
	PositionEntity camera, camx, camy, camz
	PointEntity camera, camtarget
End Function

; ---------------------------------------------------------------------------------------------------------------------------------

Dim times#(frames - 1)
drawsum# = 0 : trissum# = 0 : total_ms# = 0
aitotal# = 0 : picktotal# = 0 : effecttotal# = 0 : collidetotal# = 0 : physicstotal# = 0 : rendertotal# = 0
boltsum# = 0 : debrissum# = 0 : alivesum# = 0

For f = 0 To warmup + frames - 1
	If f = warmup Then
		; Only the timed frames are counted.
		kills = 0 : shots = 0 : hits = 0 : losdone = 0 : losblocked = 0 : collided = 0 : campicks = 0 : campicked = 0
		respawns = 0 : debrismade = 0
	EndIf
	t0 = BenchMicros()
	UpdateShips f
	t1 = BenchMicros()
	MoveCamera f
	DoPicks
	t2 = BenchMicros()
	UpdateEffects
	TurnWorld asteroids
	t3 = BenchMicros()
	UpdateWorld
	AfterCollisions
	t4 = BenchMicros()
	BenchPhysicsUpdate
	t5 = BenchMicros()
	RenderWorld
	BenchFlip()
	t6 = BenchMicros()
	If f >= warmup Then
		elapsed# = t6 - t0
		times(f - warmup) = elapsed
		total_ms = total_ms + elapsed
		aitotal = aitotal + (t1 - t0)
		picktotal = picktotal + (t2 - t1)
		effecttotal = effecttotal + (t3 - t2)
		collidetotal = collidetotal + (t4 - t3)
		physicstotal = physicstotal + (t5 - t4)
		rendertotal = rendertotal + (t6 - t5)
		drawsum = drawsum + BenchDraws()
		trissum = trissum + TrisRendered()
		bolts = 0
		For b.Bolt = Each Bolt
			bolts = bolts + 1
		Next
		boltsum = boltsum + bolts
		debrissum = debrissum + debriscount
		alive = 0
		For i = 0 To ships - 1
			If shipdead(i) = 0 Then alive = alive + 1
		Next
		alivesum = alivesum + alive
	EndIf
Next

shot$ = GetEnv$("BENCH_SHOT")
If shot$ <> "" Then SaveBuffer BackBuffer(), shot$

; Sorting the times gives the median and the 95th percentile.
Dim srt#(frames - 1)
For i = 0 To frames - 1
	srt(i) = times(i)
Next
gap = frames / 2
While gap > 0
	For i = gap To frames - 1
		v# = srt(i)
		j = i
		; And does not skip the second test, so the index is checked first.
		While j >= gap
			If srt(j - gap) <= v Then Exit
			srt(j) = srt(j - gap)
			j = j - gap
		Wend
		srt(j) = v
	Next
	gap = gap / 2
Wend
p95 = Int(frames * 0.95) : If p95 > frames - 1 Then p95 = frames - 1

timesfile$ = GetEnv$("BENCH_FRAMETIMES")
If timesfile$ <> "" Then
	file = WriteFile(timesfile$)
	If file <> 0 Then
		For i = 0 To frames - 1
			WriteLine file, Int(times(i))
		Next
		CloseFile file
	EndIf
EndIf

avg# = total_ms / frames / 1000
result$ = "RESULT ships=" + ships + " asteroids=" + asteroids + " debriscap=" + debriscap + " physics=" + BenchPhysics() + " frames=" + frames + " seed=" + seed
result$ = result$ + " width=" + GraphicsWidth() + " height=" + GraphicsHeight() + " create_ms=" + creation
result$ = result$ + " ai_ms=" + (aitotal / frames / 1000) + " pick_ms=" + (picktotal / frames / 1000) + " effects_ms=" + (effecttotal / frames / 1000)
result$ = result$ + " collide_ms=" + (collidetotal / frames / 1000) + " physics_ms=" + (physicstotal / frames / 1000) + " render_ms=" + (rendertotal / frames / 1000)
result$ = result$ + " ms_avg=" + avg + " ms_min=" + (srt(0) / 1000) + " ms_median=" + (srt(frames / 2) / 1000) + " ms_p95=" + (srt(p95) / 1000) + " ms_max=" + (srt(frames - 1) / 1000) + " fps=" + (1000 / avg)
result$ = result$ + " tris=" + Int(trissum / frames) + " draws=" + Int(drawsum / frames)
result$ = result$ + " alive=" + Int(alivesum / frames) + " bolts=" + Int(boltsum / frames) + " debris=" + Int(debrissum / frames)
result$ = result$ + " kills=" + kills + " respawns=" + respawns + " shots=" + shots + " hits=" + hits + " los=" + losdone + " los_blocked=" + losblocked
result$ = result$ + " collided=" + collided + " camera_picks=" + campicks + " camera_hits=" + campicked + " debris_made=" + debrismade
DebugLog result$
resultfile$ = GetEnv$("BENCH_RESULT")
If resultfile$ <> "" Then
	file = WriteFile(resultfile$)
	If file <> 0 Then
		WriteLine file, result$
		CloseFile file
	EndIf
EndIf
End
