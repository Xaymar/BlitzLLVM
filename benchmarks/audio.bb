; Loads sounds from files and then plays many of them at the same time for a while. It prints how long loading took (decoding and
; converting to the format of the audio device), and benchmarks/history.py reads the CPU time of the process, which is what mixing
; the channels cost. It uses commands that the original Blitz3D has too.
;
; Environment variables:
;   BENCH_SOUNDS    folder with the .wav files to load (all of them)
;   BENCH_REPEAT    how many times the files are loaded (default 4)
;   BENCH_CHANNELS  how many sounds play at the same time (default 32)
;   BENCH_PLAY_MS   how long they play (default 3000)
;   BENCH_RESULT    file to write the RESULT line to

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

folder$ = Env$("BENCH_SOUNDS", ".")
reps = Int(Env$("BENCH_REPEAT", 4))
channels = Int(Env$("BENCH_CHANNELS", 32))
playms = Int(Env$("BENCH_PLAY_MS", 3000))

; The names come from index.txt, because the original has no easy way to list a folder in both compilers' file systems.
index = ReadFile(folder$ + "/index.txt")
If index = 0 Then RuntimeError "No index.txt in " + folder$
Dim names$(255)
count = 0
While Not Eof(index) And count < 256
	names$(count) = ReadLine$(index)
	count = count + 1
Wend
CloseFile index

start = MilliSecs()
loaded = 0
Dim sounds(255)
For r = 1 To reps
	For i = 0 To count - 1
		sound = LoadSound(folder$ + "/" + names$(i))
		If sound <> 0
			sounds(i) = sound
			loaded = loaded + 1
		EndIf
	Next
Next
loadms = MilliSecs() - start

started = 0
For c = 0 To channels - 1
	If sounds(c Mod count) <> 0
		LoopSound sounds(c Mod count)
		PlaySound sounds(c Mod count)
		started = started + 1
	EndIf
Next
Delay playms

result$ = "RESULT loaded=" + loaded + " started=" + started + " load_ms=" + loadms + " play_ms=" + playms
file = WriteFile(Env$("BENCH_RESULT", "audio_result.txt"))
If file <> 0
	WriteLine file, result$
	CloseFile file
EndIf
Print result$
