; A walk through a dungeon: rooms joined by corridors, walls and pillars everywhere, a torch in each corner and campfires in some
; rooms, whose flames and smoke are see-through sprites. The walls hide most of the dungeon from the camera at any moment, so this
; is the benchmark for what culling and early-Z save, in particular early-Z for see-through sprites: the camera walks a wide path
; and sways to both sides, so that the walls beside the doors are in the view, and the sprites of the next room behind them are in the
; view as well, but hidden. The sources of fire are point lights, but a graphics card has 8 lights and the dungeon has hundreds, so
; the 8 nearest to the camera are lit and the others are hidden. The camera turns to a campfire when it comes near one.
; The walk is the same on every run.
; Needs a window and a GPU: python3 benchmarks/dungeon.py builds and runs it, under xvfb and llvmpipe if there is no display.
;
; Environment variables:
;   BENCH_ROOMS      how many rooms the dungeon has (default 16, in a snake of rows, each joined to the next by a corridor)
;   BENCH_TORCHES    torches in each room, 1 to 8 (default 4, one in each corner first)
;   BENCH_PARTICLES  flame and smoke sprites of each torch (default 12: half flame, half smoke)
;   BENCH_PROPS      barrels, crates and balls in each room, loose entities (default 6)
;   BENCH_FRAMES     how many frames are timed (default 600)
;   BENCH_WARMUP     frames that are rendered but not timed, they make the GPU buffers (default 5)
;   BENCH_SEED       seed of the random offsets (default 1)
;   BENCH_W, BENCH_H size of the window (default 640 x 360)
;   BENCH_CAMPFIRES  chance in percent that a room has a campfire (default 25, and at least one room has)
;   BENCH_SPRITESCALE  how many times bigger the flames and smoke are drawn (default 1; with 6 every sprite covers 36 times the pixels, so
;                    the overdraw is what the GPU spends its time on, and what early-Z saves)
;   BENCH_COVERAGE   1 also counts the sprites that are in the view of the camera, after the frame is timed (default 0)
;   BENCH_STATIC     1 places the particles once (frame 0), so only the camera moves (default 0: the fire burns)
;   BENCH_SHOT       file to save the last frame to (optional)
;   BENCH_RESULT     file to write the RESULT line to (optional, it is also in the debug log)
;   BENCH_FRAMETIMES file to write the time of every frame to, in microseconds, one per line (optional)
;
; The camera walks 0.2 units per frame, about 150 frames for a room and the corridor to the next. At the last room it
; starts again at the first. Where every particle is depends only on the frame number, so the pictures are the same on every
; run and every machine.

; Runs with BlitzLLVM and with the original Blitz3D, so that their speeds can be compared. What the original does not have (a
; microsecond timer, the draw counters) is in dungeon_llvm.bi or dungeon_original.bi, python3 benchmarks/dungeon.py copies
; the right one next to this file as dungeon_counters.bi.
Include "dungeon_counters.bi"

Const PITCH# = 24.0
Const HALF# = 7.0
Const WALLT# = 0.5
Const WALLH# = 6.0
Const DOORW# = 2.0
Const DOORH# = 4.0
Const EYE# = 2.4
Const SPEED# = 0.2
Const CELL# = 2.0
Const TILE# = 3.0

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

; The random numbers come from this generator and not from Rnd, because Rnd gives different numbers in BlitzLLVM and in the
; original Blitz3D, and then the two would not draw the same scene. It is the Park-Miller generator, with Schrage's way of
; multiplying without leaving 31 bits, so it gives the same numbers in both.
Global BenchState = 1

Function BenchSeedRnd(seed)
	BenchState = (seed Mod 2147483646) + 1
	If BenchState < 1 Then BenchState = BenchState + 2147483646
End Function

Function BenchRnd#(low#, high#)
	BenchState = 16807 * (BenchState Mod 127773) - 2836 * (BenchState / 127773)
	If BenchState <= 0 Then BenchState = BenchState + 2147483647
	Return low + (high - low) * (BenchState / 2147483647.0)
End Function

Graphics3D Int(Env$("BENCH_W", 640)), Int(Env$("BENCH_H", 360)), 32, 2
SetBuffer BackBuffer()

Global rooms = Int(Env$("BENCH_ROOMS", 16))
torches = Int(Env$("BENCH_TORCHES", 4))
particles = Int(Env$("BENCH_PARTICLES", 12))
props = Int(Env$("BENCH_PROPS", 6))
frames = Int(Env$("BENCH_FRAMES", 600))
warmup = Int(Env$("BENCH_WARMUP", 5))
seed = Int(Env$("BENCH_SEED", 1))
still = Int(Env$("BENCH_STATIC", 0))
campfires = Int(Env$("BENCH_CAMPFIRES", 25))
coverage = Int(Env$("BENCH_COVERAGE", 0))
spritescale# = Float(Env$("BENCH_SPRITESCALE", 1))
If spritescale < 0.1 Then spritescale = 0.1
If rooms < 2 Then rooms = 2
If torches < 1 Then torches = 1
If torches > 8 Then torches = 8
If particles < 2 Then particles = 2
If props < 0 Then props = 0
If frames < 1 Then frames = 1

BenchSeedRnd seed

; The rooms are laid out in rows, as a snake: the first row goes right, the second row goes left, and so on. Room i and room
; i + 1 are always next to each other, so a corridor joins them.
cols = 1
While cols * cols < rooms
	cols = cols + 1
Wend
Dim rcx#(rooms - 1)
Dim rcz#(rooms - 1)
For i = 0 To rooms - 1
	row = i / cols
	col = i Mod cols
	If (row Mod 2) = 1 Then col = cols - 1 - col
	rcx(i) = col * PITCH
	rcz(i) = row * PITCH
Next
Global npts = rooms * 3
Global pathlength# = 0
Dim wpx#(npts - 1)
Dim wpz#(npts - 1)
Dim wpcum#(npts - 1)
Dim fireon(rooms - 1)
Dim firex#(rooms - 1)
Dim firez#(rooms - 1)

; One face of a box, as a grid of cells of about 2 x 2 units, so that the lights (which work on the vertices) can shade it and
; so that the walls have triangles to draw. The face goes from o along u (lu long) and along v (lv long) and shows to
; (nx, ny, nz), the order of the corners follows from that.
Function AddFace(s, ox#, oy#, oz#, ux#, uy#, uz#, vx#, vy#, vz#, lu#, lv#, nx#, ny#, nz#)
	nu = Int(Ceil(lu / CELL))
	nv = Int(Ceil(lv / CELL))
	If nu < 1 Then nu = 1
	If nv < 1 Then nv = 1
	cx# = uy * vz - uz * vy
	cy# = uz * vx - ux * vz
	cz# = ux * vy - uy * vx
	base = CountVertices(s)
	For j = 0 To nv
		For i = 0 To nu
			a# = lu * i / nu
			b# = lv * j / nv
			AddVertex s, ox + ux * a + vx * b, oy + uy * a + vy * b, oz + uz * a + vz * b, a / TILE, b / TILE
		Next
	Next
	For j = 0 To nv - 1
		For i = 0 To nu - 1
			v00 = base + j * (nu + 1) + i
			v10 = v00 + 1
			v01 = v00 + nu + 1
			v11 = v01 + 1
			; The corners are in the other order for faces that look up, which is what comes out of the cross product for them.
			If (cx * nx + cy * ny + cz * nz > 0) = (ny <= 0) Then
				AddTriangle s, v00, v01, v10
				AddTriangle s, v10, v01, v11
			Else
				AddTriangle s, v00, v10, v01
				AddTriangle s, v10, v11, v01
			EndIf
		Next
	Next
End Function

; A box with six faces, mask says which ones to make: 1 +x, 2 -x, 4 +y (top), 8 -y (bottom), 16 +z, 32 -z.
Function AddBox(s, x0#, y0#, z0#, x1#, y1#, z1#, mask)
	If (mask And 1) <> 0 Then AddFace s, x1, y0, z0, 0, 0, 1, 0, 1, 0, z1 - z0, y1 - y0, 1, 0, 0
	If (mask And 2) <> 0 Then AddFace s, x0, y0, z0, 0, 0, 1, 0, 1, 0, z1 - z0, y1 - y0, -1, 0, 0
	If (mask And 4) <> 0 Then AddFace s, x0, y1, z0, 1, 0, 0, 0, 0, 1, x1 - x0, z1 - z0, 0, 1, 0
	If (mask And 8) <> 0 Then AddFace s, x0, y0, z0, 1, 0, 0, 0, 0, 1, x1 - x0, z1 - z0, 0, -1, 0
	If (mask And 16) <> 0 Then AddFace s, x0, y0, z1, 1, 0, 0, 0, 1, 0, x1 - x0, y1 - y0, 0, 0, 1
	If (mask And 32) <> 0 Then AddFace s, x0, y0, z0, 1, 0, 0, 0, 1, 0, x1 - x0, y1 - y0, 0, 0, -1
End Function

; A box on one side of the room (0 +x, 1 -x, 2 +z, 3 -z), from a0 to a1 away from the middle of the room and from l0 to l1
; sideways, so that walls and corridors are made the same way on all four sides.
Function SideBox(s, side, a0#, a1#, l0#, l1#, y0#, y1#, mask)
	Select side
		Case 0
			AddBox s, a0, y0, l0, a1, y1, l1, mask
		Case 1
			AddBox s, -a1, y0, l0, -a0, y1, l1, mask
		Case 2
			AddBox s, l0, y0, a0, l1, y1, a1, mask
		Default
			AddBox s, l0, y0, -a1, l1, y1, -a0, mask
	End Select
End Function

; Which side of a room the neighbor is on.
Function SideOf(dx#, dz#)
	If dx > 0.5 Then Return 0
	If dx < -0.5 Then Return 1
	If dz > 0.5 Then Return 2
	Return 3
End Function

; The torches of a room: corners first, then four more along the walls, away from the doors.
Function TorchX#(k)
	Select k
		Case 0
			Return 6.3
		Case 1
			Return -6.3
		Case 2
			Return 6.3
		Case 3
			Return -6.3
		Case 4
			Return 4.2
		Case 5
			Return -4.2
		Case 6
			Return 6.6
		Default
			Return -6.6
	End Select
End Function

Function TorchZ#(k)
	Select k
		Case 0
			Return 6.3
		Case 1
			Return 6.3
		Case 2
			Return -6.3
		Case 3
			Return -6.3
		Case 4
			Return 6.6
		Case 5
			Return -6.6
		Case 6
			Return -4.2
		Default
			Return 4.2
	End Select
End Function

; A room with the corridor to the next room: floor, ceiling, four walls (a doorway to the previous and the next room), four
; pillars and a bracket for every torch. All of it is one mesh with the position of the room, so a room is hidden or drawn whole.
Function MakeRoom(index, rooms, torches)
	m = CreateMesh()
	s = CreateSurface(m)
	hasnext = (index < rooms - 1)
	hasprev = (index > 0)
	nextside = -1
	prevside = -1
	If hasnext Then nextside = SideOf(rcx(index + 1) - rcx(index), rcz(index + 1) - rcz(index))
	If hasprev Then prevside = SideOf(rcx(index - 1) - rcx(index), rcz(index - 1) - rcz(index))

	AddBox s, -HALF - WALLT, -0.5, -HALF - WALLT, HALF + WALLT, 0, HALF + WALLT, 63 - 8
	AddBox s, -HALF - WALLT, WALLH, -HALF - WALLT, HALF + WALLT, WALLH + 0.5, HALF + WALLT, 63 - 4
	For side = 0 To 3
		If side = nextside Or side = prevside Then
			SideBox s, side, HALF, HALF + WALLT, -HALF - WALLT, -DOORW, 0, WALLH, 63
			SideBox s, side, HALF, HALF + WALLT, DOORW, HALF + WALLT, 0, WALLH, 63
			SideBox s, side, HALF, HALF + WALLT, -DOORW, DOORW, DOORH, WALLH, 63
		Else
			SideBox s, side, HALF, HALF + WALLT, -HALF - WALLT, HALF + WALLT, 0, WALLH, 63
		EndIf
	Next
	If hasnext Then
		a0# = HALF + WALLT
		a1# = PITCH - HALF - WALLT
		SideBox s, nextside, a0, a1, -DOORW - WALLT, DOORW + WALLT, -0.5, 0, 63 - 8
		SideBox s, nextside, a0, a1, -DOORW - WALLT, DOORW + WALLT, DOORH, DOORH + 0.5, 63 - 4
		SideBox s, nextside, a0, a1, -DOORW - WALLT, -DOORW, 0, DOORH, 63 - 8
		SideBox s, nextside, a0, a1, DOORW, DOORW + WALLT, 0, DOORH, 63 - 8
	EndIf
	For sx = -1 To 1 Step 2
		For sz = -1 To 1 Step 2
			AddBox s, sx * 3.5 - 0.6, 0, sz * 3.5 - 0.6, sx * 3.5 + 0.6, WALLH, sz * 3.5 + 0.6, 63 - 12
		Next
	Next
	For k = 0 To torches - 1
		AddBox s, TorchX(k) - 0.15, 2.0, TorchZ(k) - 0.15, TorchX(k) + 0.15, 2.7, TorchZ(k) + 0.15, 63 - 8
	Next
	; A campfire: two logs across each other in a ring of four stones.
	If fireon(index) = 1 Then
		fx# = firex(index)
		fz# = firez(index)
		AddBox s, fx - 0.6, 0, fz - 0.1, fx + 0.6, 0.25, fz + 0.1, 63 - 8
		AddBox s, fx - 0.1, 0.02, fz - 0.6, fx + 0.1, 0.27, fz + 0.6, 63 - 8
		For sx = -1 To 1 Step 2
			For sz = -1 To 1 Step 2
				AddBox s, fx + sx * 0.8 - 0.15, 0, fz + sz * 0.8 - 0.15, fx + sx * 0.8 + 0.15, 0.3, fz + sz * 0.8 + 0.15, 63 - 8
			Next
		Next
	EndIf
	UpdateNormals m
	Return m
End Function

; Bricks: rows of 16 pixels, each row shifted by half a brick, a different shade for every brick.
Function MakeBricks()
	t = CreateTexture(64, 64, 1 + 8 + 4096)
	SetBuffer TextureBuffer(t)
	LockBuffer TextureBuffer(t)
	For y = 0 To 63
		For x = 0 To 63
			row = y / 16
			xs = x + (row Mod 2) * 16
			brick = xs / 32
			If (y Mod 16) < 2 Or (xs Mod 32) < 2 Then
				c = 70
				r = c : g = c : b = c + 6
			Else
				c = 105 + ((brick * 7349 + row * 1013) Mod 41)
				r = c + 20 : g = c : b = c - 20
			EndIf
			WritePixelFast x, y, $FF000000 Or (r Shl 16) Or (g Shl 8) Or b, TextureBuffer(t)
		Next
	Next
	UnlockBuffer TextureBuffer(t)
	SetBuffer BackBuffer()
	Return t
End Function

; A soft round puff: opaque white in the middle, see-through at the edge.
Function MakePuff()
	t = CreateTexture(32, 32, 3 + 4096)
	SetBuffer TextureBuffer(t)
	LockBuffer TextureBuffer(t)
	For y = 0 To 31
		For x = 0 To 31
			dx# = (x - 15.5) / 15.5
			dy# = (y - 15.5) / 15.5
			r# = Sqr(dx * dx + dy * dy)
			a# = 1 - r
			If a < 0 Then a = 0
			a = a * a * (3 - 2 * a)
			WritePixelFast x, y, (Int(a * 255) Shl 24) Or $FFFFFF, TextureBuffer(t)
		Next
	Next
	UnlockBuffer TextureBuffer(t)
	SetBuffer BackBuffer()
	Return t
End Function

; How far a point is from the line between two points.
Function SegDist#(x#, z#, ax#, az#, bx#, bz#)
	dx# = bx - ax
	dz# = bz - az
	u# = ((x - ax) * dx + (z - az) * dz) / (dx * dx + dz * dz)
	If u < 0 Then u = 0
	If u > 1 Then u = 1
	qx# = ax + dx * u - x
	qz# = az + dz * u - z
	Return Sqr(qx * qx + qz * qz)
End Function

; Props stay 2 units away from the walk through the room (the camera should not be inside a barrel) and from the campfire.
Function PropFree(room, x#, z#)
	If SegDist(x, z, wpx(room * 3), wpz(room * 3), wpx(room * 3 + 1), wpz(room * 3 + 1)) < 2 Then Return 0
	If SegDist(x, z, wpx(room * 3 + 1), wpz(room * 3 + 1), wpx(room * 3 + 2), wpz(room * 3 + 2)) < 2 Then Return 0
	If fireon(room) = 1 Then
		If SegDist(x, z, rcx(room) + firex(room), rcz(room) + firez(room), rcx(room) + firex(room), rcz(room) + firez(room) + 0.01) < 2 Then Return 0
	EndIf
	Return 1
End Function

; The place on the walk after d units. The walk is a line through points, set up below: for every room the door it comes in by,
; a point out to the side (a wide curve, so that the doors and the next room are not straight ahead, and the walls of the room
; hide the next room), and the door it leaves by. It starts again when it is at the last room.
Function PathAt(d#, axis)
	d = d - Floor(d / pathlength) * pathlength
	k = 0
	; And does not skip the second test, so the index is checked first.
	While k < npts - 2
		If wpcum(k + 1) > d Then Exit
		k = k + 1
	Wend
	t# = (d - wpcum(k)) / (wpcum(k + 1) - wpcum(k))
	If t > 1 Then t = 1
	If axis = 0 Then Return wpx(k) + (wpx(k + 1) - wpx(k)) * t
	Return wpz(k) + (wpz(k + 1) - wpz(k)) * t
End Function

Function PathX#(d#)
	Return PathAt(d, 0)
End Function

Function PathZ#(d#)
	Return PathAt(d, 1)
End Function

Function Smooth#(t#)
	If t < 0 Then t = 0
	If t > 1 Then t = 1
	Return t * t * (3 - 2 * t)
End Function

; The doors and the curve of every room, and where the campfire is if it has one. Coordinates are from the middle of the room.
; The walk comes in by the door to the previous room and leaves by the door to the next one (the first room is entered, and the
; last one left, on the side opposite to the other door). With the doors opposite each other the walk swings 4.5 units out to the
; side, to the left in one room and to the right in the next; with a corner between them it cuts the corner.
For i = 0 To rooms - 1
	If i < rooms - 1 Then
		nx# = (rcx(i + 1) - rcx(i)) / PITCH
		nz# = (rcz(i + 1) - rcz(i)) / PITCH
	EndIf
	If i > 0 Then
		px# = (rcx(i - 1) - rcx(i)) / PITCH
		pz# = (rcz(i - 1) - rcz(i)) / PITCH
	EndIf
	If i = 0 Then
		px = -nx
		pz = -nz
	EndIf
	If i = rooms - 1 Then
		nx = -px
		nz = -pz
	EndIf
	; e is the door it comes in by, x the door it leaves by.
	ex# = px * (HALF - 0.5)
	ez# = pz * (HALF - 0.5)
	xx# = nx * (HALF - 0.5)
	xz# = nz * (HALF - 0.5)
	mx# = (ex + xx) / 2
	mz# = (ez + xz) / 2
	wx# = 0
	wz# = 0
	If Abs(mx) + Abs(mz) < 0.1 Then
		; Straight through: out to the side, and the fire on the other side.
		side# = 1
		If (i Mod 2) = 1 Then side = -1
		wx = -pz * side * 4.5
		wz = px * side * 4.5
		firex(i) = -wx * 0.4
		firez(i) = -wz * 0.4
	Else
		; A corner: the fire is in the opposite corner.
		firex(i) = -mx * 0.8
		firez(i) = -mz * 0.8
	EndIf
	wpx(i * 3) = rcx(i) + ex
	wpz(i * 3) = rcz(i) + ez
	wpx(i * 3 + 1) = rcx(i) + wx
	wpz(i * 3 + 1) = rcz(i) + wz
	wpx(i * 3 + 2) = rcx(i) + xx
	wpz(i * 3 + 2) = rcz(i) + xz
Next
wpcum(0) = 0
For k = 1 To npts - 1
	wpcum(k) = wpcum(k - 1) + Sqr((wpx(k) - wpx(k - 1)) * (wpx(k) - wpx(k - 1)) + (wpz(k) - wpz(k - 1)) * (wpz(k) - wpz(k - 1)))
Next
pathlength = wpcum(npts - 1)

; Which rooms have a campfire: every room with a chance of BENCH_CAMPFIRES percent, and always at least one.
nfire = 0
For i = 0 To rooms - 1
	If BenchRnd(0, 100) < campfires Then
		fireon(i) = 1
		nfire = nfire + 1
	EndIf
Next
If nfire = 0 And campfires > 0 Then
	fireon(1) = 1
	nfire = 1
EndIf

camera = CreateCamera()
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 150
AmbientLight 28, 28, 32

bricks = MakeBricks()
puff = MakePuff()

; Props: a barrel, a crate and a ball, copied for the rooms.
Dim proptemplates(2)
proptemplates(0) = CreateCylinder(8)
proptemplates(1) = CreateCube()
proptemplates(2) = CreateSphere(8)
EntityColor proptemplates(0), 150, 100, 60
EntityColor proptemplates(1), 170, 130, 80
EntityColor proptemplates(2), 120, 120, 140
For k = 0 To 2
	HideEntity proptemplates(k)
Next

; Flame: bright, added to what is behind it. Smoke: dark grey, blended.
flametemplate = CreateSprite()
EntityTexture flametemplate, puff
EntityBlend flametemplate, 3
EntityColor flametemplate, 255, 140, 40
EntityFX flametemplate, 1
smoketemplate = CreateSprite()
EntityTexture smoketemplate, puff
EntityColor smoketemplate, 70, 65, 60
EntityFX smoketemplate, 1
HideEntity flametemplate
HideEntity smoketemplate

; The sources of fire: a torch in a room is 0 .. rooms * torches - 1, the campfires come after them. A campfire has 3 times as many
; sprites, which are twice as big, and it burns on the floor and not on the wall.
total = rooms * torches
nsources = total + nfire
Dim roomentity(rooms - 1)
Dim sourcex#(nsources - 1)
Dim sourcez#(nsources - 1)
Dim sourcelight(nsources - 1)
Dim lit(nsources - 1)
Dim want(nsources - 1)
Dim flickerphase#(nsources - 1)
Dim pstart(nsources)
Dim pcount(nsources - 1)
Dim sscale#(nsources - 1)
Dim flamey#(nsources - 1)
Dim smokey#(nsources - 1)
Dim flamerise#(nsources - 1)
Dim smokerise#(nsources - 1)
nparticles = 0
For t = 0 To nsources - 1
	pstart(t) = nparticles
	If t < total Then
		pcount(t) = particles
		sscale(t) = 1
		flamey(t) = 2.8
		smokey(t) = 3.0
		flamerise(t) = 0.7
		smokerise(t) = 2.7
	Else
		pcount(t) = particles * 3
		sscale(t) = 2.2
		flamey(t) = 0.4
		smokey(t) = 0.9
		flamerise(t) = 1.6
		smokerise(t) = 4.5
	EndIf
	nparticles = nparticles + pcount(t)
Next
pstart(nsources) = nparticles

; The original Blitz3D crashes with more sprites than it has room for.
If nparticles > BenchMaxSprites() Then
	result$ = "ERROR sprites=" + nparticles + " max=" + BenchMaxSprites()
	DebugLog result$
	resultfile$ = GetEnv$("BENCH_RESULT")
	If resultfile$ <> "" Then
		file = WriteFile(resultfile$)
		If file <> 0 Then
			WriteLine file, result$
			CloseFile file
		EndIf
	EndIf
	End
EndIf

Dim spr(nparticles - 1)
Dim phase#(nparticles - 1)
Dim ox#(nparticles - 1)
Dim oz#(nparticles - 1)

creationstart = BenchMicros()
nextfire = total
For i = 0 To rooms - 1
	room = MakeRoom(i, rooms, torches)
	EntityTexture room, bricks
	PositionEntity room, rcx(i), 0, rcz(i)
	; Every room has its own tint, so that the rooms don't all look the same.
	; The numbers are drawn into variables first: the original Blitz3D evaluates the arguments of a call in another order than BlitzLLVM
	; does (the second and third before the first), which would give the rooms other tints in the two.
	tintr = 190 + BenchRnd(0, 65)
	tintg = 190 + BenchRnd(0, 65)
	tintb = 190 + BenchRnd(0, 65)
	EntityColor room, tintr, tintg, tintb
	roomentity(i) = room
	For k = 0 To props - 1
		p = CopyEntity(proptemplates(k Mod 3))
		ShowEntity p
		sz# = BenchRnd(0.5, 1.2)
		ScaleEntity p, sz, sz, sz
		; The props stay out of the way of the walk and of the campfire: a place that is in the way is tried again 8 times.
		px# = BenchRnd(-5.5, 5.5)
		pz# = BenchRnd(-5.5, 5.5)
		For tries = 1 To 8
			If PropFree(i, rcx(i) + px, rcz(i) + pz) = 1 Then Exit
			px = BenchRnd(-5.5, 5.5)
			pz = BenchRnd(-5.5, 5.5)
		Next
		PositionEntity p, rcx(i) + px, sz, rcz(i) + pz
		RotateEntity p, 0, BenchRnd(0, 360), 0
	Next
	For k = 0 To torches - 1
		t = i * torches + k
		sourcex(t) = rcx(i) + TorchX(k)
		sourcez(t) = rcz(i) + TorchZ(k)
		light = CreateLight(2)
		LightRange light, 16
		PositionEntity light, sourcex(t), 2.9, sourcez(t)
		HideEntity light
		sourcelight(t) = light
	Next
	If fireon(i) = 1 Then
		t = nextfire
		nextfire = nextfire + 1
		sourcex(t) = rcx(i) + firex(i)
		sourcez(t) = rcz(i) + firez(i)
		light = CreateLight(2)
		LightRange light, 22
		PositionEntity light, sourcex(t), 1.3, sourcez(t)
		HideEntity light
		sourcelight(t) = light
	EndIf
Next
For t = 0 To nsources - 1
	flickerphase(t) = BenchRnd(0, 360)
	For j = 0 To pcount(t) - 1
		n = pstart(t) + j
		If j < pcount(t) / 2 Then
			spr(n) = CopyEntity(flametemplate)
		Else
			spr(n) = CopyEntity(smoketemplate)
		EndIf
		ShowEntity spr(n)
		phase(n) = BenchRnd(0, 1)
		ox(n) = BenchRnd(-1, 1)
		oz(n) = BenchRnd(-1, 1)
	Next
Next
creation# = (BenchMicros() - creationstart) / 1000.0

; The 8 lights that are on. selected(n) is a source, selecteddist(n) how far it is from the camera, nearest first.
Dim selected(7)
Dim selecteddist#(7)

Dim times#(frames - 1)
drawsum# = 0 : pipesum# = 0 : texsum# = 0 : bufsum# = 0 : trissum# = 0
total_ms# = 0 : updatetotal# = 0 : inviewsum# = 0

target = CreatePivot()

For f = 0 To warmup + frames - 1
	t0 = BenchMicros()

	; The camera walks the path, looks ahead on it, bobs a little and sways from side to side (40 degrees, so that the walls to
	; both sides of the doors are in view, and the sprites of the next room behind them). Near a campfire it turns to the fire.
	d# = f * SPEED
	cx# = PathX(d)
	cz# = PathZ(d)
	tx# = PathX(d + 9)
	tz# = PathZ(d + 9)
	ty# = EYE
	pan# = 0
	For t = total To nsources - 1
		dist# = Sqr((sourcex(t) - cx) * (sourcex(t) - cx) + (sourcez(t) - cz) * (sourcez(t) - cz))
		w# = Smooth(2.2 - dist / 5)
		If w > pan Then
			pan = w
			fx# = sourcex(t)
			fz# = sourcez(t)
		EndIf
	Next
	If pan > 0 Then
		tx = tx + (fx - tx) * pan
		tz = tz + (fz - tz) * pan
		ty = EYE + (0.6 - EYE) * pan
	EndIf
	PositionEntity camera, cx, EYE + 0.06 * Sin(f * 8.0), cz
	PositionEntity target, tx, ty, tz
	PointEntity camera, target
	TurnEntity camera, 0, Sin(f * 2.5) * 40 * (1 - pan), 0

	; The 8 nearest sources of light are lit and flicker.
	nsel = 0
	For t = 0 To nsources - 1
		dist# = (sourcex(t) - cx) * (sourcex(t) - cx) + (sourcez(t) - cz) * (sourcez(t) - cz)
		If nsel < 8 Or dist < selecteddist(7) Then
			If nsel < 8 Then nsel = nsel + 1
			j = nsel - 1
			; And does not skip the second test, so the index is checked first.
			While j > 0
				If selecteddist(j - 1) <= dist Then Exit
				selecteddist(j) = selecteddist(j - 1)
				selected(j) = selected(j - 1)
				j = j - 1
			Wend
			selecteddist(j) = dist
			selected(j) = t
		EndIf
	Next
	For t = 0 To nsources - 1
		want(t) = 0
	Next
	For j = 0 To nsel - 1
		t = selected(j)
		want(t) = 1
		flick# = 0.8 + 0.2 * Sin(f * 11.0 + flickerphase(t)) * Cos(f * 5.0 + flickerphase(t) * 2)
		If t >= total Then flick = flick * 1.3
		LightColor sourcelight(t), 255 * flick, 150 * flick, 70 * flick
	Next
	For t = 0 To nsources - 1
		If want(t) = 1 And lit(t) = 0 Then ShowEntity sourcelight(t)
		If want(t) = 0 And lit(t) = 1 Then HideEntity sourcelight(t)
		lit(t) = want(t)
	Next

	If still = 0 Or f = 0 Then
		fl# = f
		For t = 0 To nsources - 1
			sc# = sscale(t)
			For j = 0 To pcount(t) - 1
				n = pstart(t) + j
				If j < pcount(t) / 2 Then
					; Flame: rises from the bracket (or the logs) in 20 frames and shrinks to nothing.
					u# = phase(n) + fl / 20
					u = u - Floor(u)
					sz = (0.5 * (1 - u) + 0.05) * sc
					PositionEntity spr(n), sourcex(t) + ox(n) * 0.12 * sc * (1 - u), flamey(t) + u * flamerise(t), sourcez(t) + oz(n) * 0.12 * sc * (1 - u)
					ScaleSprite spr(n), sz * spritescale, sz * spritescale
					EntityAlpha spr(n), 0.9 * (1 - u)
				Else
					; Smoke: rises in 90 frames, drifts sideways, grows and thins out.
					u = phase(n) + fl / 90
					u = u - Floor(u)
					sz = (0.35 + u * 1.1) * (1 + (sc - 1) * 0.6)
					PositionEntity spr(n), sourcex(t) + ox(n) * 0.5 * u * sc, smokey(t) + u * smokerise(t), sourcez(t) + oz(n) * 0.5 * u * sc
					ScaleSprite spr(n), sz * spritescale, sz * spritescale
					EntityAlpha spr(n), 0.4 * Sin(u * 180)
				EndIf
			Next
		Next
	EndIf
	updated# = BenchMicros() - t0

	RenderWorld
	Flip 0
	elapsed# = BenchMicros() - t0
	If f >= warmup Then
		n = f - warmup
		times(n) = elapsed
		total_ms = total_ms + elapsed
		updatetotal = updatetotal + updated
		drawsum = drawsum + BenchDraws()
		pipesum = pipesum + BenchPipelines()
		texsum = texsum + BenchTextures()
		bufsum = bufsum + BenchBuffers()
		trissum = trissum + TrisRendered()
		; How many sprites the camera could see if there were no walls (they are in the view, behind the walls or not).
		If coverage = 1 Then
			For j = 0 To nparticles - 1
				If EntityInView(spr(j), camera) Then inviewsum = inviewsum + 1
			Next
		EndIf
	EndIf
Next

shot$ = GetEnv$("BENCH_SHOT")
If shot$ <> "" Then SaveBuffer BackBuffer(), shot$

; Sorting the times gives the median and the 95th percentile.
Dim srt#(frames - 1)
For i = 0 To frames - 1
	srt(i) = times(i)
Next
gap = frames / 2
While gap > 0
	For i = gap To frames - 1
		v# = srt(i)
		j = i
		; And does not skip the second test, so the index is checked first.
		While j >= gap
			If srt(j - gap) <= v Then Exit
			srt(j) = srt(j - gap)
			j = j - gap
		Wend
		srt(j) = v
	Next
	gap = gap / 2
Wend
p95 = Int(frames * 0.95) : If p95 > frames - 1 Then p95 = frames - 1

timesfile$ = GetEnv$("BENCH_FRAMETIMES")
If timesfile$ <> "" Then
	file = WriteFile(timesfile$)
	If file <> 0 Then
		For i = 0 To frames - 1
			WriteLine file, Int(times(i))
		Next
		CloseFile file
	EndIf
EndIf

avg# = total_ms / frames / 1000
result$ = "RESULT rooms=" + rooms + " campfires=" + nfire + " spritescale=" + spritescale + " sprites=" + nparticles + " inview=" + (inviewsum / frames) + " torches=" + torches + " particles=" + particles + " props=" + props + " frames=" + frames + " seed=" + seed + " static=" + still + " width=" + GraphicsWidth() + " height=" + GraphicsHeight() + " create_ms=" + creation + " update_ms=" + (updatetotal / frames / 1000) + " ms_avg=" + avg + " ms_min=" + (srt(0) / 1000) + " ms_median=" + (srt(frames / 2) / 1000) + " ms_p95=" + (srt(p95) / 1000) + " ms_max=" + (srt(frames - 1) / 1000) + " fps=" + (1000 / avg) + " tris=" + Int(trissum / frames) + " draws=" + Int(drawsum / frames) + " pipelines=" + Int(pipesum / frames) + " textures=" + Int(texsum / frames) + " buffers=" + Int(bufsum / frames)
DebugLog result$
resultfile$ = GetEnv$("BENCH_RESULT")
If resultfile$ <> "" Then
	file = WriteFile(resultfile$)
	If file <> 0 Then
		WriteLine file, result$
		CloseFile file
	EndIf
EndIf
End
