; The shared start of the benchmarks, for BlitzLLVM and the original Blitz3D alike: the settings every benchmark has, a random number
; generator that gives the same numbers in both, and the window. A benchmark looks like this:
;
;   Include "bench_compiler.bi"   ; bench_llvm.bi or bench_original.bi, copied by the runner
;   Include "bench_begin.bi"      ; this file: the settings and the window
;   ...                           ; the setup of the benchmark, its own part
;   Include "bench_end.bi"        ; the frames, the times and the RESULT line
;   Function BenchUpdate(frame)   ; and the functions that bench_end.bi calls, see there
;
; A benchmark that does not time frames (loading.bb) leaves bench_end.bi out and writes its own RESULT line with BenchWriteResult. A
; benchmark that draws only 2D (frontbuffer.bb) sets BenchGraphics2D = 1 before this file: the window is then opened with Graphics
; instead of Graphics3D, and there are no triangles to count.
;
; Environment variables (the runners set all of them):
;   BENCH_FRAMES      how many frames are timed (default 300)
;   BENCH_WARMUP      frames before them that are drawn but not timed, they fill the GPU buffers (default 5)
;   BENCH_SEED        seed of BenchRnd (default 1)
;   BENCH_W, BENCH_H  size of the window (default 640 x 360); the window is never full screen
;   BENCH_DEPTH       graphics depth for Graphics3D (0 or unset: what the program picks)
;   BENCH_GPU         graphics driver for SetGfxDriver (0 or unset: what the program picks)
;   BENCH_SHOT        file to save the last frame to (optional)
;   BENCH_RESULT      file to write the RESULT line to (optional, it is also in the debug log)
;   BENCH_FRAMETIMES  file to write the time of every frame to, in microseconds, one per line (optional)

; BenchProfiling and BenchProfile: bench_profile_on.bi or bench_profile_off.bi, copied by the runner.
Include "bench_profile.bi"

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

; The random numbers come from this generator and not from Rnd, because Rnd gives different numbers in BlitzLLVM and in the
; original Blitz3D, and then the two would not draw the same scene. It is the Park-Miller generator, with Schrage's way of
; multiplying without leaving 31 bits, so it gives the same numbers in both.
Global BenchState = 1

Function BenchSeedRnd(seed)
	BenchState = (seed Mod 2147483646) + 1
	If BenchState < 1 Then BenchState = BenchState + 2147483646
End Function

Function BenchRnd#(low#, high#)
	BenchState = 16807 * (BenchState Mod 127773) - 2836 * (BenchState / 127773)
	If BenchState <= 0 Then BenchState = BenchState + 2147483647
	Return low + (high - low) * (BenchState / 2147483647.0)
End Function

Global BenchFrames = Int(Env$("BENCH_FRAMES", 300))
If BenchFrames < 1 Then BenchFrames = 1
Global BenchWarmup = Int(Env$("BENCH_WARMUP", 5))
If BenchWarmup < 0 Then BenchWarmup = 0
Global BenchSeed = Int(Env$("BENCH_SEED", 1))

; How long making the scene took (create_ms): from here to the first frame, unless the benchmark marks a part of its setup with
; BenchStartCreation and BenchEndCreation.
; The triangles of a frame are TrisRendered() after BenchRender, unless BenchRender sets this (to 0 or more): a benchmark that draws more
; than its world (forest.bb's bloom) gives the count of the world.
Global BenchSceneTris = -1
Global BenchCreateStart = 0
Global BenchCreateMs# = -1

Function BenchStartCreation()
	BenchCreateStart = BenchMicros()
End Function

Function BenchEndCreation()
	BenchCreateMs = (BenchMicros() - BenchCreateStart) / 1000.0
End Function

; The GPU time of the passes with profiling (bench_profile_on.bi). GPU work comes back late: the first GPU time arrives some frames after
; the first frame, the more frames the faster the program runs (up to 100 or more), and from then on one frame's comes back per Flip.
; So the n-th time that comes back is the one of frame n: BenchGpuSample counts them from the first frame on and adds up those of the
; timed frames (frames BenchWarmup to BenchWarmup + BenchFrames - 1), and bench_end.bi keeps drawing the last picture, untimed, until
; all of them are back. BenchGpuLag is the number of the frame at whose Flip the first time came back.
Global BenchGpuSeen = 0
Global BenchGpuLag = -1
Global BenchGpuFrames = 0
Global BenchGpuScene# = 0
Global BenchGpu2D# = 0
Global BenchGpuCopy# = 0
Global BenchGpuPresent# = 0
Global BenchGpuFrame# = 0

; Call after every Flip, with the number of the frame (counting from 0, the warmup frames first).
Function BenchGpuSample(frame)
	If BenchProfiling() = 0 Then Return
	now# = BenchProfile("gpu frame")
	If now <= 0 Then Return ; Nothing came back at this Flip.
	If BenchGpuLag < 0 Then BenchGpuLag = frame
	If BenchGpuSeen >= BenchWarmup And BenchGpuSeen < BenchWarmup + BenchFrames Then
		BenchGpuFrames = BenchGpuFrames + 1
		BenchGpuFrame = BenchGpuFrame + now
		BenchGpuScene = BenchGpuScene + BenchProfile("gpu scene")
		BenchGpu2D = BenchGpu2D + BenchProfile("gpu 2d")
		BenchGpuCopy = BenchGpuCopy + BenchProfile("gpu copy")
		BenchGpuPresent = BenchGpuPresent + BenchProfile("gpu present")
	EndIf
	BenchGpuSeen = BenchGpuSeen + 1
End Function

; Writes line (the RESULT line, or a line that starts with ERROR when the benchmark cannot run as asked) to the debug log and to the file
; BENCH_RESULT, where the runner reads it: the original Blitz3D has no stdout for a program.
Function BenchWriteResult(line$)
	DebugLog line$
	name$ = GetEnv$("BENCH_RESULT")
	If name$ <> "" Then
		file = WriteFile(name$)
		If file <> 0 Then
			WriteLine file, line$
			CloseFile file
		EndIf
	EndIf
End Function

bench_gpu = Int(Env$("BENCH_GPU", 0))
If bench_gpu > 0 And bench_gpu <= CountGfxDrivers() Then SetGfxDriver bench_gpu
If BenchGraphics2D Then
	Graphics Int(Env$("BENCH_W", 640)), Int(Env$("BENCH_H", 360)), Int(Env$("BENCH_DEPTH", 0)), 2
Else
	Graphics3D Int(Env$("BENCH_W", 640)), Int(Env$("BENCH_H", 360)), Int(Env$("BENCH_DEPTH", 0)), 2
EndIf
SetBuffer BackBuffer()
BenchSeedRnd BenchSeed
BenchStartCreation
