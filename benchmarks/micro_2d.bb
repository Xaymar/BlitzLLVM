; Microbenchmarks of 2D drawing, images and pixels. See micro.bi for how a case is timed; python3 benchmarks/micro.py builds and runs
; it. The drawing cases time the call: the work that it leaves for Flip and the GPU is done after each pass, outside the timed part.
;
; Runs with BlitzLLVM and with the original Blitz3D: what differs between them is in bench_llvm.bi and bench_original.bi, which the
; runner copies next to this file as bench_compiler.bi.
Include "bench_compiler.bi"
BenchGraphics2D = 1
Include "bench_begin.bi"
Include "micro.bi"

Global MicroW = GraphicsWidth()
Global MicroH = GraphicsHeight()

; A 32x32 picture with a mask colour in one corner, and a second one to test overlaps against.
Global MicroImage = CreateImage(32, 32)
SetBuffer ImageBuffer(MicroImage)
Color 200, 120, 40
Rect 0, 0, 32, 32, 1
Color 0, 0, 0
Rect 0, 0, 8, 8, 1
Global MicroImage2 = CopyImage(MicroImage)
SetBuffer BackBuffer()

Draw_Plot()
Draw_Line()
Draw_RectFilled()
Draw_RectOutline()
Draw_Oval()
Draw_Text()
Draw_Color()
Draw_Cls()
Draw_StringWidth()
Draw_SetBuffer()

Image_Draw()
Image_DrawBlock()
Image_DrawRect()
Image_TileImage()
Image_CreateFree()
Image_Copy()
Image_Overlap()
Image_Collide()
Image_RectCollide()
Image_Width()

Pixels_WritePixelFast()
Pixels_ReadPixelFast()
Pixels_WritePixel()
Pixels_ReadPixel()
Pixels_LockUnlock()
Pixels_CopyRect()
Pixels_ImageWritePixelFast()

MicroEnd()

; Drawing ------------------------------------------------------------------------------------------------------------------------

Function Draw_Plot()
	If Not MicroCase("2d/plot") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			Plot i And 255, (i Shr 8) And 127
		Next
	Wend
End Function

Function Draw_Line()
	If Not MicroCase("2d/line") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			Line i And 255, 0, 0, (i Shr 8) And 127
		Next
	Wend
End Function

Function Draw_RectFilled()
	If Not MicroCase("2d/rect-filled-16") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			Rect i And 255, (i Shr 8) And 127, 16, 16, 1
		Next
	Wend
End Function

Function Draw_RectOutline()
	If Not MicroCase("2d/rect-outline-16") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			Rect i And 255, (i Shr 8) And 127, 16, 16, 0
		Next
	Wend
End Function

Function Draw_Oval()
	If Not MicroCase("2d/oval-filled-16") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			Oval i And 255, (i Shr 8) And 127, 16, 16, 1
		Next
	Wend
End Function

Function Draw_Text()
	If Not MicroCase("2d/text-3-chars") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			Text i And 255, (i Shr 8) And 127, MicroShort$
		Next
	Wend
End Function

Function Draw_Color()
	If Not MicroCase("2d/color") Then Return
	While MicroRun()
		For i = 1 To MicroN
			Color i And 255, 128, 64
		Next
	Wend
	Color 255, 255, 255
End Function

Function Draw_Cls()
	If Not MicroCase("2d/cls") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			Cls
		Next
	Wend
End Function

Function Draw_StringWidth()
	If Not MicroCase("2d/stringwidth") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + StringWidth(MicroText$)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Draw_SetBuffer()
	If Not MicroCase("2d/setbuffer") Then Return
	image = ImageBuffer(MicroImage)
	While MicroRun()
		For i = 1 To MicroN
			If i And 1 Then SetBuffer image Else SetBuffer BackBuffer()
		Next
	Wend
	SetBuffer BackBuffer()
End Function

; Images -------------------------------------------------------------------------------------------------------------------------

Function Image_Draw()
	If Not MicroCase("image/drawimage-32") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			DrawImage MicroImage, i And 255, (i Shr 8) And 127
		Next
	Wend
End Function

Function Image_DrawBlock()
	If Not MicroCase("image/drawblock-32") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			DrawBlock MicroImage, i And 255, (i Shr 8) And 127
		Next
	Wend
End Function

Function Image_DrawRect()
	If Not MicroCase("image/drawimagerect-16") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			DrawImageRect MicroImage, i And 255, (i Shr 8) And 127, 8, 8, 16, 16
		Next
	Wend
End Function

Function Image_TileImage()
	If Not MicroCase("image/tileimage-32") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			TileImage MicroImage, i And 31, 0
		Next
	Wend
End Function

Function Image_CreateFree()
	If Not MicroCase("image/create-free-32") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			image = CreateImage(32, 32)
			s = s + image
			FreeImage image
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Image_Copy()
	If Not MicroCase("image/copyimage-32") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			image = CopyImage(MicroImage)
			s = s + image
			FreeImage image
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Image_Overlap()
	If Not MicroCase("image/imagesoverlap") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + ImagesOverlap(MicroImage, 0, 0, MicroImage2, i And 63, 0)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Image_Collide()
	If Not MicroCase("image/imagescollide") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + ImagesCollide(MicroImage, 0, 0, 0, MicroImage2, i And 31, 4, 0)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Image_RectCollide()
	If Not MicroCase("image/imagerectcollide") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + ImageRectCollide(MicroImage, 0, 0, 0, i And 31, 4, 8, 8)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Image_Width()
	If Not MicroCase("image/imagewidth") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + ImageWidth(MicroImage)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

; Pixels -------------------------------------------------------------------------------------------------------------------------

Function Pixels_WritePixelFast()
	If Not MicroCase("pixels/writepixelfast") Then Return
	LockBuffer BackBuffer()
	While MicroRun()
		For i = 1 To MicroN
			WritePixelFast i And 255, (i Shr 8) And 127, i
		Next
	Wend
	UnlockBuffer BackBuffer()
End Function

Function Pixels_ReadPixelFast()
	If Not MicroCase("pixels/readpixelfast") Then Return
	LockBuffer BackBuffer()
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + ReadPixelFast(i And 255, (i Shr 8) And 127)
		Next
	Wend
	UnlockBuffer BackBuffer()
	MicroSinkI = MicroSinkI + s
End Function

Function Pixels_WritePixel()
	If Not MicroCase("pixels/writepixel") Then Return
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			WritePixel i And 255, (i Shr 8) And 127, i
		Next
	Wend
End Function

Function Pixels_ReadPixel()
	If Not MicroCase("pixels/readpixel") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + ReadPixel(i And 255, (i Shr 8) And 127)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Pixels_LockUnlock()
	If Not MicroCase("pixels/lock-unlock-imagebuffer") Then Return
	buffer = ImageBuffer(MicroImage2)
	While MicroRun()
		For i = 1 To MicroN
			LockBuffer buffer
			UnlockBuffer buffer
		Next
	Wend
End Function

Function Pixels_CopyRect()
	If Not MicroCase("pixels/copyrect-32") Then Return
	MicroFlip = 1
	source = ImageBuffer(MicroImage)
	While MicroRun()
		For i = 1 To MicroN
			CopyRect 0, 0, 32, 32, i And 255, (i Shr 8) And 127, source, BackBuffer()
		Next
	Wend
End Function

Function Pixels_ImageWritePixelFast()
	If Not MicroCase("pixels/writepixelfast-imagebuffer") Then Return
	buffer = ImageBuffer(MicroImage2)
	LockBuffer buffer
	While MicroRun()
		For i = 1 To MicroN
			WritePixelFast i And 31, (i Shr 5) And 31, i, buffer
		Next
	Wend
	UnlockBuffer buffer
End Function
