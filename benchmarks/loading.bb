; Loads many textures, does some work of its own, and then uses the textures, and prints how long each step took. With
; BlitzLLVM and BENCH_ASYNC=1 the loading is done on other threads (AsyncLoading), which is what is compared with blocking.
; The original Blitz3D can run it as well. python3 benchmarks/loading.py generates the pictures, builds and runs it.
;
; Environment variables:
;   BENCH_DIR      folder with tex0.png, tex1.png, ... (made by loading.py)
;   BENCH_TEXTURES how many are loaded (default 64)
;   BENCH_WORK     iterations of the work between loading and using (default 0), standing in for the setup a game does
;   BENCH_ASYNC    1 to load on other threads (BlitzLLVM only)
;   BENCH_FLAGS    LoadTexture flags (default 9: color and mip maps)
;   BENCH_RESULT   file to write the RESULT line to
Include "loading_counters.bi"

Graphics3D 320, 180, 32, 2
SetBuffer BackBuffer()

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

count = Int(Env$("BENCH_TEXTURES", 64))
work = Int(Env$("BENCH_WORK", 0))
flags = Int(Env$("BENCH_FLAGS", 9))
folder$ = Env$("BENCH_DIR", ".")
BenchAsync Int(Env$("BENCH_ASYNC", 0))

Dim tex(count)
camera = CreateCamera()
PositionEntity camera, 0, 0, -3
light = CreateLight()
cube = CreateCube()

start = BenchMicros()
For i = 0 To count - 1
	tex(i) = LoadTexture(folder$ + "/tex" + i + ".png", flags)
	If tex(i) = 0 Then RuntimeError "Could not load " + folder$ + "/tex" + i + ".png"
Next
loaded = BenchMicros()

; Stands in for what a program does after loading and before it needs the pictures.
x# = 0
For i = 1 To work
	x# = x# + Sqr(i) * 0.5
Next
worked = BenchMicros()

; Each texture is put on the cube and drawn once, which is what needs the picture.
For i = 0 To count - 1
	EntityTexture cube, tex(i)
	RenderWorld
	Flip
Next
used = BenchMicros()

ready = 0
For i = 0 To count - 1
	ready = ready + BenchReady(tex(i))
Next

line$ = "RESULT textures=" + count + " load_ms=" + ((loaded - start) / 1000.0) + " work_ms=" + ((worked - loaded) / 1000.0) + " use_ms=" + ((used - worked) / 1000.0) + " total_ms=" + ((used - start) / 1000.0) + " ready=" + ready + " x=" + Int(x#)
resultfile$ = Env$("BENCH_RESULT", "")
If resultfile$ <> ""
	f = WriteFile(resultfile$)
	WriteLine f, line$
	CloseFile f
EndIf
DebugLog line$
End
