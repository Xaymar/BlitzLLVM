; Original Blitz3D side of the loading benchmark: a millisecond timer, and loading always blocks.

Function BenchMicros()
	Return MilliSecs() * 1000
End Function

Function BenchAsync(on)
End Function

Function BenchReady(texture)
	Return 1
End Function

Function BenchEntityReady(entity)
	Return 1
End Function
