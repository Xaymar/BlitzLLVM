; BlitzLLVM side of the flythrough benchmark: a microsecond timer and the draw counters of Stats3D.

Global BenchBase:UInt64 = Microseconds()

; Microseconds since the start. Only differences are used, so a wrap after 35 minutes does no harm.
Function BenchMicros()
	Return Int(Microseconds() - BenchBase)
End Function

Function BenchDraws()
	Return Stats3D(1000)
End Function

Function BenchPipelines()
	Return Stats3D(1001)
End Function

Function BenchTextures()
	Return Stats3D(1002)
End Function

Function BenchBuffers()
	Return Stats3D(1003)
End Function

; Shows the frame without waiting for the display, like the original (Flip 0). Flip 2 is not used while it can still hold a frame back
; to the refresh rate of the display (seen at 180 Hz), which would measure the display instead of the program.
Function BenchFlip()
	Flip 0
End Function
