; Collision oracle: a fixed course of movers (spheres and an ellipsoid) pushed along fixed paths into spheres, polygon
; meshes (cube, ramp, cone) and boxes with every response (1 stop, 2 slide, 3 slide not down slopes). Every frame the
; positions and every Collision* value are written to a text file, so that two compilers (or two collision backends) can
; be compared line by line. Works with the original Blitz3D compiler and BlitzLLVM.
;
; Environment variables:
;   ORACLE_OUT      output file (default oracle.txt)
;   ORACLE_FRAMES   frames (default 200)
Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

Dim ents(20)
Global entCount = 0
Function Reg(e)
	entCount = entCount + 1
	ents(entCount) = e
	Return e
End Function

; The original gives pointers as handles, so entities are written as their number of creation
Function IdOf(e)
	For k = 1 To entCount
		If ents(k) = e Then Return k
	Next
	Return 0
End Function

; The original gives pointers as surface handles, so surfaces are written as their index on the entity
Function SurfaceIdOf(e, surf)
	For k = 1 To CountSurfaces(e)
		If GetSurface(e, k) = surf Then Return k
	Next
	Return 0
End Function

Function F$(v#)
	; Written in units of 0.0001, so that no float formatting differs between the compilers
	Return Int(v * 10000 + 0.5 * Sgn(v))
End Function

out$ = Env$("ORACLE_OUT", "oracle.txt")
frames = Int(Env$("ORACLE_FRAMES", "200"))
file = WriteFile(out$)

cam = CreateCamera()
MoveEntity cam, 0, 5, -30
Light = CreateLight()

; Scenery: types 2 (polygons), 3 (boxes), 4 (spheres)
cube = Reg(CreateCube())
EntityType cube, 2
PositionEntity cube, 0, 0, 10
ScaleEntity cube, 2, 2, 2

cone = Reg(CreateCone(8))
EntityType cone, 2
PositionEntity cone, -10, 0, 10
ScaleEntity cone, 2, 3, 2

ramp = Reg(CreateCube())
EntityType ramp, 2
PositionEntity ramp, 10, 0, 10
ScaleEntity ramp, 4, 0.5, 4
RotateEntity ramp, 0, 0, 25

wall = Reg(CreateCube())
EntityType wall, 3
EntityBox wall, -3, -2, -0.5, 6, 4, 1
PositionEntity wall, 0, 0, 20
ScaleEntity wall, 1, 1, 1

ball = Reg(CreateSphere(8))
EntityType ball, 4
EntityRadius ball, 2
PositionEntity ball, -10, 0, 20

; Movers: type 1 (stop), 5 (slide), 6 (slide not down slopes), 7 (ellipsoid, slide)
Dim m(7), dx#(7), dz#(7)
For i = 1 To 7
	m(i) = Reg(CreateSphere(8))
	EntityRadius m(i), 1
	PositionEntity m(i), -15 + i * 4, 3, 0
	dx(i) = 0.02 * (i - 4)
	dz(i) = 0.25
Next
EntityType m(1), 1
EntityType m(2), 5
EntityType m(3), 6
EntityType m(4), 7
EntityRadius m(4), 1, 2
EntityType m(5), 5
EntityType m(6), 6
EntityType m(7), 1
; Gravity-like pull downwards so that ramps and slopes matter
Collisions 1, 2, 2, 1
Collisions 1, 3, 3, 1
Collisions 1, 4, 1, 1
Collisions 5, 2, 2, 2
Collisions 5, 3, 3, 2
Collisions 5, 4, 1, 2
Collisions 6, 2, 2, 3
Collisions 6, 3, 3, 3
Collisions 6, 4, 1, 3
Collisions 7, 2, 2, 2
Collisions 7, 3, 3, 2
Collisions 7, 4, 1, 2
Collisions 5, 6, 1, 2

For frame = 1 To frames
	For i = 1 To 7
		MoveEntity m(i), dx(i), -0.05, dz(i)
		If EntityZ(m(i)) > 30 Then PositionEntity m(i), EntityX(m(i)), 3, 0
	Next
	UpdateWorld
	For i = 1 To 7
		line$ = frame + " " + i + " " + F(EntityX(m(i))) + " " + F(EntityY(m(i))) + " " + F(EntityZ(m(i))) + " n=" + CountCollisions(m(i))
		For c = 1 To CountCollisions(m(i))
			line$ = line$ + " [" + IdOf(CollisionEntity(m(i), c)) + " " + F(CollisionX(m(i), c)) + " " + F(CollisionY(m(i), c)) + " " + F(CollisionZ(m(i), c)) + " " + F(CollisionNX(m(i), c)) + " " + F(CollisionNY(m(i), c)) + " " + F(CollisionNZ(m(i), c)) + " " + SurfaceIdOf(CollisionEntity(m(i), c), CollisionSurface(m(i), c)) + " " + CollisionTriangle(m(i), c) + "]"
		Next
		WriteLine file, line$
	Next
Next
CloseFile file
End
