; What texture layers cost: a field of terrain tiles that each have BENCH_LAYERS textures (1 is the base only, 2 adds a detail layer that
; multiplies, 3 a light map that multiplies by 2, 4 an add layer), looked at from above. Runs in the original Blitz3D as well.
;   BENCH_LAYERS  textures on every tile (1 to 8, default 3)
;   BENCH_TILES   tiles along each side of the field (default 12, so 144 tiles of 800 triangles)
;   BENCH_FRAMES  frames that are timed (default 300), BENCH_WARMUP frames before (default 5)
;   BENCH_PASSES  RenderWorld calls before every Flip (default 1): more than 1 makes the GPU the limit when a frame is shorter than the refresh of the display
;   BENCH_SYNC    1 reads a pixel of the back buffer after the passes, which waits for the GPU to be done with them, so a frame is not timed shorter than it took
;   BENCH_GPU     the graphics driver number for SetGfxDriver (optional, default is the one the program picks)
;   BENCH_W, BENCH_H size of the window (default 640 x 360)
;   BENCH_RESULT  file to write the RESULT line to
Include "flythrough_counters.bi"

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

If GetEnv$("BENCH_GPU") <> "" Then SetGfxDriver Int(GetEnv$("BENCH_GPU"))
Graphics3D Int(Env$("BENCH_W", 640)), Int(Env$("BENCH_H", 360)), 32, 2
SetBuffer BackBuffer()
layers = Int(Env$("BENCH_LAYERS", 3))
passes = Int(Env$("BENCH_PASSES", 1))
sync = Int(Env$("BENCH_SYNC", 0))
tiles = Int(Env$("BENCH_TILES", 12))
frames = Int(Env$("BENCH_FRAMES", 300))
warmup = Int(Env$("BENCH_WARMUP", 5))

camera = CreateCamera()
CameraRange camera, 0.5, 400
PositionEntity camera, 0, 60, 0
RotateEntity camera, 90, 0, 0
light = CreateLight()
RotateEntity light, 50, 30, 0

; Textures with a pattern each, drawn with the drawing commands.
Dim tex(7)
For i = 0 To 7
	tex(i) = CreateTexture(64, 64, 1 + 8)
	SetBuffer TextureBuffer(tex(i))
	For y = 0 To 63
		For x = 0 To 63
			v = 128 + ((x * (i + 3) + y * (i + 5)) Mod 96)
			Color v, 255 - v / 2, (v * (i + 2)) Mod 256
			Plot x, y
		Next
	Next
	SetBuffer BackBuffer()
	; The first layer multiplies, the others: detail multiplies, 2x multiplies, add adds.
	If i = 0 Then TextureBlend tex(i), 2
	If i = 1 Then TextureBlend tex(i), 2
	If i = 2 Then TextureBlend tex(i), 5
	If i > 2 Then TextureBlend tex(i), 3
Next

; A tile is a grid of 20 x 20 quads (800 triangles).
Function MakeTile(n)
	m = CreateMesh()
	s = CreateSurface(m)
	For y = 0 To n
		For x = 0 To n
			v = AddVertex(s, x * 1.0, Sin(x * 36.0) * Cos(y * 36.0) * 0.5, y * 1.0, x / Float(n) * 4.0, y / Float(n) * 4.0)
			VertexNormal s, v, 0, 1, 0
		Next
	Next
	For y = 0 To n - 1
		For x = 0 To n - 1
			a = y * (n + 1) + x
			AddTriangle s, a, a + n + 1, a + 1
			AddTriangle s, a + 1, a + n + 1, a + n + 2
		Next
	Next
	Return m
End Function

For ty = 0 To tiles - 1
	For tx = 0 To tiles - 1
		m = MakeTile(20)
		PositionEntity m, (tx - tiles / 2.0) * 21, 0, (ty - tiles / 2.0) * 21
		For l = 0 To layers - 1
			EntityTexture m, tex(l), 0, l
		Next
	Next
Next

For f = 1 To warmup
	RenderWorld
	BenchFlip()
Next

Dim times(frames)
total = 0
For f = 1 To frames
	start = MilliSecs()
	For pass = 1 To passes
		RenderWorld
	Next
	If sync Then
		LockBuffer BackBuffer()
		sink = ReadPixelFast(0, 0, BackBuffer())
		UnlockBuffer BackBuffer()
	EndIf
	BenchFlip()
	times(f) = MilliSecs() - start
	total = total + times(f)
Next

line$ = "RESULT layers=" + layers + " tiles=" + (tiles * tiles) + " frames=" + frames + " ms_avg=" + (total / Float(frames)) + " tris=" + TrisRendered() + " draws=" + BenchDraws() + " textures=" + BenchTextures()
resultfile$ = GetEnv$("BENCH_RESULT")
If resultfile$ <> "" Then
	file = WriteFile(resultfile$)
	WriteLine file, line$
	CloseFile file
EndIf
DebugLog line$
End
