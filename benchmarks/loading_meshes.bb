; Loads many .b3d models, does some work of its own, and then uses the models, and prints how long each step took. With BlitzLLVM
; and BENCH_ASYNC=1 the models are parsed on other threads (AsyncLoading), which is what is compared with blocking. The original
; Blitz3D can run it as well. python3 benchmarks/loading_meshes.py makes the models, builds and runs it.
;
; Environment variables:
;   BENCH_DIR      folder with mesh0.b3d, mesh1.b3d, ... (made by loading_meshes.py)
;   BENCH_MESHES   how many are loaded (default 32)
;   BENCH_WORK     iterations of the work between loading and using (default 0)
;   BENCH_ASYNC    1 to load on other threads (BlitzLLVM only)
;   BENCH_RESULT   file to write the RESULT line to
Include "loading_counters.bi"

Graphics3D 320, 180, 32, 2
SetBuffer BackBuffer()

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

count = Int(Env$("BENCH_MESHES", 32))
work = Int(Env$("BENCH_WORK", 0))
folder$ = Env$("BENCH_DIR", ".")
BenchAsync Int(Env$("BENCH_ASYNC", 0))

Dim model(count)
camera = CreateCamera()
PositionEntity camera, 0, 0, -3
light = CreateLight()

start = BenchMicros()
For i = 0 To count - 1
	model(i) = LoadMesh(folder$ + "/mesh" + i + ".b3d")
	If model(i) = 0 Then RuntimeError "Could not load " + folder$ + "/mesh" + i + ".b3d"
Next
loaded = BenchMicros()

x# = 0
For i = 1 To work
	x# = x# + Sqr(i) * 0.5
Next
worked = BenchMicros()

; Each model is shown once, which is what needs it.
For i = 0 To count - 1
	ShowEntity model(i)
	RenderWorld
	Flip
	HideEntity model(i)
Next
used = BenchMicros()

ready = 0
triangles = 0
For i = 0 To count - 1
	ready = ready + BenchEntityReady(model(i))
	triangles = triangles + CountTriangles(GetSurface(model(i), 1))
Next

line$ = "RESULT meshes=" + count + " load_ms=" + ((loaded - start) / 1000.0) + " work_ms=" + ((worked - loaded) / 1000.0) + " use_ms=" + ((used - worked) / 1000.0) + " total_ms=" + ((used - start) / 1000.0) + " ready=" + ready + " triangles=" + triangles + " x=" + Int(x#)
resultfile$ = Env$("BENCH_RESULT", "")
If resultfile$ <> ""
	f = WriteFile(resultfile$)
	WriteLine f, line$
	CloseFile f
EndIf
DebugLog line$
End
