; Meshes and surfaces ------------------------------------------------------------------------------------------------------------

Function Mesh_CreateFree()
	If Not MicroCase("mesh/createmesh-surface-free") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			mesh = CreateMesh()
			surface = CreateSurface(mesh)
			s = s + surface
			FreeEntity mesh
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

; Per vertex; the surface is emptied every 16384 vertices.
Function Mesh_AddVertex()
	If Not MicroCase("mesh/addvertex") Then Return
	mesh = CreateMesh()
	surface = CreateSurface(mesh)
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			If (i And 16383) = 0 Then ClearSurface surface
			s = s + AddVertex(surface, i And 15, 1, 2, 0.5, 0.5)
		Next
	Wend
	FreeEntity mesh
	MicroSinkI = MicroSinkI + s
End Function

Function Mesh_AddTriangle()
	If Not MicroCase("mesh/addtriangle") Then Return
	mesh = CreateMesh()
	surface = CreateSurface(mesh)
	For i = 0 To 255
		AddVertex surface, i, i And 1, 0
	Next
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			If (i And 16383) = 0 Then ClearSurface surface, False, True
			s = s + AddTriangle(surface, i And 255, (i + 1) And 255, (i + 2) And 255)
		Next
	Wend
	FreeEntity mesh
	MicroSinkI = MicroSinkI + s
End Function

Function MicroMakeMesh()
	If MicroMesh = 0 Then
		MicroMesh = CreateSphere(16)
		HideEntity MicroMesh
		MicroSurface = GetSurface(MicroMesh, 1)
	EndIf
End Function

