; Picks and collisions -----------------------------------------------------------------------------------------------------------

; 100 cubes in a 10 x 10 grid in front of the camera, pickable as polygons (MicroGrid).

Function MicroMakeGrid()
	For i = 0 To 99
		MicroGrid(i) = CopyEntity(MicroCube)
		PositionEntity MicroGrid(i), (i Mod 10) * 2.5 - 11.25, (i / 10) * 2.5 - 11.25, 0
		EntityPickMode MicroGrid(i), 2
	Next
End Function

Function MicroFreeGrid()
	For i = 0 To 99
		FreeEntity MicroGrid(i)
	Next
End Function

Function Pick_Line()
	If Not MicroCase("pick/linepick-100-cubes") Then Return
	MicroMakeGrid()
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + LinePick((i And 15) - 8, 0.5, -10, 0, 0, 20)
		Next
	Wend
	MicroFreeGrid()
	MicroSinkI = MicroSinkI + s
End Function

Function Pick_Camera()
	If Not MicroCase("pick/camerapick-100-cubes") Then Return
	MicroMakeGrid()
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + CameraPick(MicroCamera, i And 255, (i Shr 8) And 127)
		Next
	Wend
	MicroFreeGrid()
	MicroSinkI = MicroSinkI + s
End Function

Function Pick_Entity()
	If Not MicroCase("pick/entitypick-100-cubes") Then Return
	MicroMakeGrid()
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + EntityPick(MicroCamera, 100)
		Next
	Wend
	MicroFreeGrid()
	MicroSinkI = MicroSinkI + s
End Function

; Per UpdateWorld: 100 spheres that move against the 100 cubes (sphere to polygon, slide).
Function Collide_UpdateWorld()
	If Not MicroCase("collide/updateworld-100-spheres-100-cubes") Then Return
	MicroMakeGrid()
	For i = 0 To 99
		EntityType MicroGrid(i), 2
	Next
	For i = 0 To 99
		MicroBalls(i) = CreatePivot()
		EntityType MicroBalls(i), 1
		EntityRadius MicroBalls(i), 0.5
		PositionEntity MicroBalls(i), (i Mod 10) * 2.5 - 11.25, (i / 10) * 2.5 - 11.25, -2
		ResetEntity MicroBalls(i)
	Next
	Collisions 1, 2, 2, 2
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			For j = 0 To 99
				If i And 1 Then TranslateEntity MicroBalls(j), 0, 0, 1 Else PositionEntity MicroBalls(j), (j Mod 10) * 2.5 - 11.25, (j / 10) * 2.5 - 11.25, -2
			Next
			UpdateWorld
			s = s + CountCollisions(MicroBalls(0))
		Next
	Wend
	ClearCollisions
	For i = 0 To 99
		FreeEntity MicroBalls(i)
	Next
	MicroFreeGrid()
	MicroSinkI = MicroSinkI + s
End Function

; RenderWorld and Flip -----------------------------------------------------------------------------------------------------------

; count cubes in a grid in front of the camera, textured or not. With textures every cube has its own, so the renderer looks up one
; texture per draw (texture_of).
Function MicroMakeCubes(count, textured)
	side = Int(Ceil(Sqr(count)))
	If side < 1 Then side = 1
	For i = 0 To count - 1
		MicroCubes(i) = CopyEntity(MicroCube)
		ShowEntity MicroCubes(i)
		ScaleEntity MicroCubes(i), 8.0 / side, 8.0 / side, 8.0 / side
		PositionEntity MicroCubes(i), ((i Mod side) - side / 2.0) * 20.0 / side, ((i / side) - side / 2.0) * 20.0 / side, 0
		If textured Then
			MicroTextures(i) = CreateTexture(16, 16)
			EntityTexture MicroCubes(i), MicroTextures(i)
		EndIf
	Next
End Function

Function MicroFreeCubes(count, textured)
	For i = 0 To count - 1
		FreeEntity MicroCubes(i)
		If textured Then FreeTexture MicroTextures(i)
	Next
End Function

Function MicroCubesName$(what$, count, textured)
	name$ = "render/" + what$ + "-" + count + "-cubes"
	If textured Then name$ = name$ + "-textured"
	Return name$
End Function

; Per frame: RenderWorld and Flip 0.
Function Render_Frame(count, textured)
	If Not MicroCase(MicroCubesName$("frame", count, textured)) Then Return
	MicroMakeCubes count, textured
	While MicroRun()
		For i = 1 To MicroN
			RenderWorld
			Flip 0
		Next
	Wend
	MicroFreeCubes count, textured
End Function

; Per RenderWorld, without Flip: MicroRun flips after each pass, outside the timed part. The time of Flip (a few hundred microseconds)
; does not hide what the draws cost here.
Function Render_World(count, textured)
	If Not MicroCase(MicroCubesName$("renderworld", count, textured)) Then Return
	MicroMakeCubes count, textured
	MicroFlip = 1
	While MicroRun()
		For i = 1 To MicroN
			RenderWorld
		Next
	Wend
	MicroFreeCubes count, textured
End Function

; Per frame: count meshes of 64 vertices and 98 triangles that change, then RenderWorld and Flip 0. rebuilt 0 moves a vertex of each
; (same triangles), 1 clears each surface and adds its vertices and triangles again (new triangles, like Text3D).
Function Render_Changing(count, rebuilt)
	name$ = "render/frame-" + count + "-moving-surfaces"
	If rebuilt Then name$ = "render/frame-" + count + "-rebuilt-surfaces"
	If Not MicroCase(name$) Then Return
	For m = 0 To count - 1
		MicroChanging(m) = CreateMesh()
		MicroFillGrid CreateSurface(MicroChanging(m))
		PositionEntity MicroChanging(m), (m Mod 8) * 2.5 - 9, (m / 8) * 2.5 - 9, 20
	Next
	frame = 0
	While MicroRun()
		For i = 1 To MicroN
			frame = frame + 1
			For m = 0 To count - 1
				surf = GetSurface(MicroChanging(m), 1)
				If rebuilt Then
					ClearSurface surf
					MicroFillGrid surf
				Else
					VertexCoords surf, 0, 0, 0, Float(frame Mod 7) * 0.01
				EndIf
			Next
			RenderWorld
			Flip 0
		Next
	Wend
	For m = 0 To count - 1
		FreeEntity MicroChanging(m)
	Next
End Function

; An 8 by 8 grid of vertices (7 by 7 quads, 98 triangles) on a surface.
Function MicroFillGrid(surf)
	For y = 0 To 7
		For x = 0 To 7
			AddVertex surf, x * 0.25, y * 0.25, 0, x / 7.0, y / 7.0
		Next
	Next
	For y = 0 To 6
		For x = 0 To 6
			v = y * 8 + x
			AddTriangle surf, v, v + 8, v + 1
			AddTriangle surf, v + 1, v + 8, v + 9
		Next
	Next
End Function
