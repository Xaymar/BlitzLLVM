Function Entity_CreateFreePivot()
	If Not MicroCase("entity/create-free-pivot") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			e = CreatePivot()
			s = s + e
			FreeEntity e
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

