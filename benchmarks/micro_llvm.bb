; Microbenchmarks of what only BlitzLLVM has: the timer, the number and bit functions, 64 bit pixels, samplers and light channels.
; See micro.bi for how a case is timed; python3 benchmarks/micro.py builds and runs it (not with the original Blitz3D).
Include "bench_compiler.bi"
Include "bench_begin.bi"
Include "micro.bi"

Global MicroTexture = CreateTexture(64, 64)
Global MicroSampler = CreateSampler()
Global MicroCube = CreateCube()
HideEntity MicroCube

Time_Microseconds()
Bits_PopCount()
Bits_LeadingZeros()
Bits_TrailingZeros()
Bits_RotL()
Bits_ByteSwap()
Number_Byte()
Number_SatUByte()
Number_Half()
Pixels_ReadPixelFast64()
Pixels_WritePixelFast64()
Sampler_SetTextureSampler()
Sampler_Filter()
Light_EntityLightChannel()

MicroEnd()

Function Time_Microseconds()
	If Not MicroCase("time/microseconds") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + Int(Microseconds() And $FFFF)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Bits_PopCount()
	If Not MicroCase("bits/popcount") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + PopCount(i)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Bits_LeadingZeros()
	If Not MicroCase("bits/leadingzeros") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + LeadingZeros(i)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Bits_TrailingZeros()
	If Not MicroCase("bits/trailingzeros") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + TrailingZeros(i)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Bits_RotL()
	If Not MicroCase("bits/rotl") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s Xor RotL(i, i And 31)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Bits_ByteSwap()
	If Not MicroCase("bits/byteswap") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s Xor ByteSwap(i)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Number_Byte()
	If Not MicroCase("number/byte") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + Byte(i)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Number_SatUByte()
	If Not MicroCase("number/satubyte") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + SatUByte(i And 511)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Number_Half()
	If Not MicroCase("number/half") Then Return
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + Half(i * MicroHalf#)
		Next
	Wend
	MicroSinkI = MicroSinkI + s
End Function

Function Pixels_ReadPixelFast64()
	If Not MicroCase("pixels/readpixelfast64") Then Return
	LockBuffer BackBuffer()
	s = 0
	While MicroRun()
		For i = 1 To MicroN
			s = s + Int(ReadPixelFast64(i And 255, (i Shr 8) And 127) And $FFFF)
		Next
	Wend
	UnlockBuffer BackBuffer()
	MicroSinkI = MicroSinkI + s
End Function

Function Pixels_WritePixelFast64()
	If Not MicroCase("pixels/writepixelfast64") Then Return
	LockBuffer BackBuffer()
	While MicroRun()
		For i = 1 To MicroN
			WritePixelFast64 i And 255, (i Shr 8) And 127, 0, MicroHalf#, 0.25, 1, 1
		Next
	Wend
	UnlockBuffer BackBuffer()
End Function

Function Sampler_SetTextureSampler()
	If Not MicroCase("sampler/settexturesampler") Then Return
	While MicroRun()
		For i = 1 To MicroN
			If i And 1 Then SetTextureSampler MicroTexture, MicroSampler Else SetTextureSampler MicroTexture, 0
		Next
	Wend
End Function

Function Sampler_Filter()
	If Not MicroCase("sampler/setsamplerfiltermin") Then Return
	While MicroRun()
		For i = 1 To MicroN
			SetSamplerFilterMin MicroSampler, i And 1
		Next
	Wend
End Function

Function Light_EntityLightChannel()
	If Not MicroCase("light/entitylightchannel") Then Return
	While MicroRun()
		For i = 1 To MicroN
			EntityLightChannel MicroCube, i And 63
		Next
	Wend
End Function
