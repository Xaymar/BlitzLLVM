; What many lights cost: a field of cubes lit by 8, 32 or 127 point lights, timing RenderWorld on the CPU. Works with
; the original Blitz3D too (which only lights with the first 8). Writes many_lights.txt next to the program.
Graphics3D 640, 360, 32, 2
SetBuffer BackBuffer()

Global seed = 12345
Function Rand01#()
	seed = (seed * 16807) Mod 2147483647
	Return Float(seed) / 2147483647.0
End Function

Const CUBES = 5000
camera = CreateCamera()
PositionEntity camera, 0, 40, -60
RotateEntity camera, 30, 0, 0
CameraRange camera, 0.5, 400
AmbientLight 20, 20, 20

Dim cubes(CUBES)
For i = 1 To CUBES
	cubes(i) = CreateCube()
	PositionEntity cubes(i), Rand01() * 200 - 100, 0, Rand01() * 200 - 100
Next

out = WriteFile("many_lights.txt")
Dim counts(2)
counts(0) = 8 : counts(1) = 32 : counts(2) = 127
Dim lamps(127)
used = 0
For c = 0 To 2
	While used < counts(c)
		lamps(used) = CreateLight(2)
		LightRange lamps(used), 15
		LightColor lamps(used), 120, 100, 80
		PositionEntity lamps(used), Rand01() * 200 - 100, 3, Rand01() * 200 - 100
		used = used + 1
	Wend
	For f = 1 To 30
		RenderWorld
		Flip
	Next
	Local t = MilliSecs()
	For f = 1 To 300
		RenderWorld
		Flip
	Next
	WriteLine out, counts(c) + " lights: " + ((MilliSecs() - t) / 300.0) + " ms/frame"
Next
CloseFile out
End
