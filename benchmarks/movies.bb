; Plays a movie to its end, drawing every picture with DrawMovie, and prints how many pictures it showed. The movie plays in
; real time, so what is measured is the CPU time that decoding, converting and drawing took (benchmarks/history.py reads it from
; the process). The original Blitz3D plays movies with DirectShow, which does not run on Linux, so only BlitzLLVM is measured.
;
; Environment variables:
;   BENCH_MOVIE   the movie to play
;   BENCH_RESULT  file to write the RESULT line to

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

Graphics 320, 240, 32, 2
SetBuffer BackBuffer()
movie = OpenMovie(Env$("BENCH_MOVIE", "bench.mp4"))
If movie = 0 Then RuntimeError "The movie could not be opened."
width = MovieWidth(movie)
height = MovieHeight(movie)
start = MilliSecs()
shown = 0
While MoviePlaying(movie)
	DrawMovie movie, 0, 0, 320, 240
	Flip
	Delay 15
	shown = shown + 1
Wend
elapsed = MilliSecs() - start
CloseMovie movie

result$ = "RESULT width=" + width + " height=" + height + " shown=" + shown + " wall_ms=" + elapsed
file = WriteFile(Env$("BENCH_RESULT", "movies_result.txt"))
If file <> 0
	WriteLine file, result$
	CloseFile file
EndIf
Print result$
