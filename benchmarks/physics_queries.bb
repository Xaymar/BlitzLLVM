; Times the queries of the physics bodies: rays, shape casts, overlaps and point tests against a floor and many bodies.
; BlitzLLVM only, the original has no physics bodies.
;
; Environment variables:
;   BENCH_GPU      graphics driver for SetGfxDriver (0 or unset: the default one)
;   BENCH_DEPTH    colour depth for Graphics3D (0 or unset: the default one)
;   BENCH_W        width of the window (default 640)
;   BENCH_H        height of the window (default 360)
;   BENCH_FRAMES   timed frames (default 3000)
;   BENCH_WARMUP   frames before the timing starts (default 30)
;   BENCH_SEED     seed of the scene and the queries (default 1)
;   BENCH_BODIES   bodies in a 40 x 40 area (default 1000): the first half static, the second dynamic, boxes and spheres in turn
;   BENCH_QUERY    0 none, 1 PhysicsRayCast, 2 PhysicsSphereCast, 3 PhysicsBoxCast (turned by yaw), 4 PhysicsCapsuleCast,
;                  5 PhysicsOverlapSphere, 6 PhysicsOverlapBox (turned by yaw), 7 PhysicsPointInside (default 0)
;   BENCH_QUERIES  queries per frame (default 1000)
;   BENCH_RESULT   file the result line is written to (default physics_queries.txt)
;
; Rays and casts are 10 units long, from random points in random directions. The query time is measured on its own and
; written as query_ms, next to the time of the whole frame (ms_avg) and of PhysicsUpdate (update_ms).
Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

Global BenchState = 1
Function BenchRnd#(low#, high#)
	BenchState = 16807 * (BenchState Mod 127773) - 2836 * (BenchState / 127773)
	If BenchState <= 0 Then BenchState = BenchState + 2147483647
	Return low + (high - low) * (BenchState / 2147483647.0)
End Function

gpu = Int(Env$("BENCH_GPU", "0"))
depth = Int(Env$("BENCH_DEPTH", "0"))
frames = Int(Env$("BENCH_FRAMES", "3000"))
warmup = Int(Env$("BENCH_WARMUP", "30"))
BenchState = Int(Env$("BENCH_SEED", "1"))
bodies = Int(Env$("BENCH_BODIES", "1000"))
query = Int(Env$("BENCH_QUERY", "0"))
queries = Int(Env$("BENCH_QUERIES", "1000"))
If query = 0 Then queries = 0

If gpu > 0 Then SetGfxDriver gpu
Graphics3D Int(Env$("BENCH_W", "640")), Int(Env$("BENCH_H", "360")), depth, 2
SetBuffer BackBuffer()

cam = CreateCamera()
PositionEntity cam, 0, 25, -35
PointEntity cam, CreatePivot()
light = CreateLight()
TurnEntity light, 45, 30, 0

ground = CreatePhysicsBody(1, 1, 25, 0.5, 25)
PositionEntity ground, 0, -0.5, 0
groundmesh = CreateCube(ground)
ScaleEntity groundmesh, 25, 0.5, 25
EntityColor groundmesh, 90, 110, 90

Local i
For i = 1 To bodies
	motion = 1
	If i > bodies / 2 Then motion = 3
	If i Mod 2 = 1
		hx# = BenchRnd(0.2, 0.8) : hy# = BenchRnd(0.2, 0.8) : hz# = BenchRnd(0.2, 0.8)
		b = CreatePhysicsBody(1, motion, hx, hy, hz)
		m = CreateCube(b)
		ScaleEntity m, hx, hy, hz
	Else
		r# = BenchRnd(0.2, 0.7)
		b = CreatePhysicsBody(2, motion, r, 0, 0)
		m = CreateSphere(8, b)
		ScaleEntity m, r, r, r
	EndIf
	If motion = 1
		PositionEntity b, BenchRnd(-20, 20), BenchRnd(0.5, 3), BenchRnd(-20, 20)
		RotateEntity b, 0, BenchRnd(0, 360), 0
		EntityColor m, 150, 150, 160
	Else
		PositionEntity b, BenchRnd(-20, 20), BenchRnd(3, 15), BenchRnd(-20, 20)
		EntityColor m, 220, 140, 60
	EndIf
Next

; The queries are made once, so that the timing has no random numbers in it
Const POOL = 8192
Dim qx#(POOL), qy#(POOL), qz#(POOL), ex#(POOL), ey#(POOL), ez#(POOL), qyaw#(POOL)
For i = 0 To POOL - 1
	qx(i) = BenchRnd(-20, 20) : qy(i) = BenchRnd(0.5, 6) : qz(i) = BenchRnd(-20, 20)
	dx# = BenchRnd(-1, 1) : dy# = BenchRnd(-1, 1) : dz# = BenchRnd(-1, 1)
	l# = Sqr(dx * dx + dy * dy + dz * dz)
	If l < 0.001 Then dx = 1 : dy = 0 : dz = 0 : l = 1
	ex(i) = qx(i) + 10 * dx / l : ey(i) = qy(i) + 10 * dy / l : ez(i) = qz(i) + 10 * dz / l
	qyaw(i) = BenchRnd(0, 360)
Next

Global hits = 0
Function DoQueries(query, queries, offset)
	Local k, j, h
	For k = 0 To queries - 1
		j = (offset + k) Mod POOL
		Select query
			Case 1
				h = PhysicsRayCast(qx(j), qy(j), qz(j), ex(j), ey(j), ez(j))
			Case 2
				h = PhysicsSphereCast(qx(j), qy(j), qz(j), ex(j), ey(j), ez(j), 0.3)
			Case 3
				h = PhysicsBoxCast(qx(j), qy(j), qz(j), ex(j), ey(j), ez(j), 0.3, 0.3, 0.3, 0, qyaw(j), 0)
			Case 4
				h = PhysicsCapsuleCast(qx(j), qy(j), qz(j), ex(j), ey(j), ez(j), 0.3, 0.5)
			Case 5
				h = PhysicsOverlapSphere(qx(j), qy(j), qz(j), 1.0)
			Case 6
				h = PhysicsOverlapBox(qx(j), qy(j), qz(j), 0.8, 0.8, 0.8, 0, qyaw(j), 0)
			Case 7
				h = PhysicsPointInside(qx(j), qy(j), qz(j))
		End Select
		If h Then hits = hits + 1
	Next
End Function

; Queries see the bodies as the last PhysicsUpdate left them, so the placed bodies are taken over first
PhysicsUpdate 0

For f = 1 To warmup
	PhysicsUpdate 1.0 / 60
	DoQueries query, queries, f * 977
	RenderWorld
	Flip False
Next
hits = 0

total:UInt64 = 0
querytime:UInt64 = 0
updatetime:UInt64 = 0
worst:UInt64 = 0
best:UInt64 = 1000000000
For f = 1 To frames
	t0:UInt64 = Microseconds()
	PhysicsUpdate 1.0 / 60
	t1:UInt64 = Microseconds()
	DoQueries query, queries, f * 977
	t2:UInt64 = Microseconds()
	RenderWorld
	Flip False
	t3:UInt64 = Microseconds()
	ft:UInt64 = t3 - t0
	total = total + ft
	updatetime = updatetime + (t1 - t0)
	querytime = querytime + (t2 - t1)
	If ft > worst Then worst = ft
	If ft < best Then best = ft
Next

msg$ = "RESULT physics_queries query=" + query + " queries=" + queries + " bodies=" + bodies + " frames=" + frames
msg$ = msg$ + " ms_avg=" + (Float(total) / frames / 1000.0) + " update_ms=" + (Float(updatetime) / frames / 1000.0)
msg$ = msg$ + " query_ms=" + (Float(querytime) / frames / 1000.0) + " frame_min_ms=" + (Float(best) / 1000.0) + " frame_max_ms=" + (Float(worst) / 1000.0)
msg$ = msg$ + " hits_per_frame=" + (Float(hits) / frames) + " driver=" + GfxDriverName$(gpu)
fh = WriteFile(Env$("BENCH_RESULT", "physics_queries.txt"))
WriteLine fh, msg$
CloseFile fh
End
