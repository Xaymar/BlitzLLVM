; Times the code that the compiler makes for the things programs do most: loops, arithmetic, math functions, arrays, types,
; strings, function calls, banks and branches. It uses only commands that the original Blitz3D has too (MilliSecs), so that the
; code of BlitzLLVM and of the original compiler can be compared. Needs no window.
;
; Environment variables:
;   BENCH_SCALE   multiplies the iterations of every test (default 1)
;   BENCH_RESULT  file to write the RESULT line to (the original has no console, so this is where its result is)
;
; Every test prints its time in milliseconds, and a checksum so that it can be seen that two compilers computed the same.

Type Node
	Field value
	Field weight#
End Type

Global Sink
Global SinkF#

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

Function Fib(n)
	If n < 2 Then Return n
	Return Fib(n - 1) + Fib(n - 2)
End Function

scale = Int(Env$("BENCH_SCALE", 1))
result$ = "RESULT"

; Integer loop and arithmetic.
t = MilliSecs()
sum = 0
For i = 1 To 20000000 * scale
	sum = sum + (i * 3) Xor (i Shr 2)
Next
result$ = result$ + " int_loop_ms=" + (MilliSecs() - t)
Sink = Sink + sum

; Float arithmetic.
t = MilliSecs()
f# = 0
For i = 1 To 10000000 * scale
	f = f + i * 0.5 - f * 0.001
Next
result$ = result$ + " float_loop_ms=" + (MilliSecs() - t)
SinkF = SinkF + f

; Math functions.
t = MilliSecs()
f = 0
For i = 1 To 2000000 * scale
	a# = i * 0.001
	f = f + Sin(a) * Cos(a) + Sqr(a) + Floor(a)
Next
result$ = result$ + " math_ms=" + (MilliSecs() - t)
SinkF = SinkF + f

; One dimensional array: reads and writes, with the index check.
Dim a1(1023)
t = MilliSecs()
For j = 1 To 10000 * scale
	For i = 0 To 1023
		a1(i) = a1(i) + i
	Next
Next
result$ = result$ + " array1_ms=" + (MilliSecs() - t)
Sink = Sink + a1(1000)

; Two dimensional array.
Dim a2(63, 63)
t = MilliSecs()
For j = 1 To 3000 * scale
	For y = 0 To 63
		For x = 0 To 63
			a2(x, y) = a2(x, y) + x + y
		Next
	Next
Next
result$ = result$ + " array2_ms=" + (MilliSecs() - t)
Sink = Sink + a2(40, 40)

; Types: a list of objects that is walked and changed.
For i = 1 To 1000
	n.Node = New Node
	n\value = i
	n\weight = i * 0.5
Next
t = MilliSecs()
For j = 1 To 10000 * scale
	For n.Node = Each Node
		n\value = n\value + 1
		n\weight = n\weight + 0.25
	Next
Next
result$ = result$ + " types_ms=" + (MilliSecs() - t)
For n.Node = Each Node
	Sink = Sink + n\value
Next

; Making and freeing objects.
t = MilliSecs()
For j = 1 To 2000 * scale
	For i = 1 To 100
		n.Node = New Node
		n\value = i
	Next
	For i = 1 To 100
		n.Node = Last Node
		Delete n
	Next
Next
result$ = result$ + " new_delete_ms=" + (MilliSecs() - t)

; Strings.
t = MilliSecs()
s$ = ""
total = 0
For j = 1 To 200 * scale
	s$ = ""
	For i = 1 To 500
		s$ = s$ + Chr$(65 + (i Mod 26))
	Next
	For i = 1 To 500
		total = total + Asc(Mid$(s$, i, 1)) + Len(Left$(s$, i))
	Next
Next
result$ = result$ + " strings_ms=" + (MilliSecs() - t)
Sink = Sink + total

; Function calls (recursive).
t = MilliSecs()
total = 0
For j = 1 To scale
	total = total + Fib(32)
Next
result$ = result$ + " calls_ms=" + (MilliSecs() - t)
Sink = Sink + total

; Banks.
bank = CreateBank(1048576)
t = MilliSecs()
For j = 1 To 40 * scale
	For i = 0 To 1048572 Step 4
		PokeInt bank, i, PeekInt(bank, i) + i
	Next
Next
result$ = result$ + " bank_ms=" + (MilliSecs() - t)
Sink = Sink + PeekInt(bank, 4096)
FreeBank bank

; Branches.
t = MilliSecs()
total = 0
For i = 1 To 10000000 * scale
	Select i Mod 5
		Case 0 : total = total + 1
		Case 1 : total = total + 2
		Case 2 : total = total + 3
		Case 3 : total = total - 1
		Default : total = total - 2
	End Select
Next
result$ = result$ + " select_ms=" + (MilliSecs() - t)
Sink = Sink + total

result$ = result$ + " checksum=" + Sink + " checksumf=" + Int(Abs(SinkF) Mod 1000)

file = WriteFile(Env$("BENCH_RESULT", "emitted_result.txt"))
If file <> 0
	WriteLine file, result$
	CloseFile file
EndIf
Print result$
