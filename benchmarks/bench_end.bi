; AUTOGENERATED COPYRIGHT HEADER END
; The shared end of the benchmarks, for BlitzLLVM and the original Blitz3D alike: draws the frames, times them and writes the result.
; Every benchmark has these functions, which this file calls:
;
;   BenchUpdate(frame)       before a frame, not timed (frame counts from 0, the warmup frames first)
;   BenchTimedUpdate(frame)  before a frame, timed: it is part of ms/frame, and update_ms on its own
;   BenchRender(frame)       draws the frame (RenderWorld, and whatever else the benchmark draws); timed, BenchFlip follows
;   BenchAfterFrame(frame)   after a frame, not timed (counting what was drawn, ...)
;   BenchFinish()            after the last frame, before the last picture is saved and the result is written
;   BenchResult$()           the benchmark's own values for the RESULT line, as " name=value name=value" (numbers only)
;
; The RESULT line has frames, warmup, seed, width, height, depth, create_ms, update_ms, ms_avg, ms_min, ms_median, ms_p95, ms_max, fps,
; and per frame tris (TrisRendered), draws, pipelines, textures and buffers (the Stats3D counters, 0 in the original).

If BenchCreateMs < 0 Then BenchEndCreation

Dim BenchTimes#(BenchFrames - 1)
bench_total# = 0 : bench_updates# = 0
bench_draws# = 0 : bench_pipelines# = 0 : bench_textures# = 0 : bench_buffers# = 0 : bench_tris# = 0

For bench_frame = 0 To BenchWarmup + BenchFrames - 1
	BenchUpdate bench_frame
	bench_start = BenchMicros()
	BenchTimedUpdate bench_frame
	bench_updated# = BenchMicros() - bench_start
	BenchRender bench_frame
	BenchFlip()
	bench_elapsed# = BenchMicros() - bench_start
	If bench_frame >= BenchWarmup Then
		BenchTimes(bench_frame - BenchWarmup) = bench_elapsed
		bench_total = bench_total + bench_elapsed
		bench_updates = bench_updates + bench_updated
		bench_draws = bench_draws + BenchDraws()
		bench_pipelines = bench_pipelines + BenchPipelines()
		bench_textures = bench_textures + BenchTextures()
		bench_buffers = bench_buffers + BenchBuffers()
		; Graphics (BenchGraphics2D) has no 3D scene to count.
		If BenchGraphics2D = 0 Then
			If BenchSceneTris >= 0 Then bench_tris = bench_tris + BenchSceneTris Else bench_tris = bench_tris + TrisRendered()
		EndIf
	EndIf
	BenchAfterFrame bench_frame
Next

BenchFinish

bench_shot$ = GetEnv$("BENCH_SHOT")
If bench_shot$ <> "" Then SaveBuffer BackBuffer(), bench_shot$

; Sorting the times (a Shell sort) gives the median and the 95th percentile.
Dim BenchSorted#(BenchFrames - 1)
For bench_i = 0 To BenchFrames - 1
	BenchSorted(bench_i) = BenchTimes(bench_i)
Next
bench_gap = BenchFrames / 2
While bench_gap > 0
	For bench_i = bench_gap To BenchFrames - 1
		bench_v# = BenchSorted(bench_i)
		bench_j = bench_i
		; And does not skip the second test, so the index is checked first.
		While bench_j >= bench_gap
			If BenchSorted(bench_j - bench_gap) <= bench_v Then Exit
			BenchSorted(bench_j) = BenchSorted(bench_j - bench_gap)
			bench_j = bench_j - bench_gap
		Wend
		BenchSorted(bench_j) = bench_v
	Next
	bench_gap = bench_gap / 2
Wend
bench_p95 = Int(BenchFrames * 0.95)
If bench_p95 > BenchFrames - 1 Then bench_p95 = BenchFrames - 1

bench_file$ = GetEnv$("BENCH_FRAMETIMES")
If bench_file$ <> "" Then
	bench_out = WriteFile(bench_file$)
	If bench_out <> 0 Then
		For bench_i = 0 To BenchFrames - 1
			WriteLine bench_out, Int(BenchTimes(bench_i))
		Next
		CloseFile bench_out
	EndIf
EndIf

bench_avg# = bench_total / BenchFrames / 1000
bench_result$ = "RESULT frames=" + BenchFrames + " warmup=" + BenchWarmup + " seed=" + BenchSeed + " width=" + GraphicsWidth() + " height=" + GraphicsHeight() + " depth=" + GraphicsDepth()
bench_result$ = bench_result$ + " create_ms=" + BenchCreateMs + " update_ms=" + (bench_updates / BenchFrames / 1000)
bench_result$ = bench_result$ + " ms_avg=" + bench_avg + " ms_min=" + (BenchSorted(0) / 1000) + " ms_median=" + (BenchSorted(BenchFrames / 2) / 1000) + " ms_p95=" + (BenchSorted(bench_p95) / 1000) + " ms_max=" + (BenchSorted(BenchFrames - 1) / 1000) + " fps=" + (1000 / bench_avg)
bench_result$ = bench_result$ + " tris=" + Int(bench_tris / BenchFrames) + " draws=" + Int(bench_draws / BenchFrames) + " pipelines=" + Int(bench_pipelines / BenchFrames) + " textures=" + Int(bench_textures / BenchFrames) + " buffers=" + Int(bench_buffers / BenchFrames)
bench_result$ = bench_result$ + BenchResult$()
BenchWriteResult bench_result$
End
