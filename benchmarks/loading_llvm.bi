; BlitzLLVM side of the loading benchmark: a microsecond timer, AsyncLoading and TextureReady.

Global BenchBase:UInt64 = Microseconds()

Function BenchMicros()
	Return Int(Microseconds() - BenchBase)
End Function

Function BenchAsync(on)
	AsyncLoading on
End Function

Function BenchReady(texture)
	Return TextureReady(texture)
End Function
