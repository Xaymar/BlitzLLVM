; Times UpdateWorld alone: movers that collide with static scenery, and animated models. Runs with BlitzLLVM and the original.
;
; Environment variables:
;   BENCH_MOVERS   spheres that move every frame and collide (default 200)
;   BENCH_STATIC   static cubes that are collided with (default 2000)
;   BENCH_METHOD   collision method of the cubes, 1 sphere, 2 polygon, 3 box (default 2)
;   BENCH_PIVOTS   idle entities in a chain-free hierarchy, children of pivots (default 0)
;   BENCH_ANIM     path of a model with bones (optional), BENCH_ANIMS copies of it are looped (default 0)
;   BENCH_FRAMES   timed frames (default 300)
Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

Global BenchState = 1
Function BenchRnd#(low#, high#)
	BenchState = 16807 * (BenchState Mod 127773) - 2836 * (BenchState / 127773)
	If BenchState <= 0 Then BenchState = BenchState + 2147483647
	Return low + (high - low) * (BenchState / 2147483647.0)
End Function

movers = Int(Env$("BENCH_MOVERS", 200))
statics = Int(Env$("BENCH_STATIC", 2000))
method = Int(Env$("BENCH_METHOD", 2))
pivots = Int(Env$("BENCH_PIVOTS", 0))
frames = Int(Env$("BENCH_FRAMES", 300))

cam = CreateCamera()
MoveEntity cam, 0, 0, -50
Dim mv(movers), vx#(movers), vz#(movers)
Local i
cube = CreateCube()
For i = 1 To statics
	c = CopyEntity(cube)
	; Scenery spread over a 200 x 200 field
	PositionEntity c, BenchRnd(-100, 100), BenchRnd(0, 4), BenchRnd(-100, 100)
	ScaleEntity c, BenchRnd(0.5, 2), BenchRnd(0.5, 2), BenchRnd(0.5, 2)
	EntityType c, 2
	If method = 3 Then EntityBox c, -1, -1, -1, 2, 2, 2
Next
For i = 1 To movers
	mv(i) = CreateSphere(6)
	EntityType mv(i), 1
	EntityRadius mv(i), 0.5
	PositionEntity mv(i), BenchRnd(-100, 100), 2, BenchRnd(-100, 100)
	vx(i) = BenchRnd(-0.3, 0.3)
	vz(i) = BenchRnd(-0.3, 0.3)
Next
For i = 1 To pivots
	p = CreatePivot()
	PositionEntity p, BenchRnd(-100, 100), 0, BenchRnd(-100, 100)
	c = CreatePivot(p)
Next
anims = Int(Env$("BENCH_ANIMS", 0))
If anims > 0
	model = LoadAnimMesh(Env$("BENCH_ANIM", ""))
	For i = 1 To anims
		a = CopyEntity(model)
		PositionEntity a, BenchRnd(-20, 20), 0, BenchRnd(-20, 20)
		Animate a, 1, 1.0
	Next
	HideEntity model
EndIf
Collisions 1, 2, method, 2
If Env$("BENCH_SELF", "1") = "1" Then Collisions 1, 1, 1, 2

For i = 1 To 5
	UpdateWorld
	RenderWorld
	Flip False
Next
total = 0
t0 = MilliSecs()
For f = 1 To frames
	For i = 1 To movers
		TranslateEntity mv(i), vx(i), 0, vz(i)
		If EntityX(mv(i)) > 100 Or EntityX(mv(i)) < -100 Then vx(i) = -vx(i)
		If EntityZ(mv(i)) > 100 Or EntityZ(mv(i)) < -100 Then vz(i) = -vz(i)
	Next
	t1 = MilliSecs()
	UpdateWorld
	total = total + MilliSecs() - t1
	RenderWorld
	Flip False
Next
msg$ = "RESULT updateworld movers=" + movers + " static=" + statics + " method=" + method + " pivots=" + pivots + " anims=" + anims + " ms/frame=" + (Float(total) / frames) + " tris=" + Stats3D(0)
WriteLine_ msg$
End

Function WriteLine_(m$)
	f = WriteFile(GetEnv$("BENCH_RESULT"))
	WriteLine f, m$
	CloseFile f
End Function
