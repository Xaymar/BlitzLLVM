; Pick oracle: a fixed scene of pickable spheres (pick mode 1), polygon meshes (2) and boxes (3), and a fixed list of picks:
; LinePick with and without a radius, EntityPick, EntityVisible and CameraPick. Every result and every Picked* value is written to a
; text file, so two compilers (or two pick backends) can be compared line by line. The time all the picks took is written to a second
; file, so that it can be used as a benchmark too (use many entities and picks, and only on the original or BlitzLLVM on a real machine).
; Works with the original Blitz3D compiler and BlitzLLVM.
;
; Environment variables:
;   PICK_OUT       output file (default pick_oracle.txt), the time goes to the same name with .time added
;   PICK_ENTITIES  entities of every pick mode (default 30)
;   PICK_COUNT     LinePick calls (default 400); EntityPick, EntityVisible and CameraPick calls are a fifth of that each
Graphics3D 320, 240, 32, 2
SetBuffer BackBuffer()

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

; The same numbers in every compiler, and a call of it is never an argument of another call (the original evaluates arguments in another order).
Global OracleState = 1
Function R#(low#, high#)
	OracleState = 16807 * (OracleState Mod 127773) - 2836 * (OracleState / 127773)
	If OracleState <= 0 Then OracleState = OracleState + 2147483647
	Return low + (high - low) * (OracleState / 2147483647.0)
End Function

; The original gives pointers as handles, so entities and surfaces are written as numbers: the creation number of the entity and the
; index of the surface on it.
Dim ents(2000)
Global entCount = 0
Function Reg(e)
	entCount = entCount + 1
	ents(entCount) = e
	Return e
End Function

Function IdOf(e)
	For k = 1 To entCount
		If ents(k) = e Then Return k
	Next
	Return 0
End Function

Function SurfaceIdOf(e, surf)
	If e = 0 Then Return 0
	For k = 1 To CountSurfaces(e)
		If GetSurface(e, k) = surf Then Return k
	Next
	Return 0
End Function

; Written in units of 0.0001, so that no float formatting differs between the compilers.
Function F$(v#)
	Return Int(v * 10000 + 0.5 * Sgn(v))
End Function

Function Result$(label$, e)
	line$ = label$ + " " + IdOf(e)
	If e <> 0 Then
		line$ = line$ + " " + F(PickedX()) + " " + F(PickedY()) + " " + F(PickedZ()) + " " + F(PickedNX()) + " " + F(PickedNY()) + " " + F(PickedNZ()) + " " + F(PickedTime())
		line$ = line$ + " " + SurfaceIdOf(e, PickedSurface()) + " " + PickedTriangle()
	EndIf
	Return line$
End Function

out$ = Env$("PICK_OUT", "pick_oracle.txt")
count = Int(Env$("PICK_COUNT", "400"))
many = Int(Env$("PICK_ENTITIES", "30"))
file = WriteFile(out$)

cam = CreateCamera()
PositionEntity cam, 0, 20, -60
RotateEntity cam, 15, 0, 0
CameraViewport cam, 0, 0, 320, 240
CreateLight()

; Scenery: spheres (mode 1), polygon meshes (mode 2, they block sight for EntityVisible), boxes (mode 3, they do not). The positions come from the generator, one value per call.
For i = 1 To many
	x# = R(-40, 40)
	y# = R(0, 8)
	z# = R(-40, 40)
	s# = R(0.8, 2.5)
	e = Reg(CreateSphere(6))
	PositionEntity e, x, y, z
	ScaleEntity e, s, s, s
	EntityRadius e, s
	EntityPickMode e, 1

	x# = R(-40, 40)
	y# = R(0, 8)
	z# = R(-40, 40)
	s# = R(0.8, 2.5)
	If i Mod 2 = 0 Then e = Reg(CreateCube()) Else e = Reg(CreateCone(8))
	PositionEntity e, x, y, z
	ScaleEntity e, s, s, s
	ax# = R(0, 90)
	ay# = R(0, 360)
	az# = R(0, 90)
	RotateEntity e, ax, ay, az
	EntityPickMode e, 2, True

	x# = R(-40, 40)
	y# = R(0, 8)
	z# = R(-40, 40)
	s# = R(0.8, 2.5)
	e = Reg(CreateCube())
	PositionEntity e, x, y, z
	ScaleEntity e, s, s, s
	EntityBox e, -1, -1, -1, 2, 2, 2
	EntityPickMode e, 3
Next

; Pivots that EntityPick looks from, and EntityVisible runs between
Dim from(count / 5 + 1), toward(count / 5 + 1)
For i = 1 To count / 5
	from(i) = Reg(CreatePivot())
	x# = R(-45, 45)
	y# = R(0, 8)
	z# = R(-45, 45)
	PositionEntity from(i), x, y, z
	ax# = R(-30, 30)
	ay# = R(0, 360)
	RotateEntity from(i), ax, ay, 0
	toward(i) = Reg(CreatePivot())
	x# = R(-45, 45)
	y# = R(0, 8)
	z# = R(-45, 45)
	PositionEntity toward(i), x, y, z
Next

; The scene as built, so that a difference in it is not mistaken for a difference of the picks
For k = 1 To entCount
	WriteLine file, "ent " + k + " " + F(EntityX(ents(k), True)) + " " + F(EntityY(ents(k), True)) + " " + F(EntityZ(ents(k), True)) + " " + F(EntityPitch(ents(k), True)) + " " + F(EntityYaw(ents(k), True)) + " " + F(EntityRoll(ents(k), True))
Next

start = MilliSecs()
For i = 1 To count
	ox# = R(-45, 45)
	oy# = R(0, 10)
	oz# = R(-45, 45)
	dx# = R(-30, 30)
	dy# = R(-8, 8)
	dz# = R(-30, 30)
	radius# = 0
	If i Mod 2 = 1 Then radius = 0.5
	e = LinePick(ox, oy, oz, dx, dy, dz, radius)
	WriteLine file, Result$("line " + i, e)
Next
For i = 1 To count / 5
	e = EntityPick(from(i), 40)
	WriteLine file, Result$("entity " + i, e)
Next
For i = 1 To count / 5
	WriteLine file, "visible " + i + " " + EntityVisible(from(i), toward(i))
Next
For i = 1 To count / 5
	px# = R(0, 320)
	py# = R(0, 240)
	e = CameraPick(cam, px, py)
	WriteLine file, Result$("camera " + i, e)
Next
elapsed = MilliSecs() - start
CloseFile file
tf = WriteFile(out$ + ".time")
WriteLine tf, elapsed
CloseFile tf
End
