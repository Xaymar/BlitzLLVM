; Does drawing to FrontBuffer() cost more than drawing to BackBuffer()? Every frame clears the buffer, draws a fixed set of 2D
; shapes and text, and calls Flip (BenchFlip: without waiting for the display). In the original Blitz3D the front buffer is the picture
; on the screen; in BlitzLLVM it is the back buffer (FrontBuffer() = BackBuffer()), so the two should take the same time there.
; Windowed only: python3 benchmarks/frontbuffer.py builds and runs it.
;
; Environment variables:
;   BENCH_BUFFER  front or back, the buffer that is drawn to (default back)
;   BENCH_DRAWS   shapes per frame (default 2000)
;   and the ones of every benchmark (frames, warmup, window, depth, GPU, files), see bench_begin.bi.
;
; Runs with BlitzLLVM and with the original Blitz3D: what differs between them is in bench_llvm.bi and bench_original.bi,
; python3 benchmarks/frontbuffer.py copies the right one next to this file as bench_compiler.bi.
Include "bench_compiler.bi"
; Only 2D: the window is opened with Graphics.
BenchGraphics2D = 1
Include "bench_begin.bi"

Global width = GraphicsWidth()
Global height = GraphicsHeight()
Global mode$ = Env$("BENCH_BUFFER", "back")
If mode$ = "front" Then SetBuffer FrontBuffer() Else SetBuffer BackBuffer()
Global draws = Int(Env$("BENCH_DRAWS", 2000))

; The next number of the generator of bench_begin.bi (Park-Miller), from 0 to range - 1.
Function BenchNext(range)
	BenchState = 16807 * (BenchState Mod 127773) - 2836 * (BenchState / 127773)
	If BenchState <= 0 Then BenchState = BenchState + 2147483647
	Return BenchState Mod range
End Function

Include "bench_end.bi"

Function BenchUpdate(frame)
End Function

Function BenchTimedUpdate(frame)
End Function

; Every frame draws the same shapes: the generator starts at the number of the frame.
Function BenchRender(frame)
	BenchState = frame + 1
	Cls
	For i = 1 To draws
		kind = i Mod 4
		x = BenchNext(width)
		y = BenchNext(height)
		Color 64 + BenchNext(192), 64 + BenchNext(192), 64 + BenchNext(192)
		If kind = 0 Then Rect x, y, 8 + BenchNext(40), 8 + BenchNext(40), 1
		If kind = 1 Then Line x, y, BenchNext(width), BenchNext(height)
		If kind = 2 Then Oval x, y, 8 + BenchNext(30), 8 + BenchNext(30), 0
		If kind = 3 Then Text x, y, "Blitz"
	Next
End Function

Function BenchAfterFrame(frame)
End Function

Function BenchFinish()
End Function

Function BenchResult$()
	front = 0
	If mode$ = "front" Then front = 1
	Return " front=" + front + " shapes=" + draws
End Function
