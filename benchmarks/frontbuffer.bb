; Does drawing to FrontBuffer() cost more than drawing to BackBuffer()? Every frame clears the buffer, draws a fixed set of 2D
; shapes and text, and calls Flip. In the original Blitz3D the front buffer is the picture on the screen; in BlitzLLVM it is the
; back buffer (FrontBuffer() = BackBuffer()), so the two should take the same time there.
; Runs with BlitzLLVM and with the original Blitz3D: the timer is in frontbuffer_llvm.bi or frontbuffer_original.bi, and
; python3 benchmarks/frontbuffer.py copies the right one next to this file as frontbuffer_counters.bi. Windowed only.
;
; Environment variables:
;   BENCH_BUFFER  front or back, the buffer that is drawn to (default back)
;   BENCH_DRAWS   shapes per frame (default 2000)
;   BENCH_FRAMES  frames that are timed (default 600)
;   BENCH_WARMUP  frames that are drawn but not timed (default 10)
;   BENCH_W, BENCH_H  size of the window (default 640 x 360)
;   BENCH_RESULT  file to write the RESULT line to (the original has no stdout)
Include "frontbuffer_counters.bi"

Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

; Park-Miller, like the other benchmarks, because Rnd differs between the compilers.
Global BenchState = 1

Function BenchNext(range)
	BenchState = 16807 * (BenchState Mod 127773) - 2836 * (BenchState / 127773)
	If BenchState <= 0 Then BenchState = BenchState + 2147483647
	Return BenchState Mod range
End Function

width = Int(Env$("BENCH_W", 640))
height = Int(Env$("BENCH_H", 360))
Graphics width, height, 32, 2
mode$ = Env$("BENCH_BUFFER", "back")
If mode$ = "front" Then SetBuffer FrontBuffer() Else SetBuffer BackBuffer()

draws = Int(Env$("BENCH_DRAWS", 2000))
frames = Int(Env$("BENCH_FRAMES", 600))
warmup = Int(Env$("BENCH_WARMUP", 10))

total = 0
shortest = 2147483647
longest = 0
For frame = 0 To warmup + frames - 1
	start = BenchMicros()
	BenchState = frame + 1
	Cls
	For i = 1 To draws
		kind = i Mod 4
		x = BenchNext(width)
		y = BenchNext(height)
		Color 64 + BenchNext(192), 64 + BenchNext(192), 64 + BenchNext(192)
		If kind = 0 Then Rect x, y, 8 + BenchNext(40), 8 + BenchNext(40), 1
		If kind = 1 Then Line x, y, BenchNext(width), BenchNext(height)
		If kind = 2 Then Oval x, y, 8 + BenchNext(30), 8 + BenchNext(30), 0
		If kind = 3 Then Text x, y, "Blitz"
	Next
	Flip
	elapsed = BenchMicros() - start
	If frame >= warmup Then
		total = total + elapsed
		If elapsed < shortest Then shortest = elapsed
		If elapsed > longest Then longest = elapsed
	EndIf
Next

line$ = "RESULT buffer=" + mode$ + " draws=" + draws + " frames=" + frames + " avg_us=" + (total / frames) + " min_us=" + shortest + " max_us=" + longest
file = WriteFile(Env$("BENCH_RESULT", "frontbuffer_result.txt"))
WriteLine file, line$
CloseFile file
End
