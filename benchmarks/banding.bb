; Smallest test for the color banding of stacked see-through layers (sorted transparency, no OIT).
;
; A dark-to-bright gradient (one pixel column per level) is covered by LAYERS full-screen layers of one color with the same alpha.
; The exact result of the stack is   bg * (1 - alpha)^LAYERS + layer * (1 - (1 - alpha)^LAYERS)   in floating point; the program
; reads the middle row of the 8 bit buffer and compares it with that. A bias (mean error far from 0) means every blend rounds the
; same way, and a "longest run" much above the expected one means bands.
;
;   BAND_LAYERS  number of layers (default 100)       BAND_ALPHA  alpha of each layer (default 0.05)
;   BAND_COLOR   gray value of the layers, 0 to 255 (default 0)
;   BAND_DEPTH   buffer depth, 32 if not set          BAND_DITHER  Dither level, 0 if not set
;   BAND_GPU     driver number for SetGfxDriver (1 to CountGfxDrivers; all are listed on start), the default GPU if not set
;   BAND_SAVE    file name to save the picture to     BAND_CSV  file to write "x,bg,got,exact" lines to
; Result line on stdout and in BAND_RESULT if set.
Function Env$(name$, fallback$)
	value$ = GetEnv$(name$)
	If value$ = "" Then value$ = fallback$
	Return value$
End Function

Const W = 256, H = 64
layers = Int(Env$("BAND_LAYERS", "100"))
alpha# = Float(Env$("BAND_ALPHA", "0.05"))
lcol = Int(Env$("BAND_COLOR", "0"))
gpu = Int(Env$("BAND_GPU", "0"))
For i = 1 To CountGfxDrivers()
	Print i + ": " + GfxDriverName$(i)
Next
If gpu > 0 Then SetGfxDriver gpu : Print "Using driver " + gpu + ": " + GfxDriverName$(gpu)
Graphics3D W, H, Int(Env$("BAND_DEPTH", "32")), 2
SetBuffer BackBuffer()
Dither Int(Env$("BAND_DITHER", "0"))
camera = CreateCamera()
CameraProjMode camera, 2
CameraZoom camera, 0.1
CameraClsColor camera, 0, 0, 0
CameraRange camera, 0.1, 100

Function Quad(z#)
	m = CreateMesh()
	s = CreateSurface(m)
	AddVertex s, -1000, -1000, z : AddVertex s, 1000, -1000, z : AddVertex s, 1000, 1000, z : AddVertex s, -1000, 1000, z
	AddTriangle s, 0, 3, 2 : AddTriangle s, 0, 2, 1
	EntityFX m, 1
	Return m
End Function

; Gradient floor: vertex colors 0 to 255 from the left to the right edge of the view.
half# = 1.0 ; half the visible width of the orthographic view at CameraZoom 0.1 (measured)
back = CreateMesh()
s = CreateSurface(back)
AddVertex s, -half, -half, 10 : AddVertex s, half, -half, 10 : AddVertex s, half, half, 10 : AddVertex s, -half, half, 10
VertexColor s, 0, 0, 0, 0 : VertexColor s, 1, 255, 255, 255 : VertexColor s, 2, 255, 255, 255 : VertexColor s, 3, 0, 0, 0
AddTriangle s, 0, 3, 2 : AddTriangle s, 0, 2, 1
EntityFX back, 1 + 2

Dim bg(W - 1), got(W - 1)
RenderWorld
For x = 0 To W - 1
	bg(x) = ReadPixel(x, H / 2) And $FF
Next

For i = 1 To layers
	l = Quad(9.9 - i * 0.001)
	EntityColor l, lcol, lcol, lcol
	EntityAlpha l, alpha
	EntityBlend l, 1
Next
RenderWorld
For x = 0 To W - 1
	got(x) = ReadPixel(x, H / 2) And $FF
Next
If GetEnv$("BAND_SAVE") <> "" Then SaveBuffer BackBuffer(), GetEnv$("BAND_SAVE")

keep# = (1.0 - alpha) ^ layers
sum# = 0 : sumabs# = 0 : maxabs# = 0 : n = 0
run = 1 : longest = 1 : erun = 1 : elongest = 1 : distinct = 1 : edistinct = 1
csv$ = GetEnv$("BAND_CSV")
If csv$ <> "" Then f = WriteFile(csv$)
For x = 0 To W - 1
	exact# = bg(x) * keep + lcol * (1.0 - keep)
	If csv$ <> "" Then WriteLine f, x + "," + bg(x) + "," + got(x) + "," + exact
	If bg(x) > 0 And bg(x) < 255 Then
		e# = got(x) - exact
		sum = sum + e : If Abs(e) > maxabs Then maxabs = Abs(e)
		sumabs = sumabs + Abs(e) : n = n + 1
	EndIf
	If x > 0 Then
		If got(x) = got(x - 1) Then run = run + 1 : If run > longest Then longest = run
		If got(x) <> got(x - 1) Then run = 1 : distinct = distinct + 1
		If Floor(exact + 0.5) = Floor(prev# + 0.5) Then erun = erun + 1 : If erun > elongest Then elongest = erun
		If Floor(exact + 0.5) <> Floor(prev + 0.5) Then erun = 1 : edistinct = edistinct + 1
	EndIf
	prev# = exact
Next
If csv$ <> "" Then CloseFile f
r$ = "gpu=" + gpu + " layers=" + layers + " alpha=" + alpha + " color=" + lcol + " depth=" + Env$("BAND_DEPTH", "32") + " dither=" + Env$("BAND_DITHER", "0")
r$ = r$ + " meanerr=" + Left$(Str$(sum / n), 7) + " meanabs=" + Left$(Str$(sumabs / n), 6) + " maxabs=" + Left$(Str$(maxabs), 5)
r$ = r$ + " distinct=" + distinct + "/" + edistinct + " longestrun=" + longest + "/" + elongest
Print r$
If GetEnv$("BAND_RESULT") <> "" Then
	f = WriteFile(GetEnv$("BAND_RESULT"))
	WriteLine f, r$
	CloseFile f
EndIf
End
