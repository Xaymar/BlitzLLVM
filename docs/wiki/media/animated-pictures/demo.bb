Graphics3D 320, 200, 32, 2
SetBuffer BackBuffer()
camera = CreateCamera()
CameraClsColor camera, 60, 80, 120
cube = CreateCube()
EntityFX cube, 1
PositionEntity cube, 1.2, 0, 4
TurnEntity cube, 20, 30, 0
ClearTextureFilters
tex = LoadAnimTexture("spinner.gif", 1, 0, 0, 0, 0)
img = LoadAnimImage("spinner.gif", 0, 0, 0, 0)
Print_ = 0
frame = 0
elapsed = 0
For shot = 0 To TextureFrames(tex) - 1
	Cls
	EntityTexture cube, tex, shot
	RenderWorld
	DrawImage img, 40, 70, shot
	Color 255, 255, 255
	Text 8, 8, "frame " + shot + "/" + TextureFrames(tex) + "  delay " + TextureFrameDelay(tex, shot) + " ms"
	SaveBuffer BackBuffer(), "shot" + Right("0" + shot, 2) + ".bmp"
	Flip
Next
EndGraphics
