[submodule "third_party/blitz3d"]
	path = third_party/blitz3d
	url = https://github.com/blitz-research/blitz3d.git
	shallow = true
[submodule "third_party/blitz3d_soloud"]
	path = third_party/blitz3d_soloud
	url = https://github.com/blitz-research/blitz3d_soloud.git
	shallow = true
[submodule "extra/blitzplus_msvc2017"]
	path = extra/blitzplus_msvc2017
	url = https://github.com/blitz-research/blitzplus_msvc2017.git
	shallow = true
[submodule "cmake/version"]
	path = cmake/version
	url = https://github.com/Xaymar/cmake-version.git
	shallow = true
[submodule "cmake/externalcontent"]
	path = cmake/externalcontent
	url = https://github.com/Xaymar/cmake-externalcontent.git
	shallow = true
[submodule "third_party/Vulkan-Headers"]
	path = third_party/Vulkan-Headers
	url = https://github.com/KhronosGroup/Vulkan-Headers
	shallow = true
[submodule "third_party/SDL"]
	path = third_party/SDL
	url = https://github.com/libsdl-org/SDL
	shallow = true
[submodule "third_party/SDL_image"]
	path = third_party/SDL_image
	url = https://github.com/libsdl-org/SDL_image
	shallow = true
	ignore = all
[submodule "third_party/SDL_mixer"]
	path = third_party/SDL_mixer
	url = https://github.com/libsdl-org/SDL_mixer
	shallow = true
[submodule "third_party/stb"]
	path = third_party/stb
	url = https://github.com/nothings/stb
	shallow = true
[submodule "third_party/FFmpeg"]
	path = third_party/FFmpeg
	url = https://github.com/FFmpeg/FFmpeg.git
	shallow = true
	branch = release/7.1
[submodule "third_party/VulkanMemoryAllocator"]
	path = third_party/VulkanMemoryAllocator
	url = https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
	shallow = true
