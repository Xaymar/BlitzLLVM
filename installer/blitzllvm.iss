; AUTOGENERATED COPYRIGHT HEADER END
; Windows installer of BlitzLLVM, built with Inno Setup 6 (https://jrsoftware.org/isinfo.php) from the directory that
; "cmake --install build --prefix dist" produces:
;
;   ISCC.exe /DAppVersion=2026.11.1.30475 /DArch=x64 /DSourceDir=C:\path\to\dist /DOutputDir=C:\path\to\packages /DOutputName=blitzllvm-setup installer\blitzllvm.iss
;
; Defines: AppVersion (numeric A.B.C.D), Arch (x64 or arm64), SourceDir, OutputDir (both absolute: relative paths are taken from this script), OutputName (without .exe).
;
; BlitzLLVM needs a clang with lld (LLVM 23 or newer) to build programs. The installer looks for one on PATH and in the places the LLVM installer
; uses (its registry key and C:\Program Files\LLVM\bin). If there is none it offers to run "winget install -e --id LLVM.LLVM".
; Silent installs ask nothing and install nothing but BlitzLLVM, unless /INSTALLLLVM=yes is given.

#ifndef AppVersion
#error AppVersion is not defined.
#endif
#ifndef Arch
#define Arch "x64"
#endif
#ifndef SourceDir
#define SourceDir "dist"
#endif
#ifndef OutputDir
#define OutputDir "packages"
#endif
#ifndef OutputName
#define OutputName "blitzllvm-setup"
#endif

[Setup]
; Never change the AppId, it is how upgrades and the uninstaller find an installation.
AppId={{7B1F5F52-3C0D-4C6E-9D3A-B17A21C0DE10}
AppName=BlitzLLVM
AppVersion={#AppVersion}
AppVerName=BlitzLLVM {#AppVersion}
AppPublisher=Xaymar
AppPublisherURL=https://github.com/Xaymar/BlitzLLVM
AppSupportURL=https://github.com/Xaymar/BlitzLLVM/issues
AppUpdatesURL=https://github.com/Xaymar/BlitzLLVM/releases
VersionInfoVersion={#AppVersion}
DefaultDirName={localappdata}\Programs\BlitzLLVM
DefaultGroupName=BlitzLLVM
DisableProgramGroupPage=yes
LicenseFile={#SourceDir}\LICENSE.adoc
OutputDir={#OutputDir}
OutputBaseFilename={#OutputName}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
; A per-user app: installs to %LocalAppData%\Programs\BlitzLLVM, writes only to HKCU and never asks for administrator rights.
PrivilegesRequired=lowest
ChangesEnvironment=yes
UninstallDisplayName=BlitzLLVM
#if Arch == "arm64"
ArchitecturesAllowed=arm64
ArchitecturesInstallIn64BitMode=arm64
#else
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
#endif

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "addtopath"; Description: "Add BlitzLLVM to the &PATH (so that blitzcc, blitz-format and blitz-tidy can be run from any terminal)"

[Files]
Source: "{#SourceDir}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\BlitzLLVM Help"; Filename: "{app}\help\index.html"; Check: DirExists(ExpandConstant('{app}\help'))
Name: "{group}\BlitzLLVM Readme"; Filename: "{app}\README.adoc"
Name: "{group}\Uninstall BlitzLLVM"; Filename: "{uninstallexe}"

[Registry]
; blitzcc starts the clang it finds on PATH, or the one in BLITZLLVM_CC. The LLVM installer does not add itself to PATH by default,
; so when clang is only found in its own folder, BLITZLLVM_CC points blitzcc there. Removed again by the uninstaller.
Root: HKCU; Subkey: "Environment"; ValueType: string; ValueName: "BLITZLLVM_CC"; ValueData: "{code:ClangToSet}"; Flags: uninsdeletevalue; Check: SetClangVariable

[Code]
const
  WingetCommand = 'winget install -e --id LLVM.LLVM --accept-package-agreements --accept-source-agreements';
  MinClangMajor = 23;
  WingetUpgradeCommand = 'winget upgrade -e --id LLVM.LLVM --accept-package-agreements --accept-source-agreements';
  LlvmDownloadUrl = 'https://github.com/llvm/llvm-project/releases';

var
  LlvmPage: TWizardPage;
  LlvmInfo: TNewStaticText;
  LlvmInstallBox: TNewCheckBox;
  ClangPath: String;        // Full path of the clang that blitzcc will use, empty when there is none.
  ClangOnPath: Boolean;     // That clang is found through PATH already.
  WingetAvailable: Boolean;
  LlvmInstallFailed: Boolean;
  OldClangPath: String;     // A clang with lld that was found but is older than MinClangMajor.

const
  EnvironmentKey = 'Environment';   // The environment of the current user.

// ---- Finding LLVM ----------------------------------------------------------------------------------------------------

function ClangComplete(const Dir: String): Boolean;
begin
  // clang compiles, lld links (the LLVM installer ships it as lld-link.exe, ld.lld.exe and lld.exe).
  Result := FileExists(AddBackslash(Dir) + 'clang.exe') and
            (FileExists(AddBackslash(Dir) + 'ld.lld.exe') or FileExists(AddBackslash(Dir) + 'lld.exe'));
end;

function ClangMajor(const Dir: String): Integer;
var
  Tmp, Cmd: String;
  Lines: TArrayOfString;
  ResultCode, P, I: Integer;
  Text: String;
begin
  // "clang --version" prints "clang version 23.1.4" (or "... clang version ..." with a vendor in front) on its first lines.
  Result := 0;
  Tmp := ExpandConstant('{tmp}\clang-version.txt');
  DeleteFile(Tmp);
  Cmd := '/C ""' + AddBackslash(Dir) + 'clang.exe" --version > "' + Tmp + '" 2>&1"';
  if not Exec(ExpandConstant('{cmd}'), Cmd, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    Exit;
  if not LoadStringsFromFile(Tmp, Lines) then
    Exit;
  for I := 0 to GetArrayLength(Lines) - 1 do begin
    Text := Lines[I];
    P := Pos('clang version ', Text);
    if P > 0 then begin
      Delete(Text, 1, P + Length('clang version ') - 1);
      P := 1;
      while (P <= Length(Text)) and (Text[P] >= '0') and (Text[P] <= '9') do
        P := P + 1;
      Result := StrToIntDef(Copy(Text, 1, P - 1), 0);
      Exit;
    end;
  end;
end;

function ClangUsable(const Dir: String): Boolean;
begin
  // Complete (clang and lld) and new enough. A complete one that is too old is remembered, to tell the user about it.
  Result := False;
  if not ClangComplete(Dir) then
    Exit;
  if ClangMajor(Dir) >= MinClangMajor then
    Result := True
  else if OldClangPath = '' then
    OldClangPath := AddBackslash(Dir) + 'clang.exe';
end;

function FindOnPath(const Name: String): String;
begin
  // FileSearch looks through the directories of the PATH that this process has, which is that of the account running the installer.
  Result := FileSearch(Name, GetEnv('PATH'));
end;

function FindLlvmDirectory(var OnPath: Boolean): String;
var
  Dir: String;
begin
  Result := '';
  OnPath := False;

  // 1. PATH. A BLITZLLVM_CC that is already set wins in blitzcc, so it is honoured here too.
  Dir := GetEnv('BLITZLLVM_CC');
  if (Dir <> '') and FileExists(Dir) and ClangUsable(ExtractFileDir(Dir)) then begin
    Result := ExtractFileDir(Dir);
    OnPath := True; // Nothing to set, it is set.
    Exit;
  end;
  Dir := FindOnPath('clang.exe');
  if (Dir <> '') and ClangUsable(ExtractFileDir(Dir)) then begin
    Result := ExtractFileDir(Dir);
    OnPath := True;
    Exit;
  end;

  // 2. The registry key of the LLVM installer (64 bit view, then 32 bit view).
  if RegQueryStringValue(HKLM64, 'SOFTWARE\LLVM\LLVM', '', Dir) or RegQueryStringValue(HKLM32, 'SOFTWARE\LLVM\LLVM', '', Dir) then begin
    Dir := AddBackslash(Dir) + 'bin';
    if ClangUsable(Dir) then begin
      Result := Dir;
      Exit;
    end;
  end;

  // 3. The default folder, which is also where winget puts it.
  Dir := ExpandConstant('{commonpf64}\LLVM\bin');
  if ClangUsable(Dir) then begin
    Result := Dir;
    Exit;
  end;
  Dir := ExpandConstant('{commonpf32}\LLVM\bin');
  if ClangUsable(Dir) then begin
    Result := Dir;
    Exit;
  end;
  Dir := 'C:\Program Files\LLVM\bin';
  if ClangUsable(Dir) then
    Result := Dir;
end;

procedure DetectLlvm;
var
  Dir: String;
begin
  OldClangPath := '';
  Dir := FindLlvmDirectory(ClangOnPath);
  if Dir = '' then
    ClangPath := ''
  else if (GetEnv('BLITZLLVM_CC') <> '') and FileExists(GetEnv('BLITZLLVM_CC')) then
    ClangPath := GetEnv('BLITZLLVM_CC')
  else
    ClangPath := AddBackslash(Dir) + 'clang.exe';
end;

function DetectWinget: Boolean;
var
  ResultCode: Integer;
begin
  // "winget" is an app execution alias, so it is asked for its version instead of looked up as a file.
  Result := Exec(ExpandConstant('{cmd}'), '/C winget --version', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

// ---- Registry values -------------------------------------------------------------------------------------------------

function SetClangVariable: Boolean;
begin
  // Only when clang was found outside of PATH and nobody set BLITZLLVM_CC already.
  Result := (ClangPath <> '') and (not ClangOnPath);
end;

function ClangToSet(Param: String): String;
begin
  Result := ClangPath;
end;

// ---- PATH ------------------------------------------------------------------------------------------------------------

function PathContains(const Path, Dir: String): Boolean;
begin
  Result := Pos(';' + Lowercase(RemoveBackslash(Dir)) + ';', ';' + Lowercase(Path) + ';') > 0;
end;

procedure AddToPath(const Dir: String);
var
  Path: String;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, EnvironmentKey, 'Path', Path) then
    Path := '';
  if PathContains(Path, Dir) or PathContains(Path, Dir + '\') then
    Exit;
  if (Path <> '') and (Path[Length(Path)] <> ';') then
    Path := Path + ';';
  Path := Path + RemoveBackslash(Dir);
  RegWriteExpandStringValue(HKEY_CURRENT_USER, EnvironmentKey, 'Path', Path);
end;

procedure RemoveFromPath(const Dir: String);
var
  Path, Wanted: String;
  P: Integer;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, EnvironmentKey, 'Path', Path) then
    Exit;
  Wanted := RemoveBackslash(Dir);
  Path := ';' + Path + ';';
  repeat
    P := Pos(';' + Lowercase(Wanted) + ';', Lowercase(Path));
    if P > 0 then
      Delete(Path, P, Length(Wanted) + 1);
  until P = 0;
  // Remove the extra ';' of both ends.
  if (Length(Path) > 0) and (Path[1] = ';') then
    Delete(Path, 1, 1);
  if (Length(Path) > 0) and (Path[Length(Path)] = ';') then
    Delete(Path, Length(Path), 1);
  RegWriteExpandStringValue(HKEY_CURRENT_USER, EnvironmentKey, 'Path', Path);
end;

// ---- Wizard ----------------------------------------------------------------------------------------------------------

function WingetInstallCommand: String;
begin
  // An older LLVM from winget is upgraded, as "install" would only report that it is installed.
  if OldClangPath <> '' then
    Result := WingetUpgradeCommand
  else
    Result := WingetCommand;
end;

function LlvmRequested: Boolean;
begin
  // Silent installs never install anything else by themselves, unless asked with /INSTALLLLVM=yes.
  if WizardSilent then
    Result := (ClangPath = '') and WingetAvailable and (CompareText(ExpandConstant('{param:INSTALLLLVM|no}'), 'yes') = 0)
  else
    Result := (ClangPath = '') and WingetAvailable and Assigned(LlvmInstallBox) and LlvmInstallBox.Checked;
end;

procedure InitializeWizard;
var
  OldNote: String;
begin
  DetectLlvm;
  OldNote := '';
  if OldClangPath <> '' then
    OldNote := ' (only an older one, ' + OldClangPath + ')';
  WingetAvailable := DetectWinget;

  LlvmPage := CreateCustomPage(wpSelectTasks, 'LLVM', 'BlitzLLVM builds programs with clang and lld, which are part of LLVM.');
  LlvmInfo := TNewStaticText.Create(LlvmPage);
  LlvmInfo.Parent := LlvmPage.Surface;
  LlvmInfo.AutoSize := False;
  LlvmInfo.WordWrap := True;
  LlvmInfo.Width := LlvmPage.SurfaceWidth;
  LlvmInfo.Height := ScaleY(110);

  if ClangPath <> '' then
    LlvmInfo.Caption := 'LLVM was found:' + #13#10#13#10 + ClangPath + #13#10#13#10 + 'Nothing else has to be installed.'
  else if WingetAvailable then begin
    if OldClangPath <> '' then
      LlvmInfo.Caption := 'LLVM ' + IntToStr(MinClangMajor) + ' or newer (clang and lld) is needed, but only an older one was found:' + #13#10 + OldClangPath + #13#10#13#10 +
        'The installer can update it with winget (' + WingetInstallCommand + ').'
    else
      LlvmInfo.Caption := 'LLVM ' + IntToStr(MinClangMajor) + ' or newer (clang and lld) was not found on this computer. BlitzLLVM can not build programs without it, and nothing else is needed: ' +
        'no Visual Studio, no Windows SDK.' + #13#10#13#10 + 'The installer can get it with winget from the LLVM project (' + WingetInstallCommand + ').';
    LlvmInstallBox := TNewCheckBox.Create(LlvmPage);
    LlvmInstallBox.Parent := LlvmPage.Surface;
    LlvmInstallBox.Top := LlvmInfo.Top + LlvmInfo.Height + ScaleY(8);
    LlvmInstallBox.Width := LlvmPage.SurfaceWidth;
    LlvmInstallBox.Caption := 'Install LLVM ' + IntToStr(MinClangMajor) + ' with winget after installing BlitzLLVM (recommended)';
    LlvmInstallBox.Checked := True;
  end else
    LlvmInfo.Caption := 'LLVM ' + IntToStr(MinClangMajor) + ' or newer (clang and lld) was not found on this computer' + OldNote + ', and winget is not available here, so it can not be installed for you.' + #13#10#13#10 +
      'BlitzLLVM can not build programs without it. Install it after this setup, in one of these ways:' + #13#10 +
      ' - Install "App Installer" from the Microsoft Store (it provides winget), then run in a terminal:' + #13#10 + '     ' + WingetInstallCommand + #13#10 +
      ' - Or download the Windows installer (LLVM-<version>-win64.exe) from ' + LlvmDownloadUrl + ' and run it.' + #13#10#13#10 +
      'Run this setup again afterwards if blitzcc does not find clang (LLVM is searched on PATH and in C:\Program Files\LLVM\bin).';
end;

procedure InstallLlvm;
var
  ResultCode: Integer;
begin
  WizardForm.StatusLabel.Caption := 'Installing LLVM with winget (this can take a few minutes)...';
  WizardForm.ProgressGauge.Style := npbstMarquee;
  try
    // The window stays visible: winget shows its own progress and asks for administrator rights when it needs them.
    if (not Exec(ExpandConstant('{cmd}'), '/C ' + WingetInstallCommand, '', SW_SHOW, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then begin
      LlvmInstallFailed := True;
      Log(Format('winget failed (result %d).', [ResultCode]));
    end;
  finally
    WizardForm.ProgressGauge.Style := npbstNormal;
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then begin
    // Before the registry entries are written, so they see where LLVM ended up.
    if LlvmRequested then begin
      InstallLlvm;
      DetectLlvm;
      if (ClangPath = '') and (not LlvmInstallFailed) then
        LlvmInstallFailed := True; // winget finished but LLVM is still not where it is expected.
    end;
  end;
  if CurStep = ssPostInstall then begin
    if WizardIsTaskSelected('addtopath') then
      AddToPath(ExpandConstant('{app}\bin'));
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = wpFinished then begin
    if LlvmInstallFailed then
      WizardForm.FinishedLabel.Caption := WizardForm.FinishedLabel.Caption + #13#10#13#10 +
        'LLVM could not be installed. Install it yourself with:' + #13#10 + WingetInstallCommand + #13#10 + 'or from ' + LlvmDownloadUrl + '.'
    else if (ClangPath = '') then
      WizardForm.FinishedLabel.Caption := WizardForm.FinishedLabel.Caption + #13#10#13#10 +
        'LLVM ' + IntToStr(MinClangMajor) + ' or newer (clang and lld) is not installed yet, and blitzcc needs it to build programs.';
    if WizardIsTaskSelected('addtopath') then
      WizardForm.FinishedLabel.Caption := WizardForm.FinishedLabel.Caption + #13#10#13#10 +
        'Open a new terminal for the PATH change to apply.';
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
    RemoveFromPath(ExpandConstant('{app}\bin'));
end;
